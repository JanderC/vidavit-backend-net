@{
    ViewData["Title"] = "Crear Plan";
    ViewData["Subtitle"] = "Nuevo plan de membresía - TAURO GYM";
    Layout = "_AdminLayout";
}

<div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">

        <!-- Header -->
        <div class="flex items-center gap-4 mb-8 pb-6 border-b-2 border-gray-200">
            <div class="bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-xl p-4">
                <i data-lucide="plus-circle" class="w-8 h-8 text-white"></i>
            </div>
            <div>
                <h2 class="text-3xl font-black text-gray-900 uppercase tracking-wide">Nuevo Plan</h2>
                <p class="text-sm text-gray-600 font-semibold mt-1">Configura el plan que verán las recepcionistas al crear membresías</p>
            </div>
        </div>

        <form id="crearPlanForm" class="space-y-6">

            <!-- NOMBRE -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Nombre del Plan *</label>
                <input type="text" id="nombre" placeholder="Ej: Plan Mensual, Plan Semestral..."
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 text-gray-900 font-semibold">
            </div>

            <!-- DESCRIPCIÓN -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Descripción <span class="text-gray-400 font-normal normal-case">(Opcional)</span></label>
                <textarea id="descripcion" rows="2" placeholder="Beneficios, acceso, restricciones..."
                          class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 text-gray-900 font-semibold resize-none"></textarea>
            </div>

            <!-- TIPO Y PRECIO -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Tipo de Plan *</label>
                    <select id="tipo"
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 text-gray-900 bg-white font-semibold">
                        <option value="mensual">Mensual</option>
                        <option value="semanal">Semanal</option>
                        <option value="trimestral">Trimestral</option>
                        <option value="semestral">Semestral</option>
                        <option value="anual">Anual</option>
                        <option value="diario">Diario</option>
                        <option value="personalizado">Personalizado</option>
                        <option value="otro">Otro</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Precio *</label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 font-black text-lg">$</span>
                        <input type="number" id="precio" step="0.01" min="0.01" placeholder="0.00"
                               class="w-full pl-8 pr-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 text-gray-900 font-semibold text-lg">
                    </div>
                </div>
            </div>

            <!-- DURACIÓN — el campo central -->
            <div class="p-5 bg-blue-50 border-2 border-blue-300 rounded-2xl">
                <h3 class="text-sm font-black text-blue-800 uppercase tracking-wide mb-4 flex items-center gap-2">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                    Duración del Plan
                </h3>

                <!-- Tipo de cálculo de vencimiento -->
                <div class="mb-4">
                    <label class="block text-xs font-black text-gray-600 mb-2 uppercase">¿Cómo se calcula el vencimiento? *</label>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2" id="tipoCalcBtns">
                        <button type="button" onclick="seleccionarTipoCalculo('meses')" id="btn-meses"
                                class="tipo-calc-btn py-3 px-2 border-2 border-blue-500 bg-blue-100 text-blue-800 rounded-xl text-sm font-black transition-all text-center">
                            <i data-lucide="calendar-days" class="w-4 h-4 mx-auto mb-1"></i>
                            Meses
                        </button>
                        <button type="button" onclick="seleccionarTipoCalculo('dias')" id="btn-dias"
                                class="tipo-calc-btn py-3 px-2 border-2 border-gray-300 text-gray-600 rounded-xl text-sm font-black transition-all hover:border-blue-400 text-center">
                            <i data-lucide="calendar" class="w-4 h-4 mx-auto mb-1"></i>
                            Días
                        </button>
                        <button type="button" onclick="seleccionarTipoCalculo('semanas')" id="btn-semanas"
                                class="tipo-calc-btn py-3 px-2 border-2 border-gray-300 text-gray-600 rounded-xl text-sm font-black transition-all hover:border-blue-400 text-center">
                            <i data-lucide="calendar-range" class="w-4 h-4 mx-auto mb-1"></i>
                            Semanas
                        </button>
                        <button type="button" onclick="seleccionarTipoCalculo('anios')" id="btn-anios"
                                class="tipo-calc-btn py-3 px-2 border-2 border-gray-300 text-gray-600 rounded-xl text-sm font-black transition-all hover:border-blue-400 text-center">
                            <i data-lucide="calendar-check" class="w-4 h-4 mx-auto mb-1"></i>
                            Años
                        </button>
                    </div>
                    <input type="hidden" id="tipoCalculoVencimiento" value="meses">
                </div>

                <!-- Cantidad de unidades -->
                <div>
                    <label class="block text-xs font-black text-gray-600 mb-2 uppercase" id="labelCantidad">Cantidad de Meses *</label>
                    <div class="flex items-center gap-3">
                        <button type="button" onclick="ajustarCantidad(-1)"
                                class="w-12 h-12 bg-white border-2 border-gray-300 rounded-xl text-xl font-black hover:border-blue-400 hover:bg-blue-50 transition-all flex items-center justify-center">
                            −
                        </button>
                        <input type="number" id="cantidadUnidades" value="1" min="1" max="60"
                               class="flex-1 px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 font-black text-2xl text-center"
                               oninput="actualizarPreviewDuracion()">
                        <button type="button" onclick="ajustarCantidad(1)"
                                class="w-12 h-12 bg-white border-2 border-gray-300 rounded-xl text-xl font-black hover:border-blue-400 hover:bg-blue-50 transition-all flex items-center justify-center">
                            +
                        </button>
                    </div>
                </div>

                <!-- Preview de duración -->
                <div id="previewDuracion" class="mt-4 p-3 bg-white border border-blue-200 rounded-xl text-sm font-semibold text-blue-800 hidden">
                    <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                    <span id="previewDuracionTexto"></span>
                </div>
            </div>

            <!-- COLOR -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Color del Plan</label>
                <div class="flex items-center gap-4">
                    <input type="color" id="color" value="#10b981"
                           class="w-14 h-14 border-2 border-gray-300 rounded-xl cursor-pointer p-1">
                    <div class="flex gap-2 flex-wrap" id="coloresPredefinidos">
                        <button type="button" onclick="setColor('#10b981')" style="background:#10b981" class="color-preset w-8 h-8 rounded-lg border-2 border-transparent hover:border-gray-400 transition-all" title="Esmeralda"></button>
                        <button type="button" onclick="setColor('#3b82f6')" style="background:#3b82f6" class="color-preset w-8 h-8 rounded-lg border-2 border-transparent hover:border-gray-400 transition-all" title="Azul"></button>
                        <button type="button" onclick="setColor('#8b5cf6')" style="background:#8b5cf6" class="color-preset w-8 h-8 rounded-lg border-2 border-transparent hover:border-gray-400 transition-all" title="Violeta"></button>
                        <button type="button" onclick="setColor('#f59e0b')" style="background:#f59e0b" class="color-preset w-8 h-8 rounded-lg border-2 border-transparent hover:border-gray-400 transition-all" title="Ámbar"></button>
                        <button type="button" onclick="setColor('#ef4444')" style="background:#ef4444" class="color-preset w-8 h-8 rounded-lg border-2 border-transparent hover:border-gray-400 transition-all" title="Rojo"></button>
                        <button type="button" onclick="setColor('#ec4899')" style="background:#ec4899" class="color-preset w-8 h-8 rounded-lg border-2 border-transparent hover:border-gray-400 transition-all" title="Rosa"></button>
                        <button type="button" onclick="setColor('#06b6d4')" style="background:#06b6d4" class="color-preset w-8 h-8 rounded-lg border-2 border-transparent hover:border-gray-400 transition-all" title="Cyan"></button>
                        <button type="button" onclick="setColor('#64748b')" style="background:#64748b" class="color-preset w-8 h-8 rounded-lg border-2 border-transparent hover:border-gray-400 transition-all" title="Slate"></button>
                    </div>
                </div>
            </div>

            <!-- PREVIEW DE LA TARJETA -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Preview de la Tarjeta</label>
                <div class="border-2 border-gray-200 rounded-2xl overflow-hidden shadow-sm max-w-xs" id="previewCard">
                    <div class="p-5 text-white relative overflow-hidden" id="previewHeader" style="background-color:#10b981">
                        <div class="absolute top-0 right-0 w-24 h-24 bg-white opacity-10 rounded-full -mr-12 -mt-12"></div>
                        <span class="px-2 py-0.5 bg-white bg-opacity-20 rounded-full text-xs font-bold" id="previewTipo">Mensual</span>
                        <h4 class="text-xl font-black mt-2" id="previewNombre">Nombre del plan</h4>
                        <p class="text-3xl font-black mt-1" id="previewPrecio">$0</p>
                    </div>
                    <div class="p-4 bg-white">
                        <p class="text-sm text-gray-600 font-bold" id="previewDurCard">1 mes</p>
                    </div>
                </div>
            </div>

            <!-- ACTIVO -->
            <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl border-2 border-gray-200">
                <input type="checkbox" id="activo" checked
                       class="w-5 h-5 text-emerald-600 rounded border-gray-300 focus:ring-emerald-500">
                <div>
                    <label for="activo" class="text-sm font-black text-gray-700 uppercase tracking-wide cursor-pointer">Plan Activo</label>
                    <p class="text-xs text-gray-500 font-semibold">Los planes inactivos no aparecen al crear membresías</p>
                </div>
            </div>

            <!-- ERROR -->
            <div id="errorMsg" class="hidden p-4 bg-red-50 border-2 border-red-300 rounded-xl text-red-700 font-semibold text-sm"></div>

            <!-- BOTONES -->
            <div class="flex gap-4 pt-6 border-t-2 border-gray-200">
                <a href="/membresias/planes"
                   class="flex-1 px-6 py-4 bg-gray-200 hover:bg-gray-300 text-gray-900 font-black rounded-xl transition-all text-center uppercase tracking-wide">
                    <i data-lucide="x-circle" class="w-5 h-5 inline mr-2"></i>Cancelar
                </a>
                <button type="submit"
                        class="flex-1 px-6 py-4 bg-gradient-to-r from-emerald-600 to-emerald-800 hover:from-emerald-700 hover:to-emerald-900 text-white font-black rounded-xl transition-all shadow-xl uppercase tracking-wide transform hover:scale-105">
                    <i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i>Crear Plan
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL LOADING -->
<div id="modalLoading" class="hidden fixed inset-0 bg-black bg-opacity-70 z-50 flex items-center justify-center">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-sm text-center p-10">
        <div class="relative w-20 h-20 mx-auto mb-6">
            <svg class="animate-spin w-20 h-20 text-emerald-600" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            <i data-lucide="plus-circle" class="w-8 h-8 text-emerald-700 absolute inset-0 m-auto"></i>
        </div>
        <p class="text-xl font-black text-gray-900 uppercase tracking-wide mb-2">Creando Plan</p>
        <p class="text-sm text-gray-500 font-semibold">Guardando en el sistema...</p>
    </div>
</div>

<!-- MODAL ÉXITO -->
<div id="modalExito" class="hidden fixed inset-0 bg-black bg-opacity-60 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md">
        <div class="bg-gradient-to-r from-emerald-500 to-emerald-700 text-white px-8 py-6 rounded-t-3xl text-center">
            <div class="w-16 h-16 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-3">
                <i data-lucide="check-circle" class="w-9 h-9 text-white"></i>
            </div>
            <h3 class="text-2xl font-black uppercase tracking-wide">¡Plan Creado!</h3>
        </div>
        <div class="p-8 space-y-3">
            <div class="bg-gray-50 rounded-xl p-4 border-2 border-gray-200 space-y-2">
                <div class="flex justify-between"><span class="text-sm font-black text-gray-500 uppercase">Nombre</span><span class="font-black text-gray-900" id="exitoNombre"></span></div>
                <div class="flex justify-between"><span class="text-sm font-black text-gray-500 uppercase">Duración</span><span class="font-black text-gray-900" id="exitoDuracion"></span></div>
                <div class="flex justify-between"><span class="text-sm font-black text-gray-500 uppercase">Precio</span><span class="font-black text-emerald-700" id="exitoPrecio"></span></div>
            </div>
        </div>
        <div class="flex gap-3 px-8 pb-8">
            <button onclick="nuevoplan()"
                    class="flex-1 px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-900 font-black rounded-xl transition-all uppercase tracking-wide">
                Crear Otro
            </button>
            <a href="/membresias/planes"
               class="flex-1 px-6 py-3 bg-gradient-to-r from-emerald-600 to-emerald-800 text-white font-black rounded-xl text-center uppercase tracking-wide">
                Ver Planes
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Estado ────────────────────────────────────────────────────────
        let tipoCalculo = 'meses';

        // ── Tipo de cálculo ───────────────────────────────────────────────
        function seleccionarTipoCalculo(tipo) {
            tipoCalculo = tipo;
            document.getElementById('tipoCalculoVencimiento').value = tipo;

            // Botones
            document.querySelectorAll('.tipo-calc-btn').forEach(b => {
                b.classList.remove('border-blue-500', 'bg-blue-100', 'text-blue-800');
                b.classList.add('border-gray-300', 'text-gray-600');
            });
            const activo = document.getElementById('btn-' + tipo);
            activo.classList.add('border-blue-500', 'bg-blue-100', 'text-blue-800');
            activo.classList.remove('border-gray-300', 'text-gray-600');

            // Label de cantidad
            const labels = { meses:'Cantidad de Meses', dias:'Cantidad de Días', semanas:'Cantidad de Semanas', anios:'Cantidad de Años' };
            document.getElementById('labelCantidad').textContent = (labels[tipo] || 'Cantidad') + ' *';

            actualizarPreviewDuracion();
        }

        function ajustarCantidad(delta) {
            const input = document.getElementById('cantidadUnidades');
            const val = Math.max(1, (parseInt(input.value) || 1) + delta);
            input.value = val;
            actualizarPreviewDuracion();
        }

        function actualizarPreviewDuracion() {
            const cant = parseInt(document.getElementById('cantidadUnidades').value) || 1;
            const tipo = tipoCalculo;
            let texto = '';
            if (tipo === 'meses')   texto = `El plan durará ${cant} ${cant === 1 ? 'mes calendario' : 'meses calendario'} (ej: del 1 ene → 1 feb)`;
            if (tipo === 'dias')    texto = `El plan durará exactamente ${cant} ${cant === 1 ? 'día' : 'días'}`;
            if (tipo === 'semanas') texto = `El plan durará ${cant} ${cant === 1 ? 'semana' : 'semanas'} (${cant * 7} días)`;
            if (tipo === 'anios')   texto = `El plan durará ${cant} ${cant === 1 ? 'año' : 'años'} completo${cant > 1 ? 's' : ''}`;

            const preview = document.getElementById('previewDuracion');
            document.getElementById('previewDuracionTexto').textContent = texto;
            preview.classList.remove('hidden');

            // Actualizar tarjeta preview
            const labelDur = { meses:`${cant} ${cant===1?'mes':'meses'}`, dias:`${cant} ${cant===1?'día':'días'}`, semanas:`${cant} ${cant===1?'semana':'semanas'}`, anios:`${cant} ${cant===1?'año':'años'}` };
            document.getElementById('previewDurCard').textContent = labelDur[tipo] || '';
            lucide.createIcons();
        }

        // ── Color ─────────────────────────────────────────────────────────
        function setColor(hex) {
            document.getElementById('color').value = hex;
            document.getElementById('previewHeader').style.backgroundColor = hex;
        }

        document.getElementById('color').addEventListener('input', function() {
            document.getElementById('previewHeader').style.backgroundColor = this.value;
        });

        // ── Preview de tarjeta en tiempo real ────────────────────────────
        document.getElementById('nombre').addEventListener('input', function() {
            document.getElementById('previewNombre').textContent = this.value || 'Nombre del plan';
        });
        document.getElementById('precio').addEventListener('input', function() {
            const v = parseFloat(this.value) || 0;
            document.getElementById('previewPrecio').textContent = '$' + v.toLocaleString('es');
        });
        document.getElementById('tipo').addEventListener('change', function() {
            document.getElementById('previewTipo').textContent = this.options[this.selectedIndex].text;
        });

        // ── Toast ─────────────────────────────────────────────────────────
        function mostrarToast(msg, tipo) {
            const color = tipo === 'error' ? 'bg-red-600' : 'bg-emerald-600';
            const t = document.createElement('div');
            t.className = `fixed bottom-6 right-6 z-[100] ${color} text-white px-6 py-4 rounded-2xl shadow-2xl font-bold text-sm`;
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; t.style.transition = 'opacity .4s'; setTimeout(() => t.remove(), 400); }, 4000);
        }

        // ── Submit ────────────────────────────────────────────────────────
        document.getElementById('crearPlanForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const nombre      = document.getElementById('nombre').value.trim();
            const tipo        = document.getElementById('tipo').value;
            const precio      = parseFloat(document.getElementById('precio').value);
            const tipoCalcV   = document.getElementById('tipoCalculoVencimiento').value;
            const cantidad    = parseInt(document.getElementById('cantidadUnidades').value) || 1;
            const color       = document.getElementById('color').value;
            const activo      = document.getElementById('activo').checked;
            const descripcion = document.getElementById('descripcion').value.trim();
            const errorEl     = document.getElementById('errorMsg');
            errorEl.classList.add('hidden');

            // Validaciones
            if (!nombre)          { errorEl.textContent = 'El nombre es requerido'; errorEl.classList.remove('hidden'); return; }
            if (!precio || precio <= 0) { errorEl.textContent = 'El precio debe ser mayor a $0'; errorEl.classList.remove('hidden'); return; }
            if (cantidad < 1)     { errorEl.textContent = 'La cantidad debe ser al menos 1'; errorEl.classList.remove('hidden'); return; }

            // DuracionDias: referencia (el controlador lo acepta en 0 para no-días, pero mandamos algo)
            const duracionDias = tipoCalcV === 'dias' ? cantidad
                : tipoCalcV === 'semanas' ? cantidad * 7
                : tipoCalcV === 'anios'   ? cantidad * 365
                : cantidad * 30; // meses

            const payload = {
                nombre,
                descripcion: descripcion || null,
                tipo,
                duracionDias,
                tipoCalculoVencimiento: tipoCalcV,
                cantidadUnidades: cantidad,
                precio,
                color,
                activo
            };

            document.getElementById('modalLoading').classList.remove('hidden');

            let intentos = 0;
            while (intentos < 2) {
                try {
                    const res = await fetch('/api/Planes', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (!res.ok) {
                        const err = await res.text();
                        throw new Error(err || `Error HTTP ${res.status}`);
                    }
                    const plan = await res.json();
                    document.getElementById('modalLoading').classList.add('hidden');

                    // Llenar modal éxito
                    const labelDur = { meses:`${cantidad} ${cantidad===1?'mes':'meses'}`, dias:`${cantidad} ${cantidad===1?'día':'días'}`, semanas:`${cantidad} ${cantidad===1?'semana':'semanas'}`, anios:`${cantidad} ${cantidad===1?'año':'años'}` };
                    document.getElementById('exitoNombre').textContent    = nombre;
                    document.getElementById('exitoDuracion').textContent  = labelDur[tipoCalcV] || cantidad + ' unidades';
                    document.getElementById('exitoPrecio').textContent    = '$' + precio.toFixed(2);
                    document.getElementById('modalExito').classList.remove('hidden');
                    lucide.createIcons();
                    return;
                } catch(err) {
                    intentos++;
                    if (intentos < 2) {
                        await new Promise(r => setTimeout(r, 800));
                    } else {
                        document.getElementById('modalLoading').classList.add('hidden');
                        errorEl.textContent = 'Error al crear el plan: ' + err.message;
                        errorEl.classList.remove('hidden');
                    }
                }
            }
        });

        function nuevoplan() {
            document.getElementById('modalExito').classList.add('hidden');
            document.getElementById('crearPlanForm').reset();
            document.getElementById('color').value = '#10b981';
            document.getElementById('previewHeader').style.backgroundColor = '#10b981';
            document.getElementById('previewNombre').textContent = 'Nombre del plan';
            document.getElementById('previewPrecio').textContent = '$0';
            document.getElementById('previewTipo').textContent = 'Mensual';
            seleccionarTipoCalculo('meses');
            document.getElementById('cantidadUnidades').value = 1;
            actualizarPreviewDuracion();
        }

        // ── Inicializar ───────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            seleccionarTipoCalculo('meses');
            actualizarPreviewDuracion();
            lucide.createIcons();
            document.querySelectorAll('input[type="number"]').forEach(i => {
                i.addEventListener('wheel', e => e.preventDefault(), { passive: false });
            });
        });

        window.seleccionarTipoCalculo = seleccionarTipoCalculo;
        window.ajustarCantidad        = ajustarCantidad;
        window.setColor               = setColor;
        window.nuevoplan              = nuevoplan;
    </script>
}

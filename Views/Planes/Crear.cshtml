@{
    ViewData["Title"] = "Crear Plan";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --pz-blue: #2B4FD8;
        --pz-blue-dark: #1a3ab5;
        --pz-gold: #D4A017;
        --pz-gold-dark: #b8880e;
        --pz-border: rgba(43,79,216,0.2);
        --pz-text: #0f1535;
        --pz-muted: #4a5a8a;
        --pz-white: #ffffff;
    }

    .pz-page {
        background: linear-gradient(135deg, #f5f7ff 0%, #eef1ff 100%);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .pz-card {
        background: var(--pz-white);
        border: 1px solid var(--pz-border);
        border-radius: 1rem;
        box-shadow: 0 2px 12px rgba(43,79,216,0.08);
    }

    .pz-label {
        color: var(--pz-muted);
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
        display: block;
    }

    .pz-input {
        width: 100%;
        background: #f5f7ff;
        border: 2px solid var(--pz-border);
        color: var(--pz-text);
        border-radius: .5rem;
        padding: .75rem 1rem;
        transition: border-color .2s, box-shadow .2s;
        outline: none;
        font-weight: 600;
    }

        .pz-input:focus {
            border-color: #D4A017;
            box-shadow: 0 0 0 3px rgba(212,160,23,0.15);
        }

        .pz-input::placeholder {
            color: #8899bb;
        }

    select.pz-input option {
        background: #fff;
        color: var(--pz-text);
    }

    .pz-btn-primary {
        background: linear-gradient(135deg, #2B4FD8, #1a3ab5);
        color: #fff;
        font-weight: 800;
        padding: .85rem 1.5rem;
        border-radius: .5rem;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        transition: all .2s;
        width: 100%;
        box-shadow: 0 4px 14px rgba(43,79,216,0.3);
        text-transform: uppercase;
        letter-spacing: .06em;
    }

        .pz-btn-primary:hover {
            background: linear-gradient(135deg, #D4A017, #b8880e);
            box-shadow: 0 6px 20px rgba(212,160,23,0.4);
            transform: translateY(-1px);
        }

    .pz-btn-secondary {
        background: #f3f4f6;
        color: #374151;
        font-weight: 700;
        padding: .85rem 1.5rem;
        border-radius: .5rem;
        border: 1px solid #d1d5db;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        transition: background .2s;
        width: 100%;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

        .pz-btn-secondary:hover {
            background: #e5e7eb;
        }
</style>

<div class="pz-page">
    <div class="max-w-4xl mx-auto space-y-6">

        <!-- Header -->
        <div class="pz-card p-6" style="display:flex;align-items:center;justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:1rem;">
                <div style="background:linear-gradient(135deg,#0f1535,#1a2050);padding:0.5rem 1rem;border-radius:.5rem;box-shadow:0 4px 14px rgba(43,79,216,0.3);border-bottom:2px solid #D4A017;">
                    <span style="color:#D4A017;font-size:1.1rem;font-weight:900;letter-spacing:.05em;">POWER</span><span style="color:#fff;font-size:1.1rem;font-weight:900;opacity:0.85;">ZONE</span>
                </div>
                <div>
                    <h2 style="color:var(--pz-text);font-size:1.5rem;font-weight:800;">Crear Nuevo Plan</h2>
                    <p style="color:var(--pz-muted);font-size:.875rem;">Define un nuevo plan de membresía</p>
                </div>
            </div>
            <a href="/membresias/planes" style="color:var(--pz-muted);display:flex;align-items:center;padding:.5rem;border-radius:.5rem;transition:background .2s;"
               onmouseover="this.style.background='rgba(43,79,216,0.08)'" onmouseout="this.style.background='transparent'">
                <i data-lucide="x" class="w-6 h-6"></i>
            </a>
        </div>

        <!-- Formulario -->
        <div class="pz-card p-8">
            <form id="planForm" class="space-y-6">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="pz-label">Nombre del Plan *</label>
                        <input type="text" name="nombre" required
                               placeholder="Ej: Plan Mensual, Plan Trimestral, etc."
                               class="pz-input">
                    </div>

                    <div>
                        <label class="pz-label">Tipo de Plan *</label>
                        <select name="tipo" required class="pz-input">
                            <option value="">Seleccione un tipo...</option>
                            <option value="diario">Diario</option>
                            <option value="semanal">Semanal</option>
                            <option value="mensual">Mensual</option>
                            <option value="trimestral">Trimestral</option>
                            <option value="semestral">Semestral</option>
                            <option value="anual">Anual</option>
                            <option value="personalizado">Personalizado</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>

                    <div>
                        <label class="pz-label">Color del Plan *</label>
                        <div style="display:flex;gap:.5rem;">
                            <input type="color" name="color" value="#2B4FD8" id="colorPicker"
                                   style="height:3rem;width:5rem;border:2px solid var(--pz-border);border-radius:.5rem;cursor:pointer;background:#f5f7ff;padding:.2rem;">
                            <input type="text" id="colorValue" value="#2B4FD8" readonly
                                   style="flex:1;padding:.75rem 1rem;border:2px solid var(--pz-border);border-radius:.5rem;background:#f5f7ff;color:var(--pz-text);font-family:monospace;font-size:.875rem;font-weight:700;outline:none;">
                        </div>
                        <p style="color:var(--pz-muted);font-size:.75rem;margin-top:.25rem;">El color identifica visualmente el plan</p>
                    </div>

                    <div>
                        <label class="pz-label">Duración (días) *</label>
                        <input type="number" name="duracionDias" required min="1" value="30"
                               placeholder="30" class="pz-input">
                        <p style="color:var(--pz-muted);font-size:.75rem;margin-top:.25rem;">Duración del plan en días</p>
                    </div>

                    <div>
                        <label class="pz-label">Precio *</label>
                        <div style="position:relative;">
                            <span style="position:absolute;left:1rem;top:.85rem;color:#D4A017;font-weight:800;">$</span>
                            <input type="number" name="precio" required min="0" step="0.01" value="0"
                                   placeholder="0.00" style="padding-left:2rem;" class="pz-input">
                        </div>
                    </div>

                    <div class="md:col-span-2">
                        <label class="pz-label">Descripción (Opcional)</label>
                        <textarea name="descripcion" rows="3"
                                  placeholder="Describe los beneficios y características de este plan..."
                                  class="pz-input" style="resize:none;"></textarea>
                    </div>

                    <div class="md:col-span-2">
                        <label style="display:flex;align-items:center;gap:.75rem;cursor:pointer;">
                            <input type="checkbox" name="activo" checked
                                   style="width:1.25rem;height:1.25rem;accent-color:#2B4FD8;border-radius:.25rem;">
                            <span style="color:var(--pz-text);font-size:.875rem;font-weight:600;">Plan activo (visible para asignar a clientes)</span>
                        </label>
                    </div>
                </div>

                <!-- Vista Previa -->
                <div>
                    <p style="font-size:.78rem;font-weight:800;color:var(--pz-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.75rem;">Vista previa</p>
                    <div id="planPreview" style="border:2px solid #2B4FD8;border-radius:.75rem;overflow:hidden;transition:all .3s;box-shadow:0 4px 20px rgba(43,79,216,0.15);">
                        <div class="p-6 relative overflow-hidden" id="previewHeader" style="background-color:#2B4FD8;color:#fff;">
                            <div style="position:absolute;top:0;right:0;width:8rem;height:8rem;background:rgba(255,255,255,0.2);border-radius:50%;transform:translate(2rem,-2rem);"></div>
                            <div style="position:absolute;bottom:0;left:0;width:6rem;height:6rem;background:rgba(255,255,255,0.15);border-radius:50%;transform:translate(-1.5rem,1.5rem);"></div>
                            <div style="position:relative;z-index:10;">
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
                                    <span style="background:rgba(0,0,0,0.2);color:#fff;font-size:.8rem;font-weight:700;padding:.25rem .75rem;border-radius:9999px;" id="previewTipo">mensual</span>
                                    <span style="font-size:.7rem;font-weight:900;letter-spacing:.05em;opacity:.65;color:#D4A017;">POWERZONE</span>
                                </div>
                                <h4 style="font-size:1.5rem;font-weight:800;margin-bottom:.5rem;" id="previewNombre">Nombre del Plan</h4>
                                <div>
                                    <span style="font-size:2.5rem;font-weight:900;">$<span id="previewPrecio">0</span></span>
                                </div>
                            </div>
                        </div>
                        <div style="padding:1.5rem;background:#ffffff;border-top:1px solid rgba(43,79,216,0.15);">
                            <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.75rem;">
                                <i data-lucide="calendar" style="width:1.25rem;height:1.25rem;color:#2B4FD8;"></i>
                                <span style="font-weight:700;color:var(--pz-text);"><span id="previewDuracion">30</span> días</span>
                            </div>
                            <p style="font-size:.875rem;color:var(--pz-muted);" id="previewDescripcion">Sin descripción</p>
                        </div>
                    </div>
                </div>

                <!-- Botones -->
                <div style="display:flex;gap:1rem;padding-top:1rem;border-top:1px solid var(--pz-border);">
                    <button type="submit" class="pz-btn-primary">
                        <i data-lucide="check" class="w-5 h-5"></i>
                        Crear Plan
                    </button>
                    <a href="/membresias/planes" class="pz-btn-secondary">
                        <i data-lucide="x" class="w-5 h-5"></i>
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const colorPicker = document.querySelector('input[name="color"]');
        const colorValue = document.getElementById('colorValue');
        const previewContainer = document.getElementById('planPreview');
        const previewHeader = document.getElementById('previewHeader');

        function updatePreview() {
            const nombre = document.querySelector('input[name="nombre"]').value || 'Nombre del Plan';
            const tipo = document.querySelector('select[name="tipo"]').value || 'mensual';
            const duracion = document.querySelector('input[name="duracionDias"]').value || '30';
            const precio = document.querySelector('input[name="precio"]').value || '0';
            const descripcion = document.querySelector('textarea[name="descripcion"]').value || 'Sin descripción';
            const color = colorPicker.value;

            document.getElementById('previewNombre').textContent = nombre;
            document.getElementById('previewTipo').textContent = tipo;
            document.getElementById('previewDuracion').textContent = duracion;
            document.getElementById('previewPrecio').textContent = parseFloat(precio).toFixed(0);
            document.getElementById('previewDescripcion').textContent = descripcion;

            previewContainer.style.borderColor = color;
            previewHeader.style.backgroundColor = color;
        }

        colorPicker.addEventListener('input', function() {
            colorValue.value = this.value;
            updatePreview();
        });

        document.querySelector('input[name="nombre"]').addEventListener('input', updatePreview);
        document.querySelector('select[name="tipo"]').addEventListener('change', updatePreview);
        document.querySelector('input[name="duracionDias"]').addEventListener('input', updatePreview);
        document.querySelector('input[name="precio"]').addEventListener('input', updatePreview);
        document.querySelector('textarea[name="descripcion"]').addEventListener('input', updatePreview);

        document.getElementById('planForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
                nombre: formData.get('nombre'),
                tipo: formData.get('tipo'),
                duracionDias: parseInt(formData.get('duracionDias')),
                precio: parseFloat(formData.get('precio')),
                color: formData.get('color'),
                descripcion: formData.get('descripcion'),
                activo: formData.get('activo') === 'on'
            };
            try {
                const response = await fetch('/api/Planes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (response.ok) { alert('✅ Plan creado exitosamente'); window.location.href = '/membresias/planes'; }
                else { alert('❌ Error al crear plan: ' + await response.text()); }
            } catch (error) { alert('❌ Error al crear plan: ' + error.message); }
        });

        lucide.createIcons();
        updatePreview();
    </script>
}
@{
    ViewData["Title"] = "Crear Plan";
    Layout = "_AdminLayout";
}

<div class="max-w-4xl mx-auto p-6">
    <div class="bg-white rounded-xl shadow-lg p-8">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-800">📋 Crear Nuevo Plan</h2>
            <a href="/membresias/planes" class="text-gray-600 hover:text-gray-800">
                <i data-lucide="x" class="w-6 h-6"></i>
            </a>
        </div>

        <form id="planForm" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre del Plan *</label>
                    <input type="text" name="nombre" required
                           placeholder="Ej: Plan Mensual, Plan Trimestral, etc."
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Tipo de Plan *</label>
                    <select name="tipo" required
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 bg-white">
                        <option value="">Seleccione un tipo...</option>
                        <option value="diario">Diario</option>
                        <option value="semanal">Semanal</option>
                        <option value="mensual">Mensual</option>
                        <option value="trimestral">Trimestral</option>
                        <option value="semestral">Semestral</option>
                        <option value="anual">Anual</option>
                        <option value="personalizado">Personalizado</option>
                        <option value="otro">Otro</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Color del Plan *</label>
                    <div class="flex gap-2">
                        <input type="color" name="color" value="#FF6B00" id="colorPicker"
                               class="h-12 w-20 border-2 border-gray-300 rounded-lg cursor-pointer">
                        <input type="text" id="colorValue" value="#FF6B00" readonly
                               class="flex-1 px-4 py-3 border-2 border-gray-300 rounded-lg bg-gray-50 font-mono text-sm">
                    </div>
                    <p class="text-xs text-gray-500 mt-1">El color se usa para identificar visualmente el plan</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Duración (días) *</label>
                    <input type="number" name="duracionDias" required min="1" value="30"
                           placeholder="30"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500">
                    <p class="text-xs text-gray-500 mt-1">Duración del plan en días</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Precio *</label>
                    <div class="relative">
                        <span class="absolute left-4 top-3.5 text-gray-600 font-bold">$</span>
                        <input type="number" name="precio" required min="0" step="0.01" value="0"
                               placeholder="0.00"
                               class="w-full pl-8 pr-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500">
                    </div>
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Descripción (Opcional)</label>
                    <textarea name="descripcion" rows="3"
                              placeholder="Describe los beneficios y características de este plan..."
                              class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 resize-none"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" name="activo" checked
                               class="w-5 h-5 text-orange-500 rounded focus:ring-2 focus:ring-orange-500">
                        <span class="text-sm font-medium text-gray-700">Plan activo (visible para asignar a clientes)</span>
                    </label>
                </div>
            </div>

            <div id="planPreview" class="border-2 rounded-xl overflow-hidden transition-all" style="border-color: #FF6B00">
                <div class="p-6 text-white" style="background-color: #FF6B00">
                    <div class="flex items-center justify-between mb-4">
                        <span class="px-3 py-1 bg-white bg-opacity-20 rounded-full text-sm font-bold" id="previewTipo">
                            mensual
                        </span>
                    </div>
                    <h4 class="text-2xl font-bold mb-2" id="previewNombre">Nombre del Plan</h4>
                    <div class="flex items-baseline gap-1">
                        <span class="text-4xl font-bold">$<span id="previewPrecio">0</span></span>
                    </div>
                </div>
                <div class="p-6 bg-white">
                    <div class="flex items-center gap-3 mb-4">
                        <i data-lucide="calendar" class="w-5 h-5 text-gray-600"></i>
                        <span class="font-bold text-gray-800"><span id="previewDuracion">30</span> días</span>
                    </div>
                    <p class="text-sm text-gray-600" id="previewDescripcion">Sin descripción</p>
                </div>
            </div>

            <div class="flex gap-4">
                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-orange-500 to-orange-700 text-white font-bold py-3 px-6 rounded-lg hover:from-orange-600 hover:to-orange-800 transition flex items-center justify-center gap-2 shadow-lg">
                    <i data-lucide="check" class="w-5 h-5"></i>
                    Crear Plan
                </button>
                <a href="/membresias/planes"
                   class="flex-1 bg-gray-300 text-gray-700 font-bold py-3 px-6 rounded-lg hover:bg-gray-400 transition text-center flex items-center justify-center gap-2">
                    <i data-lucide="x" class="w-5 h-5"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const colorPicker = document.querySelector('input[name="color"]');
        const colorValue = document.getElementById('colorValue');
        const previewContainer = document.getElementById('planPreview');
        const previewHeader = previewContainer.querySelector('div[style*="background-color"]');

        function updatePreview() {
            const nombre = document.querySelector('input[name="nombre"]').value || 'Nombre del Plan';
            const tipo = document.querySelector('select[name="tipo"]').value || 'mensual';
            const duracion = document.querySelector('input[name="duracionDias"]').value || '30';
            const precio = document.querySelector('input[name="precio"]').value || '0';
            const descripcion = document.querySelector('textarea[name="descripcion"]').value || 'Sin descripción';
            const color = colorPicker.value;

            document.getElementById('previewNombre').textContent = nombre;
            document.getElementById('previewTipo').textContent = tipo;
            document.getElementById('previewDuracion').textContent = duracion;
            document.getElementById('previewPrecio').textContent = parseFloat(precio).toFixed(0);
            document.getElementById('previewDescripcion').textContent = descripcion;

            previewContainer.style.borderColor = color;
            previewHeader.style.backgroundColor = color;
        }

        colorPicker.addEventListener('input', function() {
            colorValue.value = this.value;
            updatePreview();
        });

        document.querySelector('input[name="nombre"]').addEventListener('input', updatePreview);
        document.querySelector('select[name="tipo"]').addEventListener('change', updatePreview);
        document.querySelector('input[name="duracionDias"]').addEventListener('input', updatePreview);
        document.querySelector('input[name="precio"]').addEventListener('input', updatePreview);
        document.querySelector('textarea[name="descripcion"]').addEventListener('input', updatePreview);

        document.getElementById('planForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const formData = new FormData(e.target);
            const data = {
                nombre: formData.get('nombre'),
                tipo: formData.get('tipo'),
                duracionDias: parseInt(formData.get('duracionDias')),
                precio: parseFloat(formData.get('precio')),
                color: formData.get('color'),
                descripcion: formData.get('descripcion'),
                activo: formData.get('activo') === 'on'
            };

            try {
                const response = await fetch('/api/Planes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    alert('✅ Plan creado exitosamente');
                    window.location.href = '/membresias/planes';
                } else {
                    const error = await response.text();
                    alert('❌ Error al crear plan: ' + error);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('❌ Error al crear plan: ' + error.message);
            }
        });

        lucide.createIcons();
        updatePreview();
    </script>
}

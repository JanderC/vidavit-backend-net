@model List<VidaFitBackend.Models.Plan>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Planes";
}

<style>
    .plan-card {
        background: #0D0D20;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.06);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .plan-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.4);
        }

        .plan-card.inactive {
            opacity: 0.5;
        }

    .stat-card {
        background: #0D0D20;
        border: 1px solid rgba(30,111,227,0.12);
        border-radius: 14px;
        padding: 20px 22px;
    }

    .action-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 12px;
        border-radius: 9px;
        font-weight: 800;
        font-size: 0.72rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        cursor: pointer;
        text-decoration: none;
        transition: opacity 0.15s, transform 0.15s;
        border: none;
    }

        .action-btn:hover {
            opacity: 0.85;
            transform: scale(1.02);
        }

    .action-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: none;
        transition: background 0.15s;
    }
</style>

<!-- Toolbar -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
    <div>
        <h2 style="font-family:'Bebas Neue',sans-serif;font-size:1.6rem;letter-spacing:3px;color:#fff;margin:0 0 4px 0;">Planes de Membresía</h2>
        <p style="font-size:0.78rem;color:rgba(255,255,255,0.35);font-weight:600;margin:0;">Administra los planes disponibles para tus clientes</p>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/membresias"
           style="display:inline-flex;align-items:center;gap:8px;padding:10px 18px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:rgba(255,255,255,0.5);font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border-radius:12px;text-decoration:none;transition:all 0.15s;"
           onmouseover="this.style.background='rgba(255,255,255,0.08)';this.style.color='rgba(255,255,255,0.8)'"
           onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.color='rgba(255,255,255,0.5)'">
            <i data-lucide="arrow-left" style="width:15px;height:15px;"></i>
            Volver
        </a>
        <a href="/membresias/planes/crear"
           style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border-radius:12px;text-decoration:none;transition:opacity 0.2s,transform 0.2s;"
           onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.02)'"
           onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
            <i data-lucide="plus" style="width:15px;height:15px;"></i>
            Crear Plan
        </a>
    </div>
</div>

<!-- Stats -->
@{
    var totalPlanes = Model.Count;
    var planesActivos = Model.Count(p => p.Activo);
    var precioPromedio = Model.Where(p => p.Activo).Any() ? Model.Where(p => p.Activo).Average(p => p.Precio) : 0;
    var durPromedio = Model.Where(p => p.Activo).Any() ? Model.Where(p => p.Activo).Average(p => p.DuracionDias) : 0;
}

<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px;">
    <div class="stat-card" style="border-left:3px solid #3D8EFF;">
        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Total Planes</p>
        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@totalPlanes</p>
    </div>
    <div class="stat-card" style="border-left:3px solid #10B981;">
        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Activos</p>
        <p style="font-size:2rem;font-weight:900;color:#10B981;margin:0;">@planesActivos</p>
    </div>
    <div class="stat-card" style="border-left:3px solid #6B3FA0;">
        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Precio Promedio</p>
        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">$@precioPromedio.ToString("N0")</p>
    </div>
    <div class="stat-card" style="border-left:3px solid #a78bfa;">
        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Duración Prom.</p>
        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@durPromedio.ToString("N0")d</p>
    </div>
</div>

<!-- Plans grid -->
<div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:16px;padding:24px;">
    <p style="font-size:0.65rem;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 20px 0;">Listado de Planes</p>

    @if (Model.Count == 0)
    {
        <div style="text-align:center;padding:48px 0;">
            <i data-lucide="inbox" style="width:48px;height:48px;color:rgba(255,255,255,0.15);margin:0 auto 14px;display:block;"></i>
            <p style="color:rgba(255,255,255,0.4);font-weight:700;margin:0 0 12px 0;">No hay planes registrados</p>
            <a href="/membresias/planes/crear"
               style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border-radius:10px;text-decoration:none;">
                Crear primer plan
            </a>
        </div>
    }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            @foreach (var plan in Model)
            {
                {
                    var tipoV = (plan.TipoCalculoVencimiento ?? "dias").ToLower();
                    var cantV = plan.CantidadUnidades;
                    string durLabel;
                    if (tipoV == "meses") durLabel = cantV == 1 ? "1 mes" : $"{cantV} meses";
                    else if (tipoV == "semanas") durLabel = cantV == 1 ? "1 semana" : $"{cantV} semanas";
                    else if (tipoV == "anios") durLabel = cantV == 1 ? "1 año" : $"{cantV} años";
                    else durLabel = $"{plan.DuracionDias} días";
                }
                <div class="plan-card @(!plan.Activo ? "inactive" : "")" style="border-color:@(plan.Color)40;">

                    <!-- Color header -->
                    <div style="padding:22px 20px;color:#fff;position:relative;overflow:hidden;background-color:@plan.Color;">
                        <div style="position:absolute;top:-20px;right:-20px;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,0.08);"></div>
                        <div style="position:relative;z-index:1;">
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                                <span style="padding:4px 12px;background:rgba(255,255,255,0.18);border-radius:100px;font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;">
                                    @plan.Tipo
                                </span>
                                @if (!plan.Activo)
                                {
                                    <span style="padding:4px 10px;background:rgba(248,113,113,0.3);border-radius:100px;font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#fff;">
                                        INACTIVO
                                    </span>
                                }
                            </div>
                            <h4 style="font-family:'Bebas Neue',sans-serif;font-size:1.5rem;letter-spacing:2px;margin:0 0 6px 0;">@plan.Nombre</h4>
                            <p style="font-size:2.2rem;font-weight:900;margin:0;line-height:1;">$@plan.Precio.ToString("N0")</p>
                        </div>
                    </div>

                    <!-- Body -->
                    <div style="padding:16px 20px;">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:@(!string.IsNullOrEmpty(plan.Descripcion) ? "12px" : "0");">
                            <div style="width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:@(plan.Color)20;flex-shrink:0;">
                                <i data-lucide="calendar" style="width:16px;height:16px;color:@plan.Color;"></i>
                            </div>
                            <div>
                                <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 3px 0;">Duración</p>
                                <p style="font-weight:800;color:#fff;margin:0;">@plan.DuracionDias</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(plan.Descripcion))
                        {
                            <p style="font-size:0.8rem;color:rgba(255,255,255,0.4);font-weight:600;margin:0 0 14px 0;padding-top:12px;border-top:1px solid rgba(255,255,255,0.06);">@plan.Descripcion</p>
                        }

                        <!-- Actions -->
                        <div style="display:flex;align-items:center;gap:6px;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.06);">
                            <a href="/membresias/planes/editar/@plan.Id" class="action-btn"
                               style="background:rgba(30,111,227,0.12);color:#3D8EFF;border:1px solid rgba(30,111,227,0.2);">
                                <i data-lucide="edit" style="width:14px;height:14px;"></i>
                                Editar
                            </a>
                            <button onclick="toggleActivoPlan('@plan.Id', @(plan.Activo ? "false" : "true"), '@plan.Nombre')"
                                    class="action-btn"
                                    style="background:@(plan.Activo ? "rgba(217,119,6,0.1)" : "rgba(16,185,129,0.1)");color:@(plan.Activo ? "#D97706" : "#10B981");border:1px solid @(plan.Activo ? "rgba(217,119,6,0.2)" : "rgba(16,185,129,0.2)");">
                                <i data-lucide="@(plan.Activo ? "toggle-right" : "toggle-left")" style="width:14px;height:14px;"></i>
                                @(plan.Activo ? "Desactivar" : "Activar")
                            </button>
                            <button onclick="eliminarPlan('@plan.Id', '@plan.Nombre')"
                                    class="action-icon"
                                    style="background:rgba(248,113,113,0.08);border:1px solid rgba(248,113,113,0.15);"
                                    onmouseover="this.style.background='rgba(248,113,113,0.18)'" onmouseout="this.style.background='rgba(248,113,113,0.08)'">
                                <i data-lucide="trash-2" style="width:15px;height:15px;color:#F87171;"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        async function eliminarPlan(id, nombre) {
            if (!confirm(`⚠️ ¿Eliminar el plan "${nombre}"?\n\nEsta acción no se puede deshacer.\nSi el plan tiene membresías asociadas, no se podrá eliminar.`)) return;
            try {
                const r = await fetch(`/api/Planes/${id}`, { method: 'DELETE' });
                if (r.ok) { alert(`✅ Plan "${nombre}" eliminado`); window.location.reload(); }
                else { const e = await r.json(); alert(`❌ Error: ${e.mensaje||'No se pudo eliminar'}`); }
            } catch(e) { alert('❌ Error: ' + e.message); }
        }

        async function toggleActivoPlan(id, nuevoEstado, nombre) {
            const accion = nuevoEstado === 'true' ? 'activar' : 'desactivar';
            if (!confirm(`¿${accion.charAt(0).toUpperCase()+accion.slice(1)} el plan "${nombre}"?`)) return;
            try {
                const r = await fetch(`/api/Planes/${id}/toggle-activo`, { method: 'PATCH' });
                if (r.ok) { alert(`✅ Plan "${nombre}" ${accion==='activar'?'activado':'desactivado'}`); window.location.reload(); }
                else { const e = await r.json(); alert(`❌ Error: ${e.mensaje||'No se pudo actualizar'}`); }
            } catch(e) { alert('❌ Error: ' + e.message); }
        }

        window.eliminarPlan      = eliminarPlan;
        window.toggleActivoPlan  = toggleActivoPlan;
        lucide.createIcons();
    </script>
}

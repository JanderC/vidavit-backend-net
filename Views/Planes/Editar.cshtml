@model VidaFitBackend.Models.Plan
@{
    ViewData["Title"] = "Editar Plan";
    Layout = "_AdminLayout";
}

<style>
    .tz-card {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.15);
        border-radius: 1rem;
        padding: 2rem;
    }

    .tz-label {
        display: block;
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #6b7280;
        margin-bottom: .4rem;
    }

        .tz-label .req {
            color: #ef4444;
        }

    .tz-input {
        width: 100%;
        padding: .7rem 1rem;
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        border-radius: .65rem;
        color: #f9fafb;
        font-weight: 600;
        font-size: .9rem;
        transition: border-color .2s, box-shadow .2s;
        box-sizing: border-box;
    }

        .tz-input::placeholder {
            color: #374151;
        }

        .tz-input:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }

    .tz-select {
        width: 100%;
        padding: .7rem 1rem;
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        border-radius: .65rem;
        color: #f9fafb;
        font-weight: 600;
        font-size: .9rem;
        transition: border-color .2s;
    }

        .tz-select:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }

    /* Plan header banner */
    .plan-banner {
        border-radius: .85rem;
        overflow: hidden;
        border: 2px solid @Model.Color;
        margin-bottom: 1.5rem;
    }

    .plan-banner-inner {
        padding: 1.5rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .plan-banner-inner::before {
            content: '';
            position: absolute;
            top: -2rem;
            right: -2rem;
            width: 8rem;
            height: 8rem;
            background: rgba(255,255,255,0.07);
            border-radius: 50%;
        }

        .plan-banner-inner::after {
            content: '';
            position: absolute;
            bottom: -1.5rem;
            left: -1.5rem;
            width: 5rem;
            height: 5rem;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }

    /* Color picker */
    .color-row {
        display: flex;
        gap: .65rem;
        align-items: center;
    }

    .color-picker-wrap {
        width: 3rem;
        height: 3rem;
        border-radius: .55rem;
        overflow: hidden;
        border: 2px solid rgba(34,197,94,0.25);
        flex-shrink: 0;
        cursor: pointer;
        position: relative;
    }

        .color-picker-wrap input[type=color] {
            width: 4rem;
            height: 4rem;
            margin: -.5rem;
            border: none;
            cursor: pointer;
            background: transparent;
        }
    /* Color dot on picker */
    .color-dot {
        position: absolute;
        top: -.2rem;
        right: -.2rem;
        width: .85rem;
        height: .85rem;
        border-radius: 50%;
        border: 2px solid #0d0d0d;
        background: @Model.Color;
        pointer-events: none;
    }

    /* Activo toggle box */
    .activo-box {
        padding: .85rem 1.1rem;
        border-radius: .65rem;
        border: 2px solid @Model.Color;
        background: @Model.Color + "10";
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        cursor: pointer;
        transition: border-color .2s;
    }

        .activo-box input[type=checkbox] {
            width: 1.15rem;
            height: 1.15rem;
            accent-color: #22c55e;
            cursor: pointer;
            margin-top: .15rem;
        }

    /* Buttons */
    .tz-btn-save {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .9rem 1.5rem;
        border-radius: .65rem;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        border: none;
        cursor: pointer;
        transition: all .2s;
        /* Color set dynamically */
    }

        .tz-btn-save:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 18px rgba(0,0,0,0.35);
        }

        .tz-btn-save:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }

    .tz-btn-ghost {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .9rem 1.5rem;
        border-radius: .65rem;
        background: transparent;
        border: 1px solid rgba(255,255,255,0.1);
        color: #6b7280;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        text-decoration: none;
        transition: all .2s;
    }

        .tz-btn-ghost:hover {
            border-color: rgba(34,197,94,0.25);
            color: #d1d5db;
        }
</style>

<!-- Plan header banner -->
<div class="plan-banner" id="planBanner" style="border-color: @Model.Color">
    <div class="plan-banner-inner" id="planBannerInner" style="background: linear-gradient(135deg, @Model.Color, @Model.Color)">
        <div style="position:relative;z-index:1">
            <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.4rem">
                <i data-lucide="edit-3" style="width:1.25rem;height:1.25rem"></i>
                <h2 style="font-size:1.35rem;font-weight:900;text-transform:uppercase;letter-spacing:.06em">Editar Plan</h2>
            </div>
            <p style="font-size:.8rem;font-weight:600;opacity:.85;margin-left:1.85rem">Modifica la información del plan de membresía</p>
        </div>
        <a href="/membresias/planes"
           style="display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1rem;border-radius:.55rem;background:rgba(255,255,255,0.15);color:#fff;font-weight:800;font-size:.75rem;text-decoration:none;text-transform:uppercase;letter-spacing:.07em;transition:background .2s;position:relative;z-index:1"
           onmouseover="this.style.background='rgba(255,255,255,0.25)'" onmouseout="this.style.background='rgba(255,255,255,0.15)'">
            <i data-lucide="arrow-left" style="width:.85rem;height:.85rem"></i>
            Volver
        </a>
    </div>
</div>

<div class="tz-card max-w-4xl mx-auto">
    <form id="planForm" class="space-y-5">
        <input type="hidden" id="planId" value="@Model.Id" />

        <!-- Nombre -->
        <div>
            <label class="tz-label" style="display:flex;align-items:center;gap:.35rem">
                <i data-lucide="tag" id="iconNombre" style="width:.75rem;height:.75rem;color:@Model.Color"></i>
                Nombre del Plan <span class="req">*</span>
            </label>
            <input type="text" id="nombre" value="@Model.Nombre" required class="tz-input" />
        </div>

        <!-- Descripción -->
        <div>
            <label class="tz-label" style="display:flex;align-items:center;gap:.35rem">
                <i data-lucide="align-left" id="iconDesc" style="width:.75rem;height:.75rem;color:@Model.Color"></i>
                Descripción
            </label>
            <textarea id="descripcion" rows="3" class="tz-input" style="resize:none">@Model.Descripcion</textarea>
        </div>

        <!-- Grid -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
            <!-- Tipo -->
            <div>
                <label class="tz-label" style="display:flex;align-items:center;gap:.35rem">
                    <i data-lucide="layers" id="iconTipo" style="width:.75rem;height:.75rem;color:@Model.Color"></i>
                    Tipo <span class="req">*</span>
                </label>
                <div style="position:relative">
                    <select id="tipo" required class="tz-select">
                        <option value="semanal" selected="@(Model.Tipo == "semanal"       ? "selected" : null)">📅 Semanal</option>
                        <option value="mensual" selected="@(Model.Tipo == "mensual"       ? "selected" : null)">📆 Mensual</option>
                        <option value="personalizado" selected="@(Model.Tipo == "personalizado" ? "selected" : null)">⚙️ Personalizado</option>
                        <option value="diario" selected="@(Model.Tipo == "diario"        ? "selected" : null)">☀️ Diario</option>
                        <option value="trimestral" selected="@(Model.Tipo == "trimestral"    ? "selected" : null)">📊 Trimestral</option>
                        <option value="semestral" selected="@(Model.Tipo == "semestral"     ? "selected" : null)">📈 Semestral</option>
                        <option value="anual" selected="@(Model.Tipo == "anual"         ? "selected" : null)">🎯 Anual</option>
                        <option value="otro" selected="@(Model.Tipo == "otro"          ? "selected" : null)">➕ Otro</option>
                    </select>
                    <i data-lucide="chevron-down" style="width:.85rem;height:.85rem;position:absolute;right:.85rem;top:50%;transform:translateY(-50%);pointer-events:none;color:#6b7280"></i>
                </div>
            </div>

            <!-- Duración -->
            <div>
                <label class="tz-label" style="display:flex;align-items:center;gap:.35rem">
                    <i data-lucide="calendar-days" id="iconDur" style="width:.75rem;height:.75rem;color:@Model.Color"></i>
                    Duración (días) <span class="req">*</span>
                </label>
                <div style="position:relative">
                    <input type="number" id="duracionDias" value="@Model.DuracionDias" required min="1" class="tz-input" style="padding-right:3.5rem" />
                    <span style="position:absolute;right:.9rem;top:50%;transform:translateY(-50%);color:#4b5563;font-weight:600;font-size:.78rem;pointer-events:none">días</span>
                </div>
            </div>

            <!-- Precio -->
            <div>
                <label class="tz-label" style="display:flex;align-items:center;gap:.35rem">
                    <i data-lucide="dollar-sign" id="iconPrice" style="width:.75rem;height:.75rem;color:@Model.Color"></i>
                    Precio <span class="req">*</span>
                </label>
                <div style="position:relative">
                    <span style="position:absolute;left:.9rem;top:50%;transform:translateY(-50%);color:#6b7280;font-weight:700">$</span>
                    <input type="number" id="precio" value="@Model.Precio" required min="0" step="0.01" class="tz-input" style="padding-left:1.75rem;font-weight:900" />
                </div>
            </div>

            <!-- Color -->
            <div>
                <label class="tz-label" style="display:flex;align-items:center;gap:.35rem">
                    <i data-lucide="palette" id="iconPalette" style="width:.75rem;height:.75rem;color:@Model.Color"></i>
                    Color de Identificación
                </label>
                <div class="color-row">
                    <div class="color-picker-wrap">
                        <input type="color" id="color" value="@Model.Color" />
                        <div class="color-dot" id="colorDot"></div>
                    </div>
                    <input type="text" id="colorHex" value="@Model.Color" placeholder="#22c55e"
                           class="tz-input" style="font-family:monospace;font-size:.85rem;text-transform:uppercase" />
                </div>
            </div>
        </div>

        <!-- Activo -->
        <label class="activo-box" id="activoBox">
            <input type="checkbox" id="activo" @(Model.Activo ? "checked" : "") />
            <div>
                <div style="display:flex;align-items:center;gap:.4rem">
                    <i data-lucide="check-circle" id="iconActivo" style="width:.9rem;height:.9rem;color:@Model.Color"></i>
                    <span style="font-weight:800;color:#d1d5db;font-size:.88rem">Plan Activo</span>
                </div>
                <p style="font-size:.72rem;color:#6b7280;font-weight:500;margin-top:.2rem">Los planes inactivos no estarán disponibles para nuevas membresías</p>
            </div>
        </label>

        <!-- Buttons -->
        <div style="display:flex;gap:.75rem;padding-top:1.25rem;border-top:1px solid rgba(34,197,94,0.1)">
            <button type="submit" id="btnGuardar" class="tz-btn-save"
                    style="background-color:@Model.Color;color:#fff">
                <i data-lucide="save" style="width:.9rem;height:.9rem"></i>
                <span>Guardar Cambios</span>
            </button>
            <a href="/membresias/planes" class="tz-btn-ghost">
                <i data-lucide="x-circle" style="width:.9rem;height:.9rem"></i>
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const planColorOriginal = '@Model.Color';

        // Luminance helper — determines readable text color on colored bg
        function getContrastColor(hex) {
            const r = parseInt(hex.substr(1,2),16);
            const g = parseInt(hex.substr(3,2),16);
            const b = parseInt(hex.substr(5,2),16);
            return (0.299*r + 0.587*g + 0.114*b)/255 > 0.5 ? '#1f2937' : '#ffffff';
        }

        const colorPicker = document.getElementById('color');
        const colorHex    = document.getElementById('colorHex');
        const colorDot    = document.getElementById('colorDot');
        const btn         = document.getElementById('btnGuardar');

        function applyColor(c) {
            // Banner
            document.getElementById('planBanner').style.borderColor = c;
            document.getElementById('planBannerInner').style.background = `linear-gradient(135deg, ${c}, ${c})`;
            // Activo box
            document.getElementById('activoBox').style.borderColor = c;
            document.getElementById('activoBox').style.backgroundColor = c + '12';
            // Color dot
            colorDot.style.backgroundColor = c;
            // Label icons
            ['iconNombre','iconDesc','iconTipo','iconDur','iconPrice','iconPalette','iconActivo'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.style.color = c;
            });
            // Save button
            btn.style.backgroundColor = c;
            btn.style.color = getContrastColor(c);
        }

        colorPicker.addEventListener('input', function () {
            const val = this.value.toUpperCase();
            colorHex.value = val;
            applyColor(val);
        });

        colorHex.addEventListener('input', function () {
            const val = this.value.trim();
            if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                colorPicker.value = val;
                applyColor(val.toUpperCase());
            }
        });

        // Submit
        document.getElementById('planForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const planId     = document.getElementById('planId').value;
            const nombreVal  = document.getElementById('nombre').value.trim();
            const tipoVal    = document.getElementById('tipo').value;
            const duracionVal= parseInt(document.getElementById('duracionDias').value);
            const precioVal  = parseFloat(document.getElementById('precio').value);
            const colorVal   = document.getElementById('color').value;

            if (!nombreVal)                          { alert('⚠️ El nombre es requerido'); return; }
            if (!tipoVal)                            { alert('⚠️ El tipo es requerido');   return; }
            if (isNaN(duracionVal)||duracionVal <= 0){ alert('⚠️ La duración debe ser mayor a 0'); return; }
            if (isNaN(precioVal)||precioVal <= 0)    { alert('⚠️ El precio debe ser mayor a 0');   return; }

            const data = {
                id:           planId,
                nombre:       nombreVal,
                descripcion:  document.getElementById('descripcion').value.trim() || null,
                tipo:         tipoVal,
                duracionDias: duracionVal,
                precio:       precioVal,
                color:        colorVal,
                activo:       document.getElementById('activo').checked
            };

            const originalHTML = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader" style="width:.9rem;height:.9rem"></i> <span>Guardando...</span>';
            lucide.createIcons();

            try {
                const resp = await fetch(`/api/Planes/${planId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (resp.ok || resp.status === 204) {
                    alert('✅ Plan actualizado exitosamente');
                    window.location.href = '/membresias/planes';
                } else {
                    let msg = 'Error desconocido';
                    try { const err = await resp.json(); msg = err.mensaje || err.title || JSON.stringify(err); }
                    catch { msg = await resp.text(); }
                    alert('❌ Error: ' + msg);
                }
            } catch (err) {
                alert('❌ Error al actualizar el plan: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHTML;
                lucide.createIcons();
                applyColor(colorVal);
            }
        });

        // Init
        document.addEventListener('DOMContentLoaded', function () {
            lucide.createIcons();
            applyColor(planColorOriginal);
        });
    </script>
}

@model VidaFitBackend.Models.Plan
@{
    ViewData["Title"] = "Editar Plan";
}

<style>
    :root {
        --pz-dark: #0f1535;
        --pz-dark2: #1a2050;
        --pz-card: #111827;
        --pz-border: #1f2a4a;
        --pz-text: #e5e5e5;
        --pz-muted: #6b7280;
    }

    .pz-page {
        background-color: var(--pz-dark);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .pz-card {
        background-color: var(--pz-card);
        border: 1px solid var(--pz-border);
        border-radius: 1rem;
    }

    .pz-label {
        color: var(--pz-text);
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .pz-input {
        width: 100%;
        background-color: #1a2050;
        border: 2px solid var(--pz-border);
        color: var(--pz-text);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }

        .pz-input:focus {
            border-color: #D4A017;
            box-shadow: 0 0 0 3px rgba(212,160,23,0.2);
        }

        .pz-input::placeholder {
            color: var(--pz-muted);
        }

    .pz-btn-primary {
        font-weight: 700;
        padding: 1rem 1.5rem;
        border-radius: 0.5rem;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: opacity 0.2s, transform 0.1s;
        flex: 1;
        background-color: @Model.Color;
    }

        .pz-btn-primary:hover {
            opacity: 0.85;
            transform: translateY(-1px);
        }

    .pz-btn-secondary {
        background-color: #1f2a4a;
        color: var(--pz-text);
        font-weight: 700;
        padding: 1rem 1.5rem;
        border-radius: 0.5rem;
        border: 1px solid var(--pz-border);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: background-color 0.2s;
        flex: 1;
        text-decoration: none;
    }

        .pz-btn-secondary:hover {
            background-color: #263060;
        }

    select.pz-input option {
        background-color: #1a2050;
    }
</style>

<div class="pz-page">
    <div class="max-w-4xl mx-auto space-y-6">

        <!-- Header con color del plan -->
        <div class="pz-card overflow-hidden" style="border: 2px solid @Model.Color;">
            <div class="p-6 relative overflow-hidden" style="background: linear-gradient(135deg, @Model.Color 0%, @Model.Color 100%); color: #0a0a0a;">
                <div style="position:absolute;top:0;right:0;width:10rem;height:10rem;background:rgba(0,0,0,0.1);border-radius:50%;transform:translate(2.5rem,-2.5rem);"></div>
                <div style="position:absolute;bottom:0;left:0;width:8rem;height:8rem;background:rgba(0,0,0,0.1);border-radius:50%;transform:translate(-2rem,2rem);"></div>
                <div style="position:relative;z-index:10;display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.5rem;">
                            <i data-lucide="edit-3" class="w-8 h-8"></i>
                            <h2 style="font-size:1.75rem;font-weight:900;">Editar Plan</h2>
                        </div>
                        <p style="opacity:0.75;margin-left:2.75rem;font-size:0.9rem;">Modifica la información del plan de membresía</p>
                        <div style="margin-top:0.75rem;margin-left:2.75rem;">
                            <span style="font-size:0.7rem;font-weight:900;letter-spacing:0.15em;opacity:0.6;background:rgba(0,0,0,0.15);padding:0.2rem 0.6rem;border-radius:9999px;">POWERZONE GYM</span>
                        </div>
                    </div>
                    <a href="/membresias/planes"
                       style="padding:0.6rem 1.25rem;background:rgba(0,0,0,0.2);color:#0a0a0a;font-weight:700;border-radius:0.5rem;display:flex;align-items:center;gap:0.5rem;transition:background 0.2s;text-decoration:none;">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        Volver
                    </a>
                </div>
            </div>
        </div>

        <!-- Formulario -->
        <div class="pz-card p-8">
            <form id="planForm" class="space-y-6">
                <input type="hidden" id="planId" value="@Model.Id">

                <!-- Nombre -->
                <div>
                    <label class="pz-label">
                        <i data-lucide="tag" class="w-4 h-4" style="color: @Model.Color"></i>
                        Nombre del Plan <span style="color:#ef4444;">*</span>
                    </label>
                    <input type="text" id="nombre" value="@Model.Nombre" required class="pz-input">
                </div>

                <!-- Descripción -->
                <div>
                    <label class="pz-label">
                        <i data-lucide="align-left" class="w-4 h-4" style="color: @Model.Color"></i>
                        Descripción
                    </label>
                    <textarea id="descripcion" rows="3" class="pz-input" style="resize:none;">@Model.Descripcion</textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Tipo -->
                    <div>
                        <label class="pz-label">
                            <i data-lucide="layers" class="w-4 h-4" style="color: @Model.Color"></i>
                            Tipo <span style="color:#ef4444;">*</span>
                        </label>
                        <div style="position:relative;">
                            <select id="tipo" required class="pz-input" style="appearance:none;cursor:pointer;">
                                <option value="semanal" selected="@(Model.Tipo == "semanal" ? "selected" : null)">📅 Semanal</option>
                                <option value="mensual" selected="@(Model.Tipo == "mensual" ? "selected" : null)">📆 Mensual</option>
                                <option value="personalizado" selected="@(Model.Tipo == "personalizado" ? "selected" : null)">⚙️ Personalizado</option>
                                <option value="diario" selected="@(Model.Tipo == "diario" ? "selected" : null)">☀️ Diario</option>
                                <option value="trimestral" selected="@(Model.Tipo == "trimestral" ? "selected" : null)">📊 Trimestral</option>
                                <option value="semestral" selected="@(Model.Tipo == "semestral" ? "selected" : null)">📈 Semestral</option>
                                <option value="anual" selected="@(Model.Tipo == "anual" ? "selected" : null)">🎯 Anual</option>
                                <option value="otro" selected="@(Model.Tipo == "otro" ? "selected" : null)">➕ Otro</option>
                            </select>
                            <i data-lucide="chevron-down" style="width:1.25rem;height:1.25rem;position:absolute;right:1rem;top:0.9rem;pointer-events:none;color:var(--pz-muted);"></i>
                        </div>
                    </div>

                    <!-- Duración -->
                    <div>
                        <label class="pz-label">
                            <i data-lucide="calendar-days" class="w-4 h-4" style="color: @Model.Color"></i>
                            Duración (días) <span style="color:#ef4444;">*</span>
                        </label>
                        <div style="position:relative;">
                            <input type="number" id="duracionDias" value="@Model.DuracionDias" required min="1" class="pz-input">
                            <span style="position:absolute;right:1rem;top:0.85rem;color:var(--pz-muted);font-weight:500;">días</span>
                        </div>
                    </div>

                    <!-- Precio -->
                    <div>
                        <label class="pz-label">
                            <i data-lucide="dollar-sign" class="w-4 h-4" style="color: @Model.Color"></i>
                            Precio <span style="color:#ef4444;">*</span>
                        </label>
                        <div style="position:relative;">
                            <span style="position:absolute;left:1rem;top:0.8rem;color:#D4A017;font-weight:700;font-size:1.1rem;">$</span>
                            <input type="number" id="precio" value="@Model.Precio" required min="0" step="0.01"
                                   class="pz-input" style="padding-left:2rem;font-weight:600;">
                        </div>
                    </div>

                    <!-- Color -->
                    <div>
                        <label class="pz-label">
                            <i data-lucide="palette" class="w-4 h-4" style="color: @Model.Color"></i>
                            Color de Identificación
                        </label>
                        <div style="display:flex;gap:0.75rem;">
                            <div style="position:relative;">
                                <input type="color" id="color" value="@Model.Color"
                                       style="height:3rem;width:4.5rem;border:2px solid var(--pz-border);border-radius:0.5rem;cursor:pointer;background:#1a2050;padding:0.2rem;">
                                <div style="position:absolute;top:-0.25rem;right:-0.25rem;width:1rem;height:1rem;border-radius:50%;border:2px solid #111827;background-color:@Model.Color;"></div>
                            </div>
                            <input type="text" id="colorHex" value="@Model.Color" placeholder="#2B4FD8"
                                   class="pz-input" style="flex:1;font-family:monospace;font-weight:700;text-transform:uppercase;">
                        </div>
                    </div>
                </div>

                <!-- Estado activo -->
                <div style="padding:1.25rem;border-radius:0.75rem;border:2px solid @Model.Color;background:@(Model.Color)18;">
                    <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
                        <input type="checkbox" id="activo" @(Model.Activo ? "checked" : "")
                               style="width:1.35rem;height:1.35rem;accent-color:#D4A017;border-radius:0.25rem;">
                        <div>
                            <span style="color:var(--pz-text);font-weight:700;display:flex;align-items:center;gap:0.5rem;font-size:1rem;">
                                <i data-lucide="check-circle" class="w-5 h-5" style="color:@Model.Color"></i>
                                Plan Activo
                            </span>
                            <p style="color:var(--pz-muted);font-size:0.8rem;margin-top:0.25rem;">Los planes inactivos no estarán disponibles para crear nuevas membresías</p>
                        </div>
                    </label>
                </div>

                <!-- Botones -->
                <div style="display:flex;gap:1rem;padding-top:1.5rem;border-top:1px solid var(--pz-border);">
                    <button type="submit" id="btnGuardar" class="pz-btn-primary" style="color:#0a0a0a;">
                        <i data-lucide="save" class="w-5 h-5"></i>
                        <span>Guardar Cambios</span>
                    </button>
                    <a href="/membresias/planes" class="pz-btn-secondary">
                        <i data-lucide="x-circle" class="w-5 h-5"></i>
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Lógica JS idéntica al original ──
        const planColor = '@Model.Color';

        function getContrastColor(hexColor) {
            const r = parseInt(hexColor.substr(1,2),16), g = parseInt(hexColor.substr(3,2),16), b = parseInt(hexColor.substr(5,2),16);
            return ((0.299*r + 0.587*g + 0.114*b)/255) > 0.5 ? '#0a0a0a' : '#ffffff';
        }

        function aplicarColorTextoBoton() {
            const btn = document.getElementById('btnGuardar');
            const textColor = getContrastColor(planColor);
            btn.style.color = textColor;
            const icon = btn.querySelector('[data-lucide]');
            if (icon) icon.style.color = textColor;
        }

        const colorPicker = document.getElementById('color');
        const colorHex = document.getElementById('colorHex');

        colorPicker.addEventListener('input', function() {
            colorHex.value = this.value.toUpperCase();
            actualizarVistaPreviaColor(this.value);
        });

        colorHex.addEventListener('input', function() {
            const value = this.value.trim();
            if (/^#[0-9A-F]{6}$/i.test(value)) { colorPicker.value = value; actualizarVistaPreviaColor(value); }
        });

        function actualizarVistaPreviaColor(color) {
            const btn = document.getElementById('btnGuardar');
            btn.style.backgroundColor = color;
            const textColor = getContrastColor(color);
            btn.style.color = textColor;
            const btnIcon = btn.querySelector('[data-lucide]');
            if (btnIcon) btnIcon.style.color = textColor;
            document.querySelectorAll('label [data-lucide]').forEach(icon => { if (icon.style.color) icon.style.color = color; });
        }

        document.querySelectorAll('input:not([type="checkbox"]):not([type="color"]), textarea, select').forEach(input => {
            input.addEventListener('focus', function() { this.style.borderColor = '#D4A017'; this.style.boxShadow = '0 0 0 3px rgba(212,160,23,0.2)'; });
            input.addEventListener('blur', function() { this.style.borderColor = ''; this.style.boxShadow = ''; });
        });

        document.getElementById('planForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const planId = document.getElementById('planId').value;
            const nombreVal = document.getElementById('nombre').value.trim();
            const tipoVal = document.getElementById('tipo').value;
            const duracionVal = parseInt(document.getElementById('duracionDias').value);
            const precioVal = parseFloat(document.getElementById('precio').value);
            const colorVal = document.getElementById('color').value;

            if (!nombreVal) { alert('⚠️ El nombre del plan es requerido'); return; }
            if (!tipoVal) { alert('⚠️ El tipo de plan es requerido'); return; }
            if (isNaN(duracionVal) || duracionVal <= 0) { alert('⚠️ La duración debe ser mayor a 0'); return; }
            if (isNaN(precioVal) || precioVal <= 0) { alert('⚠️ El precio debe ser mayor a 0'); return; }

            const data = { id:planId, nombre:nombreVal, descripcion:document.getElementById('descripcion').value.trim()||null, tipo:tipoVal, duracionDias:duracionVal, precio:precioVal, color:colorVal, activo:document.getElementById('activo').checked };

            const btn = document.getElementById('btnGuardar');
            const btnTexto = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader" class="w-5 h-5 animate-spin"></i> <span>Guardando...</span>';
            lucide.createIcons();

            try {
                const response = await fetch(`/api/Planes/${planId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok || response.status === 204) {
                    const successDiv = document.createElement('div');
                    successDiv.className = 'fixed top-4 right-4 px-6 py-4 rounded-lg shadow-2xl font-bold z-50 animate-bounce';
                    successDiv.style.backgroundColor = colorVal;
                    successDiv.style.color = getContrastColor(colorVal);
                    successDiv.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i>Plan actualizado exitosamente';
                    document.body.appendChild(successDiv);
                    lucide.createIcons();
                    setTimeout(() => { window.location.href = '/membresias/planes'; }, 1000);
                } else {
                    let errorMsg = 'Error desconocido';
                    try { const errorData = await response.json(); errorMsg = errorData.mensaje || errorData.title || JSON.stringify(errorData); }
                    catch { errorMsg = await response.text(); }
                    alert('❌ Error: ' + errorMsg);
                    btn.disabled = false; btn.innerHTML = btnTexto; lucide.createIcons(); aplicarColorTextoBoton();
                }
            } catch (error) {
                alert('❌ Error al actualizar el plan: ' + error.message);
                btn.disabled = false; btn.innerHTML = btnTexto; lucide.createIcons(); aplicarColorTextoBoton();
            }
        });

        document.addEventListener('DOMContentLoaded', function() { lucide.createIcons(); aplicarColorTextoBoton(); });
    </script>
}
@model VidaFitBackend.Models.Plan
@{
    ViewData["Title"] = "Editar Plan";
}

<div class="max-w-4xl mx-auto p-6">
    <!-- Header con el color del plan -->
    <div class="rounded-xl shadow-lg overflow-hidden mb-6" style="border: 3px solid @Model.Color">
        <div class="p-6 text-white relative overflow-hidden" style="background: linear-gradient(135deg, @Model.Color 0%, @Model.Color 100%);">
            <div class="absolute top-0 right-0 w-40 h-40 bg-white opacity-10 rounded-full -mr-20 -mt-20"></div>
            <div class="absolute bottom-0 left-0 w-32 h-32 bg-white opacity-10 rounded-full -ml-16 -mb-16"></div>

            <div class="relative z-10 flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <i data-lucide="edit-3" class="w-8 h-8"></i>
                        <h2 class="text-3xl font-bold">Editar Plan</h2>
                    </div>
                    <p class="text-white text-opacity-90 ml-11">Modifica la información del plan de membresía</p>
                </div>
                <a href="/membresias/planes"
                   class="px-5 py-2.5 bg-white bg-opacity-20 hover:bg-opacity-30 text-white font-bold rounded-lg transition-all backdrop-blur-sm flex items-center gap-2">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Volver
                </a>
            </div>
        </div>
    </div>

    <!-- Formulario -->
    <div class="bg-white rounded-xl shadow-lg p-8">
        <form id="planForm" class="space-y-6">
            <input type="hidden" id="planId" value="@Model.Id">

            <!-- Nombre -->
            <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 flex items-center gap-2">
                    <i data-lucide="tag" class="w-4 h-4" style="color: @Model.Color"></i>
                    Nombre del Plan <span class="text-red-500">*</span>
                </label>
                <input type="text" id="nombre" value="@Model.Nombre" required
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent text-gray-800 transition-all"
                       style="focus:ring-color: @Model.Color;">
            </div>

            <!-- Descripción -->
            <div class="group">
                <label class="block text-sm font-bold text-gray-700 mb-2 flex items-center gap-2">
                    <i data-lucide="align-left" class="w-4 h-4" style="color: @Model.Color"></i>
                    Descripción
                </label>
                <textarea id="descripcion" rows="3"
                          class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent text-gray-800 resize-none transition-all">@Model.Descripcion</textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Tipo -->
                <div class="group">
                    <label class="block text-sm font-bold text-gray-700 mb-2 flex items-center gap-2">
                        <i data-lucide="layers" class="w-4 h-4" style="color: @Model.Color"></i>
                        Tipo <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <select id="tipo" required
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent text-gray-800 appearance-none cursor-pointer transition-all">
                            <option value="semanal" selected="@(Model.Tipo == "semanal" ? "selected" : null)">📅 Semanal</option>
                            <option value="mensual" selected="@(Model.Tipo == "mensual" ? "selected" : null)">📆 Mensual</option>
                            <option value="personalizado" selected="@(Model.Tipo == "personalizado" ? "selected" : null)">⚙️ Personalizado</option>
                            <option value="diario" selected="@(Model.Tipo == "diario" ? "selected" : null)">☀️ Diario</option>
                            <option value="trimestral" selected="@(Model.Tipo == "trimestral" ? "selected" : null)">📊 Trimestral</option>
                            <option value="semestral" selected="@(Model.Tipo == "semestral" ? "selected" : null)">📈 Semestral</option>
                            <option value="anual" selected="@(Model.Tipo == "anual" ? "selected" : null)">🎯 Anual</option>
                            <option value="otro" selected="@(Model.Tipo == "otro" ? "selected" : null)">➕ Otro</option>
                        </select>
                        <i data-lucide="chevron-down" class="w-5 h-5 absolute right-3 top-3.5 pointer-events-none text-gray-500"></i>
                    </div>
                </div>

                <!-- Duración -->
                <div class="group">
                    <label class="block text-sm font-bold text-gray-700 mb-2 flex items-center gap-2">
                        <i data-lucide="calendar-days" class="w-4 h-4" style="color: @Model.Color"></i>
                        Duración (días) <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="number" id="duracionDias" value="@Model.DuracionDias" required min="1"
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent text-gray-800 transition-all">
                        <span class="absolute right-4 top-3.5 text-gray-400 font-medium">días</span>
                    </div>
                </div>

                <!-- Precio -->
                <div class="group">
                    <label class="block text-sm font-bold text-gray-700 mb-2 flex items-center gap-2">
                        <i data-lucide="dollar-sign" class="w-4 h-4" style="color: @Model.Color"></i>
                        Precio <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-4 top-3.5 text-gray-500 font-bold text-lg">$</span>
                        <input type="number" id="precio" value="@Model.Precio" required min="0" step="0.01"
                               class="w-full pl-9 pr-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent text-gray-800 font-semibold transition-all">
                    </div>
                </div>

                <!-- Color -->
                <div class="group">
                    <label class="block text-sm font-bold text-gray-700 mb-2 flex items-center gap-2">
                        <i data-lucide="palette" class="w-4 h-4" style="color: @Model.Color"></i>
                        Color de Identificación
                    </label>
                    <div class="flex gap-3">
                        <div class="relative">
                            <input type="color" id="color" value="@Model.Color"
                                   class="h-12 w-16 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-gray-400 transition-all">
                            <div class="absolute -top-1 -right-1 w-4 h-4 rounded-full border-2 border-white shadow-lg" style="background-color: @Model.Color"></div>
                        </div>
                        <input type="text" id="colorHex" value="@Model.Color" placeholder="#00FF00"
                               class="flex-1 px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:border-transparent text-gray-800 font-mono font-bold uppercase transition-all">
                    </div>
                </div>
            </div>

            <!-- Estado con diseño mejorado -->
            <div class="p-5 rounded-lg border-2 transition-all" style="border-color: @Model.Color; background-color: @(Model.Color)10;">
                <label class="flex items-center gap-3 cursor-pointer">
                    <div class="relative">
                        <input type="checkbox" id="activo" @(Model.Activo ? "checked" : "")
                               class="w-6 h-6 border-2 rounded focus:ring-2 cursor-pointer transition-all"
                               style="color: @Model.Color; border-color: @Model.Color;">
                    </div>
                    <div class="flex-1">
                        <span class="text-base font-bold text-gray-800 flex items-center gap-2">
                            <i data-lucide="check-circle" class="w-5 h-5" style="color: @Model.Color"></i>
                            Plan Activo
                        </span>
                        <p class="text-sm text-gray-600 mt-1">Los planes inactivos no estarán disponibles para crear nuevas membresías</p>
                    </div>
                </label>
            </div>

            <!-- Botones con el color del plan -->
            <div class="flex gap-4 pt-6 border-t-2 border-gray-200">
                <button type="submit" id="btnGuardar"
                        class="flex-1 font-bold py-4 px-6 rounded-lg transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2 transform hover:scale-105"
                        style="background-color: @Model.Color;">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    <span>Guardar Cambios</span>
                </button>
                <a href="/membresias/planes"
                   class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 font-bold py-4 px-6 rounded-lg transition-all text-center flex items-center justify-center gap-2 shadow-md hover:shadow-lg">
                    <i data-lucide="x-circle" class="w-5 h-5"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const planColor = '@Model.Color';

        // Función para determinar si un color es claro u oscuro
        function getContrastColor(hexColor) {
            // Convertir hex a RGB
            const r = parseInt(hexColor.substr(1, 2), 16);
            const g = parseInt(hexColor.substr(3, 2), 16);
            const b = parseInt(hexColor.substr(5, 2), 16);

            // Calcular luminosidad
            const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;

            // Si es claro, usar texto oscuro; si es oscuro, usar texto claro
            return luminance > 0.5 ? '#1f2937' : '#ffffff';
        }

        // Aplicar color de texto al botón
        function aplicarColorTextoBoton() {
            const btn = document.getElementById('btnGuardar');
            const textColor = getContrastColor(planColor);
            btn.style.color = textColor;

            // También aplicar a los iconos dentro del botón
            const icon = btn.querySelector('[data-lucide]');
            if (icon) {
                icon.style.color = textColor;
            }
        }

        // Sincronizar color picker con input hex
        const colorPicker = document.getElementById('color');
        const colorHex = document.getElementById('colorHex');

        colorPicker.addEventListener('input', function() {
            colorHex.value = this.value.toUpperCase();
            actualizarVistaPreviaColor(this.value);
        });

        colorHex.addEventListener('input', function() {
            const value = this.value.trim();
            if (/^#[0-9A-F]{6}$/i.test(value)) {
                colorPicker.value = value;
                actualizarVistaPreviaColor(value);
            }
        });

        function actualizarVistaPreviaColor(color) {
            // Actualizar el botón con el nuevo color
            const btn = document.getElementById('btnGuardar');
            btn.style.backgroundColor = color;

            const textColor = getContrastColor(color);
            btn.style.color = textColor;

            // Actualizar icono del botón
            const btnIcon = btn.querySelector('[data-lucide]');
            if (btnIcon) {
                btnIcon.style.color = textColor;
            }

            // Actualizar iconos de etiquetas con el nuevo color
            document.querySelectorAll('label [data-lucide]').forEach(icon => {
                if (icon.style.color) {
                    icon.style.color = color;
                }
            });
        }

        // Añadir efecto focus a los inputs
        document.querySelectorAll('input:not([type="checkbox"]):not([type="color"]), textarea, select').forEach(input => {
            input.addEventListener('focus', function() {
                this.style.borderColor = planColor;
                this.style.boxShadow = `0 0 0 3px ${planColor}20`;
            });

            input.addEventListener('blur', function() {
                this.style.borderColor = '';
                this.style.boxShadow = '';
            });
        });

        // Submit formulario
        document.getElementById('planForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const planId = document.getElementById('planId').value;
            const nombreVal = document.getElementById('nombre').value.trim();
            const tipoVal = document.getElementById('tipo').value;
            const duracionVal = parseInt(document.getElementById('duracionDias').value);
            const precioVal = parseFloat(document.getElementById('precio').value);
            const colorVal = document.getElementById('color').value;

            // Validaciones
            if (!nombreVal) {
                alert('⚠️ El nombre del plan es requerido');
                return;
            }

            if (!tipoVal) {
                alert('⚠️ El tipo de plan es requerido');
                return;
            }

            if (isNaN(duracionVal) || duracionVal <= 0) {
                alert('⚠️ La duración debe ser mayor a 0');
                return;
            }

            if (isNaN(precioVal) || precioVal <= 0) {
                alert('⚠️ El precio debe ser mayor a 0');
                return;
            }

            const data = {
                id: planId,
                nombre: nombreVal,
                descripcion: document.getElementById('descripcion').value.trim() || null,
                tipo: tipoVal,
                duracionDias: duracionVal,
                precio: precioVal,
                color: colorVal,
                activo: document.getElementById('activo').checked
            };

            const btn = document.getElementById('btnGuardar');
            const btnTexto = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader" class="w-5 h-5 animate-spin"></i> <span>Guardando...</span>';
            lucide.createIcons();

            try {
                const response = await fetch(`/api/Planes/${planId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok || response.status === 204) {
                    // Mostrar mensaje de éxito con el color del plan
                    const successDiv = document.createElement('div');
                    successDiv.className = 'fixed top-4 right-4 px-6 py-4 rounded-lg shadow-2xl font-bold z-50 animate-bounce';
                    successDiv.style.backgroundColor = colorVal;

                    const successTextColor = getContrastColor(colorVal);
                    successDiv.style.color = successTextColor;
                    successDiv.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i>Plan actualizado exitosamente';
                    document.body.appendChild(successDiv);
                    lucide.createIcons();

                    setTimeout(() => {
                        window.location.href = '/membresias/planes';
                    }, 1000);
                } else {
                    let errorMsg = 'Error desconocido';
                    try {
                        const errorData = await response.json();
                        errorMsg = errorData.mensaje || errorData.title || JSON.stringify(errorData);
                    } catch {
                        errorMsg = await response.text();
                    }
                    alert('❌ Error: ' + errorMsg);
                    btn.disabled = false;
                    btn.innerHTML = btnTexto;
                    lucide.createIcons();
                    aplicarColorTextoBoton();
                }
            } catch (error) {
                console.error('Error:', error);
                alert('❌ Error al actualizar el plan: ' + error.message);
                btn.disabled = false;
                btn.innerHTML = btnTexto;
                lucide.createIcons();
                aplicarColorTextoBoton();
            }
        });

        // Inicializar iconos y colores cuando el DOM esté listo
        document.addEventListener('DOMContentLoaded', function() {
            lucide.createIcons();
            aplicarColorTextoBoton();
        });
    </script>
}
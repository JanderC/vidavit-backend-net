@{
    ViewData["Title"] = "Login - Power Fitness Admin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - POWER FITNESS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
        }

        h1, h2 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 3px;
        }

        /* ── Background ── */
        .login-bg {
            background: #05050F;
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* subtle grid overlay */
        .login-bg::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(30,111,227,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(30,111,227,0.04) 1px, transparent 1px);
            background-size: 48px 48px;
            pointer-events: none;
        }

        /* static ambient orbs — no keyframes */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            opacity: 0.18;
        }
        .orb-1 { width: 420px; height: 420px; background: #1E6FE3; top: -100px; left: -80px; }
        .orb-2 { width: 360px; height: 360px; background: #6B3FA0; bottom: -80px; right: -60px; }

        /* ── Layout: side-by-side on wider screens ── */
        .login-card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 900px;
            display: flex;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid rgba(30,111,227,0.25);
            box-shadow: 0 32px 80px rgba(0,0,0,0.7);
        }

        /* Left panel — brand side */
        .brand-panel {
            width: 42%;
            flex-shrink: 0;
            background: linear-gradient(160deg, #0F1535 0%, #0A0A20 60%, #12082A 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 32px;
            border-right: 1px solid rgba(30,111,227,0.2);
            gap: 28px;
        }

        .brand-panel .logo-wrap {
            width: 160px;
            height: 160px;
            border-radius: 24px;
            background: rgba(30,111,227,0.08);
            border: 1px solid rgba(30,111,227,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .brand-panel .logo-wrap img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .brand-tagline {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            text-align: center;
        }

        .brand-name {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 2.8rem;
            letter-spacing: 6px;
            line-height: 1;
            text-align: center;
            background: linear-gradient(135deg, #3D8EFF, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand-badge {
            padding: 6px 18px;
            background: rgba(30,111,227,0.12);
            border: 1px solid rgba(30,111,227,0.3);
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #7EB8FF;
        }

        /* Right panel — form side */
        .form-panel {
            flex: 1;
            background: #080816;
            padding: 48px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 28px;
        }

        .form-panel .form-heading {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 2.4rem;
            letter-spacing: 4px;
            color: #fff;
        }

        .form-panel .form-sub {
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            margin-top: 2px;
        }

        .field-label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.5);
            margin-bottom: 10px;
        }

        .field-input {
            width: 100%;
            padding: 14px 18px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(30,111,227,0.2);
            border-radius: 12px;
            color: #fff;
            font-size: 0.95rem;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .field-input::placeholder { color: rgba(255,255,255,0.2); }

        .field-input:focus {
            border-color: #1E6FE3;
            box-shadow: 0 0 0 3px rgba(30,111,227,0.15);
        }

        .btn-submit {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #1E6FE3 0%, #6B3FA0 100%);
            color: #fff;
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.2rem;
            letter-spacing: 3px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
        }

        .btn-submit:hover {
            opacity: 0.9;
            transform: scale(1.02);
            box-shadow: 0 8px 24px rgba(30,111,227,0.4);
        }

        .error-box {
            background: rgba(30,111,227,0.08);
            border: 1px solid rgba(30,111,227,0.35);
            border-radius: 12px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #93B8FF;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .creds-box {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 12px;
            padding: 14px 18px;
        }

        .creds-title {
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.25);
            margin-bottom: 8px;
        }

        .creds-row {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.8rem;
            font-family: monospace;
            margin-bottom: 4px;
        }

        .creds-row span:first-child { color: rgba(255,255,255,0.35); }
        .creds-row span:last-child  { color: #7EB8FF; font-weight: 700; }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            text-decoration: none;
            transition: color 0.2s;
        }

        .back-link:hover { color: #7EB8FF; }
    </style>
</head>
<body>
    <div class="login-bg">
        <!-- ambient orbs -->
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>

        <div class="login-card">
            <!-- ── BRAND PANEL ── -->
            <div class="brand-panel">
                <div class="logo-wrap">
                    <img src="/images/power-fitness-logo.png" alt="Power Fitness" />
                </div>
                <div>
                    <div class="brand-name">POWER<br>FITNESS</div>
                </div>
                <div class="brand-tagline">Fuerza · Disciplina · Resultados</div>
                <div class="brand-badge">Acceso Administrativo</div>
            </div>

            <!-- ── FORM PANEL ── -->
            <div class="form-panel">
                <div>
                    <div class="form-heading">Iniciar Sesión</div>
                    <div class="form-sub">Panel de administración</div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="error-box">
                        <i data-lucide="alert-circle" style="width:18px;height:18px;flex-shrink:0;"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form method="post" action="/admin/login" style="display:flex;flex-direction:column;gap:20px;">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="field-label">
                            <i data-lucide="mail" style="width:14px;height:14px;"></i>
                            Correo Electrónico
                        </label>
                        <input type="email" name="email" required placeholder="admin@powerfitness.com"
                               class="field-input" />
                    </div>

                    <div>
                        <label class="field-label">
                            <i data-lucide="lock" style="width:14px;height:14px;"></i>
                            Contraseña
                        </label>
                        <input type="password" name="password" required placeholder="••••••••"
                               class="field-input" />
                    </div>

                    <button type="submit" class="btn-submit">
                        <i data-lucide="log-in" style="width:20px;height:20px;"></i>
                        Ingresar al Sistema
                    </button>
                </form>

                <div class="creds-box">
                    <div class="creds-title">Credenciales por defecto</div>
                    <div class="creds-row">
                        <span>Email</span>
                        <span>admin@powerfitness.com</span>
                    </div>
                    <div class="creds-row">
                        <span>Password</span>
                        <span>admin123</span>
                    </div>
                </div>

                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <a href="/kiosko" class="back-link">
                        <i data-lucide="arrow-left" style="width:14px;height:14px;"></i>
                        Volver al Kiosko
                    </a>
                    <span style="font-size:0.7rem;color:rgba(255,255,255,0.15);font-weight:700;letter-spacing:2px;">
                        POWER FITNESS © 2026
                    </span>
                </div>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>

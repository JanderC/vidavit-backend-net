@{
    ViewData["Title"] = "Login - Tauro GYM Admin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - TAURO GYM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'tauro-red': '#E31E24',
                        'tauro-dark': '#000000',
                        'tauro-gray': '#1a1a1a',
                        'tauro-accent': '#C41E23'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1, h2 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }

        {
            box-shadow: 0 0 20px rgba(227, 30, 36, 0.5);
        }

        50% {
            box-shadow: 0 0 40px rgba(227, 30, 36, 0.8);
        }

        }

        .bull-logo {
            animation: glow 3s ease-in-out infinite;
        }
    </style>
</head>
<body>
    <div class="min-h-screen bg-gradient-to-br from-tauro-dark via-tauro-gray to-black flex items-center justify-center p-4 relative overflow-hidden">
        <!-- Efectos de fondo -->
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-tauro-red rounded-full blur-3xl"></div>
            <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-tauro-red rounded-full blur-3xl"></div>
        </div>

        <div class="w-full max-w-md relative z-10">
            <!-- Logo -->
            <div class="text-center mb-8">
                <div class="mb-6 flex justify-center">
                    <div class="w-24 h-24 bg-gradient-to-br from-tauro-red to-tauro-accent rounded-full flex items-center justify-center bull-logo shadow-2xl">
                        <span class="text-5xl">🐂</span>
                    </div>
                </div>
                <h1 class="text-7xl font-black text-white mb-2">
                    TAURO <span class="text-tauro-red">GYM</span>
                </h1>
                <p class="text-gray-400 uppercase tracking-widest text-sm">Panel Administrativo</p>
            </div>

            <!-- Formulario de Login -->
            <div class="bg-tauro-gray/80 backdrop-blur-lg rounded-2xl border-2 border-tauro-red/30 shadow-2xl p-8">
                <div class="text-center mb-6">
                    <div class="w-20 h-20 bg-gradient-to-br from-tauro-red to-tauro-accent rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                        <i data-lucide="shield-check" class="w-10 h-10 text-white"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-white">Iniciar Sesión</h2>
                    <p class="text-gray-400 text-sm mt-1">Ingresa tus credenciales</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-900/30 border-2 border-red-500 rounded-lg p-4 mb-6 flex items-center gap-3">
                        <i data-lucide="alert-circle" class="w-5 h-5 text-red-400"></i>
                        <p class="text-red-300 text-sm">@ViewBag.Error</p>
                    </div>
                }

                <form method="post" action="/admin/login" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="block text-gray-300 text-sm font-semibold mb-2">
                            <i data-lucide="mail" class="w-4 h-4 inline mr-1"></i>
                            Correo Electrónico
                        </label>
                        <input type="email" name="email" required placeholder="admin@taurogym.com"
                               class="w-full px-4 py-3 bg-black/50 border-2 border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-tauro-red transition-colors" />
                    </div>

                    <div>
                        <label class="block text-gray-300 text-sm font-semibold mb-2">
                            <i data-lucide="lock" class="w-4 h-4 inline mr-1"></i>
                            Contraseña
                        </label>
                        <input type="password" name="password" required placeholder="••••••••"
                               class="w-full px-4 py-3 bg-black/50 border-2 border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-tauro-red transition-colors" />
                    </div>

                    <button type="submit"
                            class="w-full py-4 bg-gradient-to-r from-tauro-red to-tauro-accent hover:from-tauro-accent hover:to-tauro-red text-white font-bold rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-tauro-red/50 flex items-center justify-center gap-2">
                        <i data-lucide="log-in" class="w-5 h-5"></i>
                        <span>INGRESAR</span>
                    </button>
                </form>

                <div class="mt-6 pt-6 border-t-2 border-gray-700">
                    <p class="text-xs text-gray-500 text-center mb-2">Credenciales por defecto:</p>
                    <div class="bg-black/50 rounded-lg p-3 font-mono text-xs text-gray-400 text-center border border-gray-700">
                        <p>Email: <span class="text-tauro-red font-semibold">admin@taurogym.com</span></p>
                        <p>Password: <span class="text-tauro-red font-semibold">admin123</span></p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-6">
                <a href="/kiosko" class="text-gray-400 hover:text-tauro-red transition-colors inline-flex items-center gap-2 text-sm font-semibold">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Volver al Kiosko
                </a>
            </div>

            <p class="text-center text-gray-600 text-xs mt-8">
                TAURO GYM © 2024 - Todos los derechos reservados
            </p>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
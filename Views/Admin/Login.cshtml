@{
    ViewData["Title"] = "Login - Elite GYM Admin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - ELITE GYM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700;800;900&family=Rajdhani:wght@700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'elite-red': '#E31E24',
                        'elite-dark': '#000000',
                        'elite-gray': '#1a1a1a',
                        'elite-accent': '#C41E23',
                        'elite-white': '#FFFFFF'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
        }

        h1, h2 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 4px;
        }

        .elite-logo {
            font-family: 'Rajdhani', sans-serif;
            letter-spacing: 6px;
            text-shadow: 0 0 20px rgba(227, 30, 36, 0.5);
        }

        .logo-container {
            animation: pulse-glow 3s ease-in-out infinite;
        }

        .diagonal-lines {
            background-image: repeating-linear-gradient( 45deg, transparent, transparent 35px, rgba(227, 30, 36, 0.03) 35px, rgba(227, 30, 36, 0.03) 70px );
        }

        .elite-border {
            position: relative;
            border: 3px solid transparent;
            background: linear-gradient(135deg, #1a1a1a, #000) padding-box, linear-gradient(135deg, #E31E24, #C41E23) border-box;
        }

        .input-glow:focus {
            box-shadow: 0 0 20px rgba(227, 30, 36, 0.3);
        }

        .btn-elite {
            background: linear-gradient(135deg, #E31E24 0%, #C41E23 100%);
            position: relative;
            overflow: hidden;
        }

            .btn-elite::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
                transition: left 0.5s;
            }

            .btn-elite:hover::before {
                left: 100%;
            }

        .shield-icon {
            filter: drop-shadow(0 0 15px rgba(227, 30, 36, 0.6));
        }
    </style>
</head>
<body>
    <div class="min-h-screen bg-black relative overflow-hidden flex items-center justify-center p-4">
        <!-- Patrón de fondo diagonal -->
        <div class="absolute inset-0 diagonal-lines"></div>

        <!-- Efectos de luz ambiental -->
        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-0 left-1/4 w-96 h-96 bg-elite-red rounded-full blur-3xl animate-pulse"></div>
            <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-elite-accent rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        </div>

        <!-- Líneas decorativas -->
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-elite-red to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-elite-red to-transparent"></div>

        <div class="w-full max-w-md relative z-10">
            <!-- Logo y título principal -->
            <div class="text-center mb-10">
                <div class="mb-8 flex justify-center">
                    <div class="logo-container inline-block px-12 py-6 elite-border rounded-2xl transform hover:scale-105 transition-transform duration-300">
                        <h1 class="text-7xl font-black text-white elite-logo">
                            ELITE GYM
                        </h1>
                    </div>
                </div>
                <div class="inline-block px-8 py-3 bg-gradient-to-r from-elite-gray to-black elite-border rounded-full">
                    <p class="text-elite-red uppercase tracking-[0.3em] text-sm font-black">Panel Administrativo</p>
                </div>
            </div>

            <!-- Formulario de login -->
            <div class="elite-border rounded-3xl shadow-2xl p-8 relative overflow-hidden backdrop-blur-lg bg-gradient-to-br from-elite-gray/90 to-black/95">
                <!-- Efecto de brillo superior -->
                <div class="absolute top-0 right-0 w-40 h-40 bg-elite-red rounded-full blur-3xl opacity-20 -translate-y-1/2 translate-x-1/2"></div>

                <!-- Líneas decorativas internas -->
                <div class="absolute top-6 left-6 w-12 h-12 border-l-2 border-t-2 border-elite-red opacity-30"></div>
                <div class="absolute bottom-6 right-6 w-12 h-12 border-r-2 border-b-2 border-elite-red opacity-30"></div>

                <div class="text-center mb-8 relative z-10">
                    <div class="w-28 h-28 bg-gradient-to-br from-elite-red via-elite-accent to-elite-red rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-2xl transform hover:rotate-6 transition-all shield-icon">
                        <i data-lucide="shield-check" class="w-14 h-14 text-white"></i>
                    </div>
                    <h2 class="text-5xl font-black text-white uppercase tracking-wider mb-2">Iniciar Sesión</h2>
                    <div class="w-20 h-1 bg-gradient-to-r from-transparent via-elite-red to-transparent mx-auto mb-3"></div>
                    <p class="text-gray-400 text-sm mt-3 font-bold uppercase tracking-[0.2em]">Acceso al Sistema Elite</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-elite-red/20 elite-border rounded-xl p-4 mb-6 flex items-center gap-3 backdrop-blur-sm">
                        <i data-lucide="alert-circle" class="w-6 h-6 text-elite-red"></i>
                        <p class="text-red-300 text-sm font-bold">@ViewBag.Error</p>
                    </div>
                }

                <form method="post" action="/admin/login" class="space-y-6 relative z-10">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="block text-gray-300 text-sm font-black mb-3 uppercase tracking-[0.15em] flex items-center gap-2">
                            <i data-lucide="mail" class="w-4 h-4 text-elite-red"></i>
                            Correo Electrónico
                        </label>
                        <input type="email" name="email" required placeholder="admin@elitegym.com"
                               class="w-full px-6 py-5 bg-black/60 border-2 border-gray-700 rounded-xl text-white placeholder-gray-600 focus:outline-none focus:border-elite-red transition-all font-semibold input-glow" />
                    </div>

                    <div>
                        <label class="block text-gray-300 text-sm font-black mb-3 uppercase tracking-[0.15em] flex items-center gap-2">
                            <i data-lucide="lock" class="w-4 h-4 text-elite-red"></i>
                            Contraseña
                        </label>
                        <input type="password" name="password" required placeholder="••••••••"
                               class="w-full px-6 py-5 bg-black/60 border-2 border-gray-700 rounded-xl text-white placeholder-gray-600 focus:outline-none focus:border-elite-red transition-all font-semibold input-glow" />
                    </div>

                    <button type="submit"
                            class="w-full py-6 btn-elite text-white font-black text-lg rounded-xl transition-all duration-300 transform hover:scale-105 shadow-2xl hover:shadow-elite-red/50 flex items-center justify-center gap-3 uppercase tracking-[0.2em]">
                        <i data-lucide="log-in" class="w-6 h-6"></i>
                        <span>Ingresar al Sistema</span>
                    </button>
                </form>

                <div class="mt-8 pt-6 border-t-2 border-gray-800 relative z-10">
                    <p class="text-xs text-gray-500 text-center mb-4 uppercase tracking-[0.15em] font-black flex items-center justify-center gap-2">
                        <i data-lucide="key" class="w-3 h-3"></i>
                        Credenciales por defecto
                    </p>
                    <div class="bg-black/70 rounded-xl p-5 font-mono text-xs text-center elite-border">
                        <div class="flex items-center justify-center gap-3 mb-3">
                            <span class="text-gray-400 font-bold">Email:</span>
                            <span class="text-elite-red font-black tracking-wide">admin@elitegym.com</span>
                        </div>
                        <div class="flex items-center justify-center gap-3">
                            <span class="text-gray-400 font-bold">Password:</span>
                            <span class="text-elite-red font-black tracking-wide">admin123</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Enlaces de navegación -->
            <div class="text-center mt-8">
                <a href="/kiosko" class="text-gray-400 hover:text-elite-red transition-colors inline-flex items-center gap-2 text-sm font-black uppercase tracking-[0.15em] group">
                    <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-2 transition-transform"></i>
                    Volver al Kiosko
                </a>
            </div>

            <!-- Footer -->
            <div class="mt-10 text-center">
                <div class="inline-block px-8 py-3 bg-gradient-to-r from-elite-gray to-black elite-border rounded-full">
                    <p class="text-gray-600 text-xs font-black uppercase tracking-[0.2em] flex items-center gap-2">
                        <i data-lucide="shield" class="w-3 h-3"></i>
                        ELITE GYM © 2024
                        <i data-lucide="shield" class="w-3 h-3"></i>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>

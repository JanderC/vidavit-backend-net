@{
    ViewData["Title"] = "Login - Power Fitness Admin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - POWER FITNESS</title>
    <style>
        /* =============================================
           POWER FITNESS — PALETA DEL LOGO
           Azul eléctrico + Azul profundo + Púrpura
        ============================================= */
        :root {
            --pf-blue:        #3B82F6;   /* azul principal logo */
            --pf-blue-bright: #60A5FA;   /* azul claro/neón */
            --pf-blue-deep:   #1E3A8A;   /* azul marino oscuro */
            --pf-purple:      #7C3AED;   /* púrpura logo */
            --pf-purple-dark: #4C1D95;   /* púrpura profundo */
            --pf-dark:        #060B18;   /* fondo más oscuro */
            --pf-dark-card:   #0D1526;   /* tarjeta oscura */
            --pf-dark-border: #1E2D4A;   /* borde sutil */
            --pf-text:        #E2E8F0;
            --pf-text-muted:  #64748B;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

    

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--pf-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            position: relative;
            overflow: hidden;
        }

        /* ─── Fondo animado ─── */
        .bg-layer {
            position: fixed;
            inset: 0;
            z-index: 0;
        }

        /* Grid hexagonal */
        .bg-grid {
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(59,130,246,.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(59,130,246,.06) 1px, transparent 1px);
            background-size: 48px 48px;
        }

        /* Orbes de luz */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            animation: orb-pulse 6s ease-in-out infinite;
        }
        .orb-1 {
            width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(59,130,246,.25), transparent 70%);
            top: -150px; left: -100px;
            animation-delay: 0s;
        }
        .orb-2 {
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(124,58,237,.2), transparent 70%);
            bottom: -100px; right: -80px;
            animation-delay: 2s;
        }
        .orb-3 {
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(30,58,138,.3), transparent 70%);
            top: 40%; left: 60%;
            animation-delay: 4s;
        }

      
        /* Partículas flotantes */
        .particles { position: absolute; inset: 0; overflow: hidden; }
        .particle {
            position: absolute;
            width: 3px; height: 3px;
            background: var(--pf-blue-bright);
            border-radius: 50%;
            animation: float-up linear infinite;
            opacity: 0;
        }
   

        /* ─── Contenedor principal ─── */
        .login-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 440px;
        }

        /* ─── Logo / Header ─── */
        .brand-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .brand-logo-box {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            gap: .25rem;
            padding: 1rem 2.5rem;
            background: linear-gradient(135deg, var(--pf-blue-deep) 0%, var(--pf-purple-dark) 100%);
            border-radius: 1.25rem;
            border: 2px solid rgba(96,165,250,.3);
            box-shadow: 0 0 40px rgba(59,130,246,.25), inset 0 1px 0 rgba(255,255,255,.08);
            margin-bottom: 1rem;
            animation: logo-glow 3s ease-in-out infinite;
        }


        .brand-word-power {
            font-size: 2.8rem;
            font-weight: 900;
            letter-spacing: .18em;
            color: #fff;
            text-transform: uppercase;
            line-height: 1;
            text-shadow: 0 0 20px rgba(96,165,250,.6);
        }
        .brand-word-fitness {
            font-size: 1.05rem;
            font-weight: 800;
            letter-spacing: .45em;
            color: var(--pf-blue-bright);
            text-transform: uppercase;
            text-shadow: 0 0 10px rgba(96,165,250,.8);
        }

        .brand-badge {
            display: inline-block;
            padding: .35rem 1.25rem;
            background: rgba(30,58,138,.6);
            border: 1px solid rgba(96,165,250,.25);
            border-radius: 999px;
            color: var(--pf-blue-bright);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .2em;
            text-transform: uppercase;
        }

        /* ─── Tarjeta de login ─── */
        .login-card {
            background: linear-gradient(145deg, var(--pf-dark-card) 0%, rgba(6,11,24,.9) 100%);
            border: 1px solid var(--pf-dark-border);
            border-radius: 1.5rem;
            padding: 2.25rem;
            position: relative;
            overflow: hidden;
            box-shadow:
                0 25px 60px rgba(0,0,0,.6),
                0 0 0 1px rgba(59,130,246,.1),
                inset 0 1px 0 rgba(255,255,255,.04);
        }

        /* Borde superior brillante */
        .login-card::before {
            content: '';
            position: absolute;
            top: 0; left: 10%; right: 10%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--pf-blue), var(--pf-purple), transparent);
            border-radius: 999px;
        }

        /* Brillo esquina */
        .login-card::after {
            content: '';
            position: absolute;
            top: -60px; right: -60px;
            width: 160px; height: 160px;
            background: radial-gradient(circle, rgba(59,130,246,.12), transparent 70%);
            border-radius: 50%;
        }

        /* ─── Ícono escudo ─── */
        .shield-wrap {
            text-align: center;
            margin-bottom: 1.75rem;
        }

        .shield-icon {
            width: 72px; height: 72px;
            background: linear-gradient(135deg, var(--pf-blue) 0%, var(--pf-purple) 100%);
            border-radius: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 32px rgba(59,130,246,.35);
            margin-bottom: 1rem;
            transition: transform .3s;
        }
        .shield-icon:hover { transform: rotate(3deg) scale(1.05); }

        .shield-icon svg {
            width: 36px; height: 36px;
            stroke: #fff;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .card-title {
            color: #fff;
            font-size: 1.6rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .card-subtitle {
            color: var(--pf-text-muted);
            font-size: .75rem;
            font-weight: 600;
            letter-spacing: .15em;
            text-transform: uppercase;
            margin-top: .3rem;
        }

        /* ─── Error ─── */
        .error-box {
            background: rgba(59,130,246,.08);
            border: 1px solid rgba(239,68,68,.4);
            border-radius: .875rem;
            padding: .9rem 1.1rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: .75rem;
        }
        .error-box svg {
            flex-shrink: 0;
            width: 20px; height: 20px;
            stroke: #EF4444;
            fill: none; stroke-width: 2;
            stroke-linecap: round; stroke-linejoin: round;
        }
        .error-box p { color: #FCA5A5; font-size: .85rem; font-weight: 600; }

        /* ─── Formulario ─── */
        .form-group { margin-bottom: 1.4rem; }

        .form-label {
            display: block;
            color: var(--pf-blue-bright);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .15em;
            text-transform: uppercase;
            margin-bottom: .6rem;
        }
        .form-label svg {
            width: 14px; height: 14px;
            display: inline-block;
            vertical-align: middle;
            margin-right: .4rem;
            stroke: currentColor;
            fill: none; stroke-width: 2;
            stroke-linecap: round; stroke-linejoin: round;
        }

        .form-input {
            width: 100%;
            padding: .9rem 1.1rem;
            background: rgba(255,255,255,.04);
            border: 1.5px solid var(--pf-dark-border);
            border-radius: .875rem;
            color: var(--pf-text);
            font-size: .95rem;
            font-weight: 600;
            font-family: inherit;
            transition: border-color .25s, box-shadow .25s, background .25s;
            outline: none;
        }
        .form-input::placeholder { color: var(--pf-text-muted); font-weight: 400; }
        .form-input:focus {
            border-color: var(--pf-blue);
            background: rgba(59,130,246,.06);
            box-shadow: 0 0 0 3px rgba(59,130,246,.15), 0 0 20px rgba(59,130,246,.1);
        }
        .form-input:hover:not(:focus) { border-color: rgba(59,130,246,.4); }

        /* ─── Botón submit ─── */
        .btn-submit {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(135deg, var(--pf-blue) 0%, var(--pf-purple) 100%);
            color: #fff;
            font-size: 1rem;
            font-weight: 800;
            font-family: inherit;
            letter-spacing: .12em;
            text-transform: uppercase;
            border: none;
            border-radius: .875rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .6rem;
            transition: transform .25s, box-shadow .25s, opacity .25s;
            box-shadow: 0 4px 20px rgba(59,130,246,.35);
            position: relative;
            overflow: hidden;
            margin-top: .5rem;
        }
        .btn-submit::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,.1), transparent);
            opacity: 0;
            transition: opacity .25s;
        }
        .btn-submit:hover {
            transform: translateY(-2px) scale(1.01);
            box-shadow: 0 8px 35px rgba(59,130,246,.5), 0 0 60px rgba(124,58,237,.2);
        }
        .btn-submit:hover::before { opacity: 1; }
        .btn-submit:active { transform: translateY(0) scale(.98); }
        .btn-submit svg {
            width: 20px; height: 20px;
            stroke: currentColor; fill: none;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }

        /* ─── Credenciales info ─── */
        .cred-section {
            margin-top: 1.75rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--pf-dark-border);
        }
        .cred-title {
            color: var(--pf-text-muted);
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .18em;
            text-transform: uppercase;
            text-align: center;
            margin-bottom: .75rem;
        }
        .cred-box {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--pf-dark-border);
            border-radius: .875rem;
            padding: .9rem 1.1rem;
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: .8rem;
        }
        .cred-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .6rem;
            padding: .2rem 0;
        }
        .cred-key { color: var(--pf-text-muted); }
        .cred-val { color: var(--pf-blue-bright); font-weight: 700; }

        /* ─── Footer link ─── */
        .footer-area {
            text-align: center;
            margin-top: 1.75rem;
        }
        .back-link {
            color: var(--pf-text-muted);
            text-decoration: none;
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            transition: color .2s, gap .2s;
        }
        .back-link svg {
            width: 14px; height: 14px;
            stroke: currentColor; fill: none;
            stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
            transition: transform .2s;
        }
        .back-link:hover { color: var(--pf-blue-bright); }
        .back-link:hover svg { transform: translateX(-3px); }

        .copyright {
            margin-top: 1.25rem;
        }
        .copyright-badge {
            display: inline-block;
            padding: .35rem 1.25rem;
            background: rgba(13,21,38,.8);
            border: 1px solid var(--pf-dark-border);
            border-radius: 999px;
            color: var(--pf-text-muted);
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

    </style>
</head>
<body>

    <!-- Capa de fondo -->
    <div class="bg-layer">
        <div class="bg-grid"></div>
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="particles" id="particles"></div>
    </div>

    <!-- Contenido -->
    <div class="login-wrapper">

        <!-- Marca -->
        <div class="brand-header">
            <div class="brand-logo-box">
                <span class="brand-word-power">Power</span>
                <span class="brand-word-fitness">Fitness</span>
            </div>
            <div class="brand-badge">Panel Administrativo</div>
        </div>

        <!-- Tarjeta -->
        <div class="login-card">

            <!-- Ícono -->
            <div class="shield-wrap">
                <div class="shield-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <polyline points="9,12 11,14 15,10" />
                    </svg>
                </div>
                <div class="card-title">Iniciar Sesión</div>
                <div class="card-subtitle">Acceso al Sistema</div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="error-box">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    <p>@ViewBag.Error</p>
                </div>
            }

            <form method="post" action="/admin/login">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">
                        <svg viewBox="0 0 24 24">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22,6 12,13 2,6" />
                        </svg>
                        Correo Electrónico
                    </label>
                    <input type="email" name="email" required
                           placeholder="admin@powerfitness.com"
                           class="form-input" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        Contraseña
                    </label>
                    <input type="password" name="password" required
                           placeholder="••••••••"
                           class="form-input" />
                </div>

                <button type="submit" class="btn-submit">
                    <svg viewBox="0 0 24 24">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        <polyline points="10,17 15,12 10,7" />
                        <line x1="15" y1="12" x2="3" y2="12" />
                    </svg>
                    Ingresar al Sistema
                </button>
            </form>

            <div class="cred-section">
                <p class="cred-title">Credenciales por defecto</p>
                <div class="cred-box">
                    <div class="cred-row">
                        <span class="cred-key">Email:</span>
                        <span class="cred-val">admin@powerfitness.com</span>
                    </div>
                    <div class="cred-row">
                        <span class="cred-key">Password:</span>
                        <span class="cred-val">admin123</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer-area">
            <a href="/kiosko" class="back-link">
                <svg viewBox="0 0 24 24">
                    <line x1="19" y1="12" x2="5" y2="12" />
                    <polyline points="12,19 5,12 12,5" />
                </svg>
                Volver al Kiosko
            </a>
            <div class="copyright">
                <span class="copyright-badge">Power Fitness © 2025</span>
            </div>
        </div>
    </div>

    <script>
        // Generar partículas flotantes (sin CDN)
        (function () {
            const container = document.getElementById('particles');
            const count = 30;
            for (let i = 0; i < count; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                p.style.left = Math.random() * 100 + 'vw';
                p.style.animationDuration = (8 + Math.random() * 14) + 's';
                p.style.animationDelay = (Math.random() * 12) + 's';
                p.style.width = p.style.height = (2 + Math.random() * 3) + 'px';
                // Alternar entre azul y púrpura
                p.style.background = Math.random() > .5 ? '#60A5FA' : '#A78BFA';
                container.appendChild(p);
            }
        })();
    </script>
</body>
</html>

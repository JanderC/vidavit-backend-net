@{
    Layout = "_Layout";
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="min-h-screen bg-gradient-to-br from-vida-dark via-black to-vida-gray flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <!-- Logo -->
        <div class="text-center mb-8">
            <h1 class="text-6xl font-black text-white mb-2">
                VIDA <span class="text-vida-primary">FIT</span>
            </h1>
            <p class="text-gray-400 uppercase tracking-widest text-sm">Panel Administrativo</p>
        </div>

        <!-- Formulario de Login -->
        <div class="bg-vida-gray rounded-2xl border-2 border-gray-800 shadow-2xl p-8">
            <div class="text-center mb-6">
                <div class="w-20 h-20 bg-vida-primary rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="user" class="w-10 h-10 text-vida-dark"></i>
                </div>
                <h2 class="text-2xl font-bold text-white">Iniciar Sesión</h2>
                <p class="text-gray-400 text-sm mt-1">Ingresa tus credenciales</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="bg-red-900/30 border border-red-500 rounded-lg p-4 mb-6 flex items-center gap-3">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-red-400"></i>
                    <p class="text-red-300 text-sm">@ViewBag.Error</p>
                </div>
            }

            <form method="post" action="/admin/login" class="space-y-4">
                <!-- Email -->
                <div>
                    <label class="block text-gray-300 text-sm font-medium mb-2">
                        <i data-lucide="mail" class="w-4 h-4 inline mr-1"></i>
                        Correo Electrónico
                    </label>
                    <input type="email"
                           name="email"
                           required
                           placeholder="admin@vidafit.com"
                           class="w-full px-4 py-3 bg-vida-dark border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-vida-primary transition-colors" />
                </div>

                <!-- Password -->
                <div>
                    <label class="block text-gray-300 text-sm font-medium mb-2">
                        <i data-lucide="lock" class="w-4 h-4 inline mr-1"></i>
                        Contraseña
                    </label>
                    <input type="password"
                           name="password"
                           required
                           placeholder="••••••••"
                           class="w-full px-4 py-3 bg-vida-dark border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-vida-primary transition-colors" />
                </div>

                <!-- Botón Submit -->
                <button type="submit"
                        class="w-full py-3 bg-vida-primary hover:bg-vida-accent text-vida-dark font-bold rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-vida-primary/50 flex items-center justify-center gap-2">
                    <i data-lucide="log-in" class="w-5 h-5"></i>
                    <span>Ingresar</span>
                </button>
            </form>

            <!-- Credenciales por defecto (solo en desarrollo) -->
            <div class="mt-6 pt-6 border-t border-gray-700">
                <p class="text-xs text-gray-500 text-center mb-2">Credenciales por defecto:</p>
                <div class="bg-vida-dark rounded-lg p-3 font-mono text-xs text-gray-400 text-center">
                    <p>Email: <span class="text-vida-primary">admin@vidafit.com</span></p>
                    <p>Password: <span class="text-vida-primary">admin123</span></p>
                </div>
            </div>
        </div>

        <!-- Volver al Kiosko -->
        <div class="text-center mt-6">
            <a href="/kiosko" class="text-gray-400 hover:text-vida-primary transition-colors inline-flex items-center gap-2 text-sm">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Volver al Kiosko
            </a>
        </div>

        <!-- Footer -->
        <p class="text-center text-gray-600 text-xs mt-8">
            VIDA FIT © 2024 - Todos los derechos reservados
        </p>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
@{
    ViewData["Title"] = "Login - ELITE GYM Admin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - ELITE GYM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@300;400;500;600;700&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'elite-red': '#E31E24',
                        'elite-dark': '#000000',
                        'elite-gray': '#1a1a1a',
                        'elite-white': '#FFFFFF',
                        'elite-accent': '#C41E23'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1, h2 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 4px;
        }

        .logo-glow {
            animation: logo-pulse 2s ease-in-out infinite;
            filter: drop-shadow(0 0 20px rgba(227, 30, 36, 0.6));
        }

        .diagonal-pattern {
            background-image:
                repeating-linear-gradient(
                    45deg,
                    transparent,
                    transparent 10px,
                    rgba(227, 30, 36, 0.03) 10px,
                    rgba(227, 30, 36, 0.03) 20px
                );
        }

        .elite-border {
            position: relative;
        }

        .elite-border::before {
            content: '';
            position: absolute;
            inset: -3px;
            background: linear-gradient(45deg, #E31E24, #FFFFFF, #E31E24);
            border-radius: 1.5rem;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: -1;
        }

        .elite-border:hover::before {
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <div class="min-h-screen bg-black relative overflow-hidden flex items-center justify-center p-4">
        <!-- Patrón de fondo -->
        <div class="absolute inset-0 diagonal-pattern"></div>

        <!-- Efectos de luz -->
        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-red-600 rounded-full blur-[100px]"></div>
            <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-red-800 rounded-full blur-[100px]" style="animation: pulse 4s ease-in-out infinite;"></div>
        </div>

        <!-- Líneas decorativas -->
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-red-600 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-red-600 to-transparent"></div>

        <div class="w-full max-w-md relative z-10">
            <!-- Logo y Título -->
            <div class="text-center mb-12">
                <div class="mb-8 flex justify-center">
                    <img src="/images/LogoElite.jpeg" alt="ELITE GYM Logo" class="h-32 w-auto logo-glow" />
                </div>
                <div class="inline-block px-8 py-3 bg-gradient-to-r from-red-600/20 via-red-600/30 to-red-600/20 border-2 border-red-600 rounded-full backdrop-blur-sm">
                    <p class="text-red-500 uppercase tracking-[0.3em] text-sm font-black">Panel Administrativo</p>
                </div>
            </div>

            <!-- Formulario de Login -->
            <div class="elite-border bg-gradient-to-br from-gray-900/90 via-black/95 to-gray-900/90 backdrop-blur-xl rounded-3xl border-2 border-red-600/50 shadow-2xl shadow-red-600/20 p-10 relative overflow-hidden">
                <!-- Líneas decorativas internas -->
                <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-red-600 to-transparent"></div>
                <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-red-600 to-transparent"></div>

                <!-- Efectos de esquina -->
                <div class="absolute top-0 left-0 w-20 h-20 border-t-2 border-l-2 border-red-600/50"></div>
                <div class="absolute top-0 right-0 w-20 h-20 border-t-2 border-r-2 border-red-600/50"></div>
                <div class="absolute bottom-0 left-0 w-20 h-20 border-b-2 border-l-2 border-red-600/50"></div>
                <div class="absolute bottom-0 right-0 w-20 h-20 border-b-2 border-r-2 border-red-600/50"></div>

                <div class="text-center mb-10 relative z-10">
                    <div class="w-20 h-20 bg-gradient-to-br from-red-600 to-red-900 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-xl shadow-red-600/50 transform hover:scale-110 transition-all">
                        <i data-lucide="shield-check" class="w-10 h-10 text-white"></i>
                    </div>
                    <h2 class="text-5xl font-black text-white uppercase tracking-[0.2em] mb-2">Acceso</h2>
                    <div class="w-24 h-1 bg-gradient-to-r from-transparent via-red-600 to-transparent mx-auto mb-3"></div>
                    <p class="text-gray-400 text-sm font-bold uppercase tracking-[0.2em]">Sistema Administrativo</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-900/30 border-2 border-red-500/80 rounded-2xl p-4 mb-6 flex items-center gap-3 backdrop-blur-sm relative z-10">
                        <i data-lucide="alert-circle" class="w-6 h-6 text-red-400"></i>
                        <p class="text-red-300 text-sm font-semibold">@ViewBag.Error</p>
                    </div>
                }

                <form method="post" action="/admin/login" class="space-y-6 relative z-10">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="block text-gray-300 text-xs font-bold mb-3 uppercase tracking-[0.2em]">
                            <i data-lucide="mail" class="w-4 h-4 inline mr-2"></i>
                            Correo Electrónico
                        </label>
                        <input type="email" name="email" required placeholder="admin@elitegym.com"
                               class="w-full px-6 py-4 bg-black/70 border-2 border-gray-700/50 rounded-xl text-white placeholder-gray-600 focus:outline-none focus:border-red-600 focus:shadow-lg focus:shadow-red-600/20 transition-all font-medium" />
                    </div>

                    <div>
                        <label class="block text-gray-300 text-xs font-bold mb-3 uppercase tracking-[0.2em]">
                            <i data-lucide="lock" class="w-4 h-4 inline mr-2"></i>
                            Contraseña
                        </label>
                        <input type="password" name="password" required placeholder="••••••••"
                               class="w-full px-6 py-4 bg-black/70 border-2 border-gray-700/50 rounded-xl text-white placeholder-gray-600 focus:outline-none focus:border-red-600 focus:shadow-lg focus:shadow-red-600/20 transition-all font-medium" />
                    </div>

                    <button type="submit"
                            class="w-full py-5 bg-gradient-to-r from-red-600 via-red-700 to-red-600 hover:from-red-700 hover:via-red-800 hover:to-red-700 text-white font-black text-lg rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-xl shadow-red-600/30 hover:shadow-2xl hover:shadow-red-600/50 flex items-center justify-center gap-3 uppercase tracking-[0.2em] border-2 border-red-500/50">
                        <i data-lucide="log-in" class="w-6 h-6"></i>
                        <span>Ingresar</span>
                    </button>
                </form>

                <div class="mt-8 pt-6 border-t border-gray-800/50 relative z-10">
                    <p class="text-xs text-gray-500 text-center mb-3 uppercase tracking-[0.2em] font-bold">Credenciales por defecto:</p>
                    <div class="bg-black/70 rounded-xl p-4 font-mono text-xs text-center border border-gray-800/50">
                        <div class="flex items-center justify-center gap-2 mb-2">
                            <span class="text-gray-400">Email:</span>
                            <span class="text-red-500 font-bold">admin@elitegym.com</span>
                        </div>
                        <div class="flex items-center justify-center gap-2">
                            <span class="text-gray-400">Password:</span>
                            <span class="text-red-500 font-bold">admin123</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-8">
                <a href="/kiosko" class="text-gray-400 hover:text-red-500 transition-colors inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.2em] group">
                    <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i>
                    Volver al Kiosko
                </a>
            </div>

            <div class="mt-10 text-center">
                <div class="inline-block px-8 py-3 bg-gray-900/50 border border-gray-800/50 rounded-full backdrop-blur-sm">
                    <p class="text-gray-600 text-xs font-black uppercase tracking-[0.3em]">
                        ELITE GYM © 2024
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>

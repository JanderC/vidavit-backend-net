@{
    ViewData["Title"] = "Login - JonelGym Admin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - JONELGYM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'jonel-orange': '#F47920',
                        'jonel-dark': '#000000',
                        'jonel-gray': '#9B9B9B',
                        'jonel-accent': '#E56B1F'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1, h2 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 3px;
        }

        .logo-container {
            animation: pulse-glow 3s ease-in-out infinite;
        }

        @@keyframes pulse-glow {
            0%, 100% {
                box-shadow: 0 0 20px rgba(244, 121, 32, 0.5);
            }

            50% {
                box-shadow: 0 0 40px rgba(244, 121, 32, 0.8);
            }
        }

        .grid-pattern {
            background-image: linear-gradient(rgba(244, 121, 32, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(244, 121, 32, 0.05) 1px, transparent 1px);
            background-size: 50px 50px;
        }

        .password-toggle {
            cursor: pointer;
            transition: all 0.2s;
        }

            .password-toggle:hover {
                color: #F47920;
            }

        .credential-blur {
            filter: blur(4px);
            transition: filter 0.3s;
            user-select: none;
        }

            .credential-blur.revealed {
                filter: blur(0);
            }
    </style>
</head>
<body>
    <div class="min-h-screen bg-black relative overflow-hidden flex items-center justify-center p-4">
        <div class="absolute inset-0 grid-pattern"></div>

        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-0 left-1/4 w-96 h-96 bg-orange-600 rounded-full blur-3xl animate-pulse"></div>
            <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-orange-800 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        </div>

        <div class="w-full max-w-md relative z-10">
            <div class="text-center mb-10">
                <div class="mb-8 flex justify-center">
                    <div class="logo-container inline-block px-10 py-5 bg-gradient-to-r from-orange-600 to-orange-800 rounded-2xl transform hover:scale-105 transition-transform duration-300">
                        <h1 class="text-6xl font-black text-white tracking-widest">
                            JONELGYM
                        </h1>
                    </div>
                </div>
                <div class="inline-block px-6 py-2 bg-gray-900 border border-orange-600 rounded-full">
                    <p class="text-orange-500 uppercase tracking-widest text-sm font-bold">Panel Administrativo</p>
                </div>
            </div>

            <div class="bg-gradient-to-br from-gray-900 to-black backdrop-blur-lg rounded-3xl border-2 border-orange-600 shadow-2xl p-8 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-40 h-40 bg-orange-600 rounded-full blur-3xl opacity-20 -translate-y-1/2 translate-x-1/2"></div>

                <div class="text-center mb-8 relative z-10">
                    <div class="w-24 h-24 bg-gradient-to-br from-orange-600 to-orange-800 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-2xl transform hover:rotate-3 transition-transform">
                        <i data-lucide="shield-check" class="w-12 h-12 text-white"></i>
                    </div>
                    <h2 class="text-4xl font-black text-white uppercase tracking-wider">Iniciar Sesión</h2>
                    <p class="text-gray-400 text-sm mt-2 font-semibold uppercase tracking-wide">Acceso al Sistema</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-900/40 border-2 border-red-500 rounded-xl p-4 mb-6 flex items-center gap-3 backdrop-blur-sm">
                        <i data-lucide="alert-circle" class="w-6 h-6 text-red-400"></i>
                        <p class="text-red-300 text-sm font-semibold">@ViewBag.Error</p>
                    </div>
                }

                <form method="post" action="/admin/login" class="space-y-6 relative z-10">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="block text-gray-300 text-sm font-bold mb-3 uppercase tracking-wide">
                            <i data-lucide="mail" class="w-4 h-4 inline mr-2"></i>
                            Correo Electrónico
                        </label>
                        <input type="email" name="email" required placeholder="admin@jonelgym.com"
                               class="w-full px-5 py-4 bg-black/60 border-2 border-gray-700 rounded-xl text-white placeholder-gray-600 focus:outline-none focus:border-orange-600 transition-all font-semibold" />
                    </div>

                    <div>
                        <label class="block text-gray-300 text-sm font-bold mb-3 uppercase tracking-wide">
                            <i data-lucide="lock" class="w-4 h-4 inline mr-2"></i>
                            Contraseña
                        </label>
                        <div class="relative">
                            <input type="password" id="passwordInput" name="password" required placeholder="••••••••"
                                   class="w-full px-5 py-4 pr-12 bg-black/60 border-2 border-gray-700 rounded-xl text-white placeholder-gray-600 focus:outline-none focus:border-orange-600 transition-all font-semibold" />
                            <button type="button" onclick="togglePassword()" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 password-toggle">
                                <i data-lucide="eye" id="eyeIcon" class="w-5 h-5"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full py-5 bg-gradient-to-r from-orange-600 to-orange-800 hover:from-orange-700 hover:to-orange-900 text-white font-black text-lg rounded-xl transition-all duration-300 transform hover:scale-105 shadow-2xl hover:shadow-orange-600/50 flex items-center justify-center gap-3 uppercase tracking-wider">
                        <i data-lucide="log-in" class="w-6 h-6"></i>
                        <span>Ingresar al Sistema</span>
                    </button>
                </form>

                <div class="mt-8 pt-6 border-t-2 border-gray-800 relative z-10">
                    <p class="text-xs text-gray-500 text-center mb-3 uppercase tracking-wide font-bold">Credenciales por defecto:</p>
                    <div class="bg-black/70 rounded-xl p-4 font-mono text-xs border-2 border-gray-800">
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <span class="text-gray-400">Email:</span>
                                <span class="text-orange-500 font-bold credential-blur" id="emailCred">admin@jonelgym.com</span>
                            </div>
                            <button type="button" onclick="toggleEmail()" class="text-gray-400 password-toggle">
                                <i data-lucide="eye" id="eyeIconEmail" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-gray-400">Password:</span>
                                <span class="text-orange-500 font-bold credential-blur" id="passwordCred">admin123</span>
                            </div>
                            <button type="button" onclick="togglePasswordCred()" class="text-gray-400 password-toggle">
                                <i data-lucide="eye" id="eyeIconPassword" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-8">
                <a href="/kiosko" class="text-gray-400 hover:text-orange-500 transition-colors inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wide group">
                    <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i>
                    Volver al Kiosko
                </a>
            </div>

            <div class="mt-10 text-center">
                <div class="inline-block px-6 py-2 bg-gray-900 border border-gray-800 rounded-full">
                    <p class="text-gray-600 text-xs font-bold uppercase tracking-wider">
                        JONELGYM © 2024
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();

        function togglePassword() {
            const passwordInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('eyeIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.setAttribute('data-lucide', 'eye-off');
            } else {
                passwordInput.type = 'password';
                eyeIcon.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }

        function toggleEmail() {
            const emailCred = document.getElementById('emailCred');
            const eyeIconEmail = document.getElementById('eyeIconEmail');

            emailCred.classList.toggle('revealed');

            if (emailCred.classList.contains('revealed')) {
                eyeIconEmail.setAttribute('data-lucide', 'eye-off');
            } else {
                eyeIconEmail.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }

        function togglePasswordCred() {
            const passwordCred = document.getElementById('passwordCred');
            const eyeIconPassword = document.getElementById('eyeIconPassword');

            passwordCred.classList.toggle('revealed');

            if (passwordCred.classList.contains('revealed')) {
                eyeIconPassword.setAttribute('data-lucide', 'eye-off');
            } else {
                eyeIconPassword.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }
    </script>
</body>
</html>

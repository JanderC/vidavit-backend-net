@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Panel de Control";
    Layout = "_AdminLayout";
}

<div id="dashboard-app">
    <div class="flex items-center justify-center h-64">
        <div class="text-center">
            <div class="animate-spin w-12 h-12 border-4 border-green-500 border-t-transparent rounded-full mx-auto mb-4"></div>
            <p class="text-gray-400 font-semibold uppercase tracking-widest text-sm">Cargando estadísticas...</p>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* ── Tallest GYM Dashboard Theme ── */
        :root {
            --tz-green: #22c55e;
            --tz-green-dark: #15803d;
            --tz-green-dim: rgba(34,197,94,0.15);
            --tz-black: #000000;
            --tz-dark: #0d0d0d;
            --tz-card: #111111;
            --tz-border: rgba(34,197,94,0.18);
        }

        /* Section headings */
        .section-title {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #e5e7eb;
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: 1.05rem;
            margin-bottom: 1.25rem;
        }

            .section-title i {
                color: var(--tz-green);
            }

        /* KPI cards (caja) */
        .kpi-card {
            border-radius: 1rem;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            transition: transform .25s, box-shadow .25s;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

            .kpi-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 35px rgba(0,0,0,0.6);
            }

            .kpi-card .circle-bg {
                position: absolute;
                top: -16px;
                right: -16px;
                width: 100px;
                height: 100px;
                background: rgba(255,255,255,0.07);
                border-radius: 50%;
            }

            .kpi-card .icon-box {
                background: rgba(255,255,255,0.15);
                border-radius: .75rem;
                padding: .65rem;
                display: inline-flex;
                backdrop-filter: blur(4px);
            }

            .kpi-card .badge {
                font-size: .65rem;
                font-weight: 800;
                letter-spacing: .08em;
                background: rgba(255,255,255,0.15);
                padding: .25rem .7rem;
                border-radius: 99px;
                backdrop-filter: blur(4px);
            }

            .kpi-card .kpi-label {
                font-size: .75rem;
                text-transform: uppercase;
                letter-spacing: .1em;
                opacity: .8;
                margin-bottom: .25rem;
            }

            .kpi-card .kpi-value {
                font-size: 1.85rem;
                font-weight: 900;
                line-height: 1.1;
            }

            .kpi-card .kpi-sub {
                font-size: .7rem;
                opacity: .75;
                margin-top: .4rem;
            }

        .kpi-green {
            background: linear-gradient(135deg, #16a34a 0%, #166534 100%);
            color: #fff;
        }

        .kpi-teal {
            background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
            color: #fff;
        }

        .kpi-lime {
            background: linear-gradient(135deg, #65a30d 0%, #4d7c0f 100%);
            color: #fff;
        }

        .kpi-dark {
            background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
            color: #fff;
        }

        /* Stat mini-cards (estadísticas generales) */
        .stat-card {
            background: #111;
            border: 1px solid var(--tz-border);
            border-radius: 1rem;
            padding: 1.5rem;
            transition: transform .2s, box-shadow .2s;
            box-shadow: 0 2px 12px rgba(0,0,0,0.4);
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 24px rgba(34,197,94,0.15);
            }

        .stat-icon {
            width: 3.25rem;
            height: 3.25rem;
            border-radius: .75rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .stat-icon.green {
                background: rgba(34,197,94,0.12);
            }

            .stat-icon.emerald {
                background: rgba(16,185,129,0.12);
            }

            .stat-icon.orange {
                background: rgba(249,115,22,0.12);
            }

            .stat-icon.red {
                background: rgba(239,68,68,0.12);
            }

        .stat-value {
            font-size: 2rem;
            font-weight: 900;
        }

        .stat-label {
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: #6b7280;
            margin-top: .25rem;
        }

        /* Tables */
        .tz-table {
            width: 100%;
            border-collapse: collapse;
        }

            .tz-table thead th {
                padding: .9rem 1.25rem;
                text-align: left;
                font-size: .7rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .1em;
                color: #fff;
            }

                .tz-table thead th:not(:first-child) {
                    text-align: right;
                }

            .tz-table tbody tr {
                border-bottom: 1px solid rgba(255,255,255,0.04);
                transition: background .15s;
            }

                .tz-table tbody tr:hover {
                    background: rgba(34,197,94,0.04);
                }

            .tz-table tbody td {
                padding: .9rem 1.25rem;
                font-size: .9rem;
                color: #d1d5db;
            }

                .tz-table tbody td:not(:first-child) {
                    text-align: right;
                    font-weight: 700;
                    color: #f9fafb;
                }

            .tz-table tfoot td {
                padding: .9rem 1.25rem;
                font-size: .75rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .08em;
                border-top: 2px solid rgba(34,197,94,0.25);
                background: rgba(34,197,94,0.04);
            }

                .tz-table tfoot td:not(:first-child) {
                    text-align: right;
                }

        /* Panel cards (alerts / top clientes) */
        .panel-card {
            background: #111;
            border: 1px solid var(--tz-border);
            border-radius: 1rem;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .panel-header {
            padding: 1.1rem 1.5rem;
            background: linear-gradient(90deg, #0d0d0d 0%, #111 100%);
            border-bottom: 1px solid var(--tz-border);
            display: flex;
            align-items: center;
            gap: .75rem;
        }

            .panel-header h3 {
                color: #f9fafb;
                font-weight: 800;
                font-size: 1rem;
                text-transform: uppercase;
                letter-spacing: .08em;
            }

            .panel-header i {
                color: var(--tz-green);
            }

        /* Alert rows */
        .alert-row-warn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .65rem 1rem;
            border-radius: .65rem;
            font-size: .82rem;
            background: linear-gradient(90deg, rgba(217,119,6,0.08), rgba(245,158,11,0.05));
            border: 1px solid rgba(217,119,6,0.2);
            transition: box-shadow .15s;
        }

            .alert-row-warn:hover {
                box-shadow: 0 2px 10px rgba(217,119,6,0.15);
            }

        .alert-row-expired {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .65rem 1rem;
            border-radius: .65rem;
            font-size: .82rem;
            background: linear-gradient(90deg, rgba(220,38,38,0.08), rgba(239,68,68,0.05));
            border: 1px solid rgba(220,38,38,0.2);
            transition: box-shadow .15s;
        }

            .alert-row-expired:hover {
                box-shadow: 0 2px 10px rgba(220,38,38,0.15);
            }

        /* Scrollbar for panels */
        .custom-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scroll::-webkit-scrollbar-thumb {
            background: rgba(34,197,94,0.3);
            border-radius: 4px;
        }

        /* Section separator accent line */
        .section-accent {
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(34,197,94,0.5), transparent);
            margin-bottom: 1.5rem;
        }

        /* Table header themes */
        .thead-green {
            background: linear-gradient(90deg, #166534, #15803d);
        }

        .thead-dark {
            background: linear-gradient(90deg, #1f2937, #111827);
        }
    </style>

    <script>
        const API_URL = '/api';

        class DashboardApp {
            constructor() {
                this.cajaHoyData = null;
                this.estadisticasData = null;
                this.loadAllData();
                setInterval(() => this.loadAllData(), 30000);
            }

            async loadAllData() {
                try {
                    await Promise.all([
                        this.loadCajaHoy(),
                        this.loadEstadisticas()
                    ]);
                    this.render();
                } catch (error) {
                    console.error('Error cargando datos:', error);
                }
            }

            async loadCajaHoy() {
                try {
                    const response = await fetch(`${API_URL}/Caja/dashboard`);
                    const data = await response.json();
                    if (data.success) {
                        this.cajaHoyData = {
                            success: true,
                            ingresos: data.cajaHoy.totalIngresos,
                            egresos: data.cajaHoy.totalEgresos,
                            balance: data.cajaHoy.balance,
                            ingresosEfectivo: data.cajaHoy.efectivo.ingresos,
                            egresosEfectivo: data.cajaHoy.efectivo.egresos,
                            ingresosTransferencia: data.cajaHoy.transferencia.ingresos,
                            egresosTransferencia: data.cajaHoy.transferencia.egresos,
                            cantidadMovimientos: data.cajaHoy.cantidadMovimientos
                        };
                    }
                } catch (error) {
                    console.error('Error cargando datos de caja:', error);
                }
            }

            async loadEstadisticas() {
                try {
                    const response = await fetch(`${API_URL}/Dashboard/estadisticas`);
                    this.estadisticasData = await response.json();
                } catch (error) {
                    console.error('Error cargando estadísticas:', error);
                }
            }

            formatCurrency(value) {
                return new Intl.NumberFormat('es-CO', {
                    style: 'currency', currency: 'COP',
                    minimumFractionDigits: 0, maximumFractionDigits: 0
                }).format(value);
            }

            render() {
                if (!this.cajaHoyData || !this.estadisticasData) return;

                const { resumen, alertas, topClientes } = this.estadisticasData;
                const { ingresos, egresos, balance, ingresosEfectivo, egresosEfectivo,
                        ingresosTransferencia, egresosTransferencia, cantidadMovimientos } = this.cajaHoyData;

                document.getElementById('dashboard-app').innerHTML = `

                    <!-- ── Caja Hoy ── -->
                    <div class="mb-9">
                        <div class="section-accent"></div>
                        <p class="section-title">
                            <i data-lucide="wallet"></i>
                            Estado de Caja — Hoy
                        </p>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

                            <div class="kpi-card kpi-green">
                                <div class="circle-bg"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="icon-box"><i data-lucide="trending-up" class="w-6 h-6"></i></div>
                                        <span class="badge">HOY</span>
                                    </div>
                                    <p class="kpi-label">Ingresos de Hoy</p>
                                    <p class="kpi-value">${this.formatCurrency(ingresos)}</p>
                                    <p class="kpi-sub">${cantidadMovimientos} movimientos registrados</p>
                                </div>
                            </div>

                            <div class="kpi-card kpi-teal">
                                <div class="circle-bg"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="icon-box"><i data-lucide="wallet" class="w-6 h-6"></i></div>
                                        <span class="badge">EFECTIVO</span>
                                    </div>
                                    <p class="kpi-label">Efectivo Hoy</p>
                                    <p class="kpi-value">${this.formatCurrency(ingresosEfectivo - egresosEfectivo)}</p>
                                    <p class="kpi-sub">Ingresos: ${this.formatCurrency(ingresosEfectivo)}</p>
                                </div>
                            </div>

                            <div class="kpi-card kpi-lime">
                                <div class="circle-bg"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="icon-box"><i data-lucide="credit-card" class="w-6 h-6"></i></div>
                                        <span class="badge">TRANSF.</span>
                                    </div>
                                    <p class="kpi-label">Transferencias Hoy</p>
                                    <p class="kpi-value">${this.formatCurrency(ingresosTransferencia - egresosTransferencia)}</p>
                                    <p class="kpi-sub">Ingresos: ${this.formatCurrency(ingresosTransferencia)}</p>
                                </div>
                            </div>

                            <div class="kpi-card kpi-dark">
                                <div class="circle-bg"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="icon-box"><i data-lucide="trending-down" class="w-6 h-6"></i></div>
                                        <span class="badge">HOY</span>
                                    </div>
                                    <p class="kpi-label">Egresos de Hoy</p>
                                    <p class="kpi-value">${this.formatCurrency(egresos)}</p>
                                    <p class="kpi-sub">Balance: ${this.formatCurrency(balance)}</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Ingresos del Mes ── -->
                    <div class="mb-9">
                        <p class="section-title">
                            <i data-lucide="bar-chart-3"></i>
                            Ingresos del Mes Desglosados
                        </p>
                        <div class="panel-card">
                            <div class="overflow-x-auto">
                                <table class="tz-table">
                                    <thead class="thead-green">
                                        <tr>
                                            <th>Categoría</th>
                                            <th style="text-align:right">Monto</th>
                                            <th style="text-align:right">% del Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${this.renderFilaIngreso('Membresías',      resumen.ingresosMes.membresias, resumen.ingresosMes.total, 'green')}
                                        ${this.renderFilaIngreso('Productos',       resumen.ingresosMes.productos,  resumen.ingresosMes.total, 'teal')}
                                        ${this.renderFilaIngreso('Abonos a Deudas',resumen.ingresosMes.abonos,     resumen.ingresosMes.total, 'lime')}
                                        ${this.renderFilaIngreso('Otros',           resumen.ingresosMes.otros,      resumen.ingresosMes.total, 'gray')}
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td style="color:#f9fafb">TOTAL</td>
                                            <td style="color:#22c55e;font-size:1.1rem;text-align:right">${this.formatCurrency(resumen.ingresosMes.total)}</td>
                                            <td style="color:#6b7280;text-align:right">100%</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- ── Egresos del Mes ── -->
                    <div class="mb-9">
                        <p class="section-title">
                            <i data-lucide="trending-down" style="color:#ef4444"></i>
                            Egresos del Mes Desglosados
                        </p>
                        <div class="panel-card">
                            <div class="overflow-x-auto">
                                <table class="tz-table">
                                    <thead style="background:linear-gradient(90deg,#7f1d1d,#991b1b)">
                                        <tr>
                                            <th>Categoría</th>
                                            <th style="text-align:right">Monto</th>
                                            <th style="text-align:right">% del Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${this.renderFilaEgreso('Sueldos',       resumen.egresosMes.sueldos,       resumen.egresosMes.total, 'red')}
                                        ${this.renderFilaEgreso('Servicios',     resumen.egresosMes.servicios,     resumen.egresosMes.total, 'orange')}
                                        ${this.renderFilaEgreso('Mantenimiento', resumen.egresosMes.mantenimiento, resumen.egresosMes.total, 'yellow')}
                                        ${this.renderFilaEgreso('Compras',       resumen.egresosMes.compras,       resumen.egresosMes.total, 'pink')}
                                        ${this.renderFilaEgreso('Otros',         resumen.egresosMes.otros,         resumen.egresosMes.total, 'gray')}
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td style="color:#f9fafb">TOTAL</td>
                                            <td style="color:#ef4444;font-size:1.1rem;text-align:right">${this.formatCurrency(resumen.egresosMes.total)}</td>
                                            <td style="color:#6b7280;text-align:right">100%</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- ── Estadísticas Generales ── -->
                    <div class="mb-9">
                        <p class="section-title">
                            <i data-lucide="activity"></i>
                            Estadísticas Generales
                        </p>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

                            <div class="stat-card">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="stat-icon green"><i data-lucide="users" class="w-7 h-7" style="color:#22c55e"></i></div>
                                    <span class="stat-value" style="color:#22c55e">${resumen.totalClientes}</span>
                                </div>
                                <p class="stat-label">Clientes Activos</p>
                            </div>

                            <div class="stat-card">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="stat-icon emerald"><i data-lucide="check-circle" class="w-7 h-7" style="color:#10b981"></i></div>
                                    <span class="stat-value" style="color:#10b981">${resumen.checkInsHoy}</span>
                                </div>
                                <p class="stat-label">Check-ins Hoy</p>
                            </div>

                            <div class="stat-card">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="stat-icon orange"><i data-lucide="alert-triangle" class="w-7 h-7" style="color:#f97316"></i></div>
                                    <span class="stat-value" style="color:#f97316">${resumen.membresiasPorVencer}</span>
                                </div>
                                <p class="stat-label">Por Vencer (7 días)</p>
                            </div>

                            <div class="stat-card">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="stat-icon red"><i data-lucide="x-circle" class="w-7 h-7" style="color:#ef4444"></i></div>
                                    <span class="stat-value" style="color:#ef4444">${resumen.membresiasVencidas}</span>
                                </div>
                                <p class="stat-label">Membresías Vencidas</p>
                            </div>
                        </div>
                    </div>

                    <!-- ── Alertas + Top Clientes ── -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                        ${this.renderAlertas(alertas)}
                        ${this.renderTopClientes(topClientes)}
                    </div>
                `;

                lucide.createIcons();
            }

            renderFilaIngreso(nombre, monto, total, color) {
                const pct = total > 0 ? ((monto / total) * 100).toFixed(1) : 0;
                const colors = {
                    green:  { badge: 'rgba(34,197,94,0.15)',  text: '#22c55e',  bar: '#22c55e' },
                    teal:   { badge: 'rgba(20,184,166,0.15)', text: '#14b8a6',  bar: '#14b8a6' },
                    lime:   { badge: 'rgba(132,204,22,0.15)', text: '#84cc16',  bar: '#84cc16' },
                    gray:   { badge: 'rgba(107,114,128,0.15)',text: '#9ca3af',  bar: '#9ca3af' },
                };
                const c = colors[color] || colors.gray;
                return `
                    <tr>
                        <td>
                            <span style="background:${c.badge};color:${c.text};padding:.25rem .75rem;border-radius:99px;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em">${nombre}</span>
                        </td>
                        <td>${this.formatCurrency(monto)}</td>
                        <td>
                            <div style="display:flex;align-items:center;justify-content:flex-end;gap:.5rem">
                                <div style="width:4rem;height:5px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden">
                                    <div style="height:100%;width:${pct}%;background:${c.bar};border-radius:4px"></div>
                                </div>
                                <span style="font-size:.8rem;color:#9ca3af">${pct}%</span>
                            </div>
                        </td>
                    </tr>`;
            }

            renderFilaEgreso(nombre, monto, total, color) {
                const pct = total > 0 ? ((monto / total) * 100).toFixed(1) : 0;
                const colors = {
                    red:    { badge: 'rgba(239,68,68,0.15)',   text: '#ef4444', bar: '#ef4444' },
                    orange: { badge: 'rgba(249,115,22,0.15)',  text: '#f97316', bar: '#f97316' },
                    yellow: { badge: 'rgba(234,179,8,0.15)',   text: '#eab308', bar: '#eab308' },
                    pink:   { badge: 'rgba(236,72,153,0.15)',  text: '#ec4899', bar: '#ec4899' },
                    gray:   { badge: 'rgba(107,114,128,0.15)', text: '#9ca3af', bar: '#9ca3af' },
                };
                const c = colors[color] || colors.gray;
                return `
                    <tr>
                        <td>
                            <span style="background:${c.badge};color:${c.text};padding:.25rem .75rem;border-radius:99px;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em">${nombre}</span>
                        </td>
                        <td>${this.formatCurrency(monto)}</td>
                        <td>
                            <div style="display:flex;align-items:center;justify-content:flex-end;gap:.5rem">
                                <div style="width:4rem;height:5px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden">
                                    <div style="height:100%;width:${pct}%;background:${c.bar};border-radius:4px"></div>
                                </div>
                                <span style="font-size:.8rem;color:#9ca3af">${pct}%</span>
                            </div>
                        </td>
                    </tr>`;
            }

            renderAlertas(alertas) {
                return `
                    <div class="panel-card">
                        <div class="panel-header">
                            <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                            <h3>Alertas de Membresías</h3>
                        </div>
                        <div style="padding:1.25rem">
                            ${alertas.membresiasPorVencer > 0 || alertas.membresiasVencidas > 0 ? `
                                <div style="display:flex;flex-direction:column;gap:1.25rem">

                                    ${alertas.membresiasPorVencer > 0 ? `
                                        <div>
                                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem">
                                                <span style="font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#d97706">Por Vencer (${alertas.membresiasPorVencer})</span>
                                                <a href="/membresias" style="font-size:.7rem;font-weight:800;text-transform:uppercase;color:#22c55e;text-decoration:none">Ver todas →</a>
                                            </div>
                                            <div class="custom-scroll" style="display:flex;flex-direction:column;gap:.4rem;max-height:12rem;overflow-y:auto">
                                                ${alertas.detalleProximasVencer.slice(0, 3).map(m => `
                                                    <div class="alert-row-warn">
                                                        <div>
                                                            <p style="font-weight:700;color:#f9fafb;font-size:.85rem">${m.clienteNombre}</p>
                                                            <p style="font-size:.7rem;color:#9ca3af">${m.planNombre}</p>
                                                        </div>
                                                        <span style="background:${m.diasRestantes <= 3 ? '#dc2626' : '#d97706'};color:#fff;padding:.2rem .6rem;border-radius:99px;font-size:.68rem;font-weight:900">
                                                            ${m.diasRestantes}d
                                                        </span>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    ` : ''}

                                    ${alertas.membresiasVencidas > 0 ? `
                                        <div style="${alertas.membresiasPorVencer > 0 ? 'padding-top:1rem;border-top:1px solid rgba(255,255,255,0.07)' : ''}">
                                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem">
                                                <span style="font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#ef4444">Vencidas (${alertas.membresiasVencidas})</span>
                                                <a href="/membresias" style="font-size:.7rem;font-weight:800;text-transform:uppercase;color:#22c55e;text-decoration:none">Ver todas →</a>
                                            </div>
                                            <div class="custom-scroll" style="display:flex;flex-direction:column;gap:.4rem;max-height:9rem;overflow-y:auto">
                                                ${alertas.detalleVencidas.slice(0, 3).map(m => `
                                                    <div class="alert-row-expired">
                                                        <div>
                                                            <p style="font-weight:700;color:#f9fafb;font-size:.85rem">${m.clienteNombre}</p>
                                                            <p style="font-size:.7rem;color:#9ca3af">${m.planNombre}</p>
                                                        </div>
                                                        <span style="background:#dc2626;color:#fff;padding:.2rem .6rem;border-radius:99px;font-size:.68rem;font-weight:900">
                                                            ${m.diasVencido > 0 ? '-' + m.diasVencido : 'HOY'}d
                                                        </span>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    ` : ''}
                                </div>
                            ` : `
                                <div style="text-align:center;padding:3rem 1rem;color:#6b7280">
                                    <i data-lucide="check-circle" style="width:3.5rem;height:3.5rem;margin:0 auto .75rem;display:block;color:#22c55e"></i>
                                    <p style="font-weight:700;color:#d1d5db">No hay alertas pendientes</p>
                                    <p style="font-size:.8rem;margin-top:.25rem">Todo en orden</p>
                                </div>
                            `}
                        </div>
                    </div>
                `;
            }

            renderTopClientes(topClientes) {
                return `
                    <div class="panel-card">
                        <div class="panel-header">
                            <i data-lucide="trophy" class="w-5 h-5"></i>
                            <h3>Top 10 Clientes del Mes</h3>
                        </div>
                        <div style="padding:1.25rem">
                            ${topClientes && topClientes.length > 0 ? `
                                <div class="custom-scroll" style="display:flex;flex-direction:column;gap:.4rem;max-height:24rem;overflow-y:auto">
                                    ${topClientes.map((cliente, index) => `
                                        <div style="display:flex;align-items:center;justify-content:space-between;padding:.65rem .85rem;border-radius:.65rem;
                                            background:${index===0?'rgba(234,179,8,0.08)':index===1?'rgba(148,163,184,0.06)':index===2?'rgba(249,115,22,0.06)':'rgba(255,255,255,0.03)'};
                                            border:1px solid ${index===0?'rgba(234,179,8,0.25)':index===1?'rgba(148,163,184,0.2)':index===2?'rgba(249,115,22,0.2)':'rgba(255,255,255,0.05)'}">
                                            <div style="display:flex;align-items:center;gap:.75rem">
                                                <div style="width:2.2rem;height:2.2rem;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.8rem;color:#fff;
                                                    background:${index===0?'linear-gradient(135deg,#eab308,#a16207)':index===1?'linear-gradient(135deg,#94a3b8,#475569)':index===2?'linear-gradient(135deg,#f97316,#c2410c)':'rgba(34,197,94,0.2)'}">
                                                    ${index + 1}
                                                </div>
                                                <div>
                                                    <p style="font-weight:700;color:#f9fafb;font-size:.85rem">${cliente.nombre}</p>
                                                    <p style="font-size:.7rem;color:#6b7280;font-weight:600">${cliente.totalCheckIns} visitas</p>
                                                </div>
                                            </div>
                                            ${index < 3 ? `<i data-lucide="award" style="width:1.25rem;height:1.25rem;color:${index===0?'#eab308':index===1?'#94a3b8':'#f97316'}"></i>` : ''}
                                        </div>
                                    `).join('')}
                                </div>
                            ` : `
                                <div style="text-align:center;padding:3rem 1rem;color:#6b7280">
                                    <i data-lucide="users" style="width:3.5rem;height:3.5rem;margin:0 auto .75rem;display:block;color:#374151"></i>
                                    <p style="font-weight:700;color:#d1d5db">No hay datos disponibles</p>
                                </div>
                            `}
                        </div>
                    </div>
                `;
            }
        }

        const dashboard = new DashboardApp();
    </script>
}

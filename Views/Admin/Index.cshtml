@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Panel de Control ELITE GYM";
    Layout = "_AdminLayout";
}

<div id="dashboard-app">
    <div class="flex items-center justify-center h-64">
        <div class="text-center">
            <div class="animate-spin w-16 h-16 border-4 border-elit-red border-t-transparent rounded-full mx-auto mb-4"></div>
            <p class="text-gray-600 font-bold uppercase tracking-wide">Cargando datos ELITE GYM...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const API_URL = '/api';

        class DashboardApp {
            constructor() {
                this.cajaData = null;
                this.estadisticasData = null;
                this.loadAllData();
                // Actualizar cada 30 segundos
                setInterval(() => this.loadAllData(), 30000);
            }

            async loadAllData() {
                try {
                    await Promise.all([
                        this.loadCajaDashboard(),
                        this.loadEstadisticas()
                    ]);
                    this.render();
                } catch (error) {
                    console.error('Error cargando datos:', error);
                    this.showError();
                }
            }

            async loadCajaDashboard() {
                try {
                    const response = await fetch(`${API_URL}/Caja/dashboard`);
                    const data = await response.json();

                    if (data.success) {
                        this.cajaData = data;
                    }
                } catch (error) {
                    console.error('Error cargando datos de caja:', error);
                }
            }

            async loadEstadisticas() {
                try {
                    const response = await fetch(`${API_URL}/Dashboard/estadisticas`);
                    this.estadisticasData = await response.json();
                } catch (error) {
                    console.error('Error cargando estadísticas:', error);
                }
            }

            formatCurrency(value) {
                return new Intl.NumberFormat('es-CO', {
                    style: 'currency',
                    currency: 'COP',
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                }).format(value);
            }

            formatDate(dateString) {
                const date = new Date(dateString);
                return date.toLocaleDateString('es-ES', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                });
            }

            showError() {
                document.getElementById('dashboard-app').innerHTML = `
                    <div class="bg-red-50 border-2 border-red-200 rounded-lg p-8 text-center">
                        <i data-lucide="alert-circle" class="w-16 h-16 text-red-600 mx-auto mb-4"></i>
                        <h3 class="text-xl font-bold text-red-800 mb-2">Error al cargar datos</h3>
                        <p class="text-red-600">No se pudieron cargar las estadísticas. Por favor, recarga la página.</p>
                    </div>
                `;
                lucide.createIcons();
            }

            render() {
                if (!this.cajaData || !this.estadisticasData) return;

                const { cajaHoy, ultimoCierre, alertas: alertasCaja } = this.cajaData;
                const { resumen, alertas, topClientes, asistencia30dias } = this.estadisticasData;

                document.getElementById('dashboard-app').innerHTML = `
                    <!-- ESTADO DE CAJA HOY -->
                    <section class="mb-8">
                        <div class="flex items-center gap-3 mb-6 border-l-4 border-elit-red pl-4">
                            <i data-lucide="wallet" class="w-8 h-8 text-elit-red"></i>
                            <h3 class="text-3xl font-black text-gray-900 uppercase tracking-wide">Estado de Caja - Hoy</h3>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                            <!-- Ingresos Hoy -->
                            <div class="bg-gradient-to-br from-green-500 to-green-700 text-white rounded-xl shadow-xl p-6 transform hover:scale-105 transition-all">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="bg-white/20 rounded-lg p-3">
                                        <i data-lucide="trending-up" class="w-7 h-7"></i>
                                    </div>
                                    <span class="text-xs font-bold bg-white/25 px-3 py-1 rounded-full">HOY</span>
                                </div>
                                <p class="text-sm uppercase tracking-wider mb-2 opacity-90 font-semibold">Ingresos</p>
                                <p class="text-3xl font-black mb-2">${this.formatCurrency(cajaHoy.totalIngresos)}</p>
                                <div class="flex items-center gap-2 text-sm opacity-90">
                                    <i data-lucide="activity" class="w-4 h-4"></i>
                                    <span>${cajaHoy.cantidadMovimientos} movimientos</span>
                                </div>
                            </div>

                            <!-- Egresos Hoy -->
                            <div class="bg-gradient-to-br from-red-500 to-red-700 text-white rounded-xl shadow-xl p-6 transform hover:scale-105 transition-all">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="bg-white/20 rounded-lg p-3">
                                        <i data-lucide="trending-down" class="w-7 h-7"></i>
                                    </div>
                                    <span class="text-xs font-bold bg-white/25 px-3 py-1 rounded-full">HOY</span>
                                </div>
                                <p class="text-sm uppercase tracking-wider mb-2 opacity-90 font-semibold">Egresos</p>
                                <p class="text-3xl font-black mb-2">${this.formatCurrency(cajaHoy.totalEgresos)}</p>
                                <div class="flex items-center gap-2 text-sm opacity-90">
                                    <i data-lucide="minus-circle" class="w-4 h-4"></i>
                                    <span>Salidas registradas</span>
                                </div>
                            </div>

                            <!-- Balance Hoy -->
                            <div class="bg-gradient-to-br from-blue-500 to-blue-700 text-white rounded-xl shadow-xl p-6 transform hover:scale-105 transition-all">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="bg-white/20 rounded-lg p-3">
                                        <i data-lucide="dollar-sign" class="w-7 h-7"></i>
                                    </div>
                                    <span class="text-xs font-bold bg-white/25 px-3 py-1 rounded-full">HOY</span>
                                </div>
                                <p class="text-sm uppercase tracking-wider mb-2 opacity-90 font-semibold">Balance</p>
                                <p class="text-3xl font-black mb-2">${this.formatCurrency(cajaHoy.balance)}</p>
                                <div class="flex items-center gap-2 text-sm opacity-90">
                                    <i data-lucide="calculator" class="w-4 h-4"></i>
                                    <span>Saldo actual</span>
                                </div>
                            </div>

                            <!-- Efectivo -->
                            <div class="bg-gradient-to-br from-purple-500 to-purple-700 text-white rounded-xl shadow-xl p-6 transform hover:scale-105 transition-all">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="bg-white/20 rounded-lg p-3">
                                        <i data-lucide="banknote" class="w-7 h-7"></i>
                                    </div>
                                    <span class="text-xs font-bold bg-white/25 px-3 py-1 rounded-full">EFECTIVO</span>
                                </div>
                                <p class="text-sm uppercase tracking-wider mb-2 opacity-90 font-semibold">Balance Efectivo</p>
                                <p class="text-3xl font-black mb-2">${this.formatCurrency(cajaHoy.efectivo.balance)}</p>
                                <div class="grid grid-cols-2 gap-2 text-xs mt-3">
                                    <div class="bg-white/10 rounded px-2 py-1">
                                        <div class="opacity-75">Ingresos</div>
                                        <div class="font-bold">${this.formatCurrency(cajaHoy.efectivo.ingresos)}</div>
                                    </div>
                                    <div class="bg-white/10 rounded px-2 py-1">
                                        <div class="opacity-75">Egresos</div>
                                        <div class="font-bold">${this.formatCurrency(cajaHoy.efectivo.egresos)}</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Desglose por métodos de pago -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                            <!-- Transferencia -->
                            <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-gray-100">
                                <div class="flex items-center gap-3 mb-4">
                                    <div class="bg-blue-100 rounded-lg p-3">
                                        <i data-lucide="smartphone" class="w-6 h-6 text-blue-600"></i>
                                    </div>
                                    <div>
                                        <h4 class="text-lg font-bold text-gray-900">Transferencias</h4>
                                        <p class="text-sm text-gray-500">Movimientos digitales</p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-3 gap-4">
                                    <div class="text-center">
                                        <p class="text-xs text-gray-500 uppercase mb-1">Ingresos</p>
                                        <p class="text-lg font-bold text-green-600">${this.formatCurrency(cajaHoy.transferencia.ingresos)}</p>
                                    </div>
                                    <div class="text-center">
                                        <p class="text-xs text-gray-500 uppercase mb-1">Egresos</p>
                                        <p class="text-lg font-bold text-red-600">${this.formatCurrency(cajaHoy.transferencia.egresos)}</p>
                                    </div>
                                    <div class="text-center">
                                        <p class="text-xs text-gray-500 uppercase mb-1">Balance</p>
                                        <p class="text-lg font-bold text-blue-600">${this.formatCurrency(cajaHoy.transferencia.balance)}</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Categorías -->
                            <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-gray-100">
                                <div class="flex items-center gap-3 mb-4">
                                    <div class="bg-purple-100 rounded-lg p-3">
                                        <i data-lucide="pie-chart" class="w-6 h-6 text-purple-600"></i>
                                    </div>
                                    <div>
                                        <h4 class="text-lg font-bold text-gray-900">Categorías de Ingreso</h4>
                                        <p class="text-sm text-gray-500">Desglose por tipo</p>
                                    </div>
                                </div>
                                <div class="space-y-2">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">Membresías</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(cajaHoy.categorias.membresias)}</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">Productos</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(cajaHoy.categorias.productos)}</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">Abonos</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(cajaHoy.categorias.abonos)}</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">Otros</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(cajaHoy.categorias.otros)}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        ${ultimoCierre ? `
                            <!-- Último Cierre -->
                            <div class="bg-gradient-to-r from-gray-900 to-black text-white rounded-xl shadow-xl p-6 border-2 border-elit-red">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="flex items-center gap-3">
                                        <div class="bg-elit-red rounded-lg p-3">
                                            <i data-lucide="lock" class="w-6 h-6"></i>
                                        </div>
                                        <div>
                                            <h4 class="text-lg font-bold">Último Cierre de Caja</h4>
                                            <p class="text-sm text-gray-400">${this.formatDate(ultimoCierre.FechaCierre)} - ${ultimoCierre.TipoCierre}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-6">
                                    <div>
                                        <p class="text-xs text-gray-400 uppercase mb-1">Balance General</p>
                                        <p class="text-2xl font-bold">${this.formatCurrency(ultimoCierre.BalanceGeneral)}</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-400 uppercase mb-1">Efectivo Final</p>
                                        <p class="text-2xl font-bold">${this.formatCurrency(ultimoCierre.EfectivoFinal)}</p>
                                    </div>
                                </div>
                            </div>
                        ` : ''}

                        ${alertasCaja.tieneMovimientosPendientesAnteriores ? `
                            <!-- Alerta Movimientos Pendientes -->
                            <div class="bg-yellow-50 border-2 border-yellow-400 rounded-xl p-6 mt-6">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="alert-triangle" class="w-8 h-8 text-yellow-600"></i>
                                    <div>
                                        <h4 class="text-lg font-bold text-yellow-900">Movimientos Pendientes Anteriores</h4>
                                        <p class="text-yellow-700">Hay ${alertasCaja.movimientosPendientesAnteriores} movimientos pendientes de períodos anteriores</p>
                                    </div>
                                </div>
                            </div>
                        ` : ''}
                    </section>

                    <!-- ESTADÍSTICAS GENERALES -->
                    <section class="mb-8">
                        <div class="flex items-center gap-3 mb-6 border-l-4 border-elit-red pl-4">
                            <i data-lucide="bar-chart-3" class="w-8 h-8 text-elit-red"></i>
                            <h3 class="text-3xl font-black text-gray-900 uppercase tracking-wide">Estadísticas Generales</h3>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                            <!-- Total Clientes -->
                            <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-blue-500">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="bg-blue-100 rounded-lg p-3">
                                        <i data-lucide="users" class="w-6 h-6 text-blue-600"></i>
                                    </div>
                                    <span class="text-3xl font-black text-blue-600">${resumen.totalClientes}</span>
                                </div>
                                <p class="text-sm text-gray-600 font-semibold uppercase">Total Clientes</p>
                            </div>

                            <!-- Check-ins Hoy -->
                            <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-green-500">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="bg-green-100 rounded-lg p-3">
                                        <i data-lucide="user-check" class="w-6 h-6 text-green-600"></i>
                                    </div>
                                    <span class="text-3xl font-black text-green-600">${resumen.checkInsHoy}</span>
                                </div>
                                <p class="text-sm text-gray-600 font-semibold uppercase">Check-ins Hoy</p>
                            </div>

                            <!-- Por Vencer -->
                            <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-yellow-500">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="bg-yellow-100 rounded-lg p-3">
                                        <i data-lucide="clock" class="w-6 h-6 text-yellow-600"></i>
                                    </div>
                                    <span class="text-3xl font-black text-yellow-600">${resumen.membresiasPorVencer}</span>
                                </div>
                                <p class="text-sm text-gray-600 font-semibold uppercase">Por Vencer</p>
                            </div>

                            <!-- Vencidas -->
                            <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-red-500">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="bg-red-100 rounded-lg p-3">
                                        <i data-lucide="alert-circle" class="w-6 h-6 text-red-600"></i>
                                    </div>
                                    <span class="text-3xl font-black text-red-600">${resumen.membresiasVencidas}</span>
                                </div>
                                <p class="text-sm text-gray-600 font-semibold uppercase">Vencidas</p>
                            </div>
                        </div>
                    </section>

                    <!-- INGRESOS Y EGRESOS DEL MES -->
                    <section class="mb-8">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <!-- Ingresos del Mes -->
                            <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-gray-100">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="bg-green-100 rounded-lg p-3">
                                        <i data-lucide="trending-up" class="w-7 h-7 text-green-600"></i>
                                    </div>
                                    <div>
                                        <h4 class="text-xl font-black text-gray-900">Ingresos del Mes</h4>
                                        <p class="text-3xl font-black text-green-600">${this.formatCurrency(resumen.ingresosMes.total)}</p>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    <div class="flex justify-between items-center pb-2 border-b">
                                        <span class="text-sm text-gray-600">Membresías</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(resumen.ingresosMes.membresias)}</span>
                                    </div>
                                    <div class="flex justify-between items-center pb-2 border-b">
                                        <span class="text-sm text-gray-600">Productos</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(resumen.ingresosMes.productos)}</span>
                                    </div>
                                    <div class="flex justify-between items-center pb-2 border-b">
                                        <span class="text-sm text-gray-600">Abonos</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(resumen.ingresosMes.abonos)}</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">Otros</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(resumen.ingresosMes.otros)}</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Egresos del Mes -->
                            <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-gray-100">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="bg-red-100 rounded-lg p-3">
                                        <i data-lucide="trending-down" class="w-7 h-7 text-red-600"></i>
                                    </div>
                                    <div>
                                        <h4 class="text-xl font-black text-gray-900">Egresos del Mes</h4>
                                        <p class="text-3xl font-black text-red-600">${this.formatCurrency(resumen.egresosMes.total)}</p>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    <div class="flex justify-between items-center pb-2 border-b">
                                        <span class="text-sm text-gray-600">Sueldos</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(resumen.egresosMes.sueldos)}</span>
                                    </div>
                                    <div class="flex justify-between items-center pb-2 border-b">
                                        <span class="text-sm text-gray-600">Servicios</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(resumen.egresosMes.servicios)}</span>
                                    </div>
                                    <div class="flex justify-between items-center pb-2 border-b">
                                        <span class="text-sm text-gray-600">Compras</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(resumen.egresosMes.compras)}</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">Otros</span>
                                        <span class="font-bold text-gray-900">${this.formatCurrency(resumen.egresosMes.otros)}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ALERTAS Y TOP CLIENTES -->
                    <section class="mb-8">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <!-- Alertas de Membresías -->
                            ${this.renderAlertas(alertas)}

                            <!-- Top Clientes -->
                            ${this.renderTopClientes(topClientes)}
                        </div>
                    </section>

                    <!-- GRÁFICA DE ASISTENCIA -->
                    ${asistencia30dias && asistencia30dias.length > 0 ? `
                        <section>
                            <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-gray-100">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="bg-blue-100 rounded-lg p-3">
                                        <i data-lucide="activity" class="w-7 h-7 text-blue-600"></i>
                                    </div>
                                    <h4 class="text-xl font-black text-gray-900">Asistencia Últimos 30 Días</h4>
                                </div>
                                <div class="h-64">
                                    <canvas id="asistenciaChart"></canvas>
                                </div>
                            </div>
                        </section>
                    ` : ''}
                `;

                // Inicializar iconos
                lucide.createIcons();

                // Renderizar gráfica de asistencia
                if (asistencia30dias && asistencia30dias.length > 0) {
                    this.renderAsistenciaChart(asistencia30dias);
                }
            }

            renderAlertas(alertas) {
                if (!alertas || (alertas.membresiasPorVencer === 0 && alertas.membresiasVencidas === 0)) {
                    return `
                        <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-gray-100">
                            <div class="text-center py-12">
                                <div class="bg-green-100 rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4">
                                    <i data-lucide="check-circle" class="w-10 h-10 text-green-600"></i>
                                </div>
                                <p class="text-lg font-bold text-gray-900 mb-2">Sin Alertas</p>
                                <p class="text-sm text-gray-500">Todas las membresías están al día</p>
                            </div>
                        </div>
                    `;
                }

                return `
                    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-gray-100">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="bg-yellow-100 rounded-lg p-3">
                                <i data-lucide="bell" class="w-7 h-7 text-yellow-600"></i>
                            </div>
                            <h4 class="text-xl font-black text-gray-900">Alertas de Membresías</h4>
                        </div>

                        <!-- Por Vencer -->
                        ${alertas.membresiasPorVencer > 0 ? `
                            <div class="mb-6">
                                <div class="flex items-center justify-between mb-3">
                                    <h5 class="font-bold text-gray-900 flex items-center gap-2">
                                        <span class="w-2 h-2 bg-yellow-500 rounded-full animate-pulse"></span>
                                        Por Vencer (${alertas.membresiasPorVencer})
                                    </h5>
                                    <a href="/membresias" class="text-xs text-elit-red hover:underline font-bold">Ver todas →</a>
                                </div>
                                <div class="space-y-2 max-h-48 overflow-y-auto">
                                    ${alertas.detalleProximasVencer.slice(0, 5).map(m => `
                                        <div class="flex items-center justify-between p-3 bg-yellow-50 rounded-lg border border-yellow-200">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 bg-yellow-500 rounded-lg flex items-center justify-center">
                                                    <i data-lucide="user" class="w-4 h-4 text-white"></i>
                                                </div>
                                                <div>
                                                    <p class="font-bold text-sm text-gray-900">${m.clienteNombre}</p>
                                                    <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                </div>
                                            </div>
                                            <span class="px-3 py-1 bg-yellow-600 text-white rounded-full text-xs font-bold">
                                                ${m.diasRestantes === 0 ? 'HOY' : m.diasRestantes + 'd'}
                                            </span>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        ` : ''}

                        <!-- Vencidas -->
                        ${alertas.membresiasVencidas > 0 ? `
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <h5 class="font-bold text-gray-900 flex items-center gap-2">
                                        <span class="w-2 h-2 bg-red-600 rounded-full animate-pulse"></span>
                                        Vencidas (${alertas.membresiasVencidas})
                                    </h5>
                                    <a href="/membresias" class="text-xs text-elit-red hover:underline font-bold">Ver todas →</a>
                                </div>
                                <div class="space-y-2 max-h-48 overflow-y-auto">
                                    ${alertas.detalleVencidas.slice(0, 5).map(m => `
                                        <div class="flex items-center justify-between p-3 bg-red-50 rounded-lg border border-red-200">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center">
                                                    <i data-lucide="user-x" class="w-4 h-4 text-white"></i>
                                                </div>
                                                <div>
                                                    <p class="font-bold text-sm text-gray-900">${m.clienteNombre}</p>
                                                    <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                </div>
                                            </div>
                                            <span class="px-3 py-1 bg-red-600 text-white rounded-full text-xs font-bold">
                                                ${m.diasVencido > 0 ? '-' + m.diasVencido : 'HOY'}d
                                            </span>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        ` : ''}
                    </div>
                `;
            }

            renderTopClientes(topClientes) {
                if (!topClientes || topClientes.length === 0) {
                    return `
                        <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-gray-100">
                            <div class="text-center py-12">
                                <div class="bg-gray-100 rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4">
                                    <i data-lucide="users" class="w-10 h-10 text-gray-400"></i>
                                </div>
                                <p class="text-lg font-bold text-gray-900 mb-2">Sin Datos</p>
                                <p class="text-sm text-gray-500">No hay información de asistencia</p>
                            </div>
                        </div>
                    `;
                }

                return `
                    <div class="bg-white rounded-xl shadow-lg p-6 border-2 border-gray-100">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="bg-yellow-100 rounded-lg p-3">
                                <i data-lucide="trophy" class="w-7 h-7 text-yellow-600"></i>
                            </div>
                            <h4 class="text-xl font-black text-gray-900">Top 10 Clientes del Mes</h4>
                        </div>
                        <div class="space-y-2 max-h-96 overflow-y-auto">
                            ${topClientes.map((cliente, index) => `
                                <div class="flex items-center justify-between p-3 rounded-lg ${
                                    index === 0 ? 'bg-gradient-to-r from-yellow-100 to-yellow-50 border-2 border-yellow-400' :
                                    index === 1 ? 'bg-gradient-to-r from-gray-100 to-gray-50 border-2 border-gray-400' :
                                    index === 2 ? 'bg-gradient-to-r from-orange-100 to-orange-50 border-2 border-orange-400' :
                                    'bg-gray-50 border border-gray-200'
                                }">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-lg ${
                                            index === 0 ? 'bg-gradient-to-br from-yellow-400 to-yellow-600' :
                                            index === 1 ? 'bg-gradient-to-br from-gray-400 to-gray-600' :
                                            index === 2 ? 'bg-gradient-to-br from-orange-400 to-orange-600' :
                                            'bg-black'
                                        } flex items-center justify-center text-white font-black">
                                            ${index + 1}
                                        </div>
                                        <div>
                                            <p class="font-bold text-gray-900">${cliente.nombre}</p>
                                            <p class="text-xs text-gray-600 flex items-center gap-1">
                                                <i data-lucide="activity" class="w-3 h-3"></i>
                                                ${cliente.totalCheckIns} visitas
                                            </p>
                                        </div>
                                    </div>
                                    ${index < 3 ? `
                                        <i data-lucide="award" class="w-6 h-6 ${
                                            index === 0 ? 'text-yellow-500' :
                                            index === 1 ? 'text-gray-500' :
                                            'text-orange-500'
                                        }"></i>
                                    ` : ''}
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            }

            renderAsistenciaChart(asistencia30dias) {
                const ctx = document.getElementById('asistenciaChart');
                if (!ctx) return;

                const labels = asistencia30dias.map(a => {
                    const fecha = new Date(a.Fecha);
                    return fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
                });
                const data = asistencia30dias.map(a => a.Total);

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Asistencias',
                            data: data,
                            borderColor: '#E31E24',
                            backgroundColor: 'rgba(227, 30, 36, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: '#E31E24',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                });
            }
        }

        // Inicializar dashboard
        const dashboard = new DashboardApp();
    </script>
}

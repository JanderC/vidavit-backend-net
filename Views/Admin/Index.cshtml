@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Resumen general del gimnasio";
}

<div id="dashboard-app">
    <!-- Loading State -->
    <div class="flex items-center justify-center h-64">
        <div class="text-center">
            <div class="animate-spin w-12 h-12 border-4 border-vida-primary border-t-transparent rounded-full mx-auto mb-4"></div>
            <p class="text-gray-600">Cargando estadísticas...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';

        class DashboardApp {
            constructor() {
                this.data = null;
                this.loadData();

                // Actualizar cada 30 segundos
                setInterval(() => this.loadData(), 30000);
            }

            async loadData() {
                try {
                    const response = await fetch(`${API_URL}/Dashboard/estadisticas`);
                    this.data = await response.json();
                    this.render();
                } catch (error) {
                    console.error('Error cargando datos:', error);
                }
            }

            render() {
                if (!this.data) return;

                const { resumen, alertas, topClientes } = this.data;

                document.getElementById('dashboard-app').innerHTML = `
                    <!-- Tarjetas de Estadísticas -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                        <!-- Total Clientes -->
                        <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-blue-500">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-600 text-sm font-medium">Total Clientes</p>
                                    <p class="text-3xl font-bold text-gray-800 mt-1">${resumen.totalClientes}</p>
                                    <p class="text-xs text-gray-500 mt-1">
                                        ${resumen.clientesConMembresia} con membresía activa
                                    </p>
                                </div>
                                <div class="bg-blue-100 rounded-full p-3">
                                    <i data-lucide="users" class="w-8 h-8 text-blue-600"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Check-ins Hoy -->
                        <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-green-500">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-600 text-sm font-medium">Check-ins Hoy</p>
                                    <p class="text-3xl font-bold text-gray-800 mt-1">${resumen.checkInsHoy}</p>
                                    <p class="text-xs text-green-600 mt-1 flex items-center gap-1">
                                        <i data-lucide="trending-up" class="w-3 h-3"></i>
                                        Tiempo real
                                    </p>
                                </div>
                                <div class="bg-green-100 rounded-full p-3">
                                    <i data-lucide="fingerprint" class="w-8 h-8 text-green-600"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Membresías Activas -->
                        <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-purple-500">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-600 text-sm font-medium">Membresías Activas</p>
                                    <p class="text-3xl font-bold text-gray-800 mt-1">${resumen.membresiasActivas}</p>
                                    <p class="text-xs text-gray-500 mt-1">
                                        ${alertas.membresiasProximasVencer} próximas a vencer
                                    </p>
                                </div>
                                <div class="bg-purple-100 rounded-full p-3">
                                    <i data-lucide="credit-card" class="w-8 h-8 text-purple-600"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Ingresos del Mes -->
                        <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-yellow-500">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-600 text-sm font-medium">Ingresos del Mes</p>
                                    <p class="text-3xl font-bold text-gray-800 mt-1">
                                        $${resumen.ingresosMes.toFixed(2)}
                                    </p>
                                    <p class="text-xs text-gray-500 mt-1">
                                        $${resumen.productosPendientes.toFixed(2)} pendientes
                                    </p>
                                </div>
                                <div class="bg-yellow-100 rounded-full p-3">
                                    <i data-lucide="dollar-sign" class="w-8 h-8 text-yellow-600"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alertas -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                        <!-- Membresías por Vencer -->
                        <div class="bg-white rounded-xl shadow-md overflow-hidden">
                            <div class="bg-orange-500 px-6 py-4">
                                <h3 class="text-white font-bold flex items-center gap-2">
                                    <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                                    Membresías por Vencer (${alertas.membresiasProximasVencer})
                                </h3>
                            </div>
                            <div class="p-6">
                                ${alertas.detalleProximasVencer.length > 0 ? `
                                    <div class="space-y-3 max-h-64 overflow-y-auto">
                                        ${alertas.detalleProximasVencer.map(m => `
                                            <div class="flex items-center justify-between p-3 bg-orange-50 rounded-lg">
                                                <div>
                                                    <p class="font-semibold text-gray-800">${m.clienteNombre}</p>
                                                    <p class="text-sm text-gray-600">${m.planNombre}</p>
                                                </div>
                                                <div class="text-right">
                                                    <span class="px-3 py-1 rounded-full text-sm font-bold ${
                                                        m.diasRestantes <= 3
                                                            ? 'bg-red-100 text-red-700'
                                                            : 'bg-orange-100 text-orange-700'
                                                    }">
                                                        ${m.diasRestantes} días
                                                    </span>
                                                </div>
                                            </div>
                                        `).join('')}
                                    </div>
                                ` : `
                                    <div class="text-center py-8 text-gray-500">
                                        <i data-lucide="check-circle" class="w-12 h-12 mx-auto mb-2 text-green-500"></i>
                                        <p>No hay membresías próximas a vencer</p>
                                    </div>
                                `}
                            </div>
                        </div>

                        <!-- Membresías Vencidas -->
                        <div class="bg-white rounded-xl shadow-md overflow-hidden">
                            <div class="bg-red-500 px-6 py-4">
                                <h3 class="text-white font-bold flex items-center gap-2">
                                    <i data-lucide="x-circle" class="w-5 h-5"></i>
                                    Membresías Vencidas (${alertas.membresiasVencidas})
                                </h3>
                            </div>
                            <div class="p-6">
                                ${alertas.detalleVencidas.length > 0 ? `
                                    <div class="space-y-3 max-h-64 overflow-y-auto">
                                        ${alertas.detalleVencidas.slice(0, 5).map(m => `
                                            <div class="flex items-center justify-between p-3 bg-red-50 rounded-lg">
                                                <div>
                                                    <p class="font-semibold text-gray-800">${m.clienteNombre}</p>
                                                    <p class="text-sm text-gray-600">${m.planNombre}</p>
                                                </div>
                                                <div class="text-right">
                                                    <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-bold">
                                                        Hace ${m.diasVencido} días
                                                    </span>
                                                </div>
                                            </div>
                                        `).join('')}
                                    </div>
                                    ${alertas.detalleVencidas.length > 5 ? `
                                        <a href="/membresias" class="block text-center text-sm text-blue-600 hover:text-blue-800 mt-4">
                                            Ver todas (${alertas.detalleVencidas.length})
                                        </a>
                                    ` : ''}
                                ` : `
                                    <div class="text-center py-8 text-gray-500">
                                        <i data-lucide="check-circle" class="w-12 h-12 mx-auto mb-2 text-green-500"></i>
                                        <p>No hay membresías vencidas</p>
                                    </div>
                                `}
                            </div>
                        </div>
                    </div>

                    <!-- Top Clientes -->
                    <div class="bg-white rounded-xl shadow-md overflow-hidden">
                        <div class="bg-vida-primary px-6 py-4">
                            <h3 class="text-vida-dark font-bold flex items-center gap-2">
                                <i data-lucide="trophy" class="w-5 h-5"></i>
                                Top 10 Clientes Más Activos
                            </h3>
                        </div>
                        <div class="p-6">
                            ${topClientes.length > 0 ? `
                                <div class="space-y-3">
                                    ${topClientes.map((cliente, index) => `
                                        <div class="flex items-center justify-between p-3 rounded-lg ${
                                            index === 0 ? 'bg-yellow-50 border-2 border-yellow-400' :
                                            index === 1 ? 'bg-gray-50 border-2 border-gray-400' :
                                            index === 2 ? 'bg-orange-50 border-2 border-orange-400' :
                                            'bg-gray-50'
                                        }">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-full ${
                                                    index === 0 ? 'bg-yellow-400' :
                                                    index === 1 ? 'bg-gray-400' :
                                                    index === 2 ? 'bg-orange-400' :
                                                    'bg-gray-300'
                                                } flex items-center justify-center text-white font-bold">
                                                    ${index + 1}
                                                </div>
                                                <div>
                                                    <p class="font-semibold text-gray-800">${cliente.nombre}</p>
                                                    <p class="text-sm text-gray-600">${cliente.totalCheckIns} visitas</p>
                                                </div>
                                            </div>
                                            ${index < 3 ? `
                                                <i data-lucide="medal" class="w-6 h-6 ${
                                                    index === 0 ? 'text-yellow-500' :
                                                    index === 1 ? 'text-gray-500' :
                                                    'text-orange-500'
                                                }"></i>
                                            ` : ''}
                                        </div>
                                    `).join('')}
                                </div>
                            ` : `
                                <div class="text-center py-8 text-gray-500">
                                    <i data-lucide="users" class="w-12 h-12 mx-auto mb-2"></i>
                                    <p>No hay datos disponibles</p>
                                </div>
                            `}
                        </div>
                    </div>
                `;

                lucide.createIcons();
            }
        }

        // Inicializar dashboard
        const dashboard = new DashboardApp();
    </script>
}
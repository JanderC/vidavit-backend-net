@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Panel de Control";
    Layout = "_AdminLayout";
}

<div id="dashboard-app">
    <div class="flex items-center justify-center h-64">
        <div class="text-center">
            <div class="animate-spin w-12 h-12 border-4 border-red-600 border-t-transparent rounded-full mx-auto mb-4"></div>
            <p class="text-gray-600">Cargando estadísticas...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';

        class DashboardApp {
            constructor() {
                this.cajaHoyData = null;
                this.estadisticasData = null;
                this.loadAllData();
                // Actualizar cada 30 segundos
                setInterval(() => this.loadAllData(), 30000);
            }

            async loadAllData() {
                try {
                    await Promise.all([
                        this.loadCajaHoy(),
                        this.loadEstadisticas()
                    ]);
                    this.render();
                } catch (error) {
                    console.error('Error cargando datos:', error);
                }
            }

            async loadCajaHoy() {
                try {
                    const response = await fetch(`${API_URL}/Caja/dashboard`);
                    const data = await response.json();

                    if (data.success) {
                        // Adaptar la estructura del nuevo endpoint al formato que espera el dashboard
                        this.cajaHoyData = {
                            success: true,
                            ingresos: data.hoy.ingresos,
                            egresos: data.hoy.egresos,
                            balance: data.hoy.balance,
                            ingresosEfectivo: data.cajaActual.efectivo.ingresos,
                            egresosEfectivo: data.cajaActual.efectivo.egresos,
                            ingresosTransferencia: data.cajaActual.transferencia.ingresos,
                            egresosTransferencia: data.cajaActual.transferencia.egresos,
                            cantidadMovimientos: data.hoy.cantidadMovimientos
                        };
                    }
                } catch (error) {
                    console.error('Error cargando datos de caja:', error);
                }
            }

            async loadEstadisticas() {
                try {
                    const response = await fetch(`${API_URL}/Dashboard/estadisticas`);
                    this.estadisticasData = await response.json();
                } catch (error) {
                    console.error('Error cargando estadísticas:', error);
                }
            }

            formatCurrency(value) {
                return new Intl.NumberFormat('es-CO', {
                    style: 'currency',
                    currency: 'COP',
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                }).format(value);
            }

            getCategoriaConfig(categoria) {
                const configs = {
                    'membresia': { nombre: 'Membresías', icono: 'badge-check', color: 'red' },
                    'producto': { nombre: 'Productos', icono: 'shopping-bag', color: 'emerald' },
                    'abono_deuda': { nombre: 'Abonos', icono: 'coins', color: 'blue' },
                    'default': { nombre: 'Otros', icono: 'plus-circle', color: 'purple' }
                };
                return configs[categoria] || configs['default'];
            }

            render() {
                if (!this.cajaHoyData || !this.estadisticasData) return;

                const { resumen, alertas, topClientes } = this.estadisticasData;
                const { ingresos, egresos, balance, ingresosEfectivo, egresosEfectivo,
                        ingresosTransferencia, egresosTransferencia, cantidadMovimientos } = this.cajaHoyData;

                document.getElementById('dashboard-app').innerHTML = `
                    <!-- Resumen de Caja Hoy -->
                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-5 uppercase tracking-wide flex items-center gap-2">
                            <i data-lucide="wallet" class="w-6 h-6 text-emerald-600"></i>
                            Estado de Caja - Hoy
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                            <!-- Total Ingresos Hoy -->
                            <div class="bg-gradient-to-br from-emerald-500 to-emerald-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 transition-all">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="trending-up" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold bg-white/20 px-3 py-1 rounded-full backdrop-blur-sm">HOY</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1 text-emerald-100">Ingresos de Hoy</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(ingresos)}</p>
                                    <p class="text-xs mt-2 text-emerald-100">
                                        ${cantidadMovimientos} movimientos hoy
                                    </p>
                                </div>
                            </div>

                            <!-- Efectivo -->
                            <div class="bg-gradient-to-br from-blue-500 to-blue-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 transition-all">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="banknote" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold bg-white/20 px-3 py-1 rounded-full backdrop-blur-sm">EFECTIVO</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1 text-blue-100">En Efectivo</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(ingresosEfectivo)}</p>
                                    <p class="text-xs mt-2 text-blue-100">
                                        Egresos: ${this.formatCurrency(egresosEfectivo)}
                                    </p>
                                </div>
                            </div>

                            <!-- Transferencias -->
                            <div class="bg-gradient-to-br from-purple-500 to-purple-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 transition-all">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="credit-card" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold bg-white/20 px-3 py-1 rounded-full backdrop-blur-sm">DIGITAL</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1 text-purple-100">Transferencias</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(ingresosTransferencia)}</p>
                                    <p class="text-xs mt-2 text-purple-100">
                                        Egresos: ${this.formatCurrency(egresosTransferencia)}
                                    </p>
                                </div>
                            </div>

                            <!-- Balance General -->
                            <div class="bg-gradient-to-br from-amber-500 to-orange-600 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 transition-all">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="chart-bar" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold bg-white/20 px-3 py-1 rounded-full backdrop-blur-sm">BALANCE</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1 text-amber-100">Balance del Día</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(balance)}</p>
                                    <p class="text-xs mt-2 text-amber-100">
                                        Egresos: ${this.formatCurrency(egresos)}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Acciones Rápidas -->
                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-5 uppercase tracking-wide">Acciones Rápidas</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                            <a href="/clientes/crear" class="bg-gradient-to-br from-gray-800 to-black text-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-6 group relative overflow-hidden">
                                <div class="absolute inset-0 bg-red-600 opacity-0 group-hover:opacity-10 transition-opacity"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="bg-red-600 rounded-xl p-3 group-hover:scale-110 transition-transform shadow-lg">
                                            <i data-lucide="user-plus" class="w-7 h-7"></i>
                                        </div>
                                        <i data-lucide="arrow-right" class="w-5 h-5 opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                                    </div>
                                    <h4 class="text-lg font-black mb-1 uppercase tracking-wide">Agregar Cliente</h4>
                                    <p class="text-gray-400 text-sm">Registrar nuevo miembro</p>
                                </div>
                            </a>

                            <a href="/productos/vender" class="bg-gradient-to-br from-emerald-700 to-emerald-900 text-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-6 group relative overflow-hidden">
                                <div class="absolute inset-0 bg-emerald-400 opacity-0 group-hover:opacity-10 transition-opacity"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="bg-emerald-500 rounded-xl p-3 group-hover:scale-110 transition-transform shadow-lg">
                                            <i data-lucide="shopping-cart" class="w-7 h-7"></i>
                                        </div>
                                        <i data-lucide="arrow-right" class="w-5 h-5 opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                                    </div>
                                    <h4 class="text-lg font-black mb-1 uppercase tracking-wide">Vender Productos</h4>
                                    <p class="text-emerald-200 text-sm">Registrar venta</p>
                                </div>
                            </a>

                            <a href="/membresias/crear" class="bg-gradient-to-br from-red-600 to-red-800 text-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-6 group relative overflow-hidden">
                                <div class="absolute inset-0 bg-red-400 opacity-0 group-hover:opacity-10 transition-opacity"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="bg-red-500 rounded-xl p-3 group-hover:scale-110 transition-transform shadow-lg">
                                            <i data-lucide="badge-check" class="w-7 h-7"></i>
                                        </div>
                                        <i data-lucide="arrow-right" class="w-5 h-5 opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                                    </div>
                                    <h4 class="text-lg font-black mb-1 uppercase tracking-wide">Nueva Membresía</h4>
                                    <p class="text-red-200 text-sm">Vender membresía</p>
                                </div>
                            </a>

                            <a href="/caja/cierre" class="bg-gradient-to-br from-amber-600 to-orange-700 text-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-6 group relative overflow-hidden">
                                <div class="absolute inset-0 bg-amber-400 opacity-0 group-hover:opacity-10 transition-opacity"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="bg-amber-500 rounded-xl p-3 group-hover:scale-110 transition-transform shadow-lg">
                                            <i data-lucide="calculator" class="w-7 h-7"></i>
                                        </div>
                                        <i data-lucide="arrow-right" class="w-5 h-5 opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                                    </div>
                                    <h4 class="text-lg font-black mb-1 uppercase tracking-wide">Cerrar Caja</h4>
                                    <p class="text-amber-100 text-sm">Cierre de caja</p>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- Estadísticas Generales -->
                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-5 uppercase tracking-wide">Estadísticas Generales</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                            <div class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg p-6 border-l-4 border-red-600 hover:shadow-xl transition-all transform hover:-translate-y-1">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm text-gray-600 mb-1 font-bold uppercase tracking-wide">Total Clientes</p>
                                        <p class="text-3xl font-black text-gray-900">${resumen.totalClientes}</p>
                                        <p class="text-xs text-emerald-600 mt-2 font-bold">
                                            <i data-lucide="check-circle" class="w-3 h-3 inline"></i>
                                            ${resumen.clientesConMembresia} con membresía
                                        </p>
                                    </div>
                                    <div class="bg-red-100 rounded-2xl p-4">
                                        <i data-lucide="users" class="w-8 h-8 text-red-600"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg p-6 border-l-4 border-emerald-600 hover:shadow-xl transition-all transform hover:-translate-y-1">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm text-gray-600 mb-1 font-bold uppercase tracking-wide">Membresías Activas</p>
                                        <p class="text-3xl font-black text-gray-900">${resumen.membresiasActivas}</p>
                                        <p class="text-xs text-gray-500 mt-2 font-bold">
                                            Estado actual
                                        </p>
                                    </div>
                                    <div class="bg-emerald-100 rounded-2xl p-4">
                                        <i data-lucide="badge-check" class="w-8 h-8 text-emerald-600"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg p-6 border-l-4 border-blue-600 hover:shadow-xl transition-all transform hover:-translate-y-1">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm text-gray-600 mb-1 font-bold uppercase tracking-wide">Check-ins Hoy</p>
                                        <p class="text-3xl font-black text-gray-900">${resumen.checkInsHoy}</p>
                                        <p class="text-xs text-gray-500 mt-2 font-bold">
                                            Asistencias registradas
                                        </p>
                                    </div>
                                    <div class="bg-blue-100 rounded-2xl p-4">
                                        <i data-lucide="fingerprint" class="w-8 h-8 text-blue-600"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg p-6 border-l-4 border-purple-600 hover:shadow-xl transition-all transform hover:-translate-y-1">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm text-gray-600 mb-1 font-bold uppercase tracking-wide">Ingresos del Mes</p>
                                        <p class="text-3xl font-black text-gray-900">${this.formatCurrency(resumen.ingresosMes)}</p>
                                        <p class="text-xs text-gray-500 mt-2 font-bold">
                                            Total acumulado
                                        </p>
                                    </div>
                                    <div class="bg-purple-100 rounded-2xl p-4">
                                        <i data-lucide="trending-up" class="w-8 h-8 text-purple-600"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alertas y Top Clientes -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                        ${this.renderAlertas(alertas)}
                        ${this.renderTopClientes(topClientes)}
                    </div>
                `;

                lucide.createIcons();
            }

            renderAlertas(alertas) {
                return `
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                        <div class="bg-gradient-to-r from-orange-600 to-red-600 px-6 py-5">
                            <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                                Alertas de Membresías
                            </h3>
                        </div>
                        <div class="p-6">
                            ${alertas.membresiasProximasVencer > 0 || alertas.membresiasVencidas > 0 ? `
                                <div class="space-y-5">
                                    ${alertas.membresiasProximasVencer > 0 ? `
                                        <div>
                                            <div class="flex items-center justify-between mb-3">
                                                <h4 class="font-bold text-gray-800 uppercase text-sm tracking-wide">Por Vencer (${alertas.membresiasProximasVencer})</h4>
                                                <a href="/membresias" class="text-xs text-orange-600 hover:text-orange-800 font-bold uppercase">Ver todas →</a>
                                            </div>
                                            <div class="space-y-2 max-h-48 overflow-y-auto">
                                                ${alertas.detalleProximasVencer.slice(0, 3).map(m => `
                                                    <div class="flex items-center justify-between p-3 bg-gradient-to-r from-orange-50 to-amber-50 rounded-xl border border-orange-200 text-sm hover:shadow-md transition-shadow">
                                                        <div>
                                                            <p class="font-bold text-gray-800">${m.clienteNombre}</p>
                                                            <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                        </div>
                                                        <span class="px-3 py-1 rounded-full text-xs font-black ${
                                                            m.diasRestantes <= 3 ? 'bg-red-600 text-white' : 'bg-orange-500 text-white'
                                                        }">
                                                            ${m.diasRestantes}d
                                                        </span>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    ` : ''}

                                    ${alertas.membresiasVencidas > 0 ? `
                                        <div class="${alertas.membresiasProximasVencer > 0 ? 'pt-5 border-t-2 border-gray-200' : ''}">
                                            <div class="flex items-center justify-between mb-3">
                                                <h4 class="font-bold text-gray-800 uppercase text-sm tracking-wide">Vencidas (${alertas.membresiasVencidas})</h4>
                                                <a href="/membresias" class="text-xs text-red-600 hover:text-red-800 font-bold uppercase">Ver todas →</a>
                                            </div>
                                            <div class="space-y-2 max-h-32 overflow-y-auto">
                                                ${alertas.detalleVencidas.slice(0, 3).map(m => `
                                                    <div class="flex items-center justify-between p-3 bg-gradient-to-r from-red-50 to-pink-50 rounded-xl border border-red-200 text-sm hover:shadow-md transition-shadow">
                                                        <div>
                                                            <p class="font-bold text-gray-800">${m.clienteNombre}</p>
                                                            <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                        </div>
                                                        <span class="px-3 py-1 bg-red-600 text-white rounded-full text-xs font-black">
                                                            ${m.diasVencido > 0 ? '-' + m.diasVencido : 'HOY'}d
                                                        </span>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    ` : ''}
                                </div>
                            ` : `
                                <div class="text-center py-12 text-gray-500">
                                    <i data-lucide="check-circle" class="w-16 h-16 mx-auto mb-3 text-emerald-500"></i>
                                    <p class="font-bold text-gray-700">No hay alertas pendientes</p>
                                    <p class="text-sm text-gray-500 mt-1">Todo en orden</p>
                                </div>
                            `}
                        </div>
                    </div>
                `;
            }

            renderTopClientes(topClientes) {
                return `
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                        <div class="bg-gradient-to-r from-gray-800 to-black px-6 py-5">
                            <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                <i data-lucide="trophy" class="w-6 h-6"></i>
                                Top 10 Clientes del Mes
                            </h3>
                        </div>
                        <div class="p-6">
                            ${topClientes && topClientes.length > 0 ? `
                                <div class="space-y-2 max-h-96 overflow-y-auto">
                                    ${topClientes.map((cliente, index) => `
                                        <div class="flex items-center justify-between p-3 rounded-xl transition-all hover:shadow-md ${
                                            index === 0 ? 'bg-gradient-to-r from-yellow-100 to-amber-100 border-2 border-yellow-400' :
                                            index === 1 ? 'bg-gradient-to-r from-gray-100 to-slate-100 border-2 border-gray-400' :
                                            index === 2 ? 'bg-gradient-to-r from-orange-100 to-amber-100 border-2 border-orange-400' :
                                            'bg-gray-50 border border-gray-200'
                                        }">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-full ${
                                                    index === 0 ? 'bg-gradient-to-br from-yellow-400 to-amber-500' :
                                                    index === 1 ? 'bg-gradient-to-br from-gray-400 to-slate-500' :
                                                    index === 2 ? 'bg-gradient-to-br from-orange-400 to-amber-500' :
                                                    'bg-gray-700'
                                                } flex items-center justify-center text-white font-black text-sm shadow-lg">
                                                    ${index + 1}
                                                </div>
                                                <div>
                                                    <p class="font-bold text-gray-900 text-sm">${cliente.nombre}</p>
                                                    <p class="text-xs text-gray-600 font-semibold">${cliente.totalCheckIns} visitas</p>
                                                </div>
                                            </div>
                                            ${index < 3 ? `
                                                <i data-lucide="award" class="w-6 h-6 ${
                                                    index === 0 ? 'text-yellow-500' :
                                                    index === 1 ? 'text-gray-500' :
                                                    'text-orange-500'
                                                }"></i>
                                            ` : ''}
                                        </div>
                                    `).join('')}
                                </div>
                            ` : `
                                <div class="text-center py-12 text-gray-500">
                                    <i data-lucide="users" class="w-16 h-16 mx-auto mb-3 text-gray-400"></i>
                                    <p class="font-bold text-gray-700">No hay datos disponibles</p>
                                </div>
                            `}
                        </div>
                    </div>
                `;
            }
        }

        const dashboard = new DashboardApp();
    </script>
}

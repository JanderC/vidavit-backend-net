@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Bienvenido al panel de administración";
    Layout = "_AdminLayout";
}

<div id="dashboard-app">
    <!-- Loading State -->
    <div class="flex items-center justify-center h-64">
        <div class="text-center">
            <div class="animate-spin w-12 h-12 border-4 border-vida-primary border-t-transparent rounded-full mx-auto mb-4"></div>
            <p class="text-gray-600">Cargando estadísticas...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';

        class DashboardApp {
            constructor() {
                this.data = null;
                this.loadData();

                // Actualizar cada 30 segundos
                setInterval(() => this.loadData(), 30000);
            }

            async loadData() {
                try {
                    const response = await fetch(`${API_URL}/Dashboard/estadisticas`);
                    this.data = await response.json();
                    this.render();
                } catch (error) {
                    console.error('Error cargando datos:', error);
                }
            }

            render() {
                if (!this.data) return;

                const { resumen, alertas, topClientes } = this.data;

                document.getElementById('dashboard-app').innerHTML = `
                    <!-- Accesos Rápidos -->
                    <div class="mb-8">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Acciones Rápidas</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                            <!-- Agregar Cliente -->
                            <a href="/clientes/crear" class="bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 p-6 group">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="bg-white bg-opacity-20 rounded-full p-3 group-hover:scale-110 transition-transform">
                                        <i data-lucide="user-plus" class="w-7 h-7"></i>
                                    </div>
                                    <i data-lucide="arrow-right" class="w-5 h-5 opacity-70"></i>
                                </div>
                                <h4 class="text-lg font-bold mb-1">Agregar Cliente</h4>
                                <p class="text-blue-100 text-sm">Registrar nuevo cliente</p>
                            </a>

                            <!-- Vender Productos -->
                            <a href="/productos/vender" class="bg-gradient-to-br from-green-500 to-green-600 text-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 p-6 group">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="bg-white bg-opacity-20 rounded-full p-3 group-hover:scale-110 transition-transform">
                                        <i data-lucide="shopping-cart" class="w-7 h-7"></i>
                                    </div>
                                    <i data-lucide="arrow-right" class="w-5 h-5 opacity-70"></i>
                                </div>
                                <h4 class="text-lg font-bold mb-1">Vender Productos</h4>
                                <p class="text-green-100 text-sm">Registrar venta</p>
                            </a>

                            <!-- Agregar Producto -->
                            <a href="/productos/crear" class="bg-gradient-to-br from-purple-500 to-purple-600 text-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 p-6 group">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="bg-white bg-opacity-20 rounded-full p-3 group-hover:scale-110 transition-transform">
                                        <i data-lucide="package-plus" class="w-7 h-7"></i>
                                    </div>
                                    <i data-lucide="arrow-right" class="w-5 h-5 opacity-70"></i>
                                </div>
                                <h4 class="text-lg font-bold mb-1">Agregar Producto</h4>
                                <p class="text-purple-100 text-sm">Añadir al inventario</p>
                            </a>

                            <!-- Cuentas Pendientes -->
                            <a href="/productos/cuentas-pendientes" class="bg-gradient-to-br from-orange-500 to-orange-600 text-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 p-6 group">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="bg-white bg-opacity-20 rounded-full p-3 group-hover:scale-110 transition-transform">
                                        <i data-lucide="alert-circle" class="w-7 h-7"></i>
                                    </div>
                                    <i data-lucide="arrow-right" class="w-5 h-5 opacity-70"></i>
                                </div>
                                <h4 class="text-lg font-bold mb-1">Fiar Producto</h4>
                                <p class="text-orange-100 text-sm">Cuentas pendientes</p>
                            </a>
                        </div>
                    </div>

                    <!-- Tarjetas de Estadísticas -->
                    <div class="mb-8">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Estadísticas de Hoy</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                            <!-- Total Clientes -->
                            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-blue-500 hover:shadow-lg transition-shadow">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-xs font-medium uppercase">Total Clientes</p>
                                        <p class="text-3xl font-bold text-gray-800 mt-1">${resumen.totalClientes}</p>
                                        <p class="text-xs text-gray-500 mt-1">
                                            ${resumen.clientesConMembresia} activos
                                        </p>
                                    </div>
                                    <div class="bg-blue-100 rounded-full p-3">
                                        <i data-lucide="users" class="w-6 h-6 text-blue-600"></i>
                                    </div>
                                </div>
                            </div>

                            <!-- Check-ins Hoy -->
                            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-green-500 hover:shadow-lg transition-shadow">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-xs font-medium uppercase">Check-ins Hoy</p>
                                        <p class="text-3xl font-bold text-gray-800 mt-1">${resumen.checkInsHoy}</p>
                                        <p class="text-xs text-green-600 mt-1 flex items-center gap-1">
                                            <i data-lucide="activity" class="w-3 h-3"></i>
                                            En tiempo real
                                        </p>
                                    </div>
                                    <div class="bg-green-100 rounded-full p-3">
                                        <i data-lucide="fingerprint" class="w-6 h-6 text-green-600"></i>
                                    </div>
                                </div>
                            </div>

                            <!-- Membresías Activas -->
                            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-purple-500 hover:shadow-lg transition-shadow">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-xs font-medium uppercase">Membresías</p>
                                        <p class="text-3xl font-bold text-gray-800 mt-1">${resumen.membresiasActivas}</p>
                                        <p class="text-xs text-orange-600 mt-1">
                                            ${alertas.membresiasProximasVencer} por vencer
                                        </p>
                                    </div>
                                    <div class="bg-purple-100 rounded-full p-3">
                                        <i data-lucide="credit-card" class="w-6 h-6 text-purple-600"></i>
                                    </div>
                                </div>
                            </div>

                            <!-- Ingresos del Mes -->
                            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-yellow-500 hover:shadow-lg transition-shadow">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-xs font-medium uppercase">Ingresos Mes</p>
                                        <p class="text-3xl font-bold text-gray-800 mt-1">
                                            $${resumen.ingresosMes.toFixed(0)}
                                        </p>
                                        <p class="text-xs text-gray-500 mt-1">
                                            $${resumen.productosPendientes.toFixed(0)} fiados
                                        </p>
                                    </div>
                                    <div class="bg-yellow-100 rounded-full p-3">
                                        <i data-lucide="dollar-sign" class="w-6 h-6 text-yellow-600"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alertas y Top Clientes en 2 columnas -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Alertas Combinadas -->
                        <div class="bg-white rounded-xl shadow-md overflow-hidden">
                            <div class="bg-gradient-to-r from-orange-500 to-red-500 px-6 py-4">
                                <h3 class="text-white font-bold flex items-center gap-2">
                                    <i data-lucide="bell" class="w-5 h-5"></i>
                                    Alertas Importantes
                                </h3>
                            </div>
                            <div class="p-6">
                                ${alertas.membresiasProximasVencer > 0 || alertas.membresiasVencidas > 0 ? `
                                    <div class="space-y-4">
                                        ${alertas.membresiasProximasVencer > 0 ? `
                                            <div>
                                                <div class="flex items-center justify-between mb-2">
                                                    <h4 class="font-semibold text-gray-800 text-sm">Por Vencer (${alertas.membresiasProximasVencer})</h4>
                                                    <a href="/membresias" class="text-xs text-orange-600 hover:text-orange-800">Ver todas →</a>
                                                </div>
                                                <div class="space-y-2 max-h-48 overflow-y-auto">
                                                    ${alertas.detalleProximasVencer.slice(0, 3).map(m => `
                                                        <div class="flex items-center justify-between p-2 bg-orange-50 rounded text-sm">
                                                            <span class="font-medium text-gray-800">${m.clienteNombre}</span>
                                                            <span class="px-2 py-1 rounded-full text-xs font-bold ${
                                                                m.diasRestantes <= 3 ? 'bg-red-100 text-red-700' : 'bg-orange-100 text-orange-700'
                                                            }">
                                                                ${m.diasRestantes}d
                                                            </span>
                                                        </div>
                                                    `).join('')}
                                                </div>
                                            </div>
                                        ` : ''}

                                        ${alertas.membresiasVencidas > 0 ? `
                                            <div class="pt-4 border-t">
                                                <div class="flex items-center justify-between mb-2">
                                                    <h4 class="font-semibold text-gray-800 text-sm">Vencidas (${alertas.membresiasVencidas})</h4>
                                                    <a href="/membresias" class="text-xs text-red-600 hover:text-red-800">Ver todas →</a>
                                                </div>
                                                <div class="space-y-2 max-h-32 overflow-y-auto">
                                                    ${alertas.detalleVencidas.slice(0, 3).map(m => `
                                                        <div class="flex items-center justify-between p-2 bg-red-50 rounded text-sm">
                                                            <span class="font-medium text-gray-800">${m.clienteNombre}</span>
                                                            <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs font-bold">
                                                                -${m.diasVencido}d
                                                            </span>
                                                        </div>
                                                    `).join('')}
                                                </div>
                                            </div>
                                        ` : ''}
                                    </div>
                                ` : `
                                    <div class="text-center py-8 text-gray-500">
                                        <i data-lucide="check-circle" class="w-12 h-12 mx-auto mb-2 text-green-500"></i>
                                        <p class="text-sm">No hay alertas pendientes</p>
                                    </div>
                                `}
                            </div>
                        </div>

                        <!-- Top Clientes -->
                        <div class="bg-white rounded-xl shadow-md overflow-hidden">
                            <div class="bg-gradient-to-r from-vida-primary to-vida-accent px-6 py-4">
                                <h3 class="text-vida-dark font-bold flex items-center gap-2">
                                    <i data-lucide="trophy" class="w-5 h-5"></i>
                                    Top 10 Clientes del Mes
                                </h3>
                            </div>
                            <div class="p-6">
                                ${topClientes.length > 0 ? `
                                    <div class="space-y-2">
                                        ${topClientes.map((cliente, index) => `
                                            <div class="flex items-center justify-between p-3 rounded-lg ${
                                                index === 0 ? 'bg-yellow-50 border border-yellow-200' :
                                                index === 1 ? 'bg-gray-50 border border-gray-200' :
                                                index === 2 ? 'bg-orange-50 border border-orange-200' :
                                                'bg-gray-50'
                                            }">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-8 h-8 rounded-full ${
                                                        index === 0 ? 'bg-yellow-400' :
                                                        index === 1 ? 'bg-gray-400' :
                                                        index === 2 ? 'bg-orange-400' :
                                                        'bg-gray-300'
                                                    } flex items-center justify-center text-white font-bold text-sm">
                                                        ${index + 1}
                                                    </div>
                                                    <div>
                                                        <p class="font-semibold text-gray-800 text-sm">${cliente.nombre}</p>
                                                        <p class="text-xs text-gray-600">${cliente.totalCheckIns} visitas</p>
                                                    </div>
                                                </div>
                                                ${index < 3 ? `
                                                    <i data-lucide="award" class="w-5 h-5 ${
                                                        index === 0 ? 'text-yellow-500' :
                                                        index === 1 ? 'text-gray-500' :
                                                        'text-orange-500'
                                                    }"></i>
                                                ` : ''}
                                            </div>
                                        `).join('')}
                                    </div>
                                ` : `
                                    <div class="text-center py-8 text-gray-500">
                                        <i data-lucide="users" class="w-12 h-12 mx-auto mb-2"></i>
                                        <p class="text-sm">No hay datos disponibles</p>
                                    </div>
                                `}
                            </div>
                        </div>
                    </div>
                `;

                lucide.createIcons();
            }
        }

        // Inicializar dashboard
        const dashboard = new DashboardApp();
    </script>
}

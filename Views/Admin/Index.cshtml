@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Panel de Control";
    Layout = "_AdminLayout";
}

<div id="dashboard-app">
    <div class="flex items-center justify-center h-64">
        <div class="text-center">
            <div class="animate-spin w-12 h-12 border-4 border-orange-600 border-t-transparent rounded-full mx-auto mb-4"></div>
            <p class="text-gray-600">Cargando estadísticas...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';

        class DashboardApp {
            constructor() {
                this.cajaHoyData = null;
                this.estadisticasData = null;
                this.loadAllData();
                setInterval(() => this.loadAllData(), 30000);
            }

            async loadAllData() {
                try {
                    await Promise.all([
                        this.loadCajaHoy(),
                        this.loadEstadisticas()
                    ]);
                    this.render();
                } catch (error) {
                    console.error('Error cargando datos:', error);
                }
            }

            async loadCajaHoy() {
                try {
                    const response = await fetch(`${API_URL}/Caja/dashboard`);
                    const data = await response.json();

                    if (data.success) {
                        this.cajaHoyData = {
                            success: true,
                            ingresos: data.cajaHoy.totalIngresos || 0,
                            egresos: data.cajaHoy.totalEgresos || 0,
                            balance: data.cajaHoy.balance || 0,
                            ingresosEfectivo: data.cajaHoy.efectivo?.ingresos || 0,
                            egresosEfectivo: data.cajaHoy.efectivo?.egresos || 0,
                            ingresosTransferencia: data.cajaHoy.transferencia?.ingresos || 0,
                            egresosTransferencia: data.cajaHoy.transferencia?.egresos || 0,
                            cantidadMovimientos: data.cajaHoy.cantidadMovimientos || 0
                        };
                    }
                } catch (error) {
                    console.error('Error cargando datos de caja:', error);
                }
            }

            async loadEstadisticas() {
                try {
                    const response = await fetch(`${API_URL}/Dashboard/estadisticas`);
                    this.estadisticasData = await response.json();
                } catch (error) {
                    console.error('Error cargando estadísticas:', error);
                }
            }

            formatCurrency(value) {
                return new Intl.NumberFormat('es-CO', {
                    style: 'currency',
                    currency: 'COP',
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                }).format(value || 0);
            }

            render() {
                if (!this.cajaHoyData || !this.estadisticasData) return;

                const { resumen, alertas, topClientes } = this.estadisticasData;
                const { ingresos, egresos, balance, ingresosEfectivo, egresosEfectivo,
                        ingresosTransferencia, egresosTransferencia, cantidadMovimientos } = this.cajaHoyData;

                document.getElementById('dashboard-app').innerHTML = `
                    <!-- Resumen de Caja Hoy -->
                    <div class="mb-8">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-2xl font-black text-gray-800 uppercase tracking-wide flex items-center gap-3">
                                <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-orange-700 rounded-xl flex items-center justify-center">
                                    <i data-lucide="wallet" class="w-6 h-6 text-white"></i>
                                </div>
                                Caja del Día
                            </h3>
                            <div class="bg-gradient-to-r from-orange-100 to-amber-100 px-5 py-2 rounded-full border-2 border-orange-400">
                                <p class="text-sm font-black text-orange-800 uppercase tracking-wide">${new Date().toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long' })}</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                            <div class="bg-gradient-to-br from-orange-500 to-orange-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 hover:shadow-2xl transition-all duration-300">
                                <div class="absolute top-0 right-0 -mt-6 -mr-6 w-40 h-40 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3 shadow-lg">
                                            <i data-lucide="trending-up" class="w-8 h-8"></i>
                                        </div>
                                        <span class="text-xs font-black bg-white/30 px-4 py-1.5 rounded-full backdrop-blur-sm shadow-lg uppercase tracking-wider">Ingresos</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-2 text-orange-100 font-bold">Total Hoy</p>
                                    <p class="text-4xl font-black mb-3">${this.formatCurrency(ingresos)}</p>
                                    <div class="flex items-center gap-2 text-orange-100">
                                        <i data-lucide="activity" class="w-4 h-4"></i>
                                        <p class="text-xs font-semibold">
                                            ${cantidadMovimientos} ${cantidadMovimientos === 1 ? 'movimiento' : 'movimientos'}
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-gradient-to-br from-red-500 to-red-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 hover:shadow-2xl transition-all duration-300">
                                <div class="absolute top-0 right-0 -mt-6 -mr-6 w-40 h-40 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3 shadow-lg">
                                            <i data-lucide="trending-down" class="w-8 h-8"></i>
                                        </div>
                                        <span class="text-xs font-black bg-white/30 px-4 py-1.5 rounded-full backdrop-blur-sm shadow-lg uppercase tracking-wider">Egresos</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-2 text-red-100 font-bold">Gastos Hoy</p>
                                    <p class="text-4xl font-black mb-3">${this.formatCurrency(egresos)}</p>
                                    <div class="flex items-center gap-2 text-red-100">
                                        <i data-lucide="arrow-down" class="w-4 h-4"></i>
                                        <p class="text-xs font-semibold">Salidas del día</p>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-gradient-to-br from-emerald-500 to-emerald-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 hover:shadow-2xl transition-all duration-300">
                                <div class="absolute top-0 right-0 -mt-6 -mr-6 w-40 h-40 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3 shadow-lg">
                                            <i data-lucide="dollar-sign" class="w-8 h-8"></i>
                                        </div>
                                        <span class="text-xs font-black bg-white/30 px-4 py-1.5 rounded-full backdrop-blur-sm shadow-lg uppercase tracking-wider">Balance</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-2 text-emerald-100 font-bold">Neto del Día</p>
                                    <p class="text-4xl font-black mb-3">${this.formatCurrency(balance)}</p>
                                    <div class="flex items-center gap-2 text-emerald-100">
                                        <i data-lucide="wallet" class="w-4 h-4"></i>
                                        <p class="text-xs font-semibold">Diferencia total</p>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-gradient-to-br from-purple-500 to-purple-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 hover:shadow-2xl transition-all duration-300">
                                <div class="absolute top-0 right-0 -mt-6 -mr-6 w-40 h-40 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3 shadow-lg">
                                            <i data-lucide="credit-card" class="w-8 h-8"></i>
                                        </div>
                                        <span class="text-xs font-black bg-white/30 px-4 py-1.5 rounded-full backdrop-blur-sm shadow-lg uppercase tracking-wider">Efectivo</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-2 text-purple-100 font-bold">En Caja</p>
                                    <p class="text-4xl font-black mb-3">${this.formatCurrency(ingresosEfectivo - egresosEfectivo)}</p>
                                    <div class="flex items-center gap-2 text-purple-100">
                                        <i data-lucide="banknote" class="w-4 h-4"></i>
                                        <p class="text-xs font-semibold">Efectivo disponible</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Detalles de Métodos de Pago -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                            <div class="bg-gradient-to-r from-green-600 to-green-700 px-6 py-5">
                                <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                    <i data-lucide="banknote" class="w-6 h-6"></i>
                                    Efectivo
                                </h3>
                            </div>
                            <div class="p-6 space-y-4">
                                <div class="flex items-center justify-between p-4 bg-green-50 rounded-xl border-2 border-green-200">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-green-700 rounded-xl flex items-center justify-center shadow-lg">
                                            <i data-lucide="arrow-up" class="w-6 h-6 text-white"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-bold uppercase tracking-wide">Ingresos</p>
                                            <p class="text-2xl font-black text-gray-900">${this.formatCurrency(ingresosEfectivo)}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between p-4 bg-red-50 rounded-xl border-2 border-red-200">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 bg-gradient-to-br from-red-500 to-red-700 rounded-xl flex items-center justify-center shadow-lg">
                                            <i data-lucide="arrow-down" class="w-6 h-6 text-white"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-bold uppercase tracking-wide">Egresos</p>
                                            <p class="text-2xl font-black text-gray-900">${this.formatCurrency(egresosEfectivo)}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="pt-4 border-t-2 border-gray-200">
                                    <div class="flex items-center justify-between">
                                        <p class="text-sm font-bold text-gray-600 uppercase tracking-wide">Balance Total</p>
                                        <p class="text-3xl font-black ${ingresosEfectivo - egresosEfectivo >= 0 ? 'text-green-600' : 'text-red-600'}">${this.formatCurrency(ingresosEfectivo - egresosEfectivo)}</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                            <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-5">
                                <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                    <i data-lucide="credit-card" class="w-6 h-6"></i>
                                    Transferencias
                                </h3>
                            </div>
                            <div class="p-6 space-y-4">
                                <div class="flex items-center justify-between p-4 bg-blue-50 rounded-xl border-2 border-blue-200">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-700 rounded-xl flex items-center justify-center shadow-lg">
                                            <i data-lucide="arrow-up" class="w-6 h-6 text-white"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-bold uppercase tracking-wide">Ingresos</p>
                                            <p class="text-2xl font-black text-gray-900">${this.formatCurrency(ingresosTransferencia)}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between p-4 bg-red-50 rounded-xl border-2 border-red-200">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 bg-gradient-to-br from-red-500 to-red-700 rounded-xl flex items-center justify-center shadow-lg">
                                            <i data-lucide="arrow-down" class="w-6 h-6 text-white"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-bold uppercase tracking-wide">Egresos</p>
                                            <p class="text-2xl font-black text-gray-900">${this.formatCurrency(egresosTransferencia)}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="pt-4 border-t-2 border-gray-200">
                                    <div class="flex items-center justify-between">
                                        <p class="text-sm font-bold text-gray-600 uppercase tracking-wide">Balance Total</p>
                                        <p class="text-3xl font-black ${ingresosTransferencia - egresosTransferencia >= 0 ? 'text-blue-600' : 'text-red-600'}">${this.formatCurrency(ingresosTransferencia - egresosTransferencia)}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Estadísticas Generales -->
                    <div class="mb-8">
                        <h3 class="text-2xl font-black text-gray-800 mb-6 uppercase tracking-wide flex items-center gap-3">
                            <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-purple-700 rounded-xl flex items-center justify-center">
                                <i data-lucide="bar-chart" class="w-6 h-6 text-white"></i>
                            </div>
                            Estadísticas del Gimnasio
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
                            <div class="bg-white rounded-xl shadow-lg p-5 border-2 border-gray-100 hover:border-orange-300 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-700 rounded-xl flex items-center justify-center shadow-lg">
                                        <i data-lucide="users" class="w-6 h-6 text-white"></i>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-600 uppercase tracking-wide font-bold mb-1">Clientes</p>
                                <p class="text-3xl font-black text-gray-900">${resumen?.totalClientes || 0}</p>
                            </div>

                            <div class="bg-white rounded-xl shadow-lg p-5 border-2 border-gray-100 hover:border-green-300 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-green-700 rounded-xl flex items-center justify-center shadow-lg">
                                        <i data-lucide="user-check" class="w-6 h-6 text-white"></i>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-600 uppercase tracking-wide font-bold mb-1">Check-ins Hoy</p>
                                <p class="text-3xl font-black text-gray-900">${resumen?.checkInsHoy || 0}</p>
                            </div>

                            <div class="bg-white rounded-xl shadow-lg p-5 border-2 border-gray-100 hover:border-orange-300 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-700 rounded-xl flex items-center justify-center shadow-lg">
                                        <i data-lucide="alert-circle" class="w-6 h-6 text-white"></i>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-600 uppercase tracking-wide font-bold mb-1">Por Vencer</p>
                                <p class="text-3xl font-black text-gray-900">${alertas?.membresiasPorVencer || 0}</p>
                            </div>

                            <div class="bg-white rounded-xl shadow-lg p-5 border-2 border-gray-100 hover:border-red-300 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="w-12 h-12 bg-gradient-to-br from-red-500 to-red-700 rounded-xl flex items-center justify-center shadow-lg">
                                        <i data-lucide="x-circle" class="w-6 h-6 text-white"></i>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-600 uppercase tracking-wide font-bold mb-1">Vencidas</p>
                                <p class="text-3xl font-black text-gray-900">${alertas?.membresiasVencidas || 0}</p>
                            </div>

                            <div class="bg-white rounded-xl shadow-lg p-5 border-2 border-gray-100 hover:border-purple-300 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-purple-700 rounded-xl flex items-center justify-center shadow-lg">
                                        <i data-lucide="trending-up" class="w-6 h-6 text-white"></i>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-600 uppercase tracking-wide font-bold mb-1">Ingresos Mes</p>
                                <p class="text-2xl font-black text-gray-900">${this.formatCurrency(resumen?.ingresosMes?.total || 0)}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Alertas y Top Clientes -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        ${this.renderAlertas(alertas)}
                        ${this.renderTopClientes(topClientes)}
                    </div>
                `;

                lucide.createIcons();
            }

            renderAlertas(alertas) {
                return `
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                        <div class="bg-gradient-to-r from-orange-600 to-orange-700 px-6 py-5">
                            <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                                Alertas de Membresías
                            </h3>
                        </div>
                        <div class="p-6">
                            ${(alertas?.membresiasPorVencer > 0 || alertas?.membresiasVencidas > 0) ? `
                                <div class="space-y-5">
                                    ${alertas?.membresiasPorVencer > 0 ? `
                                        <div>
                                            <div class="flex items-center justify-between mb-3">
                                                <h4 class="font-bold text-gray-800 uppercase text-sm tracking-wide">Por Vencer (${alertas.membresiasPorVencer})</h4>
                                                <a href="/membresias" class="text-xs text-orange-600 hover:text-orange-800 font-bold uppercase">Ver todas →</a>
                                            </div>
                                            <div class="space-y-2 max-h-48 overflow-y-auto">
                                                ${(alertas?.detalleProximasVencer || []).slice(0, 3).map(m => `
                                                    <div class="flex items-center justify-between p-3 bg-gradient-to-r from-orange-50 to-amber-50 rounded-xl border-2 border-orange-200 text-sm hover:shadow-md transition-all">
                                                        <div>
                                                            <p class="font-bold text-gray-800">${m.clienteNombre}</p>
                                                            <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                        </div>
                                                        <span class="px-3 py-1 rounded-full text-xs font-black ${
                                                            m.diasRestantes <= 3 ? 'bg-red-600 text-white' : 'bg-orange-500 text-white'
                                                        }">
                                                            ${m.diasRestantes}d
                                                        </span>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    ` : ''}

                                    ${alertas?.membresiasVencidas > 0 ? `
                                        <div class="${alertas.membresiasPorVencer > 0 ? 'pt-5 border-t-2 border-gray-200' : ''}">
                                            <div class="flex items-center justify-between mb-3">
                                                <h4 class="font-bold text-gray-800 uppercase text-sm tracking-wide">Vencidas (${alertas.membresiasVencidas})</h4>
                                                <a href="/membresias" class="text-xs text-red-600 hover:text-red-800 font-bold uppercase">Ver todas →</a>
                                            </div>
                                            <div class="space-y-2 max-h-32 overflow-y-auto">
                                                ${(alertas?.detalleVencidas || []).slice(0, 3).map(m => `
                                                    <div class="flex items-center justify-between p-3 bg-gradient-to-r from-red-50 to-pink-50 rounded-xl border-2 border-red-200 text-sm hover:shadow-md transition-all">
                                                        <div>
                                                            <p class="font-bold text-gray-800">${m.clienteNombre}</p>
                                                            <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                        </div>
                                                        <span class="px-3 py-1 bg-red-600 text-white rounded-full text-xs font-black">
                                                            ${m.diasVencido > 0 ? '-' + m.diasVencido : 'HOY'}d
                                                        </span>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    ` : ''}
                                </div>
                            ` : `
                                <div class="text-center py-12 text-gray-500">
                                    <i data-lucide="check-circle" class="w-16 h-16 mx-auto mb-3 text-green-500"></i>
                                    <p class="font-bold text-gray-700 text-lg">¡Todo en orden!</p>
                                    <p class="text-sm text-gray-500 mt-1">No hay alertas pendientes</p>
                                </div>
                            `}
                        </div>
                    </div>
                `;
            }

            renderTopClientes(topClientes) {
                return `
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                        <div class="bg-gradient-to-r from-gray-800 to-gray-900 px-6 py-5">
                            <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                <i data-lucide="trophy" class="w-6 h-6"></i>
                                Top Clientes del Mes
                            </h3>
                        </div>
                        <div class="p-6">
                            ${topClientes && topClientes.length > 0 ? `
                                <div class="space-y-2 max-h-96 overflow-y-auto">
                                    ${topClientes.slice(0, 10).map((cliente, index) => `
                                        <div class="flex items-center justify-between p-4 rounded-xl transition-all hover:shadow-lg ${
                                            index === 0 ? 'bg-gradient-to-r from-orange-100 to-amber-100 border-2 border-orange-400' :
                                            index === 1 ? 'bg-gradient-to-r from-gray-100 to-slate-100 border-2 border-gray-400' :
                                            index === 2 ? 'bg-gradient-to-r from-orange-50 to-amber-50 border-2 border-orange-300' :
                                            'bg-gray-50 border-2 border-gray-200'
                                        }">
                                            <div class="flex items-center gap-4">
                                                <div class="w-12 h-12 rounded-full ${
                                                    index === 0 ? 'bg-gradient-to-br from-orange-500 to-orange-700' :
                                                    index === 1 ? 'bg-gradient-to-br from-gray-400 to-gray-600' :
                                                    index === 2 ? 'bg-gradient-to-br from-orange-400 to-orange-600' :
                                                    'bg-gray-700'
                                                } flex items-center justify-center text-white font-black text-lg shadow-lg">
                                                    ${index + 1}
                                                </div>
                                                <div>
                                                    <p class="font-bold text-gray-900 text-base">${cliente.nombre}</p>
                                                    <p class="text-xs text-gray-600 font-semibold flex items-center gap-1">
                                                        <i data-lucide="activity" class="w-3 h-3"></i>
                                                        ${cliente.totalCheckIns} ${cliente.totalCheckIns === 1 ? 'visita' : 'visitas'}
                                                    </p>
                                                </div>
                                            </div>
                                            ${index < 3 ? `
                                                <i data-lucide="award" class="w-7 h-7 ${
                                                    index === 0 ? 'text-orange-500' :
                                                    index === 1 ? 'text-gray-500' :
                                                    'text-orange-400'
                                                }"></i>
                                            ` : ''}
                                        </div>
                                    `).join('')}
                                </div>
                            ` : `
                                <div class="text-center py-12 text-gray-500">
                                    <i data-lucide="users" class="w-16 h-16 mx-auto mb-3 text-gray-400"></i>
                                    <p class="font-bold text-gray-700 text-lg">No hay datos disponibles</p>
                                    <p class="text-sm text-gray-500 mt-1">Aún no hay visitas registradas</p>
                                </div>
                            `}
                        </div>
                    </div>
                `;
            }
        }

        const dashboard = new DashboardApp();
    </script>
}

@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Panel de Control";
    Layout = "_AdminLayout";
}

<div id="dashboard-app">
    <div class="flex items-center justify-center h-64">
        <div class="text-center">
            <div class="animate-spin w-12 h-12 border-4 border-orange-500 border-t-transparent rounded-full mx-auto mb-4"></div>
            <p class="text-gray-600">Cargando estadísticas...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';

        class DashboardApp {
            constructor() {
                this.cajaHoyData = null;
                this.estadisticasData = null;
                this.loadAllData();
                // Actualizar cada 30 segundos
                setInterval(() => this.loadAllData(), 30000);
            }

            async loadAllData() {
                try {
                    await Promise.all([
                        this.loadCajaHoy(),
                        this.loadEstadisticas()
                    ]);
                    this.render();
                } catch (error) {
                    console.error('Error cargando datos:', error);
                }
            }

            async loadCajaHoy() {
                try {
                    const response = await fetch(`${API_URL}/Caja/dashboard`);
                    const data = await response.json();

                    if (data.success) {
                        this.cajaHoyData = {
                            success: true,
                            ingresos: data.cajaHoy.totalIngresos,
                            egresos: data.cajaHoy.totalEgresos,
                            balance: data.cajaHoy.balance,
                            ingresosEfectivo: data.cajaHoy.efectivo.ingresos,
                            egresosEfectivo: data.cajaHoy.efectivo.egresos,
                            ingresosTransferencia: data.cajaHoy.transferencia.ingresos,
                            egresosTransferencia: data.cajaHoy.transferencia.egresos,
                            cantidadMovimientos: data.cajaHoy.cantidadMovimientos
                        };
                    }
                } catch (error) {
                    console.error('Error cargando datos de caja:', error);
                    this.cajaHoyData = {
                        success: true,
                        ingresos: 0,
                        egresos: 0,
                        balance: 0,
                        ingresosEfectivo: 0,
                        egresosEfectivo: 0,
                        ingresosTransferencia: 0,
                        egresosTransferencia: 0,
                        cantidadMovimientos: 0
                    };
                }
            }

            async loadEstadisticas() {
                try {
                    const response = await fetch(`${API_URL}/Dashboard/estadisticas`);
                    this.estadisticasData = await response.json();
                } catch (error) {
                    console.error('Error cargando estadísticas:', error);
                }
            }

            formatCurrency(value) {
                return new Intl.NumberFormat('es-CO', {
                    style: 'currency',
                    currency: 'COP',
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                }).format(value);
            }

            render() {
                if (!this.cajaHoyData || !this.estadisticasData) return;

                const { resumen, alertas, topClientes } = this.estadisticasData;
                const { ingresos, egresos, balance, ingresosEfectivo, egresosEfectivo,
                        ingresosTransferencia, egresosTransferencia, cantidadMovimientos } = this.cajaHoyData;

                document.getElementById('dashboard-app').innerHTML = `
                    <!-- Resumen de Caja Hoy -->
                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-5 uppercase tracking-wide flex items-center gap-2">
                            <i data-lucide="wallet" class="w-6 h-6 text-orange-600"></i>
                            Estado de Caja - Hoy
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                            <div class="bg-gradient-to-br from-emerald-500 to-emerald-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 transition-all">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="trending-up" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold bg-white/20 px-3 py-1 rounded-full backdrop-blur-sm">HOY</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1 text-emerald-100">Ingresos de Hoy</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(ingresos)}</p>
                                    <p class="text-xs mt-2 text-emerald-100">
                                        ${cantidadMovimientos} movimientos hoy
                                    </p>
                                </div>
                            </div>

                            <div class="bg-gradient-to-br from-blue-500 to-blue-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 transition-all">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="wallet" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold bg-white/20 px-3 py-1 rounded-full backdrop-blur-sm">EFECTIVO</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1 text-blue-100">Efectivo Hoy</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(ingresosEfectivo - egresosEfectivo)}</p>
                                    <p class="text-xs mt-2 text-blue-100">
                                        Balance neto
                                    </p>
                                </div>
                            </div>

                            <div class="bg-gradient-to-br from-purple-500 to-purple-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 transition-all">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="credit-card" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold bg-white/20 px-3 py-1 rounded-full backdrop-blur-sm">TRANSFERENCIA</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1 text-purple-100">Transferencias Hoy</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(ingresosTransferencia - egresosTransferencia)}</p>
                                    <p class="text-xs mt-2 text-purple-100">
                                        Balance neto
                                    </p>
                                </div>
                            </div>

                            <div class="bg-gradient-to-br from-orange-500 to-orange-700 text-white rounded-2xl shadow-xl p-6 relative overflow-hidden transform hover:scale-105 transition-all">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="scale" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold bg-white/20 px-3 py-1 rounded-full backdrop-blur-sm">BALANCE</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1 text-orange-100">Balance Total</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(balance)}</p>
                                    <p class="text-xs mt-2 text-orange-100">
                                        Diferencia: Ingresos - Egresos
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Resumen General -->
                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-5 uppercase tracking-wide flex items-center gap-2">
                            <i data-lucide="bar-chart-3" class="w-6 h-6 text-orange-600"></i>
                            Resumen General
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5">
                            <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-orange-500 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Miembros Activos</p>
                                        <p class="text-3xl font-black text-gray-900 mt-2">${resumen.totalClientes || 0}</p>
                                    </div>
                                    <div class="w-16 h-16 bg-gradient-to-br from-orange-100 to-orange-200 rounded-2xl flex items-center justify-center">
                                        <i data-lucide="users" class="w-8 h-8 text-orange-600"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-blue-500 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Check-ins Hoy</p>
                                        <p class="text-3xl font-black text-gray-900 mt-2">${resumen.checkInsHoy || 0}</p>
                                    </div>
                                    <div class="w-16 h-16 bg-gradient-to-br from-blue-100 to-blue-200 rounded-2xl flex items-center justify-center">
                                        <i data-lucide="log-in" class="w-8 h-8 text-blue-600"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-purple-500 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Membresías Vencidas</p>
                                        <p class="text-3xl font-black text-gray-900 mt-2">${alertas.membresiasVencidas || 0}</p>
                                    </div>
                                    <div class="w-16 h-16 bg-gradient-to-br from-purple-100 to-purple-200 rounded-2xl flex items-center justify-center">
                                        <i data-lucide="alert-circle" class="w-8 h-8 text-purple-600"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-amber-500 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Por Vencer</p>
                                        <p class="text-3xl font-black text-gray-900 mt-2">${alertas.membresiasPorVencer || 0}</p>
                                    </div>
                                    <div class="w-16 h-16 bg-gradient-to-br from-amber-100 to-amber-200 rounded-2xl flex items-center justify-center">
                                        <i data-lucide="clock" class="w-8 h-8 text-amber-600"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-emerald-500 hover:shadow-xl transition-all transform hover:scale-105">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Movimientos</p>
                                        <p class="text-3xl font-black text-gray-900 mt-2">${cantidadMovimientos || 0}</p>
                                    </div>
                                    <div class="w-16 h-16 bg-gradient-to-br from-emerald-100 to-emerald-200 rounded-2xl flex items-center justify-center">
                                        <i data-lucide="zap" class="w-8 h-8 text-emerald-600"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Clientes -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
                        <div class="lg:col-span-2">
                            ${this.renderTopClientes(topClientes)}
                        </div>

                        <!-- Alertas -->
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                            <div class="bg-gradient-to-r from-gray-800 to-black px-6 py-5">
                                <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                    <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                                    Alertas de Membresías
                                </h3>
                            </div>
                            <div class="p-6">
                                ${alertas.membresiasPorVencer > 0 || alertas.membresiasVencidas > 0 ? `
                                    <div class="space-y-5">
                                        ${alertas.membresiasPorVencer > 0 ? `
                                            <div>
                                                <div class="flex items-center justify-between mb-3">
                                                    <h4 class="font-bold text-gray-800 uppercase text-sm tracking-wide">Por Vencer (${alertas.membresiasPorVencer})</h4>
                                                    <a href="/membresias" class="text-xs text-orange-600 hover:text-orange-800 font-bold uppercase">Ver todas →</a>
                                                </div>
                                                <div class="space-y-2 max-h-48 overflow-y-auto">
                                                    ${alertas.detalleProximasVencer.slice(0, 3).map(m => `
                                                        <div class="flex items-center justify-between p-3 bg-gradient-to-r from-orange-50 to-amber-50 rounded-xl border border-orange-200 text-sm hover:shadow-md transition-shadow">
                                                            <div>
                                                                <p class="font-bold text-gray-800">${m.clienteNombre}</p>
                                                                <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                            </div>
                                                            <span class="px-3 py-1 rounded-full text-xs font-black ${
                                                                m.diasRestantes <= 3 ? 'bg-red-600 text-white' : 'bg-orange-500 text-white'
                                                            }">
                                                                ${m.diasRestantes}d
                                                            </span>
                                                        </div>
                                                    `).join('')}
                                                </div>
                                            </div>
                                        ` : ''}

                                        ${alertas.membresiasVencidas > 0 ? `
                                            <div class="${alertas.membresiasPorVencer > 0 ? 'pt-5 border-t-2 border-gray-200' : ''}">
                                                <div class="flex items-center justify-between mb-3">
                                                    <h4 class="font-bold text-gray-800 uppercase text-sm tracking-wide">Vencidas (${alertas.membresiasVencidas})</h4>
                                                    <a href="/membresias" class="text-xs text-red-600 hover:text-red-800 font-bold uppercase">Ver todas →</a>
                                                </div>
                                                <div class="space-y-2 max-h-32 overflow-y-auto">
                                                    ${alertas.detalleVencidas.slice(0, 3).map(m => `
                                                        <div class="flex items-center justify-between p-3 bg-gradient-to-r from-red-50 to-pink-50 rounded-xl border border-red-200 text-sm hover:shadow-md transition-shadow">
                                                            <div>
                                                                <p class="font-bold text-gray-800">${m.clienteNombre}</p>
                                                                <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                            </div>
                                                            <span class="px-3 py-1 bg-red-600 text-white rounded-full text-xs font-black">
                                                                ${m.diasVencido > 0 ? '-' + m.diasVencido : 'HOY'}d
                                                            </span>
                                                        </div>
                                                    `).join('')}
                                                </div>
                                            </div>
                                        ` : ''}
                                    </div>
                                ` : `
                                    <div class="text-center py-12 text-gray-500">
                                        <i data-lucide="check-circle" class="w-16 h-16 mx-auto mb-3 text-emerald-500"></i>
                                        <p class="font-bold text-gray-700">No hay alertas pendientes</p>
                                        <p class="text-sm text-gray-500 mt-1">Todo en orden</p>
                                    </div>
                                `}
                            </div>
                        </div>
                    </div>
                `;

                // Inicializar iconos de lucide DESPUÉS de renderizar
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            }

            renderTopClientes(topClientes) {
                return `
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                        <div class="bg-gradient-to-r from-gray-800 to-black px-6 py-5">
                            <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                <i data-lucide="trophy" class="w-6 h-6"></i>
                                Top 10 Clientes del Mes
                            </h3>
                        </div>
                        <div class="p-6">
                            ${topClientes && topClientes.length > 0 ? `
                                <div class="space-y-2 max-h-96 overflow-y-auto">
                                    ${topClientes.map((cliente, index) => `
                                        <div class="flex items-center justify-between p-3 rounded-xl transition-all hover:shadow-md ${
                                            index === 0 ? 'bg-gradient-to-r from-yellow-100 to-amber-100 border-2 border-yellow-400' :
                                            index === 1 ? 'bg-gradient-to-r from-gray-100 to-slate-100 border-2 border-gray-400' :
                                            index === 2 ? 'bg-gradient-to-r from-orange-100 to-amber-100 border-2 border-orange-400' :
                                            'bg-gray-50 border border-gray-200'
                                        }">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-full ${
                                                    index === 0 ? 'bg-gradient-to-br from-yellow-400 to-amber-500' :
                                                    index === 1 ? 'bg-gradient-to-br from-gray-400 to-slate-500' :
                                                    index === 2 ? 'bg-gradient-to-br from-orange-400 to-amber-500' :
                                                    'bg-gray-700'
                                                } flex items-center justify-center text-white font-black text-sm shadow-lg">
                                                    ${index + 1}
                                                </div>
                                                <div>
                                                    <p class="font-bold text-gray-900 text-sm">${cliente.nombre}</p>
                                                    <p class="text-xs text-gray-600 font-semibold">${cliente.totalCheckIns} visitas</p>
                                                </div>
                                            </div>
                                            ${index < 3 ? `
                                                <i data-lucide="award" class="w-6 h-6 ${
                                                    index === 0 ? 'text-yellow-500' :
                                                    index === 1 ? 'text-gray-500' :
                                                    'text-orange-500'
                                                }"></i>
                                            ` : ''}
                                        </div>
                                    `).join('')}
                                </div>
                            ` : `
                                <div class="text-center py-12 text-gray-500">
                                    <i data-lucide="users" class="w-16 h-16 mx-auto mb-3 text-gray-400"></i>
                                    <p class="font-bold text-gray-700">No hay datos disponibles</p>
                                </div>
                            `}
                        </div>
                    </div>
                `;
            }
        }

        const dashboard = new DashboardApp();
    </script>
}

@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Panel de Control";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --pz-blue: #2B4FD8;
        --pz-blue-dark: #1a3ab5;
        --pz-blue-light: #4a6ee0;
        --pz-gold: #D4A017;
        --pz-gold-dark: #b8880e;
        --pz-dark: #0f1535;
        --pz-dark2: #1a2050;
        --pz-silver: #8899bb;
    }
    .pz-stat-card { border: 2px solid rgba(43,79,216,0.15); transition: transform 0.2s, box-shadow 0.2s; }
    .pz-stat-card:hover { transform: scale(1.03); box-shadow: 0 8px 30px rgba(43,79,216,0.2); }
    .pz-text-blue { color: #2B4FD8; }
    .pz-text-gold { color: #D4A017; }
    .pz-section-icon { color: #2B4FD8; }
</style>

<div id="dashboard-app">
    <div class="flex items-center justify-center h-64">
        <div class="text-center">
            <div class="animate-spin w-12 h-12 border-4 rounded-full mx-auto mb-4"
                 style="border-color: #D4A017; border-top-color: transparent;"></div>
            <p class="text-gray-600">Cargando estadísticas...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';

        class DashboardApp {
            constructor() {
                this.cajaHoyData = null;
                this.estadisticasData = null;
                this.loadAllData();
                setInterval(() => this.loadAllData(), 30000);
            }

            async loadAllData() {
                try {
                    await Promise.all([this.loadCajaHoy(), this.loadEstadisticas()]);
                    this.render();
                } catch (error) { console.error('Error cargando datos:', error); }
            }

            async loadCajaHoy() {
                try {
                    const response = await fetch(`${API_URL}/Caja/dashboard`);
                    const data = await response.json();
                    if (data.success) {
                        this.cajaHoyData = {
                            success: true,
                            ingresos: data.cajaHoy.totalIngresos,
                            egresos: data.cajaHoy.totalEgresos,
                            balance: data.cajaHoy.balance,
                            ingresosEfectivo: data.cajaHoy.efectivo.ingresos,
                            egresosEfectivo: data.cajaHoy.efectivo.egresos,
                            ingresosTransferencia: data.cajaHoy.transferencia.ingresos,
                            egresosTransferencia: data.cajaHoy.transferencia.egresos,
                            cantidadMovimientos: data.cajaHoy.cantidadMovimientos
                        };
                    }
                } catch (error) { console.error('Error cargando datos de caja:', error); }
            }

            async loadEstadisticas() {
                try {
                    const response = await fetch(`${API_URL}/Dashboard/estadisticas`);
                    this.estadisticasData = await response.json();
                } catch (error) { console.error('Error cargando estadísticas:', error); }
            }

            formatCurrency(value) {
                return new Intl.NumberFormat('es-CO', {
                    style: 'currency', currency: 'COP',
                    minimumFractionDigits: 0, maximumFractionDigits: 0
                }).format(value);
            }

            render() {
                if (!this.cajaHoyData || !this.estadisticasData) return;
                const { resumen, alertas, topClientes } = this.estadisticasData;
                const { ingresos, egresos, balance, ingresosEfectivo, egresosEfectivo,
                        ingresosTransferencia, egresosTransferencia, cantidadMovimientos } = this.cajaHoyData;

                document.getElementById('dashboard-app').innerHTML = `
                    <!-- Caja Hoy -->
                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-5 uppercase tracking-wide flex items-center gap-2">
                            <i data-lucide="wallet" class="w-6 h-6 pz-section-icon"></i>
                            Estado de Caja - Hoy
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

                            <div class="text-white rounded-2xl shadow-xl p-6 relative overflow-hidden pz-stat-card"
                                 style="background: linear-gradient(135deg, #2B4FD8, #1a3ab5);">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="trending-up" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold px-3 py-1 rounded-full" style="background:rgba(212,160,23,0.4);">HOY</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1" style="color:rgba(255,255,255,0.8);">Ingresos de Hoy</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(ingresos)}</p>
                                    <p class="text-xs mt-2" style="color:rgba(255,255,255,0.7);">${cantidadMovimientos} movimientos hoy</p>
                                </div>
                            </div>

                            <div class="text-white rounded-2xl shadow-xl p-6 relative overflow-hidden pz-stat-card"
                                 style="background: linear-gradient(135deg, #D4A017, #b8880e);">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="wallet" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold px-3 py-1 rounded-full" style="background:rgba(255,255,255,0.25);">EFECTIVO</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1" style="color:rgba(255,255,255,0.85);">Efectivo Hoy</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(ingresosEfectivo - egresosEfectivo)}</p>
                                    <p class="text-xs mt-2" style="color:rgba(255,255,255,0.7);">Ingresos: ${this.formatCurrency(ingresosEfectivo)}</p>
                                </div>
                            </div>

                            <div class="text-white rounded-2xl shadow-xl p-6 relative overflow-hidden pz-stat-card"
                                 style="background: linear-gradient(135deg, #4a6ee0, #2B4FD8);">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="credit-card" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold px-3 py-1 rounded-full" style="background:rgba(212,160,23,0.4);">TRANSF</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1" style="color:rgba(255,255,255,0.8);">Transferencias Hoy</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(ingresosTransferencia - egresosTransferencia)}</p>
                                    <p class="text-xs mt-2" style="color:rgba(255,255,255,0.7);">Ingresos: ${this.formatCurrency(ingresosTransferencia)}</p>
                                </div>
                            </div>

                            <div class="text-white rounded-2xl shadow-xl p-6 relative overflow-hidden pz-stat-card"
                                 style="background: linear-gradient(135deg, #0f1535, #1a2050);">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full"></div>
                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
                                            <i data-lucide="trending-down" class="w-7 h-7"></i>
                                        </div>
                                        <span class="text-xs font-bold px-3 py-1 rounded-full" style="background:rgba(212,160,23,0.4);">HOY</span>
                                    </div>
                                    <p class="text-sm uppercase tracking-wider mb-1" style="color:rgba(255,255,255,0.7);">Egresos de Hoy</p>
                                    <p class="text-3xl font-black">${this.formatCurrency(egresos)}</p>
                                    <p class="text-xs mt-2" style="color:rgba(255,255,255,0.6);">Balance: ${this.formatCurrency(balance)}</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ingresos del Mes -->
                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-5 uppercase tracking-wide flex items-center gap-2">
                            <i data-lucide="bar-chart-3" class="w-6 h-6 pz-section-icon"></i>
                            Ingresos del Mes Desglosados
                        </h3>
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead class="text-white" style="background: linear-gradient(135deg, #2B4FD8, #1a3ab5);">
                                        <tr>
                                            <th class="px-6 py-4 text-left text-sm font-black uppercase tracking-wider">Categoría</th>
                                            <th class="px-6 py-4 text-right text-sm font-black uppercase tracking-wider">Monto</th>
                                            <th class="px-6 py-4 text-right text-sm font-black uppercase tracking-wider">% del Total</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200">
                                        ${this.renderFilaIngreso('Membresías', resumen.ingresosMes.membresias, resumen.ingresosMes.total, 'blue')}
                                        ${this.renderFilaIngreso('Productos', resumen.ingresosMes.productos, resumen.ingresosMes.total, 'gold')}
                                        ${this.renderFilaIngreso('Abonos a Deudas', resumen.ingresosMes.abonos, resumen.ingresosMes.total, 'blue')}
                                        ${this.renderFilaIngreso('Otros', resumen.ingresosMes.otros, resumen.ingresosMes.total, 'dark')}
                                    </tbody>
                                    <tfoot class="bg-gray-50">
                                        <tr class="border-t-2 border-gray-300">
                                            <td class="px-6 py-4 text-left text-sm font-black uppercase text-gray-900">TOTAL</td>
                                            <td class="px-6 py-4 text-right text-xl font-black pz-text-blue">${this.formatCurrency(resumen.ingresosMes.total)}</td>
                                            <td class="px-6 py-4 text-right text-sm font-bold text-gray-600">100%</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Egresos del Mes -->
                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-5 uppercase tracking-wide flex items-center gap-2">
                            <i data-lucide="trending-down" class="w-6 h-6" style="color:#D4A017;"></i>
                            Egresos del Mes Desglosados
                        </h3>
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead class="text-white" style="background: linear-gradient(135deg, #0f1535, #1a2050); border-bottom: 2px solid #D4A017;">
                                        <tr>
                                            <th class="px-6 py-4 text-left text-sm font-black uppercase tracking-wider">Categoría</th>
                                            <th class="px-6 py-4 text-right text-sm font-black uppercase tracking-wider">Monto</th>
                                            <th class="px-6 py-4 text-right text-sm font-black uppercase tracking-wider">% del Total</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200">
                                        ${this.renderFilaEgreso('Sueldos', resumen.egresosMes.sueldos, resumen.egresosMes.total, 'red')}
                                        ${this.renderFilaEgreso('Servicios', resumen.egresosMes.servicios, resumen.egresosMes.total, 'orange')}
                                        ${this.renderFilaEgreso('Mantenimiento', resumen.egresosMes.mantenimiento, resumen.egresosMes.total, 'yellow')}
                                        ${this.renderFilaEgreso('Compras', resumen.egresosMes.compras, resumen.egresosMes.total, 'pink')}
                                        ${this.renderFilaEgreso('Otros', resumen.egresosMes.otros, resumen.egresosMes.total, 'gray')}
                                    </tbody>
                                    <tfoot class="bg-gray-50">
                                        <tr class="border-t-2 border-gray-300">
                                            <td class="px-6 py-4 text-left text-sm font-black uppercase text-gray-900">TOTAL</td>
                                            <td class="px-6 py-4 text-right text-xl font-black pz-text-gold">${this.formatCurrency(resumen.egresosMes.total)}</td>
                                            <td class="px-6 py-4 text-right text-sm font-bold text-gray-600">100%</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Estadísticas Generales -->
                    <div class="mb-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-5 uppercase tracking-wide flex items-center gap-2">
                            <i data-lucide="activity" class="w-6 h-6 pz-section-icon"></i>
                            Estadísticas Generales
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
                            <div class="bg-white rounded-2xl shadow-lg p-6 pz-stat-card">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="w-14 h-14 rounded-xl flex items-center justify-center"
                                         style="background: linear-gradient(135deg, rgba(43,79,216,0.1), rgba(43,79,216,0.2));">
                                        <i data-lucide="users" class="w-8 h-8 pz-text-blue"></i>
                                    </div>
                                    <span class="text-3xl font-black pz-text-blue">${resumen.totalClientes}</span>
                                </div>
                                <p class="text-sm font-bold text-gray-700 uppercase tracking-wide">Clientes Activos</p>
                            </div>
                            <div class="bg-white rounded-2xl shadow-lg p-6 pz-stat-card">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="w-14 h-14 rounded-xl flex items-center justify-center"
                                         style="background: linear-gradient(135deg, rgba(212,160,23,0.1), rgba(212,160,23,0.2));">
                                        <i data-lucide="check-circle" class="w-8 h-8 pz-text-gold"></i>
                                    </div>
                                    <span class="text-3xl font-black pz-text-gold">${resumen.checkInsHoy}</span>
                                </div>
                                <p class="text-sm font-bold text-gray-700 uppercase tracking-wide">Check-ins Hoy</p>
                            </div>
                            <div class="bg-white rounded-2xl shadow-lg p-6 border-2 border-gray-100 pz-stat-card">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="w-14 h-14 bg-gradient-to-br from-orange-100 to-orange-200 rounded-xl flex items-center justify-center">
                                        <i data-lucide="alert-triangle" class="w-8 h-8 text-orange-600"></i>
                                    </div>
                                    <span class="text-3xl font-black text-orange-600">${resumen.membresiasPorVencer}</span>
                                </div>
                                <p class="text-sm font-bold text-gray-700 uppercase tracking-wide">Por Vencer (7 días)</p>
                            </div>
                            <div class="bg-white rounded-2xl shadow-lg p-6 border-2 border-gray-100 pz-stat-card">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="w-14 h-14 bg-gradient-to-br from-red-100 to-red-200 rounded-xl flex items-center justify-center">
                                        <i data-lucide="x-circle" class="w-8 h-8 text-red-600"></i>
                                    </div>
                                    <span class="text-3xl font-black text-red-600">${resumen.membresiasVencidas}</span>
                                </div>
                                <p class="text-sm font-bold text-gray-700 uppercase tracking-wide">Membresías Vencidas</p>
                            </div>
                        </div>
                    </div>

                    <!-- Alertas y Top Clientes -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                        ${this.renderAlertas(alertas)}
                        ${this.renderTopClientes(topClientes)}
                    </div>
                `;
                lucide.createIcons();
            }

            renderFilaIngreso(nombre, monto, total, color) {
                const porcentaje = total > 0 ? ((monto / total) * 100).toFixed(1) : 0;
                const styles = {
                    'blue':  { badge: 'background:rgba(43,79,216,0.1);color:#2B4FD8;', bar: '#2B4FD8' },
                    'gold':  { badge: 'background:rgba(212,160,23,0.1);color:#D4A017;',  bar: '#D4A017' },
                    'dark':  { badge: 'background:rgba(15,21,53,0.08);color:#1a2050;',   bar: '#1a2050' }
                };
                const s = styles[color] || styles['blue'];
                return `
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4">
                            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase" style="${s.badge}">${nombre}</span>
                        </td>
                        <td class="px-6 py-4 text-right text-lg font-black text-gray-900">${this.formatCurrency(monto)}</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <div class="w-20 h-2 bg-gray-200 rounded-full overflow-hidden">
                                    <div class="h-full rounded-full" style="width:${porcentaje}%;background:${s.bar};"></div>
                                </div>
                                <span class="text-sm font-bold text-gray-700">${porcentaje}%</span>
                            </div>
                        </td>
                    </tr>`;
            }

            renderFilaEgreso(nombre, monto, total, color) {
                const porcentaje = total > 0 ? ((monto / total) * 100).toFixed(1) : 0;
                const colorClasses = {
                    'red': 'bg-red-50 text-red-700', 'orange': 'bg-orange-50 text-orange-700',
                    'yellow': 'bg-yellow-50 text-yellow-700', 'pink': 'bg-pink-50 text-pink-700',
                    'gray': 'bg-gray-50 text-gray-700'
                };
                return `
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4">
                            <span class="px-3 py-1 ${colorClasses[color]} rounded-full text-xs font-bold uppercase">${nombre}</span>
                        </td>
                        <td class="px-6 py-4 text-right text-lg font-black text-gray-900">${this.formatCurrency(monto)}</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <div class="w-20 h-2 bg-gray-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-${color}-500" style="width:${porcentaje}%"></div>
                                </div>
                                <span class="text-sm font-bold text-gray-700">${porcentaje}%</span>
                            </div>
                        </td>
                    </tr>`;
            }

            renderAlertas(alertas) {
                return `
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                        <div class="px-6 py-5" style="background:linear-gradient(135deg,#0f1535,#1a2050);border-bottom:3px solid #D4A017;">
                            <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                <i data-lucide="alert-triangle" class="w-6 h-6" style="color:#D4A017;"></i>
                                Alertas de Membresías
                            </h3>
                        </div>
                        <div class="p-6">
                            ${alertas.membresiasPorVencer > 0 || alertas.membresiasVencidas > 0 ? `
                                <div class="space-y-5">
                                    ${alertas.membresiasPorVencer > 0 ? `
                                        <div>
                                            <div class="flex items-center justify-between mb-3">
                                                <h4 class="font-bold text-gray-800 uppercase text-sm tracking-wide">Por Vencer (${alertas.membresiasPorVencer})</h4>
                                                <a href="/membresias" class="text-xs font-bold uppercase" style="color:#D4A017;">Ver todas →</a>
                                            </div>
                                            <div class="space-y-2 max-h-48 overflow-y-auto">
                                                ${alertas.detalleProximasVencer.slice(0, 3).map(m => `
                                                    <div class="flex items-center justify-between p-3 rounded-xl border text-sm hover:shadow-md transition-shadow"
                                                         style="background:linear-gradient(135deg,rgba(212,160,23,0.06),rgba(212,160,23,0.12));border-color:rgba(212,160,23,0.3);">
                                                        <div>
                                                            <p class="font-bold text-gray-800">${m.clienteNombre}</p>
                                                            <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                        </div>
                                                        <span class="px-3 py-1 rounded-full text-xs font-black text-white"
                                                              style="background:${m.diasRestantes <= 3 ? '#dc2626' : '#D4A017'};">
                                                            ${m.diasRestantes}d
                                                        </span>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    ` : ''}
                                    ${alertas.membresiasVencidas > 0 ? `
                                        <div class="${alertas.membresiasPorVencer > 0 ? 'pt-5 border-t-2 border-gray-200' : ''}">
                                            <div class="flex items-center justify-between mb-3">
                                                <h4 class="font-bold text-gray-800 uppercase text-sm tracking-wide">Vencidas (${alertas.membresiasVencidas})</h4>
                                                <a href="/membresias" class="text-xs text-red-600 hover:text-red-800 font-bold uppercase">Ver todas →</a>
                                            </div>
                                            <div class="space-y-2 max-h-32 overflow-y-auto">
                                                ${alertas.detalleVencidas.slice(0, 3).map(m => `
                                                    <div class="flex items-center justify-between p-3 bg-gradient-to-r from-red-50 to-pink-50 rounded-xl border border-red-200 text-sm hover:shadow-md transition-shadow">
                                                        <div>
                                                            <p class="font-bold text-gray-800">${m.clienteNombre}</p>
                                                            <p class="text-xs text-gray-600">${m.planNombre}</p>
                                                        </div>
                                                        <span class="px-3 py-1 bg-red-600 text-white rounded-full text-xs font-black">
                                                            ${m.diasVencido > 0 ? '-' + m.diasVencido : 'HOY'}d
                                                        </span>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    ` : ''}
                                </div>
                            ` : `
                                <div class="text-center py-12">
                                    <i data-lucide="check-circle" class="w-16 h-16 mx-auto mb-3" style="color:#2B4FD8;"></i>
                                    <p class="font-bold text-gray-700">No hay alertas pendientes</p>
                                    <p class="text-sm text-gray-500 mt-1">Todo en orden</p>
                                </div>
                            `}
                        </div>
                    </div>`;
            }

            renderTopClientes(topClientes) {
                return `
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-gray-100">
                        <div class="px-6 py-5" style="background:linear-gradient(135deg,#0f1535,#1a2050);border-bottom:3px solid #D4A017;">
                            <h3 class="text-white font-black flex items-center gap-3 text-lg uppercase tracking-wide">
                                <i data-lucide="trophy" class="w-6 h-6" style="color:#D4A017;"></i>
                                Top 10 Clientes del Mes
                            </h3>
                        </div>
                        <div class="p-6">
                            ${topClientes && topClientes.length > 0 ? `
                                <div class="space-y-2 max-h-96 overflow-y-auto">
                                    ${topClientes.map((cliente, index) => `
                                        <div class="flex items-center justify-between p-3 rounded-xl transition-all hover:shadow-md ${
                                            index === 0 ? 'bg-gradient-to-r from-yellow-100 to-amber-100 border-2 border-yellow-400' :
                                            index === 1 ? 'bg-gradient-to-r from-gray-100 to-slate-100 border-2 border-gray-400' :
                                            index === 2 ? 'bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-300' :
                                            'bg-gray-50 border border-gray-200'
                                        }">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-black text-sm shadow-lg"
                                                     style="background:${
                                                        index === 0 ? 'linear-gradient(135deg,#D4A017,#b8880e)' :
                                                        index === 1 ? 'linear-gradient(135deg,#8899bb,#6677aa)' :
                                                        index === 2 ? 'linear-gradient(135deg,#2B4FD8,#1a3ab5)' :
                                                        '#0f1535'
                                                     };">
                                                    ${index + 1}
                                                </div>
                                                <div>
                                                    <p class="font-bold text-gray-900 text-sm">${cliente.nombre}</p>
                                                    <p class="text-xs text-gray-600 font-semibold">${cliente.totalCheckIns} visitas</p>
                                                </div>
                                            </div>
                                            ${index < 3 ? `
                                                <i data-lucide="award" class="w-6 h-6" style="color:${
                                                    index === 0 ? '#D4A017' : index === 1 ? '#8899bb' : '#2B4FD8'
                                                };"></i>
                                            ` : ''}
                                        </div>
                                    `).join('')}
                                </div>
                            ` : `
                                <div class="text-center py-12 text-gray-500">
                                    <i data-lucide="users" class="w-16 h-16 mx-auto mb-3 text-gray-400"></i>
                                    <p class="font-bold text-gray-700">No hay datos disponibles</p>
                                </div>
                            `}
                        </div>
                    </div>`;
            }
        }

        const dashboard = new DashboardApp();
    </script>
}
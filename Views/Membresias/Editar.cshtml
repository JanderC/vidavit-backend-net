@model VidaFitBackend.Models.Membresia
@{
    ViewData["Title"] = "Editar Membresía";
    ViewData["Subtitle"] = "Modificar información de la membresía - Tallest GYM";
    Layout = "_AdminLayout";
}

<style>
    .tz-card {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.15);
        border-radius: 1rem;
        padding: 2rem;
    }

    .tz-section-title {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-size: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #f9fafb;
        padding-bottom: .85rem;
        border-bottom: 1px solid rgba(34,197,94,0.12);
        margin-bottom: 1.25rem;
    }

        .tz-section-title i {
            color: #22c55e;
        }

    .tz-label {
        display: block;
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #6b7280;
        margin-bottom: .4rem;
    }

        .tz-label .opt {
            color: #4b5563;
            font-weight: 500;
            text-transform: none;
            font-size: .65rem;
        }

    .tz-input {
        width: 100%;
        padding: .7rem 1rem;
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        border-radius: .65rem;
        color: #f9fafb;
        font-weight: 600;
        font-size: .9rem;
        transition: border-color .2s, box-shadow .2s;
        box-sizing: border-box;
    }

        .tz-input::placeholder {
            color: #374151;
        }

        .tz-input:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }

    .tz-select {
        width: 100%;
        padding: .7rem 1rem;
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        border-radius: .65rem;
        color: #f9fafb;
        font-weight: 600;
        font-size: .9rem;
        transition: border-color .2s;
    }

        .tz-select:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }

    /* Alert box */
    .info-box-blue {
        padding: 1rem 1.25rem;
        border-radius: .75rem;
        background: rgba(59,130,246,0.06);
        border: 1px solid rgba(59,130,246,0.2);
        display: flex;
        align-items: flex-start;
        gap: .75rem;
    }

    /* Info box for plan */
    .plan-info-box {
        margin-top: .6rem;
        padding: .65rem 1rem;
        border-radius: .6rem;
        background: rgba(34,197,94,0.06);
        border: 1px solid rgba(34,197,94,0.2);
        font-size: .82rem;
        color: #86efac;
        font-weight: 600;
    }

    /* Cliente readonly box */
    .cliente-readonly {
        padding: .85rem 1.1rem;
        border-radius: .65rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .cliente-icon-box {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: .5rem;
        flex-shrink: 0;
        background: rgba(34,197,94,0.08);
        border: 1px solid rgba(34,197,94,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Duration box */
    .duracion-box {
        padding: 1rem 1.25rem;
        border-radius: .75rem;
        background: rgba(34,197,94,0.05);
        border: 1px solid rgba(34,197,94,0.15);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .75rem;
    }

    /* Monto readonly */
    .monto-readonly {
        padding: .85rem 1.1rem;
        border-radius: .65rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Timestamps */
    .ts-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .75rem;
        padding: .85rem 1.1rem;
        border-radius: .65rem;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
    }

    /* Buttons */
    .tz-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .85rem 1.5rem;
        border-radius: .65rem;
        background: linear-gradient(135deg,#22c55e,#15803d);
        color: #fff;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        border: none;
        cursor: pointer;
        transition: all .2s;
    }

        .tz-btn-primary:hover {
            background: linear-gradient(135deg,#16a34a,#166534);
            box-shadow: 0 4px 16px rgba(34,197,94,0.3);
            transform: translateY(-1px);
        }

        .tz-btn-primary:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }

    .tz-btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .85rem 1.5rem;
        border-radius: .65rem;
        background: transparent;
        border: 1px solid rgba(255,255,255,0.1);
        color: #6b7280;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        text-decoration: none;
        transition: all .2s;
    }

        .tz-btn-ghost:hover {
            border-color: rgba(34,197,94,0.25);
            color: #d1d5db;
        }

    .badge-no-caja {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .2rem .6rem;
        border-radius: 99px;
        background: rgba(59,130,246,0.1);
        border: 1px solid rgba(59,130,246,0.2);
        color: #60a5fa;
        font-size: .65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .07em;
    }
</style>

<div class="max-w-4xl mx-auto">
    <div class="tz-card">

        <!-- Header -->
        <div class="tz-section-title">
            <i data-lucide="edit" style="width:1.1rem;height:1.1rem"></i>
            Editar Membresía
            <span class="badge-no-caja" style="margin-left:.5rem">
                <i data-lucide="info" style="width:.7rem;height:.7rem"></i>
                No registra ingreso
            </span>
        </div>

        <!-- Alerta informativa -->
        <div class="info-box-blue mb-6">
            <i data-lucide="alert-circle" style="width:1.1rem;height:1.1rem;color:#60a5fa;flex-shrink:0;margin-top:.1rem"></i>
            <div style="font-size:.8rem;color:#93c5fd;font-weight:600;line-height:1.6">
                <strong style="color:#60a5fa;font-weight:800;display:block;margin-bottom:.3rem;text-transform:uppercase;font-size:.72rem;letter-spacing:.07em">ℹ️ Importante</strong>
                Esta función solo <strong style="color:#bfdbfe">edita datos</strong> de la membresía. No registra movimientos en caja.
                Para renovar y registrar pago, use el botón <strong style="color:#bfdbfe">RENOVAR</strong> del listado.
            </div>
        </div>

        <form id="editForm" class="space-y-6">
            <input type="hidden" id="membresiaId" value="@Model.Id" />
            <input type="hidden" id="createdAt" value="@Model.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")" />
            <input type="hidden" id="montoPagadoOriginal" value="@Model.MontoPagado" />

            <!-- Cliente (solo lectura) -->
            <div>
                <label class="tz-label">Cliente</label>
                <div class="cliente-readonly">
                    <div class="cliente-icon-box">
                        <i data-lucide="user" style="width:1rem;height:1rem;color:#22c55e"></i>
                    </div>
                    <div>
                        <p style="font-weight:900;color:#f9fafb;font-size:.95rem;text-transform:uppercase">@Model.Cliente?.Nombre @Model.Cliente?.Apellido</p>
                        <p style="font-size:.75rem;color:#6b7280;font-weight:600;margin-top:.1rem;font-family:monospace">@Model.Cliente?.Cedula</p>
                    </div>
                </div>
                <input type="hidden" id="clienteId" value="@Model.ClienteId" />
            </div>

            <!-- Plan -->
            <div>
                <label class="tz-label">Plan <span style="color:#ef4444">*</span></label>
                <select id="planId" required class="tz-select">
                    @if (ViewBag.Planes != null)
                    {
                        foreach (var plan in ViewBag.Planes)
                        {
                            var isSelected = plan.Id == Model.PlanId;
                            <option value="@plan.Id"
                                    data-precio="@plan.Precio"
                                    data-duracion="@plan.DuracionDias"
                                    data-tipo="@plan.TipoCalculoVencimiento"
                                    data-cantidad="@plan.CantidadUnidades"
                                    selected="@isSelected">
                                @plan.Nombre — $@plan.Precio (@plan.DuracionDias días)
                            </option>
                        }
                    }
                </select>
                <div id="planInfo" class="plan-info-box hidden"></div>
            </div>

            <!-- Fechas -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
                <div>
                    <label class="tz-label">Fecha Inicio <span style="color:#ef4444">*</span></label>
                    <input type="date" id="fechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" required class="tz-input" />
                </div>
                <div>
                    <label class="tz-label">Fecha Vencimiento <span style="color:#ef4444">*</span></label>
                    <input type="date" id="fechaVencimiento" value="@Model.FechaVencimiento.ToString("yyyy-MM-dd")" required class="tz-input" />
                    <p style="font-size:.7rem;color:#4b5563;font-weight:600;margin-top:.35rem;display:flex;align-items:center;gap:.3rem">
                        <i data-lucide="info" style="width:.75rem;height:.75rem"></i>
                        Se actualizará al cambiar plan o fecha inicio
                    </p>
                </div>
            </div>

            <!-- Duración -->
            <div id="duracionInfo" class="hidden duracion-box">
                <div>
                    <p style="font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#6b7280;margin-bottom:.2rem">Total</p>
                    <p style="font-size:1.5rem;font-weight:900;color:#22c55e" id="totalDias">—</p>
                </div>
                <div>
                    <p style="font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#6b7280;margin-bottom:.2rem">Vence el</p>
                    <p style="font-size:.88rem;font-weight:800;color:#f9fafb" id="fechaVencTexto">—</p>
                </div>
            </div>

            <!-- Estado -->
            <div>
                <label class="tz-label">Estado <span style="color:#ef4444">*</span></label>
                <select id="estado" required class="tz-select">
                    <option value="activa" selected="@(Model.Estado == "activa")">Activa</option>
                    <option value="vencida" selected="@(Model.Estado == "vencida")">Vencida</option>
                    <option value="suspendida" selected="@(Model.Estado == "suspendida")">Suspendida</option>
                    <option value="cancelada" selected="@(Model.Estado == "cancelada")">Cancelada</option>
                </select>
            </div>

            <!-- Método de pago -->
            <div>
                <label class="tz-label">
                    Método de Pago (Referencial)
                    <span class="opt">— no afecta la caja</span>
                </label>
                <select id="metodoPago" required class="tz-select">
                    <option value="efectivo" selected="@(Model.MetodoPago == "efectivo")">Efectivo</option>
                    <option value="tarjeta" selected="@(Model.MetodoPago == "tarjeta")">Tarjeta</option>
                    <option value="transferencia" selected="@(Model.MetodoPago == "transferencia")">Transferencia</option>
                </select>
            </div>

            <!-- Monto (solo lectura) -->
            <div>
                <label class="tz-label">Monto Pagado Originalmente</label>
                <div class="monto-readonly">
                    <div>
                        <p style="font-size:.65rem;font-weight:800;text-transform:uppercase;color:#6b7280;margin-bottom:.2rem;display:flex;align-items:center;gap:.3rem">
                            <i data-lucide="lock" style="width:.7rem;height:.7rem"></i>
                            No editable desde aquí
                        </p>
                        <p style="font-size:1.5rem;font-weight:900;color:#22c55e">$@Model.MontoPagado.ToString("N2")</p>
                    </div>
                    <div style="width:2.5rem;height:2.5rem;border-radius:.55rem;background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center">
                        <i data-lucide="dollar-sign" style="width:1.1rem;height:1.1rem;color:#22c55e"></i>
                    </div>
                </div>
            </div>

            <!-- Notas -->
            <div>
                <label class="tz-label">Notas <span class="opt">(opcional)</span></label>
                <textarea id="notas" rows="3" class="tz-input" style="resize:none"
                          placeholder="Observaciones o comentarios adicionales...">@Model.Notas</textarea>
            </div>

            <!-- Timestamps -->
            <div class="ts-box">
                <div>
                    <p style="font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#4b5563;margin-bottom:.2rem">Creado</p>
                    <p style="font-size:.82rem;font-weight:800;color:#6b7280">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div>
                    <p style="font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#4b5563;margin-bottom:.2rem">Última actualización</p>
                    <p style="font-size:.82rem;font-weight:800;color:#6b7280">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <!-- Botones -->
            <div style="display:flex;gap:.75rem;padding-top:1.25rem;border-top:1px solid rgba(34,197,94,0.1)">
                <a href="/membresias" class="tz-btn-ghost">
                    <i data-lucide="arrow-left" style="width:.9rem;height:.9rem"></i>
                    Cancelar
                </a>
                <button type="submit" id="btn-guardar" class="tz-btn-primary">
                    <i data-lucide="save" style="width:.9rem;height:.9rem"></i>
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let planesData = [];
        let planSeleccionado = null;

        async function cargarPlanes() {
            try {
                const resp = await fetch('/api/Planes');
                planesData = await resp.json();

                const planActual = planesData.find(p => (p.id || p.Id) == '@Model.PlanId');
                if (planActual) {
                    planSeleccionado = {
                        id:                     planActual.id     || planActual.Id,
                        precio:                 planActual.precio || planActual.Precio,
                        duracionDias:           planActual.duracionDias || planActual.DuracionDias,
                        tipoCalculoVencimiento: planActual.tipoCalculoVencimiento || planActual.TipoCalculoVencimiento || 'dias',
                        cantidadUnidades:       planActual.cantidadUnidades || planActual.CantidadUnidades || planActual.duracionDias || planActual.DuracionDias
                    };
                    mostrarInfoPlan();
                }
            } catch (err) {
                console.error('Error cargando planes:', err);
            }
        }

        document.getElementById('planId').addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            if (!opt.value) { planSeleccionado = null; document.getElementById('planInfo').classList.add('hidden'); document.getElementById('duracionInfo').classList.add('hidden'); return; }
            planSeleccionado = {
                id:                     opt.value,
                precio:                 parseFloat(opt.dataset.precio),
                duracionDias:           parseInt(opt.dataset.duracion),
                tipoCalculoVencimiento: opt.dataset.tipo || 'dias',
                cantidadUnidades:       parseInt(opt.dataset.cantidad || opt.dataset.duracion)
            };
            mostrarInfoPlan();
            recalcularFechaVencimiento();
        });

        document.getElementById('fechaInicio').addEventListener('change', function () {
            if (planSeleccionado) recalcularFechaVencimiento();
        });

        function mostrarInfoPlan() {
            if (!planSeleccionado) return;
            const info = document.getElementById('planInfo');
            info.innerHTML = `Precio: <strong style="color:#f9fafb">$${planSeleccionado.precio.toFixed(2)}</strong> &nbsp;·&nbsp; Duración: <strong style="color:#f9fafb">${planSeleccionado.duracionDias} días</strong>`;
            info.classList.remove('hidden');
        }

        function recalcularFechaVencimiento() {
            const fechaInicioStr = document.getElementById('fechaInicio').value;
            if (!fechaInicioStr || !planSeleccionado) return;

            const [y, m, d] = fechaInicioStr.split('-').map(Number);
            const fi = new Date(y, m - 1, d);
            let fv, durTxt;

            switch ((planSeleccionado.tipoCalculoVencimiento || 'dias').toLowerCase()) {
                case 'meses':
                    fv = new Date(fi); fv.setMonth(fv.getMonth() + planSeleccionado.cantidadUnidades);
                    durTxt = `${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades===1?'mes':'meses'}`; break;
                case 'semanas':
                    fv = new Date(fi); fv.setDate(fv.getDate() + planSeleccionado.cantidadUnidades * 7);
                    durTxt = `${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades===1?'semana':'semanas'}`; break;
                case 'anios':
                    fv = new Date(fi); fv.setFullYear(fv.getFullYear() + planSeleccionado.cantidadUnidades);
                    durTxt = `${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades===1?'año':'años'}`; break;
                default:
                    fv = new Date(fi); fv.setDate(fv.getDate() + (planSeleccionado.duracionDias - 1));
                    durTxt = `${planSeleccionado.duracionDias} días`; break;
            }

            const fvStr = `${fv.getFullYear()}-${String(fv.getMonth()+1).padStart(2,'0')}-${String(fv.getDate()).padStart(2,'0')}`;
            document.getElementById('fechaVencimiento').value = fvStr;
            document.getElementById('totalDias').textContent = durTxt;
            document.getElementById('fechaVencTexto').textContent = fv.toLocaleDateString('es-ES', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
            document.getElementById('duracionInfo').classList.remove('hidden');
        }

        document.getElementById('editForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            if (!confirm('⚠️ ¿Confirmar cambios?\n\n✏️ Solo se editarán los datos\n🚫 No se registrará ningún movimiento en caja')) return;

            const btn = document.getElementById('btn-guardar');
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader" style="width:.9rem;height:.9rem" class="animate-spin"></i> Guardando...';
            lucide.createIcons();

            const membresiaId = document.getElementById('membresiaId').value;
            const data = {
                id:               membresiaId,
                clienteId:        document.getElementById('clienteId').value,
                planId:           document.getElementById('planId').value,
                fechaInicio:      document.getElementById('fechaInicio').value,
                fechaVencimiento: document.getElementById('fechaVencimiento').value,
                estado:           document.getElementById('estado').value,
                montoPagado:      parseFloat(document.getElementById('montoPagadoOriginal').value),
                metodoPago:       document.getElementById('metodoPago').value,
                notas:            document.getElementById('notas').value || null
            };

            try {
                const resp = await fetch(`/api/Membresias/${membresiaId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (resp.ok) {
                    alert('✅ Membresía actualizada exitosamente');
                    window.location.href = '/membresias';
                } else {
                    alert('❌ Error al actualizar: ' + await resp.text());
                }
            } catch (err) {
                alert('❌ Error al actualizar la membresía: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="save" style="width:.9rem;height:.9rem"></i> Guardar Cambios';
                lucide.createIcons();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            cargarPlanes();
            lucide.createIcons();
            if (planSeleccionado) recalcularFechaVencimiento();
        });
    </script>
}

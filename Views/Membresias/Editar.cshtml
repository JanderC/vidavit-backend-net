@model VidaFitBackend.Models.Membresia
@{
    ViewData["Title"] = "Editar Membresía";
    ViewData["Subtitle"] = "Modificar información de la membresía - Power Fitness";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --pf-blue:#3B82F6; --pf-blueB:#60A5FA; --pf-deep:#1E3A8A;
        --pf-purple:#7C3AED; --pf-card:#0D1526; --pf-border:#1E2D4A;
        --pf-text:#E2E8F0; --pf-soft:#94A3B8; --pf-muted:#64748B;
        --pf-green:#10B981; --pf-red:#EF4444; --pf-orange:#F59E0B;
    }
    .pf-input {
        width:100%; padding:.75rem 1rem; border:2px solid var(--pf-border);
        border-radius:.75rem; background:rgba(255,255,255,.03); color:var(--pf-text);
        font-weight:600; font-family:inherit; font-size:.9rem; outline:none;
        box-sizing:border-box; transition:border-color .2s, background .2s;
    }
    .pf-input:focus { border-color:var(--pf-blue); background:rgba(59,130,246,.05); }
    .pf-input::placeholder { color:var(--pf-muted); font-weight:400; }
    .pf-select {
        width:100%; padding:.75rem 1rem; border:2px solid var(--pf-border);
        border-radius:.75rem; background:var(--pf-card); color:var(--pf-text);
        font-weight:600; font-family:inherit; font-size:.9rem; outline:none;
        box-sizing:border-box; transition:border-color .2s;
    }
    .pf-select:focus { border-color:var(--pf-blue); }
    .pf-label {
        display:block; font-size:.72rem; font-weight:800; color:var(--pf-soft);
        margin-bottom:.5rem; text-transform:uppercase; letter-spacing:.1em;
    }
    .pf-label small { font-size:.65rem; color:var(--pf-muted); text-transform:none; font-weight:500; margin-left:.35rem; }
</style>

<div style="max-width:56rem; margin:0 auto;">
    <div style="background:var(--pf-card); border:1px solid var(--pf-border); border-radius:1.25rem; padding:2rem; box-shadow:0 4px 24px rgba(0,0,0,.4);">

        <!-- Header -->
        <div style="display:flex; align-items:center; gap:1rem; margin-bottom:2rem; padding-bottom:1.25rem; border-bottom:1px solid var(--pf-border);">
            <div style="background:linear-gradient(135deg,#92400E,#B45309); border-radius:.875rem; padding:1rem; flex-shrink:0;">
                <i data-lucide="edit" style="width:32px;height:32px;color:#FCD34D;"></i>
            </div>
            <div>
                <h2 style="font-size:1.5rem; font-weight:900; color:var(--pf-text); text-transform:uppercase; letter-spacing:.06em; margin:0 0 .2rem 0;">Editar Membresía</h2>
                <p style="font-size:.8rem; color:var(--pf-muted); font-weight:600; margin:0; display:flex; align-items:center; gap:.5rem;">
                    Modificar datos sin afectar la caja
                    <span style="display:inline-flex;align-items:center;gap:.3rem;padding:.2rem .6rem;background:rgba(59,130,246,.1);color:var(--pf-blueB);border:1px solid rgba(59,130,246,.2);border-radius:999px;font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;">
                        <i data-lucide="info" style="width:10px;height:10px;"></i> No registra ingreso
                    </span>
                </p>
            </div>
        </div>

        <!-- Aviso -->
        <div style="margin-bottom:1.5rem;padding:1rem 1.25rem;background:rgba(59,130,246,.07);border:1px solid rgba(59,130,246,.2);border-left:4px solid var(--pf-blue);border-radius:.875rem;display:flex;align-items:flex-start;gap:.875rem;">
            <div style="background:rgba(59,130,246,.15);padding:.75rem;border-radius:.75rem;flex-shrink:0;">
                <i data-lucide="alert-circle" style="width:22px;height:22px;color:var(--pf-blueB);"></i>
            </div>
            <div>
                <h4 style="font-weight:900;color:var(--pf-blueB);font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;margin:0 0 .5rem 0;">ℹ️ Importante</h4>
                <ul style="font-size:.8rem;color:var(--pf-soft);font-weight:700;margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:.25rem;">
                    <li>✏️ Esta función solo EDITA datos de la membresía</li>
                    <li>🚫 NO registra movimientos en caja</li>
                    <li>💰 Para renovar y registrar pago, use el botón "RENOVAR" del listado</li>
                </ul>
            </div>
        </div>

        <form id="editForm" style="display:flex;flex-direction:column;gap:1.25rem;">
            <input type="hidden" id="membresiaId" value="@Model.Id" />
            <input type="hidden" id="createdAt" value="@Model.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")" />
            <input type="hidden" id="montoPagadoOriginal" value="@Model.MontoPagado" />

            <!-- Cliente (lectura) -->
            <div>
                <label class="pf-label">Cliente</label>
                <div style="padding:1rem 1.25rem;background:rgba(255,255,255,.03);border:1px solid var(--pf-border);border-radius:.875rem;display:flex;align-items:center;gap:.875rem;">
                    <div style="background:rgba(59,130,246,.1);padding:.75rem;border-radius:.75rem;flex-shrink:0;">
                        <i data-lucide="user" style="width:22px;height:22px;color:var(--pf-blueB);"></i>
                    </div>
                    <div>
                        <p style="font-weight:900;color:var(--pf-text);font-size:1rem;text-transform:uppercase;margin:0 0 .15rem 0;">@Model.Cliente?.Nombre @Model.Cliente?.Apellido</p>
                        <p style="font-size:.8rem;color:var(--pf-soft);font-weight:700;margin:0;font-family:monospace;">@Model.Cliente?.Cedula</p>
                    </div>
                </div>
                <input type="hidden" id="clienteId" value="@Model.ClienteId" />
            </div>

            <!-- Plan -->
            <div>
                <label class="pf-label">Plan <span style="color:var(--pf-blue);">*</span></label>
                <select id="planId" required class="pf-select">
                    @if (ViewBag.Planes != null)
                    {
                        foreach (var plan in ViewBag.Planes)
                        {
                            var isSelected = plan.Id == Model.PlanId;
                            <option value="@plan.Id"
                                    data-precio="@plan.Precio"
                                    data-duracion="@plan.DuracionDias"
                                    data-tipo="@plan.TipoCalculoVencimiento"
                                    data-cantidad="@plan.CantidadUnidades"
                                    selected="@isSelected">
                                @plan.Nombre - $@plan.Precio (@plan.DuracionDias días)
                            </option>
                        }
                    }
                </select>
                <div id="planInfo" class="hidden" style="margin-top:.625rem;padding:.75rem 1rem;background:rgba(59,130,246,.07);border:1px solid rgba(59,130,246,.2);border-radius:.75rem;font-size:.82rem;color:var(--pf-blueB);font-weight:700;"></div>
            </div>

            <!-- Fechas -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
                <div>
                    <label class="pf-label">Fecha Inicio <span style="color:var(--pf-blue);">*</span></label>
                    <input type="date" id="fechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" required class="pf-input">
                </div>
                <div>
                    <label class="pf-label">Fecha Vencimiento <span style="color:var(--pf-blue);">*</span></label>
                    <input type="date" id="fechaVencimiento" value="@Model.FechaVencimiento.ToString("yyyy-MM-dd")" required class="pf-input">
                    <p style="font-size:.72rem;color:var(--pf-muted);font-weight:600;margin:.35rem 0 0 0;">
                        Se actualizará automáticamente al cambiar el plan o fecha de inicio
                    </p>
                </div>
            </div>

            <!-- Duración -->
            <div id="duracionInfo" class="hidden" style="padding:1.1rem 1.25rem;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.25);border-radius:.875rem;">
                <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.875rem;">
                    <i data-lucide="calendar" style="width:20px;height:20px;color:var(--pf-green);"></i>
                    <h4 style="font-weight:900;color:var(--pf-green);font-size:.82rem;text-transform:uppercase;letter-spacing:.08em;margin:0;">Duración de la Membresía</h4>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:.875rem;">
                    <div>
                        <p style="font-size:.7rem;color:rgba(16,185,129,.7);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .2rem 0;">Total:</p>
                        <p style="font-weight:900;color:var(--pf-green);font-size:1.4rem;margin:0;" id="totalDias">-</p>
                    </div>
                    <div>
                        <p style="font-size:.7rem;color:rgba(16,185,129,.7);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .2rem 0;">Vence el:</p>
                        <p style="font-weight:800;color:var(--pf-text);font-size:.95rem;margin:0;" id="fechaVencTexto">-</p>
                    </div>
                </div>
            </div>

            <!-- Estado -->
            <div>
                <label class="pf-label">Estado <span style="color:var(--pf-blue);">*</span></label>
                <select id="estado" required class="pf-select">
                    <option value="activa"     selected="@(Model.Estado=="activa")">Activa</option>
                    <option value="vencida"    selected="@(Model.Estado=="vencida")">Vencida</option>
                    <option value="suspendida" selected="@(Model.Estado=="suspendida")">Suspendida</option>
                    <option value="cancelada"  selected="@(Model.Estado=="cancelada")">Cancelada</option>
                </select>
            </div>

            <!-- Método pago -->
            <div>
                <label class="pf-label">Método de Pago (Referencial)<small>(No afecta la caja)</small></label>
                <select id="metodoPago" required class="pf-select">
                    <option value="efectivo"      selected="@(Model.MetodoPago=="efectivo")">Efectivo</option>
                    <option value="tarjeta"        selected="@(Model.MetodoPago=="tarjeta")">Tarjeta</option>
                    <option value="transferencia"  selected="@(Model.MetodoPago=="transferencia")">Transferencia</option>
                </select>
            </div>

            <!-- Monto original (lectura) -->
            <div style="padding:1rem 1.25rem;background:rgba(255,255,255,.03);border:1px solid var(--pf-border);border-radius:.875rem;display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .25rem 0;">Monto Pagado Originalmente</p>
                    <p style="font-size:1.5rem;font-weight:900;color:var(--pf-text);margin:0 0 .2rem 0;">$@Model.MontoPagado.ToString("N2")</p>
                    <p style="font-size:.72rem;color:var(--pf-muted);font-weight:600;margin:0;display:flex;align-items:center;gap:.3rem;">
                        <i data-lucide="lock" style="width:12px;height:12px;"></i>
                        Este campo no se puede editar desde aquí
                    </p>
                </div>
                <div style="background:rgba(59,130,246,.1);padding:.875rem;border-radius:.75rem;">
                    <i data-lucide="dollar-sign" style="width:28px;height:28px;color:var(--pf-blueB);"></i>
                </div>
            </div>

            <!-- Notas -->
            <div>
                <label class="pf-label">Notas (Opcional)</label>
                <textarea id="notas" rows="3" class="pf-input" style="resize:vertical;" placeholder="Observaciones o comentarios adicionales...">@Model.Notas</textarea>
            </div>

            <!-- Timestamps -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:.875rem;padding:1rem 1.25rem;background:rgba(255,255,255,.02);border:1px solid var(--pf-border);border-radius:.875rem;">
                <div>
                    <p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .2rem 0;">Creado:</p>
                    <p style="font-size:.85rem;font-weight:800;color:var(--pf-soft);margin:0;">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div>
                    <p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .2rem 0;">Última Actualización:</p>
                    <p style="font-size:.85rem;font-weight:800;color:var(--pf-soft);margin:0;">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <!-- Botones -->
            <div style="display:flex;gap:1rem;padding-top:1.25rem;border-top:1px solid var(--pf-border);">
                <a href="/membresias"
                   style="flex:1;background:rgba(255,255,255,.05);border:1px solid var(--pf-border);color:var(--pf-soft);font-weight:800;padding:1rem;border-radius:.875rem;text-align:center;text-decoration:none;font-size:.9rem;text-transform:uppercase;letter-spacing:.08em;display:flex;align-items:center;justify-content:center;gap:.5rem;transition:background .2s;"
                   onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">
                    <i data-lucide="arrow-left" style="width:18px;height:18px;"></i>
                    Cancelar
                </a>
                <button type="submit"
                        style="flex:1;background:linear-gradient(135deg,#92400E,#B45309);color:#FCD34D;font-weight:800;padding:1rem;border:none;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.9rem;text-transform:uppercase;letter-spacing:.08em;box-shadow:0 4px 20px rgba(180,83,9,.3);transition:transform .2s,box-shadow .2s;display:flex;align-items:center;justify-content:center;gap:.5rem;"
                        onmouseover="this.style.transform='scale(1.02)';this.style.boxShadow='0 8px 28px rgba(180,83,9,.45)'" onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 20px rgba(180,83,9,.3)'">
                    <i data-lucide="save" style="width:18px;height:18px;"></i>
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let planesData = [];
        let planSeleccionado = null;

        async function cargarPlanes() {
            try {
                const response = await fetch('/api/Planes');
                planesData = await response.json();
                const planActual = planesData.find(p => (p.id||p.Id) == '@Model.PlanId');
                if (planActual) {
                    planSeleccionado = {
                        id: planActual.id||planActual.Id,
                        precio: planActual.precio||planActual.Precio,
                        duracionDias: planActual.duracionDias||planActual.DuracionDias,
                        tipoCalculoVencimiento: planActual.tipoCalculoVencimiento||planActual.TipoCalculoVencimiento||'dias',
                        cantidadUnidades: planActual.cantidadUnidades||planActual.CantidadUnidades||planActual.duracionDias||planActual.DuracionDias
                    };
                    mostrarInfoPlan();
                }
            } catch (error) { console.error('Error cargando planes:', error); }
        }

        document.getElementById('planId').addEventListener('change', function() {
            const opt = this.options[this.selectedIndex];
            if (!opt.value) { planSeleccionado=null; document.getElementById('planInfo').classList.add('hidden'); document.getElementById('duracionInfo').classList.add('hidden'); return; }
            planSeleccionado = {
                id: opt.value, precio: parseFloat(opt.dataset.precio),
                duracionDias: parseInt(opt.dataset.duracion),
                tipoCalculoVencimiento: opt.dataset.tipo || 'dias',
                cantidadUnidades: parseInt(opt.dataset.cantidad || opt.dataset.duracion)
            };
            mostrarInfoPlan();
            recalcularFechaVencimiento();
        });

        document.getElementById('fechaInicio').addEventListener('change', function() {
            if (planSeleccionado) recalcularFechaVencimiento();
        });

        function mostrarInfoPlan() {
            if (!planSeleccionado) return;
            document.getElementById('planInfo').innerHTML = `
                <div style="display:flex;align-items:center;gap:.5rem;">
                    <i data-lucide="info" style="width:16px;height:16px;"></i>
                    Precio: <strong>$${planSeleccionado.precio.toFixed(2)}</strong> &nbsp;|&nbsp; Duración: <strong>${planSeleccionado.duracionDias} días</strong>
                </div>`;
            document.getElementById('planInfo').classList.remove('hidden');
            lucide.createIcons();
        }

        function recalcularFechaVencimiento() {
            const fi = document.getElementById('fechaInicio').value;
            if (!fi || !planSeleccionado) return;
            const [y,m,d] = fi.split('-').map(Number);
            const inicio = new Date(y, m-1, d);
            let venc, texto;
            switch (planSeleccionado.tipoCalculoVencimiento.toLowerCase()) {
                case 'meses':   venc=new Date(inicio); venc.setMonth(venc.getMonth()+planSeleccionado.cantidadUnidades);   texto=`${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades===1?'mes':'meses'}`;     break;
                case 'semanas': venc=new Date(inicio); venc.setDate(venc.getDate()+planSeleccionado.cantidadUnidades*7);   texto=`${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades===1?'semana':'semanas'}`; break;
                case 'anios':   venc=new Date(inicio); venc.setFullYear(venc.getFullYear()+planSeleccionado.cantidadUnidades); texto=`${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades===1?'año':'años'}`;      break;
                default:        venc=new Date(inicio); venc.setDate(venc.getDate()+(planSeleccionado.duracionDias-1));     texto=`${planSeleccionado.duracionDias} días`;                                                              break;
            }
            const vy=venc.getFullYear(), vm=String(venc.getMonth()+1).padStart(2,'0'), vd=String(venc.getDate()).padStart(2,'0');
            document.getElementById('fechaVencimiento').value = `${vy}-${vm}-${vd}`;
            document.getElementById('totalDias').textContent  = texto;
            document.getElementById('fechaVencTexto').textContent = venc.toLocaleDateString('es-ES',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
            document.getElementById('duracionInfo').classList.remove('hidden');
        }

        document.getElementById('editForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            if (!confirm('⚠️ ¿Confirmar cambios en esta membresía?\n\n✏️ Solo se editarán los datos\n🚫 NO se registrará ningún movimiento en caja')) return;
            const id = document.getElementById('membresiaId').value;
            const data = {
                id, clienteId: document.getElementById('clienteId').value,
                planId: document.getElementById('planId').value,
                fechaInicio: document.getElementById('fechaInicio').value,
                fechaVencimiento: document.getElementById('fechaVencimiento').value,
                estado: document.getElementById('estado').value,
                montoPagado: parseFloat(document.getElementById('montoPagadoOriginal').value),
                metodoPago: document.getElementById('metodoPago').value,
                notas: document.getElementById('notas').value || null
            };
            try {
                const response = await fetch(`/api/Membresias/${id}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
                if (response.ok) { alert('✅ Membresía actualizada exitosamente'); window.location.href='/membresias'; }
                else { const error = await response.text(); alert('❌ Error al actualizar: '+error); }
            } catch (error) { console.error('Error:',error); alert('❌ Error al actualizar la membresía: '+error.message); }
        });

        document.querySelectorAll('input[type="number"]').forEach(i => i.addEventListener('wheel', e => e.preventDefault(), {passive:false}));

        document.addEventListener('DOMContentLoaded', function() {
            cargarPlanes(); lucide.createIcons();
        });
    </script>
}

@model VidaFitBackend.Models.Membresia
@{
    ViewData["Title"] = "Editar Membresía";
    ViewData["Subtitle"] = "Modificar información de la membresía - POWER FITNESS";
    Layout = "_AdminLayout";
}

<style>
    .pf-input {
        width: 100%; padding: 13px 16px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px; color: #fff; font-size: 0.9rem; font-weight: 600;
        font-family: 'Inter', sans-serif; outline: none; transition: border-color 0.2s, box-shadow 0.2s;
        resize: none;
    }
    .pf-input::placeholder { color: rgba(255,255,255,0.2); }
    .pf-input:focus { border-color: #1E6FE3; box-shadow: 0 0 0 3px rgba(30,111,227,0.15); }

    .pf-label {
        display: block; font-size: 0.68rem; font-weight: 800;
        letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 8px;
    }

    .pf-select {
        width: 100%; padding: 13px 16px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px; color: #fff; font-size: 0.9rem; font-weight: 600;
        font-family: 'Inter', sans-serif; outline: none; transition: border-color 0.2s;
    }
    .pf-select:focus { border-color: #1E6FE3; }
    .pf-select option { background: #0D0D20; color: #fff; }

    .section-divider {
        display: flex; align-items: center; gap: 12px;
        padding-bottom: 16px; margin-bottom: 20px;
        border-bottom: 1px solid rgba(30,111,227,0.12);
    }
    .section-icon {
        width: 36px; height: 36px; border-radius: 9px;
        background: rgba(30,111,227,0.1); border: 1px solid rgba(30,111,227,0.2);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
</style>

<div style="max-width:860px;margin:0 auto;">
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:16px;padding:32px;">

        <!-- Header -->
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:28px;padding-bottom:24px;border-bottom:1px solid rgba(30,111,227,0.12);">
            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#D97706,#B45309);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i data-lucide="edit" style="width:24px;height:24px;color:#fff;"></i>
            </div>
            <div>
                <h2 style="font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:3px;color:#fff;margin:0;line-height:1;">Editar Membresía</h2>
                <div style="display:flex;align-items:center;gap:8px;margin-top:4px;flex-wrap:wrap;">
                    <p style="font-size:0.78rem;color:rgba(255,255,255,0.35);margin:0;font-weight:600;">Modificar datos sin afectar la caja</p>
                    <span style="display:inline-flex;align-items:center;gap:5px;padding:3px 10px;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.2);border-radius:100px;font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#3D8EFF;">
                        <i data-lucide="info" style="width:10px;height:10px;"></i> No registra ingreso
                    </span>
                </div>
            </div>
        </div>

        <!-- Info banner -->
        <div style="margin-bottom:24px;padding:14px 18px;background:rgba(30,111,227,0.05);border:1px solid rgba(30,111,227,0.15);border-left:3px solid #1E6FE3;border-radius:10px;display:flex;align-items:flex-start;gap:12px;">
            <i data-lucide="alert-circle" style="width:18px;height:18px;color:#3D8EFF;flex-shrink:0;margin-top:1px;"></i>
            <div>
                <p style="font-size:0.72rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:#3D8EFF;margin:0 0 6px 0;">ℹ️ Importante</p>
                <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:3px;">
                    <li style="font-size:0.8rem;color:rgba(255,255,255,0.5);font-weight:600;">✏️ Esta función solo EDITA datos de la membresía</li>
                    <li style="font-size:0.8rem;color:rgba(255,255,255,0.5);font-weight:600;">🚫 NO registra movimientos en caja</li>
                    <li style="font-size:0.8rem;color:rgba(255,255,255,0.5);font-weight:600;">💰 Para renovar y registrar pago, use el botón RENOVAR del listado</li>
                </ul>
            </div>
        </div>

        <form id="editForm" style="display:flex;flex-direction:column;gap:24px;">
            <input type="hidden" id="membresiaId" value="@Model.Id" />
            <input type="hidden" id="createdAt" value="@Model.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")" />
            <input type="hidden" id="montoPagadoOriginal" value="@Model.MontoPagado" />

            <!-- Cliente (solo lectura) -->
            <div>
                <div class="section-divider">
                    <div class="section-icon"><i data-lucide="user" style="width:16px;height:16px;color:#3D8EFF;"></i></div>
                    <span style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#fff;">Cliente</span>
                </div>
                <div style="padding:16px 18px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:12px;display:flex;align-items:center;gap:14px;">
                    <div style="width:42px;height:42px;border-radius:10px;background:rgba(30,111,227,0.08);border:1px solid rgba(30,111,227,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i data-lucide="user" style="width:18px;height:18px;color:rgba(30,111,227,0.5);"></i>
                    </div>
                    <div>
                        <p style="font-weight:800;color:#fff;font-size:1rem;margin:0 0 3px 0;text-transform:uppercase;letter-spacing:1px;">@Model.Cliente?.Nombre @Model.Cliente?.Apellido</p>
                        <p style="font-size:0.78rem;color:rgba(255,255,255,0.35);font-weight:600;margin:0;font-family:monospace;">@Model.Cliente?.Cedula</p>
                    </div>
                </div>
                <input type="hidden" id="clienteId" value="@Model.ClienteId" />
            </div>

            <!-- Plan -->
            <div>
                <div class="section-divider">
                    <div class="section-icon"><i data-lucide="credit-card" style="width:16px;height:16px;color:#3D8EFF;"></i></div>
                    <span style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#fff;">Plan</span>
                </div>
                <label class="pf-label">Plan *</label>
                <select id="planId" required class="pf-select">
                    @if (ViewBag.Planes != null)
                    {
                        foreach (var plan in ViewBag.Planes)
                        {
                            var isSelected = plan.Id == Model.PlanId;
                            <option value="@plan.Id"
                                    data-precio="@plan.Precio"
                                    data-duracion="@plan.DuracionDias"
                                    data-tipo="@plan.TipoCalculoVencimiento"
                                    data-cantidad="@plan.CantidadUnidades"
                                    selected="@isSelected">
                                @plan.Nombre - $@plan.Precio (@plan.DuracionDias días)
                            </option>
                        }
                    }
                </select>
                <div id="planInfo" style="display:none;margin-top:8px;padding:12px 14px;background:rgba(30,111,227,0.06);border:1px solid rgba(30,111,227,0.18);border-radius:10px;font-size:0.82rem;color:#7EB8FF;font-weight:700;"></div>
            </div>

            <!-- Fechas -->
            <div>
                <div class="section-divider">
                    <div class="section-icon"><i data-lucide="calendar" style="width:16px;height:16px;color:#3D8EFF;"></i></div>
                    <span style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#fff;">Fechas</span>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div>
                        <label class="pf-label">Fecha Inicio *</label>
                        <input type="date" id="fechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" required class="pf-input">
                    </div>
                    <div>
                        <label class="pf-label">Fecha Vencimiento *</label>
                        <input type="date" id="fechaVencimiento" value="@Model.FechaVencimiento.ToString("yyyy-MM-dd")" required class="pf-input">
                        <p style="font-size:0.7rem;color:rgba(255,255,255,0.25);font-weight:600;margin:6px 0 0 0;">Se actualiza automáticamente al cambiar plan o fecha de inicio</p>
                    </div>
                </div>

                <!-- Duración info -->
                <div id="duracionInfo" style="display:none;margin-top:14px;">
                    <div style="padding:14px 16px;background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.18);border-radius:10px;">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                            <i data-lucide="calendar" style="width:14px;height:14px;color:#10B981;"></i>
                            <span style="font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#10B981;">Duración de la Membresía</span>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                            <div>
                                <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 4px 0;">Total</p>
                                <p style="font-size:1.3rem;font-weight:900;color:#fff;margin:0;" id="totalDias">—</p>
                            </div>
                            <div>
                                <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 4px 0;">Vence el</p>
                                <p style="font-weight:700;color:rgba(255,255,255,0.7);margin:0;" id="fechaVencTexto">—</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Estado y método -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div>
                    <label class="pf-label">Estado *</label>
                    <select id="estado" required class="pf-select">
                        <option value="activa"      selected="@(Model.Estado == "activa")">Activa</option>
                        <option value="vencida"     selected="@(Model.Estado == "vencida")">Vencida</option>
                        <option value="suspendida"  selected="@(Model.Estado == "suspendida")">Suspendida</option>
                        <option value="cancelada"   selected="@(Model.Estado == "cancelada")">Cancelada</option>
                    </select>
                </div>
                <div>
                    <label class="pf-label">Método de Pago
                        <span style="font-size:0.55rem;color:rgba(255,255,255,0.2);text-transform:none;letter-spacing:0;">(referencial)</span>
                    </label>
                    <select id="metodoPago" required class="pf-select">
                        <option value="efectivo"      selected="@(Model.MetodoPago == "efectivo")">Efectivo</option>
                        <option value="tarjeta"       selected="@(Model.MetodoPago == "tarjeta")">Tarjeta</option>
                        <option value="transferencia" selected="@(Model.MetodoPago == "transferencia")">Transferencia</option>
                    </select>
                </div>
            </div>

            <!-- Monto pagado (solo lectura) -->
            <div style="padding:16px 18px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:12px;display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 5px 0;">Monto Pagado Originalmente</p>
                    <p style="font-size:1.6rem;font-weight:900;color:#10B981;margin:0;">$@Model.MontoPagado.ToString("N2")</p>
                    <p style="font-size:0.7rem;color:rgba(255,255,255,0.25);font-weight:600;margin:4px 0 0 0;display:flex;align-items:center;gap:5px;">
                        <i data-lucide="lock" style="width:11px;height:11px;"></i> No editable desde aquí
                    </p>
                </div>
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,0.04);display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="dollar-sign" style="width:20px;height:20px;color:rgba(255,255,255,0.2);"></i>
                </div>
            </div>

            <!-- Notas -->
            <div>
                <label class="pf-label">Notas (Opcional)</label>
                <textarea id="notas" rows="3" class="pf-input" placeholder="Observaciones o comentarios adicionales...">@Model.Notas</textarea>
            </div>

            <!-- Timestamps -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:14px 16px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.05);border-radius:10px;">
                <div>
                    <p style="font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.25);margin:0 0 4px 0;">Creado</p>
                    <p style="font-size:0.82rem;font-weight:700;color:rgba(255,255,255,0.5);margin:0;">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div>
                    <p style="font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.25);margin:0 0 4px 0;">Última Actualización</p>
                    <p style="font-size:0.82rem;font-weight:700;color:rgba(255,255,255,0.5);margin:0;">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <!-- Botones -->
            <div style="display:flex;gap:12px;padding-top:20px;border-top:1px solid rgba(30,111,227,0.12);">
                <a href="/membresias"
                   style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.5);font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border:1px solid rgba(255,255,255,0.08);border-radius:12px;text-decoration:none;transition:all 0.15s;"
                   onmouseover="this.style.background='rgba(255,255,255,0.08)';this.style.color='rgba(255,255,255,0.8)'"
                   onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.color='rgba(255,255,255,0.5)'">
                    <i data-lucide="arrow-left" style="width:16px;height:16px;"></i>
                    Cancelar
                </a>
                <button type="submit" id="btn-guardar"
                        style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;background:linear-gradient(135deg,#D97706,#B45309);color:#fff;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer;transition:opacity 0.2s,transform 0.2s;"
                        onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.02)'"
                        onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
                    <i data-lucide="save" style="width:16px;height:16px;"></i>
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let planesData = [];
        let planSeleccionado = null;

        async function cargarPlanes() {
            try {
                const r = await fetch('/api/Planes');
                planesData = await r.json();
                const planActual = planesData.find(p=>(p.id||p.Id)==='@Model.PlanId');
                if (planActual) {
                    planSeleccionado = {
                        id: planActual.id||planActual.Id,
                        precio: planActual.precio||planActual.Precio,
                        duracionDias: planActual.duracionDias||planActual.DuracionDias,
                        tipoCalculoVencimiento: planActual.tipoCalculoVencimiento||planActual.TipoCalculoVencimiento||'dias',
                        cantidadUnidades: planActual.cantidadUnidades||planActual.CantidadUnidades||planActual.duracionDias||planActual.DuracionDias
                    };
                    mostrarInfoPlan();
                }
            } catch(e) { console.error(e); }
        }

        document.getElementById('planId').addEventListener('change', function() {
            const opt = this.options[this.selectedIndex];
            if (!opt.value) { planSeleccionado=null; document.getElementById('planInfo').style.display='none'; document.getElementById('duracionInfo').style.display='none'; return; }
            planSeleccionado = {
                id: opt.value, precio: parseFloat(opt.dataset.precio),
                duracionDias: parseInt(opt.dataset.duracion),
                tipoCalculoVencimiento: opt.dataset.tipo||'dias',
                cantidadUnidades: parseInt(opt.dataset.cantidad||opt.dataset.duracion)
            };
            mostrarInfoPlan(); recalcularFechaVencimiento();
        });

        document.getElementById('fechaInicio').addEventListener('change', function() {
            if (planSeleccionado) recalcularFechaVencimiento();
        });

        function mostrarInfoPlan() {
            if (!planSeleccionado) return;
            const info = document.getElementById('planInfo');
            info.innerHTML = `Precio: <strong>$${planSeleccionado.precio.toFixed(2)}</strong> | Duración: <strong>${planSeleccionado.duracionDias} días</strong>`;
            info.style.display = 'block';
        }

        function recalcularFechaVencimiento() {
            const fi = document.getElementById('fechaInicio').value;
            if (!fi||!planSeleccionado) return;
            const [year,month,day] = fi.split('-').map(Number);
            const inicio = new Date(year,month-1,day);
            const tipo = (planSeleccionado.tipoCalculoVencimiento||'dias').toLowerCase();
            const cant = planSeleccionado.cantidadUnidades;
            let v = new Date(inicio);
            if (tipo==='meses')   v.setMonth(v.getMonth()+cant);
            else if (tipo==='semanas') v.setDate(v.getDate()+cant*7);
            else if (tipo==='anios')  v.setFullYear(v.getFullYear()+cant);
            else v.setDate(v.getDate()+(planSeleccionado.duracionDias-1));
            document.getElementById('fechaVencimiento').value=`${v.getFullYear()}-${String(v.getMonth()+1).padStart(2,'0')}-${String(v.getDate()).padStart(2,'0')}`;
            const durTxt=tipo==='meses'?`${cant} ${cant===1?'mes':'meses'}`:tipo==='semanas'?`${cant} ${cant===1?'semana':'semanas'}`:tipo==='anios'?`${cant} ${cant===1?'año':'años'}`:`${planSeleccionado.duracionDias} días`;
            document.getElementById('totalDias').textContent=durTxt;
            document.getElementById('fechaVencTexto').textContent=v.toLocaleDateString('es-ES',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
            document.getElementById('duracionInfo').style.display='block';
        }

        document.getElementById('editForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            if (!confirm('⚠️ ¿Confirmar cambios en esta membresía?\n\n✏️ Solo se editarán los datos\n🚫 NO se registrará ningún movimiento en caja')) return;
            const btn = document.getElementById('btn-guardar');
            btn.disabled=true;
            btn.innerHTML=`<div style="width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin 0.7s linear infinite;"></div> Guardando...`;
            const membresiaId = document.getElementById('membresiaId').value;
            const data = {
                id: membresiaId,
                clienteId: document.getElementById('clienteId').value,
                planId: document.getElementById('planId').value,
                fechaInicio: document.getElementById('fechaInicio').value,
                fechaVencimiento: document.getElementById('fechaVencimiento').value,
                estado: document.getElementById('estado').value,
                montoPagado: parseFloat(document.getElementById('montoPagadoOriginal').value),
                metodoPago: document.getElementById('metodoPago').value,
                notas: document.getElementById('notas').value||null
            };
            try {
                const r = await fetch(`/api/Membresias/${membresiaId}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
                if (r.ok) { alert('✅ Membresía actualizada exitosamente'); window.location.href='/membresias'; }
                else { alert('❌ Error al actualizar: '+(await r.text())); }
            } catch(error) { alert('❌ Error: '+error.message); }
            finally {
                btn.disabled=false;
                btn.innerHTML='<i data-lucide="save" style="width:16px;height:16px;"></i> Guardar Cambios';
                lucide.createIcons();
            }
        });

        document.querySelectorAll('input[type="number"]').forEach(i =>
            i.addEventListener('wheel', e=>e.preventDefault(), {passive:false})
        );

        document.addEventListener('DOMContentLoaded', () => {
            cargarPlanes(); lucide.createIcons();
            if (planSeleccionado) recalcularFechaVencimiento();
        });
    </script>
    <style>@@keyframes spin { to { transform: rotate(360deg); } }</style>
}

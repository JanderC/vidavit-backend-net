@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Membresías";
    ViewData["Subtitle"] = "Gestión de membresías del gimnasio";
}

<div class="mb-6">
    <!-- Filtros por Estado -->
    <div class="flex items-center justify-between mb-4">
        <div class="flex gap-3">
            <button onclick="filterByEstado('todas')"
                    class="filter-btn px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-colors" data-estado="todas">
                Todas
            </button>
            <button onclick="filterByEstado('activa')"
                    class="filter-btn px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-colors" data-estado="activa">
                Activas
            </button>
            <button onclick="filterByEstado('vencida')"
                    class="filter-btn px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-colors" data-estado="vencida">
                Vencidas
            </button>
            <button onclick="filterByEstado('suspendida')"
                    class="filter-btn px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-colors" data-estado="suspendida">
                Suspendidas
            </button>
        </div>

        <a href="/membresias/crear"
           class="inline-flex items-center gap-2 px-6 py-2 bg-vida-primary hover:bg-vida-accent text-vida-dark font-semibold rounded-lg transition-all shadow-lg hover:shadow-xl">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Nueva Membresía
        </a>

        <a href="/membresias/planes/"
           class="inline-flex items-center gap-2 px-6 py-2 bg-vida-primary hover:bg-vida-accent text-vida-dark font-semibold rounded-lg transition-all shadow-lg hover:shadow-xl">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Nuevo Plan
        </a>
    </div>

    <!-- Filtros por Plan -->
    <div class="bg-white rounded-lg shadow p-4 mb-4">
        <div class="flex items-center gap-3 flex-wrap">
            <span class="text-sm font-medium text-gray-700">Filtrar por plan:</span>
            <button onclick="filterByPlan(null)"
                    class="plan-filter-btn px-3 py-1 bg-vida-primary text-vida-dark text-sm rounded-lg font-semibold"
                    data-plan="todos">
                Todos los planes
            </button>
            <div id="planesFilters" class="flex gap-2 flex-wrap"></div>
        </div>
    </div>
</div>

<!-- Estadísticas Rápidas -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-lg shadow p-4 border-l-4 border-green-500">
        <p class="text-sm text-gray-600">Activas</p>
        <p class="text-2xl font-bold text-gray-800" id="count-activas">0</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4 border-l-4 border-yellow-500">
        <p class="text-sm text-gray-600">Por Vencer (7 días)</p>
        <p class="text-2xl font-bold text-gray-800" id="count-por-vencer">0</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4 border-l-4 border-red-500">
        <p class="text-sm text-gray-600">Vencidas</p>
        <p class="text-2xl font-bold text-gray-800" id="count-vencidas">0</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4 border-l-4 border-blue-500">
        <p class="text-sm text-gray-600">Total</p>
        <p class="text-2xl font-bold text-gray-800" id="count-total">0</p>
    </div>
</div>

<!-- Lista de Membresías -->
<div class="bg-white rounded-xl shadow-md overflow-hidden">
    <div id="membresias-container" class="p-6">
        <div class="flex items-center justify-center h-64">
            <div class="text-center">
                <div class="animate-spin w-12 h-12 border-4 border-vida-primary border-t-transparent rounded-full mx-auto mb-4"></div>
                <p class="text-gray-600">Cargando membresías...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let membresiasData = [];
        let planesData = [];
        let filtroEstado = 'todas';
        let filtroPlan = null;

        async function loadMembresias() {
            try {
                const response = await fetch(`${API_URL}/Membresias`);
                if (!response.ok) throw new Error('Error en la respuesta');

                membresiasData = await response.json();
                console.log('Membresías cargadas:', membresiasData.length);

                calcularEstadisticas();
                renderMembresias();
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('membresias-container').innerHTML = `
                    <div class="text-center py-12 text-red-500">
                        <i data-lucide="alert-circle" class="w-12 h-12 mx-auto mb-2"></i>
                        <p class="font-semibold">Error al cargar las membresías</p>
                        <button onclick="loadMembresias()" class="mt-4 px-4 py-2 bg-vida-primary text-vida-dark rounded-lg hover:bg-yellow-400">
                            Reintentar
                        </button>
                    </div>
                `;
                lucide.createIcons();
            }
        }

        async function loadPlanes() {
            try {
                const response = await fetch(`${API_URL}/Planes`);
                planesData = await response.json();

                const container = document.getElementById('planesFilters');
                container.innerHTML = planesData.map(p => `
                    <button onclick="filterByPlan('${p.id || p.Id}')"
                            class="plan-filter-btn px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-lg hover:bg-gray-200"
                            data-plan="${p.id || p.Id}">
                        ${p.nombre || p.Nombre}
                    </button>
                `).join('');
            } catch (error) {
                console.error('Error cargando planes:', error);
            }
        }

        function calcularEstadisticas() {
            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);

            const activas = membresiasData.filter(m => (m.estado || m.Estado) === 'activa').length;
            const vencidas = membresiasData.filter(m => (m.estado || m.Estado) === 'vencida').length;

            const porVencer = membresiasData.filter(m => {
                if ((m.estado || m.Estado) !== 'activa') return false;
                const fechaVenc = new Date(m.fechaVencimiento || m.FechaVencimiento);
                fechaVenc.setHours(0, 0, 0, 0);
                const diasRestantes = Math.ceil((fechaVenc - hoy) / (1000 * 60 * 60 * 24));
                return diasRestantes <= 7 && diasRestantes >= 0;
            }).length;

            document.getElementById('count-activas').textContent = activas;
            document.getElementById('count-por-vencer').textContent = porVencer;
            document.getElementById('count-vencidas').textContent = vencidas;
            document.getElementById('count-total').textContent = membresiasData.length;
        }

        function renderMembresias() {
            const container = document.getElementById('membresias-container');

            let filtradas = membresiasData;

            if (filtroEstado !== 'todas') {
                filtradas = filtradas.filter(m => (m.estado || m.Estado) === filtroEstado);
            }

            if (filtroPlan) {
                filtradas = filtradas.filter(m => (m.planId || m.PlanId) === filtroPlan);
            }

            if (filtradas.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-gray-500">
                        <i data-lucide="inbox" class="w-16 h-16 mx-auto mb-4 text-gray-400"></i>
                        <p class="text-lg">No hay membresías con los filtros seleccionados</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            container.innerHTML = `
                <div class="space-y-3">
                    ${filtradas.map(m => renderMembresia(m)).join('')}
                </div>
            `;

            lucide.createIcons();
        }

        function renderMembresia(m) {
            const fechaInicio = new Date(m.fechaInicio || m.FechaInicio);
            const fechaVenc = new Date(m.fechaVencimiento || m.FechaVencimiento);
            const estado = m.estado || m.Estado;

            const fechaInicioStr = fechaInicio.toLocaleDateString('es-ES');
            const fechaVencStr = fechaVenc.toLocaleDateString('es-ES');

            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);
            fechaVenc.setHours(0, 0, 0, 0);

            const diasRestantes = Math.ceil((fechaVenc - hoy) / (1000 * 60 * 60 * 24));

            let estadoBadge = '';
            let diasTexto = '';

            if (estado === 'activa') {
                if (diasRestantes < 0) {
                    estadoBadge = '<span class="px-3 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full">Vencida (actualizar)</span>';
                    diasTexto = `<span class="text-red-600 font-bold">Vencida hace ${Math.abs(diasRestantes)} días</span>`;
                } else if (diasRestantes === 0) {
                    estadoBadge = '<span class="px-3 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full animate-pulse">Vence HOY</span>';
                    diasTexto = '<span class="text-red-600 font-bold animate-pulse">¡Vence HOY!</span>';
                } else if (diasRestantes <= 3) {
                    estadoBadge = '<span class="px-3 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full">Vence pronto</span>';
                    diasTexto = `<span class="text-red-600 font-bold">${diasRestantes} ${diasRestantes === 1 ? 'día' : 'días'}</span>`;
                } else if (diasRestantes <= 7) {
                    estadoBadge = '<span class="px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-semibold rounded-full">Por vencer</span>';
                    diasTexto = `<span class="text-yellow-600 font-semibold">${diasRestantes} días</span>`;
                } else {
                    estadoBadge = '<span class="px-3 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">Activa</span>';
                    diasTexto = `<span class="text-green-600 font-semibold">${diasRestantes} días</span>`;
                }
            } else if (estado === 'vencida') {
                estadoBadge = '<span class="px-3 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full">Vencida</span>';
                diasTexto = '<span class="text-red-600">Vencida</span>';
            } else if (estado === 'suspendida') {
                estadoBadge = '<span class="px-3 py-1 bg-gray-100 text-gray-800 text-xs font-semibold rounded-full">Suspendida</span>';
                diasTexto = '<span class="text-gray-600">-</span>';
            }

            const cliente = m.cliente || m.Cliente;
            const plan = m.plan || m.Plan;

            const clienteNombre = cliente ?
                `${cliente.nombre || cliente.Nombre} ${cliente.apellido || cliente.Apellido}` :
                'Cliente no disponible';
            const planNombre = plan ? (plan.nombre || plan.Nombre) : 'Plan no disponible';
            const planTipo = plan ? (plan.tipo || plan.Tipo) : '';
            const planColor = plan ? (plan.color || plan.Color || '#00FF00') : '#00FF00';

            return `
                <div class="p-4 border-l-4 border-gray-200 rounded-lg hover:shadow-md transition-all" style="border-left-color: ${planColor}">
                    <div class="flex items-center justify-between">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-3">
                                <h3 class="font-bold text-gray-800 text-lg">${clienteNombre}</h3>
                                ${estadoBadge}
                                <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">${planTipo}</span>
                            </div>
                            <div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-sm">
                                <div>
                                    <p class="text-gray-500 mb-1">Plan</p>
                                    <p class="font-semibold text-gray-800">${planNombre}</p>
                                </div>
                                <div>
                                    <p class="text-gray-500 mb-1">Inicio</p>
                                    <p class="font-semibold text-gray-800">${fechaInicioStr}</p>
                                </div>
                                <div>
                                    <p class="text-gray-500 mb-1">Vencimiento</p>
                                    <p class="font-semibold text-gray-800">${fechaVencStr}</p>
                                </div>
                                <div>
                                    <p class="text-gray-500 mb-1">Días restantes</p>
                                    <p class="font-semibold">${diasTexto}</p>
                                </div>
                                <div>
                                    <p class="text-gray-500 mb-1">Monto</p>
                                    <p class="font-semibold text-gray-800">$${m.montoPagado || m.MontoPagado}</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 ml-4">
                            ${(estado === 'vencida' || (estado === 'activa' && diasRestantes < 0)) ? `
                            <button onclick="renovarMembresia('${m.id || m.Id}')"
                                    class="px-3 py-2 bg-vida-primary hover:bg-vida-accent text-vida-dark font-semibold rounded-lg transition-colors flex items-center gap-2"
                                    title="Renovar membresía">
                                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                                Renovar
                            </button>
                            ` : ''}
                            <button onclick="verDetalles('${m.id || m.Id}')"
                                    class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                                    title="Ver detalles">
                                <i data-lucide="eye" class="w-5 h-5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function filterByEstado(estado) {
            filtroEstado = estado;

            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.dataset.estado === estado) {
                    btn.classList.remove('bg-gray-100', 'text-gray-700');
                    btn.classList.add('bg-vida-primary', 'text-vida-dark', 'font-semibold');
                } else {
                    btn.classList.add('bg-gray-100', 'text-gray-700');
                    btn.classList.remove('bg-vida-primary', 'text-vida-dark', 'font-semibold');
                }
            });

            renderMembresias();
        }

        function filterByPlan(planId) {
            filtroPlan = planId;

            document.querySelectorAll('.plan-filter-btn').forEach(btn => {
                if (btn.dataset.plan === (planId || 'todos')) {
                    btn.classList.remove('bg-gray-100', 'text-gray-700');
                    btn.classList.add('bg-vida-primary', 'text-vida-dark', 'font-semibold');
                } else {
                    btn.classList.add('bg-gray-100', 'text-gray-700');
                    btn.classList.remove('bg-vida-primary', 'text-vida-dark', 'font-semibold');
                }
            });

            renderMembresias();
        }

        function renovarMembresia(id) {
            const membresia = membresiasData.find(m => (m.id || m.Id) == id);
            if (!membresia) return;

            const cliente = membresia.cliente || membresia.Cliente;
            const plan = membresia.plan || membresia.Plan;
            const clienteNombre = `${cliente.nombre || cliente.Nombre} ${cliente.apellido || cliente.Apellido}`;
            const planNombre = plan ? (plan.nombre || plan.Nombre) : 'Plan no disponible';

            // Crear modal de renovación
            const modal = document.createElement('div');
            modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            modal.innerHTML = `
                <div class="bg-white rounded-xl shadow-2xl p-8 max-w-md w-full mx-4">
                    <h3 class="text-2xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i data-lucide="refresh-cw" class="w-6 h-6 text-vida-primary"></i>
                        Renovar Membresía
                    </h3>
                    <div class="mb-6">
                        <p class="text-gray-700 mb-2"><strong>Cliente:</strong> ${clienteNombre}</p>
                        <p class="text-gray-700 mb-4"><strong>Plan actual:</strong> ${planNombre}</p>

                        <label class="block text-sm font-medium text-gray-700 mb-2">Monto a Pagar *</label>
                        <div class="relative mb-4">
                            <span class="absolute left-4 top-3.5 text-gray-500 font-medium">$</span>
                            <input type="number" step="0.01" id="montoRenovacion"
                                   value="${(membresia.montoPagado || membresia.MontoPagado)}"
                                   class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                        </div>

                        <label class="block text-sm font-medium text-gray-700 mb-2">Método de Pago *</label>
                        <select id="metodoPagoRenovacion" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary mb-4">
                            <option value="efectivo">💵 Efectivo</option>
                            <option value="tarjeta">💳 Tarjeta</option>
                            <option value="transferencia">🏦 Transferencia</option>
                        </select>

                        <label class="block text-sm font-medium text-gray-700 mb-2">Notas (opcional)</label>
                        <textarea id="notasRenovacion" rows="2"
                                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary resize-none"></textarea>
                    </div>
                    <div class="flex gap-3">
                        <button onclick="confirmarRenovacion('${id}')"
                                class="flex-1 bg-vida-primary hover:bg-vida-accent text-vida-dark font-bold py-3 rounded-lg transition flex items-center justify-center gap-2">
                            <i data-lucide="check" class="w-5 h-5"></i>
                            Confirmar
                        </button>
                        <button onclick="this.closest('.fixed').remove()"
                                class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 font-bold py-3 rounded-lg transition">
                            Cancelar
                        </button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
            lucide.createIcons();
        }

        async function confirmarRenovacion(id) {
            const monto = parseFloat(document.getElementById('montoRenovacion').value);
            const metodoPago = document.getElementById('metodoPagoRenovacion').value;
            const notas = document.getElementById('notasRenovacion').value;

            if (!monto || monto <= 0) {
                alert('⚠️ Ingrese un monto válido');
                return;
            }

            const modal = document.querySelector('.fixed');

            try {
                const response = await fetch(`${API_URL}/Membresias/renovar/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        montoPagado: monto,
                        metodoPago: metodoPago,
                        notas: notas
                    })
                });

                const result = await response.json();

                if (result.success) {
                    if (modal) modal.remove();
                    alert('✅ Membresía renovada exitosamente');
                    window.location.reload();   
                } else {
                    alert('❌ Error: ' + (result.message || 'No se pudo renovar la membresía'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('❌ Error al renovar: ' + error.message);
            }
        }

        function verDetalles(id) {
            const membresia = membresiasData.find(m => (m.id || m.Id) == id);
            if (membresia) {
                alert(`Detalles:\nID: ${id}\nEstado: ${membresia.estado || membresia.Estado}\n\n(Si quieres mas diseño contactate al 584247551680 Ing Jander)`);
            }
        }

        window.addEventListener('load', function() {
            loadPlanes();
            loadMembresias();
            filterByEstado('todas');
        });
    </script>
}

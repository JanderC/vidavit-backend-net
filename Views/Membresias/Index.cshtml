@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Membresías";
    ViewData["Subtitle"] = "Gestión de membresías - Tallest GYM";
}

<style>
    /* ── Tallest GYM — Membresías Index ── */

    /* Filter buttons */
    .filter-btn {
        padding: .55rem 1.1rem;
        border-radius: .65rem;
        font-weight: 800;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        border: 1px solid rgba(34,197,94,0.15);
        background: #111;
        color: #6b7280;
        transition: all .2s;
        cursor: pointer;
    }

        .filter-btn:hover {
            border-color: rgba(34,197,94,0.3);
            color: #d1d5db;
        }

        .filter-btn.active {
            background: linear-gradient(135deg,#22c55e,#15803d);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 3px 12px rgba(34,197,94,0.3);
        }

    .plan-filter-btn {
        padding: .4rem .85rem;
        border-radius: .5rem;
        font-weight: 800;
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        border: 1px solid rgba(34,197,94,0.15);
        background: #111;
        color: #6b7280;
        transition: all .2s;
        cursor: pointer;
    }

        .plan-filter-btn:hover {
            border-color: rgba(34,197,94,0.3);
            color: #d1d5db;
        }

        .plan-filter-btn.active {
            background: linear-gradient(135deg,#22c55e,#15803d);
            color: #fff;
            border-color: transparent;
        }

    /* New membership button */
    .tz-new-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .65rem 1.4rem;
        border-radius: .65rem;
        background: linear-gradient(135deg,#22c55e,#15803d);
        color: #fff;
        font-weight: 800;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        text-decoration: none;
        transition: all .2s;
    }

        .tz-new-btn:hover {
            background: linear-gradient(135deg,#16a34a,#166534);
            box-shadow: 0 4px 16px rgba(34,197,94,0.3);
            transform: translateY(-1px);
        }

    /* Search bar */
    .tz-search-wrap {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.15);
        border-radius: .85rem;
        padding: .85rem 1.1rem;
        display: flex;
        align-items: center;
        gap: .75rem;
        margin-bottom: .75rem;
    }

    .tz-search {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #f9fafb;
        font-weight: 600;
        font-size: .88rem;
    }

        .tz-search::placeholder {
            color: #4b5563;
        }

    /* Filter panel */
    .tz-filter-panel {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.12);
        border-radius: .85rem;
        padding: .85rem 1.1rem;
        display: flex;
        align-items: center;
        gap: .65rem;
        flex-wrap: wrap;
        margin-bottom: .75rem;
    }

    /* Stats cards */
    .stat-card {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.12);
        border-radius: .85rem;
        padding: 1.25rem 1.5rem;
        border-left-width: 4px;
    }

        .stat-card .stat-label {
            font-size: .65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: #6b7280;
            margin-bottom: .35rem;
        }

        .stat-card .stat-value {
            font-size: 2.25rem;
            font-weight: 900;
        }

    /* Main container */
    .tz-container {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.12);
        border-radius: 1rem;
        overflow: hidden;
    }

    /* Membership card */
    .mem-card {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        border-left-width: 4px;
        border-left-style: solid;
        transition: background .15s;
    }

        .mem-card:last-child {
            border-bottom: none;
        }

        .mem-card:hover {
            background: rgba(34,197,94,0.03);
        }

    .mem-label {
        font-size: .62rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #6b7280;
        margin-bottom: .2rem;
    }

    .mem-value {
        font-weight: 800;
        color: #f9fafb;
        font-size: .9rem;
    }

    /* Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .25rem .7rem;
        border-radius: 99px;
        font-size: .65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .badge-active {
        background: rgba(16,185,129,0.12);
        color: #10b981;
        border: 1px solid rgba(16,185,129,0.25);
    }

    .badge-warn {
        background: rgba(245,158,11,0.12);
        color: #f59e0b;
        border: 1px solid rgba(245,158,11,0.25);
    }

    .badge-danger {
        background: rgba(239,68,68,0.12);
        color: #ef4444;
        border: 1px solid rgba(239,68,68,0.25);
    }

    .badge-gray {
        background: rgba(75,85,99,0.15);
        color: #9ca3af;
        border: 1px solid rgba(75,85,99,0.25);
    }

    .badge-plan {
        background: rgba(34,197,94,0.08);
        color: #22c55e;
        border: 1px solid rgba(34,197,94,0.15);
    }

    /* Action buttons */
    .act-btn {
        padding: .45rem;
        border-radius: .5rem;
        display: inline-flex;
        align-items: center;
        transition: background .15s;
        cursor: pointer;
        border: none;
        background: transparent;
    }

    .act-btn-green {
        color: #22c55e;
    }

        .act-btn-green:hover {
            background: rgba(34,197,94,0.1);
        }

    .act-btn-amber {
        color: #fbbf24;
    }

        .act-btn-amber:hover {
            background: rgba(251,191,36,0.1);
        }

    .act-btn-red {
        color: #ef4444;
    }

        .act-btn-red:hover {
            background: rgba(239,68,68,0.1);
        }

    /* Renovar button */
    .btn-renovar {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .45rem .9rem;
        border-radius: .55rem;
        background: linear-gradient(135deg,#22c55e,#15803d);
        color: #fff;
        font-weight: 800;
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        border: none;
        cursor: pointer;
        transition: all .2s;
    }

        .btn-renovar:hover {
            background: linear-gradient(135deg,#16a34a,#166534);
            box-shadow: 0 3px 12px rgba(34,197,94,0.3);
        }

    /* Pagination */
    .page-btn {
        padding: .4rem .8rem;
        border-radius: .5rem;
        border: 1px solid rgba(34,197,94,0.2);
        background: transparent;
        color: #9ca3af;
        font-weight: 800;
        font-size: .78rem;
        cursor: pointer;
        transition: all .15s;
    }

        .page-btn:hover {
            border-color: #22c55e;
            color: #22c55e;
        }

        .page-btn.active {
            background: #22c55e;
            border-color: #22c55e;
            color: #fff;
        }

    /* Pagination footer */
    .tz-pagination {
        background: rgba(0,0,0,0.5);
        border-top: 1px solid rgba(34,197,94,0.1);
        padding: .85rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .5rem;
    }

    /* ── MODAL ── */
    #modalRenovar {
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(6px);
    }

    .modal-inner {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.25);
        border-radius: 1.1rem;
        width: 100%;
        max-width: 40rem;
        margin: 1rem;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 25px 60px rgba(0,0,0,0.7);
    }

    .modal-header-tz {
        background: linear-gradient(135deg,#166534,#15803d);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(34,197,94,0.3);
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 10;
    }

        .modal-header-tz h3 {
            font-size: 1.1rem;
            font-weight: 800;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

    .modal-close {
        background: rgba(255,255,255,0.1);
        border: none;
        color: #fff;
        padding: .35rem;
        border-radius: .45rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: background .15s;
    }

        .modal-close:hover {
            background: rgba(255,255,255,0.2);
        }

    .modal-body-tz {
        padding: 1.5rem;
    }

    .tz-label-sm {
        font-size: .65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #6b7280;
        margin-bottom: .35rem;
        display: block;
    }

    .tz-input {
        width: 100%;
        padding: .65rem 1rem;
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        border-radius: .65rem;
        color: #f9fafb;
        font-weight: 600;
        font-size: .88rem;
        transition: border-color .2s;
        box-sizing: border-box;
    }

        .tz-input:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }

    .tz-select {
        width: 100%;
        padding: .65rem 1rem;
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        border-radius: .65rem;
        color: #f9fafb;
        font-weight: 600;
        font-size: .88rem;
        transition: border-color .2s;
    }

        .tz-select:focus {
            outline: none;
            border-color: #22c55e;
        }

    /* Radio options in modal */
    .radio-option {
        display: flex;
        align-items: flex-start;
        gap: .85rem;
        padding: .85rem 1rem;
        background: rgba(34,197,94,0.04);
        border: 1px solid rgba(34,197,94,0.1);
        border-radius: .65rem;
        cursor: pointer;
        transition: all .2s;
    }

        .radio-option:hover {
            border-color: rgba(34,197,94,0.3);
            background: rgba(34,197,94,0.07);
        }

        .radio-option input[type=radio] {
            accent-color: #22c55e;
            margin-top: .15rem;
            flex-shrink: 0;
        }

    .radio-option-label {
        font-weight: 800;
        color: #d1d5db;
        font-size: .85rem;
    }

    .radio-option-desc {
        font-size: .72rem;
        color: #6b7280;
        font-weight: 500;
        margin-top: .2rem;
    }

    .info-mini {
        padding: .55rem .85rem;
        border-radius: .5rem;
        font-size: .72rem;
        font-weight: 700;
        margin-top: .4rem;
    }

    .info-mini-blue {
        background: rgba(59,130,246,0.08);
        color: #93c5fd;
        border: 1px solid rgba(59,130,246,0.2);
    }

    .info-mini-green {
        background: rgba(34,197,94,0.08);
        color: #86efac;
        border: 1px solid rgba(34,197,94,0.2);
    }

    .preview-box {
        padding: .85rem 1rem;
        border-radius: .65rem;
        background: rgba(168,85,247,0.07);
        border: 1px solid rgba(168,85,247,0.2);
    }

        .preview-box .preview-title {
            font-size: .65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: #a78bfa;
            margin-bottom: .35rem;
        }

        .preview-box .preview-date {
            font-size: 1rem;
            font-weight: 900;
            color: #c4b5fd;
        }

        .preview-box .preview-dur {
            font-size: .75rem;
            color: #7c3aed;
            font-weight: 600;
            margin-top: .2rem;
        }

    .deuda-box {
        padding: .85rem 1rem;
        border-radius: .65rem;
        background: rgba(245,158,11,0.07);
        border: 1px solid rgba(245,158,11,0.25);
    }

    .btn-confirm {
        flex: 1;
        padding: .75rem 1.25rem;
        border-radius: .65rem;
        background: linear-gradient(135deg,#22c55e,#15803d);
        color: #fff;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        border: none;
        cursor: pointer;
        transition: all .2s;
    }

        .btn-confirm:hover {
            background: linear-gradient(135deg,#16a34a,#166534);
            box-shadow: 0 4px 16px rgba(34,197,94,0.3);
        }

    .btn-cancel-modal {
        flex: 1;
        padding: .75rem 1.25rem;
        border-radius: .65rem;
        background: transparent;
        border: 1px solid rgba(255,255,255,0.1);
        color: #9ca3af;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        cursor: pointer;
        transition: all .2s;
    }

        .btn-cancel-modal:hover {
            border-color: rgba(34,197,94,0.25);
            color: #d1d5db;
        }
</style>

<!-- Toolbar -->
<div class="mb-5">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;flex-wrap:wrap;gap:.5rem">
        <div style="display:flex;gap:.4rem;flex-wrap:wrap">
            <button onclick="filterByEstado('todas')" class="filter-btn" data-estado="todas">Todas</button>
            <button onclick="filterByEstado('activa')" class="filter-btn" data-estado="activa">Activas</button>
            <button onclick="filterByEstado('vencida')" class="filter-btn" data-estado="vencida">Vencidas</button>
            <button onclick="filterByEstado('suspendida')" class="filter-btn" data-estado="suspendida">Suspendidas</button>
        </div>
        <a href="/membresias/crear" class="tz-new-btn">
            <i data-lucide="plus" style="width:.9rem;height:.9rem"></i>
            Nueva Membresía
        </a>
    </div>

    <div class="tz-search-wrap">
        <i data-lucide="search" style="width:1rem;height:1rem;color:#4b5563;flex-shrink:0"></i>
        <input type="text" id="searchInput" placeholder="Buscar por nombre de cliente..."
               class="tz-search" onkeyup="filtrarMembresias()" />
    </div>

    <div class="tz-filter-panel">
        <span style="font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#6b7280">Plan:</span>
        <button onclick="filterByPlan(null)" class="plan-filter-btn active" data-plan="todos">Todos</button>
        <div id="planesFilters" style="display:flex;gap:.4rem;flex-wrap:wrap"></div>
    </div>
</div>

<!-- Stats -->
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(10rem,1fr));gap:.75rem;margin-bottom:1.25rem">
    <div class="stat-card" style="border-left-color:#10b981">
        <div class="stat-label">Activas</div>
        <div class="stat-value" style="color:#10b981" id="count-activas">0</div>
    </div>
    <div class="stat-card" style="border-left-color:#f59e0b">
        <div class="stat-label">Por Vencer (7d)</div>
        <div class="stat-value" style="color:#f59e0b" id="count-por-vencer">0</div>
    </div>
    <div class="stat-card" style="border-left-color:#ef4444">
        <div class="stat-label">Vencidas</div>
        <div class="stat-value" style="color:#ef4444" id="count-vencidas">0</div>
    </div>
    <div class="stat-card" style="border-left-color:#22c55e">
        <div class="stat-label">Total</div>
        <div class="stat-value" style="color:#22c55e" id="count-total">0</div>
    </div>
</div>

<!-- Main container -->
<div class="tz-container">
    <div id="membresias-container" style="padding:1.5rem">
        <div style="text-align:center;padding:4rem 1rem">
            <div style="width:2.5rem;height:2.5rem;border:3px solid rgba(34,197,94,0.2);border-top-color:#22c55e;border-radius:50%;margin:0 auto .75rem"></div>
            <p style="color:#6b7280;font-weight:700;font-size:.82rem;text-transform:uppercase;letter-spacing:.08em">Cargando membresías...</p>
        </div>
    </div>
    <div id="pagination" class="tz-pagination">
        <p style="font-size:.78rem;color:#6b7280;font-weight:600">
            Mostrando <span id="showing-start" style="color:#d1d5db;font-weight:900">0</span> –
            <span id="showing-end" style="color:#d1d5db;font-weight:900">0</span> de
            <span id="showing-total" style="color:#d1d5db;font-weight:900">0</span>
        </p>
        <div style="display:flex;gap:.35rem;flex-wrap:wrap" id="pagination-buttons"></div>
    </div>
</div>

<!-- Modal de Renovación -->
<div id="modalRenovar" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="modal-inner">
        <div class="modal-header-tz">
            <h3>Renovar Membresía</h3>
            <button onclick="cerrarModalRenovar()" class="modal-close">
                <i data-lucide="x" style="width:1.1rem;height:1.1rem"></i>
            </button>
        </div>
        <div class="modal-body-tz space-y-4">

            <div>
                <span class="tz-label-sm">Cliente</span>
                <p style="font-weight:900;color:#f9fafb;font-size:1rem" id="modal-cliente">—</p>
            </div>

            <!-- Opciones de fecha -->
            <div style="padding:1rem;background:rgba(59,130,246,0.05);border:1px solid rgba(59,130,246,0.15);border-radius:.75rem">
                <p style="font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#60a5fa;margin-bottom:.75rem;display:flex;align-items:center;gap:.4rem">
                    <i data-lucide="calendar" style="width:.9rem;height:.9rem"></i>
                    ¿Desde cuándo renovar?
                </p>
                <div style="display:flex;flex-direction:column;gap:.5rem">
                    <label class="radio-option">
                        <input type="radio" name="fecha-renovacion" value="vencimiento" checked onchange="actualizarVistaPrevia()" />
                        <div>
                            <div class="radio-option-label">Desde fecha de vencimiento</div>
                            <div class="radio-option-desc">Mantiene la continuidad de la membresía</div>
                            <div class="info-mini info-mini-blue">
                                Vencimiento actual: <strong id="fecha-vencimiento-actual">—</strong>
                            </div>
                        </div>
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="fecha-renovacion" value="hoy" onchange="actualizarVistaPrevia()" />
                        <div>
                            <div class="radio-option-label">Desde hoy</div>
                            <div class="radio-option-desc">Reinicia el conteo desde la fecha actual</div>
                            <div class="info-mini info-mini-green">
                                Hoy: <strong id="fecha-hoy">—</strong>
                            </div>
                        </div>
                    </label>
                </div>

                <div class="preview-box" style="margin-top:.75rem">
                    <div class="preview-title">Vista Previa</div>
                    <div class="preview-date">Nueva venc.: <span id="preview-fecha-vencimiento">—</span></div>
                    <div class="preview-dur" id="preview-duracion">—</div>
                </div>
            </div>

            <div>
                <label class="tz-label-sm">Plan</label>
                <select id="select-plan" onchange="cambiarPlan()" class="tz-select"></select>
            </div>

            <div>
                <span class="tz-label-sm">Precio del Plan</span>
                <p style="font-size:1.4rem;font-weight:900;color:#22c55e" id="modal-precio">$0.00</p>
            </div>

            <div id="deuda-info" class="hidden deuda-box">
                <span class="tz-label-sm" style="color:#f59e0b">Deuda Pendiente</span>
                <p style="font-size:1.25rem;font-weight:900;color:#f59e0b" id="modal-deuda">$0.00</p>
                <p style="font-size:.72rem;color:#d97706;font-weight:600;margin-top:.25rem">El pago se aplicará primero a la deuda existente</p>
            </div>

            <div>
                <label class="tz-label-sm">Monto a Pagar</label>
                <input type="number" id="input-monto" step="0.01" min="0.01" class="tz-input" />
            </div>

            <div>
                <label class="tz-label-sm">Método de Pago</label>
                <select id="input-metodo" class="tz-select">
                    <option value="efectivo">Efectivo</option>
                    <option value="tarjeta">Tarjeta</option>
                    <option value="transferencia">Transferencia</option>
                </select>
            </div>

            <div style="display:flex;gap:.65rem;padding-top:.75rem;border-top:1px solid rgba(34,197,94,0.1)">
                <button onclick="cerrarModalRenovar()" class="btn-cancel-modal">Cancelar</button>
                <button onclick="confirmarRenovacion()" class="btn-confirm">Confirmar Renovación</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let membresiasData = [];
        let membresiasFiltradas = [];
        let planesData = [];
        let filtroEstado = 'todas';
        let filtroPlan = null;
        let membresiaSeleccionada = null;
        let deudaPendiente = null;
        let paginaActual = 1;
        let itemsPorPagina = 10;

        function parsearFechaUTC(fechaStr) {
            if (!fechaStr) return null;
            const fecha = fechaStr.split('T')[0];
            const [year, month, day] = fecha.split('-').map(Number);
            return new Date(year, month - 1, day);
        }

        async function loadMembresias() {
            try {
                const response = await fetch(`${API_URL}/Membresias`);
                if (!response.ok) throw new Error('Error en la respuesta');
                membresiasData = await response.json();
                calcularEstadisticas();
                filtrarMembresias();
            } catch (error) {
                document.getElementById('membresias-container').innerHTML = `
                    <div style="text-align:center;padding:3rem">
                        <i data-lucide="alert-circle" style="width:2.5rem;height:2.5rem;display:block;margin:0 auto .75rem;color:#ef4444"></i>
                        <p style="color:#ef4444;font-weight:800;font-size:.9rem;text-transform:uppercase">Error al cargar las membresías</p>
                        <button onclick="loadMembresias()" style="margin-top:.75rem;padding:.5rem 1.25rem;border-radius:.55rem;background:linear-gradient(135deg,#22c55e,#15803d);color:#fff;font-weight:800;font-size:.78rem;border:none;cursor:pointer;text-transform:uppercase">
                            Reintentar
                        </button>
                    </div>`;
                lucide.createIcons();
            }
        }

        async function loadPlanes() {
            try {
                const response = await fetch(`${API_URL}/Planes`);
                planesData = await response.json();
                const container = document.getElementById('planesFilters');
                container.innerHTML = planesData.map(p => `
                    <button onclick="filterByPlan('${p.id || p.Id}')"
                            class="plan-filter-btn" data-plan="${p.id || p.Id}">
                        ${p.Nombre || p.nombre}
                    </button>`).join('');
            } catch (error) {
                console.error('Error cargando planes:', error);
            }
        }

        function calcularEstadisticas() {
            const hoy = new Date(); hoy.setHours(0,0,0,0);
            let activasReales = 0, vencidasReales = 0, porVencer = 0;
            membresiasData.forEach(m => {
                const estado = (m.estado || m.Estado).toLowerCase();
                const fechaVenc = parsearFechaUTC(m.fechaVencimiento || m.FechaVencimiento);
                fechaVenc.setHours(0,0,0,0);
                if (estado === 'activa' && fechaVenc >= hoy) {
                    activasReales++;
                    const diffDays = Math.ceil((fechaVenc - hoy) / (1000*60*60*24));
                    if (diffDays <= 7) porVencer++;
                } else if (estado === 'vencida' || (estado === 'activa' && fechaVenc < hoy)) {
                    vencidasReales++;
                }
            });
            document.getElementById('count-activas').textContent = activasReales;
            document.getElementById('count-por-vencer').textContent = porVencer;
            document.getElementById('count-vencidas').textContent = vencidasReales;
            document.getElementById('count-total').textContent = membresiasData.length;
        }

        function filtrarMembresias() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const hoy = new Date(); hoy.setHours(0,0,0,0);
            membresiasFiltradas = membresiasData.filter(m => {
                const estado = (m.estado || m.Estado).toLowerCase();
                const fechaVenc = parsearFechaUTC(m.fechaVencimiento || m.FechaVencimiento);
                fechaVenc.setHours(0,0,0,0);
                let pasaEstado = filtroEstado === 'todas';
                if (!pasaEstado) {
                    if (filtroEstado === 'activa')        pasaEstado = estado === 'activa' && fechaVenc >= hoy;
                    else if (filtroEstado === 'vencida')  pasaEstado = estado === 'vencida' || (estado === 'activa' && fechaVenc < hoy);
                    else                                  pasaEstado = estado === filtroEstado;
                }
                const pasaPlan = !filtroPlan || (m.planId || m.PlanId) === filtroPlan;
                const cliente = m.cliente || m.Cliente;
                const nombreCompleto = cliente ? `${cliente.nombre || cliente.Nombre} ${cliente.apellido || cliente.Apellido}`.toLowerCase() : '';
                const pasaBusqueda = !searchTerm || nombreCompleto.includes(searchTerm);
                return pasaEstado && pasaPlan && pasaBusqueda;
            });
            paginaActual = 1;
            renderMembresias();
        }

        function renderMembresias() {
            const inicio = (paginaActual - 1) * itemsPorPagina;
            const fin = inicio + itemsPorPagina;
            const pagina = membresiasFiltradas.slice(inicio, fin);

            if (pagina.length === 0) {
                document.getElementById('membresias-container').innerHTML = `
                    <div style="text-align:center;padding:3.5rem">
                        <i data-lucide="inbox" style="width:3rem;height:3rem;display:block;margin:0 auto .75rem;color:#374151"></i>
                        <p style="color:#6b7280;font-weight:700;font-size:.9rem;text-transform:uppercase">No se encontraron membresías</p>
                    </div>`;
                lucide.createIcons();
                return;
            }

            document.getElementById('membresias-container').innerHTML =
                `<div>${pagina.map(m => renderMembresiaCard(m)).join('')}</div>`;
            renderPaginacion();
            lucide.createIcons();
        }

        function renderMembresiaCard(m) {
            const hoy = new Date(); hoy.setHours(0,0,0,0);
            const fechaInicio = parsearFechaUTC(m.fechaInicio || m.FechaInicio);
            const fechaVenc   = parsearFechaUTC(m.fechaVencimiento || m.FechaVencimiento);
            fechaVenc.setHours(0,0,0,0);
            const diasRestantes = Math.ceil((fechaVenc - hoy) / (1000*60*60*24));
            const estado = (m.estado || m.Estado).toLowerCase();

            let badge = '', diasHtml = '', mostrarRenovar = false;

            if (estado === 'activa' && fechaVenc >= hoy) {
                if (diasRestantes === 0) {
                    badge = `<span class="badge badge-danger">Vence HOY</span>`;
                    diasHtml = `<span style="color:#ef4444;font-weight:900">¡HOY!</span>`;
                    mostrarRenovar = true;
                } else if (diasRestantes <= 3) {
                    badge = `<span class="badge badge-danger">Vence pronto</span>`;
                    diasHtml = `<span style="color:#ef4444;font-weight:900">${diasRestantes}d</span>`;
                    mostrarRenovar = true;
                } else if (diasRestantes <= 7) {
                    badge = `<span class="badge badge-warn">Por vencer</span>`;
                    diasHtml = `<span style="color:#f59e0b;font-weight:900">${diasRestantes}d</span>`;
                    mostrarRenovar = true;
                } else {
                    badge = `<span class="badge badge-active">Activa</span>`;
                    diasHtml = `<span style="color:#10b981;font-weight:900">${diasRestantes}d</span>`;
                }
            } else if (estado === 'vencida' || (estado === 'activa' && fechaVenc < hoy)) {
                badge = `<span class="badge badge-danger">Vencida</span>`;
                diasHtml = `<span style="color:#ef4444;font-weight:800">Vencida</span>`;
                mostrarRenovar = true;
            } else if (estado === 'suspendida') {
                badge = `<span class="badge badge-gray">Suspendida</span>`;
                diasHtml = `<span style="color:#6b7280">—</span>`;
            }

            const cliente    = m.cliente || m.Cliente;
            const plan       = m.plan    || m.Plan;
            const clienteNombre = cliente ? `${cliente.nombre || cliente.Nombre} ${cliente.apellido || cliente.Apellido}` : 'N/D';
            const planNombre    = plan   ? (plan.nombre || plan.Nombre) : 'N/D';
            const planTipo      = plan   ? (plan.tipo   || plan.Tipo   || '') : '';
            const planColor     = plan   ? (plan.color  || plan.Color  || '#22c55e') : '#22c55e';
            const planPrecio    = plan   ? (plan.precio || plan.Precio || 0) : 0;

            return `
                <div class="mem-card" style="border-left-color:${planColor}">
                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem">
                        <div style="flex:1;min-width:0">
                            <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:.75rem">
                                <h3 style="font-weight:900;color:#f9fafb;font-size:1rem;text-transform:uppercase">${clienteNombre}</h3>
                                ${badge}
                                ${planTipo ? `<span class="badge badge-plan">${planTipo}</span>` : ''}
                            </div>
                            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(7rem,1fr));gap:.65rem">
                                <div><div class="mem-label">Plan</div><div class="mem-value">${planNombre}</div></div>
                                <div><div class="mem-label">Inicio</div><div class="mem-value">${fechaInicio.toLocaleDateString('es-ES')}</div></div>
                                <div><div class="mem-label">Vencimiento</div><div class="mem-value">${fechaVenc.toLocaleDateString('es-ES')}</div></div>
                                <div><div class="mem-label">Días rest.</div><div class="mem-value">${diasHtml}</div></div>
                                <div><div class="mem-label">Monto</div><div class="mem-value" style="color:#22c55e">$${m.montoPagado || m.MontoPagado}</div></div>
                            </div>
                        </div>
                        <div style="display:flex;align-items:center;gap:.35rem;flex-shrink:0">
                            ${mostrarRenovar ? `
                                <button onclick="abrirModalRenovar('${m.id || m.Id}','${clienteNombre}','${planNombre}',${planPrecio})" class="btn-renovar">
                                    <i data-lucide="refresh-cw" style="width:.8rem;height:.8rem"></i> Renovar
                                </button>` : ''}
                            <a href="/membresias/editar/${m.id || m.Id}" class="act-btn act-btn-amber" title="Editar">
                                <i data-lucide="edit" style="width:1.1rem;height:1.1rem"></i>
                            </a>
                            <button onclick="eliminarMembresia('${m.id || m.Id}','${clienteNombre}')" class="act-btn act-btn-red" title="Eliminar">
                                <i data-lucide="trash-2" style="width:1.1rem;height:1.1rem"></i>
                            </button>
                        </div>
                    </div>
                </div>`;
        }

        function renderPaginacion() {
            const totalPaginas = Math.ceil(membresiasFiltradas.length / itemsPorPagina);
            const inicio = (paginaActual - 1) * itemsPorPagina + 1;
            const fin = Math.min(inicio + itemsPorPagina - 1, membresiasFiltradas.length);
            document.getElementById('showing-start').textContent = inicio;
            document.getElementById('showing-end').textContent   = fin;
            document.getElementById('showing-total').textContent = membresiasFiltradas.length;

            let html = '';
            if (paginaActual > 1)
                html += `<button onclick="cambiarPagina(${paginaActual-1})" class="page-btn">Ant.</button>`;
            for (let i = 1; i <= totalPaginas; i++) {
                if (i === 1 || i === totalPaginas || (i >= paginaActual-2 && i <= paginaActual+2))
                    html += `<button onclick="cambiarPagina(${i})" class="page-btn ${i===paginaActual?'active':''}">${i}</button>`;
                else if (i === paginaActual-3 || i === paginaActual+3)
                    html += `<span style="padding:0 .3rem;color:#4b5563">…</span>`;
            }
            if (paginaActual < totalPaginas)
                html += `<button onclick="cambiarPagina(${paginaActual+1})" class="page-btn">Sig.</button>`;
            document.getElementById('pagination-buttons').innerHTML = html;
        }

        function cambiarPagina(p) {
            paginaActual = p;
            renderMembresias();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function filterByEstado(estado) {
            filtroEstado = estado;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.estado === estado);
            });
            filtrarMembresias();
        }

        function filterByPlan(planId) {
            filtroPlan = planId;
            document.querySelectorAll('.plan-filter-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.plan === (planId || 'todos'));
            });
            filtrarMembresias();
        }

        function formatearFecha(fecha) {
            return fecha.toLocaleDateString('es-ES', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
        }

        function calcularFechaVencimiento(fechaInicio, plan) {
            const inicio = new Date(fechaInicio);
            let venc = new Date(inicio);
            const tipo = (plan.tipoCalculoVencimiento || plan.TipoCalculoVencimiento || 'dias').toLowerCase();
            const cantidad = plan.cantidadUnidades || plan.CantidadUnidades || plan.duracionDias || plan.DuracionDias || 30;
            switch (tipo) {
                case 'meses':   venc.setMonth(venc.getMonth() + cantidad); break;
                case 'semanas': venc.setDate(venc.getDate() + cantidad * 7); break;
                case 'anios':   venc.setFullYear(venc.getFullYear() + cantidad); break;
                default:        venc.setDate(venc.getDate() + cantidad); break;
            }
            return venc;
        }

        function actualizarVistaPrevia() {
            if (!membresiaSeleccionada) return;
            const opcion = document.querySelector('input[name="fecha-renovacion"]:checked').value;
            const selectPlan = document.getElementById('select-plan');
            const plan = planesData.find(p => (p.id || p.Id) === selectPlan.value);
            if (!plan) return;
            const fechaInicio = opcion === 'vencimiento' ? new Date(membresiaSeleccionada.fechaVencimiento) : new Date();
            const fechaVenc = calcularFechaVencimiento(fechaInicio, plan);
            document.getElementById('preview-fecha-vencimiento').textContent = formatearFecha(fechaVenc);
            const tipo = (plan.tipoCalculoVencimiento || plan.TipoCalculoVencimiento || 'dias').toLowerCase();
            const cantidad = plan.cantidadUnidades || plan.CantidadUnidades || plan.duracionDias || plan.DuracionDias || 30;
            const durMap = { meses: `${cantidad} ${cantidad===1?'mes':'meses'}`, semanas: `${cantidad} ${cantidad===1?'semana':'semanas'}`, anios: `${cantidad} ${cantidad===1?'año':'años'}` };
            document.getElementById('preview-duracion').textContent = `Duración: ${durMap[tipo] || `${cantidad} días`}`;
        }

        async function abrirModalRenovar(id, clienteNombre, planNombre, precioPlan) {
            membresiaSeleccionada = { id, clienteNombre, planNombre, precioPlan };
            const membresia = membresiasData.find(m => (m.id || m.Id) === id);
            if (!membresia) { alert('No se pudo cargar la información'); return; }
            membresiaSeleccionada.fechaVencimiento = new Date(membresia.fechaVencimiento || membresia.FechaVencimiento);
            membresiaSeleccionada.fechaInicio = new Date(membresia.fechaInicio || membresia.FechaInicio);

            const selectPlan = document.getElementById('select-plan');
            selectPlan.innerHTML = planesData.map(p => {
                const pId = p.id || p.Id, nombre = p.nombre || p.Nombre, precio = p.precio || p.Precio;
                return `<option value="${pId}" data-precio="${precio}" ${nombre===planNombre?'selected':''}>${nombre} - $${precio}</option>`;
            }).join('');

            const hoy = new Date();
            document.getElementById('fecha-hoy').textContent = formatearFecha(hoy);
            document.getElementById('fecha-vencimiento-actual').textContent = formatearFecha(membresiaSeleccionada.fechaVencimiento);

            deudaPendiente = null;
            try {
                const clienteId = membresia.clienteId || membresia.ClienteId;
                const resp = await fetch(`${API_URL}/DeudasClientes/cliente/${clienteId}`);
                if (resp.ok) {
                    const deudas = await resp.json();
                    deudaPendiente = deudas.find(d => (d.estado || d.Estado) === 'pendiente');
                    if (deudaPendiente) {
                        const saldo = deudaPendiente.saldo || deudaPendiente.Saldo;
                        const planActual = planesData.find(p => (p.id || p.Id) === selectPlan.value);
                        const precioActual = planActual ? (planActual.precio || planActual.Precio) : precioPlan;
                        document.getElementById('deuda-info').classList.remove('hidden');
                        document.getElementById('modal-deuda').textContent = `$${saldo.toFixed(2)}`;
                        document.getElementById('input-monto').value = (saldo + precioActual).toFixed(2);
                    } else {
                        document.getElementById('deuda-info').classList.add('hidden');
                        document.getElementById('input-monto').value = precioPlan.toFixed(2);
                    }
                } else {
                    document.getElementById('deuda-info').classList.add('hidden');
                    document.getElementById('input-monto').value = precioPlan.toFixed(2);
                }
            } catch { document.getElementById('deuda-info').classList.add('hidden'); document.getElementById('input-monto').value = precioPlan.toFixed(2); }

            document.getElementById('modal-cliente').textContent = clienteNombre;
            const planSel = selectPlan.options[selectPlan.selectedIndex];
            document.getElementById('modal-precio').textContent = `$${parseFloat(planSel.dataset.precio).toFixed(2)}`;
            actualizarVistaPrevia();
            document.getElementById('modalRenovar').classList.remove('hidden');
            lucide.createIcons();
        }

        function cambiarPlan() {
            const selectPlan = document.getElementById('select-plan');
            const opt = selectPlan.options[selectPlan.selectedIndex];
            const nuevoPrecio = parseFloat(opt.dataset.precio);
            document.getElementById('modal-precio').textContent = `$${nuevoPrecio.toFixed(2)}`;
            if (deudaPendiente) {
                const saldo = deudaPendiente.saldo || deudaPendiente.Saldo;
                document.getElementById('input-monto').value = (saldo + nuevoPrecio).toFixed(2);
            } else {
                document.getElementById('input-monto').value = nuevoPrecio.toFixed(2);
            }
            actualizarVistaPrevia();
        }

        function cerrarModalRenovar() {
            document.getElementById('modalRenovar').classList.add('hidden');
            membresiaSeleccionada = null; deudaPendiente = null;
        }

        async function confirmarRenovacion() {
            const monto = parseFloat(document.getElementById('input-monto').value);
            const metodo = document.getElementById('input-metodo').value;
            const planId = document.getElementById('select-plan').value;
            const opcionFecha = document.querySelector('input[name="fecha-renovacion"]:checked').value;
            if (isNaN(monto) || monto <= 0) { alert('Monto inválido'); return; }
            try {
                const body = { montoPagado: monto, metodoPago: metodo, notas: '', usuarioId: null, renovarDesdeHoy: opcionFecha === 'hoy' };
                const membresia = membresiasData.find(m => (m.id || m.Id) === membresiaSeleccionada.id);
                if (planId !== (membresia.planId || membresia.PlanId)) body.planId = planId;
                const resp = await fetch(`${API_URL}/Membresias/renovar/${membresiaSeleccionada.id}`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
                });
                const result = await resp.json();
                if (result.success) { alert(`✅ ${result.message}`); cerrarModalRenovar(); loadMembresias(); }
                else alert(`❌ Error: ${result.message}`);
            } catch (error) { alert('❌ Error al renovar la membresía'); }
        }

        async function eliminarMembresia(id, clienteNombre) {
            if (!confirm(`¿Eliminar la membresía de ${clienteNombre}? Esta acción no se puede deshacer.`)) return;
            try {
                const resp = await fetch(`/api/Membresias/${id}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
                if (resp.ok || resp.status === 204) { alert('✅ Membresía eliminada'); loadMembresias(); }
                else alert('❌ Error: ' + await resp.text());
            } catch (error) { alert('❌ Error al eliminar la membresía'); }
        }

        window.addEventListener('load', function () {
            loadPlanes(); loadMembresias(); filterByEstado('todas');
        });
    </script>
}

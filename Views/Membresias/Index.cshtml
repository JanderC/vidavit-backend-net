@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Membresías";
    ViewData["Subtitle"] = "Gestión de membresías - Power Fitness";
}

<style>
    :root {
        --pf-blue:   #3B82F6; --pf-blueB: #60A5FA; --pf-deep:   #1E3A8A;
        --pf-purple: #7C3AED; --pf-dark:  #060B18; --pf-card:   #0D1526;
        --pf-border: #1E2D4A; --pf-text:  #E2E8F0; --pf-soft:   #94A3B8;
        --pf-muted:  #64748B; --pf-green: #10B981; --pf-red:    #EF4444;
        --pf-orange: #F59E0B;
    }

    /* Botones de filtro */
    .filter-btn {
        padding: .6rem 1.25rem;
        background: rgba(255,255,255,.05);
        border: 1px solid var(--pf-border);
        color: var(--pf-soft);
        border-radius: .75rem;
        font-weight: 800;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        cursor: pointer;
        font-family: inherit;
        transition: background .2s, border-color .2s, color .2s;
    }
    .filter-btn:hover { background: rgba(59,130,246,.1); border-color: var(--pf-blue); color: var(--pf-blueB); }
    .filter-btn.active-filter {
        background: linear-gradient(135deg, var(--pf-blue), var(--pf-purple));
        border-color: transparent;
        color: #fff;
        box-shadow: 0 4px 14px rgba(59,130,246,.35);
    }

    /* Botones de plan */
    .plan-filter-btn {
        padding: .4rem 1rem;
        background: rgba(255,255,255,.05);
        border: 1px solid var(--pf-border);
        color: var(--pf-soft);
        border-radius: .625rem;
        font-weight: 700;
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        cursor: pointer;
        font-family: inherit;
        transition: background .2s, border-color .2s, color .2s;
    }
    .plan-filter-btn:hover { background: rgba(59,130,246,.08); border-color: rgba(59,130,246,.3); color: var(--pf-blueB); }
    .plan-filter-btn.active-plan {
        background: linear-gradient(135deg, var(--pf-blue), var(--pf-purple));
        border-color: transparent;
        color: #fff;
    }

    /* Inputs */
    .pf-input {
        padding: .7rem 1rem;
        border: 2px solid var(--pf-border);
        border-radius: .75rem;
        background: rgba(255,255,255,.03);
        color: var(--pf-text);
        font-weight: 600;
        font-family: inherit;
        font-size: .9rem;
        outline: none;
        transition: border-color .2s;
    }
    .pf-input:focus { border-color: var(--pf-blue); }
    .pf-input::placeholder { color: var(--pf-muted); }
    .pf-select {
        padding: .7rem 1rem;
        border: 2px solid var(--pf-border);
        border-radius: .75rem;
        background: var(--pf-card);
        color: var(--pf-text);
        font-weight: 600;
        font-family: inherit;
        font-size: .9rem;
        outline: none;
        transition: border-color .2s;
    }
    .pf-select:focus { border-color: var(--pf-blue); }

    /* Modal */
    #modalRenovar {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(6,11,24,.8);
        backdrop-filter: blur(6px);
        z-index: 50;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    #modalRenovar.flex { display: flex; }

    .modal-renovar-card {
        background: var(--pf-card);
        border: 1px solid var(--pf-border);
        border-radius: 1.25rem;
        width: 100%;
        max-width: 680px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 25px 60px rgba(0,0,0,.6);
    }

    .modal-header-renovar {
        background: linear-gradient(135deg, var(--pf-deep), var(--pf-purple));
        padding: 1.25rem 1.5rem;
        border-radius: 1.25rem 1.25rem 0 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid rgba(96,165,250,.2);
    }

    .pf-radio-option {
        display: flex;
        align-items: flex-start;
        gap: .875rem;
        padding: 1rem 1.25rem;
        background: rgba(255,255,255,.03);
        border: 1px solid var(--pf-border);
        border-radius: .875rem;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        margin-bottom: .6rem;
    }
    .pf-radio-option:hover { border-color: var(--pf-blue); background: rgba(59,130,246,.05); }
    .pf-radio-option input[type="radio"] { accent-color: var(--pf-blue); width: 18px; height: 18px; flex-shrink: 0; margin-top: .15rem; }

    /* Tarjeta de membresía */
    .pf-membresia-card {
        background: var(--pf-card);
        border: 1px solid var(--pf-border);
        border-radius: 1rem;
        padding: 1.25rem 1.5rem;
        transition: box-shadow .2s, border-color .2s;
        position: relative;
        overflow: hidden;
    }
    .pf-membresia-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,.35); }
</style>

<!-- Filtros de estado -->
<div style="margin-bottom:1.5rem;">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:.875rem; flex-wrap:wrap; gap:.75rem;">
        <div style="display:flex; gap:.5rem; flex-wrap:wrap;">
            <button onclick="filterByEstado('todas')"    class="filter-btn" data-estado="todas">Todas</button>
            <button onclick="filterByEstado('activa')"   class="filter-btn" data-estado="activa">Activas</button>
            <button onclick="filterByEstado('vencida')"  class="filter-btn" data-estado="vencida">Vencidas</button>
            <button onclick="filterByEstado('suspendida')" class="filter-btn" data-estado="suspendida">Suspendidas</button>
        </div>
        <a href="/membresias/crear"
           style="display:inline-flex; align-items:center; gap:.5rem; padding:.7rem 1.75rem; background:linear-gradient(135deg,#3B82F6,#7C3AED); color:#fff; font-weight:800; border-radius:.875rem; text-decoration:none; text-transform:uppercase; letter-spacing:.06em; font-size:.85rem; box-shadow:0 4px 20px rgba(59,130,246,.3); transition:transform .2s, box-shadow .2s;"
           onmouseover="this.style.transform='scale(1.03)';this.style.boxShadow='0 8px 28px rgba(59,130,246,.45)'" onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 20px rgba(59,130,246,.3)'">
            <i data-lucide="plus" style="width:18px;height:18px;"></i>
            Nueva Membresía
        </a>
    </div>

    <!-- Búsqueda -->
    <div style="background:var(--pf-card); border:1px solid var(--pf-border); border-radius:1rem; padding:1rem 1.25rem; margin-bottom:.75rem; display:flex; align-items:center; gap:.75rem;">
        <i data-lucide="search" style="width:18px;height:18px;color:var(--pf-muted);flex-shrink:0;"></i>
        <input type="text" id="searchInput" placeholder="Buscar por nombre de cliente..."
               class="pf-input" style="flex:1; border:none; background:transparent; padding:.25rem 0;"
               onkeyup="filtrarMembresias()">
    </div>

    <!-- Filtro por plan -->
    <div style="background:var(--pf-card); border:1px solid var(--pf-border); border-radius:1rem; padding:.875rem 1.25rem; display:flex; align-items:center; gap:.75rem; flex-wrap:wrap;">
        <span style="font-size:.72rem; font-weight:800; color:var(--pf-soft); text-transform:uppercase; letter-spacing:.1em; flex-shrink:0;">Plan:</span>
        <button onclick="filterByPlan(null)" class="plan-filter-btn active-plan" data-plan="todos">Todos</button>
        <div id="planesFilters" style="display:flex; gap:.5rem; flex-wrap:wrap;"></div>
    </div>
</div>

<!-- Stats -->
<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-bottom:1.5rem;">
    <div style="background:var(--pf-card); border:1px solid var(--pf-border); border-left:4px solid var(--pf-green); border-radius:.875rem; padding:1.25rem;">
        <p style="font-size:.7rem; color:var(--pf-muted); font-weight:800; text-transform:uppercase; letter-spacing:.1em; margin-bottom:.5rem;">Activas</p>
        <p style="font-size:2.25rem; font-weight:900; color:var(--pf-green); margin:0;" id="count-activas">0</p>
    </div>
    <div style="background:var(--pf-card); border:1px solid var(--pf-border); border-left:4px solid var(--pf-orange); border-radius:.875rem; padding:1.25rem;">
        <p style="font-size:.7rem; color:var(--pf-muted); font-weight:800; text-transform:uppercase; letter-spacing:.1em; margin-bottom:.5rem;">Por Vencer (7d)</p>
        <p style="font-size:2.25rem; font-weight:900; color:var(--pf-orange); margin:0;" id="count-por-vencer">0</p>
    </div>
    <div style="background:var(--pf-card); border:1px solid var(--pf-border); border-left:4px solid var(--pf-red); border-radius:.875rem; padding:1.25rem;">
        <p style="font-size:.7rem; color:var(--pf-muted); font-weight:800; text-transform:uppercase; letter-spacing:.1em; margin-bottom:.5rem;">Vencidas</p>
        <p style="font-size:2.25rem; font-weight:900; color:var(--pf-red); margin:0;" id="count-vencidas">0</p>
    </div>
    <div style="background:var(--pf-card); border:1px solid var(--pf-border); border-left:4px solid var(--pf-blue); border-radius:.875rem; padding:1.25rem;">
        <p style="font-size:.7rem; color:var(--pf-muted); font-weight:800; text-transform:uppercase; letter-spacing:.1em; margin-bottom:.5rem;">Total</p>
        <p style="font-size:2.25rem; font-weight:900; color:var(--pf-blueB); margin:0;" id="count-total">0</p>
    </div>
</div>

<!-- Contenedor membresías -->
<div style="background:var(--pf-card); border:1px solid var(--pf-border); border-radius:1rem; overflow:hidden;">
    <div id="membresias-container" style="padding:1.25rem;">
        <div style="display:flex;align-items:center;justify-content:center;height:12rem;text-align:center;">
            <div>
                <div style="width:48px;height:48px;border:4px solid rgba(59,130,246,.15);border-top-color:#3B82F6;border-radius:50%;margin:0 auto 1rem;"></div>
                <p style="color:var(--pf-muted);font-weight:700;">Cargando membresías...</p>
            </div>
        </div>
    </div>
    <!-- Paginación -->
    <div id="pagination" style="display:flex;align-items:center;justify-content:space-between;padding:.875rem 1.5rem;border-top:1px solid var(--pf-border);">
        <div style="font-size:.8rem;color:var(--pf-soft);font-weight:600;">
            Mostrando <span id="showing-start">0</span> - <span id="showing-end">0</span> de <span id="showing-total">0</span>
        </div>
        <div style="display:flex;gap:.4rem;" id="pagination-buttons"></div>
    </div>
</div>

<!-- Modal Renovar -->
<div id="modalRenovar">
    <div class="modal-renovar-card">
        <div class="modal-header-renovar">
            <h3 style="font-size:1.1rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.08em;margin:0;">Renovar Membresía</h3>
            <button onclick="cerrarModalRenovar()" style="background:transparent;border:none;cursor:pointer;color:rgba(255,255,255,.7);padding:.25rem;">
                <i data-lucide="x" style="width:22px;height:22px;"></i>
            </button>
        </div>

        <div style="padding:1.5rem;">
            <div style="margin-bottom:1rem;">
                <p style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.25rem;">Cliente</p>
                <p style="font-size:1.1rem;font-weight:900;color:var(--pf-text);margin:0;" id="modal-cliente">-</p>
            </div>

            <!-- Opciones de fecha -->
            <div style="margin-bottom:1.25rem;padding:1.1rem;background:rgba(59,130,246,.06);border:1px solid rgba(59,130,246,.2);border-radius:.875rem;">
                <p style="font-size:.75rem;font-weight:800;color:var(--pf-blueB);text-transform:uppercase;letter-spacing:.1em;margin:0 0 .875rem 0;display:flex;align-items:center;gap:.4rem;">
                    <i data-lucide="calendar" style="width:16px;height:16px;"></i>
                    ¿Desde cuándo renovar?
                </p>

                <label class="pf-radio-option">
                    <input type="radio" name="fecha-renovacion" value="vencimiento" checked onchange="actualizarVistaPrevia()">
                    <div style="flex:1;">
                        <p style="font-weight:800;color:var(--pf-text);margin:0 0 .2rem 0;font-size:.9rem;">Desde fecha de vencimiento</p>
                        <p style="font-size:.78rem;color:var(--pf-soft);margin:0 0 .5rem 0;">Mantiene continuidad de la membresía</p>
                        <div style="background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.2);border-radius:.5rem;padding:.4rem .875rem;">
                            <p style="font-size:.72rem;font-weight:700;color:var(--pf-blueB);margin:0;">📅 Vencimiento actual: <span id="fecha-vencimiento-actual" style="font-weight:900;">-</span></p>
                        </div>
                    </div>
                </label>

                <label class="pf-radio-option">
                    <input type="radio" name="fecha-renovacion" value="hoy" onchange="actualizarVistaPrevia()">
                    <div style="flex:1;">
                        <p style="font-weight:800;color:var(--pf-text);margin:0 0 .2rem 0;font-size:.9rem;">Desde hoy</p>
                        <p style="font-size:.78rem;color:var(--pf-soft);margin:0 0 .5rem 0;">Reinicia el conteo desde la fecha actual</p>
                        <div style="background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.2);border-radius:.5rem;padding:.4rem .875rem;">
                            <p style="font-size:.72rem;font-weight:700;color:var(--pf-green);margin:0;">📅 Hoy: <span id="fecha-hoy" style="font-weight:900;">-</span></p>
                        </div>
                    </div>
                </label>

                <!-- Vista previa -->
                <div style="margin-top:.875rem;padding:.875rem 1rem;background:rgba(124,58,237,.08);border:1px solid rgba(124,58,237,.25);border-radius:.75rem;">
                    <div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.35rem;">
                        <i data-lucide="check-circle" style="width:16px;height:16px;color:#A78BFA;"></i>
                        <p style="font-size:.68rem;font-weight:800;color:#A78BFA;text-transform:uppercase;letter-spacing:.1em;margin:0;">Vista Previa</p>
                    </div>
                    <p style="font-size:.95rem;font-weight:800;color:var(--pf-text);margin:0 0 .2rem 0;">
                        Nueva fecha de vencimiento: <span id="preview-fecha-vencimiento" style="color:#A78BFA;">-</span>
                    </p>
                    <p style="font-size:.78rem;color:var(--pf-soft);margin:0;" id="preview-duracion">-</p>
                </div>
            </div>

            <!-- Plan -->
            <div style="margin-bottom:1rem;">
                <label style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:.5rem;">Plan</label>
                <select id="select-plan" onchange="cambiarPlan()" class="pf-select" style="width:100%;"></select>
            </div>

            <!-- Precio -->
            <div style="margin-bottom:1rem;">
                <p style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.25rem;">Precio del Plan</p>
                <p style="font-size:1.6rem;font-weight:900;color:var(--pf-blueB);margin:0;" id="modal-precio">$0.00</p>
            </div>

            <!-- Deuda -->
            <div id="deuda-info" class="hidden" style="margin-bottom:1rem;padding:1rem;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.3);border-radius:.75rem;">
                <p style="font-size:.7rem;color:var(--pf-orange);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.25rem;">Deuda Pendiente</p>
                <p style="font-size:1.4rem;font-weight:900;color:var(--pf-orange);margin:0 0 .35rem 0;" id="modal-deuda">$0.00</p>
                <p style="font-size:.75rem;color:var(--pf-soft);margin:0;">El pago se aplicará primero a la deuda existente</p>
            </div>

            <!-- Monto -->
            <div style="margin-bottom:1rem;">
                <label style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:.5rem;">Monto a Pagar</label>
                <input type="number" id="input-monto" step="0.01" min="0.01" class="pf-input" style="width:100%;box-sizing:border-box;font-size:1.1rem;">
            </div>

            <!-- Método -->
            <div style="margin-bottom:1.25rem;">
                <label style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:.5rem;">Método de Pago</label>
                <select id="input-metodo" class="pf-select" style="width:100%;">
                    <option value="efectivo">Efectivo</option>
                    <option value="tarjeta">Tarjeta</option>
                    <option value="transferencia">Transferencia</option>
                </select>
            </div>

            <!-- Botones modal -->
            <div style="display:flex;gap:.75rem;">
                <button onclick="cerrarModalRenovar()"
                        style="flex:1;padding:.875rem;background:rgba(255,255,255,.05);border:1px solid var(--pf-border);color:var(--pf-soft);border-radius:.875rem;font-weight:800;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;transition:background .2s;"
                        onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">
                    Cancelar
                </button>
                <button onclick="confirmarRenovacion()"
                        style="flex:1;padding:.875rem;background:linear-gradient(135deg,var(--pf-green),#065F46);color:#fff;border:none;border-radius:.875rem;font-weight:800;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;box-shadow:0 4px 16px rgba(16,185,129,.3);transition:transform .2s;"
                        onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                    Confirmar Renovación
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let membresiasData = [];
        let membresiasFiltradas = [];
        let planesData = [];
        let filtroEstado = 'todas';
        let filtroPlan = null;
        let membresiaSeleccionada = null;
        let deudaPendiente = null;
        let paginaActual = 1;
        let itemsPorPagina = 10;

        const PF = {
            blue:'#3B82F6', blueB:'#60A5FA', purple:'#7C3AED',
            green:'#10B981', orange:'#F59E0B', red:'#EF4444',
            text:'#E2E8F0', soft:'#94A3B8', muted:'#64748B',
            border:'#1E2D4A', card:'#0D1526'
        };

        function parsearFechaUTC(fechaStr) {
            if (!fechaStr) return null;
            const fecha = fechaStr.split('T')[0];
            const [year, month, day] = fecha.split('-').map(Number);
            return new Date(year, month - 1, day);
        }

        async function loadMembresias() {
            try {
                const response = await fetch(`${API_URL}/Membresias`);
                if (!response.ok) throw new Error('Error en la respuesta');
                membresiasData = await response.json();
                calcularEstadisticas();
                filtrarMembresias();
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('membresias-container').innerHTML = `
                    <div style="text-align:center;padding:3rem;color:${PF.red};">
                        <i data-lucide="alert-circle" style="width:48px;height:48px;display:block;margin:0 auto 1rem;"></i>
                        <p style="font-weight:800;font-size:1.1rem;text-transform:uppercase;margin:0 0 1rem 0;">Error al cargar las membresías</p>
                        <button onclick="loadMembresias()"
                                style="padding:.75rem 1.5rem;background:linear-gradient(135deg,${PF.blue},${PF.purple});color:#fff;border:none;border-radius:.875rem;font-weight:800;font-size:.85rem;text-transform:uppercase;cursor:pointer;font-family:inherit;">
                            Reintentar
                        </button>
                    </div>`;
                lucide.createIcons();
            }
        }

        async function loadPlanes() {
            try {
                const response = await fetch(`${API_URL}/Planes`);
                planesData = await response.json();
                const container = document.getElementById('planesFilters');
                container.innerHTML = planesData.map(p => `
                    <button onclick="filterByPlan('${p.id || p.Id}')"
                            class="plan-filter-btn" data-plan="${p.id || p.Id}">
                        ${p.Nombre || p.nombre}
                    </button>
                `).join('');
            } catch (error) { console.error('Error cargando planes:', error); }
        }

        function calcularEstadisticas() {
            const hoy = new Date(); hoy.setHours(0,0,0,0);
            let activas=0, vencidas=0, porVencer=0;
            membresiasData.forEach(m => {
                const estado = (m.estado || m.Estado).toLowerCase();
                const fechaVenc = parsearFechaUTC(m.fechaVencimiento || m.FechaVencimiento);
                fechaVenc.setHours(0,0,0,0);
                if (estado === 'activa' && fechaVenc >= hoy) {
                    activas++;
                    const dias = Math.ceil((fechaVenc - hoy) / (1000*60*60*24));
                    if (dias <= 7) porVencer++;
                } else if (estado === 'vencida' || (estado === 'activa' && fechaVenc < hoy)) { vencidas++; }
            });
            document.getElementById('count-activas').textContent    = activas;
            document.getElementById('count-por-vencer').textContent = porVencer;
            document.getElementById('count-vencidas').textContent   = vencidas;
            document.getElementById('count-total').textContent      = membresiasData.length;
        }

        function filtrarMembresias() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const hoy = new Date(); hoy.setHours(0,0,0,0);
            membresiasFiltradas = membresiasData.filter(m => {
                const estado = (m.estado || m.Estado).toLowerCase();
                const fechaVenc = parsearFechaUTC(m.fechaVencimiento || m.FechaVencimiento);
                fechaVenc.setHours(0,0,0,0);
                let pasaEstado = filtroEstado === 'todas';
                if (!pasaEstado) {
                    if (filtroEstado === 'activa')       pasaEstado = estado === 'activa' && fechaVenc >= hoy;
                    else if (filtroEstado === 'vencida') pasaEstado = estado === 'vencida' || (estado === 'activa' && fechaVenc < hoy);
                    else                                 pasaEstado = estado === filtroEstado;
                }
                const pasaPlan = !filtroPlan || (m.planId || m.PlanId) === filtroPlan;
                const cliente = m.cliente || m.Cliente;
                const nombreCompleto = cliente ? `${cliente.nombre || cliente.Nombre} ${cliente.apellido || cliente.Apellido}`.toLowerCase() : '';
                const pasaBusqueda = !searchTerm || nombreCompleto.includes(searchTerm);
                return pasaEstado && pasaPlan && pasaBusqueda;
            });
            paginaActual = 1;
            renderMembresias();
        }

        function renderMembresias() {
            const inicio = (paginaActual - 1) * itemsPorPagina;
            const fin = inicio + itemsPorPagina;
            const pagina = membresiasFiltradas.slice(inicio, fin);

            if (pagina.length === 0) {
                document.getElementById('membresias-container').innerHTML = `
                    <div style="text-align:center;padding:3rem;color:${PF.muted};">
                        <i data-lucide="inbox" style="width:48px;height:48px;display:block;margin:0 auto 1rem;"></i>
                        <p style="font-weight:800;font-size:1.1rem;text-transform:uppercase;margin:0;">No se encontraron membresías</p>
                    </div>`;
                lucide.createIcons();
                return;
            }

            document.getElementById('membresias-container').innerHTML =
                `<div style="display:flex;flex-direction:column;gap:.875rem;">${pagina.map(m => renderMembresiaCard(m)).join('')}</div>`;
            renderPaginacion();
            lucide.createIcons();
        }

        function renderMembresiaCard(m) {
            const hoy = new Date(); hoy.setHours(0,0,0,0);
            const fechaInicio = parsearFechaUTC(m.fechaInicio || m.FechaInicio);
            const fechaVenc   = parsearFechaUTC(m.fechaVencimiento || m.FechaVencimiento);
            fechaVenc.setHours(0,0,0,0);
            const diasRestantes = Math.ceil((fechaVenc - hoy) / (1000*60*60*24));
            const estado = (m.estado || m.Estado).toLowerCase();
            const cliente = m.cliente || m.Cliente;
            const plan    = m.plan    || m.Plan;
            const clienteNombre = cliente ? `${cliente.nombre || cliente.Nombre} ${cliente.apellido || cliente.Apellido}` : 'Cliente no disponible';
            const planNombre    = plan ? (plan.nombre || plan.Nombre) : 'Plan no disponible';
            const planTipo      = plan ? (plan.tipo   || plan.Tipo)   : '';
            const planColor     = plan ? (plan.color  || plan.Color   || PF.blue) : PF.blue;
            const planPrecio    = plan ? (plan.precio || plan.Precio) : 0;

            let badgeColor = PF.soft, badgeBg = 'rgba(100,116,139,.1)', badgeBorder = 'rgba(100,116,139,.2)', badgeText = estado;
            let diasHtml = `<span style="color:${PF.soft};font-weight:700;">-</span>`;
            let mostrarRenovar = false;

            if (estado === 'activa' && fechaVenc >= hoy) {
                if (diasRestantes === 0) {
                    badgeColor='#F87171'; badgeBg='rgba(239,68,68,.1)'; badgeBorder='rgba(239,68,68,.3)'; badgeText='Vence HOY';
                    diasHtml=`<span style="color:${PF.red};font-weight:900;">¡HOY!</span>`; mostrarRenovar=true;
                } else if (diasRestantes <= 3) {
                    badgeColor='#F87171'; badgeBg='rgba(239,68,68,.1)'; badgeBorder='rgba(239,68,68,.3)'; badgeText='Vence pronto';
                    diasHtml=`<span style="color:${PF.red};font-weight:900;">${diasRestantes}d</span>`; mostrarRenovar=true;
                } else if (diasRestantes <= 7) {
                    badgeColor=PF.orange; badgeBg='rgba(245,158,11,.1)'; badgeBorder='rgba(245,158,11,.3)'; badgeText='Por vencer';
                    diasHtml=`<span style="color:${PF.orange};font-weight:900;">${diasRestantes}d</span>`; mostrarRenovar=true;
                } else {
                    badgeColor=PF.green; badgeBg='rgba(16,185,129,.1)'; badgeBorder='rgba(16,185,129,.3)'; badgeText='Activa';
                    diasHtml=`<span style="color:${PF.green};font-weight:900;">${diasRestantes}d</span>`;
                }
            } else if (estado === 'vencida' || (estado === 'activa' && fechaVenc < hoy)) {
                badgeColor=PF.red; badgeBg='rgba(239,68,68,.1)'; badgeBorder='rgba(239,68,68,.3)'; badgeText='Vencida';
                diasHtml=`<span style="color:${PF.red};font-weight:900;">Vencida</span>`; mostrarRenovar=true;
            } else if (estado === 'suspendida') {
                badgeText='Suspendida';
            }

            return `
                <div class="pf-membresia-card" style="border-left:4px solid ${planColor};">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;">
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;align-items:center;gap:.625rem;margin-bottom:.875rem;flex-wrap:wrap;">
                                <h3 style="font-weight:900;color:${PF.text};font-size:1.05rem;text-transform:uppercase;margin:0;">${clienteNombre}</h3>
                                <span style="display:inline-flex;align-items:center;padding:.25rem .75rem;background:${badgeBg};color:${badgeColor};border:1px solid ${badgeBorder};border-radius:999px;font-size:.68rem;font-weight:800;text-transform:uppercase;">${badgeText}</span>
                                ${planTipo ? `<span style="display:inline-flex;padding:.2rem .625rem;background:rgba(59,130,246,.08);color:${PF.blueB};border:1px solid rgba(59,130,246,.2);border-radius:999px;font-size:.65rem;font-weight:700;text-transform:uppercase;">${planTipo}</span>` : ''}
                            </div>
                            <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:.75rem;">
                                <div>
                                    <p style="font-size:.65rem;color:${PF.muted};font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .25rem 0;">Plan</p>
                                    <p style="font-weight:800;color:${PF.text};font-size:.9rem;margin:0;">${planNombre}</p>
                                </div>
                                <div>
                                    <p style="font-size:.65rem;color:${PF.muted};font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .25rem 0;">Inicio</p>
                                    <p style="font-weight:800;color:${PF.text};font-size:.9rem;margin:0;">${fechaInicio.toLocaleDateString('es-ES')}</p>
                                </div>
                                <div>
                                    <p style="font-size:.65rem;color:${PF.muted};font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .25rem 0;">Vencimiento</p>
                                    <p style="font-weight:800;color:${PF.text};font-size:.9rem;margin:0;">${fechaVenc.toLocaleDateString('es-ES')}</p>
                                </div>
                                <div>
                                    <p style="font-size:.65rem;color:${PF.muted};font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .25rem 0;">Días rest.</p>
                                    <p style="font-size:.9rem;margin:0;">${diasHtml}</p>
                                </div>
                                <div>
                                    <p style="font-size:.65rem;color:${PF.muted};font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .25rem 0;">Monto</p>
                                    <p style="font-weight:900;color:${PF.green};font-size:.9rem;margin:0;">$${m.montoPagado || m.MontoPagado}</p>
                                </div>
                            </div>
                        </div>
                        <div style="display:flex;align-items:center;gap:.35rem;flex-shrink:0;">
                            ${mostrarRenovar ? `
                            <button onclick="abrirModalRenovar('${m.id || m.Id}', '${clienteNombre}', '${planNombre}', ${planPrecio})"
                                    style="display:inline-flex;align-items:center;gap:.35rem;padding:.5rem 1rem;background:linear-gradient(135deg,${PF.green},#065F46);color:#fff;border:none;border-radius:.75rem;font-weight:800;font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;box-shadow:0 3px 12px rgba(16,185,129,.3);">
                                <i data-lucide="refresh-cw" style="width:14px;height:14px;"></i>
                                Renovar
                            </button>` : ''}
                            <a href="/membresias/editar/${m.id || m.Id}" title="Editar"
                               style="padding:.45rem;color:${PF.orange};border-radius:.625rem;display:flex;transition:background .15s;"
                               onmouseover="this.style.background='rgba(245,158,11,.12)'" onmouseout="this.style.background='transparent'">
                                <i data-lucide="edit" style="width:20px;height:20px;"></i>
                            </a>
                            <button onclick="eliminarMembresia('${m.id || m.Id}', '${clienteNombre}')" title="Eliminar"
                                    style="padding:.45rem;color:${PF.red};border-radius:.625rem;background:transparent;border:none;cursor:pointer;display:flex;transition:background .15s;"
                                    onmouseover="this.style.background='rgba(239,68,68,.12)'" onmouseout="this.style.background='transparent'">
                                <i data-lucide="trash-2" style="width:20px;height:20px;"></i>
                            </button>
                        </div>
                    </div>
                </div>`;
        }

        function renderPaginacion() {
            const totalPaginas = Math.ceil(membresiasFiltradas.length / itemsPorPagina);
            const inicio = (paginaActual - 1) * itemsPorPagina + 1;
            const fin = Math.min(inicio + itemsPorPagina - 1, membresiasFiltradas.length);
            document.getElementById('showing-start').textContent = inicio;
            document.getElementById('showing-end').textContent   = fin;
            document.getElementById('showing-total').textContent = membresiasFiltradas.length;

            let html = '';
            if (paginaActual > 1) html += `<button onclick="cambiarPagina(${paginaActual-1})" style="padding:.45rem .875rem;background:rgba(255,255,255,.05);border:1px solid #1E2D4A;color:#94A3B8;border-radius:.625rem;font-weight:700;cursor:pointer;font-family:inherit;font-size:.8rem;">Anterior</button>`;
            for (let i=1; i<=totalPaginas; i++) {
                if (i===1||i===totalPaginas||(i>=paginaActual-2&&i<=paginaActual+2)) {
                    html += `<button onclick="cambiarPagina(${i})" style="width:34px;height:34px;border-radius:.5rem;border:1px solid ${i===paginaActual?PF.blue:'#1E2D4A'};background:${i===paginaActual?'linear-gradient(135deg,'+PF.blue+','+PF.purple+')':'transparent'};color:${i===paginaActual?'#fff':'#94A3B8'};font-weight:800;cursor:pointer;font-size:.8rem;font-family:inherit;">${i}</button>`;
                } else if (i===paginaActual-3||i===paginaActual+3) html += `<span style="color:#64748B;padding:0 .25rem;">…</span>`;
            }
            if (paginaActual < totalPaginas) html += `<button onclick="cambiarPagina(${paginaActual+1})" style="padding:.45rem .875rem;background:rgba(255,255,255,.05);border:1px solid #1E2D4A;color:#94A3B8;border-radius:.625rem;font-weight:700;cursor:pointer;font-family:inherit;font-size:.8rem;">Siguiente</button>`;
            document.getElementById('pagination-buttons').innerHTML = html;
        }

        function cambiarPagina(p) { paginaActual=p; renderMembresias(); window.scrollTo({top:0,behavior:'smooth'}); }

        function filterByEstado(estado) {
            filtroEstado = estado;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.toggle('active-filter', btn.dataset.estado === estado);
            });
            filtrarMembresias();
        }

        function filterByPlan(planId) {
            filtroPlan = planId;
            document.querySelectorAll('.plan-filter-btn').forEach(btn => {
                btn.classList.toggle('active-plan', btn.dataset.plan === (planId || 'todos'));
            });
            filtrarMembresias();
        }

        function formatearFecha(fecha) {
            return fecha.toLocaleDateString('es-ES', {weekday:'long',year:'numeric',month:'long',day:'numeric'});
        }

        function calcularFechaVencimiento(fechaInicio, plan) {
            const inicio = new Date(fechaInicio);
            let venc = new Date(inicio);
            const tipo = (plan.tipoCalculoVencimiento || plan.TipoCalculoVencimiento || 'dias').toLowerCase();
            const cant = plan.cantidadUnidades || plan.CantidadUnidades || plan.duracionDias || plan.DuracionDias || 30;
            switch (tipo) {
                case 'meses':   venc.setMonth(venc.getMonth() + cant); break;
                case 'semanas': venc.setDate(venc.getDate() + cant*7); break;
                case 'anios':   venc.setFullYear(venc.getFullYear() + cant); break;
                default:        venc.setDate(venc.getDate() + cant); break;
            }
            return venc;
        }

        function actualizarVistaPrevia() {
            if (!membresiaSeleccionada) return;
            const opcion = document.querySelector('input[name="fecha-renovacion"]:checked').value;
            const planId = document.getElementById('select-plan').value;
            const plan   = planesData.find(p => (p.id || p.Id) === planId);
            if (!plan) return;
            const fechaInicio = opcion === 'vencimiento' ? new Date(membresiaSeleccionada.fechaVencimiento) : new Date();
            const fechaVenc   = calcularFechaVencimiento(fechaInicio, plan);
            document.getElementById('preview-fecha-vencimiento').textContent = formatearFecha(fechaVenc);
            const tipo = (plan.tipoCalculoVencimiento || plan.TipoCalculoVencimiento || 'dias').toLowerCase();
            const cant = plan.cantidadUnidades || plan.CantidadUnidades || plan.duracionDias || plan.DuracionDias || 30;
            const unidades = {meses:`${cant} ${cant===1?'mes':'meses'}`, semanas:`${cant} ${cant===1?'semana':'semanas'}`, anios:`${cant} ${cant===1?'año':'años'}`};
            document.getElementById('preview-duracion').textContent = `Duración: ${unidades[tipo] || cant + ' días'}`;
        }

        async function abrirModalRenovar(id, clienteNombre, planNombre, precioPlan) {
            membresiaSeleccionada = { id, clienteNombre, planNombre, precioPlan };
            const membresia = membresiasData.find(m => (m.id || m.Id) === id);
            if (!membresia) { alert('❌ No se pudo cargar la información de la membresía'); return; }
            membresiaSeleccionada.fechaVencimiento = new Date(membresia.fechaVencimiento || membresia.FechaVencimiento);
            membresiaSeleccionada.fechaInicio      = new Date(membresia.fechaInicio      || membresia.FechaInicio);

            const selectPlan = document.getElementById('select-plan');
            selectPlan.innerHTML = planesData.map(p => {
                const pid = p.id || p.Id, nombre = p.nombre || p.Nombre, precio = p.precio || p.Precio;
                return `<option value="${pid}" data-precio="${precio}" ${nombre===planNombre?'selected':''}>${nombre} - $${precio}</option>`;
            }).join('');

            document.getElementById('fecha-hoy').textContent = formatearFecha(new Date());
            document.getElementById('fecha-vencimiento-actual').textContent = formatearFecha(membresiaSeleccionada.fechaVencimiento);

            deudaPendiente = null;
            try {
                const clienteId = membresia.clienteId || membresia.ClienteId;
                const response = await fetch(`${API_URL}/DeudasClientes/cliente/${clienteId}`);
                if (response.ok) {
                    const deudas = await response.json();
                    deudaPendiente = deudas.find(d => (d.estado || d.Estado) === 'pendiente');
                    if (deudaPendiente) {
                        const saldo = deudaPendiente.saldo || deudaPendiente.Saldo;
                        document.getElementById('deuda-info').classList.remove('hidden');
                        document.getElementById('modal-deuda').textContent = `$${saldo.toFixed(2)}`;
                        const planActual = planesData.find(p => (p.id||p.Id)===selectPlan.value);
                        const precio = planActual ? (planActual.precio||planActual.Precio) : precioPlan;
                        document.getElementById('input-monto').value = (saldo + precio).toFixed(2);
                    } else {
                        document.getElementById('deuda-info').classList.add('hidden');
                        document.getElementById('input-monto').value = precioPlan.toFixed(2);
                    }
                } else {
                    document.getElementById('deuda-info').classList.add('hidden');
                    document.getElementById('input-monto').value = precioPlan.toFixed(2);
                }
            } catch { document.getElementById('deuda-info').classList.add('hidden'); document.getElementById('input-monto').value = precioPlan.toFixed(2); }

            document.getElementById('modal-cliente').textContent = clienteNombre;
            const opt = selectPlan.options[selectPlan.selectedIndex];
            document.getElementById('modal-precio').textContent = `$${parseFloat(opt.dataset.precio).toFixed(2)}`;
            actualizarVistaPrevia();
            document.getElementById('modalRenovar').classList.add('flex');
            lucide.createIcons();
        }

        function cambiarPlan() {
            const opt = document.getElementById('select-plan').options[document.getElementById('select-plan').selectedIndex];
            const precio = parseFloat(opt.dataset.precio);
            document.getElementById('modal-precio').textContent = `$${precio.toFixed(2)}`;
            if (deudaPendiente) {
                const saldo = deudaPendiente.saldo || deudaPendiente.Saldo;
                document.getElementById('input-monto').value = (saldo + precio).toFixed(2);
            } else { document.getElementById('input-monto').value = precio.toFixed(2); }
            actualizarVistaPrevia();
        }

        function cerrarModalRenovar() {
            document.getElementById('modalRenovar').classList.remove('flex');
            membresiaSeleccionada = null; deudaPendiente = null;
        }

        async function confirmarRenovacion() {
            const monto  = parseFloat(document.getElementById('input-monto').value);
            const metodo = document.getElementById('input-metodo').value;
            const planId = document.getElementById('select-plan').value;
            const opcion = document.querySelector('input[name="fecha-renovacion"]:checked').value;
            if (isNaN(monto) || monto <= 0) { alert('❌ Monto inválido'); return; }
            try {
                const membresia = membresiasData.find(m => (m.id||m.Id) === membresiaSeleccionada.id);
                const body = { montoPagado:monto, metodoPago:metodo, notas:'', usuarioId:null, renovarDesdeHoy: opcion==='hoy' };
                if (planId !== (membresia.planId||membresia.PlanId)) body.planId = planId;
                const response = await fetch(`${API_URL}/Membresias/renovar/${membresiaSeleccionada.id}`, {
                    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)
                });
                const result = await response.json();
                if (result.success) { alert(`✅ ${result.message}`); cerrarModalRenovar(); loadMembresias(); }
                else { alert(`❌ Error: ${result.message}`); }
            } catch (error) { console.error('Error:', error); alert('❌ Error al renovar la membresía'); }
        }

        async function eliminarMembresia(id, clienteNombre) {
            if (!confirm(`¿Estás seguro de eliminar esta membresía de ${clienteNombre}?\n\nEsta acción no se puede deshacer.`)) return;
            try {
                const response = await fetch(`/api/Membresias/${id}`, {method:'DELETE',headers:{'Content-Type':'application/json'}});
                if (response.ok || response.status === 204) { alert('✅ Membresía eliminada exitosamente'); loadMembresias(); }
                else { const error = await response.text(); alert('❌ Error: ' + error); }
            } catch (error) { console.error('Error:', error); alert('❌ Error al eliminar la membresía'); }
        }

        document.querySelectorAll('input[type="number"]').forEach(input => {
            input.addEventListener('wheel', e => e.preventDefault(), {passive:false});
        });

        window.addEventListener('load', function() {
            loadPlanes(); loadMembresias(); filterByEstado('todas');
        });
    </script>
}

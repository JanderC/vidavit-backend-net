@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Membresías";
    ViewData["Subtitle"] = "Gestión de membresías - POWER FITNESS";
}

<style>
    .pf-input {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px;
        color: #fff;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .pf-input::placeholder { color: rgba(255,255,255,0.25); }
    .pf-input:focus { border-color: #1E6FE3; box-shadow: 0 0 0 3px rgba(30,111,227,0.15); }

    .filter-btn {
        padding: 9px 18px;
        border-radius: 10px;
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.5);
        transition: all 0.15s;
    }
    .filter-btn:hover { background: rgba(255,255,255,0.08); color: #fff; }
    .filter-btn.active {
        background: linear-gradient(135deg,#1E6FE3,#6B3FA0);
        border-color: transparent;
        color: #fff;
    }

    .plan-filter-btn {
        padding: 6px 14px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.65rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.4);
        transition: all 0.15s;
    }
    .plan-filter-btn.active {
        background: linear-gradient(135deg,#1E6FE3,#6B3FA0);
        border-color: transparent;
        color: #fff;
    }

    .stat-card {
        background: #0D0D20;
        border: 1px solid rgba(30,111,227,0.12);
        border-radius: 14px;
        padding: 20px 22px;
    }

    .mem-card {
        background: #0D0D20;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 14px;
        padding: 20px 22px;
        transition: border-color 0.15s, box-shadow 0.15s;
        border-left-width: 3px;
    }
    .mem-card:hover { border-color: rgba(30,111,227,0.3); box-shadow: 0 4px 20px rgba(0,0,0,0.3); }

    .pf-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 100px;
        font-size: 0.62rem; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase;
    }

    .action-btn {
        width: 34px; height: 34px; border-radius: 8px; border: none; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: background 0.15s; text-decoration: none;
    }

    .page-btn {
        padding: 7px 14px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);
        background: transparent; color: rgba(255,255,255,0.5); font-weight: 800;
        font-size: 0.78rem; cursor: pointer; transition: all 0.15s;
    }
    .page-btn:hover { border-color: #1E6FE3; color: #3D8EFF; }
    .page-btn.active { background: #1E6FE3; border-color: #1E6FE3; color: #fff; }

    /* Modal */
    .pf-modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.75); backdrop-filter: blur(6px);
        z-index: 50; align-items: center; justify-content: center; padding: 16px;
    }
    .pf-modal-overlay.show { display: flex; }
    .pf-modal {
        background: #0D0D20; border: 1px solid rgba(30,111,227,0.2);
        border-radius: 20px; width: 100%; max-width: 640px;
        max-height: 90vh; overflow-y: auto;
        box-shadow: 0 32px 80px rgba(0,0,0,0.6);
    }
    .pf-modal-header {
        background: linear-gradient(135deg,#1E6FE3,#6B3FA0);
        padding: 20px 24px; border-radius: 20px 20px 0 0;
        position: sticky; top: 0; z-index: 10;
        display: flex; align-items: center; justify-content: space-between;
    }

    .pf-select {
        width: 100%; padding: 12px 16px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(30,111,227,0.2);
        border-radius: 10px; color: #fff; font-weight: 600; font-size: 0.9rem;
        font-family: 'Inter', sans-serif; outline: none; transition: border-color 0.2s;
    }
    .pf-select:focus { border-color: #1E6FE3; }
    .pf-select option { background: #0D0D20; color: #fff; }

    .radio-option {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 14px 16px; border-radius: 10px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.02); cursor: pointer;
        transition: border-color 0.15s, background 0.15s;
    }
    .radio-option:hover { border-color: rgba(30,111,227,0.3); background: rgba(30,111,227,0.04); }
</style>

<!-- Toolbar -->
<div style="margin-bottom:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:10px;">
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button onclick="filterByEstado('todas')"  class="filter-btn active" data-estado="todas">Todas</button>
            <button onclick="filterByEstado('activa')" class="filter-btn" data-estado="activa">Activas</button>
            <button onclick="filterByEstado('vencida')" class="filter-btn" data-estado="vencida">Vencidas</button>
            <button onclick="filterByEstado('suspendida')" class="filter-btn" data-estado="suspendida">Suspendidas</button>
        </div>
        <a href="/membresias/crear"
           style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border-radius:12px;text-decoration:none;transition:opacity 0.2s,transform 0.2s;"
           onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.02)'"
           onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
            <i data-lucide="plus" style="width:16px;height:16px;"></i>
            Nueva Membresía
        </a>
    </div>

    <!-- Search -->
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:12px;padding:14px 18px;margin-bottom:10px;display:flex;align-items:center;gap:12px;">
        <i data-lucide="search" style="width:16px;height:16px;color:rgba(255,255,255,0.3);flex-shrink:0;"></i>
        <input type="text" id="searchInput" placeholder="Buscar por nombre de cliente..."
               class="pf-input" style="flex:1;padding:0;border:none;background:transparent;box-shadow:none;"
               onkeyup="filtrarMembresias()">
    </div>

    <!-- Plan filters -->
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.12);border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <span style="font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);">Plan:</span>
        <button onclick="filterByPlan(null)" class="plan-filter-btn active" data-plan="todos">Todos</button>
        <div id="planesFilters" style="display:flex;gap:6px;flex-wrap:wrap;"></div>
    </div>
</div>

<!-- Stats -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;">
    <div class="stat-card" style="border-left:3px solid #10B981;">
        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Activas</p>
        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;" id="count-activas">0</p>
    </div>
    <div class="stat-card" style="border-left:3px solid #D97706;">
        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Por Vencer (7d)</p>
        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;" id="count-por-vencer">0</p>
    </div>
    <div class="stat-card" style="border-left:3px solid #F87171;">
        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Vencidas</p>
        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;" id="count-vencidas">0</p>
    </div>
    <div class="stat-card" style="border-left:3px solid #3D8EFF;">
        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Total</p>
        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;" id="count-total">0</p>
    </div>
</div>

<!-- List -->
<div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:16px;overflow:hidden;">
    <div id="membresias-container" style="padding:20px;">
        <div style="text-align:center;padding:48px 0;">
            <div class="animate-spin" style="width:36px;height:36px;border:3px solid rgba(30,111,227,0.2);border-left-color:#1E6FE3;border-radius:50%;margin:0 auto 14px;"></div>
            <p style="color:rgba(255,255,255,0.3);font-weight:600;font-size:0.82rem;letter-spacing:1px;text-transform:uppercase;">Cargando membresías...</p>
        </div>
    </div>
    <div id="pagination" style="display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-top:1px solid rgba(255,255,255,0.05);flex-wrap:wrap;gap:10px;">
        <div style="font-size:0.78rem;color:rgba(255,255,255,0.3);font-weight:600;">
            Mostrando <span id="showing-start">0</span>–<span id="showing-end">0</span> de <span id="showing-total">0</span>
        </div>
        <div style="display:flex;gap:6px;" id="pagination-buttons"></div>
    </div>
</div>

<!-- Modal Renovar -->
<div id="modalRenovar" class="pf-modal-overlay">
    <div class="pf-modal">
        <div class="pf-modal-header">
            <div style="display:flex;align-items:center;gap:10px;">
                <i data-lucide="refresh-cw" style="width:20px;height:20px;color:#fff;"></i>
                <span style="font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:3px;color:#fff;">Renovar Membresía</span>
            </div>
            <button onclick="cerrarModalRenovar()" style="background:rgba(255,255,255,0.1);border:none;border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;">
                <i data-lucide="x" style="width:16px;height:16px;"></i>
            </button>
        </div>

        <div style="padding:22px 24px;display:flex;flex-direction:column;gap:18px;">
            <!-- Cliente -->
            <div>
                <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 5px 0;">Cliente</p>
                <p style="font-weight:800;color:#fff;font-size:1rem;margin:0;" id="modal-cliente">—</p>
            </div>

            <!-- Opciones de fecha -->
            <div style="background:rgba(30,111,227,0.05);border:1px solid rgba(30,111,227,0.15);border-radius:12px;padding:16px;">
                <p style="font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#3D8EFF;margin:0 0 12px 0;display:flex;align-items:center;gap:6px;">
                    <i data-lucide="calendar" style="width:13px;height:13px;"></i>
                    ¿Desde cuándo renovar?
                </p>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    <label class="radio-option">
                        <input type="radio" name="fecha-renovacion" value="vencimiento" checked onchange="actualizarVistaPrevia()"
                               style="width:16px;height:16px;accent-color:#1E6FE3;flex-shrink:0;margin-top:2px;">
                        <div>
                            <p style="font-weight:800;color:#fff;font-size:0.85rem;margin:0 0 3px 0;">Desde fecha de vencimiento</p>
                            <p style="font-size:0.75rem;color:rgba(255,255,255,0.4);margin:0 0 6px 0;">Mantiene continuidad de la membresía</p>
                            <p style="font-size:0.72rem;font-weight:700;color:#3D8EFF;margin:0;">
                                📅 Vence actualmente: <span id="fecha-vencimiento-actual" style="font-weight:900;">—</span>
                            </p>
                        </div>
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="fecha-renovacion" value="hoy" onchange="actualizarVistaPrevia()"
                               style="width:16px;height:16px;accent-color:#10B981;flex-shrink:0;margin-top:2px;">
                        <div>
                            <p style="font-weight:800;color:#fff;font-size:0.85rem;margin:0 0 3px 0;">Desde hoy</p>
                            <p style="font-size:0.75rem;color:rgba(255,255,255,0.4);margin:0 0 6px 0;">Reinicia el conteo desde la fecha actual</p>
                            <p style="font-size:0.72rem;font-weight:700;color:#10B981;margin:0;">
                                📅 Hoy: <span id="fecha-hoy" style="font-weight:900;">—</span>
                            </p>
                        </div>
                    </label>
                </div>
                <!-- Preview -->
                <div style="margin-top:14px;background:rgba(107,63,160,0.08);border:1px solid rgba(107,63,160,0.2);border-radius:10px;padding:12px 14px;">
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#a78bfa;margin:0 0 4px 0;">Vista Previa</p>
                    <p style="font-weight:800;color:#fff;font-size:0.9rem;margin:0;">
                        Nueva fecha de vencimiento: <span id="preview-fecha-vencimiento" style="color:#a78bfa;">—</span>
                    </p>
                    <p style="font-size:0.75rem;color:rgba(255,255,255,0.4);margin:3px 0 0 0;" id="preview-duracion">—</p>
                </div>
            </div>

            <!-- Plan -->
            <div>
                <label style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);display:block;margin-bottom:8px;">Plan</label>
                <select id="select-plan" onchange="cambiarPlan()" class="pf-select"></select>
            </div>

            <!-- Precio -->
            <div>
                <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 5px 0;">Precio del Plan</p>
                <p style="font-size:1.6rem;font-weight:900;color:#3D8EFF;margin:0;" id="modal-precio">$0.00</p>
            </div>

            <!-- Deuda -->
            <div id="deuda-info" style="display:none;background:rgba(217,119,6,0.06);border:1px solid rgba(217,119,6,0.2);border-radius:10px;padding:14px;">
                <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#D97706;margin:0 0 4px 0;">Deuda Pendiente</p>
                <p style="font-size:1.4rem;font-weight:900;color:#F5C842;margin:0 0 4px 0;" id="modal-deuda">$0.00</p>
                <p style="font-size:0.72rem;color:rgba(255,255,255,0.4);margin:0;">El pago se aplicará primero a la deuda existente</p>
            </div>

            <!-- Monto -->
            <div>
                <label style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);display:block;margin-bottom:8px;">Monto a Pagar</label>
                <input type="number" id="input-monto" step="0.01" min="0.01"
                       class="pf-input" style="width:100%;padding:12px 16px;font-size:1.1rem;">
            </div>

            <!-- Método -->
            <div>
                <label style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);display:block;margin-bottom:8px;">Método de Pago</label>
                <select id="input-metodo" class="pf-select">
                    <option value="efectivo">Efectivo</option>
                    <option value="tarjeta">Tarjeta</option>
                    <option value="transferencia">Transferencia</option>
                </select>
            </div>

            <!-- Botones -->
            <div style="display:flex;gap:10px;padding-top:6px;border-top:1px solid rgba(255,255,255,0.06);">
                <button onclick="cerrarModalRenovar()"
                        style="flex:1;padding:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:10px;color:rgba(255,255,255,0.5);font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;transition:all 0.15s;"
                        onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background='rgba(255,255,255,0.04)'">
                    Cancelar
                </button>
                <button onclick="confirmarRenovacion()"
                        style="flex:1;padding:12px;background:linear-gradient(135deg,#0E5C2E,#10B981);color:#fff;border:none;border-radius:10px;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;transition:opacity 0.2s;"
                        onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
                    Confirmar Renovación
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let membresiasData = [];
        let membresiasFiltradas = [];
        let planesData = [];
        let filtroEstado = 'todas';
        let filtroPlan = null;
        let membresiaSeleccionada = null;
        let deudaPendiente = null;
        let paginaActual = 1;
        const itemsPorPagina = 10;

        function parsearFechaUTC(fechaStr) {
            if (!fechaStr) return null;
            const fecha = fechaStr.split('T')[0];
            const [year, month, day] = fecha.split('-').map(Number);
            return new Date(year, month - 1, day);
        }

        async function loadMembresias() {
            try {
                const response = await fetch(`${API_URL}/Membresias`);
                if (!response.ok) throw new Error('Error en la respuesta');
                membresiasData = await response.json();
                calcularEstadisticas();
                filtrarMembresias();
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('membresias-container').innerHTML = `
                    <div style="text-align:center;padding:48px 0;">
                        <i data-lucide="alert-circle" style="width:40px;height:40px;color:#F87171;margin:0 auto 12px;display:block;"></i>
                        <p style="color:#F87171;font-weight:700;margin:0 0 12px 0;">Error al cargar las membresías</p>
                        <button onclick="loadMembresias()"
                                style="padding:10px 20px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;border:none;border-radius:10px;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;">
                            Reintentar
                        </button>
                    </div>`;
                lucide.createIcons();
            }
        }

        async function loadPlanes() {
            try {
                const response = await fetch(`${API_URL}/Planes`);
                planesData = await response.json();
                const container = document.getElementById('planesFilters');
                container.innerHTML = planesData.map(p => `
                    <button onclick="filterByPlan('${p.id || p.Id}')"
                            class="plan-filter-btn" data-plan="${p.id || p.Id}">
                        ${p.Nombre || p.nombre}
                    </button>`).join('');
            } catch (error) {
                console.error('Error cargando planes:', error);
            }
        }

        function calcularEstadisticas() {
            const hoy = new Date(); hoy.setHours(0,0,0,0);
            let activas = 0, vencidas = 0, porVencer = 0;
            membresiasData.forEach(m => {
                const estado = (m.estado || m.Estado).toLowerCase();
                const fechaVenc = parsearFechaUTC(m.fechaVencimiento || m.FechaVencimiento);
                fechaVenc.setHours(0,0,0,0);
                if (estado === 'activa' && fechaVenc >= hoy) {
                    activas++;
                    if (Math.ceil((fechaVenc - hoy) / 86400000) <= 7) porVencer++;
                } else if (estado === 'vencida' || (estado === 'activa' && fechaVenc < hoy)) { vencidas++; }
            });
            document.getElementById('count-activas').textContent   = activas;
            document.getElementById('count-por-vencer').textContent = porVencer;
            document.getElementById('count-vencidas').textContent  = vencidas;
            document.getElementById('count-total').textContent     = membresiasData.length;
        }

        function filtrarMembresias() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            const hoy = new Date(); hoy.setHours(0,0,0,0);
            membresiasFiltradas = membresiasData.filter(m => {
                const estado = (m.estado || m.Estado).toLowerCase();
                const fechaVenc = parsearFechaUTC(m.fechaVencimiento || m.FechaVencimiento);
                fechaVenc.setHours(0,0,0,0);
                let pasaEstado = filtroEstado === 'todas';
                if (!pasaEstado) {
                    if (filtroEstado === 'activa')  pasaEstado = estado === 'activa' && fechaVenc >= hoy;
                    else if (filtroEstado === 'vencida') pasaEstado = estado === 'vencida' || (estado === 'activa' && fechaVenc < hoy);
                    else pasaEstado = estado === filtroEstado;
                }
                const pasaPlan = !filtroPlan || (m.planId || m.PlanId) === filtroPlan;
                const cliente = m.cliente || m.Cliente;
                const nombre = cliente ? `${cliente.nombre||cliente.Nombre} ${cliente.apellido||cliente.Apellido}`.toLowerCase() : '';
                return pasaEstado && pasaPlan && (!q || nombre.includes(q));
            });
            paginaActual = 1;
            renderMembresias();
        }

        function renderMembresias() {
            const inicio = (paginaActual - 1) * itemsPorPagina;
            const paginadas = membresiasFiltradas.slice(inicio, inicio + itemsPorPagina);
            if (paginadas.length === 0) {
                document.getElementById('membresias-container').innerHTML = `
                    <div style="text-align:center;padding:48px 0;">
                        <i data-lucide="inbox" style="width:40px;height:40px;color:rgba(255,255,255,0.15);margin:0 auto 12px;display:block;"></i>
                        <p style="color:rgba(255,255,255,0.3);font-weight:700;">No se encontraron membresías</p>
                    </div>`;
                lucide.createIcons();
                renderPaginacion();
                return;
            }
            document.getElementById('membresias-container').innerHTML =
                `<div style="display:flex;flex-direction:column;gap:10px;">${paginadas.map(m => renderCard(m)).join('')}</div>`;
            renderPaginacion();
            lucide.createIcons();
        }

        function renderCard(m) {
            const hoy = new Date(); hoy.setHours(0,0,0,0);
            const fechaInicio = parsearFechaUTC(m.fechaInicio || m.FechaInicio);
            const fechaVenc   = parsearFechaUTC(m.fechaVencimiento || m.FechaVencimiento);
            fechaVenc.setHours(0,0,0,0);
            const diasRestantes = Math.ceil((fechaVenc - hoy) / 86400000);
            const estado = (m.estado || m.Estado).toLowerCase();
            const cliente = m.cliente || m.Cliente;
            const plan    = m.plan || m.Plan;
            const clienteNombre = cliente ? `${cliente.nombre||cliente.Nombre} ${cliente.apellido||cliente.Apellido}` : 'Sin cliente';
            const planNombre    = plan ? (plan.nombre||plan.Nombre) : 'Sin plan';
            const planPrecio    = plan ? (plan.precio||plan.Precio||0) : 0;
            const planColor     = plan ? (plan.color||plan.Color||'#1E6FE3') : '#1E6FE3';
            const planTipo      = plan ? (plan.tipo||plan.Tipo||'') : '';

            let badgeBg, badgeColor, badgeBorder, badgeText, diasHtml, mostrarRenovar = false;
            if (estado === 'activa' && fechaVenc >= hoy) {
                if (diasRestantes === 0) {
                    badgeBg='rgba(248,113,113,0.12)'; badgeColor='#F87171'; badgeBorder='rgba(248,113,113,0.3)'; badgeText='Vence HOY';
                    diasHtml=`<span style="color:#F87171;font-weight:900;">¡Vence HOY!</span>`; mostrarRenovar=true;
                } else if (diasRestantes <= 3) {
                    badgeBg='rgba(248,113,113,0.1)'; badgeColor='#F87171'; badgeBorder='rgba(248,113,113,0.25)'; badgeText='Vence pronto';
                    diasHtml=`<span style="color:#F87171;font-weight:900;">${diasRestantes}d</span>`; mostrarRenovar=true;
                } else if (diasRestantes <= 7) {
                    badgeBg='rgba(217,119,6,0.1)'; badgeColor='#D97706'; badgeBorder='rgba(217,119,6,0.25)'; badgeText='Por vencer';
                    diasHtml=`<span style="color:#D97706;font-weight:900;">${diasRestantes}d</span>`; mostrarRenovar=true;
                } else {
                    badgeBg='rgba(16,185,129,0.1)'; badgeColor='#10B981'; badgeBorder='rgba(16,185,129,0.25)'; badgeText='Activa';
                    diasHtml=`<span style="color:#10B981;font-weight:900;">${diasRestantes}d</span>`;
                }
            } else if (estado === 'vencida' || (estado === 'activa' && fechaVenc < hoy)) {
                badgeBg='rgba(248,113,113,0.1)'; badgeColor='#F87171'; badgeBorder='rgba(248,113,113,0.25)'; badgeText='Vencida';
                diasHtml=`<span style="color:#F87171;font-weight:900;">Vencida</span>`; mostrarRenovar=true;
            } else {
                badgeBg='rgba(255,255,255,0.05)'; badgeColor='rgba(255,255,255,0.4)'; badgeBorder='rgba(255,255,255,0.1)'; badgeText='Suspendida';
                diasHtml=`<span style="color:rgba(255,255,255,0.3);">—</span>`;
            }

            return `
                <div class="mem-card" style="border-left-color:${planColor};">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap;">
                                <h3 style="font-weight:900;color:#fff;font-size:1rem;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${clienteNombre}</h3>
                                <span class="pf-badge" style="background:${badgeBg};color:${badgeColor};border:1px solid ${badgeBorder};">${badgeText}</span>
                                ${planTipo ? `<span class="pf-badge" style="background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.35);border:1px solid rgba(255,255,255,0.08);">${planTipo}</span>` : ''}
                            </div>
                            <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;">
                                ${[
                                    ['Plan', planNombre],
                                    ['Inicio', fechaInicio.toLocaleDateString('es-ES')],
                                    ['Vencimiento', fechaVenc.toLocaleDateString('es-ES')],
                                    ['Días Rest.', diasHtml],
                                    ['Monto', `<span style="color:#10B981;font-weight:900;">$${m.montoPagado||m.MontoPagado||0}</span>`]
                                ].map(([label, val]) => `
                                    <div>
                                        <p style="font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 4px 0;">${label}</p>
                                        <p style="font-weight:800;color:#fff;font-size:0.88rem;margin:0;">${val}</p>
                                    </div>`).join('')}
                            </div>
                        </div>
                        <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
                            ${mostrarRenovar ? `
                                <button onclick="abrirModalRenovar('${m.id||m.Id}','${clienteNombre.replace(/'/g,"\\'")}','${planNombre.replace(/'/g,"\\'")}',${planPrecio})"
                                        style="display:inline-flex;align-items:center;gap:6px;padding:8px 14px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.25);color:#10B981;font-weight:800;font-size:0.7rem;letter-spacing:1.5px;text-transform:uppercase;border-radius:8px;cursor:pointer;transition:all 0.15s;"
                                        onmouseover="this.style.background='rgba(16,185,129,0.2)'" onmouseout="this.style.background='rgba(16,185,129,0.1)'">
                                    <i data-lucide="refresh-cw" style="width:13px;height:13px;"></i> Renovar
                                </button>` : ''}
                            <a href="/membresias/editar/${m.id||m.Id}" class="action-btn" title="Editar"
                               style="background:rgba(217,119,6,0.08);" onmouseover="this.style.background='rgba(217,119,6,0.18)'" onmouseout="this.style.background='rgba(217,119,6,0.08)'">
                                <i data-lucide="edit" style="width:15px;height:15px;color:#D97706;"></i>
                            </a>
                            <button onclick="eliminarMembresia('${m.id||m.Id}','${clienteNombre.replace(/'/g,"\\'")}' )" class="action-btn" title="Eliminar"
                                    style="background:rgba(248,113,113,0.08);border:none;cursor:pointer;" onmouseover="this.style.background='rgba(248,113,113,0.18)'" onmouseout="this.style.background='rgba(248,113,113,0.08)'">
                                <i data-lucide="trash-2" style="width:15px;height:15px;color:#F87171;"></i>
                            </button>
                        </div>
                    </div>
                </div>`;
        }

        function renderPaginacion() {
            const total = membresiasFiltradas.length;
            const totalPaginas = Math.ceil(total / itemsPorPagina);
            const inicio = (paginaActual - 1) * itemsPorPagina + 1;
            const fin = Math.min(inicio + itemsPorPagina - 1, total);
            document.getElementById('showing-start').textContent = total ? inicio : 0;
            document.getElementById('showing-end').textContent   = fin;
            document.getElementById('showing-total').textContent = total;

            let btns = '';
            if (paginaActual > 1) btns += `<button onclick="cambiarPagina(${paginaActual-1})" class="page-btn">‹</button>`;
            for (let i = 1; i <= totalPaginas; i++) {
                if (i===1||i===totalPaginas||Math.abs(i-paginaActual)<=1)
                    btns += `<button onclick="cambiarPagina(${i})" class="page-btn${i===paginaActual?' active':''}">${i}</button>`;
                else if (Math.abs(i-paginaActual)===2) btns += `<span style="color:rgba(255,255,255,0.3);padding:0 4px;">…</span>`;
            }
            if (paginaActual < totalPaginas) btns += `<button onclick="cambiarPagina(${paginaActual+1})" class="page-btn">›</button>`;
            document.getElementById('pagination-buttons').innerHTML = btns;
        }

        function cambiarPagina(p) {
            paginaActual = p; renderMembresias();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function filterByEstado(estado) {
            filtroEstado = estado;
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.toggle('active', b.dataset.estado === estado);
            });
            filtrarMembresias();
        }

        function filterByPlan(planId) {
            filtroPlan = planId;
            document.querySelectorAll('.plan-filter-btn').forEach(b => {
                b.classList.toggle('active', b.dataset.plan === (planId||'todos'));
            });
            filtrarMembresias();
        }

        // ── Renovar ──
        function formatearFecha(fecha) {
            return fecha.toLocaleDateString('es-ES',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
        }

        function calcFechaVenc(fechaInicio, plan) {
            const inicio = new Date(fechaInicio);
            const tipo = (plan.tipoCalculoVencimiento||plan.TipoCalculoVencimiento||'dias').toLowerCase();
            const cant = plan.cantidadUnidades||plan.CantidadUnidades||plan.duracionDias||plan.DuracionDias||30;
            const v = new Date(inicio);
            if (tipo==='meses')   v.setMonth(v.getMonth()+cant);
            else if (tipo==='semanas') v.setDate(v.getDate()+cant*7);
            else if (tipo==='anios')  v.setFullYear(v.getFullYear()+cant);
            else v.setDate(v.getDate()+cant);
            return v;
        }

        function actualizarVistaPrevia() {
            if (!membresiaSeleccionada) return;
            const opcion = document.querySelector('input[name="fecha-renovacion"]:checked').value;
            const plan = planesData.find(p => (p.id||p.Id) === document.getElementById('select-plan').value);
            if (!plan) return;
            const fechaInicio = opcion === 'vencimiento' ? membresiaSeleccionada.fechaVencimiento : new Date();
            const v = calcFechaVenc(fechaInicio, plan);
            document.getElementById('preview-fecha-vencimiento').textContent = formatearFecha(v);
            const tipo = (plan.tipoCalculoVencimiento||plan.TipoCalculoVencimiento||'dias').toLowerCase();
            const cant = plan.cantidadUnidades||plan.CantidadUnidades||plan.duracionDias||plan.DuracionDias||30;
            const durTxt = tipo==='meses' ? `${cant} ${cant===1?'mes':'meses'}` :
                           tipo==='semanas' ? `${cant} ${cant===1?'semana':'semanas'}` :
                           tipo==='anios'   ? `${cant} ${cant===1?'año':'años'}` : `${cant} días`;
            document.getElementById('preview-duracion').textContent = `Duración: ${durTxt}`;
        }

        async function abrirModalRenovar(id, clienteNombre, planNombre, precioPlan) {
            const membresia = membresiasData.find(m => (m.id||m.Id) === id);
            if (!membresia) { alert('Error al cargar membresía'); return; }
            membresiaSeleccionada = {
                id, clienteNombre, planNombre, precioPlan,
                fechaVencimiento: parsearFechaUTC(membresia.fechaVencimiento||membresia.FechaVencimiento),
                fechaInicio: parsearFechaUTC(membresia.fechaInicio||membresia.FechaInicio)
            };

            const selectPlan = document.getElementById('select-plan');
            selectPlan.innerHTML = planesData.map(p => {
                const pid = p.id||p.Id, nombre = p.nombre||p.Nombre, precio = p.precio||p.Precio;
                return `<option value="${pid}" data-precio="${precio}" ${nombre===planNombre?'selected':''}>${nombre} - $${precio}</option>`;
            }).join('');

            document.getElementById('modal-cliente').textContent = clienteNombre;
            document.getElementById('fecha-hoy').textContent = formatearFecha(new Date());
            document.getElementById('fecha-vencimiento-actual').textContent = formatearFecha(membresiaSeleccionada.fechaVencimiento);

            deudaPendiente = null;
            try {
                const clienteId = membresia.clienteId||membresia.ClienteId;
                const r = await fetch(`${API_URL}/DeudasClientes/cliente/${clienteId}`);
                if (r.ok) {
                    const deudas = await r.json();
                    deudaPendiente = deudas.find(d => (d.estado||d.Estado)==='pendiente');
                    if (deudaPendiente) {
                        const saldo = deudaPendiente.saldo||deudaPendiente.Saldo;
                        document.getElementById('deuda-info').style.display = 'block';
                        document.getElementById('modal-deuda').textContent = `$${saldo.toFixed(2)}`;
                        const planAct = planesData.find(p=>(p.id||p.Id)===selectPlan.value);
                        const precioAct = planAct?(planAct.precio||planAct.Precio):precioPlan;
                        document.getElementById('input-monto').value = (saldo+precioAct).toFixed(2);
                    } else {
                        document.getElementById('deuda-info').style.display = 'none';
                        document.getElementById('input-monto').value = precioPlan.toFixed(2);
                    }
                } else { throw new Error(); }
            } catch {
                document.getElementById('deuda-info').style.display = 'none';
                document.getElementById('input-monto').value = precioPlan.toFixed(2);
            }

            const planOpt = selectPlan.options[selectPlan.selectedIndex];
            document.getElementById('modal-precio').textContent = `$${parseFloat(planOpt.dataset.precio).toFixed(2)}`;
            actualizarVistaPrevia();
            document.getElementById('modalRenovar').classList.add('show');
            lucide.createIcons();
        }

        function cambiarPlan() {
            const opt = document.getElementById('select-plan').options[document.getElementById('select-plan').selectedIndex];
            const precio = parseFloat(opt.dataset.precio);
            document.getElementById('modal-precio').textContent = `$${precio.toFixed(2)}`;
            if (deudaPendiente) {
                document.getElementById('input-monto').value = (deudaPendiente.saldo||deudaPendiente.Saldo+precio).toFixed(2);
            } else {
                document.getElementById('input-monto').value = precio.toFixed(2);
            }
            actualizarVistaPrevia();
        }

        function cerrarModalRenovar() {
            document.getElementById('modalRenovar').classList.remove('show');
            membresiaSeleccionada = null; deudaPendiente = null;
        }

        async function confirmarRenovacion() {
            const monto = parseFloat(document.getElementById('input-monto').value);
            const metodo = document.getElementById('input-metodo').value;
            const planId = document.getElementById('select-plan').value;
            const opcion = document.querySelector('input[name="fecha-renovacion"]:checked').value;
            if (isNaN(monto)||monto<=0) { alert('Monto inválido'); return; }
            try {
                const membresia = membresiasData.find(m=>(m.id||m.Id)===membresiaSeleccionada.id);
                const body = { montoPagado:monto, metodoPago:metodo, notas:'', usuarioId:null, renovarDesdeHoy:opcion==='hoy' };
                const planActual = membresia.planId||membresia.PlanId;
                if (planId!==planActual) body.planId = planId;
                const response = await fetch(`${API_URL}/Membresias/renovar/${membresiaSeleccionada.id}`,{
                    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)
                });
                const result = await response.json();
                if (result.success) { alert(`✅ ${result.message}`); cerrarModalRenovar(); loadMembresias(); }
                else { alert(`❌ Error: ${result.message}`); }
            } catch(error) { alert('❌ Error al renovar la membresía'); }
        }

        async function eliminarMembresia(id, clienteNombre) {
            if (!confirm(`¿Eliminar membresía de ${clienteNombre}? Esta acción no se puede deshacer.`)) return;
            try {
                const r = await fetch(`/api/Membresias/${id}`,{method:'DELETE'});
                if (r.ok||r.status===204) { alert('✅ Membresía eliminada'); loadMembresias(); }
                else { alert('❌ Error: '+(await r.text())); }
            } catch(e) { alert('❌ Error al eliminar'); }
        }

        document.addEventListener('click', e => {
            if (!e.target.closest('#modalRenovar') && !e.target.closest('[onclick*="abrirModalRenovar"]')) {
                // no cerrar al hacer click dentro del modal
            }
        });

        document.querySelectorAll('input[type="number"]').forEach(i =>
            i.addEventListener('wheel', e => e.preventDefault(), { passive: false })
        );

        window.addEventListener('load', () => { loadPlanes(); loadMembresias(); });
    </script>
}

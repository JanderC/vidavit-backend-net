@{
    ViewData["Title"] = "Crear Membresía";
    ViewData["Subtitle"] = "Nueva membresía con opción de pago parcial - Power Fitness";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --pf-blue:#3B82F6; --pf-blueB:#60A5FA; --pf-deep:#1E3A8A;
        --pf-purple:#7C3AED; --pf-dark:#060B18; --pf-card:#0D1526;
        --pf-border:#1E2D4A; --pf-text:#E2E8F0; --pf-soft:#94A3B8;
        --pf-muted:#64748B; --pf-green:#10B981; --pf-red:#EF4444; --pf-orange:#F59E0B;
    }
    .pf-input {
        width:100%; padding:.75rem 1rem; border:2px solid var(--pf-border);
        border-radius:.75rem; background:rgba(255,255,255,.03); color:var(--pf-text);
        font-weight:600; font-family:inherit; font-size:.9rem; outline:none;
        box-sizing:border-box; transition:border-color .2s, background .2s;
    }
    .pf-input:focus { border-color:var(--pf-blue); background:rgba(59,130,246,.05); }
    .pf-input::placeholder { color:var(--pf-muted); font-weight:400; }
    .pf-select {
        width:100%; padding:.75rem 1rem; border:2px solid var(--pf-border);
        border-radius:.75rem; background:var(--pf-card); color:var(--pf-text);
        font-weight:600; font-family:inherit; font-size:.9rem; outline:none;
        box-sizing:border-box; transition:border-color .2s;
    }
    .pf-select:focus { border-color:var(--pf-blue); }
    .pf-label {
        display:block; font-size:.72rem; font-weight:800; color:var(--pf-soft);
        margin-bottom:.5rem; text-transform:uppercase; letter-spacing:.1em;
    }
    .pf-label small { font-size:.65rem; color:var(--pf-muted); text-transform:none; font-weight:500; margin-left:.35rem; }
</style>

<div style="max-width:56rem; margin:0 auto;">
    <div style="background:var(--pf-card); border:1px solid var(--pf-border); border-radius:1.25rem; padding:2rem; box-shadow:0 4px 24px rgba(0,0,0,.4);">

        <!-- Header -->
        <div style="display:flex; align-items:center; gap:1rem; margin-bottom:2rem; padding-bottom:1.25rem; border-bottom:1px solid var(--pf-border);">
            <div style="background:linear-gradient(135deg,var(--pf-deep),var(--pf-purple)); border-radius:.875rem; padding:1rem; flex-shrink:0;">
                <i data-lucide="credit-card" style="width:32px;height:32px;color:#fff;"></i>
            </div>
            <div>
                <h2 style="font-size:1.5rem; font-weight:900; color:var(--pf-text); text-transform:uppercase; letter-spacing:.06em; margin:0 0 .2rem 0;">Nueva Membresía</h2>
                <p style="font-size:.8rem; color:var(--pf-muted); font-weight:600; margin:0;">Registrar membresía con opción de pago parcial</p>
            </div>
        </div>

        <form id="membresiaForm" style="display:flex; flex-direction:column; gap:1.25rem;">

            <!-- Buscar cliente -->
            <div>
                <label class="pf-label">Buscar Cliente <span style="color:var(--pf-blue);">*</span></label>
                <div style="position:relative;">
                    <input type="text" id="clienteBuscar" placeholder="Buscar por nombre, apellido o cédula..."
                           class="pf-input" autocomplete="off" style="padding-right:3rem;">
                    <i data-lucide="search" style="position:absolute;right:1rem;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--pf-muted);pointer-events:none;"></i>
                </div>
                <div id="clienteResultados" class="hidden" style="position:absolute;z-index:10;margin-top:.25rem;width:100%;max-width:52rem;background:var(--pf-card);border:1px solid var(--pf-border);border-radius:.875rem;box-shadow:0 12px 32px rgba(0,0,0,.5);max-height:16rem;overflow-y:auto;"></div>
                <div id="clienteSeleccionado" class="hidden" style="margin-top:.75rem;padding:1rem 1.25rem;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.25);border-radius:.875rem;">
                    <div style="display:flex;align-items:center;justify-content:space-between;">
                        <div>
                            <p style="font-weight:900;color:var(--pf-green);font-size:1rem;text-transform:uppercase;margin:0 0 .15rem 0;" id="clienteNombre"></p>
                            <p style="font-size:.8rem;color:rgba(16,185,129,.7);font-weight:700;margin:0;" id="clienteCedula"></p>
                        </div>
                        <button type="button" onclick="limpiarCliente()"
                                style="padding:.4rem;background:transparent;border:none;color:var(--pf-red);cursor:pointer;border-radius:.5rem;transition:background .15s;"
                                onmouseover="this.style.background='rgba(239,68,68,.1)'" onmouseout="this.style.background='transparent'">
                            <i data-lucide="x" style="width:18px;height:18px;"></i>
                        </button>
                    </div>
                </div>
                <input type="hidden" name="clienteId" id="clienteId" required>
            </div>

            <!-- Plan -->
            <div>
                <label class="pf-label">Plan <span style="color:var(--pf-blue);">*</span></label>
                <select name="planId" id="planSelect" required class="pf-select">
                    <option value="" style="color:var(--pf-muted);">Seleccione un plan...</option>
                </select>
                <div id="planInfo" class="hidden" style="margin-top:.625rem;padding:.75rem 1rem;background:rgba(59,130,246,.07);border:1px solid rgba(59,130,246,.2);border-radius:.75rem;font-size:.82rem;color:var(--pf-blueB);font-weight:700;"></div>
            </div>

            <!-- Fechas -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
                <div>
                    <label class="pf-label">Fecha Inicio <span style="color:var(--pf-blue);">*</span></label>
                    <input type="date" name="fechaInicio" id="fechaInicio" required class="pf-input">
                </div>
                <div>
                    <label class="pf-label">Fecha Vencimiento</label>
                    <input type="date" name="fechaVencimiento" id="fechaVencimiento" readonly
                           class="pf-input" style="background:rgba(255,255,255,.02);cursor:not-allowed;color:var(--pf-soft);">
                </div>
            </div>

            <!-- Precio plan -->
            <div id="precioContainer" class="hidden" style="padding:1.1rem 1.25rem;background:rgba(59,130,246,.07);border:1px solid rgba(59,130,246,.2);border-radius:.875rem;display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.7rem;color:var(--pf-blueB);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .25rem 0;">Precio Total del Plan</p>
                    <p style="font-size:1.75rem;font-weight:900;color:var(--pf-blueB);margin:0;" id="precioPlan">$0.00</p>
                </div>
                <div style="background:rgba(59,130,246,.15);padding:.875rem;border-radius:.75rem;">
                    <i data-lucide="dollar-sign" style="width:28px;height:28px;color:var(--pf-blueB);"></i>
                </div>
            </div>

            <!-- Monto y método -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
                <div>
                    <label class="pf-label">Monto a Pagar Ahora <span style="color:var(--pf-blue);">*</span><small>(puede pagar menos del total)</small></label>
                    <input type="number" step="0.01" min="0" name="montoPagado" id="montoPagado" required class="pf-input" style="font-size:1.1rem;">
                </div>
                <div>
                    <label class="pf-label">Método de Pago <span style="color:var(--pf-blue);">*</span></label>
                    <select name="metodoPago" required class="pf-select">
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="transferencia">Transferencia</option>
                    </select>
                </div>
            </div>

            <!-- Alerta pago parcial -->
            <div id="saldoPendienteAlert" class="hidden" style="padding:1.1rem 1.25rem;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.25);border-radius:.875rem;display:flex;align-items:flex-start;gap:.875rem;">
                <div style="background:rgba(245,158,11,.15);padding:.75rem;border-radius:.75rem;flex-shrink:0;">
                    <i data-lucide="alert-triangle" style="width:24px;height:24px;color:var(--pf-orange);"></i>
                </div>
                <div style="flex:1;">
                    <h4 style="font-weight:900;color:var(--pf-orange);font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;margin:0 0 .75rem 0;" id="alertTitle">⚠️ Pago Parcial Detectado</h4>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.875rem;">
                        <div>
                            <p style="font-size:.72rem;color:var(--pf-orange);font-weight:700;margin:0 0 .2rem 0;">Monto a Pagar:</p>
                            <p style="font-size:1.4rem;font-weight:900;color:var(--pf-text);margin:0;" id="montoPagandoDisplay">$0.00</p>
                        </div>
                        <div>
                            <p style="font-size:.72rem;color:var(--pf-red);font-weight:700;margin:0 0 .2rem 0;">Saldo a Deber:</p>
                            <p style="font-size:1.4rem;font-weight:900;color:var(--pf-red);margin:0;" id="saldoDeberDisplay">$0.00</p>
                        </div>
                    </div>
                    <p style="font-size:.78rem;color:var(--pf-soft);font-weight:700;margin:.75rem 0 0 0;padding:.5rem .875rem;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);border-radius:.5rem;">
                        📝 Se creará automáticamente una deuda por el saldo pendiente
                    </p>
                </div>
            </div>

            <!-- Duración -->
            <div id="duracionInfo" class="hidden" style="padding:1.1rem 1.25rem;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.25);border-radius:.875rem;">
                <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.875rem;">
                    <i data-lucide="calendar" style="width:20px;height:20px;color:var(--pf-green);"></i>
                    <h4 style="font-weight:900;color:var(--pf-green);font-size:.82rem;text-transform:uppercase;letter-spacing:.08em;margin:0;">Duración de la Membresía</h4>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:.875rem;">
                    <div>
                        <p style="font-size:.7rem;color:rgba(16,185,129,.7);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .2rem 0;">Total:</p>
                        <p style="font-weight:900;color:var(--pf-green);font-size:1.4rem;margin:0;" id="totalDias">-</p>
                    </div>
                    <div>
                        <p style="font-size:.7rem;color:rgba(16,185,129,.7);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .2rem 0;">Vence el:</p>
                        <p style="font-weight:800;color:var(--pf-text);font-size:.95rem;margin:0;" id="fechaVencTexto">-</p>
                    </div>
                </div>
            </div>

            <!-- Notas -->
            <div>
                <label class="pf-label">Notas (Opcional)</label>
                <textarea name="notas" rows="2" placeholder="Ingrese notas adicionales..."
                          class="pf-input" style="resize:vertical;"></textarea>
            </div>

            <!-- Botones -->
            <div style="display:flex;gap:1rem;padding-top:1.25rem;border-top:1px solid var(--pf-border);">
                <button type="submit"
                        style="flex:1;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;font-weight:800;padding:1rem;border:none;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.9rem;text-transform:uppercase;letter-spacing:.08em;box-shadow:0 4px 20px rgba(59,130,246,.3);transition:transform .2s,box-shadow .2s;display:flex;align-items:center;justify-content:center;gap:.5rem;"
                        onmouseover="this.style.transform='scale(1.02)';this.style.boxShadow='0 8px 28px rgba(59,130,246,.45)'" onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 20px rgba(59,130,246,.3)'">
                    <i data-lucide="check-circle" style="width:18px;height:18px;"></i>
                    Crear Membresía
                </button>
                <a href="/membresias"
                   style="flex:1;background:rgba(255,255,255,.05);border:1px solid var(--pf-border);color:var(--pf-soft);font-weight:800;padding:1rem;border-radius:.875rem;text-align:center;text-decoration:none;font-size:.9rem;text-transform:uppercase;letter-spacing:.08em;display:flex;align-items:center;justify-content:center;gap:.5rem;transition:background .2s;"
                   onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">
                    <i data-lucide="x-circle" style="width:18px;height:18px;"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let planes = [];
        let todosLosClientes = [];
        let clienteSeleccionadoId = null;
        let buscarTimeout = null;
        let planSeleccionado = null;

        async function cargarPlanes() {
            try {
                let planesRes = await fetch('/api/Planes/activos');
                if (!planesRes.ok) { planesRes = await fetch('/api/Planes'); if (!planesRes.ok) throw new Error('Error al cargar planes'); }
                const planesData = await planesRes.json();
                planes = planesData.map(p => ({
                    id: p.Id || p.id, nombre: p.Nombre || p.nombre, precio: p.Precio || p.precio,
                    duracionDias: p.DuracionDias || p.duracionDias,
                    tipoCalculoVencimiento: p.TipoCalculoVencimiento || p.tipoCalculoVencimiento || 'dias',
                    cantidadUnidades: p.CantidadUnidades || p.cantidadUnidades || 1
                }));
                const planSelect = document.getElementById('planSelect');
                planes.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    let dur = `${p.duracionDias} días`;
                    if (p.tipoCalculoVencimiento==='meses')   dur=`${p.cantidadUnidades} ${p.cantidadUnidades===1?'mes':'meses'}`;
                    if (p.tipoCalculoVencimiento==='semanas')  dur=`${p.cantidadUnidades} ${p.cantidadUnidades===1?'semana':'semanas'}`;
                    if (p.tipoCalculoVencimiento==='anios')    dur=`${p.cantidadUnidades} ${p.cantidadUnidades===1?'año':'años'}`;
                    opt.textContent = `${p.nombre} - $${p.precio.toFixed(2)} (${dur})`;
                    planSelect.appendChild(opt);
                });
                const hoy = new Date();
                document.getElementById('fechaInicio').value = `${hoy.getFullYear()}-${String(hoy.getMonth()+1).padStart(2,'0')}-${String(hoy.getDate()).padStart(2,'0')}`;
                const clientesRes = await fetch('/api/Clientes');
                if (clientesRes.ok) {
                    const clientesData = await clientesRes.json();
                    todosLosClientes = clientesData.map(c => ({
                        id: c.Id||c.id, nombre: c.Nombre||c.nombre, apellido: c.Apellido||c.apellido,
                        cedula: c.Cedula||c.cedula, telefono: c.Telefono||c.telefono
                    }));
                }
            } catch (error) { console.error('Error cargando datos:', error); alert('Error al cargar planes y clientes'); }
        }

        document.getElementById('clienteBuscar').addEventListener('input', function(e) {
            clearTimeout(buscarTimeout);
            const termino = e.target.value.toLowerCase().trim();
            if (termino.length < 2) { document.getElementById('clienteResultados').classList.add('hidden'); return; }
            buscarTimeout = setTimeout(() => {
                const resultados = todosLosClientes.filter(c =>
                    c.nombre.toLowerCase().includes(termino) || c.apellido.toLowerCase().includes(termino) || c.cedula.includes(termino)
                ).slice(0, 5);
                mostrarResultados(resultados);
            }, 300);
        });

        function mostrarResultados(clientes) {
            const div = document.getElementById('clienteResultados');
            if (clientes.length === 0) {
                div.innerHTML = '<div style="padding:1rem;color:#64748B;text-align:center;font-weight:700;">No se encontraron clientes</div>';
                div.classList.remove('hidden'); return;
            }
            div.innerHTML = clientes.map(c => `
                <div onclick='seleccionarCliente(${JSON.stringify(c).replace(/'/g,"&#39;")})'
                     style="padding:.875rem 1.25rem;cursor:pointer;border-bottom:1px solid #1E2D4A;transition:background .15s;"
                     onmouseover="this.style.background='rgba(59,130,246,.07)'" onmouseout="this.style.background='transparent'">
                    <p style="font-weight:800;color:#E2E8F0;margin:0 0 .15rem 0;">${c.nombre} ${c.apellido}</p>
                    <p style="font-size:.78rem;color:#64748B;font-weight:600;margin:0;">Cédula: ${c.cedula}${c.telefono?' - Tel: '+c.telefono:''}</p>
                </div>`).join('');
            div.classList.remove('hidden');
        }

        async function seleccionarCliente(cliente) {
            try {
                const response = await fetch(`/api/Membresias/cliente/${cliente.id}`);
                if (response.ok) {
                    const membresias = await response.json();
                    const tieneActiva = membresias.some(m => (m.Estado||m.estado)==='activa');
                    if (tieneActiva && !confirm('⚠️ Este cliente ya tiene una membresía activa. ¿Desea continuar?')) return;
                }
            } catch {}
            clienteSeleccionadoId = cliente.id;
            document.getElementById('clienteId').value = cliente.id;
            document.getElementById('clienteNombre').textContent = `${cliente.nombre} ${cliente.apellido}`;
            document.getElementById('clienteCedula').textContent  = `Cédula: ${cliente.cedula}`;
            document.getElementById('clienteSeleccionado').classList.remove('hidden');
            document.getElementById('clienteResultados').classList.add('hidden');
            document.getElementById('clienteBuscar').value = '';
            lucide.createIcons();
        }

        function limpiarCliente() {
            clienteSeleccionadoId = null;
            document.getElementById('clienteId').value = '';
            document.getElementById('clienteSeleccionado').classList.add('hidden');
        }

        document.getElementById('planSelect').addEventListener('change', function() {
            planSeleccionado = planes.find(p => p.id == this.value);
            if (planSeleccionado) {
                let dur = `${planSeleccionado.duracionDias} días`;
                if (planSeleccionado.tipoCalculoVencimiento==='meses')  dur=`${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades===1?'mes':'meses'}`;
                if (planSeleccionado.tipoCalculoVencimiento==='semanas') dur=`${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades===1?'semana':'semanas'}`;
                if (planSeleccionado.tipoCalculoVencimiento==='anios')   dur=`${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades===1?'año':'años'}`;
                document.getElementById('planInfo').textContent = `${planSeleccionado.nombre} - ${dur} - $${planSeleccionado.precio.toFixed(2)}`;
                document.getElementById('planInfo').classList.remove('hidden');
                document.getElementById('precioPlan').textContent = `$${planSeleccionado.precio.toFixed(2)}`;
                document.getElementById('precioContainer').classList.remove('hidden');
                document.getElementById('montoPagado').value = planSeleccionado.precio.toFixed(2);
                const fi = document.getElementById('fechaInicio').value;
                if (fi) calcularFechaVencimiento(fi, planSeleccionado);
                calcularSaldoPendiente();
                lucide.createIcons();
            }
        });

        document.getElementById('fechaInicio').addEventListener('change', function() {
            if (planSeleccionado && this.value) calcularFechaVencimiento(this.value, planSeleccionado);
        });

        document.getElementById('montoPagado').addEventListener('input', calcularSaldoPendiente);

        function calcularSaldoPendiente() {
            if (!planSeleccionado) return;
            const precio = planSeleccionado.precio;
            const monto  = parseFloat(document.getElementById('montoPagado').value) || 0;
            const saldo  = Math.max(0, precio - monto);
            const alertDiv = document.getElementById('saldoPendienteAlert');
            if (saldo > 0 && monto > 0) {
                document.getElementById('alertTitle').textContent = '⚠️ Pago Parcial Detectado';
                document.getElementById('montoPagandoDisplay').textContent = `$${monto.toFixed(2)}`;
                document.getElementById('saldoDeberDisplay').textContent   = `$${saldo.toFixed(2)}`;
                alertDiv.classList.remove('hidden');
            } else if (monto === 0) {
                document.getElementById('alertTitle').textContent = '⚠️ Membresía Fiada Completa';
                document.getElementById('montoPagandoDisplay').textContent = '$0.00';
                document.getElementById('saldoDeberDisplay').textContent   = `$${precio.toFixed(2)}`;
                alertDiv.classList.remove('hidden');
            } else { alertDiv.classList.add('hidden'); }
        }

        function calcularFechaVencimiento(fechaInicioStr, plan) {
            const [y, m, d] = fechaInicioStr.split('-').map(Number);
            const inicio = new Date(y, m-1, d);
            let venc, texto;
            const tipo = (plan.tipoCalculoVencimiento || 'dias').toLowerCase();
            const cant = plan.cantidadUnidades || 1;
            switch (tipo) {
                case 'meses':   { let nm=m-1+cant, na=y+Math.floor(nm/12); nm=nm%12; const ul=new Date(na,nm+1,0).getDate(); venc=new Date(na,nm,Math.min(d,ul)); texto=`${cant} ${cant===1?'mes':'meses'}`; break; }
                case 'semanas': venc=new Date(inicio); venc.setDate(venc.getDate()+cant*7);  texto=`${cant} ${cant===1?'semana':'semanas'}`; break;
                case 'anios':   venc=new Date(inicio); venc.setFullYear(venc.getFullYear()+cant); texto=`${cant} ${cant===1?'año':'años'}`; break;
                default:        venc=new Date(inicio); venc.setDate(venc.getDate()+(plan.duracionDias-1)); texto=`${plan.duracionDias} días`; break;
            }
            const vy=venc.getFullYear(), vm=String(venc.getMonth()+1).padStart(2,'0'), vd=String(venc.getDate()).padStart(2,'0');
            document.getElementById('fechaVencimiento').value = `${vy}-${vm}-${vd}`;
            document.getElementById('totalDias').textContent  = texto;
            document.getElementById('fechaVencTexto').textContent = venc.toLocaleDateString('es-ES',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
            document.getElementById('duracionInfo').classList.remove('hidden');
        }

        document.getElementById('membresiaForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            if (!clienteSeleccionadoId) { alert('⚠️ Debe seleccionar un cliente'); return; }
            if (!planSeleccionado)      { alert('⚠️ Debe seleccionar un plan'); return; }
            const formData = new FormData(e.target);
            const montoPagado = parseFloat(formData.get('montoPagado'));
            const saldo = planSeleccionado.precio - montoPagado;
            if (montoPagado < 0 || montoPagado > planSeleccionado.precio) { alert('⚠️ El monto pagado debe estar entre $0 y $'+planSeleccionado.precio.toFixed(2)); return; }
            let msg = montoPagado===0 ? `¿Confirmar membresía FIADA?\n\n💰 Total: $${planSeleccionado.precio.toFixed(2)}\n🔴 Se registrará como DEUDA COMPLETA`
                    : saldo>0        ? `¿Confirmar membresía con PAGO PARCIAL?\n\n💵 Paga ahora: $${montoPagado.toFixed(2)}\n🔴 Saldo a deber: $${saldo.toFixed(2)}\n📝 Se creará deuda automáticamente`
                                     : `¿Confirmar membresía PAGADA?\n\n✅ Monto: $${montoPagado.toFixed(2)}`;
            if (!confirm(msg)) return;
            const data = { clienteId:clienteSeleccionadoId, planId:formData.get('planId'), fechaInicio:formData.get('fechaInicio'), montoPagado, metodoPago:formData.get('metodoPago'), notas:formData.get('notas')||'', usuarioId:null };
            try {
                const response = await fetch('/api/Membresias',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
                const result = await response.json();
                if (result.success) { alert(`✓ Membresía creada exitosamente${result.saldoPendiente>0?'\n\n📝 Se registró deuda de $'+result.saldoPendiente.toFixed(2):''}`); window.location.href='/membresias'; }
                else { alert('❌ Error: '+result.message); }
            } catch (error) { console.error('Error:',error); alert('❌ Error al crear membresía: '+error.message); }
        });

        document.addEventListener('click', function(e) {
            if (!e.target.closest('#clienteBuscar') && !e.target.closest('#clienteResultados'))
                document.getElementById('clienteResultados').classList.add('hidden');
        });

        document.querySelectorAll('input[type="number"]').forEach(i => i.addEventListener('wheel', e => e.preventDefault(), {passive:false}));

        document.addEventListener('DOMContentLoaded', function() { cargarPlanes(); lucide.createIcons(); });
    </script>
}

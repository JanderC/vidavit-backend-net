@{
    ViewData["Title"] = "Crear Membresía";
}

<div class="max-w-4xl mx-auto p-6">
    <div class="bg-white rounded-xl shadow-lg p-8">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Nueva Membresía</h2>

        <form id="membresiaForm" class="space-y-6">
            <!-- Seleccionar Cliente -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Cliente *</label>
                <select name="clienteId" id="clienteSelect" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                    <option value="">Seleccione un cliente...</option>
                </select>
            </div>

            <!-- Seleccionar Plan -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Plan *</label>
                <select name="planId" id="planSelect" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                    <option value="">Seleccione un plan...</option>
                </select>
                <div id="planInfo" class="mt-2 text-sm text-gray-600"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Fecha Inicio -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Fecha Inicio *</label>
                    <input type="date" name="fechaInicio" id="fechaInicio" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                </div>

                <!-- Fecha Vencimiento (calculada automáticamente) -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Fecha Vencimiento</label>
                    <input type="date" name="fechaVencimiento" id="fechaVencimiento" readonly
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100">
                </div>

                <!-- Monto Pagado -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Monto Pagado *</label>
                    <input type="number" step="0.01" name="montoPagado" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                </div>

                <!-- Método de Pago -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Método de Pago *</label>
                    <select name="metodoPago" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="transferencia">Transferencia</option>
                    </select>
                </div>
            </div>

            <!-- Notas -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Notas</label>
                <textarea name="notas" rows="2"
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary"></textarea>
            </div>

            <!-- Botones -->
            <div class="flex gap-4">
                <button type="submit"
                        class="flex-1 bg-vida-primary text-vida-dark font-bold py-3 px-6 rounded-lg hover:bg-yellow-400 transition">
                    Crear Membresía
                </button>
                <a href="/membresias"
                   class="flex-1 bg-gray-300 text-gray-700 font-bold py-3 px-6 rounded-lg hover:bg-gray-400 transition text-center">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let planes = [];

        // Cargar clientes y planes al iniciar
        async function cargarDatos() {
            try {
                // Cargar clientes
                const clientesRes = await fetch('/api/Clientes');
                const clientes = await clientesRes.json();
                const clienteSelect = document.getElementById('clienteSelect');
                clientes.forEach(c => {
                    const option = document.createElement('option');
                    option.value = c.id;
                    option.textContent = `${c.Nombre} ${c.Apellido} - ${c.Cedula}`;
                    clienteSelect.appendChild(option);
                });

                // Cargar planes
                const planesRes = await fetch('/api/Planes');
                planes = await planesRes.json();
                const planSelect = document.getElementById('planSelect');
                planes.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.Id;
                    option.textContent = `${p.Nombre} - $${p.Precio}`;
                    planSelect.appendChild(option);
                });

                // Establecer fecha inicio por defecto (hoy)
                document.getElementById('fechaInicio').valueAsDate = new Date();
            } catch (error) {
                console.error('Error cargando datos:', error);
            }
        }

        // Calcular fecha vencimiento según plan seleccionado
        document.getElementById('planSelect').addEventListener('change', function() {
            const planId = this.value;
            const plan = planes.find(p => p.Id === planId);

            if (plan) {
                document.getElementById('planInfo').textContent =
                    `Duración: ${plan.duracionDias} días - Precio: $${plan.precio}`;

                const fechaInicio = document.getElementById('fechaInicio').valueAsDate;
                if (fechaInicio) {
                    const fechaVenc = new Date(fechaInicio);
                    fechaVenc.setDate(fechaVenc.getDate() + plan.duracionDias);
                    document.getElementById('fechaVencimiento').valueAsDate = fechaVenc;
                }
            }
        });

        // Recalcular vencimiento si cambia fecha inicio
        document.getElementById('fechaInicio').addEventListener('change', function() {
            const planId = document.getElementById('planSelect').value;
            const plan = planes.find(p => p.Id === planId);

            if (plan && this.valueAsDate) {
                const fechaVenc = new Date(this.valueAsDate);
                fechaVenc.setDate(fechaVenc.getDate() + plan.duracionDias);
                document.getElementById('fechaVencimiento').valueAsDate = fechaVenc;
            }
        });

        // Enviar formulario
        document.getElementById('membresiaForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const formData = new FormData(e.target);
            const data = {
                clienteId: formData.get('clienteId'),
                planId: formData.get('planId'),
                fechaInicio: formData.get('fechaInicio'),
                fechaVencimiento: formData.get('fechaVencimiento'),
                estado: 'activa',
                montoPagado: parseFloat(formData.get('montoPagado')),
                metodoPago: formData.get('metodoPago'),
                notas: formData.get('notas') || null
            };

            try {
                const response = await fetch('/api/Membresias', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    alert('Membresía creada exitosamente');
                    window.location.href = '/membresias';
                } else {
                    alert('Error al crear membresía');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al crear membresía');
            }
        });

        // Inicializar
        cargarDatos();
    </script>
}
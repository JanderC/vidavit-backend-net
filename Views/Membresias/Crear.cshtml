@{
    ViewData["Title"] = "Crear Membresía";
    ViewData["Subtitle"] = "Nueva membresía con opción de pago parcial - TAURO GYM";
    Layout = "_AdminLayout";
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
        <div class="flex items-center gap-4 mb-8 pb-6 border-b-2 border-gray-200">
            <div class="bg-gradient-to-br from-red-600 to-red-800 rounded-xl p-4">
                <i data-lucide="credit-card" class="w-8 h-8 text-white"></i>
            </div>
            <div>
                <h2 class="text-3xl font-black text-gray-900 uppercase tracking-wide">Nueva Membresía</h2>
                <p class="text-sm text-gray-600 font-semibold mt-1">Registrar membresía con opción de pago parcial</p>
            </div>
        </div>

        <form id="membresiaForm" class="space-y-6">
            <!-- CLIENTE -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Buscar Cliente *</label>
                <div class="relative">
                    <input type="text" id="clienteBuscar" placeholder="Buscar por nombre, apellido o cédula..."
                           class="w-full px-4 py-3 pr-12 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 text-gray-900 bg-white font-semibold"
                           autocomplete="off">
                    <i data-lucide="search" class="absolute right-4 top-4 w-5 h-5 text-gray-400"></i>
                </div>

                <div id="clienteResultados" class="hidden absolute z-10 mt-1 w-full bg-white border-2 border-gray-300 rounded-xl shadow-xl max-h-64 overflow-y-auto">
                </div>

                <div id="clienteSeleccionado" class="hidden mt-3 p-5 bg-emerald-50 border-2 border-emerald-500 rounded-xl">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-black text-emerald-900 text-lg uppercase tracking-wide" id="clienteNombre"></p>
                            <p class="text-sm text-emerald-700 font-bold" id="clienteCedula"></p>
                        </div>
                        <button type="button" onclick="limpiarCliente()" class="text-red-600 hover:text-red-800 p-2 hover:bg-red-50 rounded-lg transition-all">
                            <i data-lucide="x" class="w-6 h-6"></i>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="clienteId" id="clienteId" required>
            </div>

            <!-- PLAN -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Plan *</label>
                <select name="planId" id="planSelect" required
                        class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 text-gray-900 bg-white font-semibold">
                    <option value="" class="text-gray-500">Seleccione un plan...</option>
                </select>
                <div id="planInfo" class="mt-3 p-4 bg-blue-50 border-2 border-blue-500 rounded-xl text-sm text-blue-900 font-bold hidden"></div>
            </div>

            <!-- FECHAS -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Inicio *</label>
                    <input type="date" name="fechaInicio" id="fechaInicio" required
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 text-gray-900 font-semibold">
                </div>

                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Vencimiento</label>
                    <input type="date" name="fechaVencimiento" id="fechaVencimiento" readonly
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl bg-gray-100 text-gray-900 font-semibold">
                </div>
            </div>

            <!-- PRECIO DEL PLAN (DISPLAY) -->
            <div id="precioContainer" class="hidden p-5 bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-400 rounded-xl">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-blue-700 font-bold uppercase tracking-wide">Precio Total del Plan:</p>
                        <p class="text-3xl font-black text-blue-900" id="precioPlan">$0.00</p>
                    </div>
                    <div class="bg-blue-200 p-3 rounded-xl">
                        <i data-lucide="dollar-sign" class="w-8 h-8 text-blue-700"></i>
                    </div>
                </div>
            </div>

            <!-- MONTO PAGADO Y MÉTODO -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                        Monto a Pagar Ahora *
                        <span class="text-xs text-gray-500 normal-case">(Puede pagar menos del total)</span>
                    </label>
                    <input type="number" step="0.01" min="0" name="montoPagado" id="montoPagado" required
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 text-gray-900 font-semibold text-lg">
                </div>

                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Método de Pago *</label>
                    <select name="metodoPago" required
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 text-gray-900 bg-white font-semibold">
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="transferencia">Transferencia</option>
                    </select>
                </div>
            </div>

            <!-- ALERTA DE SALDO PENDIENTE -->
            <div id="saldoPendienteAlert" class="hidden p-5 bg-gradient-to-r from-orange-50 to-red-50 border-2 border-orange-400 rounded-xl">
                <div class="flex items-start gap-4">
                    <div class="bg-orange-200 p-3 rounded-xl">
                        <i data-lucide="alert-triangle" class="w-8 h-8 text-orange-700"></i>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-black text-orange-900 text-lg uppercase tracking-wide mb-2">⚠️ Pago Parcial Detectado</h4>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm text-orange-700 font-bold">Monto a Pagar:</p>
                                <p class="text-2xl font-black text-orange-900" id="montoPagandoDisplay">$0.00</p>
                            </div>
                            <div>
                                <p class="text-sm text-red-700 font-bold">Saldo a Deber:</p>
                                <p class="text-2xl font-black text-red-600" id="saldoDeberDisplay">$0.00</p>
                            </div>
                        </div>
                        <p class="text-sm text-orange-800 font-bold mt-3 bg-orange-100 p-3 rounded-lg border border-orange-300">
                            📝 Se creará automáticamente una DEUDA por el saldo pendiente
                        </p>
                    </div>
                </div>
            </div>

            <!-- INFORMACIÓN DE DURACIÓN -->
            <div id="duracionInfo" class="hidden">
                <div class="bg-emerald-50 border-2 border-emerald-500 rounded-xl p-5">
                    <div class="flex items-center gap-2 mb-4">
                        <i data-lucide="calendar" class="w-6 h-6 text-emerald-600"></i>
                        <h4 class="font-black text-emerald-900 uppercase tracking-wide">Duración de la Membresía</h4>
                    </div>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <p class="text-emerald-700 font-bold uppercase tracking-wide">Total de días:</p>
                            <p class="font-black text-emerald-900 text-2xl" id="totalDias">-</p>
                        </div>
                        <div>
                            <p class="text-emerald-700 font-bold uppercase tracking-wide">Vence el:</p>
                            <p class="font-black text-emerald-900 text-lg" id="fechaVencTexto">-</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NOTAS -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Notas (Opcional)</label>
                <textarea name="notas" rows="2" placeholder="Ingrese notas adicionales..."
                          class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 text-gray-900 font-semibold"></textarea>
            </div>

            <!-- BOTONES -->
            <div class="flex gap-4 pt-6 border-t-2 border-gray-200">
                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black py-4 px-6 rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                    <i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i>
                    Crear Membresía
                </button>
                <a href="/membresias"
                   class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 font-black py-4 px-6 rounded-xl transition-all text-center uppercase tracking-wide">
                    <i data-lucide="x-circle" class="w-5 h-5 inline mr-2"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!-- MODAL: CONFIRMACIÓN DE MEMBRESÍA                    -->
<!-- ═══════════════════════════════════════════════════ -->
<div id="modalConfirmarMembresia" class="hidden fixed inset-0 bg-black bg-opacity-60 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg transform transition-all">
        <div class="bg-gradient-to-r from-red-600 to-red-800 text-white px-8 py-6 rounded-t-3xl">
            <h3 class="text-2xl font-black uppercase tracking-wide flex items-center gap-3">
                <i data-lucide="credit-card" class="w-7 h-7"></i>
                Confirmar Membresía
            </h3>
        </div>
        <div class="p-8 space-y-4">
            <!-- Cliente -->
            <div class="flex justify-between items-center p-4 bg-blue-50 rounded-xl border border-blue-200">
                <span class="text-sm font-black text-blue-600 uppercase">Cliente</span>
                <span class="font-black text-gray-900" id="cfm-cliente"></span>
            </div>
            <!-- Plan -->
            <div class="flex justify-between items-center p-4 bg-purple-50 rounded-xl border border-purple-200">
                <span class="text-sm font-black text-purple-600 uppercase">Plan</span>
                <span class="font-black text-gray-900" id="cfm-plan"></span>
            </div>
            <!-- Fechas -->
            <div class="grid grid-cols-2 gap-3">
                <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
                    <p class="text-xs font-black text-gray-500 uppercase">Inicio</p>
                    <p class="font-black text-gray-900" id="cfm-inicio"></p>
                </div>
                <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
                    <p class="text-xs font-black text-gray-500 uppercase">Vence</p>
                    <p class="font-black text-gray-900" id="cfm-vence"></p>
                </div>
            </div>
            <!-- Montos -->
            <div class="border-t-2 border-gray-200 pt-4 space-y-2">
                <div class="flex justify-between font-black text-lg">
                    <span class="text-gray-700">Total del Plan</span>
                    <span class="text-gray-900" id="cfm-total"></span>
                </div>
                <div class="flex justify-between font-semibold text-sm" id="cfm-pago-row">
                    <span class="text-gray-600">Paga Ahora</span>
                    <span class="text-emerald-600" id="cfm-paga-ahora"></span>
                </div>
                <div class="flex justify-between font-semibold text-sm text-red-600" id="cfm-deuda-row">
                    <span>Queda a Deber</span>
                    <span id="cfm-deuda"></span>
                </div>
            </div>
            <!-- Badge tipo pago -->
            <div class="flex items-center gap-3 p-4 rounded-xl border-2" id="cfm-tipo-badge">
                <i data-lucide="banknote" class="w-5 h-5"></i>
                <div>
                    <p class="font-black text-sm uppercase tracking-wide" id="cfm-tipo-texto"></p>
                    <p class="text-xs font-semibold" id="cfm-metodo-texto"></p>
                </div>
            </div>
        </div>
        <div class="flex gap-3 px-8 pb-8">
            <button onclick="cerrarModalConfirmarMembresia()"
                    class="flex-1 px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-900 font-black rounded-xl transition-all uppercase tracking-wide">
                Cancelar
            </button>
            <button onclick="ejecutarCrearMembresia()"
                    class="flex-1 px-6 py-3 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-lg uppercase tracking-wide">
                <i data-lucide="check" class="w-4 h-4 inline mr-2"></i>
                Confirmar
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!-- MODAL: LOADING / PROCESANDO                         -->
<!-- ═══════════════════════════════════════════════════ -->
<div id="modalLoadingMembresia" class="hidden fixed inset-0 bg-black bg-opacity-70 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-sm text-center p-10">
        <div class="relative w-20 h-20 mx-auto mb-6">
            <svg class="animate-spin w-20 h-20 text-red-600" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            <i data-lucide="credit-card" class="w-8 h-8 text-red-700 absolute inset-0 m-auto"></i>
        </div>
        <p class="text-xl font-black text-gray-900 uppercase tracking-wide mb-2">Creando Membresía</p>
        <p class="text-sm text-gray-500 font-semibold">Registrando en el sistema, por favor espere...</p>
        <div class="mt-4 w-full bg-gray-200 rounded-full h-2 overflow-hidden">
            <div class="bg-red-600 h-2 rounded-full animate-pulse" style="width:70%"></div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!-- MODAL: DETALLE / COMPROBANTE DE MEMBRESÍA CREADA   -->
<!-- ═══════════════════════════════════════════════════ -->
<div id="modalDetalleMem" class="hidden fixed inset-0 bg-black bg-opacity-60 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg">
        <!-- Header éxito -->
        <div class="bg-gradient-to-r from-emerald-500 to-emerald-700 text-white px-8 py-6 rounded-t-3xl text-center">
            <div class="w-16 h-16 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-3">
                <i data-lucide="check-circle" class="w-9 h-9 text-white"></i>
            </div>
            <h3 class="text-2xl font-black uppercase tracking-wide">¡Membresía Creada!</h3>
            <p class="text-emerald-100 text-sm font-semibold mt-1" id="det-fecha-registro"></p>
        </div>
        <!-- Body comprobante -->
        <div class="p-8 space-y-4">
            <!-- Cliente + Plan -->
            <div class="grid grid-cols-2 gap-3">
                <div class="bg-blue-50 rounded-xl p-4 border border-blue-200">
                    <p class="text-xs font-black text-blue-600 uppercase mb-1">Cliente</p>
                    <p class="font-black text-gray-900 text-sm" id="det-cliente"></p>
                </div>
                <div class="bg-purple-50 rounded-xl p-4 border border-purple-200">
                    <p class="text-xs font-black text-purple-600 uppercase mb-1">Plan</p>
                    <p class="font-black text-gray-900 text-sm" id="det-plan"></p>
                </div>
            </div>
            <!-- Fechas -->
            <div class="grid grid-cols-2 gap-3">
                <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
                    <p class="text-xs font-black text-gray-500 uppercase mb-1">Inicio</p>
                    <p class="font-bold text-gray-900 text-sm" id="det-inicio"></p>
                </div>
                <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
                    <p class="text-xs font-black text-gray-500 uppercase mb-1">Vencimiento</p>
                    <p class="font-bold text-gray-900 text-sm" id="det-vence"></p>
                </div>
            </div>
            <!-- Montos -->
            <div class="bg-gray-50 rounded-2xl p-5 border-2 border-gray-200 space-y-2">
                <div class="flex justify-between font-black text-lg">
                    <span>Total Plan</span>
                    <span class="text-gray-900" id="det-total"></span>
                </div>
                <div class="flex justify-between text-sm font-semibold border-t border-gray-200 pt-2" id="det-pagado-row">
                    <span class="text-gray-600">Pagado Ahora</span>
                    <span class="text-emerald-600" id="det-pagado"></span>
                </div>
                <div class="flex justify-between text-sm font-semibold text-red-600" id="det-deuda-row">
                    <span>Deuda Registrada</span>
                    <span id="det-deuda"></span>
                </div>
            </div>
            <!-- Método -->
            <div class="flex justify-between items-center p-4 bg-amber-50 rounded-xl border border-amber-200">
                <span class="text-sm font-black text-amber-700 uppercase">Método de Pago</span>
                <span class="font-black text-gray-900 capitalize" id="det-metodo"></span>
            </div>
            <!-- Alerta deuda si aplica -->
            <div id="det-deuda-alert" class="hidden p-4 bg-orange-50 border-2 border-orange-300 rounded-xl">
                <p class="text-sm font-black text-orange-800">
                    📝 Se generó automáticamente una deuda por el saldo pendiente en el sistema.
                </p>
            </div>
        </div>
        <!-- Footer -->
        <div class="flex gap-3 px-8 pb-8">
            <button onclick="nuevaMembresia()"
                    class="flex-1 px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-900 font-black rounded-xl transition-all uppercase tracking-wide">
                Nueva Membresía
            </button>
            <a href="/membresias"
               class="flex-1 px-6 py-3 bg-gradient-to-r from-red-600 to-red-800 text-white font-black rounded-xl transition-all shadow-lg text-center uppercase tracking-wide">
                Ir a Membresías
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let planes = [];
        let todosLosClientes = [];
        let clienteSeleccionadoId = null;
        let clienteSeleccionadoNombre = '';
        let buscarTimeout = null;
        let planSeleccionado = null;
        let _membresiaPayload = null;

        // ─── CARGA INICIAL ────────────────────────────────────────
        async function cargarPlanes() {
            try {
                let planesRes = await fetch('/api/Planes/activos');
                if (!planesRes.ok) {
                    planesRes = await fetch('/api/Planes');
                    if (!planesRes.ok) throw new Error('Error al cargar planes');
                }

                const planesData = await planesRes.json();
                planes = planesData.map(p => ({
                    id: p.Id || p.id,
                    nombre: p.Nombre || p.nombre,
                    precio: p.Precio || p.precio,
                    duracionDias: p.DuracionDias || p.duracionDias,
                    tipoCalculoVencimiento: p.TipoCalculoVencimiento || p.tipoCalculoVencimiento || 'dias',
                    cantidadUnidades: p.CantidadUnidades || p.cantidadUnidades || 1
                }));

                const planSelect = document.getElementById('planSelect');
                planes.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.id;
                    let duracionTexto = `${p.duracionDias} días`;
                    if (p.tipoCalculoVencimiento === 'meses')   duracionTexto = `${p.cantidadUnidades} ${p.cantidadUnidades === 1 ? 'mes' : 'meses'}`;
                    if (p.tipoCalculoVencimiento === 'semanas')  duracionTexto = `${p.cantidadUnidades} ${p.cantidadUnidades === 1 ? 'semana' : 'semanas'}`;
                    if (p.tipoCalculoVencimiento === 'anios')    duracionTexto = `${p.cantidadUnidades} ${p.cantidadUnidades === 1 ? 'año' : 'años'}`;
                    option.textContent = `${p.nombre} - $${p.precio.toFixed(2)} (${duracionTexto})`;
                    option.className = 'text-gray-900 font-semibold';
                    planSelect.appendChild(option);
                });

                const hoy = new Date();
                const fechaHoyLocal = `${hoy.getFullYear()}-${String(hoy.getMonth()+1).padStart(2,'0')}-${String(hoy.getDate()).padStart(2,'0')}`;
                document.getElementById('fechaInicio').value = fechaHoyLocal;

                const clientesRes = await fetch('/api/Clientes');
                if (clientesRes.ok) {
                    const clientesData = await clientesRes.json();
                    todosLosClientes = clientesData.map(c => ({
                        id: c.Id || c.id,
                        nombre: c.Nombre || c.nombre,
                        apellido: c.Apellido || c.apellido,
                        cedula: c.Cedula || c.cedula,
                        telefono: c.Telefono || c.telefono
                    }));
                }
            } catch (error) {
                console.error('Error cargando datos:', error);
                mostrarToast('Error al cargar planes y clientes', 'error');
            }
        }

        // ─── BÚSQUEDA DE CLIENTES ─────────────────────────────────
        document.getElementById('clienteBuscar').addEventListener('input', function(e) {
            clearTimeout(buscarTimeout);
            const termino = e.target.value.toLowerCase().trim();
            if (termino.length < 2) { document.getElementById('clienteResultados').classList.add('hidden'); return; }
            buscarTimeout = setTimeout(() => {
                const resultados = todosLosClientes.filter(c =>
                    c.nombre.toLowerCase().includes(termino) ||
                    c.apellido.toLowerCase().includes(termino) ||
                    c.cedula.includes(termino)
                ).slice(0, 5);
                mostrarResultados(resultados);
            }, 300);
        });

        function mostrarResultados(clientes) {
            const resultadosDiv = document.getElementById('clienteResultados');
            if (clientes.length === 0) {
                resultadosDiv.innerHTML = '<div class="p-4 text-gray-500 text-center font-bold">No se encontraron clientes</div>';
                resultadosDiv.classList.remove('hidden'); return;
            }
            resultadosDiv.innerHTML = clientes.map(c => `
                <div onclick='seleccionarCliente(${JSON.stringify(c).replace(/'/g, "&#39;")})'
                     class="p-4 hover:bg-gray-50 cursor-pointer border-b last:border-b-0 transition-all">
                    <p class="font-black text-gray-900">${c.nombre} ${c.apellido}</p>
                    <p class="text-sm text-gray-600 font-semibold">Cédula: ${c.cedula}${c.telefono ? ' - Tel: ' + c.telefono : ''}</p>
                </div>`).join('');
            resultadosDiv.classList.remove('hidden');
        }

        async function seleccionarCliente(cliente) {
            try {
                const response = await fetch(`/api/Membresias/cliente/${cliente.id}`);
                if (response.ok) {
                    const membresias = await response.json();
                    const tieneActiva = membresias.some(m => (m.Estado || m.estado) === 'activa');
                    if (tieneActiva) {
                        // Toast de advertencia no bloqueante + confirmación visual en el badge
                        mostrarToast('⚠ Este cliente ya tiene una membresía activa', 'warning');
                    }
                }
            } catch (error) {
                console.error('Error al verificar membresías:', error);
            }

            clienteSeleccionadoId = cliente.id;
            clienteSeleccionadoNombre = `${cliente.nombre} ${cliente.apellido}`;
            document.getElementById('clienteId').value = cliente.id;
            document.getElementById('clienteNombre').textContent = clienteSeleccionadoNombre;
            document.getElementById('clienteCedula').textContent = `Cédula: ${cliente.cedula}`;
            document.getElementById('clienteSeleccionado').classList.remove('hidden');
            document.getElementById('clienteResultados').classList.add('hidden');
            document.getElementById('clienteBuscar').value = '';
            lucide.createIcons();
        }

        function limpiarCliente() {
            clienteSeleccionadoId = null;
            clienteSeleccionadoNombre = '';
            document.getElementById('clienteId').value = '';
            document.getElementById('clienteSeleccionado').classList.add('hidden');
        }

        // ─── SELECCIÓN DE PLAN ────────────────────────────────────
        document.getElementById('planSelect').addEventListener('change', function() {
            const planId = this.value;
            planSeleccionado = planes.find(p => p.id == planId);
            if (planSeleccionado) {
                let duracionTexto = `${planSeleccionado.duracionDias} días`;
                if (planSeleccionado.tipoCalculoVencimiento === 'meses')   duracionTexto = `${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades === 1 ? 'mes' : 'meses'}`;
                if (planSeleccionado.tipoCalculoVencimiento === 'semanas')  duracionTexto = `${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades === 1 ? 'semana' : 'semanas'}`;
                if (planSeleccionado.tipoCalculoVencimiento === 'anios')    duracionTexto = `${planSeleccionado.cantidadUnidades} ${planSeleccionado.cantidadUnidades === 1 ? 'año' : 'años'}`;

                document.getElementById('planInfo').textContent = `${planSeleccionado.nombre} - ${duracionTexto} - $${planSeleccionado.precio.toFixed(2)}`;
                document.getElementById('planInfo').classList.remove('hidden');
                document.getElementById('precioPlan').textContent = `$${planSeleccionado.precio.toFixed(2)}`;
                document.getElementById('precioContainer').classList.remove('hidden');
                document.getElementById('montoPagado').value = planSeleccionado.precio.toFixed(2);
                document.getElementById('montoPagado').max = planSeleccionado.precio;

                const fechaInicio = document.getElementById('fechaInicio').value;
                if (fechaInicio) calcularFechaVencimiento(fechaInicio, planSeleccionado);
                calcularSaldoPendiente();
                lucide.createIcons();
            }
        });

        document.getElementById('fechaInicio').addEventListener('change', function() {
            if (planSeleccionado && this.value) calcularFechaVencimiento(this.value, planSeleccionado);
        });

        document.getElementById('montoPagado').addEventListener('input', calcularSaldoPendiente);

        function calcularSaldoPendiente() {
            if (!planSeleccionado) return;
            const precioPlan   = planSeleccionado.precio;
            const montoPagado  = parseFloat(document.getElementById('montoPagado').value) || 0;
            const saldoPendiente = Math.max(0, precioPlan - montoPagado);
            const alertDiv     = document.getElementById('saldoPendienteAlert');

            if (montoPagado === 0) {
                document.getElementById('montoPagandoDisplay').textContent = '$0.00';
                document.getElementById('saldoDeberDisplay').textContent   = `$${precioPlan.toFixed(2)}`;
                alertDiv.querySelector('h4').textContent = '⚠️ Membresía Fiada Completa';
                alertDiv.classList.remove('hidden');
            } else if (saldoPendiente > 0) {
                document.getElementById('montoPagandoDisplay').textContent = `$${montoPagado.toFixed(2)}`;
                document.getElementById('saldoDeberDisplay').textContent   = `$${saldoPendiente.toFixed(2)}`;
                alertDiv.querySelector('h4').textContent = '⚠️ Pago Parcial Detectado';
                alertDiv.classList.remove('hidden');
            } else {
                alertDiv.classList.add('hidden');
            }
            lucide.createIcons();
        }

        function calcularFechaVencimiento(fechaInicioStr, plan) {
            const [year, month, day] = fechaInicioStr.split('-').map(Number);
            const fechaInicio = new Date(year, month - 1, day);
            let fechaVenc; let duracionTexto;
            const tipo = (plan.tipoCalculoVencimiento || 'dias').toLowerCase();
            const cant = plan.cantidadUnidades || 1;

            switch (tipo) {
                case 'meses': {
                    let nuevoMes  = month - 1 + cant;
                    let nuevoAnio = year + Math.floor(nuevoMes / 12);
                    nuevoMes      = nuevoMes % 12;
                    const ultimoDia = new Date(nuevoAnio, nuevoMes + 1, 0).getDate();
                    fechaVenc    = new Date(nuevoAnio, nuevoMes, Math.min(day, ultimoDia));
                    duracionTexto = `${cant} ${cant === 1 ? 'mes' : 'meses'}`;
                    break;
                }
                case 'semanas':
                    fechaVenc = new Date(fechaInicio);
                    fechaVenc.setDate(fechaVenc.getDate() + cant * 7);
                    duracionTexto = `${cant} ${cant === 1 ? 'semana' : 'semanas'}`;
                    break;
                case 'anios':
                    fechaVenc = new Date(fechaInicio);
                    fechaVenc.setFullYear(fechaVenc.getFullYear() + cant);
                    duracionTexto = `${cant} ${cant === 1 ? 'año' : 'años'}`;
                    break;
                default:
                    fechaVenc = new Date(fechaInicio);
                    fechaVenc.setDate(fechaVenc.getDate() + (plan.duracionDias - 1));
                    duracionTexto = `${plan.duracionDias} días`;
            }

            const y2 = fechaVenc.getFullYear();
            const m2 = String(fechaVenc.getMonth() + 1).padStart(2, '0');
            const d2 = String(fechaVenc.getDate()).padStart(2, '0');
            document.getElementById('fechaVencimiento').value = `${y2}-${m2}-${d2}`;
            document.getElementById('totalDias').textContent = duracionTexto;
            document.getElementById('fechaVencTexto').textContent = fechaVenc.toLocaleDateString('es-ES', {
                weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
            });
            document.getElementById('duracionInfo').classList.remove('hidden');
        }

        // ─── ABRIR MODAL DE CONFIRMACIÓN ─────────────────────────
        document.getElementById('membresiaForm').addEventListener('submit', function(e) {
            e.preventDefault();

            if (!clienteSeleccionadoId) { mostrarToast('Debe seleccionar un cliente', 'error'); return; }
            if (!planSeleccionado)      { mostrarToast('Debe seleccionar un plan', 'error'); return; }

            const formData    = new FormData(e.target);
            const montoPagado = parseFloat(formData.get('montoPagado'));
            const metodo      = formData.get('metodoPago');
            const fechaInicio = formData.get('fechaInicio');
            const notas       = formData.get('notas') || '';
            const precioPlan  = planSeleccionado.precio;
            const saldo       = precioPlan - montoPagado;

            if (isNaN(montoPagado) || montoPagado < 0 || montoPagado > precioPlan) {
                mostrarToast(`El monto debe estar entre $0.00 y $${precioPlan.toFixed(2)}`, 'error'); return;
            }

            // Guardar payload
            _membresiaPayload = { clienteId: clienteSeleccionadoId, planId: formData.get('planId'), fechaInicio, montoPagado, metodo, notas };

            // Poblar modal confirmación
            document.getElementById('cfm-cliente').textContent = clienteSeleccionadoNombre;
            document.getElementById('cfm-plan').textContent    = planSeleccionado.nombre;
            document.getElementById('cfm-total').textContent   = `$${precioPlan.toFixed(2)}`;

            // Fechas legibles
            const fmtFecha = f => { const [y,m,d] = f.split('-'); return new Date(y,m-1,d).toLocaleDateString('es-ES',{day:'2-digit',month:'short',year:'numeric'}); };
            document.getElementById('cfm-inicio').textContent = fmtFecha(fechaInicio);
            document.getElementById('cfm-vence').textContent  = fmtFecha(document.getElementById('fechaVencimiento').value);

            const pagoRow  = document.getElementById('cfm-pago-row');
            const deudaRow = document.getElementById('cfm-deuda-row');
            if (saldo > 0) {
                pagoRow.classList.remove('hidden');
                deudaRow.classList.remove('hidden');
                document.getElementById('cfm-paga-ahora').textContent = `$${montoPagado.toFixed(2)}`;
                document.getElementById('cfm-deuda').textContent      = `$${saldo.toFixed(2)}`;
            } else {
                pagoRow.classList.add('hidden');
                deudaRow.classList.add('hidden');
            }

            // Badge tipo
            const badge = document.getElementById('cfm-tipo-badge');
            let tipoCls, tipoTxt;
            if (montoPagado === 0)     { tipoCls = 'border-red-400 bg-red-50 text-red-700';     tipoTxt = 'Fiado Completo'; }
            else if (saldo > 0)        { tipoCls = 'border-orange-400 bg-orange-50 text-orange-700'; tipoTxt = 'Pago Parcial'; }
            else                       { tipoCls = 'border-emerald-400 bg-emerald-50 text-emerald-700'; tipoTxt = 'Pago Completo'; }
            badge.className = `flex items-center gap-3 p-4 rounded-xl border-2 ${tipoCls}`;
            document.getElementById('cfm-tipo-texto').textContent   = tipoTxt;
            document.getElementById('cfm-metodo-texto').textContent = metodo.charAt(0).toUpperCase() + metodo.slice(1);

            document.getElementById('modalConfirmarMembresia').classList.remove('hidden');
            lucide.createIcons();
        });

        function cerrarModalConfirmarMembresia() {
            document.getElementById('modalConfirmarMembresia').classList.add('hidden');
        }

        // ─── EJECUTAR CREACIÓN (con loading y reintento) ──────────
        async function ejecutarCrearMembresia() {
            cerrarModalConfirmarMembresia();

            const { clienteId, planId, fechaInicio, montoPagado, metodo, notas } = _membresiaPayload;
            const precioPlan = planSeleccionado.precio;
            const saldo      = precioPlan - montoPagado;

            // Mostrar loading
            document.getElementById('modalLoadingMembresia').classList.remove('hidden');

            const data = { clienteId, planId, fechaInicio, montoPagado, metodoPago: metodo, notas, usuarioId: null };

            let result = null;
            let intentos = 0;
            while (intentos < 2) {
                try {
                    const response = await fetch('/api/Membresias', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    if (!response.ok) {
                        const err = await response.json().catch(() => ({}));
                        throw new Error(err.message || `Error HTTP ${response.status}`);
                    }
                    result = await response.json();
                    if (!result.success) throw new Error(result.message || 'Error desconocido');
                    break;
                } catch (err) {
                    intentos++;
                    if (intentos < 2) {
                        await new Promise(r => setTimeout(r, 800));
                    } else {
                        document.getElementById('modalLoadingMembresia').classList.add('hidden');
                        mostrarToast('Error al crear membresía: ' + err.message, 'error');
                        return;
                    }
                }
            }

            document.getElementById('modalLoadingMembresia').classList.add('hidden');

            // Poblar modal de detalle/comprobante
            const ahora = new Date();
            document.getElementById('det-fecha-registro').textContent = ahora.toLocaleString('es-ES');
            document.getElementById('det-cliente').textContent  = clienteSeleccionadoNombre;
            document.getElementById('det-plan').textContent     = planSeleccionado.nombre;
            document.getElementById('det-total').textContent    = `$${precioPlan.toFixed(2)}`;
            document.getElementById('det-metodo').textContent   = metodo;

            const fmtFecha = f => { const [y,m,d] = f.split('-'); return new Date(y,m-1,d).toLocaleDateString('es-ES',{day:'2-digit',month:'long',year:'numeric'}); };
            document.getElementById('det-inicio').textContent = fmtFecha(fechaInicio);
            document.getElementById('det-vence').textContent  = fmtFecha(document.getElementById('fechaVencimiento').value);

            const detPagadoRow = document.getElementById('det-pagado-row');
            const detDeudaRow  = document.getElementById('det-deuda-row');
            const detDeudaAlert = document.getElementById('det-deuda-alert');
            const deudaFinal   = result.saldoPendiente || saldo;

            if (deudaFinal > 0) {
                detPagadoRow.classList.remove('hidden');
                detDeudaRow.classList.remove('hidden');
                detDeudaAlert.classList.remove('hidden');
                document.getElementById('det-pagado').textContent = `$${montoPagado.toFixed(2)}`;
                document.getElementById('det-deuda').textContent  = `$${deudaFinal.toFixed(2)}`;
            } else {
                detPagadoRow.classList.add('hidden');
                detDeudaRow.classList.add('hidden');
                detDeudaAlert.classList.add('hidden');
            }

            document.getElementById('modalDetalleMem').classList.remove('hidden');
            lucide.createIcons();
        }

        function nuevaMembresia() {
            document.getElementById('modalDetalleMem').classList.add('hidden');
            document.getElementById('membresiaForm').reset();
            limpiarCliente();
            planSeleccionado = null;
            _membresiaPayload = null;
            document.getElementById('planInfo').classList.add('hidden');
            document.getElementById('precioContainer').classList.add('hidden');
            document.getElementById('saldoPendienteAlert').classList.add('hidden');
            document.getElementById('duracionInfo').classList.add('hidden');
            document.getElementById('fechaVencimiento').value = '';
            // Restaurar fecha de hoy
            const hoy = new Date();
            document.getElementById('fechaInicio').value = `${hoy.getFullYear()}-${String(hoy.getMonth()+1).padStart(2,'0')}-${String(hoy.getDate()).padStart(2,'0')}`;
        }

        // ─── TOAST ───────────────────────────────────────────────
        function mostrarToast(mensaje, tipo) {
            const colores = { error: 'bg-red-600', success: 'bg-green-600', warning: 'bg-amber-500', info: 'bg-blue-600' };
            const color = colores[tipo] || 'bg-gray-800';
            const toast = document.createElement('div');
            toast.className = `fixed bottom-6 right-6 z-[100] ${color} text-white px-6 py-4 rounded-2xl shadow-2xl font-bold text-sm flex items-center gap-3`;
            toast.innerHTML = `<span>${mensaje}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.4s'; setTimeout(() => toast.remove(), 400); }, 4000);
        }

        // ─── CERRAR RESULTADOS AL CLICK FUERA ────────────────────
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#clienteBuscar') && !e.target.closest('#clienteResultados'))
                document.getElementById('clienteResultados').classList.add('hidden');
        });

        // Evitar scroll en inputs numéricos
        document.querySelectorAll('input[type="number"]').forEach(function(input) {
            input.addEventListener('wheel', function(e) { e.preventDefault(); }, { passive: false });
        });

        // ─── EXPONER ─────────────────────────────────────────────
        window.seleccionarCliente           = seleccionarCliente;
        window.limpiarCliente               = limpiarCliente;
        window.ejecutarCrearMembresia       = ejecutarCrearMembresia;
        window.cerrarModalConfirmarMembresia = cerrarModalConfirmarMembresia;
        window.nuevaMembresia               = nuevaMembresia;

        // ─── INICIALIZAR ──────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function() {
            cargarPlanes();
            lucide.createIcons();
        });
    </script>
}

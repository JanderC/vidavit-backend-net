@{
    ViewData["Title"] = "Crear Membresía";
}

<div class="max-w-4xl mx-auto p-6">
    <div class="bg-white rounded-xl shadow-lg p-8">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Nueva Membresía</h2>

        <form id="membresiaForm" class="space-y-6">
            <!-- Buscar Cliente con Lupa -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Buscar Cliente *</label>
                <div class="relative">
                    <input type="text" id="clienteBuscar" placeholder="Buscar por nombre, apellido o cédula..."
                           class="w-full px-4 py-2 pr-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary text-gray-800 bg-white"
                           autocomplete="off">
                    <i data-lucide="search" class="absolute right-3 top-3 w-5 h-5 text-gray-400"></i>
                </div>
                
                <!-- Resultados de búsqueda -->
                <div id="clienteResultados" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-lg max-h-64 overflow-y-auto">
                </div>

                <!-- Cliente seleccionado -->
                <div id="clienteSeleccionado" class="hidden mt-3 p-4 bg-green-50 border border-green-200 rounded-lg">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-semibold text-green-800" id="clienteNombre"></p>
                            <p class="text-sm text-green-600" id="clienteCedula"></p>
                        </div>
                        <button type="button" onclick="limpiarCliente()" class="text-red-600 hover:text-red-800">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="clienteId" id="clienteId" required>
            </div>

            <!-- Seleccionar Plan -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Plan *</label>
                <select name="planId" id="planSelect" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary text-gray-800 bg-white">
                    <option value="" class="text-gray-500">Seleccione un plan...</option>
                </select>
                <div id="planInfo" class="mt-2 p-3 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-800 hidden"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Fecha Inicio -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Fecha Inicio *</label>
                    <input type="date" name="fechaInicio" id="fechaInicio" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary text-gray-800">
                </div>

                <!-- Fecha Vencimiento -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Fecha Vencimiento</label>
                    <input type="date" name="fechaVencimiento" id="fechaVencimiento" readonly
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 text-gray-800">
                </div>

                <!-- Monto Pagado -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Monto Pagado *</label>
                    <input type="number" step="0.01" name="montoPagado" id="montoPagado" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary text-gray-800">
                </div>

                <!-- Método de Pago -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Método de Pago *</label>
                    <select name="metodoPago" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary text-gray-800 bg-white">
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="transferencia">Transferencia</option>
                    </select>
                </div>
            </div>

            <!-- Información de Duración -->
            <div id="duracionInfo" class="hidden">
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <i data-lucide="calendar" class="w-5 h-5 text-green-600"></i>
                        <h4 class="font-semibold text-green-800">Duración de la Membresía</h4>
                    </div>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <p class="text-gray-600">Total de días:</p>
                            <p class="font-bold text-green-700" id="totalDias">-</p>
                        </div>
                        <div>
                            <p class="text-gray-600">Vence el:</p>
                            <p class="font-bold text-green-700" id="fechaVencTexto">-</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notas -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Notas (Opcional)</label>
                <textarea name="notas" rows="2" placeholder="Ingrese notas adicionales..."
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary text-gray-800"></textarea>
            </div>

            <!-- Botones -->
            <div class="flex gap-4">
                <button type="submit"
                        class="flex-1 bg-vida-primary text-vida-dark font-bold py-3 px-6 rounded-lg hover:bg-yellow-400 transition">
                    Crear Membresía
                </button>
                <a href="/membresias"
                   class="flex-1 bg-gray-300 text-gray-700 font-bold py-3 px-6 rounded-lg hover:bg-gray-400 transition text-center">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let planes = [];
        let buscarTimeout = null;
        let clienteSeleccionadoId = null;

        async function cargarPlanes() {
            try {
                const planesRes = await fetch('/api/Planes');
                if (!planesRes.ok) throw new Error('Error al cargar planes');
                
                planes = await planesRes.json();
                const planSelect = document.getElementById('planSelect');
                
                planes.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.id || p.Id;
                    option.textContent = `${p.nombre || p.Nombre} - $${p.precio || p.Precio} (${p.duracionDias || p.DuracionDias} días)`;
                    option.className = 'text-gray-800';
                    planSelect.appendChild(option);
                });

                const today = new Date();
                document.getElementById('fechaInicio').valueAsDate = today;
            } catch (error) {
                console.error('Error:', error);
                alert('Error al cargar planes');
            }
        }

        document.getElementById('clienteBuscar').addEventListener('input', function(e) {
            clearTimeout(buscarTimeout);
            const query = e.target.value.trim();

            if (query.length < 2) {
                document.getElementById('clienteResultados').classList.add('hidden');
                return;
            }

            buscarTimeout = setTimeout(async () => {
                try {
                    const response = await fetch(`/api/Membresias/buscar-clientes?q=${encodeURIComponent(query)}`);
                    const clientes = await response.json();
                    mostrarResultados(clientes);
                } catch (error) {
                    console.error('Error:', error);
                }
            }, 300);
        });

        function mostrarResultados(clientes) {
            const resultadosDiv = document.getElementById('clienteResultados');
            
            if (clientes.length === 0) {
                resultadosDiv.innerHTML = '<div class="p-4 text-gray-500 text-center">No se encontraron clientes</div>';
                resultadosDiv.classList.remove('hidden');
                return;
            }

            resultadosDiv.innerHTML = clientes.map(c => `
                <div onclick="seleccionarCliente('${c.id}', '${c.nombreCompleto}', '${c.cedula}', ${c.tieneMembresia})" 
                     class="p-3 hover:bg-gray-50 cursor-pointer border-b last:border-b-0">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-semibold text-gray-800">${c.nombreCompleto}</p>
                            <p class="text-sm text-gray-600">Cédula: ${c.cedula}${c.telefono ? ' - Tel: ' + c.telefono : ''}</p>
                        </div>
                        ${c.tieneMembresia ? '<span class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded">Activo</span>' : ''}
                    </div>
                </div>
            `).join('');

            resultadosDiv.classList.remove('hidden');
        }

        function seleccionarCliente(id, nombre, cedula, tieneMembresia) {
            if (tieneMembresia) {
                if (!confirm('Este cliente ya tiene una membresía activa. ¿Desea continuar?')) {
                    return;
                }
            }

            clienteSeleccionadoId = id;
            document.getElementById('clienteId').value = id;
            document.getElementById('clienteNombre').textContent = nombre;
            document.getElementById('clienteCedula').textContent = `Cédula: ${cedula}`;
            document.getElementById('clienteSeleccionado').classList.remove('hidden');
            document.getElementById('clienteResultados').classList.add('hidden');
            document.getElementById('clienteBuscar').value = '';
            
            lucide.createIcons();
        }

        function limpiarCliente() {
            clienteSeleccionadoId = null;
            document.getElementById('clienteId').value = '';
            document.getElementById('clienteSeleccionado').classList.add('hidden');
        }

        document.getElementById('planSelect').addEventListener('change', function() {
            const planId = this.value;
            const plan = planes.find(p => (p.id || p.Id) == planId);

            if (plan) {
                const duracion = plan.duracionDias || plan.DuracionDias;
                const precio = plan.precio || plan.Precio;
                const nombre = plan.nombre || plan.Nombre;
                
                document.getElementById('planInfo').textContent = `${nombre} - ${duracion} días - $${precio}`;
                document.getElementById('planInfo').classList.remove('hidden');
                document.getElementById('montoPagado').value = precio;

                const fechaInicio = document.getElementById('fechaInicio').valueAsDate;
                if (fechaInicio) {
                    calcularFechaVencimiento(fechaInicio, duracion);
                }
            }
        });

        document.getElementById('fechaInicio').addEventListener('change', function() {
            const planId = document.getElementById('planSelect').value;
            const plan = planes.find(p => (p.id || p.Id) == planId);

            if (plan && this.valueAsDate) {
                const duracion = plan.duracionDias || plan.DuracionDias;
                calcularFechaVencimiento(this.valueAsDate, duracion);
            }
        });

        function calcularFechaVencimiento(fechaInicio, duracionDias) {
            const fechaVenc = new Date(fechaInicio);
            fechaVenc.setDate(fechaVenc.getDate() + duracionDias);
            
            document.getElementById('fechaVencimiento').valueAsDate = fechaVenc;
            document.getElementById('totalDias').textContent = `${duracionDias} días`;
            document.getElementById('fechaVencTexto').textContent = fechaVenc.toLocaleDateString('es-ES', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            document.getElementById('duracionInfo').classList.remove('hidden');
        }

        document.getElementById('membresiaForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            if (!clienteSeleccionadoId) {
                alert('Debe seleccionar un cliente');
                return;
            }

            const formData = new FormData(e.target);
            const data = {
                clienteId: clienteSeleccionadoId,
                planId: formData.get('planId'),
                fechaInicio: formData.get('fechaInicio'),
                fechaVencimiento: formData.get('fechaVencimiento'),
                estado: 'activa',
                montoPagado: parseFloat(formData.get('montoPagado')),
                metodoPago: formData.get('metodoPago'),
                notas: formData.get('notas') || ''
            };

            try {
                const response = await fetch('/api/Membresias', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    alert('Membresía creada exitosamente');
                    window.location.href = '/membresias';
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al crear membresía');
            }
        });

        document.addEventListener('click', function(e) {
            if (!e.target.closest('#clienteBuscar') && !e.target.closest('#clienteResultados')) {
                document.getElementById('clienteResultados').classList.add('hidden');
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            cargarPlanes();
            lucide.createIcons();
        });
    </script>
}

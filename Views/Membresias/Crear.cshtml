@{
    ViewData["Title"] = "Crear Membresía";
    ViewData["Subtitle"] = "Nueva membresía con opción de pago parcial - POWER FITNESS";
    Layout = "_AdminLayout";
}

<style>
    .pf-input {
        width: 100%; padding: 13px 16px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px; color: #fff; font-size: 0.9rem; font-weight: 600;
        font-family: 'Inter', sans-serif; outline: none; transition: border-color 0.2s, box-shadow 0.2s;
    }
    .pf-input::placeholder { color: rgba(255,255,255,0.2); }
    .pf-input:focus { border-color: #1E6FE3; box-shadow: 0 0 0 3px rgba(30,111,227,0.15); }

    .pf-label {
        display: block; font-size: 0.68rem; font-weight: 800;
        letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 8px;
    }

    .pf-select {
        width: 100%; padding: 13px 16px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px; color: #fff; font-size: 0.9rem; font-weight: 600;
        font-family: 'Inter', sans-serif; outline: none; transition: border-color 0.2s;
    }
    .pf-select:focus { border-color: #1E6FE3; }
    .pf-select option { background: #0D0D20; color: #fff; }

    /* Modal overlay */
    .pf-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.75); backdrop-filter: blur(6px);
        z-index: 9999; align-items: center; justify-content: center; padding: 16px;
    }
    .pf-overlay.show { display: flex; }

    .pf-modal {
        background: #0D0D20; border: 1px solid rgba(30,111,227,0.2);
        border-radius: 20px; width: 100%; max-width: 520px;
        box-shadow: 0 32px 80px rgba(0,0,0,0.6); overflow: hidden;
    }

    .pf-modal-header {
        background: linear-gradient(135deg,#1E6FE3,#6B3FA0);
        padding: 22px 28px; text-align: center;
    }

    .cfm-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 12px 14px; border-radius: 10px;
    }

    /* Toast */
    .pf-toast {
        position: fixed; bottom: 24px; right: 24px; z-index: 10000;
        padding: 14px 20px; border-radius: 12px; font-weight: 700; font-size: 0.85rem;
        box-shadow: 0 12px 32px rgba(0,0,0,0.5); transition: opacity 0.3s;
        display: flex; align-items: center; gap: 8px;
    }

    /* Spinner */
    .btn-spinner {
        width: 15px; height: 15px; border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #fff; border-radius: 50%;
        animation: spin 0.7s linear infinite; flex-shrink: 0;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

<!-- Modal Confirmación -->
<div id="modalConfirmarMembresia" class="pf-overlay">
    <div class="pf-modal">
        <div class="pf-modal-header">
            <i data-lucide="credit-card" style="width:28px;height:28px;color:#fff;margin:0 auto 8px;display:block;"></i>
            <h3 style="font-family:'Bebas Neue',sans-serif;font-size:1.5rem;letter-spacing:3px;color:#fff;margin:0;">Confirmar Membresía</h3>
        </div>
        <div style="padding:22px 24px;display:flex;flex-direction:column;gap:10px;">
            <div class="cfm-row" style="background:rgba(30,111,227,0.08);border:1px solid rgba(30,111,227,0.15);">
                <span style="font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#3D8EFF;">Cliente</span>
                <span style="font-weight:800;color:#fff;font-size:0.9rem;" id="cfm-cliente"></span>
            </div>
            <div class="cfm-row" style="background:rgba(107,63,160,0.08);border:1px solid rgba(107,63,160,0.15);">
                <span style="font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#a78bfa;">Plan</span>
                <span style="font-weight:800;color:#fff;font-size:0.9rem;" id="cfm-plan"></span>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:12px 14px;">
                    <p style="font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 4px 0;">Inicio</p>
                    <p style="font-weight:800;color:#fff;margin:0;" id="cfm-inicio"></p>
                </div>
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:12px 14px;">
                    <p style="font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 4px 0;">Vence</p>
                    <p style="font-weight:800;color:#fff;margin:0;" id="cfm-vence"></p>
                </div>
            </div>
            <div style="border-top:1px solid rgba(255,255,255,0.06);padding-top:12px;display:flex;flex-direction:column;gap:8px;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:0.85rem;font-weight:800;color:rgba(255,255,255,0.6);">Total del Plan</span>
                    <span style="font-size:1.1rem;font-weight:900;color:#fff;" id="cfm-total"></span>
                </div>
                <div id="cfm-pago-row" style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:0.8rem;color:rgba(255,255,255,0.4);">Paga Ahora</span>
                    <span style="font-weight:800;color:#10B981;" id="cfm-paga-ahora"></span>
                </div>
                <div id="cfm-deuda-row" style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:0.8rem;color:rgba(255,255,255,0.4);">Queda a Deber</span>
                    <span style="font-weight:800;color:#F87171;" id="cfm-deuda"></span>
                </div>
            </div>
            <div id="cfm-tipo-badge" style="display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:10px;border:1px solid;">
                <i data-lucide="banknote" style="width:16px;height:16px;"></i>
                <div>
                    <p style="font-weight:800;font-size:0.78rem;text-transform:uppercase;letter-spacing:1px;margin:0;" id="cfm-tipo-texto"></p>
                    <p style="font-size:0.72rem;opacity:0.7;margin:2px 0 0 0;" id="cfm-metodo-texto"></p>
                </div>
            </div>
        </div>
        <div style="display:flex;gap:10px;padding:0 24px 24px;">
            <button onclick="cerrarModalConfirmarMembresia()"
                    style="flex:1;padding:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:10px;color:rgba(255,255,255,0.5);font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;transition:background 0.15s;"
                    onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background='rgba(255,255,255,0.04)'">
                Cancelar
            </button>
            <button onclick="ejecutarCrearMembresia()"
                    style="flex:1;padding:12px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;border:none;border-radius:10px;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;transition:opacity 0.2s;"
                    onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
                <i data-lucide="check" style="width:15px;height:15px;display:inline;margin-right:4px;"></i>
                Confirmar
            </button>
        </div>
    </div>
</div>

<!-- Modal Loading -->
<div id="modalLoadingMembresia" class="pf-overlay">
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.2);border-radius:20px;padding:40px;text-align:center;max-width:360px;width:100%;">
        <div style="width:64px;height:64px;border:4px solid rgba(30,111,227,0.2);border-left-color:#1E6FE3;border-radius:50%;margin:0 auto 20px;animation:spin 0.9s linear infinite;"></div>
        <p style="font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:3px;color:#fff;margin:0 0 8px 0;">Creando Membresía</p>
        <p style="font-size:0.8rem;color:rgba(255,255,255,0.4);font-weight:600;margin:0 0 16px 0;">Registrando en el sistema, por favor espere...</p>
        <div style="height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden;">
            <div style="height:100%;width:70%;background:linear-gradient(90deg,#1E6FE3,#6B3FA0);border-radius:2px;"></div>
        </div>
    </div>
</div>

<!-- Modal Comprobante -->
<div id="modalDetalleMem" class="pf-overlay">
    <div class="pf-modal">
        <div style="background:linear-gradient(135deg,#0E5C2E,#10B981);padding:22px 28px;border-radius:20px 20px 0 0;text-align:center;">
            <div style="width:56px;height:56px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;">
                <i data-lucide="check-circle" style="width:28px;height:28px;color:#fff;"></i>
            </div>
            <h3 style="font-family:'Bebas Neue',sans-serif;font-size:1.5rem;letter-spacing:3px;color:#fff;margin:0 0 4px 0;">¡Membresía Creada!</h3>
            <p style="font-size:0.78rem;color:rgba(255,255,255,0.65);margin:0;" id="det-fecha-registro"></p>
        </div>
        <div style="padding:22px 24px;display:flex;flex-direction:column;gap:10px;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="background:rgba(30,111,227,0.08);border:1px solid rgba(30,111,227,0.15);border-radius:10px;padding:12px 14px;">
                    <p style="font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#3D8EFF;margin:0 0 4px 0;">Cliente</p>
                    <p style="font-weight:800;color:#fff;font-size:0.85rem;margin:0;" id="det-cliente"></p>
                </div>
                <div style="background:rgba(107,63,160,0.08);border:1px solid rgba(107,63,160,0.15);border-radius:10px;padding:12px 14px;">
                    <p style="font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#a78bfa;margin:0 0 4px 0;">Plan</p>
                    <p style="font-weight:800;color:#fff;font-size:0.85rem;margin:0;" id="det-plan"></p>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:12px 14px;">
                    <p style="font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 4px 0;">Inicio</p>
                    <p style="font-weight:700;color:#fff;margin:0;font-size:0.85rem;" id="det-inicio"></p>
                </div>
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:12px 14px;">
                    <p style="font-size:0.6rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 4px 0;">Vencimiento</p>
                    <p style="font-weight:700;color:#fff;margin:0;font-size:0.85rem;" id="det-vence"></p>
                </div>
            </div>
            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:8px;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-weight:800;color:rgba(255,255,255,0.7);">Total Plan</span>
                    <span style="font-size:1.1rem;font-weight:900;color:#fff;" id="det-total"></span>
                </div>
                <div id="det-pagado-row" style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(255,255,255,0.06);padding-top:8px;">
                    <span style="font-size:0.82rem;color:rgba(255,255,255,0.4);">Pagado Ahora</span>
                    <span style="font-weight:800;color:#10B981;" id="det-pagado"></span>
                </div>
                <div id="det-deuda-row" style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:0.82rem;color:rgba(255,255,255,0.4);">Deuda Registrada</span>
                    <span style="font-weight:800;color:#F87171;" id="det-deuda"></span>
                </div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:rgba(217,119,6,0.06);border:1px solid rgba(217,119,6,0.15);border-radius:10px;">
                <span style="font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#D97706;">Método de Pago</span>
                <span style="font-weight:800;color:#fff;text-transform:capitalize;" id="det-metodo"></span>
            </div>
            <div id="det-deuda-alert" style="display:none;padding:12px 14px;background:rgba(217,119,6,0.06);border:1px solid rgba(217,119,6,0.2);border-radius:10px;">
                <p style="font-size:0.8rem;font-weight:700;color:#D97706;margin:0;">📝 Se generó automáticamente una deuda por el saldo pendiente.</p>
            </div>
        </div>
        <div style="display:flex;gap:10px;padding:0 24px 24px;">
            <button onclick="nuevaMembresia()"
                    style="flex:1;padding:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:10px;color:rgba(255,255,255,0.5);font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;transition:background 0.15s;"
                    onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background='rgba(255,255,255,0.04)'">
                Nueva Membresía
            </button>
            <a href="/membresias"
               style="flex:1;padding:12px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;border-radius:10px;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;text-align:center;display:flex;align-items:center;justify-content:center;">
                Ir a Membresías
            </a>
        </div>
    </div>
</div>

<!-- Formulario -->
<div style="max-width:860px;margin:0 auto;">
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:16px;padding:32px;">

        <!-- Header -->
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:28px;padding-bottom:24px;border-bottom:1px solid rgba(30,111,227,0.12);">
            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i data-lucide="credit-card" style="width:24px;height:24px;color:#fff;"></i>
            </div>
            <div>
                <h2 style="font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:3px;color:#fff;margin:0;line-height:1;">Nueva Membresía</h2>
                <p style="font-size:0.78rem;color:rgba(255,255,255,0.35);margin:4px 0 0 0;font-weight:600;">Registrar membresía con opción de pago parcial</p>
            </div>
        </div>

        <form id="membresiaForm" style="display:flex;flex-direction:column;gap:22px;">

            <!-- Cliente -->
            <div style="position:relative;">
                <label class="pf-label">Buscar Cliente *</label>
                <div style="position:relative;">
                    <input type="text" id="clienteBuscar" placeholder="Buscar por nombre, apellido o cédula..."
                           class="pf-input" style="padding-right:44px;" autocomplete="off">
                    <i data-lucide="search" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:rgba(255,255,255,0.25);pointer-events:none;"></i>
                </div>
                <div id="clienteResultados" style="display:none;position:absolute;z-index:20;top:100%;left:0;right:0;background:#0D0D20;border:1px solid rgba(30,111,227,0.25);border-radius:12px;box-shadow:0 12px 32px rgba(0,0,0,0.5);max-height:240px;overflow-y:auto;margin-top:4px;"></div>
                <div id="clienteSeleccionado" style="display:none;margin-top:10px;padding:14px 16px;background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.2);border-radius:12px;">
                    <div style="display:flex;align-items:center;justify-content:space-between;">
                        <div>
                            <p style="font-weight:800;color:#fff;margin:0 0 3px 0;" id="clienteNombre"></p>
                            <p style="font-size:0.78rem;color:rgba(255,255,255,0.4);margin:0;" id="clienteCedula"></p>
                        </div>
                        <button type="button" onclick="limpiarCliente()"
                                style="background:rgba(248,113,113,0.08);border:1px solid rgba(248,113,113,0.2);border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#F87171;transition:background 0.15s;"
                                onmouseover="this.style.background='rgba(248,113,113,0.18)'" onmouseout="this.style.background='rgba(248,113,113,0.08)'">
                            <i data-lucide="x" style="width:15px;height:15px;"></i>
                        </button>
                    </div>
                </div>
                <input type="hidden" name="clienteId" id="clienteId" required>
            </div>

            <!-- Plan -->
            <div>
                <label class="pf-label">Plan *</label>
                <select name="planId" id="planSelect" required class="pf-select">
                    <option value="">Seleccione un plan...</option>
                </select>
                <div id="planInfo" style="display:none;margin-top:8px;padding:12px 14px;background:rgba(30,111,227,0.06);border:1px solid rgba(30,111,227,0.18);border-radius:10px;font-size:0.82rem;color:#7EB8FF;font-weight:700;"></div>
            </div>

            <!-- Fechas -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div>
                    <label class="pf-label">Fecha Inicio *</label>
                    <input type="date" name="fechaInicio" id="fechaInicio" required class="pf-input">
                </div>
                <div>
                    <label class="pf-label">Fecha Vencimiento</label>
                    <input type="date" name="fechaVencimiento" id="fechaVencimiento" readonly
                           class="pf-input" style="opacity:0.6;cursor:not-allowed;">
                </div>
            </div>

            <!-- Precio display -->
            <div id="precioContainer" style="display:none;padding:18px 20px;background:rgba(30,111,227,0.06);border:1px solid rgba(30,111,227,0.18);border-radius:12px;display:none;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(30,111,227,0.7);margin:0 0 4px 0;">Precio Total del Plan</p>
                        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;" id="precioPlan">$0.00</p>
                    </div>
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(30,111,227,0.12);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="dollar-sign" style="width:22px;height:22px;color:#3D8EFF;"></i>
                    </div>
                </div>
            </div>

            <!-- Monto + método -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div>
                    <label class="pf-label">Monto a Pagar Ahora *
                        <span style="font-size:0.6rem;color:rgba(255,255,255,0.25);normal-case;text-transform:none;">(puede ser parcial)</span>
                    </label>
                    <input type="number" step="0.01" min="0" name="montoPagado" id="montoPagado" required
                           class="pf-input" style="font-size:1.1rem;">
                </div>
                <div>
                    <label class="pf-label">Método de Pago *</label>
                    <select name="metodoPago" required class="pf-select">
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="transferencia">Transferencia</option>
                    </select>
                </div>
            </div>

            <!-- Alerta saldo pendiente -->
            <div id="saldoPendienteAlert" style="display:none;padding:16px 18px;background:rgba(217,119,6,0.06);border:1px solid rgba(217,119,6,0.2);border-radius:12px;">
                <h4 style="font-size:0.78rem;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:#D97706;margin:0 0 12px 0;"></h4>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
                        <p style="font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.35);margin:0 0 4px 0;">Monto a Pagar</p>
                        <p style="font-size:1.4rem;font-weight:900;color:#D97706;margin:0;" id="montoPagandoDisplay">$0.00</p>
                    </div>
                    <div>
                        <p style="font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.35);margin:0 0 4px 0;">Saldo a Deber</p>
                        <p style="font-size:1.4rem;font-weight:900;color:#F87171;margin:0;" id="saldoDeberDisplay">$0.00</p>
                    </div>
                </div>
                <p style="font-size:0.78rem;color:rgba(255,255,255,0.45);font-weight:700;margin:10px 0 0 0;padding:8px 12px;background:rgba(217,119,6,0.08);border-radius:8px;">
                    📝 Se creará automáticamente una deuda por el saldo pendiente
                </p>
            </div>

            <!-- Duración info -->
            <div id="duracionInfo" style="display:none;">
                <div style="padding:16px 18px;background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.18);border-radius:12px;">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
                        <i data-lucide="calendar" style="width:16px;height:16px;color:#10B981;"></i>
                        <span style="font-size:0.68rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#10B981;">Duración de la Membresía</span>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <div>
                            <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 4px 0;">Total</p>
                            <p style="font-size:1.5rem;font-weight:900;color:#fff;margin:0;" id="totalDias">—</p>
                        </div>
                        <div>
                            <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 4px 0;">Vence el</p>
                            <p style="font-weight:700;color:rgba(255,255,255,0.8);margin:0;" id="fechaVencTexto">—</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notas -->
            <div>
                <label class="pf-label">Notas (Opcional)</label>
                <textarea name="notas" rows="2" placeholder="Ingrese notas adicionales..." class="pf-input"></textarea>
            </div>

            <!-- Botones -->
            <div style="display:flex;gap:12px;padding-top:20px;border-top:1px solid rgba(30,111,227,0.12);">
                <button type="submit"
                        style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.85rem;letter-spacing:1.5px;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer;transition:opacity 0.2s,transform 0.2s;"
                        onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.02)'"
                        onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
                    <i data-lucide="check-circle" style="width:18px;height:18px;"></i>
                    Crear Membresía
                </button>
                <a href="/membresias"
                   style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.5);font-weight:800;font-size:0.85rem;letter-spacing:1.5px;text-transform:uppercase;border:1px solid rgba(255,255,255,0.08);border-radius:12px;text-decoration:none;transition:all 0.15s;"
                   onmouseover="this.style.background='rgba(255,255,255,0.08)';this.style.color='rgba(255,255,255,0.8)'"
                   onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.color='rgba(255,255,255,0.5)'">
                    <i data-lucide="x-circle" style="width:18px;height:18px;"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let planes = [];
        let todosLosClientes = [];
        let clienteSeleccionadoId = null;
        let clienteSeleccionadoNombre = '';
        let buscarTimeout = null;
        let planSeleccionado = null;
        let _membresiaPayload = null;

        async function cargarPlanes() {
            try {
                let res = await fetch('/api/Planes/activos');
                if (!res.ok) res = await fetch('/api/Planes');
                if (!res.ok) throw new Error('Error al cargar planes');
                const data = await res.json();
                planes = data.map(p => ({
                    id: p.Id||p.id, nombre: p.Nombre||p.nombre, precio: p.Precio||p.precio,
                    duracionDias: p.DuracionDias||p.duracionDias,
                    tipoCalculoVencimiento: p.TipoCalculoVencimiento||p.tipoCalculoVencimiento||'dias',
                    cantidadUnidades: p.CantidadUnidades||p.cantidadUnidades||1
                }));
                const sel = document.getElementById('planSelect');
                planes.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    const tipo = p.tipoCalculoVencimiento.toLowerCase();
                    const cant = p.cantidadUnidades;
                    const durTxt = tipo==='meses' ? `${cant} ${cant===1?'mes':'meses'}` :
                                   tipo==='semanas' ? `${cant} ${cant===1?'semana':'semanas'}` :
                                   tipo==='anios'   ? `${cant} ${cant===1?'año':'años'}` : `${p.duracionDias} días`;
                    opt.textContent = `${p.nombre} - $${p.precio.toFixed(2)} (${durTxt})`;
                    sel.appendChild(opt);
                });
                const hoy = new Date();
                document.getElementById('fechaInicio').value = `${hoy.getFullYear()}-${String(hoy.getMonth()+1).padStart(2,'0')}-${String(hoy.getDate()).padStart(2,'0')}`;
                const cr = await fetch('/api/Clientes');
                if (cr.ok) {
                    const cd = await cr.json();
                    todosLosClientes = cd.map(c => ({
                        id:c.Id||c.id, nombre:c.Nombre||c.nombre, apellido:c.Apellido||c.apellido,
                        cedula:c.Cedula||c.cedula, telefono:c.Telefono||c.telefono
                    }));
                }
            } catch(e) { console.error(e); mostrarToast('Error al cargar planes y clientes','error'); }
        }

        document.getElementById('clienteBuscar').addEventListener('input', function(e) {
            clearTimeout(buscarTimeout);
            const t = e.target.value.toLowerCase().trim();
            if (t.length < 2) { document.getElementById('clienteResultados').style.display='none'; return; }
            buscarTimeout = setTimeout(() => {
                const r = todosLosClientes.filter(c =>
                    c.nombre.toLowerCase().includes(t)||c.apellido.toLowerCase().includes(t)||c.cedula.includes(t)
                ).slice(0,5);
                mostrarResultados(r);
            }, 300);
        });

        function mostrarResultados(clientes) {
            const div = document.getElementById('clienteResultados');
            if (!clientes.length) {
                div.innerHTML = `<div style="padding:16px;text-align:center;color:rgba(255,255,255,0.35);font-weight:600;font-size:0.85rem;">No se encontraron clientes</div>`;
            } else {
                div.innerHTML = clientes.map(c => `
                    <div onclick='seleccionarCliente(${JSON.stringify(c).replace(/'/g,"&#39;")})'
                         style="padding:14px 16px;cursor:pointer;border-bottom:1px solid rgba(255,255,255,0.05);transition:background 0.15s;"
                         onmouseover="this.style.background='rgba(30,111,227,0.08)'" onmouseout="this.style.background='transparent'">
                        <p style="font-weight:800;color:#fff;margin:0 0 2px 0;">${c.nombre} ${c.apellido}</p>
                        <p style="font-size:0.75rem;color:rgba(255,255,255,0.35);font-weight:600;margin:0;">Cédula: ${c.cedula}${c.telefono?' · '+c.telefono:''}</p>
                    </div>`).join('');
            }
            div.style.display = 'block';
        }

        async function seleccionarCliente(cliente) {
            try {
                const r = await fetch(`/api/Membresias/cliente/${cliente.id}`);
                if (r.ok) {
                    const mems = await r.json();
                    if (mems.some(m=>(m.Estado||m.estado)==='activa')) mostrarToast('⚠ Este cliente ya tiene una membresía activa','warning');
                }
            } catch {}
            clienteSeleccionadoId = cliente.id;
            clienteSeleccionadoNombre = `${cliente.nombre} ${cliente.apellido}`;
            document.getElementById('clienteId').value = cliente.id;
            document.getElementById('clienteNombre').textContent = clienteSeleccionadoNombre;
            document.getElementById('clienteCedula').textContent = `Cédula: ${cliente.cedula}`;
            document.getElementById('clienteSeleccionado').style.display = 'block';
            document.getElementById('clienteResultados').style.display = 'none';
            document.getElementById('clienteBuscar').value = '';
            lucide.createIcons();
        }

        function limpiarCliente() {
            clienteSeleccionadoId = null; clienteSeleccionadoNombre = '';
            document.getElementById('clienteId').value = '';
            document.getElementById('clienteSeleccionado').style.display = 'none';
        }

        document.getElementById('planSelect').addEventListener('change', function() {
            planSeleccionado = planes.find(p=>p.id==this.value);
            if (planSeleccionado) {
                const tipo=planSeleccionado.tipoCalculoVencimiento.toLowerCase(), cant=planSeleccionado.cantidadUnidades;
                const durTxt = tipo==='meses'?`${cant} ${cant===1?'mes':'meses'}`:tipo==='semanas'?`${cant} ${cant===1?'semana':'semanas'}`:tipo==='anios'?`${cant} ${cant===1?'año':'años'}`:`${planSeleccionado.duracionDias} días`;
                document.getElementById('planInfo').textContent = `${planSeleccionado.nombre} – ${durTxt} – $${planSeleccionado.precio.toFixed(2)}`;
                document.getElementById('planInfo').style.display = 'block';
                document.getElementById('precioPlan').textContent = `$${planSeleccionado.precio.toFixed(2)}`;
                document.getElementById('precioContainer').style.display = 'block';
                document.getElementById('montoPagado').value = planSeleccionado.precio.toFixed(2);
                document.getElementById('montoPagado').max = planSeleccionado.precio;
                const fi = document.getElementById('fechaInicio').value;
                if (fi) calcularFechaVencimiento(fi, planSeleccionado);
                calcularSaldoPendiente(); lucide.createIcons();
            }
        });

        document.getElementById('fechaInicio').addEventListener('change', function() {
            if (planSeleccionado && this.value) calcularFechaVencimiento(this.value, planSeleccionado);
        });
        document.getElementById('montoPagado').addEventListener('input', calcularSaldoPendiente);

        function calcularSaldoPendiente() {
            if (!planSeleccionado) return;
            const precio = planSeleccionado.precio;
            const monto  = parseFloat(document.getElementById('montoPagado').value)||0;
            const saldo  = Math.max(0, precio-monto);
            const alerta = document.getElementById('saldoPendienteAlert');
            const titulo = alerta.querySelector('h4');
            if (monto===0) {
                document.getElementById('montoPagandoDisplay').textContent='$0.00';
                document.getElementById('saldoDeberDisplay').textContent=`$${precio.toFixed(2)}`;
                titulo.textContent='⚠️ Membresía Fiada Completa'; titulo.style.color='#F87171';
                alerta.style.display='block';
            } else if (saldo>0) {
                document.getElementById('montoPagandoDisplay').textContent=`$${monto.toFixed(2)}`;
                document.getElementById('saldoDeberDisplay').textContent=`$${saldo.toFixed(2)}`;
                titulo.textContent='⚠️ Pago Parcial Detectado'; titulo.style.color='#D97706';
                alerta.style.display='block';
            } else { alerta.style.display='none'; }
        }

        function calcularFechaVencimiento(fechaInicioStr, plan) {
            const [year,month,day] = fechaInicioStr.split('-').map(Number);
            const tipo=(plan.tipoCalculoVencimiento||'dias').toLowerCase(), cant=plan.cantidadUnidades||1;
            let v;
            if (tipo==='meses') {
                let nm=month-1+cant, na=year+Math.floor(nm/12); nm=nm%12;
                const ult=new Date(na,nm+1,0).getDate();
                v=new Date(na,nm,Math.min(day,ult));
            } else if (tipo==='semanas') { v=new Date(year,month-1,day); v.setDate(v.getDate()+cant*7); }
            else if (tipo==='anios') { v=new Date(year,month-1,day); v.setFullYear(v.getFullYear()+cant); }
            else { v=new Date(year,month-1,day); v.setDate(v.getDate()+(plan.duracionDias-1)); }
            document.getElementById('fechaVencimiento').value=`${v.getFullYear()}-${String(v.getMonth()+1).padStart(2,'0')}-${String(v.getDate()).padStart(2,'0')}`;
            const tipo2=plan.tipoCalculoVencimiento.toLowerCase();
            const durTxt=tipo2==='meses'?`${cant} ${cant===1?'mes':'meses'}`:tipo2==='semanas'?`${cant} ${cant===1?'semana':'semanas'}`:tipo2==='anios'?`${cant} ${cant===1?'año':'años'}`:`${plan.duracionDias} días`;
            document.getElementById('totalDias').textContent=durTxt;
            document.getElementById('fechaVencTexto').textContent=v.toLocaleDateString('es-ES',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
            document.getElementById('duracionInfo').style.display='block';
        }

        document.getElementById('membresiaForm').addEventListener('submit', function(e) {
            e.preventDefault();
            if (!clienteSeleccionadoId) { mostrarToast('Debe seleccionar un cliente','error'); return; }
            if (!planSeleccionado) { mostrarToast('Debe seleccionar un plan','error'); return; }
            const fd=new FormData(e.target);
            const montoPagado=parseFloat(fd.get('montoPagado'));
            const metodo=fd.get('metodoPago'), fechaInicio=fd.get('fechaInicio'), notas=fd.get('notas')||'';
            const precio=planSeleccionado.precio, saldo=precio-montoPagado;
            if (isNaN(montoPagado)||montoPagado<0||montoPagado>precio) { mostrarToast(`El monto debe estar entre $0.00 y $${precio.toFixed(2)}`,'error'); return; }
            _membresiaPayload={clienteId:clienteSeleccionadoId, planId:fd.get('planId'), fechaInicio, montoPagado, metodo, notas};
            document.getElementById('cfm-cliente').textContent=clienteSeleccionadoNombre;
            document.getElementById('cfm-plan').textContent=planSeleccionado.nombre;
            document.getElementById('cfm-total').textContent=`$${precio.toFixed(2)}`;
            const fmt=f=>{const[y,m,d]=f.split('-');return new Date(y,m-1,d).toLocaleDateString('es-ES',{day:'2-digit',month:'short',year:'numeric'});};
            document.getElementById('cfm-inicio').textContent=fmt(fechaInicio);
            document.getElementById('cfm-vence').textContent=fmt(document.getElementById('fechaVencimiento').value);
            const pr=document.getElementById('cfm-pago-row'), dr=document.getElementById('cfm-deuda-row');
            if (saldo>0){pr.style.display='flex';dr.style.display='flex';document.getElementById('cfm-paga-ahora').textContent=`$${montoPagado.toFixed(2)}`;document.getElementById('cfm-deuda').textContent=`$${saldo.toFixed(2)}`;}
            else{pr.style.display='none';dr.style.display='none';}
            const badge=document.getElementById('cfm-tipo-badge');
            let bg,color,txt;
            if (montoPagado===0){bg='rgba(248,113,113,0.08)';color='#F87171';txt='Fiado Completo';}
            else if (saldo>0){bg='rgba(217,119,6,0.08)';color='#D97706';txt='Pago Parcial';}
            else{bg='rgba(16,185,129,0.08)';color='#10B981';txt='Pago Completo';}
            badge.style.cssText=`display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:10px;border:1px solid;background:${bg};color:${color};border-color:${color}40;`;
            document.getElementById('cfm-tipo-texto').textContent=txt;
            document.getElementById('cfm-metodo-texto').textContent=metodo.charAt(0).toUpperCase()+metodo.slice(1);
            document.getElementById('modalConfirmarMembresia').classList.add('show');
            lucide.createIcons();
        });

        function cerrarModalConfirmarMembresia() { document.getElementById('modalConfirmarMembresia').classList.remove('show'); }

        async function ejecutarCrearMembresia() {
            cerrarModalConfirmarMembresia();
            const{clienteId,planId,fechaInicio,montoPagado,metodo,notas}=_membresiaPayload;
            const precio=planSeleccionado.precio, saldo=precio-montoPagado;
            document.getElementById('modalLoadingMembresia').classList.add('show');
            const data={clienteId,planId,fechaInicio,montoPagado,metodoPago:metodo,notas,usuarioId:null};
            let result=null, intentos=0;
            while (intentos<2) {
                try {
                    const r=await fetch('/api/Membresias',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
                    if (!r.ok){const e=await r.json().catch(()=>({}));throw new Error(e.message||`Error HTTP ${r.status}`);}
                    result=await r.json();
                    if (!result.success) throw new Error(result.message||'Error desconocido');
                    break;
                } catch(err){
                    intentos++;
                    if (intentos<2){await new Promise(r=>setTimeout(r,800));}
                    else{document.getElementById('modalLoadingMembresia').classList.remove('show');mostrarToast('Error al crear membresía: '+err.message,'error');return;}
                }
            }
            document.getElementById('modalLoadingMembresia').classList.remove('show');
            const ahora=new Date();
            document.getElementById('det-fecha-registro').textContent=ahora.toLocaleString('es-ES');
            document.getElementById('det-cliente').textContent=clienteSeleccionadoNombre;
            document.getElementById('det-plan').textContent=planSeleccionado.nombre;
            document.getElementById('det-total').textContent=`$${precio.toFixed(2)}`;
            document.getElementById('det-metodo').textContent=metodo;
            const fmt=f=>{const[y,m,d]=f.split('-');return new Date(y,m-1,d).toLocaleDateString('es-ES',{day:'2-digit',month:'long',year:'numeric'});};
            document.getElementById('det-inicio').textContent=fmt(fechaInicio);
            document.getElementById('det-vence').textContent=fmt(document.getElementById('fechaVencimiento').value);
            const deudaFinal=result.saldoPendiente||saldo;
            const pr=document.getElementById('det-pagado-row'),dr=document.getElementById('det-deuda-row'),da=document.getElementById('det-deuda-alert');
            if (deudaFinal>0){pr.style.display='flex';dr.style.display='flex';da.style.display='block';document.getElementById('det-pagado').textContent=`$${montoPagado.toFixed(2)}`;document.getElementById('det-deuda').textContent=`$${deudaFinal.toFixed(2)}`;}
            else{pr.style.display='none';dr.style.display='none';da.style.display='none';}
            document.getElementById('modalDetalleMem').classList.add('show');
            lucide.createIcons();
        }

        function nuevaMembresia() {
            document.getElementById('modalDetalleMem').classList.remove('show');
            document.getElementById('membresiaForm').reset();
            limpiarCliente(); planSeleccionado=null; _membresiaPayload=null;
            document.getElementById('planInfo').style.display='none';
            document.getElementById('precioContainer').style.display='none';
            document.getElementById('saldoPendienteAlert').style.display='none';
            document.getElementById('duracionInfo').style.display='none';
            document.getElementById('fechaVencimiento').value='';
            const hoy=new Date();
            document.getElementById('fechaInicio').value=`${hoy.getFullYear()}-${String(hoy.getMonth()+1).padStart(2,'0')}-${String(hoy.getDate()).padStart(2,'0')}`;
        }

        function mostrarToast(msg, tipo) {
            const cols={error:'rgba(248,113,113,0.12)',success:'rgba(16,185,129,0.12)',warning:'rgba(217,119,6,0.12)',info:'rgba(30,111,227,0.12)'};
            const bords={error:'rgba(248,113,113,0.3)',success:'rgba(16,185,129,0.3)',warning:'rgba(217,119,6,0.3)',info:'rgba(30,111,227,0.3)'};
            const t=document.createElement('div');
            t.className='pf-toast';
            t.style.cssText=`background:${cols[tipo]||cols.info};border:1px solid ${bords[tipo]||bords.info};color:#fff;`;
            t.innerHTML=`<span>${msg}</span>`;
            document.body.appendChild(t);
            setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),300);},4000);
        }

        document.addEventListener('click', e => {
            if (!e.target.closest('#clienteBuscar')&&!e.target.closest('#clienteResultados'))
                document.getElementById('clienteResultados').style.display='none';
        });

        document.querySelectorAll('input[type="number"]').forEach(i =>
            i.addEventListener('wheel', e=>e.preventDefault(), {passive:false})
        );

        window.seleccionarCliente=seleccionarCliente; window.limpiarCliente=limpiarCliente;
        window.ejecutarCrearMembresia=ejecutarCrearMembresia;
        window.cerrarModalConfirmarMembresia=cerrarModalConfirmarMembresia;
        window.nuevaMembresia=nuevaMembresia;

        document.addEventListener('DOMContentLoaded', () => { cargarPlanes(); lucide.createIcons(); });
    </script>
}

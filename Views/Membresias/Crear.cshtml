@{
    ViewData["Title"] = "Crear Membresía";
    ViewData["Subtitle"] = "Nueva membresía con opción de pago parcial - TAURO GYM";
    Layout = "_AdminLayout";
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
        <div class="flex items-center gap-4 mb-8 pb-6 border-b-2 border-gray-200">
            <div class="bg-gradient-to-br from-blue-700 to-blue-900 rounded-xl p-4">
                <i data-lucide="credit-card" class="w-8 h-8 text-white"></i>
            </div>
            <div>
                <h2 class="text-3xl font-black text-gray-900 uppercase tracking-wide">Nueva Membresía</h2>
                <p class="text-sm text-gray-600 font-semibold mt-1">Registrar membresía con opción de pago parcial</p>
            </div>
        </div>

        <form id="membresiaForm" class="space-y-6">
            <!-- CLIENTE -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Buscar Cliente *</label>
                <div class="relative">
                    <input type="text" id="clienteBuscar" placeholder="Buscar por nombre, apellido o cédula..."
                           class="w-full px-4 py-3 pr-12 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-700 focus:border-blue-700 text-gray-900 bg-white font-semibold"
                           autocomplete="off">
                    <i data-lucide="search" class="absolute right-4 top-4 w-5 h-5 text-gray-400"></i>
                </div>

                <div id="clienteResultados" class="hidden absolute z-10 mt-1 w-full bg-white border-2 border-gray-300 rounded-xl shadow-xl max-h-64 overflow-y-auto">
                </div>

                <div id="clienteSeleccionado" class="hidden mt-3 p-5 bg-yellow-50 border-2 border-yellow-500 rounded-xl">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-black text-yellow-900 text-lg uppercase tracking-wide" id="clienteNombre"></p>
                            <p class="text-sm text-yellow-700 font-bold" id="clienteCedula"></p>
                        </div>
                        <button type="button" onclick="limpiarCliente()" class="text-red-600 hover:text-red-800 p-2 hover:bg-red-50 rounded-lg transition-all">
                            <i data-lucide="x" class="w-6 h-6"></i>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="clienteId" id="clienteId" required>
            </div>

            <!-- PLAN -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Plan *</label>
                <select name="planId" id="planSelect" required
                        class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-700 focus:border-blue-700 text-gray-900 bg-white font-semibold">
                    <option value="" class="text-gray-500">Seleccione un plan...</option>
                </select>
                <div id="planInfo" class="mt-3 p-4 bg-blue-50 border-2 border-blue-500 rounded-xl text-sm text-blue-900 font-bold hidden"></div>
            </div>

            <!-- FECHAS -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Inicio *</label>
                    <input type="date" name="fechaInicio" id="fechaInicio" required
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-700 focus:border-blue-700 text-gray-900 font-semibold">
                </div>

                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Vencimiento</label>
                    <input type="date" name="fechaVencimiento" id="fechaVencimiento" readonly
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl bg-gray-100 text-gray-900 font-semibold">
                </div>
            </div>

            <!-- PRECIO DEL PLAN (DISPLAY) -->
            <div id="precioContainer" class="hidden p-5 bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-400 rounded-xl">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-blue-700 font-bold uppercase tracking-wide">Precio Total del Plan:</p>
                        <p class="text-3xl font-black text-blue-900" id="precioPlan">$0.00</p>
                    </div>
                    <div class="bg-blue-200 p-3 rounded-xl">
                        <i data-lucide="dollar-sign" class="w-8 h-8 text-blue-700"></i>
                    </div>
                </div>
            </div>

            <!-- MONTO PAGADO Y MÉTODO -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                        Monto a Pagar Ahora *
                        <span class="text-xs text-gray-500 normal-case">(Puede pagar menos del total)</span>
                    </label>
                    <input type="number" step="0.01" min="0" name="montoPagado" id="montoPagado" required
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-700 focus:border-blue-700 text-gray-900 font-semibold text-lg">
                </div>

                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Método de Pago *</label>
                    <select name="metodoPago" required
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-700 focus:border-blue-700 text-gray-900 bg-white font-semibold">
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="transferencia">Transferencia</option>
                    </select>
                </div>
            </div>

            <!-- ALERTA DE SALDO PENDIENTE -->
            <div id="saldoPendienteAlert" class="hidden p-5 bg-gradient-to-r from-orange-50 to-red-50 border-2 border-orange-400 rounded-xl">
                <div class="flex items-start gap-4">
                    <div class="bg-orange-200 p-3 rounded-xl">
                        <i data-lucide="alert-triangle" class="w-8 h-8 text-orange-700"></i>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-black text-orange-900 text-lg uppercase tracking-wide mb-2">⚠️ Pago Parcial Detectado</h4>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm text-orange-700 font-bold">Monto a Pagar:</p>
                                <p class="text-2xl font-black text-orange-900" id="montoPagandoDisplay">$0.00</p>
                            </div>
                            <div>
                                <p class="text-sm text-red-700 font-bold">Saldo a Deber:</p>
                                <p class="text-2xl font-black text-red-600" id="saldoDeberDisplay">$0.00</p>
                            </div>
                        </div>
                        <p class="text-sm text-orange-800 font-bold mt-3 bg-orange-100 p-3 rounded-lg border border-orange-300">
                            📝 Se creará automáticamente una DEUDA por el saldo pendiente
                        </p>
                    </div>
                </div>
            </div>

            <!-- INFORMACIÓN DE DURACIÓN -->
            <div id="duracionInfo" class="hidden">
                <div class="bg-yellow-50 border-2 border-yellow-500 rounded-xl p-5">
                    <div class="flex items-center gap-2 mb-4">
                        <i data-lucide="calendar" class="w-6 h-6 text-yellow-600"></i>
                        <h4 class="font-black text-yellow-900 uppercase tracking-wide">Duración de la Membresía</h4>
                    </div>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <p class="text-yellow-700 font-bold uppercase tracking-wide">Total de días:</p>
                            <p class="font-black text-yellow-900 text-2xl" id="totalDias">-</p>
                        </div>
                        <div>
                            <p class="text-yellow-700 font-bold uppercase tracking-wide">Vence el:</p>
                            <p class="font-black text-yellow-900 text-lg" id="fechaVencTexto">-</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NOTAS -->
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Notas (Opcional)</label>
                <textarea name="notas" rows="2" placeholder="Ingrese notas adicionales..."
                          class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-700 focus:border-blue-700 text-gray-900 font-semibold"></textarea>
            </div>

            <!-- BOTONES -->
            <div class="flex gap-4 pt-6 border-t-2 border-gray-200">
                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-blue-700 to-blue-900 hover:from-blue-800 hover:to-blue-950 text-white font-black py-4 px-6 rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                    <i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i>
                    Crear Membresía
                </button>
                <a href="/membresias"
                   class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 font-black py-4 px-6 rounded-xl transition-all text-center uppercase tracking-wide">
                    <i data-lucide="x-circle" class="w-5 h-5 inline mr-2"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let planes = [];
        let todosLosClientes = [];
        let clienteSeleccionadoId = null;
        let buscarTimeout = null;
        let planSeleccionado = null;

        async function cargarPlanes() {
            try {
                let planesRes = await fetch('/api/Planes/activos');
                if (!planesRes.ok) {
                    planesRes = await fetch('/api/Planes');
                    if (!planesRes.ok) throw new Error('Error al cargar planes');
                }

                const planesData = await planesRes.json();
                planes = planesData.map(p => ({
                    id: p.Id || p.id,
                    nombre: p.Nombre || p.nombre,
                    precio: p.Precio || p.precio,
                    duracionDias: p.DuracionDias || p.duracionDias
                }));

                const planSelect = document.getElementById('planSelect');
                planes.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.id;
                    option.textContent = `${p.nombre} - $${p.precio.toFixed(2)} (${p.duracionDias} días)`;
                    option.className = 'text-gray-900 font-semibold';
                    planSelect.appendChild(option);
                });

                // Establecer fecha de hoy
                const hoy = new Date().toISOString().split('T')[0];
                document.getElementById('fechaInicio').value = hoy;

                // Cargar clientes
                const clientesRes = await fetch('/api/Clientes');
                if (clientesRes.ok) {
                    const clientesData = await clientesRes.json();
                    todosLosClientes = clientesData.map(c => ({
                        id: c.Id || c.id,
                        nombre: c.Nombre || c.nombre,
                        apellido: c.Apellido || c.apellido,
                        cedula: c.Cedula || c.cedula,
                        telefono: c.Telefono || c.telefono
                    }));
                }

            } catch (error) {
                console.error('Error cargando datos:', error);
                alert('Error al cargar planes y clientes');
            }
        }

        // Buscar cliente
        document.getElementById('clienteBuscar').addEventListener('input', function(e) {
            clearTimeout(buscarTimeout);
            const termino = e.target.value.toLowerCase().trim();

            if (termino.length < 2) {
                document.getElementById('clienteResultados').classList.add('hidden');
                return;
            }

            buscarTimeout = setTimeout(() => {
                const resultados = todosLosClientes.filter(c =>
                    c.nombre.toLowerCase().includes(termino) ||
                    c.apellido.toLowerCase().includes(termino) ||
                    c.cedula.includes(termino)
                ).slice(0, 5);

                mostrarResultados(resultados);
            }, 300);
        });

        function mostrarResultados(clientes) {
            const resultadosDiv = document.getElementById('clienteResultados');

            if (clientes.length === 0) {
                resultadosDiv.innerHTML = '<div class="p-4 text-gray-500 text-center font-bold">No se encontraron clientes</div>';
                resultadosDiv.classList.remove('hidden');
                return;
            }

            resultadosDiv.innerHTML = clientes.map(c => `
                <div onclick='seleccionarCliente(${JSON.stringify(c).replace(/'/g, "&#39;")})'
                     class="p-4 hover:bg-gray-50 cursor-pointer border-b last:border-b-0 transition-all">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-black text-gray-900">${c.nombre} ${c.apellido}</p>
                            <p class="text-sm text-gray-600 font-semibold">Cédula: ${c.cedula}${c.telefono ? ' - Tel: ' + c.telefono : ''}</p>
                        </div>
                    </div>
                </div>
            `).join('');

            resultadosDiv.classList.remove('hidden');
        }

        async function seleccionarCliente(cliente) {
            // Verificar membresía activa
            try {
                const response = await fetch(`/api/Membresias/cliente/${cliente.id}`);
                if (response.ok) {
                    const membresias = await response.json();
                    const tieneActiva = membresias.some(m => (m.Estado || m.estado) === 'activa');

                    if (tieneActiva) {
                        if (!confirm('⚠️ Este cliente ya tiene una membresía activa. ¿Desea continuar?')) {
                            return;
                        }
                    }
                }
            } catch (error) {
                console.error('Error al verificar membresías:', error);
            }

            clienteSeleccionadoId = cliente.id;
            document.getElementById('clienteId').value = cliente.id;
            document.getElementById('clienteNombre').textContent = `${cliente.nombre} ${cliente.apellido}`;
            document.getElementById('clienteCedula').textContent = `Cédula: ${cliente.cedula}`;
            document.getElementById('clienteSeleccionado').classList.remove('hidden');
            document.getElementById('clienteResultados').classList.add('hidden');
            document.getElementById('clienteBuscar').value = '';

            lucide.createIcons();
        }

        function limpiarCliente() {
            clienteSeleccionadoId = null;
            document.getElementById('clienteId').value = '';
            document.getElementById('clienteSeleccionado').classList.add('hidden');
        }

        // Seleccionar plan
        document.getElementById('planSelect').addEventListener('change', function() {
            const planId = this.value;
            planSeleccionado = planes.find(p => p.id == planId);

            if (planSeleccionado) {
                document.getElementById('planInfo').textContent = `${planSeleccionado.nombre} - ${planSeleccionado.duracionDias} días - $${planSeleccionado.precio.toFixed(2)}`;
                document.getElementById('planInfo').classList.remove('hidden');

                // Mostrar precio
                document.getElementById('precioPlan').textContent = `$${planSeleccionado.precio.toFixed(2)}`;
                document.getElementById('precioContainer').classList.remove('hidden');

                // Setear monto pagado con el precio del plan
                document.getElementById('montoPagado').value = planSeleccionado.precio.toFixed(2);
                document.getElementById('montoPagado').max = planSeleccionado.precio;

                const fechaInicio = document.getElementById('fechaInicio').value;
                if (fechaInicio) {
                    calcularFechaVencimiento(fechaInicio, planSeleccionado.duracionDias);
                }

                calcularSaldoPendiente();
                lucide.createIcons();
            }
        });

        // Cambio de fecha inicio
        document.getElementById('fechaInicio').addEventListener('change', function() {
            if (planSeleccionado && this.value) {
                calcularFechaVencimiento(this.value, planSeleccionado.duracionDias);
            }
        });

        // Calcular saldo pendiente en tiempo real
        document.getElementById('montoPagado').addEventListener('input', calcularSaldoPendiente);

        function calcularSaldoPendiente() {
            if (!planSeleccionado) return;

            const precioPlan = planSeleccionado.precio;
            const montoPagado = parseFloat(document.getElementById('montoPagado').value) || 0;
            const saldoPendiente = Math.max(0, precioPlan - montoPagado);

            const alertDiv = document.getElementById('saldoPendienteAlert');

            if (saldoPendiente > 0 && montoPagado > 0) {
                // Mostrar alerta de pago parcial
                document.getElementById('montoPagandoDisplay').textContent = `$${montoPagado.toFixed(2)}`;
                document.getElementById('saldoDeberDisplay').textContent = `$${saldoPendiente.toFixed(2)}`;
                alertDiv.classList.remove('hidden');
            } else if (montoPagado === 0) {
                // Pago completo fiado
                document.getElementById('montoPagandoDisplay').textContent = '$0.00';
                document.getElementById('saldoDeberDisplay').textContent = `$${precioPlan.toFixed(2)}`;
                alertDiv.classList.remove('hidden');
                alertDiv.querySelector('h4').textContent = '⚠️ Membresía Fiada Completa';
            } else {
                // Pago completo
                alertDiv.classList.add('hidden');
            }

            lucide.createIcons();
        }

        function calcularFechaVencimiento(fechaInicioStr, duracionDias) {
            const fechaInicio = new Date(fechaInicioStr + 'T00:00:00');
            const fechaVenc = new Date(fechaInicio);
            fechaVenc.setDate(fechaVenc.getDate() + duracionDias);

            const fechaVencStr = fechaVenc.toISOString().split('T')[0];
            document.getElementById('fechaVencimiento').value = fechaVencStr;
            document.getElementById('totalDias').textContent = `${duracionDias} días`;
            document.getElementById('fechaVencTexto').textContent = fechaVenc.toLocaleDateString('es-ES', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            document.getElementById('duracionInfo').classList.remove('hidden');
        }

        // Submit form
        document.getElementById('membresiaForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            if (!clienteSeleccionadoId) {
                alert('⚠️ Debe seleccionar un cliente');
                return;
            }

            if (!planSeleccionado) {
                alert('⚠️ Debe seleccionar un plan');
                return;
            }

            const formData = new FormData(e.target);
            const montoPagado = parseFloat(formData.get('montoPagado'));
            const precioPlan = planSeleccionado.precio;
            const saldoPendiente = precioPlan - montoPagado;

            // Validar monto
            if (montoPagado < 0 || montoPagado > precioPlan) {
                alert('⚠️ El monto pagado debe estar entre $0 y $' + precioPlan.toFixed(2));
                return;
            }

            // Confirmación
            let mensaje = '';
            if (montoPagado === 0) {
                mensaje = `¿Confirmar membresía FIADA?\n\n💰 Total: $${precioPlan.toFixed(2)}\n🔴 Se registrará como DEUDA COMPLETA`;
            } else if (saldoPendiente > 0) {
                mensaje = `¿Confirmar membresía con PAGO PARCIAL?\n\n💵 Paga ahora: $${montoPagado.toFixed(2)}\n🔴 Saldo a deber: $${saldoPendiente.toFixed(2)}\n📝 Se creará deuda automáticamente`;
            } else {
                mensaje = `¿Confirmar membresía PAGADA?\n\n✅ Monto: $${montoPagado.toFixed(2)}`;
            }

            if (!confirm(mensaje)) return;

            const data = {
                clienteId: clienteSeleccionadoId,
                planId: formData.get('planId'),
                fechaInicio: formData.get('fechaInicio'),
                fechaVencimiento: formData.get('fechaVencimiento'),
                montoPagado: montoPagado,
                metodoPago: formData.get('metodoPago'),
                notas: formData.get('notas') || '',
                usuarioId: null // TODO: Obtener del usuario logueado
            };

            try {
                const response = await fetch('/api/Membresias', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    let mensajeExito = '✓ Membresía creada exitosamente';
                    if (result.saldoPendiente > 0) {
                        mensajeExito += `\n\n📝 Se registró deuda de $${result.saldoPendiente.toFixed(2)}`;
                    }
                    alert(mensajeExito);
                    window.location.href = '/membresias';
                } else {
                    alert('❌ Error: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('❌ Error al crear membresía: ' + error.message);
            }
        });

        // Cerrar resultados al hacer clic fuera
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#clienteBuscar') && !e.target.closest('#clienteResultados')) {
                document.getElementById('clienteResultados').classList.add('hidden');
            }
        });

        // Inicializar
        document.addEventListener('DOMContentLoaded', function() {
            cargarPlanes();
            lucide.createIcons();
        });
    </script>
}

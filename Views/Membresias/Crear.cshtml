@{
    ViewData["Title"] = "Crear Membresía";
}

<div class="max-w-4xl mx-auto p-6">
    <div class="bg-white rounded-xl shadow-lg p-8">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Nueva Membresía</h2>

        <form id="membresiaForm" class="space-y-6">
            <!-- Buscar Cliente -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Buscar Cliente <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <input type="text"
                           id="buscarClienteInput"
                           placeholder="Escribe nombre, apellido o cédula..."
                           autocomplete="off"
                           class="w-full px-4 py-3 pr-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-vida-primary text-gray-800 bg-white">
                    <i data-lucide="search" class="absolute right-3 top-3.5 w-5 h-5 text-gray-400"></i>
                </div>

                <!-- Resultados de búsqueda -->
                <div id="resultadosBusqueda" class="hidden mt-2 border border-gray-300 rounded-lg bg-white shadow-lg max-h-64 overflow-y-auto">
                    <!-- Resultados se llenan aquí -->
                </div>

                <!-- Cliente seleccionado -->
                <div id="clienteSeleccionado" class="hidden mt-3 p-4 bg-green-50 border-2 border-green-300 rounded-lg">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center">
                                <i data-lucide="user-check" class="w-6 h-6 text-white"></i>
                            </div>
                            <div>
                                <p class="font-bold text-green-900" id="clienteNombre"></p>
                                <p class="text-sm text-green-700" id="clienteCedula"></p>
                                <p class="text-xs text-green-600" id="clienteTelefono"></p>
                            </div>
                        </div>
                        <button type="button" onclick="limpiarCliente()"
                                class="px-3 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition flex items-center gap-2">
                            <i data-lucide="x" class="w-4 h-4"></i>
                            Cambiar
                        </button>
                    </div>
                </div>

                <input type="hidden" name="clienteId" id="clienteId" required>
            </div>

            <!-- Seleccionar Plan -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Plan <span class="text-red-500">*</span>
                </label>
                <select name="planId" id="planSelect" required
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-vida-primary text-gray-800 bg-white">
                    <option value="">Seleccione un plan...</option>
                </select>
                <div id="planInfo" class="hidden mt-3 p-4 bg-blue-50 border-2 border-blue-300 rounded-lg">
                    <div class="flex items-center gap-2">
                        <i data-lucide="info" class="w-5 h-5 text-blue-600"></i>
                        <span class="text-sm font-medium text-blue-800" id="planInfoTexto"></span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Fecha Inicio -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Fecha Inicio <span class="text-red-500">*</span>
                    </label>
                    <input type="date" name="fechaInicio" id="fechaInicio" required
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-vida-primary text-gray-800 bg-white">
                </div>

                <!-- Fecha Vencimiento -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Fecha Vencimiento
                    </label>
                    <input type="date" name="fechaVencimiento" id="fechaVencimiento" readonly
                           class="w-full px-4 py-3 border border-gray-200 rounded-lg bg-gray-50 text-gray-700">
                </div>

                <!-- Monto Pagado -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Monto Pagado <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-4 top-3.5 text-gray-500 font-medium">$</span>
                        <input type="number" step="0.01" name="montoPagado" id="montoPagado" required
                               class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-vida-primary text-gray-800 bg-white">
                    </div>
                </div>

                <!-- Método de Pago -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Método de Pago <span class="text-red-500">*</span>
                    </label>
                    <select name="metodoPago" required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-vida-primary text-gray-800 bg-white">
                        <option value="efectivo">💵 Efectivo</option>
                        <option value="tarjeta">💳 Tarjeta</option>
                        <option value="transferencia">🏦 Transferencia</option>
                    </select>
                </div>
            </div>

            <!-- Información de Duración -->
            <div id="duracionInfo" class="hidden">
                <div class="bg-gradient-to-r from-green-50 to-blue-50 border-2 border-green-300 rounded-lg p-5">
                    <div class="flex items-center gap-2 mb-3">
                        <i data-lucide="calendar-check" class="w-6 h-6 text-green-600"></i>
                        <h4 class="font-bold text-green-900 text-lg">Duración de la Membresía</h4>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <div class="bg-white rounded-lg p-3 border border-green-200">
                            <p class="text-xs text-gray-600 mb-1">Total de días</p>
                            <p class="font-bold text-green-700 text-xl" id="totalDias">-</p>
                        </div>
                        <div class="bg-white rounded-lg p-3 border border-green-200 col-span-2">
                            <p class="text-xs text-gray-600 mb-1">Vence el</p>
                            <p class="font-bold text-green-700 text-lg" id="fechaVencTexto">-</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notas -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Notas (Opcional)
                </label>
                <textarea name="notas" rows="3" placeholder="Información adicional sobre la membresía..."
                          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-vida-primary text-gray-800 bg-white resize-none"></textarea>
            </div>

            <!-- Botones -->
            <div class="flex gap-4 pt-4">
                <button type="submit" id="btnCrear"
                        class="flex-1 bg-vida-primary hover:bg-vida-accent text-vida-dark font-bold py-3.5 px-6 rounded-lg transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                    <i data-lucide="check-circle" class="w-5 h-5"></i>
                    Crear Membresía
                </button>
                <a href="/membresias"
                   class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 font-bold py-3.5 px-6 rounded-lg transition-all text-center flex items-center justify-center gap-2">
                    <i data-lucide="x-circle" class="w-5 h-5"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let planes = [];
        let todosLosClientes = [];
        let clienteSeleccionado = null;
        let buscarTimeout = null;

        async function cargarDatos() {
            try {
                // Cargar planes activos
                const planesRes = await fetch('/api/Planes/activos');
                if (!planesRes.ok) throw new Error('Error al cargar planes');

                const planesData = await planesRes.json();
                planes = planesData.map(p => ({
                    id: p.Id || p.id,
                    nombre: p.Nombre || p.nombre,
                    precio: p.Precio || p.precio,
                    duracionDias: p.DuracionDias || p.duracionDias
                }));

                const planSelect = document.getElementById('planSelect');
                planes.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.id;
                    option.textContent = `${p.nombre} - $${p.precio.toFixed(2)} (${p.duracionDias} días)`;
                    planSelect.appendChild(option);
                });

                // Cargar todos los clientes activos
                const clientesRes = await fetch('/api/Clientes');
                if (!clientesRes.ok) throw new Error('Error al cargar clientes');

                const clientesData = await clientesRes.json();
                todosLosClientes = clientesData
                    .filter(c => c.Activo || c.activo)
                    .map(c => ({
                        id: c.Id || c.id,
                        nombre: c.Nombre || c.nombre,
                        apellido: c.Apellido || c.apellido,
                        cedula: c.Cedula || c.cedula,
                        telefono: c.Telefono || c.telefono || ''
                    }));

                // Establecer fecha de hoy
                const today = new Date().toISOString().split('T')[0];
                document.getElementById('fechaInicio').value = today;

                console.log(`Cargados ${planes.length} planes y ${todosLosClientes.length} clientes`);
            } catch (error) {
                console.error('Error:', error);
                alert('Error al cargar datos: ' + error.message);
            }
        }

        // Búsqueda de clientes
        document.getElementById('buscarClienteInput').addEventListener('input', function(e) {
            clearTimeout(buscarTimeout);
            const query = e.target.value.trim().toLowerCase();

            if (query.length < 2) {
                document.getElementById('resultadosBusqueda').classList.add('hidden');
                return;
            }

            buscarTimeout = setTimeout(() => {
                const resultados = todosLosClientes.filter(c => {
                    const nombreCompleto = `${c.nombre} ${c.apellido}`.toLowerCase();
                    return nombreCompleto.includes(query) ||
                           c.cedula.includes(query) ||
                           c.telefono.includes(query);
                }).slice(0, 10);

                mostrarResultados(resultados);
            }, 300);
        });

        function mostrarResultados(resultados) {
            const div = document.getElementById('resultadosBusqueda');

            if (resultados.length === 0) {
                div.innerHTML = `
                    <div class="p-4 text-center text-gray-500">
                        <i data-lucide="search-x" class="w-8 h-8 mx-auto mb-2 text-gray-400"></i>
                        <p>No se encontraron clientes</p>
                    </div>
                `;
                div.classList.remove('hidden');
                lucide.createIcons();
                return;
            }

            div.innerHTML = resultados.map(c => `
                <div onclick='seleccionarClienteDesdeResultado(${JSON.stringify(c).replace(/'/g, "&#39;")})'
                     class="p-4 hover:bg-gray-50 cursor-pointer border-b last:border-b-0 transition">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-semibold text-gray-800">${c.nombre} ${c.apellido}</p>
                            <p class="text-sm text-gray-600">Cédula: ${c.cedula}</p>
                            ${c.telefono ? `<p class="text-xs text-gray-500">Tel: ${c.telefono}</p>` : ''}
                        </div>
                        <i data-lucide="chevron-right" class="w-5 h-5 text-gray-400"></i>
                    </div>
                </div>
            `).join('');

            div.classList.remove('hidden');
            lucide.createIcons();
        }

        async function seleccionarClienteDesdeResultado(cliente) {
            // Verificar si tiene membresía activa
            try {
                const response = await fetch(`/api/Membresias/cliente/${cliente.id}`);
                const membresias = await response.json();
                const tieneActiva = membresias.some(m => (m.Estado || m.estado) === 'activa');

                if (tieneActiva) {
                    const confirmar = confirm(
                        `⚠️ ${cliente.nombre} ${cliente.apellido} ya tiene una membresía activa.\n\n` +
                        `¿Desea crear una nueva membresía de todas formas?`
                    );
                    if (!confirmar) return;
                }
            } catch (error) {
                console.error('Error al verificar membresías:', error);
            }

            clienteSeleccionado = cliente;
            document.getElementById('clienteId').value = cliente.id;
            document.getElementById('clienteNombre').textContent = `${cliente.nombre} ${cliente.apellido}`;
            document.getElementById('clienteCedula').textContent = `Cédula: ${cliente.cedula}`;
            document.getElementById('clienteTelefono').textContent = cliente.telefono ? `Tel: ${cliente.telefono}` : '';

            document.getElementById('clienteSeleccionado').classList.remove('hidden');
            document.getElementById('resultadosBusqueda').classList.add('hidden');
            document.getElementById('buscarClienteInput').value = '';

            lucide.createIcons();
        }

        function limpiarCliente() {
            clienteSeleccionado = null;
            document.getElementById('clienteId').value = '';
            document.getElementById('clienteSeleccionado').classList.add('hidden');
            document.getElementById('buscarClienteInput').focus();
        }

        // Evento de selección de plan
        document.getElementById('planSelect').addEventListener('change', function() {
            const planId = this.value;
            const plan = planes.find(p => p.id == planId);

            if (plan) {
                document.getElementById('planInfoTexto').textContent =
                    `${plan.nombre} - Duración: ${plan.duracionDias} días - Precio: $${plan.precio.toFixed(2)}`;
                document.getElementById('planInfo').classList.remove('hidden');
                document.getElementById('montoPagado').value = plan.precio.toFixed(2);

                const fechaInicio = document.getElementById('fechaInicio').value;
                if (fechaInicio) {
                    calcularFechaVencimiento(fechaInicio, plan.duracionDias);
                }
            } else {
                document.getElementById('planInfo').classList.add('hidden');
            }
            lucide.createIcons();
        });

        // Evento de cambio de fecha inicio
        document.getElementById('fechaInicio').addEventListener('change', function() {
            const planId = document.getElementById('planSelect').value;
            const plan = planes.find(p => p.id == planId);

            if (plan && this.value) {
                calcularFechaVencimiento(this.value, plan.duracionDias);
            }
        });

        function calcularFechaVencimiento(fechaInicioStr, duracionDias) {
            const fechaInicio = new Date(fechaInicioStr + 'T00:00:00');
            const fechaVenc = new Date(fechaInicio);
            fechaVenc.setDate(fechaVenc.getDate() + duracionDias);

            const fechaVencStr = fechaVenc.toISOString().split('T')[0];
            document.getElementById('fechaVencimiento').value = fechaVencStr;
            document.getElementById('totalDias').textContent = `${duracionDias} días`;
            document.getElementById('fechaVencTexto').textContent = fechaVenc.toLocaleDateString('es-DO', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            document.getElementById('duracionInfo').classList.remove('hidden');
            lucide.createIcons();
        }

        // Submit del formulario
        document.getElementById('membresiaForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            if (!clienteSeleccionado) {
                alert('⚠️ Debe seleccionar un cliente');
                document.getElementById('buscarClienteInput').focus();
                return;
            }

            const formData = new FormData(e.target);
            const data = {
                clienteId: clienteSeleccionado.id,
                planId: formData.get('planId'),
                fechaInicio: formData.get('fechaInicio'),
                fechaVencimiento: formData.get('fechaVencimiento'),
                estado: 'activa',
                montoPagado: parseFloat(formData.get('montoPagado')),
                metodoPago: formData.get('metodoPago'),
                notas: formData.get('notas') || ''
            };

            const btn = document.getElementById('btnCrear');
            const btnTexto = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader" class="w-5 h-5 animate-spin"></i> Creando...';
            lucide.createIcons();

            try {
                const response = await fetch('/api/Membresias', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    alert('✅ Membresía creada exitosamente');
                    window.location.href = '/membresias';
                } else {
                    alert('❌ Error: ' + (result.message || 'No se pudo crear la membresía'));
                    btn.disabled = false;
                    btn.innerHTML = btnTexto;
                    lucide.createIcons();
                }
            } catch (error) {
                console.error('Error:', error);
                alert('❌ Error al crear membresía: ' + error.message);
                btn.disabled = false;
                btn.innerHTML = btnTexto;
                lucide.createIcons();
            }
        });

        // Cerrar resultados al hacer clic fuera
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#buscarClienteInput') && !e.target.closest('#resultadosBusqueda')) {
                document.getElementById('resultadosBusqueda').classList.add('hidden');
            }
        });

        // Inicializar
        document.addEventListener('DOMContentLoaded', function() {
            cargarDatos();
            lucide.createIcons();
        });
    </script>
}

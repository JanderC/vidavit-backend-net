@page
@model VidaFit.Pages.Caja.HistorialModel
@{
    ViewData["Title"] = "Historial de deuda";
    Layout = "_Layout";
}

@section Styles {
<style>
    :root {
        --h-radius: 10px;
        --h-vencida: #b91c1c;
        --h-vencida-bg: #fef2f2;
        --h-pendiente: #b45309;
        --h-pendiente-bg: #fffbeb;
        --h-pagada: #15803d;
        --h-pagada-bg: #f0fdf4;
        --font-num: 'JetBrains Mono', 'Fira Mono', monospace;
    }

    .hist-page { padding: 1.5rem 2rem 3rem; max-width: 900px; margin: 0 auto; }

    /* ── Breadcrumb ─────────────────────────────────────────────── */
    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: #9ca3af;
        margin-bottom: 1.5rem;
    }
    .breadcrumb a { color: #6366f1; text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    /* ── Header de la deuda ─────────────────────────────────────── */
    .hist-header {
        background: #fff;
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 14px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .hist-header-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }
    .hist-cliente-row { display: flex; align-items: center; gap: 0.75rem; }
    .hist-avatar {
        width: 48px; height: 48px; border-radius: 50%;
        background: #e0e7ff; color: #4f46e5;
        font-size: 1rem; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .hist-cliente-nombre { font-size: 1.1rem; font-weight: 700; color: #111; }
    .hist-cliente-cedula { font-size: 0.8rem; color: #9ca3af; margin-top: 0.15rem; }
    .hist-concepto {
        font-size: 0.8rem; color: #9ca3af;
        margin-top: 0.3rem;
        display: flex; align-items: center; gap: 0.4rem;
    }

    /* ── Métricas de la deuda ───────────────────────────────────── */
    .hist-metricas {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 0.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid #f3f4f6;
    }
    .hist-metrica { text-align: center; }
    .hist-metrica-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: #9ca3af; margin: 0; }
    .hist-metrica-valor { font-size: 1.3rem; font-weight: 700; font-family: var(--font-num); color: #111; margin: 0.2rem 0 0; }
    .hist-metrica-valor.vencida { color: var(--h-vencida); }
    .hist-metrica-valor.pagada { color: var(--h-pagada); }
    .hist-metrica-valor.pendiente { color: var(--h-pendiente); }

    /* Barra de progreso grande */
    .hist-progress-wrap { margin: 1.25rem 0 0; }
    .hist-progress-label {
        display: flex; justify-content: space-between;
        font-size: 0.75rem; color: #9ca3af; margin-bottom: 0.4rem;
    }
    .hist-progress-bar-bg {
        background: #f3f4f6; border-radius: 99px; height: 8px; overflow: hidden;
    }
    .hist-progress-bar-fill {
        height: 100%; border-radius: 99px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        transition: width 0.5s ease;
    }
    .hist-progress-bar-fill.completo { background: linear-gradient(90deg, #16a34a, #22c55e); }

    /* ── Chip estado ────────────────────────────────────────────── */
    .estado-chip {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.3rem 0.8rem;
        border-radius: 99px; font-size: 0.75rem; font-weight: 600;
    }
    .estado-chip::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; display: inline-block; }
    .estado-chip.vencida { background: var(--h-vencida-bg); color: var(--h-vencida); }
    .estado-chip.pendiente { background: var(--h-pendiente-bg); color: var(--h-pendiente); }
    .estado-chip.pagada { background: var(--h-pagada-bg); color: var(--h-pagada); }

    /* ── Acciones rápidas ───────────────────────────────────────── */
    .hist-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .btn-hist {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.55rem 1rem;
        border-radius: 8px; border: 1px solid #e5e7eb;
        font-size: 0.8rem; font-weight: 600; cursor: pointer;
        background: transparent; color: #374151;
        transition: all 0.15s;
    }
    .btn-hist:hover { background: #f3f4f6; }
    .btn-hist.primary { background: #111; color: #fff; border-color: transparent; }
    .btn-hist.primary:hover { background: #374151; }
    .btn-hist:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── Timeline de abonos ─────────────────────────────────────── */
    .hist-section-title {
        font-size: 0.8rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.07em; color: #9ca3af;
        margin: 0 0 1rem;
    }
    .timeline { position: relative; padding-left: 1.5rem; }
    .timeline::before {
        content: ''; position: absolute; left: 6px; top: 0; bottom: 0;
        width: 1px; background: #e5e7eb;
    }
    .timeline-item {
        position: relative;
        margin-bottom: 1rem;
        background: #fff;
        border: 1px solid rgba(0,0,0,0.07);
        border-radius: var(--h-radius);
        padding: 1rem 1.25rem;
        transition: box-shadow 0.15s;
    }
    .timeline-item:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .timeline-dot {
        position: absolute;
        left: -1.5rem;
        top: 1.2rem;
        width: 12px; height: 12px;
        background: #6366f1;
        border: 2px solid #fff;
        border-radius: 50%;
        box-shadow: 0 0 0 1px #e5e7eb;
        transform: translateX(-6px);
    }
    .timeline-item:last-child .timeline-dot { background: #16a34a; }
    .timeline-header {
        display: flex; align-items: center; justify-content: space-between;
        gap: 0.75rem; flex-wrap: wrap;
    }
    .tl-fecha { font-size: 0.75rem; color: #9ca3af; }
    .tl-monto { font-family: var(--font-num); font-size: 1.05rem; font-weight: 700; color: #16a34a; }
    .tl-meta { font-size: 0.75rem; color: #6b7280; margin-top: 0.3rem; }
    .tl-saldo-tras {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.2rem 0.6rem;
        background: #f3f4f6;
        border-radius: 6px;
        font-size: 0.72rem;
        color: #6b7280;
        font-family: var(--font-num);
    }
    .tl-badge-metodo {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.15rem 0.55rem;
        background: #eff6ff; color: #1d4ed8;
        border-radius: 99px; font-size: 0.72rem; font-weight: 600;
    }

    /* ── Sin abonos ─────────────────────────────────────────────── */
    .no-abonos {
        text-align: center; padding: 3rem 2rem;
        background: #fff; border: 1px dashed #e5e7eb; border-radius: var(--h-radius);
        color: #9ca3af;
    }

    /* ── Modal abono ────────────────────────────────────────────── */
    .modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.35); z-index: 1000;
        align-items: center; justify-content: center;
        backdrop-filter: blur(2px);
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
        background: #fff; border-radius: 16px; padding: 2rem;
        width: 100%; max-width: 440px; margin: 1rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        animation: modalIn 0.2s cubic-bezier(.4,0,.2,1);
    }
    @@keyframes modalIn {
        from { transform: scale(0.95) translateY(8px); opacity: 0; }
        to { transform: scale(1) translateY(0); opacity: 1; }
    }
    .modal-title { font-size: 1rem; font-weight: 700; margin: 0 0 1.25rem; color: #111; }
    .form-group { margin-bottom: 1rem; }
    .form-label { display: block; font-size: 0.8rem; font-weight: 600; color: #374151; margin-bottom: 0.35rem; }
    .form-input {
        width: 100%; padding: 0.6rem 0.85rem; border: 1px solid #e5e7eb;
        border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;
        transition: border-color 0.15s;
    }
    .form-input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
    .modal-actions { display: flex; gap: 0.75rem; margin-top: 1.25rem; justify-content: flex-end; }
    .btn-cancelar { padding: 0.6rem 1.1rem; border: 1px solid #e5e7eb; border-radius: 8px; background: transparent; cursor: pointer; font-size: 0.875rem; color: #374151; }
    .btn-confirmar { padding: 0.6rem 1.3rem; border: none; border-radius: 8px; background: #111; color: #fff; font-size: 0.875rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; }
    .btn-confirmar:disabled { opacity: 0.6; cursor: not-allowed; }

    .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.7s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ── Toast ──────────────────────────────────────────────────── */
    #toast-hist {
        position: fixed; top: 1.5rem; right: 1.5rem;
        background: #111; color: #fff;
        padding: 0.85rem 1.25rem; border-radius: 10px;
        font-size: 0.875rem; font-weight: 500; z-index: 9999;
        box-shadow: 0 8px 30px rgba(0,0,0,0.2);
        transform: translateY(-10px) scale(0.97); opacity: 0;
        transition: all 0.25s cubic-bezier(.4,0,.2,1); pointer-events: none;
    }
    #toast-hist.show { transform: translateY(0) scale(1); opacity: 1; }
    #toast-hist.success { background: #15803d; }
    #toast-hist.error { background: #b91c1c; }
    #toast-hist.warning { background: #b45309; }

    /* ── Loading ─────────────────────────────────────────────────── */
    .loading-state { text-align: center; padding: 4rem 2rem; color: #9ca3af; }
    .sk-loader { display: inline-block; width: 24px; height: 24px; border: 2px solid #e5e7eb; border-top-color: #6366f1; border-radius: 50%; animation: spin 0.7s linear infinite; }
</style>
}

<div class="hist-page">

    <!-- ── Breadcrumb ───────────────────────────────────────────── -->
    <nav class="breadcrumb">
        <a href="/Caja"><i class="bi bi-cash-stack me-1"></i>Caja</a>
        <i class="bi bi-chevron-right" style="font-size:0.7rem"></i>
        <span>Historial de deuda</span>
    </nav>

    <!-- ── Loading state ────────────────────────────────────────── -->
    <div id="loading-state" class="loading-state">
        <div class="sk-loader"></div>
        <p style="margin-top:1rem">Cargando historial…</p>
    </div>

    <!-- ── Contenido (oculto hasta carga) ───────────────────────── -->
    <div id="hist-contenido" style="display:none">

        <!-- Header de la deuda -->
        <div class="hist-header">
            <div class="hist-header-top">
                <div>
                    <div class="hist-cliente-row">
                        <div class="hist-avatar" id="h-avatar">—</div>
                        <div>
                            <div class="hist-cliente-nombre" id="h-nombre">—</div>
                            <div class="hist-cliente-cedula" id="h-cedula">—</div>
                        </div>
                    </div>
                    <div class="hist-concepto">
                        <i class="bi bi-tag"></i>
                        <span id="h-concepto">—</span>
                    </div>
                </div>
                <div style="display:flex;align-items:flex-start;gap:0.75rem;flex-wrap:wrap">
                    <span id="h-estado-chip" class="estado-chip">—</span>
                    <div class="hist-actions">
                        <button class="btn-hist primary" id="btn-abonar" onclick="abrirModalAbono()">
                            <i class="bi bi-cash-coin"></i> Registrar abono
                        </button>
                        <button class="btn-hist" onclick="history.back()">
                            <i class="bi bi-arrow-left"></i> Volver
                        </button>
                    </div>
                </div>
            </div>

            <!-- Métricas -->
            <div class="hist-metricas">
                <div class="hist-metrica">
                    <p class="hist-metrica-label">Monto total</p>
                    <p class="hist-metrica-valor" id="hm-total">—</p>
                </div>
                <div class="hist-metrica">
                    <p class="hist-metrica-label">Pagado</p>
                    <p class="hist-metrica-valor pagada" id="hm-pagado">—</p>
                </div>
                <div class="hist-metrica">
                    <p class="hist-metrica-label">Saldo</p>
                    <p class="hist-metrica-valor" id="hm-saldo">—</p>
                </div>
                <div class="hist-metrica">
                    <p class="hist-metrica-label">Abonos realizados</p>
                    <p class="hist-metrica-valor" id="hm-abonos">—</p>
                </div>
                <div class="hist-metrica">
                    <p class="hist-metrica-label">Fecha creación</p>
                    <p class="hist-metrica-valor" style="font-size:0.9rem" id="hm-fecha">—</p>
                </div>
                <div class="hist-metrica" id="hm-vence-wrap">
                    <p class="hist-metrica-label">Vencimiento</p>
                    <p class="hist-metrica-valor" style="font-size:0.9rem" id="hm-vence">—</p>
                </div>
            </div>

            <!-- Barra de progreso -->
            <div class="hist-progress-wrap" id="h-progress-wrap">
                <div class="hist-progress-label">
                    <span>Progreso de pago</span>
                    <span id="h-progress-pct">0%</span>
                </div>
                <div class="hist-progress-bar-bg">
                    <div class="hist-progress-bar-fill" id="h-progress-bar" style="width:0%"></div>
                </div>
            </div>
        </div>

        <!-- Timeline de abonos -->
        <p class="hist-section-title">Historial de abonos</p>
        <div id="hist-timeline">
            <div class="no-abonos">
                <i class="bi bi-inbox" style="font-size:2rem"></i>
                <p style="margin-top:0.75rem;font-size:0.875rem">No hay abonos registrados para esta deuda</p>
            </div>
        </div>

    </div>
</div>

<!-- ── Toast ─────────────────────────────────────────────────────── -->
<div id="toast-hist"></div>

<!-- ── Modal abono ────────────────────────────────────────────────── -->
<div class="modal-overlay" id="modal-abono">
    <div class="modal-box">
        <p class="modal-title"><i class="bi bi-cash-coin me-2"></i>Registrar abono</p>

        <div class="form-group">
            <label class="form-label">Monto *</label>
            <input type="number" id="ab-monto" class="form-input" placeholder="0.00" min="0.01" step="0.01" />
            <div style="margin-top:0.4rem;display:flex;gap:0.3rem;flex-wrap:wrap">
                <button class="btn-pago" onclick="pRapido(25)" style="padding:.25rem .65rem;border:1px solid #e5e7eb;border-radius:6px;font-size:.72rem;cursor:pointer;background:transparent">25%</button>
                <button class="btn-pago" onclick="pRapido(50)" style="padding:.25rem .65rem;border:1px solid #e5e7eb;border-radius:6px;font-size:.72rem;cursor:pointer;background:transparent">50%</button>
                <button class="btn-pago" onclick="pRapido(75)" style="padding:.25rem .65rem;border:1px solid #e5e7eb;border-radius:6px;font-size:.72rem;cursor:pointer;background:transparent">75%</button>
                <button class="btn-pago" onclick="pRapido(100)" style="padding:.25rem .65rem;border:1px solid #e5e7eb;border-radius:6px;font-size:.72rem;cursor:pointer;background:transparent">Saldo total</button>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Método de pago</label>
            <select id="ab-metodo" class="form-input">
                <option value="efectivo">Efectivo</option>
                <option value="tarjeta">Tarjeta</option>
                <option value="transferencia">Transferencia</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Notas <span style="color:#9ca3af">(opcional)</span></label>
            <input type="text" id="ab-notas" class="form-input" placeholder="Observación del abono…" />
        </div>
        <div class="modal-actions">
            <button class="btn-cancelar" onclick="cerrarModalAbono()">Cancelar</button>
            <button class="btn-confirmar" id="btn-confirmar-abono" onclick="confirmarAbono()">
                <i class="bi bi-check-lg"></i> Confirmar abono
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    /* ═══════════════════════════════════════════════════════════
       ESTADO GLOBAL
    ═══════════════════════════════════════════════════════════ */
    let deudaData = null;
    const deudaId = new URLSearchParams(window.location.search).get('deudaId');

    /* ═══════════════════════════════════════════════════════════
       INICIALIZACIÓN
    ═══════════════════════════════════════════════════════════ */
    document.addEventListener('DOMContentLoaded', () => {
        if (!deudaId) {
            document.getElementById('loading-state').innerHTML =
                '<div style="color:#ef4444"><i class="bi bi-exclamation-circle"></i> ID de deuda no especificado</div>';
            return;
        }
        cargarHistorial();
    });

    /* ═══════════════════════════════════════════════════════════
       CARGA DE DATOS
    ═══════════════════════════════════════════════════════════ */
    async function cargarHistorial() {
        try {
            const r = await fetch(`/api/HistorialDeuda/${deudaId}`);
            const d = await r.json();
            if (!d.success) throw new Error(d.message);

            deudaData = d;
            renderizarHistorial(d);

        } catch(e) {
            document.getElementById('loading-state').innerHTML = `
                <div style="color:#ef4444">
                    <i class="bi bi-exclamation-circle" style="font-size:2rem"></i>
                    <p style="margin-top:0.75rem">${esc(e.message || 'Error al cargar historial')}</p>
                    <button onclick="cargarHistorial()" style="margin-top:1rem;padding:.5rem 1rem;border:1px solid #e5e7eb;border-radius:6px;cursor:pointer">Reintentar</button>
                </div>`;
        }
    }

    /* ═══════════════════════════════════════════════════════════
       RENDERIZADO
    ═══════════════════════════════════════════════════════════ */
    function renderizarHistorial(d) {
        const deuda = d.deuda;

        // ✅ FIX: calcular estado real en cliente también
        const estadoReal = calcularEstadoReal(deuda);

        // Header
        const iniciales = deuda.cliente.nombre.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase();
        document.getElementById('h-avatar').textContent = iniciales;
        document.getElementById('h-nombre').textContent = deuda.cliente.nombre;
        document.getElementById('h-cedula').textContent = deuda.cliente.cedula;
        document.getElementById('h-concepto').textContent = deuda.concepto;

        // Chip de estado
        const chip = document.getElementById('h-estado-chip');
        chip.textContent = estadoReal.charAt(0).toUpperCase() + estadoReal.slice(1);
        chip.className = `estado-chip ${estadoReal}`;

        // Ocultar botón abonar si pagada/cancelada
        if (estadoReal === 'pagada' || estadoReal === 'cancelada') {
            document.getElementById('btn-abonar').style.display = 'none';
        }

        // Métricas
        document.getElementById('hm-total').textContent  = fmt(deuda.montoTotal);
        document.getElementById('hm-pagado').textContent = fmt(deuda.montoPagado);

        const saldoEl = document.getElementById('hm-saldo');
        saldoEl.textContent = fmt(deuda.saldo);
        saldoEl.className = `hist-metrica-valor ${estadoReal}`;

        document.getElementById('hm-abonos').textContent = d.totalAbonos;
        document.getElementById('hm-fecha').textContent  = fmtFecha(deuda.fechaCreacion);

        if (deuda.fechaVencimiento) {
            const vEl = document.getElementById('hm-vence');
            const dias = diasHasta(deuda.fechaVencimiento);
            vEl.textContent = fmtFecha(deuda.fechaVencimiento);
            if (dias < 0) vEl.className = 'hist-metrica-valor vencida';
        } else {
            document.getElementById('hm-vence-wrap').style.display = 'none';
        }

        // Barra progreso
        const pct = deuda.montoTotal > 0
            ? Math.min(100, (deuda.montoPagado / deuda.montoTotal) * 100)
            : 0;
        const bar = document.getElementById('h-progress-bar');
        bar.style.width = pct.toFixed(1) + '%';
        if (pct >= 100) bar.classList.add('completo');
        document.getElementById('h-progress-pct').textContent = pct.toFixed(0) + '%';

        // Timeline de abonos
        renderizarTimeline(d.abonos);

        // Mostrar contenido
        document.getElementById('loading-state').style.display = 'none';
        document.getElementById('hist-contenido').style.display = 'block';
    }

    function renderizarTimeline(abonos) {
        const el = document.getElementById('hist-timeline');

        if (!abonos || !abonos.length) {
            el.innerHTML = `
                <div class="no-abonos">
                    <i class="bi bi-inbox" style="font-size:2rem"></i>
                    <p style="margin-top:0.75rem;font-size:0.875rem">No hay abonos registrados aún</p>
                </div>`;
            return;
        }

        // Invertir para mostrar más reciente primero
        const abonosOrdenados = [...abonos].reverse();

        el.innerHTML = `<div class="timeline">
            ${abonosOrdenados.map((a, i) => `
            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-header">
                    <div>
                        <span class="tl-monto">+${fmt(a.monto)}</span>
                        <span class="tl-badge-metodo">
                            <i class="bi bi-${iconoMetodo(a.metodoPago)}"></i>
                            ${a.metodoPago}
                        </span>
                    </div>
                    <span class="tl-fecha">${fmtFechaHora(a.fecha)}</span>
                </div>
                <div class="tl-meta">
                    ${a.descripcion ? `<span>${esc(a.descripcion)}</span>` : ''}
                    <span class="tl-saldo-tras">
                        <i class="bi bi-arrow-right" style="font-size:0.65rem"></i>
                        Saldo: ${fmt(a.saldoTrasAbono)}
                    </span>
                </div>
            </div>
            `).join('')}
        </div>`;
    }

    /* ═══════════════════════════════════════════════════════════
       FIX VENCIDAS: calcular estado real en cliente
    ═══════════════════════════════════════════════════════════ */
    function calcularEstadoReal(deuda) {
        if (deuda.estado === 'pagada' || deuda.estado === 'cancelada') return deuda.estado;
        if (deuda.fechaVencimiento && diasHasta(deuda.fechaVencimiento) < 0 && deuda.saldo > 0)
            return 'vencida';
        return deuda.estado;
    }

    /* ═══════════════════════════════════════════════════════════
       MODAL ABONO
    ═══════════════════════════════════════════════════════════ */
    function abrirModalAbono() {
        document.getElementById('modal-abono').classList.add('open');
        document.getElementById('ab-monto').focus();
    }
    function cerrarModalAbono() {
        document.getElementById('modal-abono').classList.remove('open');
        document.getElementById('ab-monto').value = '';
        document.getElementById('ab-notas').value = '';
    }
    function pRapido(pct) {
        if (!deudaData) return;
        document.getElementById('ab-monto').value =
            (deudaData.deuda.saldo * pct / 100).toFixed(2);
    }

    async function confirmarAbono() {
        const monto  = parseFloat(document.getElementById('ab-monto').value);
        const metodo = document.getElementById('ab-metodo').value;
        const notas  = document.getElementById('ab-notas').value.trim();

        if (!monto || monto <= 0) return toast('El monto debe ser mayor a 0', 'warning');
        if (deudaData && monto > deudaData.deuda.saldo)
            return toast(`El monto supera el saldo (${fmt(deudaData.deuda.saldo)})`, 'warning');

        const btn = document.getElementById('btn-confirmar-abono');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span> Registrando…';

        try {
            const r = await fetch('/api/HistorialDeuda/abonar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    deudaId,
                    monto,
                    metodoPago: metodo,
                    notas: notas || null
                })
            });
            const d = await r.json();
            if (!d.success) throw new Error(d.message);

            toast(d.message, 'success');
            cerrarModalAbono();
            await cargarHistorial();  // Recargar para mostrar nuevo abono

        } catch(e) {
            toast(e.message || 'Error al registrar abono', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-lg"></i> Confirmar abono';
        }
    }

    /* ═══════════════════════════════════════════════════════════
       UTILIDADES
    ═══════════════════════════════════════════════════════════ */
    function fmt(n) {
        return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(n || 0);
    }
    function fmtFecha(iso) {
        if (!iso) return '—';
        return new Date(iso).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
    }
    function fmtFechaHora(iso) {
        if (!iso) return '—';
        return new Date(iso).toLocaleString('es-ES', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }
    function diasHasta(iso) {
        if (!iso) return null;
        const hoy = new Date(); hoy.setHours(0,0,0,0);
        return Math.round((new Date(iso) - hoy) / 86400000);
    }
    function esc(s) {
        const d = document.createElement('div');
        d.textContent = s || '';
        return d.innerHTML;
    }
    function iconoMetodo(m) {
        const map = { efectivo: 'cash', tarjeta: 'credit-card', transferencia: 'bank' };
        return map[m] || 'cash';
    }

    let toastT = null;
    function toast(msg, tipo = 'success') {
        const t = document.getElementById('toast-hist');
        t.textContent = msg;
        t.className = `show ${tipo}`;
        clearTimeout(toastT);
        toastT = setTimeout(() => t.classList.remove('show'), 3500);
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarModalAbono(); });
    document.getElementById('modal-abono').addEventListener('click', function(e) {
        if (e.target === this) cerrarModalAbono();
    });
</script>
}

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reportes";
    ViewData["Subtitle"] = "Análisis y estadísticas - TAURO GYM";
}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <a href="/reportes/asistencia" class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-all transform hover:scale-105 border-2 border-gray-200">
        <div class="flex items-center gap-4">
            <div class="w-20 h-20 bg-blue-100 rounded-2xl flex items-center justify-center">
                <i data-lucide="activity" class="w-10 h-10 text-blue-600"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-xl font-black text-gray-900 uppercase tracking-wide">Asistencia</h3>
                <p class="text-sm text-gray-600 font-semibold">Análisis de check-ins y visitas</p>
            </div>
            <i data-lucide="chevron-right" class="w-6 h-6 text-gray-400"></i>
        </div>
    </a>

    <a href="/reportes/ingresos" class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-all transform hover:scale-105 border-2 border-gray-200">
        <div class="flex items-center gap-4">
            <div class="w-20 h-20 bg-yellow-100 rounded-2xl flex items-center justify-center">
                <i data-lucide="dollar-sign" class="w-10 h-10 text-yellow-600"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-xl font-black text-gray-900 uppercase tracking-wide">Ingresos</h3>
                <p class="text-sm text-gray-600 font-semibold">Reporte financiero y pagos</p>
            </div>
            <i data-lucide="chevron-right" class="w-6 h-6 text-gray-400"></i>
        </div>
    </a>

    <a href="/reportes/clientes-inactivos" class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-all transform hover:scale-105 border-2 border-gray-200">
        <div class="flex items-center gap-4">
            <div class="w-20 h-20 bg-gray-100 rounded-2xl flex items-center justify-center">
                <i data-lucide="user-x" class="w-10 h-10 text-gray-600"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-xl font-black text-gray-900 uppercase tracking-wide">Clientes Inactivos</h3>
                <p class="text-sm text-gray-600 font-semibold">Seguimiento de clientes</p>
            </div>
            <i data-lucide="chevron-right" class="w-6 h-6 text-gray-400"></i>
        </div>
    </a>

    <a href="/reportes/productos-mas-vendidos" class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-all transform hover:scale-105 border-2 border-gray-200">
        <div class="flex items-center gap-4">
            <div class="w-20 h-20 bg-amber-100 rounded-2xl flex items-center justify-center">
                <i data-lucide="package" class="w-10 h-10 text-amber-600"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-xl font-black text-gray-900 uppercase tracking-wide">Productos</h3>
                <p class="text-sm text-gray-600 font-semibold">Más vendidos</p>
            </div>
            <i data-lucide="chevron-right" class="w-6 h-6 text-gray-400"></i>
        </div>
    </a>

    <a href="/reportes/ingresos-membresias" class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-all transform hover:scale-105 border-2 border-gray-200">
        <div class="flex items-center gap-4">
            <div class="w-20 h-20 bg-red-100 rounded-2xl flex items-center justify-center">
                <i data-lucide="credit-card" class="w-10 h-10 text-blue-700"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-xl font-black text-gray-900 uppercase tracking-wide">Membresías</h3>
                <p class="text-sm text-gray-600 font-semibold">Ingresos por membresías</p>
            </div>
            <i data-lucide="chevron-right" class="w-6 h-6 text-gray-400"></i>
        </div>
    </a>

    <a href="/reportes/cuentas-pendientes" class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-all transform hover:scale-105 border-2 border-gray-200">
        <div class="flex items-center gap-4">
            <div class="w-20 h-20 bg-orange-100 rounded-2xl flex items-center justify-center">
                <i data-lucide="alert-circle" class="w-10 h-10 text-orange-600"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-xl font-black text-gray-900 uppercase tracking-wide">Cuentas Pendientes</h3>
                <p class="text-sm text-gray-600 font-semibold">Productos fiados</p>
            </div>
            <i data-lucide="chevron-right" class="w-6 h-6 text-gray-400"></i>
        </div>
    </a>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}

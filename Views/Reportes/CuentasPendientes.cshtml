@{
    ViewData["Title"] = "Cuentas Pendientes";
    ViewData["Subtitle"] = "Productos Fiados - ELITE GYM";
    Layout = "_AdminLayout";
}

<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-4xl font-black text-gray-900 uppercase tracking-wide">Productos Fiados</h2>
        <a href="/productos"
           class="bg-gray-300 hover:bg-gray-400 text-gray-900 font-black py-3 px-8 rounded-xl transition-all uppercase tracking-wide">
            Volver
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white rounded-2xl shadow-xl p-8 border-l-4 border-orange-600">
            <p class="text-gray-600 text-sm font-black uppercase tracking-wide mb-2">Total Pendiente</p>
            <p class="text-4xl font-black text-orange-600" id="totalPendiente">$0.00</p>
        </div>
        <div class="bg-white rounded-2xl shadow-xl p-8 border-l-4 border-red-600">
            <p class="text-gray-600 text-sm font-black uppercase tracking-wide mb-2">Clientes con Deuda</p>
            <p class="text-4xl font-black text-gray-900" id="clientesConDeuda">0</p>
        </div>
        <div class="bg-white rounded-2xl shadow-xl p-8 border-l-4 border-blue-600">
            <p class="text-gray-600 text-sm font-black uppercase tracking-wide mb-2">Productos Fiados</p>
            <p class="text-4xl font-black text-gray-900" id="productosFiados">0</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
        <div class="p-6 border-b-2 border-gray-200">
            <input type="text" id="buscarCliente" placeholder="Buscar cliente..."
                   class="w-full px-5 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
        </div>
        <div id="cuentasList" class="divide-y-2 divide-gray-200">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cuentasPendientes = [];

        async function cargarCuentas() {
            try {
                const response = await fetch('/api/VentasProductos');
                const ventas = await response.json();

                console.log('Ventas cargadas:', ventas.length);
                console.log('Primera venta:', ventas[0]);

                const pendientes = ventas.filter(v => v.EstadoPago === 'pendiente');
                console.log('Ventas pendientes:', pendientes.length);

                const porCliente = {};
                pendientes.forEach(v => {
                    if (!porCliente[v.ClienteId]) {
                        porCliente[v.ClienteId] = {
                            cliente: v.Cliente,
                            ventas: [],
                            total: 0
                        };
                    }
                    porCliente[v.ClienteId].ventas.push(v);
                    porCliente[v.ClienteId].total += v.Total;
                });

                cuentasPendientes = Object.values(porCliente);

                const totalPendiente = cuentasPendientes.reduce((sum, c) => sum + c.total, 0);
                document.getElementById('totalPendiente').textContent = `$${totalPendiente.toFixed(2)}`;
                document.getElementById('clientesConDeuda').textContent = cuentasPendientes.length;
                document.getElementById('productosFiados').textContent = pendientes.length;

                renderCuentas(cuentasPendientes);
            } catch (error) {
                console.error('Error cargando cuentas:', error);
            }
        }

        function renderCuentas(cuentas) {
            const container = document.getElementById('cuentasList');

            if (cuentas.length === 0) {
                container.innerHTML = '<p class="text-center text-gray-500 py-12 font-bold text-lg">No hay cuentas pendientes</p>';
                return;
            }

            container.innerHTML = cuentas.map(cuenta => `
                <div class="p-8 hover:bg-gray-50 transition-colors">
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h3 class="text-2xl font-black text-gray-900 uppercase tracking-wide">
                                ${cuenta.cliente.Nombre} ${cuenta.cliente.Apellido}
                            </h3>
                            <p class="text-sm text-gray-600 font-bold mt-1">${cuenta.cliente.Cedula}</p>
                        </div>
                        <div class="text-right">
                            <p class="text-3xl font-black text-orange-600">$${cuenta.total.toFixed(2)}</p>
                            <button onclick="marcarComoPagado('${cuenta.cliente.Id}')"
                                    class="mt-3 bg-gradient-to-r from-emerald-600 to-emerald-800 hover:from-emerald-700 hover:to-emerald-900 text-white px-6 py-3 rounded-xl font-black uppercase tracking-wide shadow-lg">
                                Marcar Pagado
                            </button>
                        </div>
                    </div>
                    <div class="space-y-3">
                        ${cuenta.ventas.map(v => `
                            <div class="flex justify-between items-center text-sm bg-gray-50 p-4 rounded-xl border-2 border-gray-200">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="package" class="w-5 h-5 text-gray-400"></i>
                                    <span class="font-black text-gray-900">${v.Producto.Nombre}</span>
                                    <span class="text-gray-600 font-bold">x${v.Cantidad}</span>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="font-black text-gray-900 text-lg">$${v.Total.toFixed(2)}</span>
                                    <span class="text-xs text-gray-500 font-semibold">${new Date(v.FechaVenta).toLocaleDateString()}</span>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `).join('');

            lucide.createIcons();
        }

        async function marcarComoPagado(clienteId) {
            if (!confirm('¿Marcar todas las deudas de este cliente como pagadas?')) return;

            try {
                const cuenta = cuentasPendientes.find(c => c.cliente.Id === clienteId);

                for (const venta of cuenta.ventas) {
                    await fetch(`/api/VentasProductos/${venta.Id}/marcar-pagado`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                }

                alert('✓ Deuda marcada como pagada');
                cargarCuentas();
            } catch (error) {
                console.error('Error:', error);
                alert('Error al actualizar el pago');
            }
        }

        document.getElementById('buscarCliente').addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase();
            const filtradas = cuentasPendientes.filter(c =>
                c.cliente.Nombre.toLowerCase().includes(query) ||
                c.cliente.Apellido.toLowerCase().includes(query) ||
                c.cliente.Cedula.includes(query)
            );
            renderCuentas(filtradas);
        });

        window.marcarComoPagado = marcarComoPagado;
        cargarCuentas();
        lucide.createIcons();
    </script>
}

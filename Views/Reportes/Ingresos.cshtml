@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reporte de Ingresos";
    ViewData["Subtitle"] = "Análisis financiero completo - JONELGYM";
}

<div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-orange-600">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Ingresos del Mes</p>
                    <p class="text-4xl font-black text-gray-900" id="ingresos-mes">$0.00</p>
                </div>
                <div class="w-14 h-14 bg-orange-100 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-7 h-7 text-orange-600"></i>
                </div>
            </div>
            <p class="text-xs text-orange-600 flex items-center gap-1 font-bold">
                <i data-lucide="arrow-up" class="w-3 h-3"></i>
                Membresías pagadas
            </p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-orange-600">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Ingresos por Productos</p>
                    <p class="text-4xl font-black text-gray-900" id="ingresos-productos">$0.00</p>
                </div>
                <div class="w-14 h-14 bg-orange-100 rounded-full flex items-center justify-center">
                    <i data-lucide="shopping-cart" class="w-7 h-7 text-orange-600"></i>
                </div>
            </div>
            <p class="text-xs text-orange-600 flex items-center gap-1 font-bold">
                <i data-lucide="package" class="w-3 h-3"></i>
                Ventas realizadas
            </p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-amber-600">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Pendiente de Cobro</p>
                    <p class="text-4xl font-black text-gray-900" id="pendiente-cobro">$0.00</p>
                </div>
                <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center">
                    <i data-lucide="alert-circle" class="w-7 h-7 text-amber-600"></i>
                </div>
            </div>
            <p class="text-xs text-amber-600 flex items-center gap-1 font-bold">
                <i data-lucide="clock" class="w-3 h-3"></i>
                Productos fiados
            </p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-2xl font-black text-gray-900 uppercase tracking-wide">Ingresos Mensuales</h3>
            <select id="meses-periodo" onchange="loadData()" class="px-4 py-2 border-2 border-gray-300 rounded-xl text-sm font-semibold bg-white focus:ring-2 focus:ring-red-600">
                <option value="6">Últimos 6 meses</option>
                <option value="12">Últimos 12 meses</option>
            </select>
        </div>
        <div class="relative" style="height: 300px;">
            <canvas id="chart-ingresos"></canvas>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
            <h3 class="text-xl font-black text-gray-900 mb-6 uppercase tracking-wide">Resumen por Tipo</h3>
            <div class="space-y-3" id="resumen-tipo">
                <div class="text-center py-8 text-gray-500">
                    <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                    <p class="font-bold">Cargando...</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
            <h3 class="text-xl font-black text-gray-900 mb-6 uppercase tracking-wide">Últimas Ventas</h3>
            <div class="space-y-2" id="ultimas-ventas">
                <div class="text-center py-8 text-gray-500">
                    <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                    <p class="font-bold">Cargando...</p>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
        <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-wide">Productos Más Vendidos</h3>
        <div class="overflow-x-auto">
            <table class="w-full" id="tabla-productos">
                <thead class="bg-gray-50 border-b-2 border-gray-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase tracking-wider">Producto</th>
                        <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase tracking-wider">Cantidad</th>
                        <th class="px-6 py-4 text-right text-xs font-black text-gray-600 uppercase tracking-wider">Ingresos</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y-2 divide-gray-200" id="tbody-productos">
                    <tr>
                        <td colspan="3" class="px-6 py-8 text-center text-gray-500">
                            <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                            <p class="font-bold">Cargando...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let chartInstance = null;

        async function loadData() {
            try {
                const mesesPeriodo = document.getElementById('meses-periodo').value;

                const [membresiasRes, ventasRes] = await Promise.all([
                    fetch('/api/Membresias'),
                    fetch('/api/VentasProductos')
                ]);

                const membresias = await membresiasRes.json();
                const ventas = await ventasRes.json();

                calcularResumen(membresias, ventas);
                renderGrafica(membresias, ventas, parseInt(mesesPeriodo));
                renderResumenTipo(membresias, ventas);
                renderUltimasVentas(ventas);
                renderProductosMasVendidos(ventas);

            } catch (error) {
                console.error('Error:', error);
            }
        }

        function calcularResumen(membresias, ventas) {
            const hoy = new Date();
            const primerDiaMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);

            const ingresosMembresias = membresias
                .filter(m => {
                    const fecha = new Date(m.fechaInicio || m.FechaInicio);
                    return fecha >= primerDiaMes && (m.estado || m.Estado) === 'activa';
                })
                .reduce((sum, m) => sum + (m.montoPagado || m.MontoPagado || 0), 0);

            const ventasMes = ventas.filter(v => {
                const fecha = new Date(v.fechaVenta || v.FechaVenta);
                return fecha >= primerDiaMes;
            });

            const ingresosProductos = ventasMes
                .filter(v => v.estadoPago === 'pagado')
                .reduce((sum, v) => sum + (v.total || 0), 0);

            const pendienteCobro = ventasMes
                .filter(v => v.estadoPago === 'pendiente')
                .reduce((sum, v) => sum + (v.total || 0), 0);

            document.getElementById('ingresos-mes').textContent = `$${ingresosMembresias.toFixed(2)}`;
            document.getElementById('ingresos-productos').textContent = `$${ingresosProductos.toFixed(2)}`;
            document.getElementById('pendiente-cobro').textContent = `$${pendienteCobro.toFixed(2)}`;
        }

        function renderGrafica(membresias, ventas, meses) {
            const ctx = document.getElementById('chart-ingresos');

            if (chartInstance) {
                chartInstance.destroy();
            }

            const labels = [];
            const datosMembresias = [];
            const datosProductos = [];

            for (let i = meses - 1; i >= 0; i--) {
                const fecha = new Date();
                fecha.setMonth(fecha.getMonth() - i);

                const mesLabel = fecha.toLocaleDateString('es-ES', { month: 'short', year: 'numeric' });
                labels.push(mesLabel);

                const primerDia = new Date(fecha.getFullYear(), fecha.getMonth(), 1);
                const ultimoDia = new Date(fecha.getFullYear(), fecha.getMonth() + 1, 0);

                const ingresosM = membresias
                    .filter(m => {
                        const f = new Date(m.fechaInicio || m.FechaInicio);
                        return f >= primerDia && f <= ultimoDia && (m.estado || m.Estado) === 'activa';
                    })
                    .reduce((sum, m) => sum + (m.montoPagado || m.MontoPagado || 0), 0);

                const ingresosP = ventas
                    .filter(v => {
                        const f = new Date(v.fechaVenta || v.FechaVenta);
                        return f >= primerDia && f <= ultimoDia && v.estadoPago === 'pagado';
                    })
                    .reduce((sum, v) => sum + (v.total || 0), 0);

                datosMembresias.push(ingresosM);
                datosProductos.push(ingresosP);
            }

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Membresías',
                            data: datosMembresias,
                            borderColor: '#E31E24',
                            backgroundColor: 'rgba(227, 30, 36, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4
                        },
                        {
                            label: 'Productos',
                            data: datosProductos,
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value;
                                }
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        function renderResumenTipo(membresias, ventas) {
            const hoy = new Date();
            const primerDiaMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);

            const ingresosM = membresias
                .filter(m => {
                    const fecha = new Date(m.fechaInicio || m.FechaInicio);
                    return fecha >= primerDiaMes && (m.estado || m.Estado) === 'activa';
                })
                .reduce((sum, m) => sum + (m.montoPagado || m.MontoPagado || 0), 0);

            const ingresosP = ventas
                .filter(v => {
                    const fecha = new Date(v.fechaVenta || v.FechaVenta);
                    return fecha >= primerDiaMes && v.estadoPago === 'pagado';
                })
                .reduce((sum, v) => sum + (v.total || 0), 0);

            const total = ingresosM + ingresosP;
            const porcM = total > 0 ? (ingresosM / total * 100) : 0;
            const porcP = total > 0 ? (ingresosP / total * 100) : 0;

            document.getElementById('resumen-tipo').innerHTML = `
                <div class="p-4 bg-red-50 rounded-xl border-2 border-red-200">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-2">
                            <i data-lucide="credit-card" class="w-5 h-5 text-red-600"></i>
                            <span class="font-black text-gray-900 uppercase text-sm tracking-wide">Membresías</span>
                        </div>
                        <span class="font-black text-red-600 text-lg">$${ingresosM.toFixed(2)}</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="bg-gradient-to-r from-red-600 to-red-800 h-2 rounded-full" style="width: ${porcM}%"></div>
                    </div>
                    <p class="text-xs text-gray-600 mt-2 font-bold">${porcM.toFixed(1)}% del total</p>
                </div>

                <div class="p-4 bg-orange-50 rounded-xl border-2 border-orange-200">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-2">
                            <i data-lucide="shopping-bag" class="w-5 h-5 text-orange-600"></i>
                            <span class="font-black text-gray-900 uppercase text-sm tracking-wide">Productos</span>
                        </div>
                        <span class="font-black text-orange-600 text-lg">$${ingresosP.toFixed(2)}</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="bg-orange-600 h-2 rounded-full" style="width: ${porcP}%"></div>
                    </div>
                    <p class="text-xs text-gray-600 mt-2 font-bold">${porcP.toFixed(1)}% del total</p>
                </div>
            `;
            lucide.createIcons();
        }

        function renderUltimasVentas(ventas) {
            const ultimas = ventas
                .sort((a, b) => new Date(b.fechaVenta || b.FechaVenta) - new Date(a.fechaVenta || a.FechaVenta))
                .slice(0, 5);

            if (ultimas.length === 0) {
                document.getElementById('ultimas-ventas').innerHTML = '<p class="text-center text-gray-500 py-4 font-semibold">No hay ventas recientes</p>';
                return;
            }

            document.getElementById('ultimas-ventas').innerHTML = ultimas.map(v => {
                const fecha = new Date(v.fechaVenta || v.FechaVenta);
                const producto = v.producto || v.Producto || {};
                const cliente = v.cliente || v.Cliente || {};

                return `
                    <div class="p-3 bg-gray-50 rounded-xl border-2 border-gray-200 hover:border-red-600 transition-all">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="font-black text-gray-900 text-sm">${producto.nombre || producto.Nombre || 'Producto'}</p>
                                <p class="text-xs text-gray-600 font-semibold">${cliente.nombre || cliente.Nombre || 'Cliente'} - ${fecha.toLocaleDateString()}</p>
                            </div>
                            <span class="font-black text-orange-600 text-lg">$${(v.total || 0).toFixed(2)}</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderProductosMasVendidos(ventas) {
            const ventasPagadas = ventas.filter(v => v.estadoPago === 'pagado');

            const productosMap = {};
            ventasPagadas.forEach(v => {
                const id = v.productoId || v.ProductoId;
                const producto = v.producto || v.Producto || {};

                if (!productosMap[id]) {
                    productosMap[id] = {
                        nombre: producto.nombre || producto.Nombre || 'Desconocido',
                        cantidad: 0,
                        total: 0
                    };
                }
                productosMap[id].cantidad += v.cantidad || 0;
                productosMap[id].total += v.total || 0;
            });

            const productos = Object.values(productosMap)
                .sort((a, b) => b.total - a.total)
                .slice(0, 5);

            if (productos.length === 0) {
                document.getElementById('tbody-productos').innerHTML = '<tr><td colspan="3" class="px-6 py-8 text-center text-gray-500 font-semibold">No hay ventas de productos</td></tr>';
                return;
            }

            document.getElementById('tbody-productos').innerHTML = productos.map(p => `
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center">
                                <i data-lucide="package" class="w-5 h-5 text-gray-600"></i>
                            </div>
                            <span class="font-black text-gray-900">${p.nombre}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 text-center">
                        <span class="inline-flex items-center px-3 py-1 bg-orange-100 text-orange-800 font-black rounded-full uppercase text-xs tracking-wide">
                            ${p.cantidad} unidades
                        </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <span class="text-xl font-black text-orange-600">$${p.total.toFixed(2)}</span>
                    </td>
                </tr>
            `).join('');

            lucide.createIcons();
        }

        window.addEventListener('load', function() {
            loadData();
            lucide.createIcons();
        });
    </script>
}

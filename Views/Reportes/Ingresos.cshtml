@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reporte de Ingresos";
    ViewData["Subtitle"] = "Análisis financiero y pagos del gimnasio";
}

<div class="space-y-6">
    <!-- Resumen Financiero -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Ingresos del Mes</p>
                    <p class="text-3xl font-bold text-gray-800" id="ingresos-mes">$0.00</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-6 h-6 text-green-600"></i>
                </div>
            </div>
            <p class="text-xs text-green-600 flex items-center gap-1">
                <i data-lucide="arrow-up" class="w-3 h-3"></i>
                Membresías pagadas
            </p>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Ingresos por Productos</p>
                    <p class="text-3xl font-bold text-gray-800" id="ingresos-productos">$0.00</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                    <i data-lucide="shopping-cart" class="w-6 h-6 text-blue-600"></i>
                </div>
            </div>
            <p class="text-xs text-blue-600 flex items-center gap-1">
                <i data-lucide="package" class="w-3 h-3"></i>
                Ventas realizadas
            </p>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-yellow-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Pendiente de Cobro</p>
                    <p class="text-3xl font-bold text-gray-800" id="pendiente-cobro">$0.00</p>
                </div>
                <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                    <i data-lucide="alert-circle" class="w-6 h-6 text-yellow-600"></i>
                </div>
            </div>
            <p class="text-xs text-yellow-600 flex items-center gap-1">
                <i data-lucide="clock" class="w-3 h-3"></i>
                Productos fiados
            </p>
        </div>
    </div>

    <!-- Gráfica de Ingresos Mensuales -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-800">Ingresos Mensuales</h3>
            <select id="meses-periodo" onchange="loadData()" class="px-4 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="6">Últimos 6 meses</option>
                <option value="12">Últimos 12 meses</option>
            </select>
        </div>
        <div class="relative" style="height: 300px;">
            <canvas id="chart-ingresos"></canvas>
        </div>
    </div>

    <!-- Detalle de Ingresos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Por Método de Pago -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4">Métodos de Pago</h3>
            <div class="space-y-3" id="metodos-pago">
                <div class="text-center py-8 text-gray-500">
                    <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                    <p>Cargando...</p>
                </div>
            </div>
        </div>

        <!-- Últimas Transacciones -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4">Últimos Pagos</h3>
            <div class="space-y-2" id="ultimos-pagos">
                <div class="text-center py-8 text-gray-500">
                    <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                    <p>Cargando...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Productos Más Vendidos -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Productos Más Vendidos</h3>
        <div id="productos-vendidos">
            <div class="text-center py-8 text-gray-500">
                <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                <p>Cargando...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const API_URL = '/api';
        let chart = null;

        async function loadData() {
            try {
                const meses = document.getElementById('meses-periodo').value;

                const [estadisticas, ingresos, productos] = await Promise.all([
                    fetch(`${API_URL}/Dashboard/estadisticas`).then(r => r.json()),
                    fetch(`${API_URL}/Dashboard/ingresos?meses=${meses}`).then(r => r.json()),
                    fetch(`${API_URL}/Dashboard/productos-mas-vendidos?limit=5`).then(r => r.json())
                ]);

                // Actualizar resumen financiero
                document.getElementById('ingresos-mes').textContent = `$${estadisticas.resumen.ingresosMes.toFixed(2)}`;
                document.getElementById('pendiente-cobro').textContent = `$${estadisticas.resumen.productosPendientes.toFixed(2)}`;

                // Calcular ingresos por productos (pagados)
                const ingresosProductos = await fetch(`${API_URL}/VentasProductos`)
                    .then(r => r.json())
                    .then(ventas => {
                        const pagadas = ventas.filter(v => v.estadoPago === 'pagado');
                        return pagadas.reduce((sum, v) => sum + v.total, 0);
                    });

                document.getElementById('ingresos-productos').textContent = `$${ingresosProductos.toFixed(2)}`;

                // Renderizar gráfica
                renderChart(ingresos);

                // Renderizar productos más vendidos
                renderProductos(productos);

                lucide.createIcons();
            } catch (error) {
                console.error('Error cargando datos:', error);
            }
        }

        function renderChart(data) {
            const ctx = document.getElementById('chart-ingresos');

            if (chart) {
                chart.destroy();
            }

            const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

            chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.map(d => `${meses[d.mes - 1]} ${d.año}`),
                    datasets: [{
                        label: 'Ingresos',
                        data: data.map(d => d.total),
                        backgroundColor: '#7ED957',
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    return '$' + context.parsed.y.toFixed(2);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value;
                                }
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        function renderProductos(productos) {
            const container = document.getElementById('productos-vendidos');

            if (productos.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-gray-500">
                        <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 text-gray-400"></i>
                        <p>No hay ventas registradas</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            container.innerHTML = `
                <div class="space-y-2">
                    ${productos.map((p, index) => `
                        <div class="flex items-center justify-between p-3 rounded-lg ${index % 2 === 0 ? 'bg-gray-50' : 'bg-white'} border border-gray-200">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 bg-vida-primary rounded-full flex items-center justify-center text-vida-dark font-bold">
                                    ${index + 1}
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-800">${p.productoNombre}</p>
                                    <p class="text-xs text-gray-500">${p.cantidadVendida} unidades vendidas</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-lg font-bold text-vida-primary">$${p.totalIngresos.toFixed(2)}</p>
                            </div>
                        </div>
                    `).join('')}
                </div>
            `;

            lucide.createIcons();
        }

        window.addEventListener('load', function() {
            loadData();
            lucide.createIcons();
        });
    </script>
}
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reporte de Ingresos";
    ViewData["Subtitle"] = "Análisis financiero y pagos del gimnasio";
}

<div class="space-y-6">
    <!-- Resumen Financiero -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Ingresos del Mes</p>
                    <p class="text-3xl font-bold text-gray-800" id="ingresos-mes">$0.00</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-6 h-6 text-green-600"></i>
                </div>
            </div>
            <p class="text-xs text-green-600 flex items-center gap-1">
                <i data-lucide="arrow-up" class="w-3 h-3"></i>
                Membresías pagadas
            </p>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Ingresos por Productos</p>
                    <p class="text-3xl font-bold text-gray-800" id="ingresos-productos">$0.00</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                    <i data-lucide="shopping-cart" class="w-6 h-6 text-blue-600"></i>
                </div>
            </div>
            <p class="text-xs text-blue-600 flex items-center gap-1">
                <i data-lucide="package" class="w-3 h-3"></i>
                Ventas realizadas
            </p>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-yellow-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Pendiente de Cobro</p>
                    <p class="text-3xl font-bold text-gray-800" id="pendiente-cobro">$0.00</p>
                </div>
                <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                    <i data-lucide="alert-circle" class="w-6 h-6 text-yellow-600"></i>
                </div>
            </div>
            <p class="text-xs text-yellow-600 flex items-center gap-1">
                <i data-lucide="clock" class="w-3 h-3"></i>
                Productos fiados
            </p>
        </div>
    </div>

    <!-- Gráfica de Ingresos Mensuales -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-800">Ingresos Mensuales</h3>
            <select id="meses-periodo" onchange="loadData()" class="px-4 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="6">Últimos 6 meses</option>
                <option value="12">Últimos 12 meses</option>
            </select>
        </div>
        <div class="relative" style="height: 300px;">
            <canvas id="chart-ingresos"></canvas>
        </div>
    </div>

    <!-- Detalle de Ingresos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Resumen por Tipo -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4">Resumen por Tipo</h3>
            <div class="space-y-3" id="resumen-tipo">
                <div class="text-center py-8 text-gray-500">
                    <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                    <p>Cargando...</p>
                </div>
            </div>
        </div>

        <!-- Últimas Transacciones -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4">Últimas Ventas</h3>
            <div class="space-y-2" id="ultimas-ventas">
                <div class="text-center py-8 text-gray-500">
                    <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                    <p>Cargando...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Productos Más Vendidos -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Productos Más Vendidos</h3>
        <div id="productos-vendidos">
            <div class="text-center py-8 text-gray-500">
                <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                <p>Cargando...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const API_URL = '/api';
        let chart = null;

        async function loadData() {
            try {
                const meses = document.getElementById('meses-periodo').value;

                // Cargar datos de forma segura
                const [estadisticas, ventas] = await Promise.all([
                    cargarEstadisticas(),
                    cargarVentas()
                ]);

                // Actualizar resumen financiero
                actualizarResumen(estadisticas, ventas);

                // Renderizar gráfica
                renderChart(calcularIngresosMensuales(ventas, parseInt(meses)));

                // Renderizar productos más vendidos
                renderProductosVendidos(calcularProductosMasVendidos(ventas));

                // Renderizar resumen por tipo
                renderResumenTipo(ventas);

                // Renderizar últimas ventas
                renderUltimasVentas(ventas);

                lucide.createIcons();
            } catch (error) {
                console.error('Error cargando datos:', error);
                mostrarError();
            }
        }

        async function cargarEstadisticas() {
            try {
                const response = await fetch(`${API_URL}/Dashboard/estadisticas`);
                if (!response.ok) throw new Error('Error al cargar estadísticas');
                return await response.json();
            } catch (error) {
                console.error('Error cargando estadísticas:', error);
                return { resumen: { ingresosMes: 0, productosPendientes: 0 } };
            }
        }

        async function cargarVentas() {
            try {
                const response = await fetch(`${API_URL}/VentasProductos`);
                if (!response.ok) throw new Error('Error al cargar ventas');
                return await response.json();
            } catch (error) {
                console.error('Error cargando ventas:', error);
                return [];
            }
        }

        function actualizarResumen(estadisticas, ventas) {
            // Ingresos por membresías del mes actual
            const ingresosMes = estadisticas.resumen?.ingresosMes || 0;
            document.getElementById('ingresos-mes').textContent = `$${ingresosMes.toFixed(2)}`;

            // Ingresos por productos pagados
            const ventasPagadas = ventas.filter(v => v.estadoPago === 'pagado');
            const ingresosProductos = ventasPagadas.reduce((sum, v) => sum + (v.total || 0), 0);
            document.getElementById('ingresos-productos').textContent = `$${ingresosProductos.toFixed(2)}`;

            // Pendiente de cobro
            const ventasPendientes = ventas.filter(v => v.estadoPago === 'pendiente');
            const pendienteCobro = ventasPendientes.reduce((sum, v) => sum + (v.total || 0), 0);
            document.getElementById('pendiente-cobro').textContent = `$${pendienteCobro.toFixed(2)}`;
        }

        function calcularIngresosMensuales(ventas, meses) {
            const ahora = new Date();
            const ventasPagadas = ventas.filter(v => v.estadoPago === 'pagado');
            
            const ingresosPorMes = {};
            
            for (let i = 0; i < meses; i++) {
                const fecha = new Date(ahora.getFullYear(), ahora.getMonth() - i, 1);
                const key = `${fecha.getFullYear()}-${fecha.getMonth() + 1}`;
                ingresosPorMes[key] = {
                    mes: fecha.getMonth() + 1,
                    año: fecha.getFullYear(),
                    total: 0
                };
            }

            ventasPagadas.forEach(v => {
                const fecha = new Date(v.fechaVenta || v.fechaPago);
                const key = `${fecha.getFullYear()}-${fecha.getMonth() + 1}`;
                
                if (ingresosPorMes[key]) {
                    ingresosPorMes[key].total += v.total || 0;
                }
            });

            return Object.values(ingresosPorMes).reverse();
        }

        function calcularProductosMasVendidos(ventas, limit = 5) {
            const productoStats = {};

            ventas.forEach(v => {
                const producto = v.producto || {};
                const productoId = producto.id;
                
                if (!productoId) return;

                if (!productoStats[productoId]) {
                    productoStats[productoId] = {
                        productoNombre: producto.nombre || 'Desconocido',
                        cantidadVendida: 0,
                        totalIngresos: 0
                    };
                }

                productoStats[productoId].cantidadVendida += v.cantidad || 0;
                if (v.estadoPago === 'pagado') {
                    productoStats[productoId].totalIngresos += v.total || 0;
                }
            });

            return Object.values(productoStats)
                .sort((a, b) => b.totalIngresos - a.totalIngresos)
                .slice(0, limit);
        }

        function renderChart(data) {
            const ctx = document.getElementById('chart-ingresos');

            if (chart) {
                chart.destroy();
            }

            const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

            chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.map(d => `${meses[d.mes - 1]} ${d.año}`),
                    datasets: [{
                        label: 'Ingresos',
                        data: data.map(d => d.total),
                        backgroundColor: '#7ED957',
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    return '$' + context.parsed.y.toFixed(2);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value;
                                }
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        function renderProductosVendidos(productos) {
            const container = document.getElementById('productos-vendidos');

            if (productos.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-gray-500">
                        <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 text-gray-400"></i>
                        <p>No hay ventas registradas</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            container.innerHTML = `
                <div class="space-y-2">
                    ${productos.map((p, index) => `
                        <div class="flex items-center justify-between p-3 rounded-lg ${index % 2 === 0 ? 'bg-gray-50' : 'bg-white'} border border-gray-200">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 bg-vida-primary rounded-full flex items-center justify-center text-vida-dark font-bold">
                                    ${index + 1}
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-800">${p.productoNombre}</p>
                                    <p class="text-xs text-gray-500">${p.cantidadVendida} unidades vendidas</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-lg font-bold text-vida-primary">$${p.totalIngresos.toFixed(2)}</p>
                            </div>
                        </div>
                    `).join('')}
                </div>
            `;

            lucide.createIcons();
        }

        function renderResumenTipo(ventas) {
            const container = document.getElementById('resumen-tipo');
            
            const pagadas = ventas.filter(v => v.estadoPago === 'pagado');
            const pendientes = ventas.filter(v => v.estadoPago === 'pendiente');
            
            const totalPagado = pagadas.reduce((sum, v) => sum + (v.total || 0), 0);
            const totalPendiente = pendientes.reduce((sum, v) => sum + (v.total || 0), 0);

            container.innerHTML = `
                <div class="space-y-3">
                    <div class="flex items-center justify-between p-4 bg-green-50 rounded-lg border border-green-200">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                                <i data-lucide="check-circle" class="w-5 h-5 text-white"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-gray-800">Ventas Pagadas</p>
                                <p class="text-xs text-gray-600">${pagadas.length} transacciones</p>
                            </div>
                        </div>
                        <p class="text-xl font-bold text-green-600">$${totalPagado.toFixed(2)}</p>
                    </div>
                    
                    <div class="flex items-center justify-between p-4 bg-orange-50 rounded-lg border border-orange-200">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center">
                                <i data-lucide="clock" class="w-5 h-5 text-white"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-gray-800">Ventas Fiadas</p>
                                <p class="text-xs text-gray-600">${pendientes.length} transacciones</p>
                            </div>
                        </div>
                        <p class="text-xl font-bold text-orange-600">$${totalPendiente.toFixed(2)}</p>
                    </div>
                </div>
            `;
            
            lucide.createIcons();
        }

        function renderUltimasVentas(ventas) {
            const container = document.getElementById('ultimas-ventas');
            
            const ultimasVentas = [...ventas]
                .sort((a, b) => new Date(b.fechaVenta || b.fechaPago) - new Date(a.fechaVenta || a.fechaPago))
                .slice(0, 10);

            if (ultimasVentas.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-gray-500">
                        <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 text-gray-400"></i>
                        <p>No hay ventas registradas</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            container.innerHTML = ultimasVentas.map(v => {
                const producto = v.producto || {};
                const cliente = v.cliente || {};
                const fecha = new Date(v.fechaVenta || v.fechaPago).toLocaleDateString('es-ES');
                const isPagado = v.estadoPago === 'pagado';
                
                return `
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-200">
                        <div class="flex items-center gap-3 flex-1">
                            <div class="w-8 h-8 ${isPagado ? 'bg-green-100' : 'bg-orange-100'} rounded-full flex items-center justify-center">
                                <i data-lucide="${isPagado ? 'check' : 'clock'}" class="w-4 h-4 ${isPagado ? 'text-green-600' : 'text-orange-600'}"></i>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-semibold text-gray-800">${producto.nombre || 'Producto'}</p>
                                <p class="text-xs text-gray-600">${cliente.nombre || 'Cliente'} ${cliente.apellido || ''} • ${fecha}</p>
                            </div>
                        </div>
                        <p class="text-sm font-bold ${isPagado ? 'text-green-600' : 'text-orange-600'}">$${(v.total || 0).toFixed(2)}</p>
                    </div>
                `;
            }).join('');

            lucide.createIcons();
        }

        function mostrarError() {
            document.getElementById('productos-vendidos').innerHTML = 
                '<div class="text-center py-8 text-red-500"><p>Error al cargar los datos</p></div>';
        }

        window.addEventListener('load', function() {
            loadData();
            lucide.createIcons();
        });
    </script>
}

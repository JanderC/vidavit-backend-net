@model List<VidaFit.Controllers.WEB.ProductoVendidoReporte>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Productos Más Vendidos";
    ViewData["Subtitle"] = "Top productos con mayor demanda - VidaFit";

    decimal totalIngresos = 0;
    int totalUnidades = 0;
    if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model) { totalIngresos += item.Total; totalUnidades += item.Cantidad; }
    }
}

<style>
    :root {
        --vf-green: #39FF14;
        --vf-dark: #0a0a0a;
        --vf-card: #111111;
        --vf-border: #1f1f1f;
        --vf-text: #e5e5e5;
        --vf-muted: #6b7280;
    }

    .vf-page {
        background: var(--vf-dark);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .vf-card {
        background: var(--vf-card);
        border: 1px solid var(--vf-border);
        border-radius: 1rem;
    }

    .vf-label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        color: var(--vf-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .vf-input {
        background: #1a1a1a;
        border: 2px solid var(--vf-border);
        color: var(--vf-text);
        border-radius: .6rem;
        padding: .75rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s;
        width: 100%;
    }

        .vf-input:focus {
            border-color: var(--vf-green);
        }

    .vf-stat {
        background: var(--vf-card);
        border-radius: .85rem;
        padding: 1.5rem;
        border-left: 4px solid;
    }

    .vf-btn-filter {
        background: var(--vf-green);
        color: #0a0a0a;
        font-weight: 900;
        padding: .8rem 2rem;
        border-radius: .6rem;
        border: none;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: .06em;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: opacity .2s;
    }

        .vf-btn-filter:hover {
            opacity: .85;
        }

    .vf-section-title {
        font-size: 1rem;
        font-weight: 900;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .vf-section-title::before {
            content: '';
            display: block;
            width: 3px;
            height: 1rem;
            background: var(--vf-green);
            border-radius: 2px;
            flex-shrink: 0;
        }

    .vf-table {
        width: 100%;
        border-collapse: collapse;
    }

        .vf-table th {
            background: #0f0f0f;
            color: var(--vf-muted);
            font-size: .72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            padding: .9rem 1.5rem;
            border-bottom: 1px solid var(--vf-border);
        }

        .vf-table td {
            padding: .85rem 1.5rem;
            border-bottom: 1px solid var(--vf-border);
            color: var(--vf-text);
        }

        .vf-table tr:hover td {
            background: #161616;
        }

        .vf-table tr:last-child td {
            border-bottom: none;
        }

    .vf-podium {
        background: var(--vf-card);
        border-radius: 1rem;
        padding: 1.5rem;
        border: 1px solid var(--vf-border);
        transition: transform .15s,box-shadow .15s;
    }

        .vf-podium:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(57,255,20,.1);
        }
</style>

<div class="vf-page space-y-6">

    <!-- Header Brand -->
    <div style="display:flex;align-items:center;gap:.75rem;">
        <div style="background:var(--vf-green);padding:.4rem .9rem;border-radius:.5rem;">
            <span style="font-size:1.1rem;font-weight:900;color:#0a0a0a;letter-spacing:.05em;">VIDAFIT</span>
        </div>
        <div>
            <h2 style="font-size:1.5rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.04em;">Productos Más Vendidos</h2>
            <p style="color:var(--vf-muted);font-size:.82rem;">Top productos con mayor demanda</p>
        </div>
    </div>

    <!-- Filtro fechas -->
    <div class="vf-card p-6">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:1rem;">
            <div style="flex:1;min-width:200px;">
                <label class="vf-label">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="vf-input">
            </div>
            <div style="flex:1;min-width:200px;">
                <label class="vf-label">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="vf-input">
            </div>
            <button onclick="filtrarPorFecha()" class="vf-btn-filter">
                <i data-lucide="filter" style="width:1rem;height:1rem;"></i>
                Filtrar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="vf-stat" style="border-left-color:#f59e0b;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:.72rem;font-weight:800;color:var(--vf-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.35rem;">Productos Vendidos</p>
                        <p style="font-size:2.25rem;font-weight:900;color:#fbbf24;">@Model.Count</p>
                    </div>
                    <div style="width:3.5rem;height:3.5rem;background:#b4530922;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="package" style="width:1.6rem;height:1.6rem;color:#fbbf24;"></i>
                    </div>
                </div>
            </div>

            <div class="vf-stat" style="border-left-color:var(--vf-green);">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:.72rem;font-weight:800;color:var(--vf-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.35rem;">Ingresos Totales</p>
                        <p style="font-size:2.25rem;font-weight:900;color:var(--vf-green);">$@totalIngresos.ToString("N2")</p>
                    </div>
                    <div style="width:3.5rem;height:3.5rem;background:#39FF1422;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="dollar-sign" style="width:1.6rem;height:1.6rem;color:var(--vf-green);"></i>
                    </div>
                </div>
            </div>

            <div class="vf-stat" style="border-left-color:#3b82f6;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:.72rem;font-weight:800;color:var(--vf-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.35rem;">Unidades Totales</p>
                        <p style="font-size:2.25rem;font-weight:900;color:#60a5fa;">@totalUnidades</p>
                    </div>
                    <div style="width:3.5rem;height:3.5rem;background:#1d4ed822;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="shopping-cart" style="width:1.6rem;height:1.6rem;color:#60a5fa;"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Podium TOP 3 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @{
                var podiumBorders = new[] { "#f59e0b", "#9ca3af", "#fb923c" };
                var podiumIcons = new[] { "trophy", "medal", "award" };
                var podiumColors = new[] { "#fbbf24", "#9ca3af", "#fb923c" };
                var podiumBgs = new[] { "#b4530922", "#37415122", "#ea580c22" };
            }
            @for (int i = 0; i < Math.Min(3, Model.Count); i++)
            {
                var producto = Model[i];
                <div class="vf-podium" style="border-color:@podiumBorders[i];border-width:2px;border-style:solid;">
                    <div style="display:flex;align-items:center;gap:.85rem;margin-bottom:1rem;">
                        <div style="width:3.25rem;height:3.25rem;border-radius:50%;background:@podiumBgs[i];display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i data-lucide="@podiumIcons[i]" style="width:1.5rem;height:1.5rem;color:@podiumColors[i];"></i>
                        </div>
                        <div>
                            <p style="font-size:.72rem;color:var(--vf-muted);text-transform:uppercase;font-weight:800;letter-spacing:.08em;">Puesto #@(i + 1)</p>
                            <p style="font-weight:900;color:#fff;font-size:1rem;text-transform:uppercase;letter-spacing:.04em;">@producto.Nombre</p>
                        </div>
                    </div>
                    <div style="space-y:.75rem;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.6rem;">
                            <span style="font-size:.82rem;color:var(--vf-muted);font-weight:700;">Unidades vendidas:</span>
                            <span style="font-weight:900;color:@podiumColors[i];font-size:1.05rem;">@producto.Cantidad</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:.82rem;color:var(--vf-muted);font-weight:700;">Ingresos:</span>
                            <span style="font-weight:900;color:var(--vf-green);font-size:1.05rem;">$@producto.Total.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Gráfica -->
        <div class="vf-card p-8">
            <p class="vf-section-title">Comparativa de Ventas</p>
            <div style="position:relative;height:400px;">
                <canvas id="chart-productos"></canvas>
            </div>
        </div>

        <!-- Tabla Ranking -->
        <div class="vf-card" style="overflow:hidden;">
            <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--vf-border);background:#0f0f0f;">
                <p class="vf-section-title" style="margin-bottom:0;">Ranking Completo</p>
            </div>
            <div style="overflow-x:auto;">
                <table class="vf-table">
                    <thead>
                        <tr>
                            <th style="text-align:center;">Posición</th>
                            <th>Producto</th>
                            <th style="text-align:center;">Unidades</th>
                            <th style="text-align:right;">Ingresos</th>
                            <th style="text-align:center;">Participación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var posicion = 1;
                        }
                        @foreach (var producto in Model)
                        {
                            var porcentaje = totalIngresos > 0 ? (producto.Total / totalIngresos * 100) : 0;
                            var isTop = posicion <= 3;
                            <tr>
                                <td style="text-align:center;">
                                    <span style="display:inline-flex;align-items:center;justify-content:center;width:2.25rem;height:2.25rem;background:@(isTop ? "var(--vf-green)" : "#1f1f1f");color:@(isTop ? "#0a0a0a" : "var(--vf-muted)");font-weight:900;border-radius:50%;font-size:.875rem;">
                                        @posicion
                                    </span>
                                </td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:.75rem;">
                                        <div style="width:2.5rem;height:2.5rem;background:#1a1a1a;border-radius:.5rem;display:flex;align-items:center;justify-content:center;border:1px solid var(--vf-border);">
                                            <i data-lucide="package" style="width:1.25rem;height:1.25rem;color:var(--vf-muted);"></i>
                                        </div>
                                        <span style="font-weight:800;color:#fff;">@producto.Nombre</span>
                                    </div>
                                </td>
                                <td style="text-align:center;">
                                    <span style="display:inline-flex;align-items:center;padding:.25rem .75rem;background:#1d4ed822;color:#60a5fa;border-radius:9999px;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;border:1px solid #1d4ed844;">
                                        @producto.Cantidad unidades
                                    </span>
                                </td>
                                <td style="text-align:right;">
                                    <span style="font-size:1.05rem;font-weight:900;color:var(--vf-green);">$@producto.Total.ToString("N2")</span>
                                </td>
                                <td style="text-align:center;">
                                    <div style="display:flex;align-items:center;justify-content:center;gap:.5rem;">
                                        <div style="width:6rem;background:#1f1f1f;border-radius:9999px;height:.5rem;">
                                            <div style="background:var(--vf-green);height:.5rem;border-radius:9999px;width:@porcentaje.ToString("F1")%;"></div>
                                        </div>
                                        <span style="font-size:.78rem;font-weight:800;color:var(--vf-muted);">@porcentaje.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                            posicion++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="vf-card" style="padding:4rem;text-align:center;">
            <i data-lucide="inbox" style="width:6rem;height:6rem;margin:0 auto 1rem;color:#374151;display:block;"></i>
            <h3 style="font-size:1.25rem;font-weight:900;color:#fff;text-transform:uppercase;margin-bottom:.75rem;">No hay ventas en este período</h3>
            <p style="color:var(--vf-muted);font-weight:600;">Intenta seleccionar un rango de fechas diferente</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const productosData = @Html.Raw(JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/productos-mas-vendidos?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            if (productosData.length === 0) return;
            const ctx = document.getElementById('chart-productos');
            const labels = productosData.map(p => p.Nombre);
            const cantidades = productosData.map(p => p.Cantidad);
            const ingresos = productosData.map(p => p.Total);

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [
                        { label: 'Unidades Vendidas', data: cantidades, backgroundColor: '#39FF14', borderRadius: 6, yAxisID: 'y' },
                        { label: 'Ingresos ($)', data: ingresos, backgroundColor: '#3b82f6', borderRadius: 6, yAxisID: 'y1' }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true, position: 'top', labels: { color: '#e5e5e5', font: { weight: 'bold' } } },
                        tooltip: { backgroundColor: '#1a1a1a', borderColor: '#1f1f1f', borderWidth: 1, titleColor: '#e5e5e5', bodyColor: '#e5e5e5', padding: 12 }
                    },
                    scales: {
                        y: { type: 'linear', display: true, position: 'left', title: { display: true, text: 'Unidades', color: '#6b7280' }, grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#6b7280' } },
                        y1: { type: 'linear', display: true, position: 'right', title: { display: true, text: 'Ingresos ($)', color: '#6b7280' }, grid: { drawOnChartArea: false }, ticks: { color: '#6b7280' } },
                        x: { grid: { display: false }, ticks: { color: '#6b7280' } }
                    }
                }
            });
        }

        window.addEventListener('load', function() { renderChart(); lucide.createIcons(); });
    </script>
}

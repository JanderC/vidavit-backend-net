@model List<VidaFit.Controllers.WEB.ProductoVendidoReporte>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Productos Más Vendidos";
    ViewData["Subtitle"] = "Top productos con mayor demanda - TAURO GYM";

    decimal totalIngresos = 0;
    int totalUnidades = 0;

    if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            totalIngresos += item.Total;
            totalUnidades += item.Cantidad;
        }
    }
}

<div class="space-y-6">
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
        <div class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-700 focus:border-blue-700 font-semibold">
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-700 focus:border-blue-700 font-semibold">
            </div>
            <button onclick="filtrarPorFecha()"
                    class="px-8 py-3 bg-gradient-to-r from-blue-700 to-blue-900 hover:from-blue-800 hover:to-blue-950 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                Filtrar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-amber-600">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Productos Vendidos</p>
                        <p class="text-4xl font-black text-gray-900">@Model.Count</p>
                    </div>
                    <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center">
                        <i data-lucide="package" class="w-7 h-7 text-amber-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-yellow-600">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Ingresos Totales</p>
                        <p class="text-4xl font-black text-gray-900">$@totalIngresos.ToString("N2")</p>
                    </div>
                    <div class="w-14 h-14 bg-yellow-100 rounded-full flex items-center justify-center">
                        <i data-lucide="dollar-sign" class="w-7 h-7 text-yellow-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-blue-600">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Unidades Totales</p>
                        <p class="text-4xl font-black text-gray-900">@totalUnidades</p>
                    </div>
                    <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center">
                        <i data-lucide="shopping-cart" class="w-7 h-7 text-blue-600"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @for (int i = 0; i < Math.Min(3, Model.Count); i++)
            {
                var producto = Model[i];

                var podiumColors = new[] { "bg-yellow-50 border-yellow-500", "bg-gray-50 border-gray-400", "bg-orange-50 border-orange-500" };
                var podiumIcons = new[] { "trophy", "medal", "award" };
                var podiumTextColors = new[] { "text-yellow-600", "text-gray-600", "text-orange-600" };

                <div class="bg-white rounded-2xl shadow-xl p-6 border-2 @podiumColors[i] transform hover:scale-105 transition-transform">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-14 h-14 rounded-full @podiumColors[i] flex items-center justify-center">
                            <i data-lucide="@podiumIcons[i]" class="w-7 h-7 @podiumTextColors[i]"></i>
                        </div>
                        <div class="flex-1">
                            <p class="text-xs text-gray-600 uppercase font-black tracking-wide">Puesto #@(i + 1)</p>
                            <p class="font-black text-gray-900 text-lg uppercase">@producto.Nombre</p>
                        </div>
                    </div>
                    <div class="space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="text-sm text-gray-600 font-bold">Unidades vendidas:</span>
                            <span class="font-black @podiumTextColors[i] text-lg">@producto.Cantidad</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm text-gray-600 font-bold">Ingresos:</span>
                            <span class="font-black text-yellow-600 text-lg">$@producto.Total.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
            <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-wide">Comparativa de Ventas</h3>
            <div class="relative" style="height: 400px;">
                <canvas id="chart-productos"></canvas>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
            <div class="px-6 py-4 border-b-2 border-gray-200 bg-gradient-to-r from-gray-900 to-black">
                <h3 class="text-xl font-black text-white uppercase tracking-wide">Ranking Completo</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b-2 border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase tracking-wider">Posición</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase tracking-wider">Producto</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase tracking-wider">Unidades</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-600 uppercase tracking-wider">Ingresos</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase tracking-wider">Participación</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y-2 divide-gray-200">
                        @{
                            var posicion = 1;
                        }
                        @foreach (var producto in Model)
                        {
                            var porcentaje = totalIngresos > 0 ? (producto.Total / totalIngresos * 100) : 0;
                            var badgeColor = posicion <= 3 ? "bg-gradient-to-r from-blue-700 to-blue-900 text-white" : "bg-gray-200 text-gray-900";

                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center justify-center w-10 h-10 @badgeColor font-black rounded-full">
                                        @posicion
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center">
                                            <i data-lucide="package" class="w-6 h-6 text-gray-600"></i>
                                        </div>
                                        <span class="font-black text-gray-900">@producto.Nombre</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center px-4 py-2 bg-blue-100 text-blue-800 font-black rounded-full uppercase text-xs tracking-wide">
                                        @producto.Cantidad unidades
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <span class="text-xl font-black text-yellow-600">$@producto.Total.ToString("N2")</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <div class="w-24 bg-gray-200 rounded-full h-3">
                                            <div class="bg-gradient-to-r from-blue-700 to-blue-900 h-3 rounded-full" style="width: @porcentaje.ToString("F1")%"></div>
                                        </div>
                                        <span class="text-xs font-black text-gray-900">@porcentaje.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                            posicion++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl shadow-xl p-12 text-center border-2 border-gray-200">
            <i data-lucide="inbox" class="w-24 h-24 mx-auto mb-4 text-gray-400"></i>
            <h3 class="text-2xl font-black text-gray-900 mb-3 uppercase tracking-wide">No hay ventas en este período</h3>
            <p class="text-gray-600 font-semibold">Intenta seleccionar un rango de fechas diferente</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const productosData = @Html.Raw(JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/productos-mas-vendidos?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            if (productosData.length === 0) return;

            const ctx = document.getElementById('chart-productos');

            const labels = productosData.map(p => p.Nombre);
            const cantidades = productosData.map(p => p.Cantidad);
            const ingresos = productosData.map(p => p.Total);

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Unidades Vendidas',
                            data: cantidades,
                            backgroundColor: '#E31E24',
                            borderRadius: 6,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Ingresos ($)',
                            data: ingresos,
                            backgroundColor: '#10b981',
                            borderRadius: 6,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12
                        }
                    },
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Unidades'
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Ingresos ($)'
                            },
                            grid: {
                                drawOnChartArea: false
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        window.addEventListener('load', function() {
            renderChart();
            lucide.createIcons();
        });
    </script>
}

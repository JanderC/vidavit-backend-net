@model List<VidaFit.Controllers.WEB.ProductoVendidoReporte>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Productos Más Vendidos";
    ViewData["Subtitle"] = "Top productos con mayor demanda - Power Fitness";
    decimal totalIngresos = 0; int totalUnidades = 0;
    if (Model != null && Model.Count > 0) { foreach (var item in Model) { totalIngresos += item.Total; totalUnidades += item.Cantidad; } }
    var podiumBorders = new[] { "rgba(245,158,11,.4)", "rgba(148,163,184,.3)", "rgba(217,119,6,.35)" };
    var podiumBgs = new[] { "rgba(245,158,11,.07)", "rgba(148,163,184,.05)", "rgba(217,119,6,.07)" };
    var podiumColors = new[] { "#F59E0B", "#94A3B8", "#D97706" };
    var podiumIcons = new[] { "trophy", "medal", "award" };
}

<style>
    :root {
        --pf-blue: #3B82F6;
        --pf-blueB: #60A5FA;
        --pf-deep: #1E3A8A;
        --pf-purple: #7C3AED;
        --pf-card: #0D1526;
        --pf-border: #1E2D4A;
        --pf-text: #E2E8F0;
        --pf-soft: #94A3B8;
        --pf-muted: #64748B;
        --pf-green: #10B981;
        --pf-orange: #F59E0B;
    }

    .pf-input {
        width: 100%;
        padding: .75rem 1rem;
        border: 2px solid var(--pf-border);
        border-radius: .75rem;
        background: rgba(255,255,255,.03);
        color: var(--pf-text);
        font-weight: 600;
        font-family: inherit;
        outline: none;
        box-sizing: border-box;
        transition: border-color .2s;
    }

        .pf-input:focus {
            border-color: var(--pf-blue);
        }

    .pf-card {
        background: var(--pf-card);
        border: 1px solid var(--pf-border);
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,.3);
    }

    .pf-th {
        padding: .875rem 1.5rem;
        font-size: .68rem;
        font-weight: 800;
        color: rgba(255,255,255,.85);
        text-transform: uppercase;
        letter-spacing: .12em;
    }

    .pf-td {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--pf-border);
    }
</style>

<div style="display:flex;flex-direction:column;gap:1.25rem;">

    <!-- Filtro -->
    <div class="pf-card">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:1rem;">
            <div style="flex:1;min-width:180px;">
                <label style="display:block;font-size:.7rem;font-weight:800;color:var(--pf-soft);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem;">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <div style="flex:1;min-width:180px;">
                <label style="display:block;font-size:.7rem;font-weight:800;color:var(--pf-soft);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem;">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <button onclick="filtrarPorFecha()"
                    style="padding:.75rem 2rem;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;font-weight:800;border:none;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;display:inline-flex;align-items:center;gap:.5rem;box-shadow:0 4px 16px rgba(59,130,246,.3);transition:transform .2s;"
                    onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                <i data-lucide="filter" style="width:16px;height:16px;"></i> Filtrar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <!-- Stats -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;">
            <div class="pf-card" style="border-left:4px solid var(--pf-orange);display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .35rem 0;">Productos Vendidos</p>
                    <p style="font-size:2.25rem;font-weight:900;color:var(--pf-orange);margin:0;">@Model.Count</p>
                </div>
                <div style="width:52px;height:52px;background:rgba(245,158,11,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="package" style="width:26px;height:26px;color:var(--pf-orange);"></i>
                </div>
            </div>
            <div class="pf-card" style="border-left:4px solid var(--pf-green);display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .35rem 0;">Ingresos Totales</p>
                    <p style="font-size:2.25rem;font-weight:900;color:var(--pf-green);margin:0;">$@totalIngresos.ToString("N2")</p>
                </div>
                <div style="width:52px;height:52px;background:rgba(16,185,129,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="dollar-sign" style="width:26px;height:26px;color:var(--pf-green);"></i>
                </div>
            </div>
            <div class="pf-card" style="border-left:4px solid var(--pf-blue);display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .35rem 0;">Unidades Totales</p>
                    <p style="font-size:2.25rem;font-weight:900;color:var(--pf-blueB);margin:0;">@totalUnidades</p>
                </div>
                <div style="width:52px;height:52px;background:rgba(59,130,246,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="shopping-cart" style="width:26px;height:26px;color:var(--pf-blueB);"></i>
                </div>
            </div>
        </div>

        <!-- Podio Top 3 -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;">
            @for (int i = 0; i < Math.Min(3, Model.Count); i++)
            {
                var producto = Model[i];
                <div style="background:@(podiumBgs[i]);border:2px solid @(podiumBorders[i]);border-radius:1rem;padding:1.5rem;transition:transform .2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1rem;">
                        <div style="width:52px;height:52px;border-radius:50%;background:rgba(255,255,255,.07);border:2px solid @(podiumBorders[i]);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i data-lucide="@(podiumIcons[i])" style="width:24px;height:24px;color:@(podiumColors[i]);"></i>
                        </div>
                        <div>
                            <p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .1rem 0;">Puesto #@(i + 1)</p>
                            <p style="font-weight:900;color:var(--pf-text);font-size:1rem;text-transform:uppercase;margin:0;">@producto.Nombre</p>
                        </div>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:.5rem;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:.78rem;color:var(--pf-soft);font-weight:700;">Unidades vendidas:</span>
                            <span style="font-weight:900;color:@(podiumColors[i]);font-size:1.1rem;">@producto.Cantidad</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:.78rem;color:var(--pf-soft);font-weight:700;">Ingresos:</span>
                            <span style="font-weight:900;color:var(--pf-green);font-size:1.1rem;">$@producto.Total.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Gráfico -->
        <div class="pf-card">
            <h3 style="font-size:1rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.08em;margin:0 0 1.25rem 0;">Comparativa de Ventas</h3>
            <div style="position:relative;height:360px;">
                <canvas id="chart-productos"></canvas>
            </div>
        </div>

        <!-- Tabla ranking -->
        <div class="pf-card" style="padding:0;overflow:hidden;">
            <div style="padding:.875rem 1.5rem;background:linear-gradient(135deg,var(--pf-deep),#111827);border-bottom:2px solid var(--pf-blue);">
                <h3 style="font-size:.95rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.08em;margin:0;">Ranking Completo</h3>
            </div>
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="background:rgba(6,11,24,.5);">
                        <th class="pf-th" style="text-align:center;">Pos.</th>
                        <th class="pf-th">Producto</th>
                        <th class="pf-th" style="text-align:center;">Unidades</th>
                        <th class="pf-th" style="text-align:right;">Ingresos</th>
                        <th class="pf-th" style="text-align:center;">Participación</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int pos = 1;
                    }
                    @foreach (var producto in Model)
                    {
                        var pct = totalIngresos > 0 ? (producto.Total / totalIngresos * 100) : 0;
                        <tr style="transition:background .15s;" onmouseover="this.style.background='rgba(59,130,246,.04)'" onmouseout="this.style.background='transparent'">
                            <td class="pf-td" style="text-align:center;">
                                <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;font-weight:900;font-size:.85rem;@(pos<=3?"background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;":"background:rgba(255,255,255,.06);color:var(--pf-soft);border:1px solid var(--pf-border);")">@pos</span>
                            </td>
                            <td class="pf-td">
                                <div style="display:flex;align-items:center;gap:.75rem;">
                                    <div style="width:40px;height:40px;background:rgba(59,130,246,.08);border:1px solid var(--pf-border);border-radius:.625rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <i data-lucide="package" style="width:18px;height:18px;color:var(--pf-soft);"></i>
                                    </div>
                                    <span style="font-weight:800;color:var(--pf-text);">@producto.Nombre</span>
                                </div>
                            </td>
                            <td class="pf-td" style="text-align:center;">
                                <span style="padding:.22rem .75rem;background:rgba(59,130,246,.1);color:var(--pf-blueB);border:1px solid rgba(59,130,246,.25);border-radius:999px;font-size:.7rem;font-weight:800;text-transform:uppercase;">@producto.Cantidad unidades</span>
                            </td>
                            <td class="pf-td" style="text-align:right;">
                                <span style="font-size:1.1rem;font-weight:900;color:var(--pf-green);">$@producto.Total.ToString("N2")</span>
                            </td>
                            <td class="pf-td" style="text-align:center;">
                                <div style="display:flex;align-items:center;justify-content:center;gap:.625rem;">
                                    <div style="width:72px;height:8px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden;">
                                        <div style="width:@pct.ToString("F1")%;height:100%;background:linear-gradient(90deg,var(--pf-blue),var(--pf-purple));border-radius:999px;"></div>
                                    </div>
                                    <span style="font-size:.75rem;font-weight:800;color:var(--pf-text);">@pct.ToString("F1")%</span>
                                </div>
                            </td>
                        </tr>
                        pos++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="pf-card" style="text-align:center;padding:4rem 2rem;">
            <i data-lucide="inbox" style="width:72px;height:72px;color:var(--pf-border);display:block;margin:0 auto 1.25rem;"></i>
            <h3 style="font-size:1.25rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;margin:0 0 .625rem 0;">No hay ventas en este período</h3>
            <p style="color:var(--pf-muted);font-weight:600;margin:0;">Intenta seleccionar un rango de fechas diferente</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const productosData = @Html.Raw(JsonSerializer.Serialize(Model));
        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value, hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/productos-mas-vendidos?desde=${desde}&hasta=${hasta}`;
        }
        function renderChart() {
            if (!productosData || productosData.length === 0) return;
            new Chart(document.getElementById('chart-productos'), {
                type: 'bar',
                data: {
                    labels: productosData.map(p => p.Nombre),
                    datasets: [
                        { label: 'Unidades Vendidas', data: productosData.map(p => p.Cantidad), backgroundColor: '#3B82F6', borderRadius: 6, yAxisID: 'y' },
                        { label: 'Ingresos ($)', data: productosData.map(p => p.Total), backgroundColor: '#10B981', borderRadius: 6, yAxisID: 'y1' }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: true, position: 'top', labels: { color: '#94A3B8', font: { weight: 'bold' } } }, tooltip: { backgroundColor: 'rgba(6,11,24,.9)', padding: 12 } },
                    scales: {
                        y:  { type:'linear', display:true, position:'left',  title:{display:true,text:'Unidades',color:'#94A3B8'}, ticks:{color:'#94A3B8'}, grid:{color:'rgba(255,255,255,.05)'} },
                        y1: { type:'linear', display:true, position:'right', title:{display:true,text:'Ingresos ($)',color:'#94A3B8'}, ticks:{color:'#94A3B8'}, grid:{drawOnChartArea:false} },
                        x:  { ticks:{color:'#94A3B8'}, grid:{display:false} }
                    }
                }
            });
        }
        window.addEventListener('load', function() { renderChart(); lucide.createIcons(); });
    </script>
}

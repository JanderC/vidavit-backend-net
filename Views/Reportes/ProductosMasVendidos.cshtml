@model List<VidaFit.Controllers.WEB.ProductoVendidoReporte>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Productos Más Vendidos";
    ViewData["Subtitle"] = "Top productos con mayor demanda - POWER FITNESS";

    decimal totalIngresos = 0;
    int totalUnidades = 0;

    if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            totalIngresos += item.Total;
            totalUnidades += item.Cantidad;
        }
    }
}

<style>
    .pf-input {
        width: 100%; padding: 12px 16px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px; color: #fff; font-size: 0.9rem; font-weight: 600;
        font-family: 'Inter', sans-serif; outline: none; transition: border-color .2s, box-shadow .2s;
    }
    .pf-input:focus { border-color: #1E6FE3; box-shadow: 0 0 0 3px rgba(30,111,227,0.15); }
    .pf-label { display: block; font-size: 0.65rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 8px; }
    .stat-card { background: #0D0D20; border: 1px solid rgba(30,111,227,0.12); border-radius: 14px; padding: 20px 22px; }
    .section-card { background: #0D0D20; border: 1px solid rgba(30,111,227,0.12); border-radius: 14px; overflow: hidden; }
    .pf-table { width: 100%; border-collapse: collapse; }
    .pf-table thead tr { border-bottom: 1px solid rgba(30,111,227,0.2); }
    .pf-table thead th { padding: 13px 18px; font-size: 0.6rem; font-weight: 800; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255,255,255,0.3); }
    .pf-table thead th:first-child { text-align: center; }
    .pf-table thead th:nth-child(3) { text-align: center; }
    .pf-table thead th:nth-child(4) { text-align: right; }
    .pf-table thead th:last-child { text-align: center; }
    .pf-table tbody tr { border-bottom: 1px solid rgba(255,255,255,0.04); transition: background .15s; }
    .pf-table tbody tr:hover { background: rgba(30,111,227,0.05); }
    .pf-table tbody td { padding: 14px 18px; }
    .podium-card { background: #0D0D20; border: 1px solid rgba(30,111,227,0.15); border-radius: 14px; padding: 22px; }
</style>

<div style="display:flex;flex-direction:column;gap:18px;">

    <!-- Filtro -->
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:14px;padding:20px 22px;">
        <div style="display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;">
            <div style="flex:1;min-width:180px;">
                <label class="pf-label">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <div style="flex:1;min-width:180px;">
                <label class="pf-label">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <button onclick="filtrarPorFecha()"
                    style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer;transition:opacity .2s,transform .2s;"
                    onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.02)'" onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
                <i data-lucide="filter" style="width:15px;height:15px;"></i>
                Filtrar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <!-- Stats -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
            <div class="stat-card" style="border-left:3px solid #D97706;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Productos Vendidos</p>
                        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@Model.Count</p>
                    </div>
                    <div style="width:48px;height:48px;border-radius:12px;background:rgba(217,119,6,0.1);border:1px solid rgba(217,119,6,0.2);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="package" style="width:22px;height:22px;color:#D97706;"></i>
                    </div>
                </div>
            </div>
            <div class="stat-card" style="border-left:3px solid #10B981;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Ingresos Totales</p>
                        <p style="font-size:2rem;font-weight:900;color:#10B981;margin:0;">$@totalIngresos.ToString("N2")</p>
                    </div>
                    <div style="width:48px;height:48px;border-radius:12px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="dollar-sign" style="width:22px;height:22px;color:#10B981;"></i>
                    </div>
                </div>
            </div>
            <div class="stat-card" style="border-left:3px solid #3D8EFF;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Unidades Totales</p>
                        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@totalUnidades</p>
                    </div>
                    <div style="width:48px;height:48px;border-radius:12px;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.2);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="shopping-cart" style="width:22px;height:22px;color:#3D8EFF;"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Podio -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
            @{
                var podiumColors   = new[] { "#D4A017", "#94A3B8", "#CD7F32" };
                var podiumIcons    = new[] { "trophy", "medal", "award" };
                var podiumBgs      = new[] { "rgba(212,160,23,0.08)", "rgba(148,163,184,0.08)", "rgba(205,127,50,0.08)" };
                var podiumBorders  = new[] { "rgba(212,160,23,0.25)", "rgba(148,163,184,0.2)", "rgba(205,127,50,0.2)" };
            }
            @for (int i = 0; i < Math.Min(3, Model.Count); i++)
            {
                var producto = Model[i];
                <div class="podium-card" style="border-color:@podiumBorders[i];background:@podiumBgs[i];">
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                        <div style="width:48px;height:48px;border-radius:12px;background:@podiumBgs[i];border:1px solid @podiumBorders[i];display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i data-lucide="@podiumIcons[i]" style="width:22px;height:22px;color:@podiumColors[i];"></i>
                        </div>
                        <div>
                            <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.35);margin:0 0 3px 0;">Puesto #@(i + 1)</p>
                            <p style="font-weight:900;color:#fff;font-size:0.95rem;text-transform:uppercase;margin:0;">@producto.Nombre</p>
                        </div>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid rgba(255,255,255,0.06);padding-top:12px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:0.78rem;color:rgba(255,255,255,0.45);font-weight:600;">Unidades:</span>
                            <span style="font-weight:900;color:@podiumColors[i];font-size:1.1rem;">@producto.Cantidad</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:0.78rem;color:rgba(255,255,255,0.45);font-weight:600;">Ingresos:</span>
                            <span style="font-weight:900;color:#10B981;font-size:1.1rem;">$@producto.Total.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Chart -->
        <div class="section-card" style="padding:24px;">
            <p style="font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:2px;color:#fff;margin:0 0 20px 0;">Comparativa de Ventas</p>
            <div style="height:380px;">
                <canvas id="chart-productos"></canvas>
            </div>
        </div>

        <!-- Tabla ranking -->
        <div class="section-card">
            <div style="padding:16px 20px;border-bottom:1px solid rgba(30,111,227,0.15);background:linear-gradient(135deg,rgba(30,111,227,0.1),rgba(107,63,160,0.1));">
                <p style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#fff;margin:0;">Ranking Completo</p>
            </div>
            <table class="pf-table">
                <thead>
                    <tr>
                        <th style="text-align:center;">Posición</th>
                        <th>Producto</th>
                        <th style="text-align:center;">Unidades</th>
                        <th style="text-align:right;">Ingresos</th>
                        <th style="text-align:center;">Participación</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var posicion = 1;
                    }
                    @foreach (var producto in Model)
                    {
                        var porcentaje = totalIngresos > 0 ? (producto.Total / totalIngresos * 100) : 0;
                        var esTop = posicion <= 3;
                        <tr>
                            <td style="text-align:center;">
                                <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:@(esTop ? "linear-gradient(135deg,#1E6FE3,#6B3FA0)" : "rgba(255,255,255,0.06)");color:#fff;font-weight:900;font-size:0.85rem;">
                                    @posicion
                                </span>
                            </td>
                            <td>
                                <div style="display:flex;align-items:center;gap:12px;">
                                    <div style="width:40px;height:40px;border-radius:10px;background:rgba(30,111,227,0.08);border:1px solid rgba(30,111,227,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <i data-lucide="package" style="width:18px;height:18px;color:rgba(30,111,227,0.5);"></i>
                                    </div>
                                    <span style="font-weight:800;color:#fff;">@producto.Nombre</span>
                                </div>
                            </td>
                            <td style="text-align:center;">
                                <span style="display:inline-block;padding:4px 12px;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.2);border-radius:100px;font-size:0.65rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:#7EB8FF;">
                                    @producto.Cantidad uds
                                </span>
                            </td>
                            <td style="text-align:right;">
                                <span style="font-weight:900;color:#10B981;font-size:1.1rem;">$@producto.Total.ToString("N2")</span>
                            </td>
                            <td style="text-align:center;">
                                <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
                                    <div style="width:80px;height:5px;background:rgba(255,255,255,0.08);border-radius:3px;overflow:hidden;">
                                        <div style="height:100%;width:@porcentaje.ToString("F1")%;background:linear-gradient(90deg,#1E6FE3,#6B3FA0);border-radius:3px;"></div>
                                    </div>
                                    <span style="font-size:0.72rem;font-weight:800;color:rgba(255,255,255,0.5);">@porcentaje.ToString("F1")%</span>
                                </div>
                            </td>
                        </tr>
                        posicion++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:14px;padding:60px;text-align:center;">
            <i data-lucide="inbox" style="width:56px;height:56px;color:rgba(255,255,255,0.15);margin:0 auto 16px;display:block;"></i>
            <p style="font-family:'Bebas Neue',sans-serif;font-size:1.5rem;letter-spacing:2px;color:rgba(255,255,255,0.5);margin:0 0 8px 0;">No hay ventas en este período</p>
            <p style="font-size:0.85rem;color:rgba(255,255,255,0.3);font-weight:600;margin:0;">Intenta seleccionar un rango de fechas diferente</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const productosData = @Html.Raw(JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/productos-mas-vendidos?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            if (!productosData || productosData.length === 0) return;
            const ctx = document.getElementById('chart-productos');
            const labels = productosData.map(p => p.Nombre);
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [
                        { label: 'Unidades Vendidas', data: productosData.map(p => p.Cantidad), backgroundColor: '#1E6FE3', borderRadius: 6, yAxisID: 'y' },
                        { label: 'Ingresos ($)', data: productosData.map(p => p.Total), backgroundColor: '#10b981', borderRadius: 6, yAxisID: 'y1' }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true, position: 'top', labels: { color: 'rgba(255,255,255,0.6)', font: { weight: '700' } } },
                        tooltip: { backgroundColor: 'rgba(5,5,15,0.95)', padding: 12 }
                    },
                    scales: {
                        y: { type: 'linear', position: 'left', title: { display: true, text: 'Unidades', color: 'rgba(255,255,255,0.4)' }, grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: 'rgba(255,255,255,0.4)' } },
                        y1: { type: 'linear', position: 'right', title: { display: true, text: 'Ingresos ($)', color: 'rgba(255,255,255,0.4)' }, grid: { drawOnChartArea: false }, ticks: { color: 'rgba(255,255,255,0.4)' } },
                        x: { grid: { display: false }, ticks: { color: 'rgba(255,255,255,0.4)' } }
                    }
                }
            });
        }

        window.addEventListener('load', function() { renderChart(); lucide.createIcons(); });
    </script>
}

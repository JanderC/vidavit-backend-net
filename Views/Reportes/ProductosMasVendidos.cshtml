@model List<VidaFit.Controllers.WEB.ProductoVendidoReporte>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Productos Más Vendidos";
    ViewData["Subtitle"] = "Top productos con mayor demanda - Tallest GYM";

    decimal totalIngresos = 0;
    int totalUnidades = 0;

    if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            totalIngresos += item.Total;
            totalUnidades += item.Cantidad;
        }
    }
}

<style>
    :root {
        --tg-green: #2EAD4B;
        --tg-green-dark: #1e8a38;
        --tg-green-light: #f0fdf4;
        --tg-border: #c6e8cf;
        --tg-black: #1a1a1a;
        --tg-dark: #2D2D2D;
        --tg-white: #ffffff;
    }

    .tg-card {
        background: var(--tg-white);
        border-radius: 1.25rem;
        border: 2px solid #e5e7eb;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

    .tg-input {
        border: 2px solid #e5e7eb;
        border-radius: .65rem;
        padding: .75rem 1rem;
        font-weight: 600;
        transition: border-color .2s, box-shadow .2s;
        width: 100%;
        background: #fafafa;
    }

        .tg-input:focus {
            outline: none;
            border-color: var(--tg-green);
            box-shadow: 0 0 0 3px rgba(46,173,75,0.15);
        }

    .tg-btn-filter {
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
        color: var(--tg-white);
        font-weight: 900;
        padding: .75rem 2rem;
        border-radius: .75rem;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: all .2s;
        text-transform: uppercase;
        letter-spacing: .07em;
        box-shadow: 0 4px 16px rgba(46,173,75,0.3);
        font-size: .9rem;
    }

        .tg-btn-filter:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(46,173,75,0.4);
        }

    .tg-stat-card {
        background: var(--tg-white);
        border-radius: 1.25rem;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        padding: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .tg-table-head {
        background: linear-gradient(135deg, var(--tg-black), var(--tg-dark));
    }

    .tg-progress-bar {
        height: .65rem;
        border-radius: 9999px;
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
    }

    .tg-rank-top {
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
        color: var(--tg-white);
    }

    .tg-rank-normal {
        background: #e5e7eb;
        color: var(--tg-dark);
    }

    .tg-podium-1 {
        background: #fffbeb;
        border: 2px solid #f59e0b;
    }

    .tg-podium-2 {
        background: #f9fafb;
        border: 2px solid #9ca3af;
    }

    .tg-podium-3 {
        background: #fff7ed;
        border: 2px solid #f97316;
    }

    .tg-icon-1 {
        color: #d97706;
        background: #fef3c7;
    }

    .tg-icon-2 {
        color: #6b7280;
        background: #f3f4f6;
    }

    .tg-icon-3 {
        color: #ea580c;
        background: #ffedd5;
    }
</style>

<div class="space-y-6">

    <!-- Filtros -->
    <div class="tg-card p-6">
        <div class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-black text-gray-600 mb-2 uppercase tracking-widest">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="tg-input">
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-black text-gray-600 mb-2 uppercase tracking-widest">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="tg-input">
            </div>
            <button onclick="filtrarPorFecha()" class="tg-btn-filter">
                <i data-lucide="filter" class="w-4 h-4"></i>
                Filtrar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="tg-stat-card border-l-4" style="border-left-color:#f59e0b;">
                <div>
                    <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Productos Vendidos</p>
                    <p class="text-4xl font-black text-gray-900">@Model.Count</p>
                </div>
                <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center">
                    <i data-lucide="package" class="w-7 h-7 text-amber-600"></i>
                </div>
            </div>
            <div class="tg-stat-card border-l-4" style="border-left-color:var(--tg-green);">
                <div>
                    <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Ingresos Totales</p>
                    <p class="text-4xl font-black text-gray-900">$@totalIngresos.ToString("N2")</p>
                </div>
                <div class="w-14 h-14 rounded-full flex items-center justify-center" style="background:var(--tg-green-light);">
                    <i data-lucide="dollar-sign" class="w-7 h-7" style="color:var(--tg-green);"></i>
                </div>
            </div>
            <div class="tg-stat-card border-l-4 border-blue-500">
                <div>
                    <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Unidades Totales</p>
                    <p class="text-4xl font-black text-gray-900">@totalUnidades</p>
                </div>
                <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center">
                    <i data-lucide="shopping-cart" class="w-7 h-7 text-blue-600"></i>
                </div>
            </div>
        </div>

        <!-- Podium Top 3 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @for (int i = 0; i < Math.Min(3, Model.Count); i++)
            {
                var producto = Model[i];
                var podiumClass = i == 0 ? "tg-podium-1" : i == 1 ? "tg-podium-2" : "tg-podium-3";
                var iconClass = i == 0 ? "tg-icon-1" : i == 1 ? "tg-icon-2" : "tg-icon-3";
                var icon = i == 0 ? "trophy" : i == 1 ? "medal" : "award";

                <div class="rounded-2xl shadow-lg p-6 @podiumClass transition-transform hover:scale-105">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-14 h-14 rounded-full flex items-center justify-center @iconClass">
                            <i data-lucide="@icon" class="w-7 h-7"></i>
                        </div>
                        <div class="flex-1">
                            <p class="text-xs text-gray-500 uppercase font-black tracking-widest">Puesto #@(i + 1)</p>
                            <p class="font-black text-gray-900 text-base uppercase">@producto.Nombre</p>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-gray-500 font-bold uppercase tracking-wide">Unidades:</span>
                            <span class="font-black text-gray-900">@producto.Cantidad</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-gray-500 font-bold uppercase tracking-wide">Ingresos:</span>
                            <span class="font-black" style="color:var(--tg-green);">$@producto.Total.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Gráfico -->
        <div class="tg-card p-8">
            <h3 class="text-xl font-black text-gray-900 mb-6 uppercase tracking-wide flex items-center gap-2">
                <span class="w-1 h-6 rounded-full inline-block" style="background:var(--tg-green);"></span>
                Comparativa de Ventas
            </h3>
            <div class="relative" style="height:400px;">
                <canvas id="chart-productos"></canvas>
            </div>
        </div>

        <!-- Ranking tabla -->
        <div class="tg-card overflow-hidden">
            <div class="px-6 py-4 tg-table-head">
                <h3 class="text-lg font-black text-white uppercase tracking-wide">Ranking Completo · Tallest GYM</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b-2 border-gray-100">
                        <tr>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Pos.</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Producto</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Unidades</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-500 uppercase tracking-widest">Ingresos</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Participación</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y-2 divide-gray-100">
                        @{
                            var posicion = 1;
                        }
                        @foreach (var producto in Model)
                        {
                            var porcentaje = totalIngresos > 0 ? (producto.Total / totalIngresos * 100) : 0;
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center justify-center w-9 h-9 font-black rounded-full text-sm @(posicion <= 3 ? "tg-rank-top" : "tg-rank-normal")">
                                        @posicion
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="w-11 h-11 rounded-xl flex items-center justify-center" style="background:var(--tg-green-light);border:2px solid var(--tg-border);">
                                            <i data-lucide="package" class="w-5 h-5" style="color:var(--tg-green);"></i>
                                        </div>
                                        <span class="font-black text-gray-900">@producto.Nombre</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center px-3 py-1.5 bg-blue-100 text-blue-800 font-black rounded-full text-xs uppercase tracking-wide">
                                        @producto.Cantidad uds
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <span class="text-xl font-black" style="color:var(--tg-green);">$@producto.Total.ToString("N2")</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <div class="w-24 bg-gray-200 rounded-full h-2.5">
                                            <div class="tg-progress-bar" style="width:@porcentaje.ToString("F1")%;"></div>
                                        </div>
                                        <span class="text-xs font-black text-gray-700">@porcentaje.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                            posicion++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="tg-card p-12 text-center">
            <div class="w-24 h-24 rounded-full mx-auto mb-4 flex items-center justify-center" style="background:var(--tg-green-light);">
                <i data-lucide="inbox" class="w-12 h-12" style="color:var(--tg-green);"></i>
            </div>
            <h3 class="text-2xl font-black text-gray-900 mb-3 uppercase tracking-wide">No hay ventas en este período</h3>
            <p class="text-gray-500 font-semibold">Intenta seleccionar un rango de fechas diferente</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const productosData = @Html.Raw(JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/productos-mas-vendidos?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            if (!productosData || productosData.length === 0) return;
            const ctx = document.getElementById('chart-productos');
            const labels = productosData.map(p => p.Nombre);
            const cantidades = productosData.map(p => p.Cantidad);
            const ingresos = productosData.map(p => p.Total);

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Unidades Vendidas',
                            data: cantidades,
                            backgroundColor: '#2EAD4B',
                            borderRadius: 6,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Ingresos ($)',
                            data: ingresos,
                            backgroundColor: '#1a1a1a',
                            borderRadius: 6,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true, position: 'top' },
                        tooltip: { backgroundColor: 'rgba(26,26,26,0.9)', padding: 12 }
                    },
                    scales: {
                        y: {
                            type: 'linear', position: 'left',
                            title: { display: true, text: 'Unidades' },
                            grid: { color: 'rgba(0,0,0,0.04)' }
                        },
                        y1: {
                            type: 'linear', position: 'right',
                            title: { display: true, text: 'Ingresos ($)' },
                            grid: { drawOnChartArea: false }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        window.addEventListener('load', function() {
            renderChart();
            lucide.createIcons();
        });
    </script>
}

@model IEnumerable<dynamic>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reporte de Asistencia";
    ViewData["Subtitle"] = "Control de check-ins y visitas al gimnasio";

    int totalCheckins = 0;
    foreach (var item in Model)
    {
        totalCheckins += Convert.ToInt32(item.Total);
    }
    double promedioDiario = Model.Any() ? (double)totalCheckins / Model.Count() : 0;
}

<div class="space-y-6">
    <!-- Filtros de Fecha -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-medium text-gray-700 mb-2">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-medium text-gray-700 mb-2">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
            </div>
            <button onclick="filtrarPorFecha()"
                    class="px-6 py-2 bg-vida-primary hover:bg-vida-accent text-vida-dark font-semibold rounded-lg transition-all">
                <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                Filtrar
            </button>
        </div>
    </div>

    <!-- Módulo de Check-ins del Día -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
            <div>
                <h3 class="text-lg font-bold text-gray-800">Check-ins de Hoy</h3>
                <p class="text-sm text-gray-500 mt-1">Clientes que han registrado entrada</p>
            </div>
            <div class="flex items-center gap-2">
                <select id="filtro-dias" onchange="cargarCheckIns()"
                        class="px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-vida-primary focus:border-transparent">
                    <option value="0">Hoy</option>
                    <option value="1">Ayer</option>
                    <option value="7">Últimos 7 días</option>
                    <option value="30">Últimos 30 días</option>
                </select>
                <button onclick="cargarCheckIns()"
                        class="px-4 py-2 bg-vida-primary hover:bg-vida-accent text-vida-dark font-semibold rounded-lg transition-all">
                    <i data-lucide="refresh-cw" class="w-4 h-4 inline-block"></i>
                </button>
            </div>
        </div>
        <div class="overflow-x-auto" style="max-height: 500px; overflow-y: auto;">
            <div id="loading-checkins" class="p-8 text-center">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-vida-primary border-t-transparent"></div>
                <p class="text-gray-500 mt-2">Cargando check-ins...</p>
            </div>
            <table id="tabla-checkins" class="w-full hidden">
                <thead class="bg-gray-50 border-b border-gray-200 sticky top-0">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Hora</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Método</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nota</th>
                    </tr>
                </thead>
                <tbody id="tbody-checkins" class="bg-white divide-y divide-gray-200">
                </tbody>
            </table>
            <div id="no-checkins" class="hidden p-8 text-center">
                <i data-lucide="inbox" class="w-16 h-16 text-gray-300 mx-auto mb-4"></i>
                <p class="text-gray-500">No hay check-ins registrados en este período</p>
            </div>
        </div>
    </div>

    <!-- Resumen de Asistencia -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Total Check-ins</p>
                    <p class="text-3xl font-bold text-gray-800" id="total-checkins">@totalCheckins</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                    <i data-lucide="users" class="w-6 h-6 text-blue-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Promedio Diario</p>
                    <p class="text-3xl font-bold text-gray-800" id="promedio-diario">@Math.Round(promedioDiario, 1)</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-6 h-6 text-green-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-purple-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Día Más Activo</p>
                    <p class="text-3xl font-bold text-gray-800" id="dia-activo">
                        @(Model.Any() ? Model.OrderByDescending(x => x.Total).First().Total : 0)
                    </p>
                </div>
                <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                    <i data-lucide="award" class="w-6 h-6 text-purple-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border-l-4 border-yellow-500">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Días Analizados</p>
                    <p class="text-3xl font-bold text-gray-800">@Model.Count()</p>
                </div>
                <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                    <i data-lucide="calendar" class="w-6 h-6 text-yellow-600"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfica de Asistencia -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Tendencia de Asistencia</h3>
        <div class="relative" style="height: 350px;">
            <canvas id="chart-asistencia"></canvas>
        </div>
    </div>

    <!-- Tabla de Datos -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-bold text-gray-800">Detalle por Fecha</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Día</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Check-ins</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var item in Model.OrderByDescending(x => x.Fecha))
                    {
                        var fecha = (DateTime)item.Fecha;
                        var total = (int)item.Total;
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="font-semibold text-gray-800">@fecha.ToString("dd/MM/yyyy")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-gray-600">@fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES"))</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="inline-flex items-center px-3 py-1 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
                                    @total visitas
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @if (total >= 30)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">
                                        <i data-lucide="trending-up" class="w-3 h-3"></i> Alto
                                    </span>
                                }
                                else if (total >= 15)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-1 bg-yellow-100 text-yellow-800 text-xs font-semibold rounded-full">
                                        <i data-lucide="minus" class="w-3 h-3"></i> Medio
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full">
                                        <i data-lucide="trending-down" class="w-3 h-3"></i> Bajo
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const asistenciaData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/asistencia?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            const ctx = document.getElementById('chart-asistencia');

            const labels = asistenciaData.map(d => {
                const fecha = new Date(d.Fecha);
                return fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
            });

            const data = asistenciaData.map(d => d.Total);

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Check-ins',
                        data: data,
                        borderColor: '#7ED957',
                        backgroundColor: 'rgba(126, 217, 87, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#7ED957',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y + ' check-ins';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            },
                            ticks: {
                                stepSize: 5
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        window.addEventListener('load', function() {
            renderChart();
            lucide.createIcons();
            cargarCheckIns(); // Cargar check-ins al iniciar
        });

        // Función para cargar check-ins según el filtro seleccionado
        async function cargarCheckIns() {
            const loading = document.getElementById('loading-checkins');
            const tabla = document.getElementById('tabla-checkins');
            const tbody = document.getElementById('tbody-checkins');
            const noData = document.getElementById('no-checkins');
            const diasFiltro = parseInt(document.getElementById('filtro-dias').value);

            // Mostrar loading
            loading.classList.remove('hidden');
            tabla.classList.add('hidden');
            noData.classList.add('hidden');

            try {
                // Calcular fechas
                let fechaHasta = new Date();
                let fechaDesde = new Date();

                if (diasFiltro === 0) {
                    // Solo hoy
                    fechaDesde = new Date();
                } else if (diasFiltro === 1) {
                    // Ayer
                    fechaDesde.setDate(fechaDesde.getDate() - 1);
                    fechaHasta.setDate(fechaHasta.getDate() - 1);
                } else {
                    // Rango de días
                    fechaDesde.setDate(fechaDesde.getDate() - diasFiltro);
                }

                // Formatear fechas para el API
                const formatoFecha = (fecha) => fecha.toISOString().split('T')[0];

                // Llamar al API con rango de fechas
                const url = `/api/CheckIn/rango?desde=${formatoFecha(fechaDesde)}&hasta=${formatoFecha(fechaHasta)}`;
                const response = await fetch(url);
                const data = await response.json();

                // Ocultar loading
                loading.classList.add('hidden');

                if (data.success && data.checkIns && data.checkIns.length > 0) {
                    // Renderizar tabla
                    tbody.innerHTML = '';
                    data.checkIns.forEach(checkIn => {
                        // Parsear fecha correctamente (agregar Z si no la tiene)
                        let fechaStr = checkIn.FechaHora || checkIn.fechaHora;
                        if (fechaStr && !fechaStr.endsWith('Z')) {
                            fechaStr += 'Z';
                        }
                        const fecha = new Date(fechaStr);
                        const hora = fecha.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });

                        const metodoColor = {
                            'huella': 'bg-blue-100 text-blue-800',
                            'cedula': 'bg-purple-100 text-purple-800',
                            'manual': 'bg-gray-100 text-gray-800'
                        };

                        const metodoIcon = {
                            'huella': '👆',
                            'cedula': '🆔',
                            'manual': '✍️'
                        };

                        // Obtener valores con soporte para ambas notaciones (PascalCase y camelCase)
                        const clienteNombre = checkIn.clienteNombre || checkIn.ClienteNombre || 'Desconocido';
                        const metodo = (checkIn.Metodo || checkIn.metodo || 'desconocido').toLowerCase();
                        const exitoso = checkIn.Exitoso !== undefined ? checkIn.Exitoso : checkIn.exitoso;
                        const nota = checkIn.Nota || checkIn.nota || '-';
                        const fotoCliente = checkIn.fotoCliente || checkIn.FotoCliente;

                        const row = `
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        ${fotoCliente && fotoCliente !== 'string' ?
                                            `<img src="${fotoCliente.startsWith('data:') ? fotoCliente : 'data:image/jpeg;base64,' + fotoCliente}"
                                                 class="w-10 h-10 rounded-full object-cover border-2 border-gray-200"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                             <div class="w-10 h-10 rounded-full bg-gray-200 items-center justify-center hidden">
                                                <span class="text-sm font-bold text-gray-600">${clienteNombre.charAt(0)}</span>
                                             </div>`
                                            :
                                            `<div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center">
                                                <span class="text-sm font-bold text-gray-600">${clienteNombre.charAt(0)}</span>
                                             </div>`
                                        }
                                        <div>
                                            <p class="font-semibold text-gray-800">${clienteNombre}</p>
                                            <p class="text-xs text-gray-500">${fecha.toLocaleDateString('es-ES')}</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="font-semibold text-gray-800">${hora}</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center gap-1 px-2 py-1 ${metodoColor[metodo] || 'bg-gray-100 text-gray-800'} text-xs font-semibold rounded-full">
                                        ${metodoIcon[metodo] || '?'} ${metodo}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    ${exitoso ?
                                        `<span class="inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                            </svg> Exitoso
                                        </span>`
                                        :
                                        `<span class="inline-flex items-center gap-1 px-2 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg> Denegado
                                        </span>`
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-gray-600">${nota}</span>
                                </td>
                            </tr>
                        `;
                        tbody.innerHTML += row;
                    });

                    tabla.classList.remove('hidden');
                } else {
                    noData.classList.remove('hidden');
                }
            } catch (error) {
                console.error('Error al cargar check-ins:', error);
                loading.classList.add('hidden');
                noData.classList.remove('hidden');
            }
        }
    </script>
}

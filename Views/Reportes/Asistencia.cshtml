@model IEnumerable<dynamic>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reporte de Asistencia";
    ViewData["Subtitle"] = "Control de check-ins - POWER FITNESS";

    int totalCheckins = 0;
    foreach (var item in Model) { totalCheckins += Convert.ToInt32(item.Total); }
    double promedioDiario = Model.Any() ? (double)totalCheckins / Model.Count() : 0;
}

<style>
    .pf-input {
        width: 100%; padding: 12px 16px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px; color: #fff; font-size: 0.9rem; font-weight: 600;
        font-family: 'Inter', sans-serif; outline: none; transition: border-color .2s, box-shadow .2s;
    }
    .pf-input:focus { border-color: #1E6FE3; box-shadow: 0 0 0 3px rgba(30,111,227,0.15); }
    .pf-label { display: block; font-size: 0.65rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 8px; }
    .stat-card { background: #0D0D20; border: 1px solid rgba(30,111,227,0.12); border-radius: 14px; padding: 20px 22px; }
    .section-card { background: #0D0D20; border: 1px solid rgba(30,111,227,0.12); border-radius: 14px; overflow: hidden; }
    .pf-table { width: 100%; border-collapse: collapse; }
    .pf-table thead tr { border-bottom: 1px solid rgba(30,111,227,0.2); }
    .pf-table thead th { padding: 13px 18px; font-size: 0.6rem; font-weight: 800; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255,255,255,0.3); }
    .pf-table tbody tr { border-bottom: 1px solid rgba(255,255,255,0.04); transition: background .15s; }
    .pf-table tbody tr:hover { background: rgba(30,111,227,0.05); }
    .pf-table tbody td { padding: 14px 18px; }
    .pf-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 100px; font-size: 0.62rem; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; }

    /* Modal */
    .pf-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(6px); z-index: 50; align-items: flex-start; justify-content: center; padding: 48px 16px; overflow-y: auto; }
    .pf-overlay.show { display: flex; }
    .pf-modal { background: #0D0D20; border: 1px solid rgba(30,111,227,0.2); border-radius: 20px; width: 100%; max-width: 700px; box-shadow: 0 32px 80px rgba(0,0,0,0.6); }
    .pf-modal-header { background: linear-gradient(135deg,#1E6FE3,#6B3FA0); padding: 20px 24px; border-radius: 20px 20px 0 0; display: flex; align-items: center; justify-content: space-between; }
</style>

<div style="display:flex;flex-direction:column;gap:18px;">

    <!-- Filtro -->
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:14px;padding:20px 22px;">
        <div style="display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;">
            <div style="flex:1;min-width:180px;">
                <label class="pf-label">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <div style="flex:1;min-width:180px;">
                <label class="pf-label">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <button onclick="filtrarPorFecha()"
                    style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer;transition:opacity .2s,transform .2s;"
                    onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.02)'" onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
                <i data-lucide="filter" style="width:15px;height:15px;"></i> Filtrar
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;">
        <div class="stat-card" style="border-left:3px solid #3D8EFF;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Total Check-ins</p>
                    <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@totalCheckins</p>
                </div>
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.2);display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="users" style="width:20px;height:20px;color:#3D8EFF;"></i>
                </div>
            </div>
        </div>
        <div class="stat-card" style="border-left:3px solid #10B981;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Promedio Diario</p>
                    <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@Math.Round(promedioDiario, 1)</p>
                </div>
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="trending-up" style="width:20px;height:20px;color:#10B981;"></i>
                </div>
            </div>
        </div>
        <div class="stat-card" style="border-left:3px solid #a78bfa;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Día Más Activo</p>
                    <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@(Model.Any() ? Model.OrderByDescending(x => x.Total).First().Total : 0)</p>
                </div>
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(167,139,250,0.1);border:1px solid rgba(167,139,250,0.2);display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="award" style="width:20px;height:20px;color:#a78bfa;"></i>
                </div>
            </div>
        </div>
        <div class="stat-card" style="border-left:3px solid #D97706;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Días Analizados</p>
                    <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@Model.Count()</p>
                </div>
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(217,119,6,0.1);border:1px solid rgba(217,119,6,0.2);display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="calendar" style="width:20px;height:20px;color:#D97706;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart -->
    <div class="section-card" style="padding:24px;">
        <p style="font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:2px;color:#fff;margin:0 0 20px 0;">Tendencia de Asistencia</p>
        <div style="height:340px;">
            <canvas id="chart-asistencia"></canvas>
        </div>
    </div>

    <!-- Tabla -->
    <div class="section-card">
        <div style="padding:16px 20px;border-bottom:1px solid rgba(30,111,227,0.15);background:linear-gradient(135deg,rgba(30,111,227,0.1),rgba(107,63,160,0.1));">
            <p style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#fff;margin:0;">Detalle por Fecha</p>
        </div>
        <table class="pf-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Día</th>
                    <th style="text-align:center;">Check-ins</th>
                    <th style="text-align:center;">Estado</th>
                    <th style="text-align:center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderByDescending(x => x.Fecha))
                {
                    var fecha = (DateTime)item.Fecha;
                    var total = (int)item.Total;
                    var fechaStr = fecha.ToString("yyyy-MM-dd");
                    <tr>
                        <td><span style="font-weight:800;color:#fff;">@fecha.ToString("dd/MM/yyyy")</span></td>
                        <td><span style="color:rgba(255,255,255,0.5);font-weight:600;text-transform:capitalize;">@fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES"))</span></td>
                        <td style="text-align:center;">
                            <span class="pf-badge" style="background:rgba(30,111,227,0.1);color:#7EB8FF;border:1px solid rgba(30,111,227,0.2);">
                                @total visitas
                            </span>
                        </td>
                        <td style="text-align:center;">
                            @if (total >= 30)
                            {
                                <span class="pf-badge" style="background:rgba(16,185,129,0.1);color:#10B981;border:1px solid rgba(16,185,129,0.2);">
                                    <i data-lucide="trending-up" style="width:10px;height:10px;"></i> Alto
                                </span>
                            }
                            else if (total >= 15)
                            {
                                <span class="pf-badge" style="background:rgba(217,119,6,0.1);color:#D97706;border:1px solid rgba(217,119,6,0.2);">
                                    <i data-lucide="minus" style="width:10px;height:10px;"></i> Medio
                                </span>
                            }
                            else
                            {
                                <span class="pf-badge" style="background:rgba(248,113,113,0.1);color:#F87171;border:1px solid rgba(248,113,113,0.2);">
                                    <i data-lucide="trending-down" style="width:10px;height:10px;"></i> Bajo
                                </span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <button onclick="verAsistentes('@fechaStr', '@total')"
                                    style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.25);color:#3D8EFF;font-weight:800;font-size:0.7rem;letter-spacing:1.5px;text-transform:uppercase;border-radius:8px;cursor:pointer;transition:all .15s;"
                                    onmouseover="this.style.background='rgba(30,111,227,0.2)'" onmouseout="this.style.background='rgba(30,111,227,0.1)'">
                                <i data-lucide="users" style="width:13px;height:13px;"></i> Ver Asistentes
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Asistentes -->
<div id="modal-asistentes" class="pf-overlay">
    <div class="pf-modal">
        <div class="pf-modal-header">
            <div>
                <h3 style="font-family:'Bebas Neue',sans-serif;font-size:1.4rem;letter-spacing:3px;color:#fff;margin:0 0 2px 0;">Asistentes del Día</h3>
                <p style="font-size:0.78rem;color:rgba(255,255,255,0.65);font-weight:600;margin:0;" id="modal-fecha"></p>
            </div>
            <button onclick="cerrarModal()" style="background:rgba(255,255,255,0.1);border:none;border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;">
                <i data-lucide="x" style="width:16px;height:16px;"></i>
            </button>
        </div>
        <div style="padding:22px 24px;">
            <div id="modal-loading" style="display:none;text-align:center;padding:32px 0;">
                <div class="animate-spin" style="width:36px;height:36px;border:3px solid rgba(30,111,227,0.2);border-top-color:#1E6FE3;border-radius:50%;margin:0 auto 14px;"></div>
                <p style="color:rgba(255,255,255,0.35);font-weight:600;font-size:0.82rem;">Cargando asistentes...</p>
            </div>
            <div id="modal-content" style="display:none;">
                <div id="asistentes-lista"></div>
            </div>
        </div>
        <div style="padding:14px 24px;border-top:1px solid rgba(30,111,227,0.12);display:flex;align-items:center;justify-content:space-between;">
            <p style="font-size:0.78rem;font-weight:700;color:rgba(255,255,255,0.4);margin:0;">
                Total: <span id="modal-total" style="color:#3D8EFF;font-weight:900;font-size:1rem;">0</span>
            </p>
            <button onclick="cerrarModal()"
                    style="padding:9px 20px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:10px;color:rgba(255,255,255,0.5);font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;transition:background .15s;"
                    onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background='rgba(255,255,255,0.04)'">
                Cerrar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const asistenciaData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/asistencia?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            const ctx = document.getElementById('chart-asistencia');
            const labels = asistenciaData.map(d => {
                const fecha = new Date(d.Fecha);
                return fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
            });
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Check-ins',
                        data: asistenciaData.map(d => d.Total),
                        borderColor: '#1E6FE3',
                        backgroundColor: 'rgba(30,111,227,0.08)',
                        borderWidth: 3, fill: true, tension: 0.4,
                        pointRadius: 4, pointHoverRadius: 6,
                        pointBackgroundColor: '#6B3FA0',
                        pointBorderColor: '#fff', pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(5,5,15,0.95)', padding: 12,
                            callbacks: { label: ctx => ctx.parsed.y + ' check-ins' }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: 'rgba(255,255,255,0.4)', stepSize: 5 } },
                        x: { grid: { display: false }, ticks: { color: 'rgba(255,255,255,0.4)' } }
                    }
                }
            });
        }

        async function verAsistentes(fecha, total) {
            const overlay = document.getElementById('modal-asistentes');
            document.getElementById('modal-fecha').textContent = new Date(fecha + 'T00:00:00').toLocaleDateString('es-ES', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
            document.getElementById('modal-total').textContent = total;
            document.getElementById('modal-loading').style.display = 'block';
            document.getElementById('modal-content').style.display = 'none';
            overlay.classList.add('show');

            try {
                const r = await fetch(`/api/CheckIn/asistentes/${fecha}`);
                const data = await r.json();
                const lista = document.getElementById('asistentes-lista');
                if (data.success && data.asistentes?.length) {
                    lista.innerHTML = `<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;">` +
                        data.asistentes.map((a, i) => `
                            <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:rgba(255,255,255,0.02);border:1px solid rgba(30,111,227,0.12);border-radius:10px;">
                                ${a.fotoBase64
                                    ? `<img src="data:image/jpeg;base64,${a.fotoBase64}" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid rgba(30,111,227,0.3);flex-shrink:0;">`
                                    : `<div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;flex-shrink:0;">${a.nombre.charAt(0)}</div>`
                                }
                                <div style="flex:1;min-width:0;">
                                    <p style="font-weight:800;color:#fff;font-size:0.85rem;margin:0 0 3px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${a.nombre}</p>
                                    <div style="display:flex;align-items:center;gap:6px;">
                                        <span style="font-size:0.7rem;color:rgba(255,255,255,0.35);font-weight:600;">${a.hora}</span>
                                        <span style="display:inline-block;padding:2px 8px;background:rgba(30,111,227,0.1);color:#7EB8FF;border-radius:100px;font-size:0.6rem;font-weight:800;letter-spacing:1px;text-transform:uppercase;">${a.metodo}</span>
                                    </div>
                                </div>
                                <span style="font-weight:900;color:rgba(255,255,255,0.2);font-size:1rem;flex-shrink:0;">#${i+1}</span>
                            </div>`).join('') + `</div>`;
                } else {
                    lista.innerHTML = `<div style="text-align:center;padding:32px 0;"><i data-lucide="users" style="width:40px;height:40px;color:rgba(255,255,255,0.15);margin:0 auto 12px;display:block;"></i><p style="color:rgba(255,255,255,0.3);font-weight:700;">No hay asistentes registrados</p></div>`;
                }
                lucide.createIcons();
            } catch(e) {
                document.getElementById('asistentes-lista').innerHTML = `<p style="text-align:center;color:#F87171;font-weight:700;padding:24px;">Error al cargar los asistentes</p>`;
            } finally {
                document.getElementById('modal-loading').style.display = 'none';
                document.getElementById('modal-content').style.display = 'block';
            }
        }

        function cerrarModal() { document.getElementById('modal-asistentes').classList.remove('show'); }
        document.getElementById('modal-asistentes').addEventListener('click', e => { if (e.target === e.currentTarget) cerrarModal(); });

        window.addEventListener('load', function() { renderChart(); lucide.createIcons(); });
        window.verAsistentes = verAsistentes;
        window.cerrarModal = cerrarModal;
    </script>
}

@model IEnumerable<dynamic>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reporte de Asistencia";
    ViewData["Subtitle"] = "Control de check-ins - VidaFit";

    int totalCheckins = 0;
    foreach (var item in Model) { totalCheckins += Convert.ToInt32(item.Total); }
    double promedioDiario = Model.Any() ? (double)totalCheckins / Model.Count() : 0;
}

<style>
    :root {
        --vf-green: #39FF14;
        --vf-dark: #0a0a0a;
        --vf-card: #111111;
        --vf-border: #1f1f1f;
        --vf-text: #e5e5e5;
        --vf-muted: #6b7280;
    }

    .vf-page {
        background: var(--vf-dark);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .vf-card {
        background: var(--vf-card);
        border: 1px solid var(--vf-border);
        border-radius: 1rem;
    }

    .vf-label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        color: var(--vf-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .vf-input {
        background: #1a1a1a;
        border: 2px solid var(--vf-border);
        color: var(--vf-text);
        border-radius: .6rem;
        padding: .75rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s;
        width: 100%;
    }

        .vf-input:focus {
            border-color: var(--vf-green);
        }

    .vf-stat {
        background: var(--vf-card);
        border-radius: .85rem;
        padding: 1.5rem;
        border-left: 4px solid;
    }

    .vf-btn-filter {
        background: var(--vf-green);
        color: #0a0a0a;
        font-weight: 900;
        padding: .8rem 2rem;
        border-radius: .6rem;
        border: none;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: .06em;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: opacity .2s;
    }

        .vf-btn-filter:hover {
            opacity: .85;
        }

    .vf-table {
        width: 100%;
        border-collapse: collapse;
    }

        .vf-table th {
            background: #0f0f0f;
            color: var(--vf-muted);
            font-size: .75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            padding: .9rem 1.5rem;
            text-align: left;
            border-bottom: 1px solid var(--vf-border);
        }

        .vf-table td {
            padding: .85rem 1.5rem;
            border-bottom: 1px solid var(--vf-border);
        }

        .vf-table tr:hover td {
            background: #161616;
        }

        .vf-table tr:last-child td {
            border-bottom: none;
        }

    .vf-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .3rem .8rem;
        border-radius: 9999px;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .vf-btn-sm {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .9rem;
        border-radius: .5rem;
        font-weight: 700;
        font-size: .75rem;
        border: none;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: .05em;
        transition: opacity .2s;
    }

        .vf-btn-sm:hover {
            opacity: .85;
        }
    /* Modal */
    .vf-modal-backdrop {
        background: rgba(0,0,0,.75);
        backdrop-filter: blur(4px);
    }

    .vf-modal {
        background: var(--vf-card);
        border: 1px solid var(--vf-border);
        border-radius: 1rem;
        overflow: hidden;
    }
</style>

<div class="vf-page space-y-6">

    <!-- Header Brand -->
    <div style="display:flex;align-items:center;gap:.75rem;">
        <div style="background:var(--vf-green);padding:.4rem .9rem;border-radius:.5rem;">
            <span style="font-size:1.1rem;font-weight:900;color:#0a0a0a;letter-spacing:.05em;">VIDAFIT</span>
        </div>
        <div>
            <h2 style="font-size:1.5rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.04em;">Reporte de Asistencia</h2>
            <p style="color:var(--vf-muted);font-size:.82rem;">Control de check-ins del gimnasio</p>
        </div>
    </div>

    <!-- Filtro de fechas -->
    <div class="vf-card p-6">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:1rem;">
            <div style="flex:1;min-width:200px;">
                <label class="vf-label">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="vf-input">
            </div>
            <div style="flex:1;min-width:200px;">
                <label class="vf-label">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="vf-input">
            </div>
            <button onclick="filtrarPorFecha()" class="vf-btn-filter">
                <i data-lucide="filter" style="width:1rem;height:1rem;"></i>
                Filtrar
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="vf-stat" style="border-left-color:#3b82f6;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.75rem;font-weight:800;color:var(--vf-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.35rem;">Total Check-ins</p>
                    <p style="font-size:2.25rem;font-weight:900;color:#fff;">@totalCheckins</p>
                </div>
                <div style="width:3.5rem;height:3.5rem;background:#1d4ed822;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="users" style="width:1.6rem;height:1.6rem;color:#60a5fa;"></i>
                </div>
            </div>
        </div>

        <div class="vf-stat" style="border-left-color:var(--vf-green);">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.75rem;font-weight:800;color:var(--vf-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.35rem;">Promedio Diario</p>
                    <p style="font-size:2.25rem;font-weight:900;color:var(--vf-green);">@Math.Round(promedioDiario, 1)</p>
                </div>
                <div style="width:3.5rem;height:3.5rem;background:#39FF1422;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="trending-up" style="width:1.6rem;height:1.6rem;color:var(--vf-green);"></i>
                </div>
            </div>
        </div>

        <div class="vf-stat" style="border-left-color:#a78bfa;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.75rem;font-weight:800;color:var(--vf-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.35rem;">Día Más Activo</p>
                    <p style="font-size:2.25rem;font-weight:900;color:#a78bfa;">@(Model.Any() ? Model.OrderByDescending(x => x.Total).First().Total : 0)</p>
                </div>
                <div style="width:3.5rem;height:3.5rem;background:#7c3aed22;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="award" style="width:1.6rem;height:1.6rem;color:#a78bfa;"></i>
                </div>
            </div>
        </div>

        <div class="vf-stat" style="border-left-color:#f59e0b;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.75rem;font-weight:800;color:var(--vf-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.35rem;">Días Analizados</p>
                    <p style="font-size:2.25rem;font-weight:900;color:#fbbf24;">@Model.Count()</p>
                </div>
                <div style="width:3.5rem;height:3.5rem;background:#b4530922;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="calendar" style="width:1.6rem;height:1.6rem;color:#fbbf24;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfica -->
    <div class="vf-card p-8">
        <h3 style="font-size:1.25rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem;">
            <span style="display:block;width:3px;height:1.1rem;background:var(--vf-green);border-radius:2px;"></span>
            Tendencia de Asistencia
        </h3>
        <div style="position:relative;height:350px;">
            <canvas id="chart-asistencia"></canvas>
        </div>
    </div>

    <!-- Tabla Detalle -->
    <div class="vf-card" style="overflow:hidden;">
        <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--vf-border);background:#0f0f0f;display:flex;align-items:center;gap:.5rem;">
            <span style="display:block;width:3px;height:1rem;background:var(--vf-green);border-radius:2px;"></span>
            <h3 style="font-size:1rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.06em;">Detalle por Fecha</h3>
        </div>
        <div style="overflow-x:auto;">
            <table class="vf-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Día</th>
                        <th style="text-align:center;">Check-ins</th>
                        <th style="text-align:center;">Estado</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(x => x.Fecha))
                    {
                        var fecha = (DateTime)item.Fecha;
                        var total = (int)item.Total;
                        var fechaStr = fecha.ToString("yyyy-MM-dd");
                        <tr>
                            <td><span style="font-weight:800;color:#fff;">@fecha.ToString("dd/MM/yyyy")</span></td>
                            <td><span style="color:var(--vf-muted);font-weight:600;">@fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES"))</span></td>
                            <td style="text-align:center;">
                                <span class="vf-badge" style="background:#1d4ed822;color:#60a5fa;border:1px solid #1d4ed844;">
                                    @total visitas
                                </span>
                            </td>
                            <td style="text-align:center;">
                                @if (total >= 30)
                                {
                                    <span class="vf-badge" style="background:#05966922;color:#34d399;border:1px solid #05966944;">
                                        <i data-lucide="trending-up" style="width:.75rem;height:.75rem;"></i> Alto
                                    </span>
                                }
                                else if (total >= 15)
                                {
                                    <span class="vf-badge" style="background:#b4530922;color:#fb923c;border:1px solid #b4530944;">
                                        <i data-lucide="minus" style="width:.75rem;height:.75rem;"></i> Medio
                                    </span>
                                }
                                else
                                {
                                    <span class="vf-badge" style="background:#dc262622;color:#f87171;border:1px solid #dc262644;">
                                        <i data-lucide="trending-down" style="width:.75rem;height:.75rem;"></i> Bajo
                                    </span>
                                }
                            </td>
                            <td style="text-align:center;">
                                <button onclick="verAsistentes('@fechaStr', '@total')"
                                        class="vf-btn-sm" style="background:var(--vf-green);color:#0a0a0a;">
                                    <i data-lucide="users" style="width:.9rem;height:.9rem;"></i>
                                    Ver Asistentes
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL ASISTENTES -->
<div id="modal-asistentes" class="hidden fixed inset-0 vf-modal-backdrop flex items-center justify-center z-50 px-4">
    <div class="vf-modal max-w-4xl w-full max-h-[90vh] overflow-hidden" style="box-shadow:0 25px 60px rgba(0,0,0,.8);">
        <!-- Header Modal -->
        <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--vf-border);background:#0f0f0f;display:flex;align-items:center;justify-content:space-between;">
            <div>
                <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.2rem;">
                    <span style="background:var(--vf-green);color:#0a0a0a;font-size:.65rem;font-weight:900;padding:.15rem .55rem;border-radius:9999px;letter-spacing:.1em;">VIDAFIT</span>
                    <h3 style="font-size:1.25rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.05em;">Asistentes del Día</h3>
                </div>
                <p style="font-size:.82rem;color:var(--vf-muted);font-weight:600;" id="modal-fecha"></p>
            </div>
            <button onclick="cerrarModal()" style="color:var(--vf-muted);background:#1f1f1f;border:1px solid var(--vf-border);border-radius:.5rem;padding:.4rem;cursor:pointer;transition:color .2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--vf-muted)'">
                <i data-lucide="x" style="width:1.25rem;height:1.25rem;display:block;"></i>
            </button>
        </div>

        <!-- Loading -->
        <div id="modal-loading" class="hidden" style="padding:3rem;text-align:center;">
            <div style="display:inline-block;width:3rem;height:3rem;border:3px solid var(--vf-border);border-top-color:var(--vf-green);border-radius:50%;animation:spin 1s linear infinite;"></div>
            <p style="margin-top:1rem;color:var(--vf-muted);font-weight:600;">Cargando asistentes...</p>
        </div>

        <!-- Content -->
        <div id="modal-content" style="padding:1.5rem;overflow-y:auto;max-height:calc(90vh - 180px);">
            <div id="asistentes-lista"></div>
        </div>

        <!-- Footer Modal -->
        <div style="padding:1rem 1.5rem;border-top:1px solid var(--vf-border);background:#0f0f0f;display:flex;align-items:center;justify-content:space-between;">
            <p style="font-size:.875rem;font-weight:700;color:var(--vf-muted);">
                Total de asistentes: <span id="modal-total" style="color:var(--vf-green);font-size:1.1rem;font-weight:900;">0</span>
            </p>
            <button onclick="cerrarModal()" style="padding:.5rem 1.25rem;background:#1f1f1f;color:var(--vf-text);font-weight:700;border-radius:.5rem;border:1px solid var(--vf-border);cursor:pointer;text-transform:uppercase;font-size:.8rem;transition:background .2s;" onmouseover="this.style.background='#2a2a2a'" onmouseout="this.style.background='#1f1f1f'">
                Cerrar
            </button>
        </div>
    </div>
</div>

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const asistenciaData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/asistencia?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            const ctx = document.getElementById('chart-asistencia');
            const labels = asistenciaData.map(d => {
                const fecha = new Date(d.Fecha);
                return fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
            });
            const data = asistenciaData.map(d => d.Total);

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Check-ins',
                        data: data,
                        borderColor: '#39FF14',
                        backgroundColor: 'rgba(57,255,20,0.08)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointHoverRadius: 7,
                        pointBackgroundColor: '#39FF14',
                        pointBorderColor: '#111',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1a1a1a',
                            borderColor: '#1f1f1f',
                            borderWidth: 1,
                            titleColor: '#e5e5e5',
                            bodyColor: '#39FF14',
                            padding: 12,
                            callbacks: { label: ctx => ctx.parsed.y + ' check-ins' }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(255,255,255,0.04)' },
                            ticks: { color: '#6b7280', stepSize: 5 }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#6b7280' }
                        }
                    }
                }
            });
        }

        async function verAsistentes(fecha, total) {
            const modal = document.getElementById('modal-asistentes');
            const modalFecha = document.getElementById('modal-fecha');
            const modalTotal = document.getElementById('modal-total');
            const modalLoading = document.getElementById('modal-loading');
            const modalContent = document.getElementById('modal-content');
            const asistentesLista = document.getElementById('asistentes-lista');

            modal.classList.remove('hidden');
            modalLoading.classList.remove('hidden');
            modalContent.classList.add('hidden');

            const fechaObj = new Date(fecha + 'T00:00:00');
            modalFecha.textContent = fechaObj.toLocaleDateString('es-ES', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
            modalTotal.textContent = total;

            try {
                const response = await fetch(`/api/CheckIn/asistentes/${fecha}`);
                const data = await response.json();

                if (data.success && data.asistentes) {
                    if (data.asistentes.length === 0) {
                        asistentesLista.innerHTML = `
                            <div style="text-align:center;padding:3rem;">
                                <i data-lucide="users" style="width:4rem;height:4rem;margin:0 auto 1rem;color:#374151;display:block;"></i>
                                <p style="color:#6b7280;font-weight:600;">No hay asistentes registrados para este día</p>
                            </div>`;
                    } else {
                        let html = '<div class="grid grid-cols-1 md:grid-cols-2 gap-4">';
                        data.asistentes.forEach((asistente, index) => {
                            html += `
                                <div style="display:flex;align-items:center;gap:1rem;padding:1rem;background:#1a1a1a;border-radius:.75rem;border:1px solid #1f1f1f;transition:border-color .2s;" onmouseover="this.style.borderColor='#39FF14'" onmouseout="this.style.borderColor='#1f1f1f'">
                                    ${asistente.fotoBase64
                                        ? `<img src="data:image/jpeg;base64,${asistente.fotoBase64}" alt="${asistente.nombre}" style="width:3.5rem;height:3.5rem;border-radius:50%;object-fit:cover;border:2px solid #39FF14;" />`
                                        : `<div style="width:3.5rem;height:3.5rem;border-radius:50%;background:linear-gradient(135deg,#39FF14,#059669);display:flex;align-items:center;justify-content:center;font-size:1.25rem;font-weight:900;color:#0a0a0a;flex-shrink:0;">${asistente.nombre.charAt(0)}</div>`
                                    }
                                    <div style="flex:1;">
                                        <h4 style="font-weight:800;color:#fff;font-size:1rem;">${asistente.nombre}</h4>
                                        <div style="display:flex;align-items:center;gap:.5rem;margin-top:.25rem;">
                                            <span style="font-size:.78rem;color:#6b7280;font-weight:600;">
                                                <i data-lucide="clock" style="width:.75rem;height:.75rem;display:inline-block;margin-right:.2rem;"></i>${asistente.hora}
                                            </span>
                                            <span style="font-size:.7rem;padding:.15rem .5rem;background:#1d4ed822;color:#60a5fa;border-radius:9999px;font-weight:700;text-transform:uppercase;">${asistente.metodo}</span>
                                        </div>
                                    </div>
                                    <div style="font-size:1.25rem;font-weight:900;color:#374151;">#${index + 1}</div>
                                </div>`;
                        });
                        html += '</div>';
                        asistentesLista.innerHTML = html;
                    }
                    setTimeout(() => { if (typeof lucide !== 'undefined') lucide.createIcons(); }, 100);
                } else {
                    asistentesLista.innerHTML = `<div style="text-align:center;padding:3rem;"><i data-lucide="alert-circle" style="width:4rem;height:4rem;margin:0 auto 1rem;color:#f87171;display:block;"></i><p style="color:#f87171;font-weight:600;">Error al cargar los asistentes</p></div>`;
                }
            } catch (error) {
                console.error(error);
                asistentesLista.innerHTML = `<div style="text-align:center;padding:3rem;"><i data-lucide="alert-circle" style="width:4rem;height:4rem;margin:0 auto 1rem;color:#f87171;display:block;"></i><p style="color:#f87171;font-weight:600;">Error al cargar los asistentes</p><p style="font-size:.82rem;color:#6b7280;margin-top:.5rem;">${error.message}</p></div>`;
            } finally {
                modalLoading.classList.add('hidden');
                modalContent.classList.remove('hidden');
            }
        }

        function cerrarModal() { document.getElementById('modal-asistentes').classList.add('hidden'); }
        document.getElementById('modal-asistentes').addEventListener('click', function(e) { if (e.target === this) cerrarModal(); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarModal(); });

        window.addEventListener('load', function() { renderChart(); lucide.createIcons(); });
    </script>
}

@model IEnumerable<dynamic>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reporte de Asistencia";
    ViewData["Subtitle"] = "Control de check-ins - Power Fitness";
    int totalCheckins = 0;
    foreach (var item in Model) { totalCheckins += Convert.ToInt32(item.Total); }
    double promedioDiario = Model.Any() ? (double)totalCheckins / Model.Count() : 0;
}

<style>
    :root{--pf-blue:#3B82F6;--pf-blueB:#60A5FA;--pf-deep:#1E3A8A;--pf-purple:#7C3AED;--pf-card:#0D1526;--pf-border:#1E2D4A;--pf-text:#E2E8F0;--pf-soft:#94A3B8;--pf-muted:#64748B;--pf-green:#10B981;--pf-red:#EF4444;--pf-orange:#F59E0B;}
    .pf-input{width:100%;padding:.75rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:rgba(255,255,255,.03);color:var(--pf-text);font-weight:600;font-family:inherit;outline:none;box-sizing:border-box;transition:border-color .2s;}
    .pf-input:focus{border-color:var(--pf-blue);}
    .pf-card{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;padding:1.5rem;box-shadow:0 4px 20px rgba(0,0,0,.3);}
    .pf-th{padding:.875rem 1.5rem;font-size:.68rem;font-weight:800;color:rgba(255,255,255,.85);text-transform:uppercase;letter-spacing:.12em;}
    .pf-td{padding:1rem 1.5rem;border-bottom:1px solid var(--pf-border);}
    /* Modal */
    #modal-asistentes{display:none;position:fixed;inset:0;background:rgba(6,11,24,.8);backdrop-filter:blur(6px);z-index:50;align-items:center;justify-content:center;padding:1rem;}
    #modal-asistentes.flex{display:flex;}
    .modal-card{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1.25rem;width:100%;max-width:52rem;max-height:90vh;overflow:hidden;box-shadow:0 25px 60px rgba(0,0,0,.6);display:flex;flex-direction:column;}
    .modal-header{background:linear-gradient(135deg,var(--pf-deep),var(--pf-purple));padding:1.25rem 1.5rem;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;border-bottom:1px solid rgba(96,165,250,.2);}
    .modal-body{padding:1.25rem;overflow-y:auto;flex:1;}
    .modal-footer{padding:1rem 1.5rem;border-top:1px solid var(--pf-border);background:rgba(6,11,24,.5);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
</style>

<div style="display:flex;flex-direction:column;gap:1.25rem;">

    <!-- Filtro -->
    <div class="pf-card">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:1rem;">
            <div style="flex:1;min-width:180px;">
                <label style="display:block;font-size:.7rem;font-weight:800;color:var(--pf-soft);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem;">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <div style="flex:1;min-width:180px;">
                <label style="display:block;font-size:.7rem;font-weight:800;color:var(--pf-soft);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem;">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <button onclick="filtrarPorFecha()"
                    style="padding:.75rem 2rem;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;font-weight:800;border:none;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;display:inline-flex;align-items:center;gap:.5rem;box-shadow:0 4px 16px rgba(59,130,246,.3);transition:transform .2s;"
                    onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                <i data-lucide="filter" style="width:16px;height:16px;"></i> Filtrar
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;">
        <div class="pf-card" style="border-left:4px solid var(--pf-blue);display:flex;align-items:center;justify-content:space-between;">
            <div><p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Total Check-ins</p><p style="font-size:2rem;font-weight:900;color:var(--pf-blueB);margin:0;">@totalCheckins</p></div>
            <div style="width:46px;height:46px;background:rgba(59,130,246,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i data-lucide="users" style="width:22px;height:22px;color:var(--pf-blueB);"></i></div>
        </div>
        <div class="pf-card" style="border-left:4px solid var(--pf-green);display:flex;align-items:center;justify-content:space-between;">
            <div><p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Promedio Diario</p><p style="font-size:2rem;font-weight:900;color:var(--pf-green);margin:0;">@Math.Round(promedioDiario, 1)</p></div>
            <div style="width:46px;height:46px;background:rgba(16,185,129,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i data-lucide="trending-up" style="width:22px;height:22px;color:var(--pf-green);"></i></div>
        </div>
        <div class="pf-card" style="border-left:4px solid #A78BFA;display:flex;align-items:center;justify-content:space-between;">
            <div><p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Día Más Activo</p><p style="font-size:2rem;font-weight:900;color:#A78BFA;margin:0;">@(Model.Any() ? Model.OrderByDescending(x => x.Total).First().Total : 0)</p></div>
            <div style="width:46px;height:46px;background:rgba(124,58,237,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i data-lucide="award" style="width:22px;height:22px;color:#A78BFA;"></i></div>
        </div>
        <div class="pf-card" style="border-left:4px solid var(--pf-orange);display:flex;align-items:center;justify-content:space-between;">
            <div><p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Días Analizados</p><p style="font-size:2rem;font-weight:900;color:var(--pf-orange);margin:0;">@Model.Count()</p></div>
            <div style="width:46px;height:46px;background:rgba(245,158,11,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i data-lucide="calendar" style="width:22px;height:22px;color:var(--pf-orange);"></i></div>
        </div>
    </div>

    <!-- Gráfico -->
    <div class="pf-card">
        <h3 style="font-size:1rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.08em;margin:0 0 1.25rem 0;">Tendencia de Asistencia</h3>
        <div style="position:relative;height:320px;"><canvas id="chart-asistencia"></canvas></div>
    </div>

    <!-- Tabla -->
    <div class="pf-card" style="padding:0;overflow:hidden;">
        <div style="padding:.875rem 1.5rem;background:linear-gradient(135deg,var(--pf-deep),#111827);border-bottom:2px solid var(--pf-blue);">
            <h3 style="font-size:.95rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.08em;margin:0;">Detalle por Fecha</h3>
        </div>
        <table style="width:100%;border-collapse:collapse;">
            <thead><tr style="background:rgba(6,11,24,.5);">
                <th class="pf-th">Fecha</th>
                <th class="pf-th">Día</th>
                <th class="pf-th" style="text-align:center;">Check-ins</th>
                <th class="pf-th" style="text-align:center;">Estado</th>
                <th class="pf-th" style="text-align:center;">Acciones</th>
            </tr></thead>
            <tbody>
                @foreach (var item in Model.OrderByDescending(x => x.Fecha))
                {
                    var fecha = (DateTime)item.Fecha;
                    var total = (int)item.Total;
                    var fechaStr = fecha.ToString("yyyy-MM-dd");
                    <tr style="transition:background .15s;" onmouseover="this.style.background='rgba(59,130,246,.04)'" onmouseout="this.style.background='transparent'">
                        <td class="pf-td"><span style="font-weight:800;color:var(--pf-text);">@fecha.ToString("dd/MM/yyyy")</span></td>
                        <td class="pf-td"><span style="color:var(--pf-soft);font-weight:700;text-transform:capitalize;">@fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES"))</span></td>
                        <td class="pf-td" style="text-align:center;">
                            <span style="padding:.22rem .75rem;background:rgba(59,130,246,.1);color:var(--pf-blueB);border:1px solid rgba(59,130,246,.25);border-radius:999px;font-size:.72rem;font-weight:800;text-transform:uppercase;">@total visitas</span>
                        </td>
                        <td class="pf-td" style="text-align:center;">
                            @if (total >= 30)
                            { <span style="display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .75rem;background:rgba(16,185,129,.1);color:var(--pf-green);border:1px solid rgba(16,185,129,.25);border-radius:999px;font-size:.7rem;font-weight:800;text-transform:uppercase;"><i data-lucide="trending-up" style="width:11px;height:11px;"></i> Alto</span> }
                            else if (total >= 15)
                            { <span style="display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .75rem;background:rgba(245,158,11,.1);color:var(--pf-orange);border:1px solid rgba(245,158,11,.25);border-radius:999px;font-size:.7rem;font-weight:800;text-transform:uppercase;"><i data-lucide="minus" style="width:11px;height:11px;"></i> Medio</span> }
                            else
                            { <span style="display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .75rem;background:rgba(239,68,68,.1);color:var(--pf-red);border:1px solid rgba(239,68,68,.25);border-radius:999px;font-size:.7rem;font-weight:800;text-transform:uppercase;"><i data-lucide="trending-down" style="width:11px;height:11px;"></i> Bajo</span> }
                        </td>
                        <td class="pf-td" style="text-align:center;">
                            <button onclick="verAsistentes('@fechaStr', '@total')"
                                    style="display:inline-flex;align-items:center;gap:.4rem;padding:.5rem 1rem;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;font-weight:800;border:none;border-radius:.625rem;cursor:pointer;font-family:inherit;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;box-shadow:0 3px 10px rgba(59,130,246,.3);transition:transform .2s;"
                                    onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                <i data-lucide="users" style="width:14px;height:14px;"></i> Ver Asistentes
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Asistentes -->
<div id="modal-asistentes">
    <div class="modal-card">
        <div class="modal-header">
            <div>
                <h3 style="font-size:1.1rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.08em;margin:0 0 .2rem 0;">Asistentes del Día</h3>
                <p style="font-size:.78rem;color:rgba(255,255,255,.65);font-weight:600;margin:0;" id="modal-fecha"></p>
            </div>
            <button onclick="cerrarModal()" style="background:rgba(255,255,255,.1);border:none;cursor:pointer;color:#fff;padding:.5rem;border-radius:.5rem;transition:background .15s;" onmouseover="this.style.background='rgba(255,255,255,.2)'" onmouseout="this.style.background='rgba(255,255,255,.1)'">
                <i data-lucide="x" style="width:20px;height:20px;"></i>
            </button>
        </div>
        <div id="modal-loading" class="hidden modal-body" style="text-align:center;padding:3rem;">
            <div style="width:48px;height:48px;border:4px solid rgba(59,130,246,.15);border-top-color:var(--pf-blue);border-radius:50%;margin:0 auto 1rem;"></div>
            <p style="color:var(--pf-muted);font-weight:700;">Cargando asistentes...</p>
        </div>
        <div id="modal-content" class="modal-body"><div id="asistentes-lista"></div></div>
        <div class="modal-footer">
            <p style="font-size:.82rem;font-weight:700;color:var(--pf-soft);">Total: <span id="modal-total" style="color:var(--pf-blueB);font-size:1.1rem;font-weight:900;">0</span></p>
            <button onclick="cerrarModal()"
                    style="padding:.6rem 1.5rem;background:rgba(255,255,255,.06);border:1px solid var(--pf-border);color:var(--pf-soft);font-weight:800;border-radius:.75rem;cursor:pointer;font-family:inherit;font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;transition:background .2s;"
                    onmouseover="this.style.background='rgba(255,255,255,.1)'" onmouseout="this.style.background='rgba(255,255,255,.06)'">Cerrar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const asistenciaData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value, hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/asistencia?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            new Chart(document.getElementById('chart-asistencia'), {
                type: 'line',
                data: {
                    labels: asistenciaData.map(d => { const f=new Date(d.Fecha); return f.toLocaleDateString('es-ES',{day:'2-digit',month:'short'}); }),
                    datasets: [{ label:'Check-ins', data:asistenciaData.map(d=>d.Total), borderColor:'#3B82F6', backgroundColor:'rgba(59,130,246,.08)', borderWidth:3, fill:true, tension:.4, pointRadius:4, pointHoverRadius:6, pointBackgroundColor:'#3B82F6', pointBorderColor:'#fff', pointBorderWidth:2 }]
                },
                options: {
                    responsive:true, maintainAspectRatio:false,
                    plugins: { legend:{display:false}, tooltip:{backgroundColor:'rgba(6,11,24,.9)',padding:12,callbacks:{label:ctx=>ctx.parsed.y+' check-ins'}} },
                    scales: {
                        y:{beginAtZero:true,ticks:{color:'#94A3B8',stepSize:5},grid:{color:'rgba(255,255,255,.05)'}},
                        x:{ticks:{color:'#94A3B8'},grid:{display:false}}
                    }
                }
            });
        }

        async function verAsistentes(fecha, total) {
            const modal=document.getElementById('modal-asistentes'), loading=document.getElementById('modal-loading'), content=document.getElementById('modal-content');
            document.getElementById('modal-fecha').textContent = new Date(fecha+'T00:00:00').toLocaleDateString('es-ES',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
            document.getElementById('modal-total').textContent = total;
            modal.classList.add('flex'); loading.classList.remove('hidden'); content.classList.add('hidden');
            try {
                const r = await fetch(`/api/CheckIn/asistentes/${fecha}`);
                const data = await r.json();
                const lista = document.getElementById('asistentes-lista');
                if (data.success && data.asistentes && data.asistentes.length > 0) {
                    lista.innerHTML = `<div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;">${data.asistentes.map((a,i) => `
                        <div style="display:flex;align-items:center;gap:.875rem;padding:.875rem 1rem;background:rgba(255,255,255,.03);border:1px solid var(--pf-border);border-radius:.875rem;transition:background .15s;" onmouseover="this.style.background='rgba(59,130,246,.05)'" onmouseout="this.style.background='rgba(255,255,255,.03)'">
                            ${a.fotoBase64 ? `<img src="data:image/jpeg;base64,${a.fotoBase64}" style="width:52px;height:52px;border-radius:50%;object-fit:cover;border:2px solid var(--pf-blue);flex-shrink:0;">` : `<div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,var(--pf-deep),var(--pf-purple));display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-weight:900;font-size:1.1rem;">${a.nombre.charAt(0)}</div>`}
                            <div style="flex:1;min-width:0;">
                                <h4 style="font-weight:900;color:var(--pf-text);font-size:.9rem;margin:0 0 .3rem 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${a.nombre}</h4>
                                <div style="display:flex;align-items:center;gap:.5rem;">
                                    <span style="font-size:.72rem;color:var(--pf-muted);font-weight:600;"><i data-lucide="clock" style="width:11px;height:11px;display:inline-block;vertical-align:middle;margin-right:2px;"></i>${a.hora}</span>
                                    <span style="padding:.15rem .5rem;background:rgba(59,130,246,.1);color:var(--pf-blueB);border:1px solid rgba(59,130,246,.2);border-radius:999px;font-size:.62rem;font-weight:800;text-transform:uppercase;">${a.metodo}</span>
                                </div>
                            </div>
                            <span style="font-size:.85rem;font-weight:900;color:var(--pf-border);">#${i+1}</span>
                        </div>`).join('')}</div>`;
                } else {
                    lista.innerHTML = `<div style="text-align:center;padding:2.5rem;color:var(--pf-muted);"><i data-lucide="users" style="width:52px;height:52px;display:block;margin:0 auto 1rem;"></i><p style="font-weight:700;margin:0;">No hay asistentes para este día</p></div>`;
                }
                setTimeout(()=>lucide.createIcons(), 100);
            } catch(e) {
                document.getElementById('asistentes-lista').innerHTML = `<div style="text-align:center;padding:2.5rem;color:var(--pf-red);"><i data-lucide="alert-circle" style="width:52px;height:52px;display:block;margin:0 auto 1rem;"></i><p style="font-weight:700;margin:0;">Error al cargar los asistentes</p></div>`;
                lucide.createIcons();
            } finally { loading.classList.add('hidden'); content.classList.remove('hidden'); }
        }

        function cerrarModal() { document.getElementById('modal-asistentes').classList.remove('flex'); }
        document.getElementById('modal-asistentes').addEventListener('click', e=>{ if(e.target===e.currentTarget) cerrarModal(); });
        document.addEventListener('keydown', e=>{ if(e.key==='Escape') cerrarModal(); });

        window.addEventListener('load', function() { renderChart(); lucide.createIcons(); });
    </script>
}

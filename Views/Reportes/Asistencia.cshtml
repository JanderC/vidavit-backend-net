@model IEnumerable<dynamic>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reporte de Asistencia";
    ViewData["Subtitle"] = "Control de check-ins - Tallest GYM";

    int totalCheckins = 0;
    foreach (var item in Model) { totalCheckins += Convert.ToInt32(item.Total); }
    double promedioDiario = Model.Any() ? (double)totalCheckins / Model.Count() : 0;
}

<style>
    :root {
        --tg-green: #2EAD4B;
        --tg-green-dark: #1e8a38;
        --tg-green-light: #f0fdf4;
        --tg-border: #c6e8cf;
        --tg-black: #1a1a1a;
        --tg-dark: #2D2D2D;
        --tg-white: #ffffff;
    }

    .tg-card {
        background: var(--tg-white);
        border-radius: 1.25rem;
        border: 2px solid #e5e7eb;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

    .tg-input {
        border: 2px solid #e5e7eb;
        border-radius: .65rem;
        padding: .75rem 1rem;
        font-weight: 600;
        transition: border-color .2s, box-shadow .2s;
        width: 100%;
        background: #fafafa;
    }

        .tg-input:focus {
            outline: none;
            border-color: var(--tg-green);
            box-shadow: 0 0 0 3px rgba(46,173,75,0.15);
        }

    .tg-btn-filter {
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
        color: var(--tg-white);
        font-weight: 900;
        padding: .75rem 2rem;
        border-radius: .75rem;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: all .2s;
        text-transform: uppercase;
        letter-spacing: .07em;
        box-shadow: 0 4px 16px rgba(46,173,75,0.3);
    }

        .tg-btn-filter:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(46,173,75,0.4);
        }

    .tg-stat-card {
        background: var(--tg-white);
        border-radius: 1.25rem;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        padding: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .tg-table-head {
        background: linear-gradient(135deg, var(--tg-black), var(--tg-dark));
    }

    .tg-btn-action {
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
        color: var(--tg-white);
        font-weight: 800;
        padding: .4rem 1rem;
        border-radius: .55rem;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: all .2s;
        text-transform: uppercase;
        letter-spacing: .05em;
        font-size: .75rem;
        box-shadow: 0 2px 8px rgba(46,173,75,0.3);
    }

        .tg-btn-action:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(46,173,75,0.4);
        }

    /* Modal */
    .tg-modal-header {
        background: linear-gradient(135deg, var(--tg-black), var(--tg-dark));
        padding: 1.5rem 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .tg-modal-close {
        background: rgba(255,255,255,0.15);
        border: none;
        border-radius: .5rem;
        padding: .4rem;
        cursor: pointer;
        transition: background .15s;
        color: white;
        display: flex;
        align-items: center;
    }

        .tg-modal-close:hover {
            background: rgba(255,255,255,0.25);
        }

    .tg-asistente-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: #fafafa;
        border-radius: .85rem;
        border: 2px solid #e5e7eb;
        transition: border-color .2s;
    }

        .tg-asistente-card:hover {
            border-color: var(--tg-border);
        }
</style>

<div class="space-y-6">

    <!-- Filtros -->
    <div class="tg-card p-6">
        <div class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-black text-gray-600 mb-2 uppercase tracking-widest">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="tg-input">
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-black text-gray-600 mb-2 uppercase tracking-widest">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="tg-input">
            </div>
            <button onclick="filtrarPorFecha()" class="tg-btn-filter">
                <i data-lucide="filter" class="w-4 h-4"></i>
                Filtrar
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="tg-stat-card border-l-4 border-blue-500">
            <div>
                <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Total Check-ins</p>
                <p class="text-4xl font-black text-gray-900" id="total-checkins">@totalCheckins</p>
            </div>
            <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center">
                <i data-lucide="users" class="w-7 h-7 text-blue-600"></i>
            </div>
        </div>
        <div class="tg-stat-card border-l-4" style="border-left-color:var(--tg-green);">
            <div>
                <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Promedio Diario</p>
                <p class="text-4xl font-black text-gray-900" id="promedio-diario">@Math.Round(promedioDiario, 1)</p>
            </div>
            <div class="w-14 h-14 rounded-full flex items-center justify-center" style="background:var(--tg-green-light);">
                <i data-lucide="trending-up" class="w-7 h-7" style="color:var(--tg-green);"></i>
            </div>
        </div>
        <div class="tg-stat-card border-l-4 border-purple-500">
            <div>
                <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Día Más Activo</p>
                <p class="text-4xl font-black text-gray-900" id="dia-activo">
                    @(Model.Any() ? Model.OrderByDescending(x => x.Total).First().Total : 0)
                </p>
            </div>
            <div class="w-14 h-14 bg-purple-100 rounded-full flex items-center justify-center">
                <i data-lucide="award" class="w-7 h-7 text-purple-600"></i>
            </div>
        </div>
        <div class="tg-stat-card border-l-4 border-amber-500">
            <div>
                <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Días Analizados</p>
                <p class="text-4xl font-black text-gray-900">@Model.Count()</p>
            </div>
            <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center">
                <i data-lucide="calendar" class="w-7 h-7 text-amber-600"></i>
            </div>
        </div>
    </div>

    <!-- Gráfico -->
    <div class="tg-card p-8">
        <h3 class="text-xl font-black text-gray-900 mb-6 uppercase tracking-wide flex items-center gap-2">
            <span class="w-1 h-6 rounded-full inline-block" style="background:var(--tg-green);"></span>
            Tendencia de Asistencia
        </h3>
        <div class="relative" style="height:350px;">
            <canvas id="chart-asistencia"></canvas>
        </div>
    </div>

    <!-- Tabla -->
    <div class="tg-card overflow-hidden">
        <div class="px-6 py-4 tg-table-head">
            <h3 class="text-lg font-black text-white uppercase tracking-wide">Detalle por Fecha · Tallest GYM</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b-2 border-gray-100">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Fecha</th>
                        <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Día</th>
                        <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Check-ins</th>
                        <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Estado</th>
                        <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y-2 divide-gray-100">
                    @foreach (var item in Model.OrderByDescending(x => x.Fecha))
                    {
                        var fecha = (DateTime)item.Fecha;
                        var total = (int)item.Total;
                        var fechaStr = fecha.ToString("yyyy-MM-dd");
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="font-black text-gray-900">@fecha.ToString("dd/MM/yyyy")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-gray-600 font-bold capitalize">@fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES"))</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="inline-flex items-center px-3 py-1.5 bg-blue-100 text-blue-800 font-black rounded-full text-xs uppercase tracking-wide">
                                    @total visitas
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @if (total >= 30)
                                {
                                    <span class="inline-flex items-center gap-1 px-3 py-1.5 font-black rounded-full text-xs uppercase tracking-wide" style="background:var(--tg-green-light);color:#166534;">
                                        <i data-lucide="trending-up" class="w-3 h-3"></i> Alto
                                    </span>
                                }
                                else if (total >= 15)
                                {
                                    <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-amber-100 text-amber-800 font-black rounded-full text-xs uppercase tracking-wide">
                                        <i data-lucide="minus" class="w-3 h-3"></i> Medio
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-100 text-red-800 font-black rounded-full text-xs uppercase tracking-wide">
                                        <i data-lucide="trending-down" class="w-3 h-3"></i> Bajo
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <button onclick="verAsistentes('@fechaStr', '@total')" class="tg-btn-action">
                                    <i data-lucide="users" class="w-4 h-4"></i>
                                    Ver Asistentes
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL -->
<div id="modal-asistentes" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50 px-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden" style="border:2px solid var(--tg-border);">
        <div class="tg-modal-header">
            <div>
                <p class="text-xs font-black uppercase tracking-widest mb-1" style="color:var(--tg-green);">Tallest GYM · Asistencia</p>
                <h3 class="text-2xl font-black text-white uppercase tracking-wide">Asistentes del Día</h3>
                <p class="text-sm text-gray-300 font-semibold mt-1" id="modal-fecha"></p>
            </div>
            <button onclick="cerrarModal()" class="tg-modal-close">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
        </div>

        <div id="modal-loading" class="hidden px-6 py-12 text-center">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-4" style="border-color:var(--tg-green);"></div>
            <p class="mt-4 text-gray-500 font-semibold">Cargando asistentes...</p>
        </div>

        <div id="modal-content" class="px-6 py-4 overflow-y-auto max-h-[calc(90vh-200px)]">
            <div id="asistentes-lista"></div>
        </div>

        <div class="px-6 py-4 border-t-2 border-gray-100 bg-gray-50 flex items-center justify-between">
            <p class="text-sm font-bold text-gray-600">
                Total de asistentes: <span id="modal-total" class="text-lg font-black" style="color:var(--tg-green);">0</span>
            </p>
            <button onclick="cerrarModal()"
                    class="px-6 py-2 font-bold rounded-lg transition-all uppercase text-sm border-none cursor-pointer"
                    style="background:var(--tg-dark);color:white;">
                Cerrar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const asistenciaData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/asistencia?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            const ctx = document.getElementById('chart-asistencia');
            const labels = asistenciaData.map(d => {
                const fecha = new Date(d.Fecha);
                return fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
            });
            const data = asistenciaData.map(d => d.Total);

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Check-ins',
                        data,
                        borderColor: '#2EAD4B',
                        backgroundColor: 'rgba(46,173,75,0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointHoverRadius: 7,
                        pointBackgroundColor: '#2EAD4B',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(26,26,26,0.9)',
                            padding: 12,
                            callbacks: { label: ctx => ctx.parsed.y + ' check-ins' }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' }, ticks: { stepSize: 5 } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        async function verAsistentes(fecha, total) {
            const modal = document.getElementById('modal-asistentes');
            const modalFecha = document.getElementById('modal-fecha');
            const modalTotal = document.getElementById('modal-total');
            const modalLoading = document.getElementById('modal-loading');
            const modalContent = document.getElementById('modal-content');
            const asistentesLista = document.getElementById('asistentes-lista');

            modal.classList.remove('hidden');
            modalLoading.classList.remove('hidden');
            modalContent.classList.add('hidden');

            const fechaObj = new Date(fecha + 'T00:00:00');
            modalFecha.textContent = fechaObj.toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            modalTotal.textContent = total;

            try {
                const response = await fetch(`/api/CheckIn/asistentes/${fecha}`);
                const data = await response.json();

                if (data.success && data.asistentes) {
                    if (data.asistentes.length === 0) {
                        asistentesLista.innerHTML = `
                            <div class="text-center py-12">
                                <i data-lucide="users" class="w-16 h-16 mx-auto text-gray-300 mb-4"></i>
                                <p class="text-gray-500 font-semibold">No hay asistentes registrados para este día</p>
                            </div>`;
                    } else {
                        let html = '<div class="grid grid-cols-1 md:grid-cols-2 gap-4">';
                        data.asistentes.forEach((asistente, index) => {
                            html += `
                                <div class="tg-asistente-card">
                                    ${asistente.fotoBase64 ? `
                                        <img src="data:image/jpeg;base64,${asistente.fotoBase64}"
                                             alt="${asistente.nombre}"
                                             class="w-14 h-14 rounded-full object-cover border-2" style="border-color:var(--tg-green);" />
                                    ` : `
                                        <div class="w-14 h-14 rounded-full flex items-center justify-center text-white font-black text-xl"
                                             style="background:linear-gradient(135deg,#2EAD4B,#1e8a38);">
                                            ${asistente.nombre.charAt(0)}
                                        </div>
                                    `}
                                    <div class="flex-1">
                                        <h4 class="font-black text-gray-900">${asistente.nombre}</h4>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-sm text-gray-500 font-semibold flex items-center gap-1">
                                                <i data-lucide="clock" class="w-3 h-3"></i>${asistente.hora}
                                            </span>
                                            <span class="text-xs px-2 py-0.5 bg-blue-100 text-blue-800 rounded-full font-bold uppercase">
                                                ${asistente.metodo}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="text-xl font-black text-gray-300">#${index + 1}</div>
                                </div>`;
                        });
                        html += '</div>';
                        asistentesLista.innerHTML = html;
                    }
                    setTimeout(() => { if (typeof lucide !== 'undefined') lucide.createIcons(); }, 100);
                } else {
                    asistentesLista.innerHTML = `
                        <div class="text-center py-12">
                            <i data-lucide="alert-circle" class="w-16 h-16 mx-auto text-red-400 mb-4"></i>
                            <p class="text-red-600 font-semibold">Error al cargar los asistentes</p>
                        </div>`;
                }
            } catch (error) {
                asistentesLista.innerHTML = `
                    <div class="text-center py-12">
                        <i data-lucide="alert-circle" class="w-16 h-16 mx-auto text-red-400 mb-4"></i>
                        <p class="text-red-600 font-semibold">Error al cargar los asistentes</p>
                        <p class="text-sm text-gray-500 mt-2">${error.message}</p>
                    </div>`;
            } finally {
                modalLoading.classList.add('hidden');
                modalContent.classList.remove('hidden');
            }
        }

        function cerrarModal() { document.getElementById('modal-asistentes').classList.add('hidden'); }

        document.getElementById('modal-asistentes').addEventListener('click', function(e) {
            if (e.target === this) cerrarModal();
        });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarModal(); });

        window.addEventListener('load', function() {
            renderChart();
            lucide.createIcons();
        });
    </script>
}

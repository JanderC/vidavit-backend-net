@model IEnumerable<dynamic>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reporte de Asistencia";
    ViewData["Subtitle"] = "Control de check-ins - JONEL GYM";

    int totalCheckins = 0;
    foreach (var item in Model)
    {
        totalCheckins += Convert.ToInt32(item.Total);
    }
    double promedioDiario = Model.Any() ? (double)totalCheckins / Model.Count() : 0;
}

<div class="space-y-6">
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
        <div class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 font-semibold">
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 font-semibold">
            </div>
            <button onclick="filtrarPorFecha()"
                    class="px-8 py-3 bg-gradient-to-r from-orange-500 to-orange-700 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                Filtrar
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-blue-600">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Total Check-ins</p>
                    <p class="text-4xl font-black text-gray-900" id="total-checkins">@totalCheckins</p>
                </div>
                <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center">
                    <i data-lucide="users" class="w-7 h-7 text-blue-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-emerald-600">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Promedio Diario</p>
                    <p class="text-4xl font-black text-gray-900" id="promedio-diario">@Math.Round(promedioDiario, 1)</p>
                </div>
                <div class="w-14 h-14 bg-emerald-100 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-7 h-7 text-emerald-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-purple-600">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Día Más Activo</p>
                    <p class="text-4xl font-black text-gray-900" id="dia-activo">
                        @(Model.Any() ? Model.OrderByDescending(x => x.Total).First().Total : 0)
                    </p>
                </div>
                <div class="w-14 h-14 bg-purple-100 rounded-full flex items-center justify-center">
                    <i data-lucide="award" class="w-7 h-7 text-purple-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-amber-600">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Días Analizados</p>
                    <p class="text-4xl font-black text-gray-900">@Model.Count()</p>
                </div>
                <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center">
                    <i data-lucide="calendar" class="w-7 h-7 text-gray-600"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
        <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-wide">Tendencia de Asistencia</h3>
        <div class="relative" style="height: 350px;">
            <canvas id="chart-asistencia"></canvas>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
        <div class="px-6 py-4 border-b-2 border-gray-200 bg-gradient-to-r from-gray-900 to-black">
            <h3 class="text-xl font-black text-white uppercase tracking-wide">Detalle por Fecha</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b-2 border-gray-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase tracking-wider">Fecha</th>
                        <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase tracking-wider">Día</th>
                        <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase tracking-wider">Check-ins</th>
                        <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase tracking-wider">Estado</th>
                        <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase tracking-wider">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y-2 divide-gray-200">
                    @foreach (var item in Model.OrderByDescending(x => x.Fecha))
                    {
                        var fecha = (DateTime)item.Fecha;
                        var total = (int)item.Total;
                        var fechaStr = fecha.ToString("yyyy-MM-dd");
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="font-black text-gray-900">@fecha.ToString("dd/MM/yyyy")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-gray-600 font-bold">@fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES"))</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="inline-flex items-center px-4 py-2 bg-blue-100 text-blue-800 font-black rounded-full uppercase text-xs tracking-wide">
                                    @total visitas
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @if (total >= 30)
                                {
                                    <span class="inline-flex items-center gap-1 px-3 py-2 bg-emerald-100 text-emerald-800 font-black rounded-full uppercase text-xs tracking-wide">
                                        <i data-lucide="trending-up" class="w-3 h-3"></i> Alto
                                    </span>
                                }
                                else if (total >= 15)
                                {
                                    <span class="inline-flex items-center gap-1 px-3 py-2 bg-amber-100 text-amber-800 font-black rounded-full uppercase text-xs tracking-wide">
                                        <i data-lucide="minus" class="w-3 h-3"></i> Medio
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-3 py-2 bg-orange-100 text-orange-800 font-black rounded-full uppercase text-xs tracking-wide">
                                        <i data-lucide="trending-down" class="w-3 h-3"></i> Bajo
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <button onclick="verAsistentes('@fechaStr', '@total')"
                                        class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-orange-500 to-orange-700 hover:from-red-700 hover:to-red-900 text-white font-bold rounded-lg transition-all shadow-md hover:shadow-lg text-xs uppercase transform hover:scale-105">
                                    <i data-lucide="users" class="w-4 h-4"></i>
                                    Ver Asistentes
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========== MODAL PARA VER ASISTENTES ========== -->
<div id="modal-asistentes" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 px-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden">
        <!-- Header del Modal -->
        <div class="px-6 py-4 border-b-2 border-gray-200 bg-gradient-to-r from-orange-500 to-orange-700 flex items-center justify-between">
            <div>
                <h3 class="text-2xl font-black text-white uppercase tracking-wide">Asistentes del Día</h3>
                <p class="text-sm text-red-100 font-semibold mt-1" id="modal-fecha"></p>
            </div>
            <button onclick="cerrarModal()" class="text-white hover:bg-red-900 rounded-full p-2 transition-colors">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
        </div>

        <!-- Loading State -->
        <div id="modal-loading" class="hidden px-6 py-12 text-center">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-4 border-orange-500"></div>
            <p class="mt-4 text-gray-600 font-semibold">Cargando asistentes...</p>
        </div>

        <!-- Content del Modal -->
        <div id="modal-content" class="px-6 py-4 overflow-y-auto max-h-[calc(90vh-180px)]">
            <div id="asistentes-lista">
                <!-- Se llenará dinámicamente con JavaScript -->
            </div>
        </div>

        <!-- Footer del Modal -->
        <div class="px-6 py-4 border-t-2 border-gray-200 bg-gray-50 flex items-center justify-between">
            <div>
                <p class="text-sm font-bold text-gray-700">
                    Total de asistentes: <span id="modal-total" class="text-orange-500 text-lg font-black">0</span>
                </p>
            </div>
            <button onclick="cerrarModal()"
                    class="px-6 py-2 bg-gray-600 hover:bg-gray-700 text-white font-bold rounded-lg transition-all uppercase text-sm">
                Cerrar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const asistenciaData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/asistencia?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            const ctx = document.getElementById('chart-asistencia');

            const labels = asistenciaData.map(d => {
                const fecha = new Date(d.Fecha);
                return fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
            });

            const data = asistenciaData.map(d => d.Total);

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Check-ins',
                        data: data,
                        borderColor: '#E31E24',
                        backgroundColor: 'rgba(227, 30, 36, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#E31E24',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y + ' check-ins';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            },
                            ticks: {
                                stepSize: 5
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        // ========== NUEVA FUNCIONALIDAD: VER ASISTENTES ==========
        async function verAsistentes(fecha, total) {
            const modal = document.getElementById('modal-asistentes');
            const modalFecha = document.getElementById('modal-fecha');
            const modalTotal = document.getElementById('modal-total');
            const modalLoading = document.getElementById('modal-loading');
            const modalContent = document.getElementById('modal-content');
            const asistentesLista = document.getElementById('asistentes-lista');

            // Mostrar modal y loading
            modal.classList.remove('hidden');
            modalLoading.classList.remove('hidden');
            modalContent.classList.add('hidden');

            // Formatear fecha para mostrar
            const fechaObj = new Date(fecha + 'T00:00:00');
            const fechaFormateada = fechaObj.toLocaleDateString('es-ES', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            modalFecha.textContent = fechaFormateada;
            modalTotal.textContent = total;

            try {
                // Llamar al API para obtener los asistentes
                const response = await fetch(`/api/CheckIn/asistentes/${fecha}`);
                const data = await response.json();

                if (data.success && data.asistentes) {
                    // Renderizar la lista de asistentes
                    if (data.asistentes.length === 0) {
                        asistentesLista.innerHTML = `
                            <div class="text-center py-12">
                                <i data-lucide="users" class="w-16 h-16 mx-auto text-gray-400 mb-4"></i>
                                <p class="text-gray-600 font-semibold">No hay asistentes registrados para este día</p>
                            </div>
                        `;
                    } else {
                        let html = '<div class="grid grid-cols-1 md:grid-cols-2 gap-4">';

                        data.asistentes.forEach((asistente, index) => {
                            html += `
                                <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors border-2 border-gray-200">
                                    ${asistente.fotoBase64 ? `
                                        <img src="data:image/jpeg;base64,${asistente.fotoBase64}"
                                             alt="${asistente.nombre}"
                                             class="w-16 h-16 rounded-full object-cover border-2 border-orange-500" />
                                    ` : `
                                        <div class="w-16 h-16 rounded-full bg-gradient-to-r from-orange-500 to-orange-700 flex items-center justify-center text-white font-black text-xl">
                                            ${asistente.nombre.charAt(0)}
                                        </div>
                                    `}
                                    <div class="flex-1">
                                        <h4 class="font-black text-gray-900 text-lg">${asistente.nombre}</h4>
                                        <div class="flex items-center gap-3 mt-1">
                                            <span class="text-sm text-gray-600 font-semibold">
                                                <i data-lucide="clock" class="w-3 h-3 inline-block mr-1"></i>
                                                ${asistente.hora}
                                            </span>
                                            <span class="text-xs px-2 py-1 bg-blue-100 text-blue-800 rounded-full font-bold uppercase">
                                                ${asistente.metodo}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="text-2xl font-black text-gray-400">
                                        #${index + 1}
                                    </div>
                                </div>
                            `;
                        });

                        html += '</div>';
                        asistentesLista.innerHTML = html;
                    }

                    // Reiniciar iconos de Lucide
                    setTimeout(() => {
                        if (typeof lucide !== 'undefined') {
                            lucide.createIcons();
                        }
                    }, 100);
                } else {
                    asistentesLista.innerHTML = `
                        <div class="text-center py-12">
                            <i data-lucide="alert-circle" class="w-16 h-16 mx-auto text-red-400 mb-4"></i>
                            <p class="text-orange-500 font-semibold">Error al cargar los asistentes</p>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error al obtener asistentes:', error);
                asistentesLista.innerHTML = `
                    <div class="text-center py-12">
                        <i data-lucide="alert-circle" class="w-16 h-16 mx-auto text-red-400 mb-4"></i>
                        <p class="text-orange-500 font-semibold">Error al cargar los asistentes</p>
                        <p class="text-sm text-gray-600 mt-2">${error.message}</p>
                    </div>
                `;
            } finally {
                // Ocultar loading y mostrar contenido
                modalLoading.classList.add('hidden');
                modalContent.classList.remove('hidden');
            }
        }

        function cerrarModal() {
            const modal = document.getElementById('modal-asistentes');
            modal.classList.add('hidden');
        }

        // Cerrar modal al hacer clic fuera
        document.getElementById('modal-asistentes').addEventListener('click', function(e) {
            if (e.target === this) {
                cerrarModal();
            }
        });

        // Cerrar modal con tecla ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                cerrarModal();
            }
        });
        // =========================================================

        window.addEventListener('load', function() {
            renderChart();
            lucide.createIcons();
        });
    </script>
}

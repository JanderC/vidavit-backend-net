@model IEnumerable<VidaFitBackend.Models.Cliente>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clientes Inactivos";
    ViewData["Subtitle"] = "Seguimiento de clientes - POWER FITNESS";
}

<style>
    .pf-input { width:100%;padding:12px 16px;background:rgba(255,255,255,0.04);border:1px solid rgba(30,111,227,0.2);border-radius:12px;color:#fff;font-size:0.9rem;font-weight:600;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s,box-shadow .2s; }
    .pf-input:focus { border-color:#1E6FE3;box-shadow:0 0 0 3px rgba(30,111,227,0.15); }
    .pf-input::placeholder { color:rgba(255,255,255,0.25); }
    .pf-select { width:100%;padding:12px 16px;background:rgba(255,255,255,0.04);border:1px solid rgba(30,111,227,0.2);border-radius:12px;color:#fff;font-size:0.9rem;font-weight:600;font-family:'Inter',sans-serif;outline:none; }
    .pf-select:focus { border-color:#1E6FE3; }
    .pf-select option { background:#0D0D20;color:#fff; }
    .pf-label { display:block;font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:8px; }
    .stat-card { background:#0D0D20;border:1px solid rgba(30,111,227,0.12);border-radius:14px;padding:20px 22px; }
    .section-card { background:#0D0D20;border:1px solid rgba(30,111,227,0.12);border-radius:14px;overflow:hidden; }
    .pf-table { width:100%;border-collapse:collapse; }
    .pf-table thead tr { border-bottom:1px solid rgba(30,111,227,0.2); }
    .pf-table thead th { padding:13px 18px;font-size:0.6rem;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,0.3); }
    .pf-table tbody tr { border-bottom:1px solid rgba(255,255,255,0.04);transition:background .15s; }
    .pf-table tbody tr:hover { background:rgba(30,111,227,0.05); }
    .pf-table tbody td { padding:14px 18px; }
    .pf-badge { display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:100px;font-size:0.62rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase; }
    .action-btn { width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer;border:none;transition:background .15s; }
</style>

<div style="display:flex;flex-direction:column;gap:18px;">

    <!-- Filtro -->
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:14px;padding:20px 22px;">
        <div style="display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;">
            <div style="flex:1;min-width:180px;">
                <label class="pf-label">Días sin asistir</label>
                <select id="dias-inactividad" onchange="filtrarPorDias()" class="pf-select">
                    <option value="7"  selected="@(ViewBag.Dias == 7)">7 días (1 semana)</option>
                    <option value="15" selected="@(ViewBag.Dias == 15)">15 días</option>
                    <option value="30" selected="@(ViewBag.Dias == 30)">30 días (1 mes)</option>
                    <option value="60" selected="@(ViewBag.Dias == 60)">60 días (2 meses)</option>
                    <option value="90" selected="@(ViewBag.Dias == 90)">90 días (3 meses)</option>
                </select>
            </div>
            <button onclick="exportarLista()"
                    style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.25);color:#3D8EFF;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border-radius:12px;cursor:pointer;transition:all .15s;"
                    onmouseover="this.style.background='rgba(30,111,227,0.2)'" onmouseout="this.style.background='rgba(30,111,227,0.1)'">
                <i data-lucide="download" style="width:15px;height:15px;"></i> Exportar Lista
            </button>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Stats -->
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;">
            <div class="stat-card" style="border-left:3px solid #F87171;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Clientes Inactivos</p>
                        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@Model.Count()</p>
                    </div>
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(248,113,113,0.1);border:1px solid rgba(248,113,113,0.2);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="user-x" style="width:20px;height:20px;color:#F87171;"></i>
                    </div>
                </div>
                <p style="font-size:0.7rem;color:#F87171;font-weight:700;margin:8px 0 0 0;display:flex;align-items:center;gap:4px;">
                    <i data-lucide="alert-circle" style="width:11px;height:11px;"></i> Requieren atención
                </p>
            </div>
            <div class="stat-card" style="border-left:3px solid #D97706;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Período Analizado</p>
                        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@ViewBag.Dias</p>
                    </div>
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(217,119,6,0.1);border:1px solid rgba(217,119,6,0.2);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="calendar" style="width:20px;height:20px;color:#D97706;"></i>
                    </div>
                </div>
                <p style="font-size:0.7rem;color:#D97706;font-weight:700;margin:8px 0 0 0;display:flex;align-items:center;gap:4px;">
                    <i data-lucide="clock" style="width:11px;height:11px;"></i> Días sin visita
                </p>
            </div>
            <div class="stat-card" style="border-left:3px solid #a78bfa;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Con Membresía</p>
                        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@Model.Count(c => c.Membresias != null && c.Membresias.Any(m => m.Estado == "activa"))</p>
                    </div>
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(167,139,250,0.1);border:1px solid rgba(167,139,250,0.2);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="credit-card" style="width:20px;height:20px;color:#a78bfa;"></i>
                    </div>
                </div>
                <p style="font-size:0.7rem;color:#a78bfa;font-weight:700;margin:8px 0 0 0;display:flex;align-items:center;gap:4px;">
                    <i data-lucide="alert-triangle" style="width:11px;height:11px;"></i> Pagando pero no asisten
                </p>
            </div>
            <div class="stat-card" style="border-left:3px solid #3D8EFF;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Tasa de Inactividad</p>
                        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@((Model.Count() * 100.0 / (Model.Count() + 1)).ToString("F1"))%</p>
                    </div>
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.2);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="percent" style="width:20px;height:20px;color:#3D8EFF;"></i>
                    </div>
                </div>
                <p style="font-size:0.7rem;color:#3D8EFF;font-weight:700;margin:8px 0 0 0;display:flex;align-items:center;gap:4px;">
                    <i data-lucide="trending-down" style="width:11px;height:11px;"></i> Del total
                </p>
            </div>
        </div>

        <!-- Recomendaciones -->
        <div style="background:rgba(217,119,6,0.05);border:1px solid rgba(217,119,6,0.18);border-left:3px solid #D97706;border-radius:14px;padding:20px 22px;">
            <div style="display:flex;align-items:flex-start;gap:14px;">
                <i data-lucide="alert-triangle" style="width:22px;height:22px;color:#D97706;flex-shrink:0;margin-top:2px;"></i>
                <div>
                    <p style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#D97706;margin:0 0 12px 0;">Recomendaciones de Seguimiento</p>
                    <div style="display:flex;flex-direction:column;gap:8px;">
                        <div style="display:flex;align-items:center;gap:8px;font-size:0.82rem;color:rgba(255,255,255,0.55);font-weight:600;">
                            <i data-lucide="phone" style="width:15px;height:15px;color:#D97706;flex-shrink:0;"></i>
                            Contactar a clientes con membresías activas para conocer el motivo de su inasistencia
                        </div>
                        <div style="display:flex;align-items:center;gap:8px;font-size:0.82rem;color:rgba(255,255,255,0.55);font-weight:600;">
                            <i data-lucide="gift" style="width:15px;height:15px;color:#D97706;flex-shrink:0;"></i>
                            Ofrecer incentivos o promociones especiales para reactivar su participación
                        </div>
                        <div style="display:flex;align-items:center;gap:8px;font-size:0.82rem;color:rgba(255,255,255,0.55);font-weight:600;">
                            <i data-lucide="mail" style="width:15px;height:15px;color:#D97706;flex-shrink:0;"></i>
                            Enviar recordatorios amigables sobre los beneficios de mantener una rutina constante
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="section-card">
            <div style="padding:16px 20px;border-bottom:1px solid rgba(30,111,227,0.15);display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,rgba(30,111,227,0.08),rgba(107,63,160,0.08));flex-wrap:wrap;gap:12px;">
                <p style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#fff;margin:0;">Listado de Clientes Inactivos</p>
                <input type="text" id="search-input" placeholder="Buscar cliente..." class="pf-input" style="max-width:260px;">
            </div>
            <table class="pf-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Contacto</th>
                        <th style="text-align:center;">Estado Membresía</th>
                        <th style="text-align:center;">Último Check-in</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in Model.OrderBy(c => c.Nombre))
                    {
                        var ultimoCheckIn = cliente.CheckIns?.OrderByDescending(ci => ci.FechaHora).FirstOrDefault();
                        var membresiasActivas = cliente.Membresias?.Where(m => m.Estado == "activa");
                        var tieneMembresia = membresiasActivas?.Any() ?? false;
                        <tr class="cliente-row">
                            <td>
                                <div style="display:flex;align-items:center;gap:12px;">
                                    @if (!string.IsNullOrEmpty(cliente.FotoBase64))
                                    {
                                        <img src="data:image/jpeg;base64,@cliente.FotoBase64" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid rgba(30,111,227,0.3);flex-shrink:0;">
                                    }
                                    else
                                    {
                                        <div style="width:44px;height:44px;border-radius:50%;background:rgba(30,111,227,0.08);border:1px solid rgba(30,111,227,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <i data-lucide="user" style="width:18px;height:18px;color:rgba(30,111,227,0.4);"></i>
                                        </div>
                                    }
                                    <div>
                                        <div style="font-weight:800;color:#fff;font-size:0.9rem;" class="cliente-nombre">@cliente.Nombre @cliente.Apellido</div>
                                        <div style="font-size:0.72rem;color:rgba(255,255,255,0.35);font-weight:600;font-family:monospace;">@cliente.Cedula</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="font-size:0.82rem;display:flex;flex-direction:column;gap:3px;">
                                    <div style="display:flex;align-items:center;gap:6px;color:rgba(255,255,255,0.6);font-weight:700;">
                                        <i data-lucide="phone" style="width:13px;height:13px;flex-shrink:0;"></i>
                                        @cliente.Telefono
                                    </div>
                                    @if (!string.IsNullOrEmpty(cliente.Email))
                                    {
                                        <div style="display:flex;align-items:center;gap:6px;color:rgba(255,255,255,0.4);font-weight:600;">
                                            <i data-lucide="mail" style="width:13px;height:13px;flex-shrink:0;"></i>
                                            @cliente.Email
                                        </div>
                                    }
                                </div>
                            </td>
                            <td style="text-align:center;">
                                @if (tieneMembresia)
                                {
                                    <span class="pf-badge" style="background:rgba(217,119,6,0.1);color:#D97706;border:1px solid rgba(217,119,6,0.2);">
                                        <i data-lucide="alert-circle" style="width:10px;height:10px;"></i> Activa (No asiste)
                                    </span>
                                }
                                else
                                {
                                    <span class="pf-badge" style="background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.3);border:1px solid rgba(255,255,255,0.08);">
                                        <i data-lucide="x-circle" style="width:10px;height:10px;"></i> Sin membresía
                                    </span>
                                }
                            </td>
                            <td style="text-align:center;">
                                @if (ultimoCheckIn != null)
                                {
                                    var diasInactivo = (DateTime.Now - ultimoCheckIn.FechaHora).Days;
                                    <div>
                                        <div style="font-weight:800;color:#fff;font-size:0.85rem;">@ultimoCheckIn.FechaHora.ToString("dd/MM/yyyy")</div>
                                        <div style="font-size:0.72rem;color:#F87171;font-weight:800;">Hace @diasInactivo días</div>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size:0.8rem;color:rgba(255,255,255,0.3);font-weight:700;">Sin registros</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                <div style="display:flex;align-items:center;justify-content:center;gap:4px;">
                                    <a href="/clientes/detalle/@cliente.Id" class="action-btn" title="Ver detalle"
                                       style="background:rgba(30,111,227,0.08);" onmouseover="this.style.background='rgba(30,111,227,0.18)'" onmouseout="this.style.background='rgba(30,111,227,0.08)'">
                                        <i data-lucide="eye" style="width:14px;height:14px;color:#3D8EFF;"></i>
                                    </a>
                                    <button onclick="contactarCliente('@cliente.Telefono','@cliente.Nombre')" class="action-btn" title="Contactar"
                                            style="background:rgba(16,185,129,0.08);" onmouseover="this.style.background='rgba(16,185,129,0.18)'" onmouseout="this.style.background='rgba(16,185,129,0.08)'">
                                        <i data-lucide="phone" style="width:14px;height:14px;color:#10B981;"></i>
                                    </button>
                                    <button onclick="enviarRecordatorio('@cliente.Email','@cliente.Nombre')" class="action-btn" title="Recordatorio"
                                            style="background:rgba(217,119,6,0.08);" onmouseover="this.style.background='rgba(217,119,6,0.18)'" onmouseout="this.style.background='rgba(217,119,6,0.08)'"
                                            @(string.IsNullOrEmpty(cliente.Email) ? "disabled style='opacity:0.3;cursor:not-allowed;'" : "")>
                                        <i data-lucide="mail" style="width:14px;height:14px;color:#D97706;"></i>
                                    </button>
                                    @if (tieneMembresia)
                                    {
                                        <a href="/membresias?clienteId=@cliente.Id" class="action-btn" title="Ver membresías"
                                           style="background:rgba(107,63,160,0.08);" onmouseover="this.style.background='rgba(107,63,160,0.18)'" onmouseout="this.style.background='rgba(107,63,160,0.08)'">
                                            <i data-lucide="credit-card" style="width:14px;height:14px;color:#a78bfa;"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="background:#0D0D20;border:1px solid rgba(16,185,129,0.2);border-radius:14px;padding:60px;text-align:center;">
            <div style="width:80px;height:80px;border-radius:50%;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
                <i data-lucide="check-circle" style="width:40px;height:40px;color:#10B981;"></i>
            </div>
            <p style="font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:2px;color:#10B981;margin:0 0 8px 0;">¡Excelente Participación!</p>
            <p style="font-size:0.9rem;color:rgba(255,255,255,0.5);font-weight:600;margin:0;">No hay clientes inactivos en los últimos @ViewBag.Dias días</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('search-input')?.addEventListener('input', function(e) {
            const q = e.target.value.toLowerCase();
            document.querySelectorAll('.cliente-row').forEach(row => {
                const nombre = row.querySelector('.cliente-nombre').textContent.toLowerCase();
                row.style.display = nombre.includes(q) ? '' : 'none';
            });
        });
        function filtrarPorDias() { window.location.href = `/reportes/clientes-inactivos?dias=${document.getElementById('dias-inactividad').value}`; }
        function contactarCliente(tel, nombre) { alert(`Contactar a ${nombre}: ${tel}`); }
        function enviarRecordatorio(email, nombre) { if (!email) { alert('Sin email'); return; } alert(`Recordatorio a ${nombre}: ${email}`); }
        function exportarLista() { alert('Si deseas exportar archivos comunicate al 584247551680'); }
        window.addEventListener('load', function() { lucide.createIcons(); });
    </script>
}

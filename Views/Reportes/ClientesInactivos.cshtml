@model IEnumerable<VidaFitBackend.Models.Cliente>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clientes Inactivos";
    ViewData["Subtitle"] = "Seguimiento de clientes - Power Fitness";
}

<style>
    :root{--pf-blue:#3B82F6;--pf-blueB:#60A5FA;--pf-deep:#1E3A8A;--pf-purple:#7C3AED;--pf-card:#0D1526;--pf-border:#1E2D4A;--pf-text:#E2E8F0;--pf-soft:#94A3B8;--pf-muted:#64748B;--pf-green:#10B981;--pf-red:#EF4444;--pf-orange:#F59E0B;}
    .pf-input{padding:.7rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:rgba(255,255,255,.03);color:var(--pf-text);font-weight:600;font-family:inherit;outline:none;box-sizing:border-box;transition:border-color .2s;}
    .pf-input:focus{border-color:var(--pf-blue);}
    .pf-select{width:100%;padding:.75rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:var(--pf-card);color:var(--pf-text);font-weight:600;font-family:inherit;outline:none;box-sizing:border-box;}
    .pf-card{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;padding:1.5rem;box-shadow:0 4px 20px rgba(0,0,0,.3);}
    .pf-th{padding:.875rem 1.5rem;font-size:.68rem;font-weight:800;color:rgba(255,255,255,.85);text-transform:uppercase;letter-spacing:.12em;}
    .pf-td{padding:1rem 1.5rem;border-bottom:1px solid var(--pf-border);}
</style>

<div style="display:flex;flex-direction:column;gap:1.25rem;">

    <!-- Filtro -->
    <div class="pf-card">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:1rem;">
            <div style="flex:1;min-width:200px;">
                <label style="display:block;font-size:.7rem;font-weight:800;color:var(--pf-soft);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem;">Días sin asistir</label>
                <select id="dias-inactividad" onchange="filtrarPorDias()" class="pf-select">
                    <option value="7"  selected="@(ViewBag.Dias == 7)">7 días (1 semana)</option>
                    <option value="15" selected="@(ViewBag.Dias == 15)">15 días</option>
                    <option value="30" selected="@(ViewBag.Dias == 30)">30 días (1 mes)</option>
                    <option value="60" selected="@(ViewBag.Dias == 60)">60 días (2 meses)</option>
                    <option value="90" selected="@(ViewBag.Dias == 90)">90 días (3 meses)</option>
                </select>
            </div>
            <button onclick="exportarLista()"
                    style="padding:.75rem 2rem;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;font-weight:800;border:none;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;display:inline-flex;align-items:center;gap:.5rem;box-shadow:0 4px 16px rgba(59,130,246,.3);transition:transform .2s;"
                    onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                <i data-lucide="download" style="width:16px;height:16px;"></i> Exportar Lista
            </button>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Stats -->
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;">
            <div class="pf-card" style="border-left:4px solid var(--pf-red);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;">
                    <div><p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Clientes Inactivos</p><p style="font-size:2rem;font-weight:900;color:var(--pf-red);margin:0;">@Model.Count()</p></div>
                    <div style="width:46px;height:46px;background:rgba(239,68,68,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i data-lucide="user-x" style="width:22px;height:22px;color:var(--pf-red);"></i></div>
                </div>
                <p style="font-size:.7rem;color:var(--pf-red);font-weight:700;display:flex;align-items:center;gap:.3rem;margin:0;"><i data-lucide="alert-circle" style="width:12px;height:12px;"></i> Requieren atención</p>
            </div>
            <div class="pf-card" style="border-left:4px solid var(--pf-orange);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;">
                    <div><p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Período Analizado</p><p style="font-size:2rem;font-weight:900;color:var(--pf-orange);margin:0;">@ViewBag.Dias</p></div>
                    <div style="width:46px;height:46px;background:rgba(245,158,11,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i data-lucide="calendar" style="width:22px;height:22px;color:var(--pf-orange);"></i></div>
                </div>
                <p style="font-size:.7rem;color:var(--pf-orange);font-weight:700;display:flex;align-items:center;gap:.3rem;margin:0;"><i data-lucide="clock" style="width:12px;height:12px;"></i> Días sin visita</p>
            </div>
            <div class="pf-card" style="border-left:4px solid #F59E0B;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;">
                    <div><p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Con Membresía</p><p style="font-size:2rem;font-weight:900;color:#F59E0B;margin:0;">@Model.Count(c => c.Membresias != null && c.Membresias.Any(m => m.Estado == "activa"))</p></div>
                    <div style="width:46px;height:46px;background:rgba(245,158,11,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i data-lucide="credit-card" style="width:22px;height:22px;color:#F59E0B;"></i></div>
                </div>
                <p style="font-size:.7rem;color:#F59E0B;font-weight:700;display:flex;align-items:center;gap:.3rem;margin:0;"><i data-lucide="alert-triangle" style="width:12px;height:12px;"></i> Pagando pero no asisten</p>
            </div>
            <div class="pf-card" style="border-left:4px solid var(--pf-blue);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;">
                    <div><p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Tasa de Inactividad</p><p style="font-size:2rem;font-weight:900;color:var(--pf-blueB);margin:0;">@((Model.Count() * 100.0 / (Model.Count() + 1)).ToString("F1"))%</p></div>
                    <div style="width:46px;height:46px;background:rgba(59,130,246,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i data-lucide="percent" style="width:22px;height:22px;color:var(--pf-blueB);"></i></div>
                </div>
                <p style="font-size:.7rem;color:var(--pf-blueB);font-weight:700;display:flex;align-items:center;gap:.3rem;margin:0;"><i data-lucide="trending-down" style="width:12px;height:12px;"></i> Del total</p>
            </div>
        </div>

        <!-- Recomendaciones -->
        <div style="background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.25);border-left:4px solid var(--pf-orange);border-radius:1rem;padding:1.25rem 1.5rem;display:flex;align-items:flex-start;gap:.875rem;">
            <i data-lucide="alert-triangle" style="width:24px;height:24px;color:var(--pf-orange);flex-shrink:0;margin-top:.1rem;"></i>
            <div>
                <h3 style="font-size:.9rem;font-weight:900;color:var(--pf-orange);text-transform:uppercase;letter-spacing:.08em;margin:0 0 .875rem 0;">Recomendaciones de Seguimiento</h3>
                <ul style="display:flex;flex-direction:column;gap:.5rem;list-style:none;padding:0;margin:0;">
                    <li style="display:flex;align-items:center;gap:.625rem;font-size:.82rem;color:rgba(245,158,11,.85);font-weight:700;"><i data-lucide="phone" style="width:16px;height:16px;flex-shrink:0;"></i> Contactar a clientes con membresías activas para conocer el motivo de su inasistencia</li>
                    <li style="display:flex;align-items:center;gap:.625rem;font-size:.82rem;color:rgba(245,158,11,.85);font-weight:700;"><i data-lucide="gift" style="width:16px;height:16px;flex-shrink:0;"></i> Ofrecer incentivos o promociones especiales para reactivar su participación</li>
                    <li style="display:flex;align-items:center;gap:.625rem;font-size:.82rem;color:rgba(245,158,11,.85);font-weight:700;"><i data-lucide="mail" style="width:16px;height:16px;flex-shrink:0;"></i> Enviar recordatorios amigables sobre los beneficios de mantener una rutina constante</li>
                </ul>
            </div>
        </div>

        <!-- Tabla -->
        <div class="pf-card" style="padding:0;overflow:hidden;">
            <div style="padding:.875rem 1.5rem;background:linear-gradient(135deg,var(--pf-deep),#111827);border-bottom:2px solid var(--pf-blue);display:flex;align-items:center;justify-content:space-between;">
                <h3 style="font-size:.95rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.08em;margin:0;">Listado de Clientes Inactivos</h3>
                <input type="text" id="search-input" placeholder="Buscar cliente..." class="pf-input" style="width:auto;padding:.5rem .875rem;font-size:.82rem;">
            </div>
            <table style="width:100%;border-collapse:collapse;" id="tabla-inactivos">
                <thead><tr style="background:rgba(6,11,24,.5);">
                    <th class="pf-th">Cliente</th>
                    <th class="pf-th">Contacto</th>
                    <th class="pf-th" style="text-align:center;">Estado Membresía</th>
                    <th class="pf-th" style="text-align:center;">Último Check-in</th>
                    <th class="pf-th" style="text-align:center;">Acciones</th>
                </tr></thead>
                <tbody>
                    @foreach (var cliente in Model.OrderBy(c => c.Nombre))
                    {
                        var ultimoCheckIn = cliente.CheckIns?.OrderByDescending(ci => ci.FechaHora).FirstOrDefault();
                        var tieneMembresia = cliente.Membresias?.Any(m => m.Estado == "activa") ?? false;
                        <tr class="cliente-row" style="transition:background .15s;" onmouseover="this.style.background='rgba(59,130,246,.04)'" onmouseout="this.style.background='transparent'">
                            <td class="pf-td">
                                <div style="display:flex;align-items:center;gap:.75rem;">
                                    @if (!string.IsNullOrEmpty(cliente.FotoBase64))
                                    { <img src="data:image/jpeg;base64,@cliente.FotoBase64" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid var(--pf-blue);flex-shrink:0;"> }
                                    else
                                    { <div style="width:44px;height:44px;border-radius:50%;background:rgba(59,130,246,.08);border:1px solid var(--pf-border);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i data-lucide="user" style="width:20px;height:20px;color:var(--pf-soft);"></i></div> }
                                    <div>
                                        <div style="font-weight:800;color:var(--pf-text);font-size:.95rem;" class="cliente-nombre">@cliente.Nombre @cliente.Apellido</div>
                                        <div style="font-size:.75rem;color:var(--pf-muted);font-weight:600;font-family:monospace;">@cliente.Cedula</div>
                                    </div>
                                </div>
                            </td>
                            <td class="pf-td">
                                <div style="display:flex;flex-direction:column;gap:.25rem;">
                                    @if (!string.IsNullOrEmpty(cliente.Telefono))
                                    { <div style="font-size:.82rem;color:var(--pf-soft);font-weight:600;display:flex;align-items:center;gap:.35rem;"><i data-lucide="phone" style="width:13px;height:13px;"></i>@cliente.Telefono</div> }
                                    @if (!string.IsNullOrEmpty(cliente.Email))
                                    { <div style="font-size:.78rem;color:var(--pf-muted);font-weight:600;display:flex;align-items:center;gap:.35rem;"><i data-lucide="mail" style="width:13px;height:13px;"></i>@cliente.Email</div> }
                                </div>
                            </td>
                            <td class="pf-td" style="text-align:center;">
                                @if (tieneMembresia)
                                { <span style="display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .75rem;background:rgba(245,158,11,.1);color:var(--pf-orange);border:1px solid rgba(245,158,11,.25);border-radius:999px;font-size:.7rem;font-weight:800;text-transform:uppercase;"><i data-lucide="alert-circle" style="width:11px;height:11px;"></i> Activa (No asiste)</span> }
                                else
                                { <span style="display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .75rem;background:rgba(100,116,139,.1);color:var(--pf-soft);border:1px solid rgba(100,116,139,.2);border-radius:999px;font-size:.7rem;font-weight:800;text-transform:uppercase;"><i data-lucide="x-circle" style="width:11px;height:11px;"></i> Sin membresía</span> }
                            </td>
                            <td class="pf-td" style="text-align:center;">
                                @if (ultimoCheckIn != null)
                                {
                                    var diasInactivo = (DateTime.Now - ultimoCheckIn.FechaHora).Days;
                                    <div style="font-weight:800;color:var(--pf-text);font-size:.9rem;margin-bottom:.15rem;">@ultimoCheckIn.FechaHora.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size:.75rem;font-weight:800;color:var(--pf-red);">Hace @diasInactivo días</div>
                                }
                                else
                                { <span style="font-size:.82rem;color:var(--pf-muted);font-weight:700;">Sin registros</span> }
                            </td>
                            <td class="pf-td" style="text-align:center;">
                                <div style="display:flex;align-items:center;justify-content:center;gap:.35rem;">
                                    <a href="/clientes/detalle/@cliente.Id" title="Ver detalle" style="padding:.45rem;color:var(--pf-blueB);border-radius:.5rem;display:flex;transition:background .15s;" onmouseover="this.style.background='rgba(96,165,250,.12)'" onmouseout="this.style.background='transparent'"><i data-lucide="eye" style="width:18px;height:18px;"></i></a>
                                    <button onclick="contactarCliente('@cliente.Telefono','@cliente.Nombre')" title="Contactar" style="padding:.45rem;color:var(--pf-green);border-radius:.5rem;background:transparent;border:none;cursor:pointer;display:flex;transition:background .15s;" onmouseover="this.style.background='rgba(16,185,129,.12)'" onmouseout="this.style.background='transparent'"><i data-lucide="phone" style="width:18px;height:18px;"></i></button>
                                    <button onclick="enviarRecordatorio('@cliente.Email','@cliente.Nombre')" title="Recordatorio" style="padding:.45rem;color:var(--pf-orange);border-radius:.5rem;background:transparent;border:none;cursor:pointer;display:flex;transition:background .15s;" @(string.IsNullOrEmpty(cliente.Email)?"disabled":"") onmouseover="this.style.background='rgba(245,158,11,.12)'" onmouseout="this.style.background='transparent'"><i data-lucide="mail" style="width:18px;height:18px;"></i></button>
                                    @if (tieneMembresia)
                                    { <a href="/membresias?clienteId=@cliente.Id" title="Ver membresías" style="padding:.45rem;color:#A78BFA;border-radius:.5rem;display:flex;transition:background .15s;" onmouseover="this.style.background='rgba(167,139,250,.12)'" onmouseout="this.style.background='transparent'"><i data-lucide="credit-card" style="width:18px;height:18px;"></i></a> }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="pf-card" style="text-align:center;padding:4rem 2rem;">
            <div style="width:80px;height:80px;background:rgba(16,185,129,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;border:2px solid rgba(16,185,129,.25);">
                <i data-lucide="check-circle" style="width:48px;height:48px;color:var(--pf-green);"></i>
            </div>
            <h3 style="font-size:1.35rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.08em;margin:0 0 .625rem 0;">¡Excelente Participación!</h3>
            <p style="color:var(--pf-soft);font-size:1rem;font-weight:700;margin:0 0 .35rem 0;">No hay clientes inactivos en los últimos @ViewBag.Dias días</p>
            <p style="color:var(--pf-muted);font-weight:600;margin:0;">Todos los clientes mantienen una asistencia regular</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('search-input')?.addEventListener('input', function(e) {
            const q = e.target.value.toLowerCase();
            document.querySelectorAll('.cliente-row').forEach(row => {
                row.style.display = row.querySelector('.cliente-nombre').textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
        function filtrarPorDias() { window.location.href = `/reportes/clientes-inactivos?dias=${document.getElementById('dias-inactividad').value}`; }
        function contactarCliente(tel, nombre) { alert(`Contactar a ${nombre} al número: ${tel}`); }
        function enviarRecordatorio(email, nombre) { if (!email) { alert('Este cliente no tiene email registrado'); return; } alert(`Se enviará un recordatorio a ${nombre} al email: ${email}`); }
        function exportarLista() { alert('Si deseas exportar archivos comunicate al 584247551680'); }
        window.addEventListener('load', () => lucide.createIcons());
    </script>
}

@model IEnumerable<VidaFitBackend.Models.Cliente>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clientes Inactivos";
    ViewData["Subtitle"] = "Seguimiento de clientes - Tallest GYM";
}

<style>
    :root {
        --tg-green: #2EAD4B;
        --tg-green-dark: #1e8a38;
        --tg-green-light: #f0fdf4;
        --tg-border: #c6e8cf;
        --tg-black: #1a1a1a;
        --tg-dark: #2D2D2D;
        --tg-white: #ffffff;
    }

    .tg-card {
        background: var(--tg-white);
        border-radius: 1.25rem;
        border: 2px solid #e5e7eb;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

    .tg-input {
        border: 2px solid #e5e7eb;
        border-radius: .65rem;
        padding: .75rem 1rem;
        font-weight: 600;
        transition: border-color .2s, box-shadow .2s;
        width: 100%;
        background: #fafafa;
    }

        .tg-input:focus {
            outline: none;
            border-color: var(--tg-green);
            box-shadow: 0 0 0 3px rgba(46,173,75,0.15);
        }

    .tg-btn-export {
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
        color: var(--tg-white);
        font-weight: 900;
        padding: .75rem 2rem;
        border-radius: .75rem;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: all .2s;
        text-transform: uppercase;
        letter-spacing: .07em;
        box-shadow: 0 4px 16px rgba(46,173,75,0.3);
    }

        .tg-btn-export:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(46,173,75,0.4);
        }

    .tg-stat-card {
        background: var(--tg-white);
        border-radius: 1.25rem;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        padding: 1.5rem;
    }

    .tg-table-head {
        background: linear-gradient(135deg, var(--tg-black), var(--tg-dark));
    }

    .tg-alert-panel {
        background: #fffbeb;
        border: 2px solid #fde68a;
        border-left: 4px solid #f59e0b;
        border-radius: 1rem;
        padding: 1.5rem;
    }

    .tg-search-input {
        border: 2px solid rgba(255,255,255,0.2);
        border-radius: .6rem;
        padding: .5rem 1rem;
        font-weight: 600;
        background: rgba(255,255,255,0.1);
        color: white;
        font-size: .85rem;
    }

        .tg-search-input::placeholder {
            color: rgba(255,255,255,0.5);
        }

        .tg-search-input:focus {
            outline: none;
            border-color: var(--tg-green);
            background: rgba(255,255,255,0.15);
        }
</style>

<div class="space-y-6">

    <!-- Filtros -->
    <div class="tg-card p-6">
        <div class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-black text-gray-600 mb-2 uppercase tracking-widest">Días sin asistir</label>
                <select id="dias-inactividad" onchange="filtrarPorDias()" class="tg-input bg-white">
                    <option value="7" selected="@(ViewBag.Dias == 7)">7 días (1 semana)</option>
                    <option value="15" selected="@(ViewBag.Dias == 15)">15 días</option>
                    <option value="30" selected="@(ViewBag.Dias == 30)">30 días (1 mes)</option>
                    <option value="60" selected="@(ViewBag.Dias == 60)">60 días (2 meses)</option>
                    <option value="90" selected="@(ViewBag.Dias == 90)">90 días (3 meses)</option>
                </select>
            </div>
            <button onclick="exportarLista()" class="tg-btn-export">
                <i data-lucide="download" class="w-4 h-4"></i>
                Exportar Lista
            </button>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="tg-stat-card border-l-4 border-red-500">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Clientes Inactivos</p>
                        <p class="text-4xl font-black text-gray-900">@Model.Count()</p>
                    </div>
                    <div class="w-14 h-14 bg-red-100 rounded-full flex items-center justify-center">
                        <i data-lucide="user-x" class="w-7 h-7 text-red-600"></i>
                    </div>
                </div>
                <p class="text-xs text-red-600 flex items-center gap-1 font-bold">
                    <i data-lucide="alert-circle" class="w-3 h-3"></i> Requieren atención
                </p>
            </div>
            <div class="tg-stat-card border-l-4 border-orange-500">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Período Analizado</p>
                        <p class="text-4xl font-black text-gray-900">@ViewBag.Dias</p>
                    </div>
                    <div class="w-14 h-14 bg-orange-100 rounded-full flex items-center justify-center">
                        <i data-lucide="calendar" class="w-7 h-7 text-orange-600"></i>
                    </div>
                </div>
                <p class="text-xs text-orange-600 flex items-center gap-1 font-bold">
                    <i data-lucide="clock" class="w-3 h-3"></i> Días sin visita
                </p>
            </div>
            <div class="tg-stat-card border-l-4 border-amber-500">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Con Membresía</p>
                        <p class="text-4xl font-black text-gray-900">@Model.Count(c => c.Membresias != null && c.Membresias.Any(m => m.Estado == "activa"))</p>
                    </div>
                    <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center">
                        <i data-lucide="credit-card" class="w-7 h-7 text-amber-600"></i>
                    </div>
                </div>
                <p class="text-xs text-amber-600 flex items-center gap-1 font-bold">
                    <i data-lucide="alert-triangle" class="w-3 h-3"></i> Pagando pero no asisten
                </p>
            </div>
            <div class="tg-stat-card border-l-4 border-blue-500">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-xs font-black text-gray-500 mb-1 uppercase tracking-widest">Tasa de Inactividad</p>
                        <p class="text-4xl font-black text-gray-900">@((Model.Count() * 100.0 / (Model.Count() + 1)).ToString("F1"))%</p>
                    </div>
                    <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center">
                        <i data-lucide="percent" class="w-7 h-7 text-blue-600"></i>
                    </div>
                </div>
                <p class="text-xs text-blue-600 flex items-center gap-1 font-bold">
                    <i data-lucide="trending-down" class="w-3 h-3"></i> Del total
                </p>
            </div>
        </div>

        <!-- Recomendaciones -->
        <div class="tg-alert-panel">
            <div class="flex items-start gap-3">
                <i data-lucide="alert-triangle" class="w-6 h-6 text-amber-600 mt-0.5 flex-shrink-0"></i>
                <div class="flex-1">
                    <h3 class="text-lg font-black text-amber-900 mb-3 uppercase tracking-wide">Recomendaciones de Seguimiento</h3>
                    <ul class="space-y-2 text-sm text-amber-800 font-semibold">
                        <li class="flex items-center gap-2">
                            <i data-lucide="phone" class="w-4 h-4 flex-shrink-0"></i>
                            Contactar a clientes con membresías activas para conocer el motivo de su inasistencia
                        </li>
                        <li class="flex items-center gap-2">
                            <i data-lucide="gift" class="w-4 h-4 flex-shrink-0"></i>
                            Ofrecer incentivos o promociones especiales para reactivar su participación
                        </li>
                        <li class="flex items-center gap-2">
                            <i data-lucide="mail" class="w-4 h-4 flex-shrink-0"></i>
                            Enviar recordatorios amigables sobre los beneficios de mantener una rutina constante
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="tg-card overflow-hidden">
            <div class="px-6 py-4 tg-table-head flex items-center justify-between">
                <h3 class="text-lg font-black text-white uppercase tracking-wide">Listado de Clientes Inactivos</h3>
                <input type="text" id="search-input" placeholder="Buscar cliente..."
                       class="tg-search-input" style="width:200px;">
            </div>
            <div class="overflow-x-auto">
                <table class="w-full" id="tabla-inactivos">
                    <thead class="bg-gray-50 border-b-2 border-gray-100">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Cliente</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Contacto</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Membresía</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Último Check-in</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y-2 divide-gray-100">
                        @foreach (var cliente in Model.OrderBy(c => c.Nombre))
                        {
                            var ultimoCheckIn = cliente.CheckIns?.OrderByDescending(ci => ci.FechaHora).FirstOrDefault();
                            var membresiasActivas = cliente.Membresias?.Where(m => m.Estado == "activa");
                            var tieneMembresia = membresiasActivas?.Any() ?? false;

                            <tr class="hover:bg-gray-50 transition-colors cliente-row">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(cliente.FotoBase64))
                                        {
                                            <img src="data:image/jpeg;base64,@cliente.FotoBase64"
                                                 class="w-11 h-11 rounded-full object-cover border-2" style="border-color:var(--tg-green);">
                                        }
                                        else
                                        {
                                            <div class="w-11 h-11 rounded-full bg-gray-200 flex items-center justify-center">
                                                <i data-lucide="user" class="w-5 h-5 text-gray-500"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="font-black text-gray-900 cliente-nombre">@cliente.Nombre @cliente.Apellido</div>
                                            <div class="text-xs text-gray-500 font-semibold">Cédula: @cliente.Cedula</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm space-y-0.5">
                                        <div class="text-gray-700 flex items-center gap-1 font-bold">
                                            <i data-lucide="phone" class="w-3 h-3"></i> @cliente.Telefono
                                        </div>
                                        @if (!string.IsNullOrEmpty(cliente.Email))
                                        {
                                            <div class="text-gray-500 flex items-center gap-1 font-semibold text-xs">
                                                <i data-lucide="mail" class="w-3 h-3"></i> @cliente.Email
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    @if (tieneMembresia)
                                    {
                                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-amber-100 text-amber-800 font-black rounded-full text-xs uppercase tracking-wide">
                                            <i data-lucide="alert-circle" class="w-3 h-3"></i> Activa (No asiste)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 text-gray-600 font-black rounded-full text-xs uppercase tracking-wide">
                                            <i data-lucide="x-circle" class="w-3 h-3"></i> Sin membresía
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    @if (ultimoCheckIn != null)
                                    {
                                        var diasInactivo = (DateTime.Now - ultimoCheckIn.FechaHora).Days;
                                        <div class="text-sm">
                                            <div class="font-black text-gray-900">@ultimoCheckIn.FechaHora.ToString("dd/MM/yyyy")</div>
                                            <div class="text-red-600 font-black text-xs">Hace @diasInactivo días</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400 font-bold">Sin registros</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="/clientes/detalle/@cliente.Id"
                                           class="p-2 rounded-lg transition-colors text-blue-600 hover:bg-blue-50" title="Ver detalle">
                                            <i data-lucide="eye" class="w-4 h-4"></i>
                                        </a>
                                        <button onclick="contactarCliente('@cliente.Telefono', '@cliente.Nombre')"
                                                class="p-2 rounded-lg transition-colors hover:bg-green-50 border-none bg-transparent cursor-pointer"
                                                style="color:var(--tg-green);" title="Contactar">
                                            <i data-lucide="phone" class="w-4 h-4"></i>
                                        </button>
                                        <button onclick="enviarRecordatorio('@cliente.Email', '@cliente.Nombre')"
                                                class="p-2 text-amber-600 hover:bg-amber-50 rounded-lg transition-colors border-none bg-transparent cursor-pointer"
                                                title="Enviar recordatorio"
                                        @(string.IsNullOrEmpty(cliente.Email) ? "disabled" : "")>
                                            <i data-lucide="mail" class="w-4 h-4"></i>
                                        </button>
                                        @if (tieneMembresia)
                                        {
                                            <a href="/membresias?clienteId=@cliente.Id"
                                               class="p-2 text-purple-600 hover:bg-purple-50 rounded-lg transition-colors" title="Ver membresías">
                                                <i data-lucide="credit-card" class="w-4 h-4"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="tg-card p-12 text-center">
            <div class="w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-4" style="background:var(--tg-green-light);">
                <i data-lucide="check-circle" class="w-14 h-14" style="color:var(--tg-green);"></i>
            </div>
            <h3 class="text-3xl font-black text-gray-900 mb-3 uppercase tracking-wide">¡Excelente Participación!</h3>
            <p class="text-gray-500 text-lg font-bold">No hay clientes inactivos en los últimos @ViewBag.Dias días</p>
            <p class="text-gray-400 mt-2 font-semibold text-sm">Todos los clientes mantienen una asistencia regular</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('search-input')?.addEventListener('input', function(e) {
            const search = e.target.value.toLowerCase();
            document.querySelectorAll('.cliente-row').forEach(row => {
                const nombre = row.querySelector('.cliente-nombre').textContent.toLowerCase();
                row.style.display = nombre.includes(search) ? '' : 'none';
            });
        });

        function filtrarPorDias() {
            const dias = document.getElementById('dias-inactividad').value;
            window.location.href = `/reportes/clientes-inactivos?dias=${dias}`;
        }

        function contactarCliente(telefono, nombre) {
            alert(`Contactar a ${nombre} al número: ${telefono}`);
        }

        function enviarRecordatorio(email, nombre) {
            if (!email) { alert('Este cliente no tiene email registrado'); return; }
            alert(`Se enviará un recordatorio a ${nombre} al email: ${email}`);
        }

        function exportarLista() {
            alert('Si deseas exportar archivos comunicate al 584247551680');
        }

        window.addEventListener('load', function() { lucide.createIcons(); });
    </script>
}

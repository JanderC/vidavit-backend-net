@model IEnumerable<VidaFitBackend.Models.Cliente>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clientes Inactivos";
    ViewData["Subtitle"] = "Seguimiento de clientes - PowerZoneFit";
}

<style>
    :root {
        --pz-gold: #D4A017;
        --pz-gold-light: #F0C040;
        --pz-blue: #1A3A8F;
        --pz-blue-light: #2B55CC;
        --pz-silver: #B0B8C8;
        --pz-dark: #08090E;
        --pz-card: #0E1120;
        --pz-card2: #131829;
        --pz-border: #1E2540;
        --pz-text: #E8ECF4;
        --pz-muted: #5A6480;
    }

    body, .space-y-6 {
        background: var(--pz-dark);
    }

    /* ── Cards ── */
    .pz-card {
        background: var(--pz-card);
        border: 1px solid var(--pz-border);
        border-radius: 1rem;
    }

    /* ── Stat cards ── */
    .pz-stat {
        background: var(--pz-card);
        border-radius: 1rem;
        padding: 1.5rem;
        border: 1px solid var(--pz-border);
        border-left-width: 4px;
        box-shadow: 0 4px 20px rgba(0,0,0,.4);
    }

    .pz-stat-label {
        font-size: .72rem;
        font-weight: 800;
        color: var(--pz-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .35rem;
    }

    .pz-stat-value {
        font-size: 2.25rem;
        font-weight: 900;
        line-height: 1;
    }

    .pz-stat-footer {
        font-size: .72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: .3rem;
        margin-top: .6rem;
    }

    /* ── Inputs / Selects ── */
    .pz-select, .pz-search {
        background: #0a0c14;
        border: 2px solid var(--pz-border);
        color: var(--pz-text);
        border-radius: .6rem;
        padding: .75rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s;
        width: 100%;
    }

        .pz-select:focus, .pz-search:focus {
            border-color: var(--pz-gold);
        }

    .pz-search {
        width: auto;
        padding: .5rem 1rem;
        font-size: .875rem;
    }

    /* ── Button ── */
    .pz-btn {
        background: linear-gradient(135deg, var(--pz-gold) 0%, var(--pz-gold-light) 100%);
        color: #08090E;
        font-weight: 900;
        padding: .8rem 2rem;
        border-radius: .6rem;
        border: none;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: .06em;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: opacity .2s, transform .15s;
        box-shadow: 0 4px 18px rgba(212,160,23,.35);
        white-space: nowrap;
    }

        .pz-btn:hover {
            opacity: .88;
            transform: translateY(-1px);
        }

    /* ── Alert / Recommendation box ── */
    .pz-alert {
        background: rgba(212,160,23,.07);
        border: 1px solid rgba(212,160,23,.3);
        border-left: 4px solid var(--pz-gold);
        border-radius: 1rem;
        padding: 1.5rem;
    }

    /* ── Section title ── */
    .pz-section-title {
        font-size: 1rem;
        font-weight: 900;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: .08em;
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: 0;
    }

        .pz-section-title::before {
            content: '';
            display: block;
            width: 3px;
            height: 1rem;
            background: linear-gradient(180deg, var(--pz-gold), var(--pz-gold-light));
            border-radius: 2px;
            flex-shrink: 0;
        }

    /* ── Table ── */
    .pz-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pz-table thead tr {
            background: #090b14;
        }

        .pz-table th {
            padding: 1rem 1.5rem;
            font-size: .72rem;
            font-weight: 800;
            color: var(--pz-muted);
            text-transform: uppercase;
            letter-spacing: .08em;
            border-bottom: 1px solid var(--pz-border);
        }

        .pz-table td {
            padding: .9rem 1.5rem;
            border-bottom: 1px solid var(--pz-border);
            color: var(--pz-text);
            vertical-align: middle;
        }

        .pz-table tbody tr:hover td {
            background: #101424;
        }

        .pz-table tbody tr:last-child td {
            border-bottom: none;
        }

    /* ── Action icon buttons ── */
    .pz-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: .5rem;
        border: 1px solid var(--pz-border);
        background: transparent;
        cursor: pointer;
        transition: background .15s, border-color .15s;
        text-decoration: none;
    }

        .pz-action-btn:hover {
            background: rgba(255,255,255,.06);
            border-color: var(--pz-gold);
        }

    /* ── Badge ── */
    .pz-brand-badge {
        background: linear-gradient(135deg, var(--pz-blue) 0%, var(--pz-blue-light) 100%);
        padding: .35rem 1rem;
        border-radius: .5rem;
        border: 2px solid var(--pz-gold);
        box-shadow: 0 0 14px rgba(212,160,23,.3);
        display: flex;
        flex-direction: column;
        align-items: center;
        line-height: 1;
    }
</style>

<div class="space-y-6" style="padding:1.5rem;background:var(--pz-dark);min-height:100vh;">

    <!-- Header Brand -->
    <div style="display:flex;align-items:center;gap:.9rem;">
        <div class="pz-brand-badge">
            <span style="font-size:.6rem;font-weight:700;color:var(--pz-silver);letter-spacing:.18em;text-transform:uppercase;">BOX BY CHOPER</span>
            <span style="font-size:1rem;font-weight:900;color:#fff;letter-spacing:.06em;text-transform:uppercase;">POWER ZONE</span>
            <span style="font-size:.58rem;font-weight:700;color:var(--pz-silver);letter-spacing:.22em;text-transform:uppercase;">TRAINING</span>
        </div>
        <div>
            <h2 style="font-size:1.5rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.04em;">Clientes Inactivos</h2>
            <p style="color:var(--pz-muted);font-size:.82rem;">Seguimiento de clientes sin asistencia reciente</p>
        </div>
    </div>

    <!-- Filtro -->
    <div class="pz-card" style="padding:1.5rem;">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:1rem;">
            <div style="flex:1;min-width:200px;">
                <label style="display:block;font-size:.78rem;font-weight:800;color:var(--pz-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem;">Días sin asistir</label>
                <select id="dias-inactividad" onchange="filtrarPorDias()" class="pz-select">
                    <option value="7" selected="@(ViewBag.Dias == 7)">7 días (1 semana)</option>
                    <option value="15" selected="@(ViewBag.Dias == 15)">15 días</option>
                    <option value="30" selected="@(ViewBag.Dias == 30)">30 días (1 mes)</option>
                    <option value="60" selected="@(ViewBag.Dias == 60)">60 días (2 meses)</option>
                    <option value="90" selected="@(ViewBag.Dias == 90)">90 días (3 meses)</option>
                </select>
            </div>
            <button onclick="exportarLista()" class="pz-btn">
                <i data-lucide="download" style="width:1rem;height:1rem;"></i>
                Exportar Lista
            </button>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Clientes Inactivos -->
            <div class="pz-stat" style="border-left-color:#e05c5c;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                    <div>
                        <p class="pz-stat-label">Clientes Inactivos</p>
                        <p class="pz-stat-value" style="color:#f87070;">@Model.Count()</p>
                    </div>
                    <div style="width:3.5rem;height:3.5rem;background:rgba(224,92,92,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid rgba(224,92,92,.3);">
                        <i data-lucide="user-x" style="width:1.6rem;height:1.6rem;color:#f87070;"></i>
                    </div>
                </div>
                <p class="pz-stat-footer" style="color:#f87070;">
                    <i data-lucide="alert-circle" style="width:.85rem;height:.85rem;"></i>
                    Requieren atención
                </p>
            </div>

            <!-- Período -->
            <div class="pz-stat" style="border-left-color:var(--pz-gold);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                    <div>
                        <p class="pz-stat-label">Período Analizado</p>
                        <p class="pz-stat-value" style="color:var(--pz-gold-light);">@ViewBag.Dias</p>
                    </div>
                    <div style="width:3.5rem;height:3.5rem;background:rgba(212,160,23,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid rgba(212,160,23,.3);">
                        <i data-lucide="calendar" style="width:1.6rem;height:1.6rem;color:var(--pz-gold);"></i>
                    </div>
                </div>
                <p class="pz-stat-footer" style="color:var(--pz-gold);">
                    <i data-lucide="clock" style="width:.85rem;height:.85rem;"></i>
                    Días sin visita
                </p>
            </div>

            <!-- Con Membresía -->
            <div class="pz-stat" style="border-left-color:var(--pz-gold-light);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                    <div>
                        <p class="pz-stat-label">Con Membresía</p>
                        <p class="pz-stat-value" style="color:var(--pz-gold-light);">@Model.Count(c => c.Membresias != null && c.Membresias.Any(m => m.Estado == "activa"))</p>
                    </div>
                    <div style="width:3.5rem;height:3.5rem;background:rgba(240,192,64,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid rgba(240,192,64,.25);">
                        <i data-lucide="credit-card" style="width:1.6rem;height:1.6rem;color:var(--pz-gold-light);"></i>
                    </div>
                </div>
                <p class="pz-stat-footer" style="color:var(--pz-gold-light);">
                    <i data-lucide="alert-triangle" style="width:.85rem;height:.85rem;"></i>
                    Pagando pero no asisten
                </p>
            </div>

            <!-- Tasa de Inactividad -->
            <div class="pz-stat" style="border-left-color:var(--pz-blue-light);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                    <div>
                        <p class="pz-stat-label">Tasa de Inactividad</p>
                        <p class="pz-stat-value" style="color:#6ea0f7;">@((Model.Count() * 100.0 / (Model.Count() + 1)).ToString("F1"))%</p>
                    </div>
                    <div style="width:3.5rem;height:3.5rem;background:rgba(26,58,143,.25);border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid rgba(43,85,204,.4);">
                        <i data-lucide="percent" style="width:1.6rem;height:1.6rem;color:#6ea0f7;"></i>
                    </div>
                </div>
                <p class="pz-stat-footer" style="color:#6ea0f7;">
                    <i data-lucide="trending-down" style="width:.85rem;height:.85rem;"></i>
                    Del total
                </p>
            </div>
        </div>

        <!-- Recomendaciones -->
        <div class="pz-alert">
            <div style="display:flex;align-items:flex-start;gap:.9rem;">
                <i data-lucide="alert-triangle" style="width:1.6rem;height:1.6rem;color:var(--pz-gold);margin-top:.1rem;flex-shrink:0;"></i>
                <div>
                    <h3 style="font-size:1.1rem;font-weight:900;color:var(--pz-gold-light);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.75rem;">Recomendaciones de Seguimiento</h3>
                    <ul style="display:flex;flex-direction:column;gap:.65rem;font-size:.875rem;color:var(--pz-text);font-weight:600;">
                        <li style="display:flex;align-items:center;gap:.6rem;">
                            <i data-lucide="phone" style="width:1.1rem;height:1.1rem;color:var(--pz-gold);flex-shrink:0;"></i>
                            Contactar a clientes con membresías activas para conocer el motivo de su inasistencia
                        </li>
                        <li style="display:flex;align-items:center;gap:.6rem;">
                            <i data-lucide="gift" style="width:1.1rem;height:1.1rem;color:var(--pz-gold);flex-shrink:0;"></i>
                            Ofrecer incentivos o promociones especiales para reactivar su participación
                        </li>
                        <li style="display:flex;align-items:center;gap:.6rem;">
                            <i data-lucide="mail" style="width:1.1rem;height:1.1rem;color:var(--pz-gold);flex-shrink:0;"></i>
                            Enviar recordatorios amigables sobre los beneficios de mantener una rutina constante
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="pz-card" style="overflow:hidden;">
            <!-- Table header bar -->
            <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--pz-border);background:linear-gradient(90deg,#090b14,#0d1020);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;">
                <p class="pz-section-title">Listado de Clientes Inactivos</p>
                <input type="text" id="search-input" placeholder="Buscar cliente…" class="pz-search">
            </div>
            <div style="overflow-x:auto;">
                <table class="pz-table" id="tabla-inactivos">
                    <thead>
                        <tr>
                            <th style="text-align:left;">Cliente</th>
                            <th style="text-align:left;">Contacto</th>
                            <th style="text-align:center;">Estado Membresía</th>
                            <th style="text-align:center;">Último Check-in</th>
                            <th style="text-align:center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in Model.OrderBy(c => c.Nombre))
                        {
                            var ultimoCheckIn = cliente.CheckIns?.OrderByDescending(ci => ci.FechaHora).FirstOrDefault();
                            var membresiasActivas = cliente.Membresias?.Where(m => m.Estado == "activa");
                            var tieneMembresia = membresiasActivas?.Any() ?? false;

                            <tr class="cliente-row">
                                <!-- Cliente -->
                                <td>
                                    <div style="display:flex;align-items:center;gap:.75rem;">
                                        @if (!string.IsNullOrEmpty(cliente.FotoBase64))
                                        {
                                            <img src="data:image/jpeg;base64,@cliente.FotoBase64"
                                                 style="width:2.75rem;height:2.75rem;border-radius:50%;object-fit:cover;border:2px solid var(--pz-gold);">
                                        }
                                        else
                                        {
                                            <div style="width:2.75rem;height:2.75rem;border-radius:50%;background:rgba(26,58,143,.3);display:flex;align-items:center;justify-content:center;border:2px solid var(--pz-border);flex-shrink:0;">
                                                <i data-lucide="user" style="width:1.25rem;height:1.25rem;color:var(--pz-muted);"></i>
                                            </div>
                                        }
                                        <div>
                                            <div style="font-weight:900;color:#fff;" class="cliente-nombre">@cliente.Nombre @cliente.Apellido</div>
                                            <div style="font-size:.8rem;color:var(--pz-muted);font-weight:600;">Cédula: @cliente.Cedula</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Contacto -->
                                <td>
                                    <div style="font-size:.875rem;display:flex;flex-direction:column;gap:.25rem;">
                                        <div style="color:var(--pz-text);font-weight:700;display:flex;align-items:center;gap:.35rem;">
                                            <i data-lucide="phone" style="width:.9rem;height:.9rem;color:var(--pz-gold);"></i>
                                            @cliente.Telefono
                                        </div>
                                        @if (!string.IsNullOrEmpty(cliente.Email))
                                        {
                                            <div style="color:var(--pz-muted);font-weight:600;display:flex;align-items:center;gap:.35rem;">
                                                <i data-lucide="mail" style="width:.9rem;height:.9rem;color:var(--pz-muted);"></i>
                                                @cliente.Email
                                            </div>
                                        }
                                    </div>
                                </td>

                                <!-- Estado Membresía -->
                                <td style="text-align:center;">
                                    @if (tieneMembresia)
                                    {
                                        <span style="display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .85rem;background:rgba(240,192,64,.12);color:var(--pz-gold-light);border-radius:9999px;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;border:1px solid rgba(240,192,64,.3);">
                                            <i data-lucide="alert-circle" style="width:.75rem;height:.75rem;"></i>
                                            Activa (No asiste)
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .85rem;background:rgba(90,100,128,.12);color:var(--pz-muted);border-radius:9999px;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;border:1px solid var(--pz-border);">
                                            <i data-lucide="x-circle" style="width:.75rem;height:.75rem;"></i>
                                            Sin membresía
                                        </span>
                                    }
                                </td>

                                <!-- Último Check-in -->
                                <td style="text-align:center;">
                                    @if (ultimoCheckIn != null)
                                    {
                                        var diasInactivo = (DateTime.Now - ultimoCheckIn.FechaHora).Days;
                                        <div>
                                            <div style="font-weight:900;color:#fff;">@ultimoCheckIn.FechaHora.ToString("dd/MM/yyyy")</div>
                                            <div style="font-size:.8rem;font-weight:800;color:#f87070;">Hace @diasInactivo días</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="font-size:.875rem;color:var(--pz-muted);font-weight:700;">Sin registros</span>
                                    }
                                </td>

                                <!-- Acciones -->
                                <td style="text-align:center;">
                                    <div style="display:flex;align-items:center;justify-content:center;gap:.4rem;">
                                        <a href="/clientes/detalle/@cliente.Id" class="pz-action-btn" title="Ver detalle">
                                            <i data-lucide="eye" style="width:1.1rem;height:1.1rem;color:#6ea0f7;"></i>
                                        </a>
                                        <button onclick="contactarCliente('@cliente.Telefono', '@cliente.Nombre')" class="pz-action-btn" title="Contactar">
                                            <i data-lucide="phone" style="width:1.1rem;height:1.1rem;color:#4ade80;"></i>
                                        </button>
                                        <button onclick="enviarRecordatorio('@cliente.Email', '@cliente.Nombre')"
                                                class="pz-action-btn" title="Enviar recordatorio"
                                        @(string.IsNullOrEmpty(cliente.Email) ? "disabled style='opacity:.35;cursor:not-allowed;'" : "")>
                                            <i data-lucide="mail" style="width:1.1rem;height:1.1rem;color:var(--pz-gold);"></i>
                                        </button>
                                        @if (tieneMembresia)
                                        {
                                            <a href="/membresias?clienteId=@cliente.Id" class="pz-action-btn" title="Ver membresías">
                                                <i data-lucide="credit-card" style="width:1.1rem;height:1.1rem;color:var(--pz-silver);"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="pz-card" style="padding:4rem;text-align:center;">
            <div style="width:5.5rem;height:5.5rem;background:rgba(74,222,128,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;border:2px solid rgba(74,222,128,.25);">
                <i data-lucide="check-circle" style="width:3rem;height:3rem;color:#4ade80;"></i>
            </div>
            <h3 style="font-size:1.5rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.75rem;">¡Excelente Participación!</h3>
            <p style="color:var(--pz-text);font-size:1rem;font-weight:700;">No hay clientes inactivos en los últimos @ViewBag.Dias días</p>
            <p style="color:var(--pz-muted);margin-top:.5rem;font-weight:600;">Todos los clientes mantienen una asistencia regular</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('search-input')?.addEventListener('input', function(e) {
            const search = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('.cliente-row');

            rows.forEach(row => {
                const nombre = row.querySelector('.cliente-nombre').textContent.toLowerCase();
                if (nombre.includes(search)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        function filtrarPorDias() {
            const dias = document.getElementById('dias-inactividad').value;
            window.location.href = `/reportes/clientes-inactivos?dias=${dias}`;
        }

        function contactarCliente(telefono, nombre) {
            alert(`Contactar a ${nombre} al número: ${telefono}`);
        }

        function enviarRecordatorio(email, nombre) {
            if (!email) {
                alert('Este cliente no tiene email registrado');
                return;
            }
            alert(`Se enviará un recordatorio a ${nombre} al email: ${email}`);
        }

        function exportarLista() {
            alert('Si deseas exportar archivos comunicate al 584247551680');
        }

        window.addEventListener('load', function() {
            lucide.createIcons();
        });
    </script>
}

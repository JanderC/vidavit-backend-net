@model List<VidaFit.Controllers.WEB.IngresoMembresiaReporte>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ingresos por Membresías";
    ViewData["Subtitle"] = "Análisis de pagos por tipo de plan - ELITE GYM";

    decimal totalIngresos = 0;
    int totalPagos = 0;

    if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            totalIngresos += item.Total;
            totalPagos += item.CantidadPagos;
        }
    }
}

<div class="space-y-6">
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
        <div class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
            </div>
            <button onclick="filtrarPorFecha()"
                    class="px-8 py-3 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                Filtrar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-emerald-600">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Ingresos Totales</p>
                        <p class="text-4xl font-black text-gray-900">$@totalIngresos.ToString("N2")</p>
                    </div>
                    <div class="w-14 h-14 bg-emerald-100 rounded-full flex items-center justify-center">
                        <i data-lucide="dollar-sign" class="w-7 h-7 text-emerald-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-blue-600">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Total de Pagos</p>
                        <p class="text-4xl font-black text-gray-900">@totalPagos</p>
                    </div>
                    <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center">
                        <i data-lucide="credit-card" class="w-7 h-7 text-blue-600"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
            <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-wide">Ingresos por Tipo de Plan</h3>
            <div class="relative" style="height: 400px;">
                <canvas id="chart-ingresos"></canvas>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
            <div class="px-6 py-4 border-b-2 border-gray-200 bg-gradient-to-r from-gray-900 to-black">
                <h3 class="text-xl font-black text-white uppercase tracking-wide">Detalle por Plan</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b-2 border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase tracking-wider">Plan</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase tracking-wider">Cantidad de Pagos</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-600 uppercase tracking-wider">Ingresos</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase tracking-wider">Participación</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y-2 divide-gray-200">
                        @foreach (var item in Model)
                        {
                            var porcentaje = totalIngresos > 0 ? (item.Total / totalIngresos * 100) : 0;

                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 bg-gradient-to-r from-red-600 to-red-800 rounded-xl flex items-center justify-center">
                                            <i data-lucide="award" class="w-6 h-6 text-white"></i>
                                        </div>
                                        <span class="font-black text-gray-900">@item.PlanNombre</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center px-4 py-2 bg-blue-100 text-blue-800 font-black rounded-full uppercase text-xs tracking-wide">
                                        @item.CantidadPagos pagos
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <span class="text-2xl font-black text-emerald-600">$@item.Total.ToString("N2")</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <div class="w-24 bg-gray-200 rounded-full h-3">
                                            <div class="bg-gradient-to-r from-red-600 to-red-800 h-3 rounded-full" style="width: @porcentaje.ToString("F1")%"></div>
                                        </div>
                                        <span class="text-xs font-black text-gray-900">@porcentaje.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl shadow-xl p-12 text-center border-2 border-gray-200">
            <i data-lucide="inbox" class="w-24 h-24 mx-auto mb-4 text-gray-400"></i>
            <h3 class="text-2xl font-black text-gray-900 mb-3 uppercase tracking-wide">No hay pagos en este período</h3>
            <p class="text-gray-600 font-semibold">Intenta seleccionar un rango de fechas diferente</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ingresosData = @Html.Raw(JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/ingresos-membresias?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            if (ingresosData.length === 0) return;

            const ctx = document.getElementById('chart-ingresos');

            const labels = ingresosData.map(i => i.PlanNombre);
            const totales = ingresosData.map(i => i.Total);

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Ingresos ($)',
                        data: totales,
                        backgroundColor: '#E31E24',
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    return '$' + context.parsed.y.toFixed(2);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value;
                                }
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        window.addEventListener('load', function() {
            renderChart();
            lucide.createIcons();
        });
    </script>
}

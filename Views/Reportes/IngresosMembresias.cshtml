@model List<VidaFit.Controllers.WEB.IngresoMembresiaReporte>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ingresos por Membresías";
    ViewData["Subtitle"] = "Análisis de pagos por tipo de plan - Power Fitness";
    decimal totalIngresos = 0; int totalPagos = 0;
    if (Model != null && Model.Count > 0) { foreach (var item in Model) { totalIngresos += item.Total; totalPagos += item.CantidadPagos; } }
}

<style>
    :root{--pf-blue:#3B82F6;--pf-blueB:#60A5FA;--pf-deep:#1E3A8A;--pf-purple:#7C3AED;--pf-card:#0D1526;--pf-border:#1E2D4A;--pf-text:#E2E8F0;--pf-soft:#94A3B8;--pf-muted:#64748B;--pf-green:#10B981;--pf-red:#EF4444;--pf-orange:#F59E0B;}
    .pf-input{width:100%;padding:.75rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:rgba(255,255,255,.03);color:var(--pf-text);font-weight:600;font-family:inherit;outline:none;box-sizing:border-box;transition:border-color .2s;}
    .pf-input:focus{border-color:var(--pf-blue);}
    .pf-card{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;padding:1.5rem;box-shadow:0 4px 20px rgba(0,0,0,.3);}
    .pf-th{padding:.875rem 1.5rem;text-align:left;font-size:.68rem;font-weight:800;color:rgba(255,255,255,.85);text-transform:uppercase;letter-spacing:.12em;}
    .pf-td{padding:1rem 1.5rem;border-bottom:1px solid var(--pf-border);}
</style>

<div style="display:flex;flex-direction:column;gap:1.25rem;">

    <!-- Filtro fechas -->
    <div class="pf-card">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:1rem;">
            <div style="flex:1;min-width:180px;">
                <label style="display:block;font-size:.7rem;font-weight:800;color:var(--pf-soft);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem;">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <div style="flex:1;min-width:180px;">
                <label style="display:block;font-size:.7rem;font-weight:800;color:var(--pf-soft);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem;">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <button onclick="filtrarPorFecha()"
                    style="padding:.75rem 2rem;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;font-weight:800;border:none;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;box-shadow:0 4px 16px rgba(59,130,246,.3);display:inline-flex;align-items:center;gap:.5rem;transition:transform .2s;"
                    onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                <i data-lucide="filter" style="width:16px;height:16px;"></i> Filtrar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <!-- Stats -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div class="pf-card" style="border-left:4px solid var(--pf-green);display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .35rem 0;">Ingresos Totales</p>
                    <p style="font-size:2.25rem;font-weight:900;color:var(--pf-green);margin:0;">$@totalIngresos.ToString("N2")</p>
                </div>
                <div style="width:52px;height:52px;background:rgba(16,185,129,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i data-lucide="dollar-sign" style="width:26px;height:26px;color:var(--pf-green);"></i>
                </div>
            </div>
            <div class="pf-card" style="border-left:4px solid var(--pf-blue);display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <p style="font-size:.7rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .35rem 0;">Total de Pagos</p>
                    <p style="font-size:2.25rem;font-weight:900;color:var(--pf-blueB);margin:0;">@totalPagos</p>
                </div>
                <div style="width:52px;height:52px;background:rgba(59,130,246,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i data-lucide="credit-card" style="width:26px;height:26px;color:var(--pf-blueB);"></i>
                </div>
            </div>
        </div>

        <!-- Gráfico -->
        <div class="pf-card">
            <h3 style="font-size:1rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.08em;margin:0 0 1.25rem 0;">Ingresos por Tipo de Plan</h3>
            <div style="position:relative;height:360px;">
                <canvas id="chart-ingresos"></canvas>
            </div>
        </div>

        <!-- Tabla -->
        <div class="pf-card" style="padding:0;overflow:hidden;">
            <div style="padding:.875rem 1.5rem;background:linear-gradient(135deg,var(--pf-deep),#111827);border-bottom:2px solid var(--pf-blue);">
                <h3 style="font-size:.95rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.08em;margin:0;">Detalle por Plan</h3>
            </div>
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="background:rgba(6,11,24,.5);">
                        <th class="pf-th">Plan</th>
                        <th class="pf-th" style="text-align:center;">Pagos</th>
                        <th class="pf-th" style="text-align:right;">Ingresos</th>
                        <th class="pf-th" style="text-align:center;">Participación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var pct = totalIngresos > 0 ? (item.Total / totalIngresos * 100) : 0;
                        <tr style="transition:background .15s;" onmouseover="this.style.background='rgba(59,130,246,.04)'" onmouseout="this.style.background='transparent'">
                            <td class="pf-td">
                                <div style="display:flex;align-items:center;gap:.75rem;">
                                    <div style="width:42px;height:42px;background:linear-gradient(135deg,var(--pf-deep),var(--pf-purple));border-radius:.625rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <i data-lucide="award" style="width:20px;height:20px;color:#fff;"></i>
                                    </div>
                                    <span style="font-weight:800;color:var(--pf-text);">@item.PlanNombre</span>
                                </div>
                            </td>
                            <td class="pf-td" style="text-align:center;">
                                <span style="padding:.25rem .875rem;background:rgba(59,130,246,.1);color:var(--pf-blueB);border:1px solid rgba(59,130,246,.25);border-radius:999px;font-size:.72rem;font-weight:800;text-transform:uppercase;">@item.CantidadPagos pagos</span>
                            </td>
                            <td class="pf-td" style="text-align:right;">
                                <span style="font-size:1.25rem;font-weight:900;color:var(--pf-green);">$@item.Total.ToString("N2")</span>
                            </td>
                            <td class="pf-td" style="text-align:center;">
                                <div style="display:flex;align-items:center;justify-content:center;gap:.625rem;">
                                    <div style="width:80px;height:8px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden;">
                                        <div style="width:@pct.ToString("F1")%;height:100%;background:linear-gradient(90deg,var(--pf-blue),var(--pf-purple));border-radius:999px;"></div>
                                    </div>
                                    <span style="font-size:.78rem;font-weight:800;color:var(--pf-text);">@pct.ToString("F1")%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="pf-card" style="text-align:center;padding:4rem 2rem;">
            <i data-lucide="inbox" style="width:72px;height:72px;color:var(--pf-border);display:block;margin:0 auto 1.25rem;"></i>
            <h3 style="font-size:1.25rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;margin:0 0 .625rem 0;">No hay pagos en este período</h3>
            <p style="color:var(--pf-muted);font-weight:600;margin:0;">Intenta seleccionar un rango de fechas diferente</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ingresosData = @Html.Raw(JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/ingresos-membresias?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            if (!ingresosData || ingresosData.length === 0) return;
            new Chart(document.getElementById('chart-ingresos'), {
                type: 'bar',
                data: {
                    labels: ingresosData.map(i => i.PlanNombre),
                    datasets: [{ label: 'Ingresos ($)', data: ingresosData.map(i => i.Total), backgroundColor: '#3B82F6', borderRadius: 8, borderSkipped: false }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: { backgroundColor: 'rgba(6,11,24,.9)', padding: 12, callbacks: { label: ctx => '$' + ctx.parsed.y.toFixed(2) } } },
                    scales: {
                        y: { beginAtZero: true, ticks: { color: '#94A3B8', callback: v => '$' + v }, grid: { color: 'rgba(255,255,255,.05)' } },
                        x: { ticks: { color: '#94A3B8' }, grid: { display: false } }
                    }
                }
            });
        }

        window.addEventListener('load', function() { renderChart(); lucide.createIcons(); });
    </script>
}

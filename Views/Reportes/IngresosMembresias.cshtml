@model List<VidaFit.Controllers.WEB.IngresoMembresiaReporte>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ingresos por Membresías";
    ViewData["Subtitle"] = "Análisis de pagos por tipo de plan - POWER FITNESS";

    decimal totalIngresos = 0;
    int totalPagos = 0;

    if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            totalIngresos += item.Total;
            totalPagos += item.CantidadPagos;
        }
    }
}

<style>
    .pf-input { width:100%;padding:12px 16px;background:rgba(255,255,255,0.04);border:1px solid rgba(30,111,227,0.2);border-radius:12px;color:#fff;font-size:0.9rem;font-weight:600;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s,box-shadow .2s; }
    .pf-input:focus { border-color:#1E6FE3;box-shadow:0 0 0 3px rgba(30,111,227,0.15); }
    .pf-label { display:block;font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:8px; }
    .stat-card { background:#0D0D20;border:1px solid rgba(30,111,227,0.12);border-radius:14px;padding:20px 22px; }
    .section-card { background:#0D0D20;border:1px solid rgba(30,111,227,0.12);border-radius:14px;overflow:hidden; }
    .pf-table { width:100%;border-collapse:collapse; }
    .pf-table thead tr { border-bottom:1px solid rgba(30,111,227,0.2); }
    .pf-table thead th { padding:13px 18px;font-size:0.6rem;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,0.3); }
    .pf-table tbody tr { border-bottom:1px solid rgba(255,255,255,0.04);transition:background .15s; }
    .pf-table tbody tr:hover { background:rgba(30,111,227,0.05); }
    .pf-table tbody td { padding:14px 18px; }
</style>

<div style="display:flex;flex-direction:column;gap:18px;">

    <!-- Filtro -->
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:14px;padding:20px 22px;">
        <div style="display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;">
            <div style="flex:1;min-width:180px;">
                <label class="pf-label">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <div style="flex:1;min-width:180px;">
                <label class="pf-label">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="pf-input">
            </div>
            <button onclick="filtrarPorFecha()"
                    style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer;transition:opacity .2s,transform .2s;"
                    onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.02)'" onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
                <i data-lucide="filter" style="width:15px;height:15px;"></i> Filtrar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <!-- Stats -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="stat-card" style="border-left:3px solid #10B981;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Ingresos Totales</p>
                        <p style="font-size:2rem;font-weight:900;color:#10B981;margin:0;">$@totalIngresos.ToString("N2")</p>
                    </div>
                    <div style="width:48px;height:48px;border-radius:12px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="dollar-sign" style="width:22px;height:22px;color:#10B981;"></i>
                    </div>
                </div>
            </div>
            <div class="stat-card" style="border-left:3px solid #3D8EFF;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 8px 0;">Total de Pagos</p>
                        <p style="font-size:2rem;font-weight:900;color:#fff;margin:0;">@totalPagos</p>
                    </div>
                    <div style="width:48px;height:48px;border-radius:12px;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.2);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="credit-card" style="width:22px;height:22px;color:#3D8EFF;"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart -->
        <div class="section-card" style="padding:24px;">
            <p style="font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:2px;color:#fff;margin:0 0 20px 0;">Ingresos por Tipo de Plan</p>
            <div style="height:380px;">
                <canvas id="chart-ingresos"></canvas>
            </div>
        </div>

        <!-- Tabla -->
        <div class="section-card">
            <div style="padding:16px 20px;border-bottom:1px solid rgba(30,111,227,0.15);background:linear-gradient(135deg,rgba(30,111,227,0.1),rgba(107,63,160,0.1));">
                <p style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:2px;color:#fff;margin:0;">Detalle por Plan</p>
            </div>
            <table class="pf-table">
                <thead>
                    <tr>
                        <th>Plan</th>
                        <th style="text-align:center;">Cantidad de Pagos</th>
                        <th style="text-align:right;">Ingresos</th>
                        <th style="text-align:center;">Participación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var porcentaje = totalIngresos > 0 ? (item.Total / totalIngresos * 100) : 0;
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:12px;">
                                    <div style="width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <i data-lucide="award" style="width:18px;height:18px;color:#fff;"></i>
                                    </div>
                                    <span style="font-weight:800;color:#fff;">@item.PlanNombre</span>
                                </div>
                            </td>
                            <td style="text-align:center;">
                                <span style="display:inline-block;padding:4px 12px;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.2);border-radius:100px;font-size:0.65rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:#7EB8FF;">
                                    @item.CantidadPagos pagos
                                </span>
                            </td>
                            <td style="text-align:right;">
                                <span style="font-size:1.3rem;font-weight:900;color:#10B981;">$@item.Total.ToString("N2")</span>
                            </td>
                            <td style="text-align:center;">
                                <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
                                    <div style="width:80px;height:5px;background:rgba(255,255,255,0.08);border-radius:3px;overflow:hidden;">
                                        <div style="height:100%;width:@porcentaje.ToString("F1")%;background:linear-gradient(90deg,#1E6FE3,#6B3FA0);border-radius:3px;"></div>
                                    </div>
                                    <span style="font-size:0.72rem;font-weight:800;color:rgba(255,255,255,0.5);">@porcentaje.ToString("F1")%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:14px;padding:60px;text-align:center;">
            <i data-lucide="inbox" style="width:56px;height:56px;color:rgba(255,255,255,0.15);margin:0 auto 16px;display:block;"></i>
            <p style="font-family:'Bebas Neue',sans-serif;font-size:1.5rem;letter-spacing:2px;color:rgba(255,255,255,0.5);margin:0 0 8px 0;">No hay pagos en este período</p>
            <p style="font-size:0.85rem;color:rgba(255,255,255,0.3);font-weight:600;margin:0;">Intenta seleccionar un rango de fechas diferente</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ingresosData = @Html.Raw(JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/ingresos-membresias?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            if (!ingresosData || ingresosData.length === 0) return;
            const ctx = document.getElementById('chart-ingresos');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ingresosData.map(i => i.PlanNombre),
                    datasets: [{
                        label: 'Ingresos ($)',
                        data: ingresosData.map(i => i.Total),
                        backgroundColor: ingresosData.map((_, idx) => idx % 2 === 0 ? '#1E6FE3' : '#6B3FA0'),
                        borderRadius: 8, borderSkipped: false
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(5,5,15,0.95)', padding: 12,
                            callbacks: { label: ctx => '$' + ctx.parsed.y.toFixed(2) }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(255,255,255,0.04)' },
                            ticks: { color: 'rgba(255,255,255,0.4)', callback: v => '$' + v }
                        },
                        x: { grid: { display: false }, ticks: { color: 'rgba(255,255,255,0.4)' } }
                    }
                }
            });
        }

        window.addEventListener('load', function() { renderChart(); lucide.createIcons(); });
    </script>
}

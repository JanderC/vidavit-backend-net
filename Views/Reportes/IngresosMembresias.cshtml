@model List<VidaFit.Controllers.WEB.IngresoMembresiaReporte>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ingresos por Membresías";
    ViewData["Subtitle"] = "Análisis de pagos por tipo de plan - VidaFit";

    decimal totalIngresos = 0;
    int totalPagos = 0;

    if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            totalIngresos += item.Total;
            totalPagos += item.CantidadPagos;
        }
    }
}

<style>
    :root {
        --vf-green: #39FF14;
        --vf-dark: #0a0a0a;
        --vf-card: #111111;
        --vf-border: #1f1f1f;
        --vf-text: #e5e5e5;
        --vf-muted: #6b7280;
    }

    .vf-page {
        background: var(--vf-dark);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .vf-card {
        background: var(--vf-card);
        border: 1px solid var(--vf-border);
        border-radius: 1rem;
    }

    .vf-label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        color: var(--vf-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .vf-input {
        background: #1a1a1a;
        border: 2px solid var(--vf-border);
        color: var(--vf-text);
        border-radius: .6rem;
        padding: .75rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s;
        width: 100%;
    }

        .vf-input:focus {
            border-color: var(--vf-green);
        }

    .vf-stat {
        background: var(--vf-card);
        border-radius: .85rem;
        padding: 1.5rem;
        border-left: 4px solid;
    }

    .vf-btn-filter {
        background: var(--vf-green);
        color: #0a0a0a;
        font-weight: 900;
        padding: .8rem 2rem;
        border-radius: .6rem;
        border: none;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: .06em;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: opacity .2s;
        white-space: nowrap;
    }

        .vf-btn-filter:hover {
            opacity: .85;
        }

    .vf-section-title {
        font-size: 1rem;
        font-weight: 900;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .vf-section-title::before {
            content: '';
            display: block;
            width: 3px;
            height: 1rem;
            background: var(--vf-green);
            border-radius: 2px;
            flex-shrink: 0;
        }

    .vf-table {
        width: 100%;
        border-collapse: collapse;
    }

        .vf-table th {
            background: #0f0f0f;
            color: var(--vf-muted);
            font-size: .72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            padding: .9rem 1.5rem;
            border-bottom: 1px solid var(--vf-border);
        }

        .vf-table td {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--vf-border);
            color: var(--vf-text);
        }

        .vf-table tr:hover td {
            background: #161616;
        }

        .vf-table tr:last-child td {
            border-bottom: none;
        }
</style>

<div class="vf-page space-y-6">

    <!-- Header Brand -->
    <div style="display:flex;align-items:center;gap:.75rem;">
        <div style="background:var(--vf-green);padding:.4rem .9rem;border-radius:.5rem;">
            <span style="font-size:1.1rem;font-weight:900;color:#0a0a0a;letter-spacing:.05em;">VIDAFIT</span>
        </div>
        <div>
            <h2 style="font-size:1.5rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.04em;">Ingresos por Membresías</h2>
            <p style="color:var(--vf-muted);font-size:.82rem;">Análisis de pagos por tipo de plan</p>
        </div>
    </div>

    <!-- Filtro fechas -->
    <div class="vf-card p-6">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:1rem;">
            <div style="flex:1;min-width:200px;">
                <label class="vf-label">Fecha Desde</label>
                <input type="date" id="fecha-desde" value="@ViewBag.FechaInicio.ToString("yyyy-MM-dd")" class="vf-input">
            </div>
            <div style="flex:1;min-width:200px;">
                <label class="vf-label">Fecha Hasta</label>
                <input type="date" id="fecha-hasta" value="@ViewBag.FechaFin.ToString("yyyy-MM-dd")" class="vf-input">
            </div>
            <button onclick="filtrarPorFecha()" class="vf-btn-filter">
                <i data-lucide="filter" style="width:1rem;height:1rem;"></i>
                Filtrar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="vf-stat" style="border-left-color:var(--vf-green);">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:.72rem;font-weight:800;color:var(--vf-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.4rem;">Ingresos Totales</p>
                        <p style="font-size:2.25rem;font-weight:900;color:var(--vf-green);">$@totalIngresos.ToString("N2")</p>
                    </div>
                    <div style="width:3.5rem;height:3.5rem;background:#39FF1422;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="dollar-sign" style="width:1.6rem;height:1.6rem;color:var(--vf-green);"></i>
                    </div>
                </div>
            </div>

            <div class="vf-stat" style="border-left-color:#3b82f6;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:.72rem;font-weight:800;color:var(--vf-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.4rem;">Total de Pagos</p>
                        <p style="font-size:2.25rem;font-weight:900;color:#60a5fa;">@totalPagos</p>
                    </div>
                    <div style="width:3.5rem;height:3.5rem;background:#1d4ed822;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="credit-card" style="width:1.6rem;height:1.6rem;color:#60a5fa;"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfica -->
        <div class="vf-card p-8">
            <p class="vf-section-title">Ingresos por Tipo de Plan</p>
            <div style="position:relative;height:400px;">
                <canvas id="chart-ingresos"></canvas>
            </div>
        </div>

        <!-- Tabla -->
        <div class="vf-card" style="overflow:hidden;">
            <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--vf-border);background:#0f0f0f;">
                <p class="vf-section-title" style="margin-bottom:0;">Detalle por Plan</p>
            </div>
            <div style="overflow-x:auto;">
                <table class="vf-table">
                    <thead>
                        <tr>
                            <th style="text-align:left;">Plan</th>
                            <th style="text-align:center;">Cantidad de Pagos</th>
                            <th style="text-align:right;">Ingresos</th>
                            <th style="text-align:center;">Participación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var porcentaje = totalIngresos > 0 ? (item.Total / totalIngresos * 100) : 0;
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:.85rem;">
                                        <div style="width:2.75rem;height:2.75rem;background:#39FF1422;border-radius:.6rem;display:flex;align-items:center;justify-content:center;border:1px solid #39FF1433;flex-shrink:0;">
                                            <i data-lucide="award" style="width:1.25rem;height:1.25rem;color:var(--vf-green);"></i>
                                        </div>
                                        <span style="font-weight:800;color:#fff;font-size:.95rem;">@item.PlanNombre</span>
                                    </div>
                                </td>
                                <td style="text-align:center;">
                                    <span style="display:inline-flex;align-items:center;padding:.3rem .85rem;background:#1d4ed822;color:#60a5fa;border-radius:9999px;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;border:1px solid #1d4ed844;">
                                        @item.CantidadPagos pagos
                                    </span>
                                </td>
                                <td style="text-align:right;">
                                    <span style="font-size:1.35rem;font-weight:900;color:var(--vf-green);">$@item.Total.ToString("N2")</span>
                                </td>
                                <td style="text-align:center;">
                                    <div style="display:flex;align-items:center;justify-content:center;gap:.5rem;">
                                        <div style="width:6rem;background:#1f1f1f;border-radius:9999px;height:.5rem;">
                                            <div style="background:var(--vf-green);height:.5rem;border-radius:9999px;width:@porcentaje.ToString("F1")%;"></div>
                                        </div>
                                        <span style="font-size:.78rem;font-weight:800;color:var(--vf-muted);min-width:2.5rem;">@porcentaje.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="vf-card" style="padding:4rem;text-align:center;">
            <i data-lucide="inbox" style="width:6rem;height:6rem;margin:0 auto 1rem;color:#374151;display:block;"></i>
            <h3 style="font-size:1.25rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.75rem;">No hay pagos en este período</h3>
            <p style="color:var(--vf-muted);font-weight:600;">Intenta seleccionar un rango de fechas diferente</p>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ingresosData = @Html.Raw(JsonSerializer.Serialize(Model));

        function filtrarPorFecha() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            window.location.href = `/reportes/ingresos-membresias?desde=${desde}&hasta=${hasta}`;
        }

        function renderChart() {
            if (ingresosData.length === 0) return;

            const ctx = document.getElementById('chart-ingresos');
            const labels = ingresosData.map(i => i.PlanNombre);
            const totales = ingresosData.map(i => i.Total);

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Ingresos ($)',
                        data: totales,
                        backgroundColor: '#39FF14',
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1a1a1a',
                            borderColor: '#1f1f1f',
                            borderWidth: 1,
                            titleColor: '#e5e5e5',
                            bodyColor: '#39FF14',
                            padding: 12,
                            callbacks: {
                                label: ctx => '$' + ctx.parsed.y.toFixed(2)
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(255,255,255,0.04)' },
                            ticks: {
                                color: '#6b7280',
                                callback: value => '$' + value
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#6b7280' }
                        }
                    }
                }
            });
        }

        window.addEventListener('load', function() {
            renderChart();
            lucide.createIcons();
        });
    </script>
}

@{
    ViewData["Title"] = "Vender Productos";
    Layout = "_AdminLayout";
}

<div class="max-w-6xl mx-auto space-y-6">
    <div class="bg-white rounded-xl shadow-lg p-8">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-800">🛒 Venta de Productos</h2>
            <a href="/ventas-productos" class="text-vida-primary hover:text-vida-dark font-medium">
                <i data-lucide="arrow-left" class="w-5 h-5 inline mr-1"></i>
                Volver a Ventas
            </a>
        </div>

        <!-- Seleccionar Cliente -->
        <div class="mb-6 p-5 bg-gradient-to-r from-blue-50 to-blue-100 rounded-xl border border-blue-200">
            <label class="block text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
                <i data-lucide="user" class="w-4 h-4"></i>
                Seleccionar Cliente *
            </label>
            <div class="relative">
                <select id="clienteSelect" required
                        class="w-full px-4 py-3 pr-10 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-vida-primary bg-white text-gray-800 font-medium appearance-none cursor-pointer">
                    <option value="">🔍 Buscar y seleccionar cliente...</option>
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                    <i data-lucide="chevron-down" class="w-5 h-5 text-gray-400"></i>
                </div>
            </div>
            <div id="clienteInfo" class="mt-4 hidden">
                <div class="flex items-center gap-4 p-4 bg-white rounded-lg shadow-sm border border-blue-200">
                    <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center">
                        <i data-lucide="user-check" class="w-7 h-7 text-white"></i>
                    </div>
                    <div class="flex-1">
                        <p class="font-bold text-lg text-gray-800" id="clienteNombre"></p>
                        <p class="text-sm text-gray-600" id="clienteCedula"></p>
                        <p class="text-xs text-gray-500 mt-1" id="clienteEmail"></p>
                    </div>
                    <button onclick="cambiarCliente()" class="px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 rounded-lg transition">
                        Cambiar
                    </button>
                </div>
            </div>
        </div>

        <!-- Agregar Producto con Select Buscador -->
        <div class="mb-6 p-5 bg-gradient-to-r from-green-50 to-green-100 rounded-xl border border-green-200">
            <label class="block text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
                <i data-lucide="package-plus" class="w-4 h-4"></i>
                Agregar Producto
            </label>

            <!-- Select con Buscador -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div class="md:col-span-2">
                    <div class="relative">
                        <input type="text" id="buscarProductoInput" placeholder="🔍 Buscar producto por nombre o categoría..."
                               class="w-full px-4 py-3 pr-10 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-vida-primary">
                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                            <i data-lucide="search" class="w-5 h-5 text-gray-400"></i>
                        </div>
                    </div>

                    <!-- Dropdown de resultados -->
                    <div id="productosDropdown" class="hidden absolute z-10 mt-2 w-full max-w-2xl bg-white border-2 border-gray-300 rounded-lg shadow-xl max-h-80 overflow-y-auto">
                        <!-- Productos filtrados aparecen aquí -->
                    </div>
                </div>

                <div>
                    <input type="number" id="cantidadAgregar" value="1" min="1" placeholder="Cantidad"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary text-center font-bold">
                </div>
            </div>

            <!-- Producto seleccionado (preview) -->
            <div id="productoPreview" class="hidden mt-4 p-4 bg-white rounded-lg border border-green-300">
                <div class="flex items-center gap-4">
                    <div id="previewImagen" class="w-16 h-16 bg-gray-200 rounded-lg flex items-center justify-center overflow-hidden">
                        <i data-lucide="package" class="w-8 h-8 text-gray-400"></i>
                    </div>
                    <div class="flex-1">
                        <p class="font-bold text-gray-800" id="previewNombre"></p>
                        <p class="text-sm text-gray-600">Precio: $<span id="previewPrecio">0.00</span></p>
                        <p class="text-xs text-gray-500">Stock disponible: <span id="previewStock">0</span></p>
                    </div>
                    <button onclick="agregarProductoSeleccionado()"
                            class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg transition flex items-center gap-2">
                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                        Agregar
                    </button>
                </div>
            </div>
        </div>

        <!-- Carrito de Compra -->
        <div class="mb-6 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                    Carrito de Compra
                </h3>
                <span id="contadorItems" class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-bold">
                    0 items
                </span>
            </div>

            <div id="carritoItems" class="space-y-2 mb-4">
                <div class="text-center py-12">
                    <i data-lucide="shopping-bag" class="w-16 h-16 text-gray-300 mx-auto mb-3"></i>
                    <p class="text-gray-400 font-medium">No hay productos en el carrito</p>
                    <p class="text-sm text-gray-400 mt-1">Busca y agrega productos arriba</p>
                </div>
            </div>

            <!-- Total -->
            <div class="border-t-2 border-gray-300 pt-4 mt-4">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-lg font-semibold text-gray-700">Subtotal:</span>
                    <span id="subtotalCarrito" class="text-lg font-bold text-gray-800">$0.00</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-2xl font-bold text-gray-800">Total:</span>
                    <span id="totalCarrito" class="text-3xl font-bold text-vida-dark">$0.00</span>
                </div>
            </div>
        </div>

        <!-- Opciones de Pago -->
        <div class="mb-6 p-5 bg-gradient-to-r from-yellow-50 to-yellow-100 rounded-xl border border-yellow-200">
            <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                <i data-lucide="credit-card" class="w-5 h-5"></i>
                Método de Pago
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <label class="flex items-center p-4 border-3 border-green-300 bg-white rounded-lg cursor-pointer hover:border-green-500 hover:shadow-md transition">
                    <input type="radio" name="estadoPago" value="pagado" checked
                           class="mr-4 w-5 h-5 text-green-600 focus:ring-2 focus:ring-green-500">
                    <div class="flex items-center gap-3 flex-1">
                        <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                            <i data-lucide="check-circle" class="w-6 h-6 text-green-600"></i>
                        </div>
                        <div>
                            <p class="font-bold text-gray-800">💵 Contado (Pagado)</p>
                            <p class="text-sm text-gray-600">Pago inmediato en efectivo/tarjeta</p>
                        </div>
                    </div>
                </label>
                <label class="flex items-center p-4 border-3 border-orange-300 bg-white rounded-lg cursor-pointer hover:border-orange-500 hover:shadow-md transition">
                    <input type="radio" name="estadoPago" value="pendiente"
                           class="mr-4 w-5 h-5 text-orange-500 focus:ring-2 focus:ring-orange-500">
                    <div class="flex items-center gap-3 flex-1">
                        <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center">
                            <i data-lucide="clock" class="w-6 h-6 text-orange-500"></i>
                        </div>
                        <div>
                            <p class="font-bold text-gray-800">📋 Fiado (Crédito)</p>
                            <p class="text-sm text-gray-600">Pago pendiente (a cuenta)</p>
                        </div>
                    </div>
                </label>
            </div>

            <!-- Notas -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">
                    <i data-lucide="sticky-note" class="w-4 h-4"></i>
                    Notas / Observaciones
                </label>
                <textarea id="notasVenta" rows="2" placeholder="Ej: Cliente solicita entrega a domicilio, producto con descuento especial, etc."
                          class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary resize-none"></textarea>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="flex flex-col md:flex-row gap-3">
            <button type="button" id="btnRegistrarVenta"
                    class="flex-1 bg-gradient-to-r from-green-600 to-green-700 text-white font-bold py-4 px-8 rounded-xl hover:from-green-700 hover:to-green-800 transition shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                <i data-lucide="check-circle" class="w-6 h-6"></i>
                <span>Registrar Venta</span>
            </button>
            <button type="button" id="btnLimpiar"
                    class="px-8 py-4 bg-gray-200 text-gray-700 font-bold rounded-xl hover:bg-gray-300 transition flex items-center justify-center gap-2">
                <i data-lucide="x-circle" class="w-5 h-5"></i>
                <span>Limpiar Todo</span>
            </button>
            <a href="/ventas-productos"
               class="px-8 py-4 bg-red-100 text-red-700 font-bold rounded-xl hover:bg-red-200 transition text-center flex items-center justify-center gap-2">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
                <span>Cancelar</span>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let productos = [];
        let clientes = [];
        let carrito = [];
        let clienteSeleccionado = null;
        let productoSeleccionado = null;

        // Cargar datos iniciales
        async function cargarDatos() {
            try {
                // Cargar clientes - USAR PROPIEDADES EN PASCALCASE
                const clientesRes = await fetch('/api/Clientes');
                clientes = await clientesRes.json();
                console.log('Clientes cargados:', clientes);

                const clienteSelect = document.getElementById('clienteSelect');
                clienteSelect.innerHTML = '<option value="">🔍 Buscar y seleccionar cliente...</option>';

                clientes.forEach(c => {
                    const option = document.createElement('option');
                    option.value = c.Id;  // PASCALCASE
                    option.textContent = `${c.Nombre} ${c.Apellido} - CI: ${c.Cedula}`;  // PASCALCASE
                    if (c.Email) {
                        option.textContent += ` | ${c.Email}`;
                    }
                    clienteSelect.appendChild(option);
                });

                // Cargar productos - USAR PROPIEDADES EN PASCALCASE
                const productosRes = await fetch('/api/Productos');
                productos = await productosRes.json();
                console.log('Productos cargados:', productos);

                // Filtrar solo productos activos con stock
                productos = productos.filter(p => p.Activo && p.Stock > 0);  // PASCALCASE

            } catch (error) {
                console.error('Error cargando datos:', error);
                alert('Error al cargar datos: ' + error.message);
            }
        }

        // Seleccionar cliente
        document.getElementById('clienteSelect').addEventListener('change', function() {
            const clienteId = this.value;
            if (clienteId) {
                clienteSeleccionado = clientes.find(c => c.Id === clienteId);  // PASCALCASE
                if (clienteSeleccionado) {
                    document.getElementById('clienteNombre').textContent =
                        `${clienteSeleccionado.Nombre} ${clienteSeleccionado.Apellido}`;  // PASCALCASE
                    document.getElementById('clienteCedula').textContent =
                        `Cédula: ${clienteSeleccionado.Cedula}`;  // PASCALCASE
                    document.getElementById('clienteEmail').textContent =
                        clienteSeleccionado.Email ? `📧 ${clienteSeleccionado.Email}` : 'Sin email registrado';  // PASCALCASE
                    document.getElementById('clienteInfo').classList.remove('hidden');
                    lucide.createIcons();
                }
            } else {
                clienteSeleccionado = null;
                document.getElementById('clienteInfo').classList.add('hidden');
            }
        });

        // Cambiar cliente
        function cambiarCliente() {
            clienteSeleccionado = null;
            document.getElementById('clienteSelect').value = '';
            document.getElementById('clienteInfo').classList.add('hidden');
        }

        // Buscar productos con dropdown
        const buscarInput = document.getElementById('buscarProductoInput');
        const dropdown = document.getElementById('productosDropdown');

        buscarInput.addEventListener('focus', () => {
            if (buscarInput.value.trim() === '') {
                mostrarTodosProductos();
            }
        });

        buscarInput.addEventListener('input', function(e) {
            const busqueda = e.target.value.toLowerCase().trim();

            if (busqueda === '') {
                mostrarTodosProductos();
                return;
            }

            const productosFiltrados = productos.filter(p =>
                p.Nombre.toLowerCase().includes(busqueda) ||  // PASCALCASE
                (p.Categoria && p.Categoria.toLowerCase().includes(busqueda)) ||  // PASCALCASE
                (p.Descripcion && p.Descripcion.toLowerCase().includes(busqueda))  // PASCALCASE
            );

            mostrarProductosEnDropdown(productosFiltrados);
        });

        function mostrarTodosProductos() {
            mostrarProductosEnDropdown(productos);
        }

        function mostrarProductosEnDropdown(lista) {
            if (lista.length === 0) {
                dropdown.innerHTML = '<div class="p-4 text-center text-gray-500">No se encontraron productos</div>';
                dropdown.classList.remove('hidden');
                return;
            }

            dropdown.innerHTML = '';
            lista.slice(0, 10).forEach(p => {  // Mostrar máximo 10 resultados
                const div = document.createElement('div');
                div.className = 'flex items-center gap-3 p-3 hover:bg-gray-100 cursor-pointer border-b border-gray-200';
                div.onclick = () => seleccionarProducto(p);

                div.innerHTML = `
                    <div class="w-14 h-14 bg-gray-200 rounded-lg flex items-center justify-center overflow-hidden flex-shrink-0">
                        ${p.ImagenBase64  // PASCALCASE
                            ? `<img src="data:image/jpeg;base64,${p.ImagenBase64}" class="w-full h-full object-cover" alt="${p.Nombre}">`
                            : `<i data-lucide="package" class="w-6 h-6 text-gray-400"></i>`
                        }
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-bold text-gray-800 truncate">${p.Nombre}</p>
                        <p class="text-sm text-gray-600">$${p.Precio.toFixed(2)}</p>
                        <p class="text-xs text-gray-500">Stock: ${p.Stock} ${p.Categoria ? '| ' + p.Categoria : ''}</p>
                    </div>
                    <div class="flex-shrink-0">
                        <i data-lucide="chevron-right" class="w-5 h-5 text-gray-400"></i>
                    </div>
                `;
                dropdown.appendChild(div);
            });

            dropdown.classList.remove('hidden');
            lucide.createIcons();
        }

        // Cerrar dropdown al hacer click fuera
        document.addEventListener('click', function(e) {
            if (!buscarInput.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });

        // Seleccionar producto
        function seleccionarProducto(producto) {
            productoSeleccionado = producto;
            buscarInput.value = producto.Nombre;  // PASCALCASE
            dropdown.classList.add('hidden');

            // Mostrar preview
            const preview = document.getElementById('productoPreview');
            document.getElementById('previewNombre').textContent = producto.Nombre;  // PASCALCASE
            document.getElementById('previewPrecio').textContent = producto.Precio.toFixed(2);  // PASCALCASE
            document.getElementById('previewStock').textContent = producto.Stock;  // PASCALCASE

            const previewImg = document.getElementById('previewImagen');
            if (producto.ImagenBase64) {  // PASCALCASE
                previewImg.innerHTML = `<img src="data:image/jpeg;base64,${producto.ImagenBase64}" class="w-full h-full object-cover">`;
            } else {
                previewImg.innerHTML = '<i data-lucide="package" class="w-8 h-8 text-gray-400"></i>';
            }

            preview.classList.remove('hidden');
            lucide.createIcons();

            // Focus en cantidad
            document.getElementById('cantidadAgregar').focus();
            document.getElementById('cantidadAgregar').select();
        }

        // Agregar producto seleccionado al carrito
        function agregarProductoSeleccionado() {
            if (!productoSeleccionado) {
                alert('Seleccione un producto primero');
                return;
            }

            const cantidad = parseInt(document.getElementById('cantidadAgregar').value);
            if (cantidad <= 0) {
                alert('La cantidad debe ser mayor a 0');
                return;
            }

            if (cantidad > productoSeleccionado.Stock) {  // PASCALCASE
                alert(`Stock insuficiente. Disponible: ${productoSeleccionado.Stock}`);
                return;
            }

            // Verificar si ya está en el carrito
            const itemExistente = carrito.find(i => i.producto.Id === productoSeleccionado.Id);  // PASCALCASE

            if (itemExistente) {
                const nuevaCantidad = itemExistente.cantidad + cantidad;
                if (nuevaCantidad > productoSeleccionado.Stock) {  // PASCALCASE
                    alert(`Stock insuficiente. Ya tiene ${itemExistente.cantidad} en el carrito. Disponible: ${productoSeleccionado.Stock}`);
                    return;
                }
                itemExistente.cantidad = nuevaCantidad;
                itemExistente.total = itemExistente.cantidad * itemExistente.precioUnitario;
            } else {
                carrito.push({
                    producto: productoSeleccionado,
                    cantidad: cantidad,
                    precioUnitario: productoSeleccionado.Precio,  // PASCALCASE
                    total: productoSeleccionado.Precio * cantidad  // PASCALCASE
                });
            }

            renderCarrito();

            // Limpiar selección
            productoSeleccionado = null;
            buscarInput.value = '';
            document.getElementById('cantidadAgregar').value = '1';
            document.getElementById('productoPreview').classList.add('hidden');
            buscarInput.focus();
        }

        // Enter en el input de búsqueda
        buscarInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && productoSeleccionado) {
                agregarProductoSeleccionado();
            }
        });

        // Enter en cantidad
        document.getElementById('cantidadAgregar').addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && productoSeleccionado) {
                agregarProductoSeleccionado();
            }
        });

        // Eliminar del carrito
        function eliminarDelCarrito(productoId) {
            carrito = carrito.filter(i => i.producto.Id !== productoId);  // PASCALCASE
            renderCarrito();
        }

        // Cambiar cantidad en el carrito
        function cambiarCantidad(productoId, nuevaCantidad) {
            const item = carrito.find(i => i.producto.Id === productoId);  // PASCALCASE
            if (item && nuevaCantidad > 0 && nuevaCantidad <= item.producto.Stock) {  // PASCALCASE
                item.cantidad = nuevaCantidad;
                item.total = item.cantidad * item.precioUnitario;
                renderCarrito();
            } else if (nuevaCantidad > item.producto.Stock) {  // PASCALCASE
                alert(`Stock insuficiente. Disponible: ${item.producto.Stock}`);
            }
        }

        // Renderizar carrito
        function renderCarrito() {
            const container = document.getElementById('carritoItems');
            const contador = document.getElementById('contadorItems');

            if (carrito.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12">
                        <i data-lucide="shopping-bag" class="w-16 h-16 text-gray-300 mx-auto mb-3"></i>
                        <p class="text-gray-400 font-medium">No hay productos en el carrito</p>
                        <p class="text-sm text-gray-400 mt-1">Busca y agrega productos arriba</p>
                    </div>
                `;
                document.getElementById('subtotalCarrito').textContent = '$0.00';
                document.getElementById('totalCarrito').textContent = '$0.00';
                contador.textContent = '0 items';
                lucide.createIcons();
                return;
            }

            container.innerHTML = '';
            let total = 0;
            let totalItems = 0;

            carrito.forEach(item => {
                total += item.total;
                totalItems += item.cantidad;

                const div = document.createElement('div');
                div.className = 'flex items-center gap-3 p-4 bg-white rounded-lg border border-gray-200 hover:shadow-md transition';
                div.innerHTML = `
                    <div class="w-16 h-16 bg-gray-200 rounded-lg flex items-center justify-center overflow-hidden flex-shrink-0">
                        ${item.producto.ImagenBase64  // PASCALCASE
                            ? `<img src="data:image/jpeg;base64,${item.producto.ImagenBase64}" class="w-full h-full object-cover">`
                            : `<i data-lucide="package" class="w-8 h-8 text-gray-400"></i>`
                        }
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-bold text-gray-800">${item.producto.Nombre}</p>
                        <p class="text-sm text-gray-600">$${item.precioUnitario.toFixed(2)} c/u</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="cambiarCantidad('${item.producto.Id}', ${item.cantidad - 1})"
                                class="w-8 h-8 bg-red-100 text-red-600 rounded hover:bg-red-200 font-bold flex items-center justify-center">−</button>
                        <span class="w-12 text-center font-bold text-lg">${item.cantidad}</span>
                        <button onclick="cambiarCantidad('${item.producto.Id}', ${item.cantidad + 1})"
                                class="w-8 h-8 bg-green-100 text-green-600 rounded hover:bg-green-200 font-bold flex items-center justify-center">+</button>
                    </div>
                    <div class="w-24 text-right">
                        <p class="font-bold text-lg text-vida-dark">$${item.total.toFixed(2)}</p>
                    </div>
                    <button onclick="eliminarDelCarrito('${item.producto.Id}')"
                            class="ml-2 p-2 text-red-600 hover:bg-red-50 rounded-lg transition">
                        <i data-lucide="trash-2" class="w-5 h-5"></i>
                    </button>
                `;
                container.appendChild(div);
            });

            document.getElementById('subtotalCarrito').textContent = `$${total.toFixed(2)}`;
            document.getElementById('totalCarrito').textContent = `$${total.toFixed(2)}`;
            contador.textContent = `${totalItems} item${totalItems !== 1 ? 's' : ''}`;
            lucide.createIcons();
        }

        // Registrar venta
        document.getElementById('btnRegistrarVenta').addEventListener('click', async function() {
            if (!clienteSeleccionado) {
                alert('⚠️ Debe seleccionar un cliente');
                return;
            }

            if (carrito.length === 0) {
                alert('⚠️ Debe agregar al menos un producto al carrito');
                return;
            }

            const estadoPago = document.querySelector('input[name="estadoPago"]:checked').value;
            const notas = document.getElementById('notasVenta').value;

            const confirmar = confirm(
                `¿Confirmar venta?\n\n` +
                `Cliente: ${clienteSeleccionado.Nombre} ${clienteSeleccionado.Apellido}\n` +  // PASCALCASE
                `Productos: ${carrito.length}\n` +
                `Total: $${carrito.reduce((sum, i) => sum + i.total, 0).toFixed(2)}\n` +
                `Estado: ${estadoPago === 'pagado' ? 'PAGADO' : 'FIADO (Pendiente)'}`
            );

            if (!confirmar) return;

            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader" class="w-5 h-5 inline mr-2 animate-spin"></i> Procesando...';

            try {
                // Registrar cada producto como una venta
                for (const item of carrito) {
                    const venta = {
                        clienteId: clienteSeleccionado.Id,  // PASCALCASE
                        productoId: item.producto.Id,  // PASCALCASE
                        cantidad: item.cantidad,
                        precioUnitario: item.precioUnitario,
                        total: item.total,
                        estadoPago: estadoPago,
                        notas: notas
                    };

                    const response = await fetch('/api/VentasProductos', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(venta)
                    });

                    if (!response.ok) {
                        const error = await response.text();
                        throw new Error(error);
                    }
                }

                alert(`✅ Venta registrada exitosamente como ${estadoPago === 'pagado' ? 'PAGADA' : 'FIADA (Pendiente)'}`);
                limpiar();
                await cargarDatos();

                // Opcional: redireccionar a la lista de ventas
                // window.location.href = '/ventas-productos';

            } catch (error) {
                console.error('Error:', error);
                alert('❌ Error al registrar venta: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="check-circle" class="w-6 h-6 inline mr-2"></i>Registrar Venta';
                lucide.createIcons();
            }
        });

        // Limpiar formulario
        document.getElementById('btnLimpiar').addEventListener('click', function() {
            if (carrito.length > 0) {
                const confirmar = confirm('¿Está seguro de limpiar todo? Se perderá el carrito actual.');
                if (!confirmar) return;
            }
            limpiar();
        });

        function limpiar() {
            carrito = [];
            clienteSeleccionado = null;
            productoSeleccionado = null;
            document.getElementById('clienteSelect').value = '';
            document.getElementById('clienteInfo').classList.add('hidden');
            document.getElementById('notasVenta').value = '';
            buscarInput.value = '';
            document.getElementById('cantidadAgregar').value = '1';
            document.getElementById('productoPreview').classList.add('hidden');
            dropdown.classList.add('hidden');
            renderCarrito();
        }

        // Exponer funciones globalmente
        window.cambiarCantidad = cambiarCantidad;
        window.eliminarDelCarrito = eliminarDelCarrito;
        window.agregarProductoSeleccionado = agregarProductoSeleccionado;
        window.cambiarCliente = cambiarCliente;

        // Inicializar
        cargarDatos();
        lucide.createIcons();
    </script>
}

@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Eliminar Producto";
}

<div style="max-width:640px;margin:0 auto;">
    <div style="background:#0D0D20;border:1px solid rgba(248,113,113,0.2);border-radius:16px;overflow:hidden;">

        <!-- Header -->
        <div style="background:linear-gradient(135deg,#7C1D1D,#991B1B);padding:24px 28px;display:flex;align-items:center;gap:16px;">
            <div style="width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i data-lucide="alert-triangle" style="width:26px;height:26px;color:#fff;"></i>
            </div>
            <div>
                <h2 style="font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:3px;color:#fff;margin:0;line-height:1;">Eliminar Producto</h2>
                <p style="font-size:0.78rem;color:rgba(255,255,255,0.6);font-weight:600;margin:4px 0 0 0;">Esta acción no se puede deshacer</p>
            </div>
        </div>

        <div style="padding:24px 28px;display:flex;flex-direction:column;gap:18px;">
            <!-- Warning -->
            <div style="padding:14px 18px;background:rgba(248,113,113,0.06);border:1px solid rgba(248,113,113,0.2);border-radius:12px;">
                <p style="font-size:0.9rem;font-weight:700;color:#F87171;margin:0 0 4px 0;">¿Estás seguro de que deseas eliminar este producto?</p>
                <p style="font-size:0.8rem;color:rgba(248,113,113,0.7);font-weight:600;margin:0;">Toda la información será eliminada permanentemente.</p>
            </div>

            <!-- Fields -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:14px 16px;">
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 5px 0;">Nombre</p>
                    <p style="font-weight:800;color:#fff;font-size:0.95rem;margin:0;">@Model.Nombre</p>
                </div>
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:14px 16px;">
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 5px 0;">Categoría</p>
                    <p style="font-weight:800;color:#fff;font-size:0.95rem;margin:0;">@(string.IsNullOrEmpty(Model.Categoria) ? "Sin categoría" : Model.Categoria)</p>
                </div>
                <div style="background:rgba(16,185,129,0.04);border:1px solid rgba(16,185,129,0.15);border-radius:10px;padding:14px 16px;">
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(16,185,129,0.5);margin:0 0 5px 0;">Precio</p>
                    <p style="font-weight:900;color:#10B981;font-size:1.1rem;margin:0;">$@Model.Precio.ToString("N2")</p>
                </div>
                <div style="background:rgba(30,111,227,0.04);border:1px solid rgba(30,111,227,0.15);border-radius:10px;padding:14px 16px;">
                    <p style="font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(30,111,227,0.5);margin:0 0 5px 0;">Stock</p>
                    <p style="font-weight:900;color:#3D8EFF;font-size:1.1rem;margin:0;">@Model.Stock</p>
                </div>
            </div>

            <!-- Buttons -->
            <form method="post" action="/productos/eliminar/@Model.Id" style="display:flex;gap:12px;padding-top:8px;">
                @Html.AntiForgeryToken()
                <button type="submit"
                        onclick="return confirm('¿Estás completamente seguro? Esta acción no se puede deshacer.')"
                        style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;background:linear-gradient(135deg,#B91C1C,#991B1B);color:#fff;font-weight:800;font-size:0.82rem;letter-spacing:1.5px;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer;transition:opacity .2s;"
                        onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
                    <i data-lucide="trash-2" style="width:16px;height:16px;"></i>
                    Confirmar Eliminación
                </button>
                <a href="/productos"
                   style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.5);font-weight:800;font-size:0.82rem;letter-spacing:1.5px;text-transform:uppercase;border:1px solid rgba(255,255,255,0.08);border-radius:12px;text-decoration:none;transition:all .15s;"
                   onmouseover="this.style.background='rgba(255,255,255,0.08)';this.style.color='rgba(255,255,255,0.8)'" onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.color='rgba(255,255,255,0.5)'">
                    <i data-lucide="x" style="width:16px;height:16px;"></i>
                    Cancelar
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}

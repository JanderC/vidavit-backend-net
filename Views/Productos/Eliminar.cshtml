@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Eliminar Producto";
}

<div style="max-width:40rem;margin:0 auto;">
    <div style="background:#0D1526;border:1px solid rgba(239,68,68,.3);border-radius:1.25rem;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.5);">

        <!-- Header rojo -->
        <div style="background:linear-gradient(135deg,#7F1D1D,#991B1B);padding:2rem;">
            <div style="display:flex;align-items:center;gap:1rem;">
                <div style="width:56px;height:56px;background:rgba(255,255,255,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i data-lucide="alert-triangle" style="width:28px;height:28px;color:#F87171;"></i>
                </div>
                <div>
                    <h2 style="font-size:1.4rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.06em;margin:0 0 .2rem 0;">Eliminar Producto</h2>
                    <p style="color:rgba(255,255,255,.7);font-weight:700;font-size:.85rem;margin:0;">Esta acción no se puede deshacer</p>
                </div>
            </div>
        </div>

        <div style="padding:2rem;">
            <div style="background:rgba(239,68,68,.07);border:1px solid rgba(239,68,68,.25);border-radius:.875rem;padding:1.1rem 1.25rem;margin-bottom:1.5rem;">
                <p style="font-size:.95rem;color:#F87171;font-weight:700;margin:0 0 .25rem 0;">¿Estás seguro de que deseas eliminar este producto?</p>
                <p style="font-size:.8rem;color:rgba(248,113,113,.7);font-weight:600;margin:0;">Toda la información será eliminada permanentemente.</p>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:.875rem;margin-bottom:2rem;">
                <div style="background:rgba(255,255,255,.03);border:1px solid #1E2D4A;border-radius:.75rem;padding:1rem;">
                    <p style="font-size:.68rem;font-weight:800;color:#64748B;text-transform:uppercase;letter-spacing:.12em;margin:0 0 .25rem 0;">Nombre</p>
                    <p style="font-weight:800;color:#E2E8F0;font-size:1rem;margin:0;">@Model.Nombre</p>
                </div>
                <div style="background:rgba(255,255,255,.03);border:1px solid #1E2D4A;border-radius:.75rem;padding:1rem;">
                    <p style="font-size:.68rem;font-weight:800;color:#64748B;text-transform:uppercase;letter-spacing:.12em;margin:0 0 .25rem 0;">Categoría</p>
                    <p style="font-weight:800;color:#E2E8F0;font-size:1rem;margin:0;">@(string.IsNullOrEmpty(Model.Categoria)?"Sin categoría":Model.Categoria)</p>
                </div>
                <div style="background:rgba(255,255,255,.03);border:1px solid #1E2D4A;border-radius:.75rem;padding:1rem;">
                    <p style="font-size:.68rem;font-weight:800;color:#64748B;text-transform:uppercase;letter-spacing:.12em;margin:0 0 .25rem 0;">Precio</p>
                    <p style="font-weight:900;color:#10B981;font-size:1rem;margin:0;">$@Model.Precio.ToString("N2")</p>
                </div>
                <div style="background:rgba(255,255,255,.03);border:1px solid #1E2D4A;border-radius:.75rem;padding:1rem;">
                    <p style="font-size:.68rem;font-weight:800;color:#64748B;text-transform:uppercase;letter-spacing:.12em;margin:0 0 .25rem 0;">Stock</p>
                    <p style="font-weight:900;color:#60A5FA;font-size:1rem;margin:0;">@Model.Stock</p>
                </div>
            </div>

            <form method="post" action="/productos/eliminar/@Model.Id" style="display:flex;gap:1rem;">
                @Html.AntiForgeryToken()
                <button type="submit"
                        style="flex:1;background:linear-gradient(135deg,#DC2626,#991B1B);color:#fff;font-weight:800;padding:1rem;border:none;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;box-shadow:0 4px 16px rgba(220,38,38,.3);display:flex;align-items:center;justify-content:center;gap:.5rem;transition:transform .2s;"
                        onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'"
                        onclick="return confirm('¿Estás completamente seguro? Esta acción no se puede deshacer.')">
                    <i data-lucide="trash-2" style="width:16px;height:16px;"></i> Confirmar Eliminación
                </button>
                <a href="/productos"
                   style="flex:1;background:rgba(255,255,255,.05);border:1px solid #1E2D4A;color:#94A3B8;font-weight:800;padding:1rem;border-radius:.875rem;text-align:center;text-decoration:none;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;display:flex;align-items:center;justify-content:center;gap:.5rem;transition:background .2s;"
                   onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">
                    <i data-lucide="x" style="width:16px;height:16px;"></i> Cancelar
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts { <script>lucide.createIcons();</script> }

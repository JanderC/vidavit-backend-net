@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Eliminar Producto";
}

<style>
    :root {
        --pz-dark: #0f1535;
        --pz-card: #111827;
        --pz-border: #1f2a4a;
        --pz-text: #e5e5e5;
        --pz-muted: #6b7280;
    }

    .pz-page {
        background: var(--pz-dark);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .pz-card {
        background: var(--pz-card);
        border: 1px solid var(--pz-border);
        border-radius: 1rem;
        overflow: hidden;
    }

    .pz-info-box {
        background: #1a2050;
        border: 1px solid var(--pz-border);
        border-radius: .75rem;
        padding: 1.5rem;
    }

    .pz-info-label {
        font-size: .75rem;
        font-weight: 800;
        color: var(--pz-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .pz-info-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--pz-text);
    }

    .pz-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .9rem 1.5rem;
        border-radius: .6rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        text-decoration: none;
        transition: opacity .2s;
        flex: 1;
        cursor: pointer;
        border: none;
    }

        .pz-btn:hover {
            opacity: .85;
        }

    .pz-btn-danger {
        background: #dc2626;
        color: #fff;
    }

    .pz-btn-gray {
        background: #1f2a4a;
        color: var(--pz-text);
        border: 1px solid var(--pz-border) !important;
    }
</style>

<div class="pz-page">
    <div class="max-w-3xl mx-auto">
        <div class="pz-card">
            <!-- Header de peligro -->
            <div style="background:linear-gradient(135deg,#1a0000 0%,#2d0000 100%);border-bottom:2px solid #dc2626;padding:2rem;">
                <div style="display:flex;align-items:center;gap:1rem;">
                    <div style="width:4rem;height:4rem;background:rgba(220,38,38,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid rgba(220,38,38,.4);">
                        <i data-lucide="alert-triangle" style="width:2rem;height:2rem;color:#f87171;display:block;"></i>
                    </div>
                    <div>
                        <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.25rem;">
                            <h2 style="font-size:1.6rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.05em;">Eliminar Producto</h2>
                            <span style="background:linear-gradient(135deg,#0f1535,#1a2050);color:#D4A017;font-size:.65rem;font-weight:900;padding:.15rem .55rem;border-radius:9999px;letter-spacing:.1em;border:1px solid #D4A017;">POWERZONE</span>
                        </div>
                        <p style="color:#f87171;font-weight:600;">Esta acción no se puede deshacer</p>
                    </div>
                </div>
            </div>

            <div style="padding:2rem;">
                <!-- Alerta -->
                <div style="background:rgba(220,38,38,.1);border:1px solid rgba(220,38,38,.4);border-radius:.75rem;padding:1.25rem;margin-bottom:1.5rem;">
                    <p style="color:#f87171;font-weight:700;font-size:1rem;margin-bottom:.25rem;">¿Estás seguro de que deseas eliminar este producto?</p>
                    <p style="color:#fca5a5;font-weight:500;font-size:.875rem;">Toda la información será eliminada permanentemente.</p>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-8">
                    <div class="pz-info-box">
                        <p class="pz-info-label">Nombre</p>
                        <p class="pz-info-value">@Model.Nombre</p>
                    </div>
                    <div class="pz-info-box">
                        <p class="pz-info-label">Categoría</p>
                        <p class="pz-info-value">@(string.IsNullOrEmpty(Model.Categoria) ? "Sin categoría" : Model.Categoria)</p>
                    </div>
                    <div class="pz-info-box" style="border-left:3px solid #D4A017;">
                        <p class="pz-info-label" style="color:#D4A017;">Precio</p>
                        <p style="font-size:1.25rem;font-weight:800;color:#D4A017;">$@Model.Precio.ToString("N2")</p>
                    </div>
                    <div class="pz-info-box" style="border-left:3px solid #2B4FD8;">
                        <p class="pz-info-label" style="color:#7094f0;">Stock</p>
                        <p style="font-size:1.25rem;font-weight:800;color:#2B4FD8;">@Model.Stock</p>
                    </div>
                </div>

                <form method="post" action="/productos/eliminar/@Model.Id" style="display:flex;gap:1rem;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pz-btn pz-btn-danger"
                            onclick="return confirm('¿Estás completamente seguro? Esta acción no se puede deshacer.')">
                        <i data-lucide="trash-2" style="width:1.25rem;height:1.25rem;"></i>
                        Confirmar Eliminación
                    </button>
                    <a href="/productos" class="pz-btn pz-btn-gray">
                        <i data-lucide="x" style="width:1.25rem;height:1.25rem;"></i>
                        Cancelar
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Eliminar Producto";
}

<div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-blue-300">
        <div class="bg-gradient-to-r from-blue-600 to-blue-800 p-8">
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center">
                    <i data-lucide="alert-triangle" class="w-8 h-8 text-white"></i>
                </div>
                <div>
                    <h2 class="text-3xl font-black text-white uppercase tracking-wide">Eliminar Producto</h2>
                    <p class="text-white opacity-90 font-bold mt-1">Esta acción no se puede deshacer</p>
                </div>
            </div>
        </div>

        <div class="p-8">
            <div class="bg-blue-50 border-2 border-blue-300 rounded-xl p-6 mb-6">
                <p class="text-lg text-blue-900 font-bold mb-2">¿Estás seguro de que deseas eliminar este producto?</p>
                <p class="text-blue-700 font-semibold">Toda la información será eliminada permanentemente.</p>
            </div>

            <div class="grid grid-cols-2 gap-6 mb-8">
                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <p class="text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Nombre</p>
                    <p class="text-xl font-bold text-gray-900">@Model.Nombre</p>
                </div>

                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <p class="text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Categoría</p>
                    <p class="text-xl font-bold text-gray-900">@(string.IsNullOrEmpty(Model.Categoria) ? "Sin categoría" : Model.Categoria)</p>
                </div>

                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <p class="text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Precio</p>
                    <p class="text-xl font-bold text-emerald-600">$@Model.Precio.ToString("N2")</p>
                </div>

                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <p class="text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Stock</p>
                    <p class="text-xl font-bold text-blue-600">@Model.Stock</p>
                </div>
            </div>

            <form method="post" action="/productos/eliminar/@Model.Id" class="flex gap-4">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-black py-4 px-6 rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide flex items-center justify-center gap-2"
                        onclick="return confirm('¿Estás completamente seguro? Esta acción no se puede deshacer.')">
                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                    Confirmar Eliminación
                </button>

                <a href="/productos"
                   class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 font-black py-4 px-6 rounded-xl transition-all text-center uppercase tracking-wide flex items-center justify-center gap-2">
                    <i data-lucide="x" class="w-5 h-5"></i>
                    Cancelar
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}

@{
    ViewData["Title"] = "Cuentas Pendientes";
}

<div class="max-w-7xl mx-auto p-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-3xl font-bold text-gray-800">Productos Fiados - Cuentas Pendientes</h2>
        <a href="/productos"
           class="bg-gray-300 text-gray-700 font-bold py-2 px-6 rounded-lg hover:bg-gray-400 transition">
            Volver
        </a>
    </div>

    <!-- Resumen -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white rounded-xl shadow-md p-6">
            <p class="text-gray-600 text-sm">Total Pendiente</p>
            <p class="text-3xl font-bold text-orange-600" id="totalPendiente">$0.00</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6">
            <p class="text-gray-600 text-sm">Clientes con Deuda</p>
            <p class="text-3xl font-bold text-gray-800" id="clientesConDeuda">0</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6">
            <p class="text-gray-600 text-sm">Productos Fiados</p>
            <p class="text-3xl font-bold text-gray-800" id="productosFiados">0</p>
        </div>
    </div>

    <!-- Lista de cuentas pendientes por cliente -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="p-6 border-b">
            <input type="text" id="buscarCliente" placeholder="Buscar cliente..."
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
        </div>
        <div id="cuentasList" class="divide-y divide-gray-200">
            <!-- Se carga dinámicamente -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cuentasPendientes = [];

        async function cargarCuentas() {
            try {
                const response = await fetch('/api/VentasProductos');
                const ventas = await response.json();

                // Filtrar solo pendientes
                const pendientes = ventas.filter(v => v.estadoPago === 'pendiente');

                // Agrupar por cliente
                const porCliente = {};
                pendientes.forEach(v => {
                    if (!porCliente[v.clienteId]) {
                        porCliente[v.clienteId] = {
                            cliente: v.cliente,
                            ventas: [],
                            total: 0
                        };
                    }
                    porCliente[v.clienteId].ventas.push(v);
                    porCliente[v.clienteId].total += v.total;
                });

                cuentasPendientes = Object.values(porCliente);

                // Actualizar resumen
                const totalPendiente = cuentasPendientes.reduce((sum, c) => sum + c.total, 0);
                document.getElementById('totalPendiente').textContent = `$${totalPendiente.toFixed(2)}`;
                document.getElementById('clientesConDeuda').textContent = cuentasPendientes.length;
                document.getElementById('productosFiados').textContent = pendientes.length;

                renderCuentas(cuentasPendientes);
            } catch (error) {
                console.error('Error:', error);
            }
        }

        function renderCuentas(cuentas) {
            const container = document.getElementById('cuentasList');

            if (cuentas.length === 0) {
                container.innerHTML = '<p class="text-center text-gray-500 py-8">No hay cuentas pendientes</p>';
                return;
            }

            container.innerHTML = cuentas.map(cuenta => `
                <div class="p-6 hover:bg-gray-50">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-lg font-bold text-gray-800">
                                ${cuenta.cliente.nombre} ${cuenta.cliente.apellido}
                            </h3>
                            <p class="text-sm text-gray-600">${cuenta.cliente.cedula}</p>
                        </div>
                        <div class="text-right">
                            <p class="text-2xl font-bold text-orange-600">$${cuenta.total.toFixed(2)}</p>
                            <button onclick="marcarComoPagado('${cuenta.cliente.id}')"
                                    class="mt-2 bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 text-sm">
                                Marcar como Pagado
                            </button>
                        </div>
                    </div>
                    <div class="space-y-2">
                        ${cuenta.ventas.map(v => `
                            <div class="flex justify-between items-center text-sm bg-gray-50 p-3 rounded">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="package" class="w-4 h-4 text-gray-400"></i>
                                    <span class="font-medium">${v.producto.nombre}</span>
                                    <span class="text-gray-600">x${v.cantidad}</span>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="font-bold">$${v.total.toFixed(2)}</span>
                                    <span class="text-xs text-gray-500">${new Date(v.fechaVenta).toLocaleDateString()}</span>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `).join('');

            lucide.createIcons();
        }

        async function marcarComoPagado(clienteId) {
            if (!confirm('¿Marcar todas las deudas de este cliente como pagadas?')) return;

            try {
                const cuenta = cuentasPendientes.find(c => c.cliente.id === clienteId);

                for (const venta of cuenta.ventas) {
                    venta.estadoPago = 'pagado';
                    venta.fechaPago = new Date().toISOString();

                    await fetch(`/api/VentasProductos/${venta.id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(venta)
                    });
                }

                alert('Deuda marcada como pagada');
                cargarCuentas();
            } catch (error) {
                console.error('Error:', error);
                alert('Error al actualizar el pago');
            }
        }

        // Buscar cliente
        document.getElementById('buscarCliente').addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase();
            const filtradas = cuentasPendientes.filter(c =>
                c.cliente.nombre.toLowerCase().includes(query) ||
                c.cliente.apellido.toLowerCase().includes(query) ||
                c.cliente.cedula.includes(query)
            );
            renderCuentas(filtradas);
        });

        window.marcarComoPagado = marcarComoPagado;
        cargarCuentas();
    </script>
}
@{
    ViewData["Title"] = "Cuentas Pendientes";
    ViewData["Subtitle"] = "Productos Fiados - Power Fitness";
    Layout = "_AdminLayout";
}

<style>
    :root{--pf-blue:#3B82F6;--pf-blueB:#60A5FA;--pf-card:#0D1526;--pf-border:#1E2D4A;--pf-text:#E2E8F0;--pf-soft:#94A3B8;--pf-muted:#64748B;--pf-green:#10B981;--pf-red:#EF4444;--pf-orange:#F59E0B;}
    .pf-input{width:100%;padding:.75rem 1.25rem;border:2px solid var(--pf-border);border-radius:.875rem;background:rgba(255,255,255,.03);color:var(--pf-text);font-weight:600;font-family:inherit;outline:none;box-sizing:border-box;transition:border-color .2s;}
    .pf-input:focus{border-color:var(--pf-blue);}
    .pf-input::placeholder{color:var(--pf-muted);font-weight:400;}
</style>

<div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
        <h2 style="font-size:1.5rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.08em;margin:0;">Productos Fiados</h2>
        <a href="/productos"
           style="padding:.65rem 1.5rem;background:rgba(255,255,255,.05);border:1px solid var(--pf-border);color:var(--pf-soft);font-weight:800;border-radius:.875rem;text-decoration:none;font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;transition:background .2s;"
           onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">Volver</a>
    </div>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.5rem;">
        <div style="background:var(--pf-card);border:1px solid var(--pf-border);border-left:4px solid var(--pf-orange);border-radius:.875rem;padding:1.25rem;">
            <p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .35rem 0;">Total Pendiente</p>
            <p style="font-size:2rem;font-weight:900;color:var(--pf-orange);margin:0;" id="totalPendiente">$0.00</p>
        </div>
        <div style="background:var(--pf-card);border:1px solid var(--pf-border);border-left:4px solid var(--pf-red);border-radius:.875rem;padding:1.25rem;">
            <p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .35rem 0;">Clientes con Deuda</p>
            <p style="font-size:2rem;font-weight:900;color:var(--pf-red);margin:0;" id="clientesConDeuda">0</p>
        </div>
        <div style="background:var(--pf-card);border:1px solid var(--pf-border);border-left:4px solid var(--pf-blue);border-radius:.875rem;padding:1.25rem;">
            <p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .35rem 0;">Productos Fiados</p>
            <p style="font-size:2rem;font-weight:900;color:var(--pf-blueB);margin:0;" id="productosFiados">0</p>
        </div>
    </div>

    <!-- Lista -->
    <div style="background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;overflow:hidden;">
        <div style="padding:1.1rem 1.5rem;border-bottom:1px solid var(--pf-border);">
            <input type="text" id="buscarCliente" placeholder="Buscar cliente..." class="pf-input">
        </div>
        <div id="cuentasList"></div>
    </div>
</div>

@section Scripts {
    <script>
        let cuentasPendientes = [];

        async function cargarCuentas() {
            try {
                const r = await fetch('/api/VentasProductos');
                const ventas = await r.json();
                const pendientes = ventas.filter(v => v.EstadoPago === 'pendiente');
                const porCliente = {};
                pendientes.forEach(v => {
                    if (!porCliente[v.ClienteId]) porCliente[v.ClienteId] = { cliente:v.Cliente, ventas:[], total:0 };
                    porCliente[v.ClienteId].ventas.push(v);
                    porCliente[v.ClienteId].total += v.Total;
                });
                cuentasPendientes = Object.values(porCliente);
                const total = cuentasPendientes.reduce((s,c)=>s+c.total,0);
                document.getElementById('totalPendiente').textContent = `$${total.toFixed(2)}`;
                document.getElementById('clientesConDeuda').textContent = cuentasPendientes.length;
                document.getElementById('productosFiados').textContent = pendientes.length;
                renderCuentas(cuentasPendientes);
            } catch(e) { console.error('Error cargando cuentas:', e); }
        }

        function renderCuentas(cuentas) {
            const c = document.getElementById('cuentasList');
            if (cuentas.length === 0) {
                c.innerHTML = '<p style="text-align:center;padding:3rem;color:#64748B;font-weight:700;">No hay cuentas pendientes</p>';
                return;
            }
            c.innerHTML = cuentas.map(cuenta => `
                <div style="padding:1.5rem;border-bottom:1px solid #1E2D4A;transition:background .15s;" onmouseover="this.style.background='rgba(59,130,246,.03)'" onmouseout="this.style.background='transparent'">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem;">
                        <div>
                            <h3 style="font-size:1.1rem;font-weight:900;color:#E2E8F0;text-transform:uppercase;margin:0 0 .2rem 0;">${cuenta.cliente.Nombre} ${cuenta.cliente.Apellido}</h3>
                            <p style="font-size:.78rem;color:#64748B;font-weight:700;margin:0;font-family:monospace;">${cuenta.cliente.Cedula}</p>
                        </div>
                        <div style="text-align:right;">
                            <p style="font-size:1.75rem;font-weight:900;color:#F59E0B;margin:0 0 .5rem 0;">$${cuenta.total.toFixed(2)}</p>
                            <button onclick="marcarComoPagado('${cuenta.cliente.Id}')"
                                    style="padding:.55rem 1.25rem;background:linear-gradient(135deg,#10B981,#065F46);color:#fff;border:none;border-radius:.75rem;font-weight:800;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;box-shadow:0 3px 12px rgba(16,185,129,.3);">
                                Marcar Pagado
                            </button>
                        </div>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:.5rem;">
                        ${cuenta.ventas.map(v=>`
                            <div style="display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;background:rgba(255,255,255,.02);border:1px solid #1E2D4A;border-radius:.625rem;">
                                <div style="display:flex;align-items:center;gap:.75rem;">
                                    <i data-lucide="package" style="width:16px;height:16px;color:#64748B;"></i>
                                    <span style="font-weight:800;color:#E2E8F0;font-size:.88rem;">${v.Producto.Nombre}</span>
                                    <span style="color:#64748B;font-weight:700;font-size:.82rem;">x${v.Cantidad}</span>
                                </div>
                                <div style="display:flex;align-items:center;gap:1rem;">
                                    <span style="font-weight:900;color:#10B981;font-size:.95rem;">$${v.Total.toFixed(2)}</span>
                                    <span style="font-size:.72rem;color:#64748B;font-weight:600;">${new Date(v.FechaVenta).toLocaleDateString()}</span>
                                </div>
                            </div>`).join('')}
                    </div>
                </div>`).join('');
            lucide.createIcons();
        }

        async function marcarComoPagado(clienteId) {
            if (!confirm('¿Marcar todas las deudas de este cliente como pagadas?')) return;
            try {
                const cuenta = cuentasPendientes.find(c=>c.cliente.Id===clienteId);
                for (const v of cuenta.ventas) await fetch(`/api/VentasProductos/${v.Id}/marcar-pagado`,{method:'POST',headers:{'Content-Type':'application/json'}});
                alert('✓ Deuda marcada como pagada');
                cargarCuentas();
            } catch(e) { alert('Error al actualizar el pago'); }
        }

        document.getElementById('buscarCliente').addEventListener('input', function(e) {
            const q = e.target.value.toLowerCase();
            renderCuentas(cuentasPendientes.filter(c=>c.cliente.Nombre.toLowerCase().includes(q)||c.cliente.Apellido.toLowerCase().includes(q)||c.cliente.Cedula.includes(q)));
        });

        window.marcarComoPagado = marcarComoPagado;
        cargarCuentas();
        lucide.createIcons();
    </script>
}

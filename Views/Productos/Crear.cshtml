@{
    ViewData["Title"] = "Crear Producto";
    ViewData["Subtitle"] = "Nuevo producto - Power Fitness";
    Layout = "_AdminLayout";
}

<style>
    :root{--pf-blue:#3B82F6;--pf-blueB:#60A5FA;--pf-deep:#1E3A8A;--pf-purple:#7C3AED;--pf-card:#0D1526;--pf-border:#1E2D4A;--pf-text:#E2E8F0;--pf-soft:#94A3B8;--pf-muted:#64748B;--pf-green:#10B981;}
    .pf-input{width:100%;padding:.75rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:rgba(255,255,255,.03);color:var(--pf-text);font-weight:600;font-family:inherit;font-size:.9rem;outline:none;box-sizing:border-box;transition:border-color .2s,background .2s;}
    .pf-input:focus{border-color:var(--pf-blue);background:rgba(59,130,246,.05);}
    .pf-input::placeholder{color:var(--pf-muted);font-weight:400;}
    .pf-select{width:100%;padding:.75rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:var(--pf-card);color:var(--pf-text);font-weight:600;font-family:inherit;outline:none;box-sizing:border-box;}
    .pf-select:focus{border-color:var(--pf-blue);}
    .pf-label{display:block;font-size:.72rem;font-weight:800;color:var(--pf-soft);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.1em;}
</style>

<div style="max-width:52rem;margin:0 auto;">
    <div style="background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1.25rem;padding:2rem;box-shadow:0 4px 24px rgba(0,0,0,.4);">

        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding-bottom:1.25rem;border-bottom:1px solid var(--pf-border);">
            <div style="background:linear-gradient(135deg,var(--pf-deep),var(--pf-purple));border-radius:.875rem;padding:1rem;flex-shrink:0;">
                <i data-lucide="package-plus" style="width:32px;height:32px;color:#fff;"></i>
            </div>
            <div>
                <h2 style="font-size:1.5rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.06em;margin:0 0 .2rem 0;">Nuevo Producto</h2>
                <p style="font-size:.8rem;color:var(--pf-muted);font-weight:600;margin:0;">Agregar producto al inventario</p>
            </div>
        </div>

        <form id="productoForm" style="display:flex;flex-direction:column;gap:1.25rem;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
                <div>
                    <label class="pf-label">Nombre <span style="color:var(--pf-blue);">*</span></label>
                    <input type="text" name="nombre" required class="pf-input" placeholder="Nombre del producto">
                </div>
                <div>
                    <label class="pf-label">Categoría</label>
                    <select name="categoria" class="pf-select">
                        <option value="suplementos">Suplementos</option>
                        <option value="bebidas">Bebidas</option>
                        <option value="snacks">Snacks</option>
                        <option value="accesorios">Accesorios</option>
                        <option value="otros">Otros</option>
                    </select>
                </div>
                <div>
                    <label class="pf-label">Precio <span style="color:var(--pf-blue);">*</span></label>
                    <div style="position:relative;">
                        <span style="position:absolute;left:1rem;top:.85rem;color:var(--pf-green);font-weight:800;">$</span>
                        <input type="number" step="0.01" name="precio" required class="pf-input" style="padding-left:2rem;" placeholder="0.00">
                    </div>
                </div>
                <div>
                    <label class="pf-label">Stock <span style="color:var(--pf-blue);">*</span></label>
                    <input type="number" name="stock" required class="pf-input" placeholder="0">
                </div>
            </div>

            <div>
                <label class="pf-label">Descripción</label>
                <textarea name="descripcion" rows="3" class="pf-input" style="resize:none;" placeholder="Descripción del producto..."></textarea>
            </div>

            <div>
                <label class="pf-label">Imagen del Producto</label>
                <input type="file" id="imagenInput" accept="image/*"
                       style="width:100%;padding:.6rem 1rem;border:2px dashed var(--pf-border);border-radius:.75rem;background:rgba(255,255,255,.02);color:var(--pf-soft);box-sizing:border-box;">
                <input type="hidden" name="imagenBase64" id="imagenBase64">
            </div>

            <div style="display:flex;gap:1rem;padding-top:1.25rem;border-top:1px solid var(--pf-border);">
                <button type="submit"
                        style="flex:1;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;font-weight:800;padding:1rem;border:none;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.9rem;text-transform:uppercase;letter-spacing:.08em;box-shadow:0 4px 20px rgba(59,130,246,.3);display:flex;align-items:center;justify-content:center;gap:.5rem;transition:transform .2s;"
                        onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                    <i data-lucide="check" style="width:18px;height:18px;"></i> Crear Producto
                </button>
                <a href="/productos"
                   style="flex:1;background:rgba(255,255,255,.05);border:1px solid var(--pf-border);color:var(--pf-soft);font-weight:800;padding:1rem;border-radius:.875rem;text-align:center;text-decoration:none;font-size:.9rem;text-transform:uppercase;letter-spacing:.08em;display:flex;align-items:center;justify-content:center;gap:.5rem;transition:background .2s;"
                   onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">
                    <i data-lucide="x" style="width:18px;height:18px;"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imagenInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) { const r = new FileReader(); r.onload = e => document.getElementById('imagenBase64').value = e.target.result; r.readAsDataURL(file); }
        });
        document.getElementById('productoForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const fd = new FormData(e.target);
            const data = { nombre:fd.get('nombre'), descripcion:fd.get('descripcion')||null, precio:parseFloat(fd.get('precio')), stock:parseInt(fd.get('stock')), categoria:fd.get('categoria'), imagenBase64:fd.get('imagenBase64')||null };
            try {
                const r = await fetch('/api/Productos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
                if (r.ok) { alert('✓ Producto creado exitosamente'); window.location.href='/productos'; }
                else { alert('Error al crear producto'); }
            } catch(e) { alert('Error al crear producto'); }
        });
        document.querySelectorAll('input[type="number"]').forEach(i=>i.addEventListener('wheel',e=>e.preventDefault(),{passive:false}));
        lucide.createIcons();
    </script>
}

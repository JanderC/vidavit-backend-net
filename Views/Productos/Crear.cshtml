@{
    ViewData["Title"] = "Crear Producto";
    ViewData["Subtitle"] = "Nuevo producto";
    Layout = "_AdminLayout";
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">

        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-800 p-8">
            <div class="flex items-center gap-4">
                <div>
                    <h2 class="text-3xl font-black text-white mb-2 uppercase tracking-wide">Nuevo Producto</h2>
                    <p class="text-white opacity-90 font-bold">Agregar producto al inventario</p>
                </div>
            </div>
        </div>

        <div class="p-8">
            <form id="productoForm" class="space-y-6">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <!-- Nombre -->
                    <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                        <label class="block text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Nombre *</label>
                        <input type="text" name="nombre" required
                               class="w-full bg-white border-2 border-gray-200 rounded-lg px-4 py-3 font-semibold text-gray-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition placeholder-gray-400"
                               placeholder="Nombre del producto">
                    </div>

                    <!-- Categoría -->
                    <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                        <label class="block text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Categoría</label>
                        <select name="categoria"
                                class="w-full bg-white border-2 border-gray-200 rounded-lg px-4 py-3 font-semibold text-gray-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition">
                            <option value="suplementos">Suplementos</option>
                            <option value="bebidas">Bebidas</option>
                            <option value="snacks">Snacks</option>
                            <option value="accesorios">Accesorios</option>
                            <option value="otros">Otros</option>
                        </select>
                    </div>

                    <!-- Precio -->
                    <div class="bg-emerald-50 p-6 rounded-xl border-2 border-emerald-300">
                        <label class="block text-sm font-black text-emerald-800 uppercase tracking-wide mb-2">Precio *</label>
                        <div class="relative">
                            <span class="absolute left-4 top-3.5 text-emerald-700 font-black">$</span>
                            <input type="number" step="0.01" name="precio" required
                                   class="w-full bg-white border-2 border-emerald-200 rounded-lg pl-8 pr-4 py-3 font-semibold text-gray-900 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition placeholder-gray-400"
                                   placeholder="0.00">
                        </div>
                    </div>

                    <!-- Stock -->
                    <div class="bg-blue-50 p-6 rounded-xl border-2 border-blue-300">
                        <label class="block text-sm font-black text-blue-800 uppercase tracking-wide mb-2">Stock *</label>
                        <input type="number" name="stock" required
                               class="w-full bg-white border-2 border-blue-200 rounded-lg px-4 py-3 font-semibold text-gray-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition placeholder-gray-400"
                               placeholder="0">
                    </div>

                </div>

                <!-- Descripción -->
                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <label class="block text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Descripción</label>
                    <textarea name="descripcion" rows="3"
                              class="w-full bg-white border-2 border-gray-200 rounded-lg px-4 py-3 font-semibold text-gray-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition placeholder-gray-400 resize-none"
                              placeholder="Descripción del producto..."></textarea>
                </div>

                <!-- Imagen -->
                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <label class="block text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Imagen del Producto</label>
                    <input type="file" id="imagenInput" accept="image/*"
                           class="w-full text-gray-700 font-semibold file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:font-black file:uppercase file:text-sm file:bg-blue-600 file:text-white hover:file:bg-blue-700 transition">
                    <input type="hidden" name="imagenBase64" id="imagenBase64">
                </div>

                <!-- Botones -->
                <div class="flex gap-4 pt-6 border-t-2 border-gray-200">
                    <button type="submit"
                            class="flex-1 bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-black py-4 px-6 rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide flex items-center justify-center gap-2">
                        <i data-lucide="check" class="w-5 h-5"></i>
                        Crear Producto
                    </button>
                    <a href="/productos"
                       class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 font-black py-4 px-6 rounded-xl transition-all text-center uppercase tracking-wide flex items-center justify-center gap-2">
                        <i data-lucide="x" class="w-5 h-5"></i>
                        Cancelar
                    </a>
                </div>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imagenInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imagenBase64').value = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('productoForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
                nombre: formData.get('nombre'),
                descripcion: formData.get('descripcion') || null,
                precio: parseFloat(formData.get('precio')),
                stock: parseInt(formData.get('stock')),
                categoria: formData.get('categoria'),
                imagenBase64: formData.get('imagenBase64') || null
            };
            try {
                const response = await fetch('/api/Productos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (response.ok) {
                    alert('✓ Producto creado exitosamente');
                    window.location.href = '/productos';
                } else {
                    alert('Error al crear producto');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al crear producto');
            }
        });

        document.querySelectorAll('input[type="number"]').forEach(function (input) {
            input.addEventListener('wheel', function (e) {
                e.preventDefault();
            }, { passive: false });
        });

        lucide.createIcons();
    </script>
}

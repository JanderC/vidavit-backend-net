@{
    ViewData["Title"] = "Crear Producto";
    ViewData["Subtitle"] = "Nuevo producto - PowerZone";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --pz-dark: #0f1535;
        --pz-dark2: #1a2050;
        --pz-card: #111827;
        --pz-border: #1f2a4a;
        --pz-text: #e5e5e5;
        --pz-muted: #6b7280;
        --pz-gold: #D4A017;
        --pz-blue: #2B4FD8;
    }

    .pz-page {
        background: var(--pz-dark);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .pz-card {
        background: var(--pz-card);
        border: 1px solid var(--pz-border);
        border-radius: 1rem;
    }

    .pz-label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        color: var(--pz-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .pz-input {
        width: 100%;
        background: #1a2050;
        border: 2px solid var(--pz-border);
        color: var(--pz-text);
        border-radius: .6rem;
        padding: .75rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s, box-shadow .2s;
    }

        .pz-input:focus {
            border-color: #D4A017;
            box-shadow: 0 0 0 3px rgba(212,160,23,0.18);
        }

        .pz-input::placeholder {
            color: var(--pz-muted);
        }

    select.pz-input option {
        background: #1a2050;
    }

    .pz-btn-primary {
        background: linear-gradient(135deg, #2B4FD8, #1a3ab5);
        color: #fff;
        font-weight: 900;
        padding: .9rem 1.5rem;
        border-radius: .6rem;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        transition: all .2s;
        text-transform: uppercase;
        letter-spacing: .06em;
        flex: 1;
        box-shadow: 0 4px 14px rgba(43,79,216,0.3);
    }

        .pz-btn-primary:hover {
            background: linear-gradient(135deg, #D4A017, #b8880e);
            box-shadow: 0 6px 20px rgba(212,160,23,0.4);
            transform: translateY(-1px);
        }

    .pz-btn-secondary {
        background: #1f2a4a;
        color: var(--pz-text);
        font-weight: 800;
        padding: .9rem 1.5rem;
        border-radius: .6rem;
        border: 1px solid var(--pz-border);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        transition: background .2s;
        text-transform: uppercase;
        letter-spacing: .06em;
        flex: 1;
        text-decoration: none;
    }

        .pz-btn-secondary:hover {
            background: #263060;
        }

    .pz-file-input {
        width: 100%;
        background: #1a2050;
        border: 2px dashed var(--pz-border);
        color: var(--pz-text);
        border-radius: .6rem;
        padding: .6rem 1rem;
    }

        .pz-file-input::file-selector-button {
            background: linear-gradient(135deg, #D4A017, #b8880e);
            color: #fff;
            font-weight: 800;
            padding: .4rem 1rem;
            border-radius: .4rem;
            border: none;
            cursor: pointer;
            margin-right: 1rem;
            text-transform: uppercase;
            font-size: .78rem;
        }
</style>

<div class="pz-page">
    <div class="max-w-4xl mx-auto">
        <div class="pz-card p-8">
            <!-- Header -->
            <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--pz-border);">
                <div style="background:linear-gradient(135deg,#2B4FD8,#1a3ab5);border-radius:.75rem;padding:1rem;">
                    <i data-lucide="package-plus" style="width:2rem;height:2rem;color:#fff;display:block;"></i>
                </div>
                <div>
                    <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.2rem;">
                        <h2 style="font-size:1.6rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.05em;">Nuevo Producto</h2>
                        <span style="background:linear-gradient(135deg,#0f1535,#1a2050);color:#D4A017;font-size:.65rem;font-weight:900;padding:.15rem .55rem;border-radius:9999px;letter-spacing:.1em;border:1px solid #D4A017;">POWERZONE</span>
                    </div>
                    <p style="color:var(--pz-muted);font-size:.875rem;font-weight:600;">Agregar producto al inventario</p>
                </div>
            </div>

            <form id="productoForm" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="pz-label">Nombre *</label>
                        <input type="text" name="nombre" required class="pz-input" placeholder="Nombre del producto">
                    </div>
                    <div>
                        <label class="pz-label">Categoría</label>
                        <select name="categoria" class="pz-input">
                            <option value="suplementos">Suplementos</option>
                            <option value="bebidas">Bebidas</option>
                            <option value="snacks">Snacks</option>
                            <option value="accesorios">Accesorios</option>
                            <option value="otros">Otros</option>
                        </select>
                    </div>
                    <div>
                        <label class="pz-label">Precio *</label>
                        <div style="position:relative;">
                            <span style="position:absolute;left:1rem;top:.85rem;color:#D4A017;font-weight:800;">$</span>
                            <input type="number" step="0.01" name="precio" required class="pz-input" style="padding-left:2rem;" placeholder="0.00">
                        </div>
                    </div>
                    <div>
                        <label class="pz-label">Stock *</label>
                        <input type="number" name="stock" required class="pz-input" placeholder="0">
                    </div>
                </div>

                <div>
                    <label class="pz-label">Descripción</label>
                    <textarea name="descripcion" rows="3" class="pz-input" style="resize:none;" placeholder="Descripción del producto..."></textarea>
                </div>

                <div>
                    <label class="pz-label">Imagen del Producto</label>
                    <input type="file" id="imagenInput" accept="image/*" class="pz-file-input">
                    <input type="hidden" name="imagenBase64" id="imagenBase64">
                </div>

                <div style="display:flex;gap:1rem;padding-top:1.5rem;border-top:1px solid var(--pz-border);">
                    <button type="submit" class="pz-btn-primary">
                        <i data-lucide="check" style="width:1.25rem;height:1.25rem;"></i>
                        Crear Producto
                    </button>
                    <a href="/productos" class="pz-btn-secondary">
                        <i data-lucide="x" style="width:1.25rem;height:1.25rem;"></i>
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imagenInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) { document.getElementById('imagenBase64').value = e.target.result; };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('productoForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
                nombre: formData.get('nombre'),
                descripcion: formData.get('descripcion') || null,
                precio: parseFloat(formData.get('precio')),
                stock: parseInt(formData.get('stock')),
                categoria: formData.get('categoria'),
                imagenBase64: formData.get('imagenBase64') || null
            };
            try {
                const response = await fetch('/api/Productos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                if (response.ok) { alert('✓ Producto creado exitosamente'); window.location.href = '/productos'; }
                else { alert('Error al crear producto'); }
            } catch (error) { alert('Error al crear producto'); }
        });

        lucide.createIcons();
    </script>
}
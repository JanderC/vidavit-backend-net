@{
    ViewData["Title"] = "Crear Producto";
    ViewData["Subtitle"] = "Nuevo producto - VidaFit";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --vf-green: #39FF14;
        --vf-dark: #0a0a0a;
        --vf-card: #111111;
        --vf-border: #1f1f1f;
        --vf-text: #e5e5e5;
        --vf-muted: #6b7280;
    }

    .vf-page {
        background: var(--vf-dark);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .vf-card {
        background: var(--vf-card);
        border: 1px solid var(--vf-border);
        border-radius: 1rem;
    }

    .vf-label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        color: var(--vf-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .vf-input {
        width: 100%;
        background: #1a1a1a;
        border: 2px solid var(--vf-border);
        color: var(--vf-text);
        border-radius: .6rem;
        padding: .75rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s,box-shadow .2s;
    }

        .vf-input:focus {
            border-color: var(--vf-green);
            box-shadow: 0 0 0 3px rgba(57,255,20,.12);
        }

        .vf-input::placeholder {
            color: var(--vf-muted);
        }

    select.vf-input option {
        background: #1a1a1a;
    }

    .vf-btn-primary {
        background: var(--vf-green);
        color: #0a0a0a;
        font-weight: 900;
        padding: .9rem 1.5rem;
        border-radius: .6rem;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        transition: opacity .2s,transform .1s;
        text-transform: uppercase;
        letter-spacing: .06em;
        flex: 1;
    }

        .vf-btn-primary:hover {
            opacity: .85;
            transform: translateY(-1px);
        }

    .vf-btn-secondary {
        background: #1f1f1f;
        color: var(--vf-text);
        font-weight: 800;
        padding: .9rem 1.5rem;
        border-radius: .6rem;
        border: 1px solid var(--vf-border);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        transition: background .2s;
        text-transform: uppercase;
        letter-spacing: .06em;
        flex: 1;
        text-decoration: none;
    }

        .vf-btn-secondary:hover {
            background: #2a2a2a;
        }

    .vf-file-input {
        width: 100%;
        background: #1a1a1a;
        border: 2px dashed var(--vf-border);
        color: var(--vf-text);
        border-radius: .6rem;
        padding: .6rem 1rem;
    }

        .vf-file-input::file-selector-button {
            background: var(--vf-green);
            color: #0a0a0a;
            font-weight: 800;
            padding: .4rem 1rem;
            border-radius: .4rem;
            border: none;
            cursor: pointer;
            margin-right: 1rem;
            text-transform: uppercase;
            font-size: .78rem;
        }
</style>

<div class="vf-page">
    <div class="max-w-4xl mx-auto">
        <div class="vf-card p-8">
            <!-- Header -->
            <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--vf-border);">
                <div style="background:var(--vf-green);border-radius:.75rem;padding:1rem;">
                    <i data-lucide="package-plus" style="width:2rem;height:2rem;color:#0a0a0a;display:block;"></i>
                </div>
                <div>
                    <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.2rem;">
                        <h2 style="font-size:1.6rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.05em;">Nuevo Producto</h2>
                        <span style="background:var(--vf-green);color:#0a0a0a;font-size:.65rem;font-weight:900;padding:.15rem .55rem;border-radius:9999px;letter-spacing:.1em;">VIDAFIT</span>
                    </div>
                    <p style="color:var(--vf-muted);font-size:.875rem;font-weight:600;">Agregar producto al inventario</p>
                </div>
            </div>

            <form id="productoForm" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="vf-label">Nombre *</label>
                        <input type="text" name="nombre" required class="vf-input" placeholder="Nombre del producto">
                    </div>
                    <div>
                        <label class="vf-label">Categoría</label>
                        <select name="categoria" class="vf-input">
                            <option value="suplementos">Suplementos</option>
                            <option value="bebidas">Bebidas</option>
                            <option value="snacks">Snacks</option>
                            <option value="accesorios">Accesorios</option>
                            <option value="otros">Otros</option>
                        </select>
                    </div>
                    <div>
                        <label class="vf-label">Precio *</label>
                        <div style="position:relative;">
                            <span style="position:absolute;left:1rem;top:.85rem;color:var(--vf-green);font-weight:800;">$</span>
                            <input type="number" step="0.01" name="precio" required class="vf-input" style="padding-left:2rem;" placeholder="0.00">
                        </div>
                    </div>
                    <div>
                        <label class="vf-label">Stock *</label>
                        <input type="number" name="stock" required class="vf-input" placeholder="0">
                    </div>
                </div>

                <div>
                    <label class="vf-label">Descripción</label>
                    <textarea name="descripcion" rows="3" class="vf-input" style="resize:none;" placeholder="Descripción del producto..."></textarea>
                </div>

                <div>
                    <label class="vf-label">Imagen del Producto</label>
                    <input type="file" id="imagenInput" accept="image/*" class="vf-file-input">
                    <input type="hidden" name="imagenBase64" id="imagenBase64">
                </div>

                <div style="display:flex;gap:1rem;padding-top:1.5rem;border-top:1px solid var(--vf-border);">
                    <button type="submit" class="vf-btn-primary">
                        <i data-lucide="check" style="width:1.25rem;height:1.25rem;"></i>
                        Crear Producto
                    </button>
                    <a href="/productos" class="vf-btn-secondary">
                        <i data-lucide="x" style="width:1.25rem;height:1.25rem;"></i>
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imagenInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagenBase64').value = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('productoForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
                nombre: formData.get('nombre'),
                descripcion: formData.get('descripcion') || null,
                precio: parseFloat(formData.get('precio')),
                stock: parseInt(formData.get('stock')),
                categoria: formData.get('categoria'),
                imagenBase64: formData.get('imagenBase64') || null
            };
            try {
                const response = await fetch('/api/Productos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (response.ok) {
                    alert('✓ Producto creado exitosamente');
                    window.location.href = '/productos';
                } else {
                    alert('Error al crear producto');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al crear producto');
            }
        });

        lucide.createIcons();
    </script>
}

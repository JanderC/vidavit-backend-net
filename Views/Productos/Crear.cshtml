@{
    ViewData["Title"] = "Crear Producto";
    ViewData["Subtitle"] = "Nuevo producto - Tallest GYM";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --tg-green: #2EAD4B;
        --tg-green-dark: #1e8a38;
        --tg-green-light: #e8f7ec;
        --tg-border: #c6e8cf;
        --tg-black: #1a1a1a;
        --tg-dark: #2D2D2D;
        --tg-text: #111827;
        --tg-muted: #4b5563;
        --tg-white: #ffffff;
    }

    .tg-page {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .tg-card {
        background: var(--tg-white);
        border: 2px solid var(--tg-border);
        border-radius: 1.25rem;
        box-shadow: 0 4px 20px rgba(46,173,75,0.1);
    }

    .tg-label {
        display: block;
        font-size: .75rem;
        font-weight: 900;
        color: var(--tg-dark);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin-bottom: .5rem;
    }

    .tg-input {
        width: 100%;
        background: #f9fefb;
        border: 2px solid var(--tg-border);
        color: var(--tg-text);
        border-radius: .65rem;
        padding: .8rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s, box-shadow .2s;
        font-size: .95rem;
    }

        .tg-input:focus {
            border-color: var(--tg-green);
            box-shadow: 0 0 0 3px rgba(46,173,75,0.15);
        }

        .tg-input::placeholder {
            color: #9ca3af;
        }

    select.tg-input option {
        background: #fff;
        color: var(--tg-text);
    }

    .tg-btn-primary {
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
        color: var(--tg-white);
        font-weight: 900;
        padding: .9rem 1.5rem;
        border-radius: .75rem;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        transition: all .2s;
        text-transform: uppercase;
        letter-spacing: .07em;
        flex: 1;
        box-shadow: 0 4px 16px rgba(46,173,75,0.35);
        font-size: .9rem;
    }

        .tg-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(46,173,75,0.45);
        }

    .tg-btn-secondary {
        background: #f3f4f6;
        color: var(--tg-dark);
        font-weight: 800;
        padding: .9rem 1.5rem;
        border-radius: .75rem;
        border: 2px solid #e5e7eb;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        transition: all .2s;
        text-transform: uppercase;
        letter-spacing: .07em;
        flex: 1;
        text-decoration: none;
        font-size: .9rem;
    }

        .tg-btn-secondary:hover {
            background: #e5e7eb;
            text-decoration: none;
            color: var(--tg-dark);
        }

    .tg-file-input {
        width: 100%;
        background: #f9fefb;
        border: 2px dashed var(--tg-border);
        color: var(--tg-text);
        border-radius: .65rem;
        padding: .6rem 1rem;
        font-weight: 600;
    }

        .tg-file-input::file-selector-button {
            background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
            color: var(--tg-white);
            font-weight: 800;
            padding: .4rem 1rem;
            border-radius: .4rem;
            border: none;
            cursor: pointer;
            margin-right: 1rem;
            text-transform: uppercase;
            font-size: .75rem;
            letter-spacing: .05em;
        }

    .tg-header-icon {
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
        border-radius: .9rem;
        padding: 1rem;
        box-shadow: 0 4px 16px rgba(46,173,75,0.35);
    }

    .tg-badge {
        background: var(--tg-green);
        color: var(--tg-white);
        font-size: .62rem;
        font-weight: 900;
        padding: .2rem .6rem;
        border-radius: 9999px;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .tg-price-prefix {
        position: absolute;
        left: 1rem;
        top: .85rem;
        color: var(--tg-green);
        font-weight: 900;
        font-size: 1rem;
    }
</style>

<div class="tg-page">
    <div class="max-w-4xl mx-auto">
        <div class="tg-card p-8">

            <!-- Header -->
            <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:2px solid var(--tg-border);">
                <div class="tg-header-icon">
                    <i data-lucide="package-plus" style="width:2rem;height:2rem;color:white;display:block;"></i>
                </div>
                <div>
                    <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.25rem;">
                        <h2 style="font-size:1.65rem;font-weight:900;color:var(--tg-text);text-transform:uppercase;letter-spacing:.05em;">Nuevo Producto</h2>
                        <span class="tg-badge">TALLEST GYM</span>
                    </div>
                    <p style="color:var(--tg-muted);font-size:.875rem;font-weight:600;">Agregar producto al inventario</p>
                </div>
            </div>

            <form id="productoForm" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="tg-label">Nombre *</label>
                        <input type="text" name="nombre" required class="tg-input" placeholder="Nombre del producto">
                    </div>
                    <div>
                        <label class="tg-label">Categoría</label>
                        <select name="categoria" class="tg-input">
                            <option value="suplementos">Suplementos</option>
                            <option value="bebidas">Bebidas</option>
                            <option value="snacks">Snacks</option>
                            <option value="accesorios">Accesorios</option>
                            <option value="otros">Otros</option>
                        </select>
                    </div>
                    <div>
                        <label class="tg-label">Precio *</label>
                        <div style="position:relative;">
                            <span class="tg-price-prefix">$</span>
                            <input type="number" step="0.01" name="precio" required class="tg-input" style="padding-left:2rem;" placeholder="0.00">
                        </div>
                    </div>
                    <div>
                        <label class="tg-label">Stock *</label>
                        <input type="number" name="stock" required class="tg-input" placeholder="0">
                    </div>
                </div>

                <div>
                    <label class="tg-label">Descripción</label>
                    <textarea name="descripcion" rows="3" class="tg-input" style="resize:none;" placeholder="Descripción del producto..."></textarea>
                </div>

                <div>
                    <label class="tg-label">Imagen del Producto</label>
                    <input type="file" id="imagenInput" accept="image/*" class="tg-file-input">
                    <input type="hidden" name="imagenBase64" id="imagenBase64">
                </div>

                <div style="display:flex;gap:1rem;padding-top:1.5rem;border-top:2px solid var(--tg-border);">
                    <button type="submit" class="tg-btn-primary">
                        <i data-lucide="check" style="width:1.25rem;height:1.25rem;"></i>
                        Crear Producto
                    </button>
                    <a href="/productos" class="tg-btn-secondary">
                        <i data-lucide="x" style="width:1.25rem;height:1.25rem;"></i>
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imagenInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagenBase64').value = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('productoForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
                nombre: formData.get('nombre'),
                descripcion: formData.get('descripcion') || null,
                precio: parseFloat(formData.get('precio')),
                stock: parseInt(formData.get('stock')),
                categoria: formData.get('categoria'),
                imagenBase64: formData.get('imagenBase64') || null
            };
            try {
                const response = await fetch('/api/Productos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (response.ok) {
                    alert('✓ Producto creado exitosamente');
                    window.location.href = '/productos';
                } else {
                    alert('Error al crear producto');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al crear producto');
            }
        });

        lucide.createIcons();
    </script>
}

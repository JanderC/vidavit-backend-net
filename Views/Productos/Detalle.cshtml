@model VidaFitBackend.Models.VentaProducto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detalle de Venta";
    ViewData["Subtitle"] = "Información completa de la venta";
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
        <!-- Header -->
        <div class="bg-gradient-to-r from-red-600 to-red-800 p-8">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-3xl font-black text-white mb-2 uppercase tracking-wide">Detalle de Venta</h2>
                    <p class="text-white opacity-90 font-bold">Venta #@Model.Id.ToString().Substring(0, 8)</p>
                </div>
                <div class="text-right">
                    @if (Model.EstadoPago == "pagado")
                    {
                        <span class="inline-flex items-center px-6 py-3 bg-emerald-500 text-white rounded-full font-black uppercase tracking-wide shadow-xl">
                            <i data-lucide="check-circle" class="w-5 h-5 mr-2"></i>
                            Pagado
                        </span>
                    }
                    else if (Model.EstadoPago == "pendiente")
                    {
                        <span class="inline-flex items-center px-6 py-3 bg-orange-500 text-white rounded-full font-black uppercase tracking-wide shadow-xl">
                            <i data-lucide="clock" class="w-5 h-5 mr-2"></i>
                            Pendiente
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-6 py-3 bg-gray-500 text-white rounded-full font-black uppercase tracking-wide shadow-xl">
                            <i data-lucide="x-circle" class="w-5 h-5 mr-2"></i>
                            Cancelado
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="p-8 space-y-8">
            <!-- Información del Cliente -->
            <div class="border-b-2 border-gray-200 pb-6">
                <h3 class="text-xl font-black text-gray-900 mb-6 flex items-center gap-3 uppercase tracking-wide">
                    <i data-lucide="user" class="w-6 h-6"></i>
                    Información del Cliente
                </h3>
                <div class="flex items-center gap-4">
                    <div class="w-20 h-20 bg-gray-200 rounded-full flex items-center justify-center">
                        <i data-lucide="user" class="w-10 h-10 text-gray-500"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-black text-gray-900">@Model.Cliente.Nombre @Model.Cliente.Apellido</p>
                        <p class="text-sm text-gray-600 font-bold">Cédula: @Model.Cliente.Cedula</p>
                        @if (!string.IsNullOrEmpty(Model.Cliente.Telefono))
                        {
                            <p class="text-sm text-gray-600 font-bold">Teléfono: @Model.Cliente.Telefono</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Información del Producto -->
            <div class="border-b-2 border-gray-200 pb-6">
                <h3 class="text-xl font-black text-gray-900 mb-6 flex items-center gap-3 uppercase tracking-wide">
                    <i data-lucide="package" class="w-6 h-6"></i>
                    Información del Producto
                </h3>
                <div class="flex items-start gap-4">
                    <div class="w-32 h-32 bg-gray-200 rounded-2xl flex items-center justify-center overflow-hidden border-2 border-gray-300">
                        @if (!string.IsNullOrEmpty(Model.Producto.ImagenBase64))
                        {
                            <img src="data:image/jpeg;base64,@Model.Producto.ImagenBase64" class="w-full h-full object-cover" alt="@Model.Producto.Nombre">
                        }
                        else
                        {
                            <i data-lucide="package" class="w-16 h-16 text-gray-400"></i>
                        }
                    </div>
                    <div class="flex-1">
                        <p class="text-2xl font-black text-gray-900">@Model.Producto.Nombre</p>
                        @if (!string.IsNullOrEmpty(Model.Producto.Descripcion))
                        {
                            <p class="text-sm text-gray-600 mt-2 font-semibold">@Model.Producto.Descripcion</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Producto.Categoria))
                        {
                            <span class="inline-block mt-3 px-4 py-2 bg-blue-100 text-blue-800 rounded-full font-black uppercase tracking-wide text-xs">
                                @Model.Producto.Categoria
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Detalles de la Venta -->
            <div class="border-b-2 border-gray-200 pb-6">
                <h3 class="text-xl font-black text-gray-900 mb-6 flex items-center gap-3 uppercase tracking-wide">
                    <i data-lucide="shopping-cart" class="w-6 h-6"></i>
                    Detalles de la Venta
                </h3>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-blue-50 p-6 rounded-2xl border-2 border-blue-200">
                        <p class="text-sm text-gray-600 mb-2 font-black uppercase tracking-wide">Cantidad</p>
                        <p class="text-3xl font-black text-gray-900">@Model.Cantidad <span class="text-lg">unidades</span></p>
                    </div>
                    <div class="bg-emerald-50 p-6 rounded-2xl border-2 border-emerald-200">
                        <p class="text-sm text-gray-600 mb-2 font-black uppercase tracking-wide">Precio Unitario</p>
                        <p class="text-3xl font-black text-gray-900">$@Model.PrecioUnitario.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Información de Fechas -->
            <div class="border-b-2 border-gray-200 pb-6">
                <h3 class="text-xl font-black text-gray-900 mb-6 flex items-center gap-3 uppercase tracking-wide">
                    <i data-lucide="calendar" class="w-6 h-6"></i>
                    Fechas
                </h3>
                <div class="space-y-3">
                    <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border-2 border-gray-200">
                        <span class="text-gray-600 font-bold">Fecha de Venta:</span>
                        <span class="font-black text-gray-900">@Model.FechaVenta.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    @if (Model.FechaPago.HasValue)
                    {
                        <div class="flex items-center justify-between p-4 bg-emerald-50 rounded-xl border-2 border-emerald-200">
                            <span class="text-gray-600 font-bold">Fecha de Pago:</span>
                            <span class="font-black text-emerald-600">@Model.FechaPago.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Notas -->
            @if (!string.IsNullOrEmpty(Model.Notas))
            {
                <div class="border-b-2 border-gray-200 pb-6">
                    <h3 class="text-xl font-black text-gray-900 mb-6 flex items-center gap-3 uppercase tracking-wide">
                        <i data-lucide="file-text" class="w-6 h-6"></i>
                        Notas
                    </h3>
                    <div class="bg-amber-50 p-6 rounded-2xl border-2 border-amber-200">
                        <p class="text-gray-900 font-semibold">@Model.Notas</p>
                    </div>
                </div>
            }

            <!-- Total -->
            <div class="bg-gradient-to-r from-red-600 to-red-800 p-8 rounded-2xl shadow-xl">
                <div class="flex items-center justify-between">
                    <span class="text-2xl font-black text-white uppercase tracking-wide">TOTAL:</span>
                    <span class="text-5xl font-black text-white">$@Model.Total.ToString("N2")</span>
                </div>
            </div>

            <!-- Acciones -->
            <div class="flex gap-4 pt-4">
                @if (Model.EstadoPago == "pendiente")
                {
                    <form method="post" action="/ventas-productos/marcar-pagado/@Model.Id" class="flex-1">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="w-full bg-gradient-to-r from-emerald-600 to-emerald-800 hover:from-emerald-700 hover:to-emerald-900 text-white font-black py-4 px-6 rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105"
                                onclick="return confirm('¿Marcar esta venta como pagada?')">
                            <i data-lucide="dollar-sign" class="w-5 h-5 inline mr-2"></i>
                            Marcar como Pagado
                        </button>
                    </form>
                }
                <a href="/ventas-productos"
                   class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 font-black py-4 px-6 rounded-xl transition-all text-center uppercase tracking-wide">
                    <i data-lucide="arrow-left" class="w-5 h-5 inline mr-2"></i>
                    Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}

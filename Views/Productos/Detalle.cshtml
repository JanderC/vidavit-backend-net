@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detalle de Producto";
    ViewData["Subtitle"] = "Información completa del producto";
}

<style>
    :root {
        --vf-green: #39FF14;
        --vf-dark: #0a0a0a;
        --vf-card: #111111;
        --vf-border: #1f1f1f;
        --vf-text: #e5e5e5;
        --vf-muted: #6b7280;
    }

    .vf-page {
        background: var(--vf-dark);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .vf-card {
        background: var(--vf-card);
        border: 1px solid var(--vf-border);
        border-radius: 1rem;
        overflow: hidden;
    }

    .vf-info-box {
        background: #1a1a1a;
        border: 1px solid var(--vf-border);
        border-radius: .75rem;
        padding: 1.5rem;
    }

    .vf-info-label {
        font-size: .75rem;
        font-weight: 800;
        color: var(--vf-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .vf-info-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--vf-text);
    }

    .vf-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .9rem 1.5rem;
        border-radius: .6rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        text-decoration: none;
        transition: opacity .2s;
        flex: 1;
    }

        .vf-btn:hover {
            opacity: .85;
        }

    .vf-btn-blue {
        background: #1d4ed8;
        color: #fff;
    }

    .vf-btn-gray {
        background: #1f1f1f;
        color: var(--vf-text);
        border: 1px solid var(--vf-border);
    }
</style>

<div class="vf-page">
    <div class="max-w-4xl mx-auto">
        <div class="vf-card">
            <!-- Header -->
            <div style="background:linear-gradient(135deg,#111 0%,#1a1a1a 100%);border-bottom:2px solid var(--vf-green);padding:2rem;">
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
                    <div>
                        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.5rem;">
                            <span style="background:var(--vf-green);color:#0a0a0a;font-size:.7rem;font-weight:900;padding:.2rem .6rem;border-radius:9999px;letter-spacing:.1em;">VIDAFIT</span>
                            <h2 style="font-size:1.75rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.05em;">Detalle de Producto</h2>
                        </div>
                        <p style="color:var(--vf-green);font-weight:700;font-size:1rem;">@Model.Nombre</p>
                    </div>
                    <div>
                        @if (Model.Activo)
                        {
                            <span style="display:inline-flex;align-items:center;gap:.5rem;padding:.6rem 1.25rem;background:#059669;color:#fff;border-radius:9999px;font-weight:800;font-size:.85rem;text-transform:uppercase;letter-spacing:.05em;">
                                <i data-lucide="check-circle" style="width:1.1rem;height:1.1rem;"></i>
                                Activo
                            </span>
                        }
                        else
                        {
                            <span style="display:inline-flex;align-items:center;gap:.5rem;padding:.6rem 1.25rem;background:#374151;color:#fff;border-radius:9999px;font-weight:800;font-size:.85rem;text-transform:uppercase;letter-spacing:.05em;">
                                <i data-lucide="x-circle" style="width:1.1rem;height:1.1rem;"></i>
                                Inactivo
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div style="padding:2rem;">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <!-- Imagen -->
                    <div class="md:col-span-2" style="display:flex;justify-content:center;">
                        @if (!string.IsNullOrEmpty(Model.ImagenBase64))
                        {
                            <div style="width:16rem;height:16rem;border-radius:1rem;overflow:hidden;border:2px solid var(--vf-border);">
                                <img src="@Model.ImagenBase64" alt="@Model.Nombre" style="width:100%;height:100%;object-fit:cover;">
                            </div>
                        }
                        else
                        {
                            <div style="width:16rem;height:16rem;border-radius:1rem;border:2px dashed var(--vf-border);display:flex;align-items:center;justify-content:center;background:#1a1a1a;">
                                <i data-lucide="package" style="width:6rem;height:6rem;color:var(--vf-muted);display:block;"></i>
                            </div>
                        }
                    </div>

                    <div class="vf-info-box">
                        <p class="vf-info-label">Nombre</p>
                        <p class="vf-info-value">@Model.Nombre</p>
                    </div>

                    <div class="vf-info-box">
                        <p class="vf-info-label">Categoría</p>
                        <p class="vf-info-value">@(string.IsNullOrEmpty(Model.Categoria) ? "Sin categoría" : Model.Categoria)</p>
                    </div>

                    <div class="vf-info-box" style="border-left:3px solid var(--vf-green);">
                        <p class="vf-info-label" style="color:var(--vf-green);">Precio</p>
                        <p style="font-size:1.75rem;font-weight:900;color:var(--vf-green);">$@Model.Precio.ToString("N2")</p>
                    </div>

                    <div class="vf-info-box" style="border-left:3px solid #3b82f6;">
                        <p class="vf-info-label" style="color:#60a5fa;">Stock Disponible</p>
                        <p style="font-size:1.75rem;font-weight:900;color:#3b82f6;">@Model.Stock</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Descripcion))
                    {
                        <div class="vf-info-box md:col-span-2">
                            <p class="vf-info-label">Descripción</p>
                            <p style="color:var(--vf-text);font-weight:500;line-height:1.6;">@Model.Descripcion</p>
                        </div>
                    }

                    <div class="vf-info-box">
                        <p class="vf-info-label">Fecha de Creación</p>
                        <p class="vf-info-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>

                    <div class="vf-info-box">
                        <p class="vf-info-label">Última Actualización</p>
                        <p class="vf-info-value">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>

                <div style="display:flex;gap:1rem;padding-top:1.5rem;border-top:1px solid var(--vf-border);">
                    <a href="/productos/editar/@Model.Id" class="vf-btn vf-btn-blue">
                        <i data-lucide="edit" style="width:1.25rem;height:1.25rem;"></i>
                        Editar Producto
                    </a>
                    <a href="/productos" class="vf-btn vf-btn-gray">
                        <i data-lucide="arrow-left" style="width:1.25rem;height:1.25rem;"></i>
                        Volver al Listado
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}

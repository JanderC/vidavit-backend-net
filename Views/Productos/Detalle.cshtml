@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detalle de Producto";
    ViewData["Subtitle"] = "Información completa del producto";
}

<style>
    .detail-card{background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:16px;overflow:hidden;}
    .field-box{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:14px 16px;}
    .field-label{font-size:0.62rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin:0 0 5px 0;}
    .field-value{font-weight:700;color:#fff;font-size:0.95rem;margin:0;}
</style>

<div style="max-width:760px;margin:0 auto;">
    <div class="detail-card">
        <!-- Header with gradient -->
        <div style="background:linear-gradient(135deg,#1E6FE3,#6B3FA0);padding:24px 28px;display:flex;align-items:center;justify-content:space-between;">
            <div>
                <h2 style="font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:3px;color:#fff;margin:0 0 4px 0;">@Model.Nombre</h2>
                <p style="font-size:0.78rem;color:rgba(255,255,255,0.65);font-weight:600;margin:0;">Detalle de Producto</p>
            </div>
            @if (Model.Activo)
            {
                <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 16px;background:rgba(16,185,129,0.2);border:1px solid rgba(16,185,129,0.4);border-radius:100px;font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#10B981;">
                    <i data-lucide="check-circle" style="width:12px;height:12px;"></i> Activo
                </span>
            }
            else
            {
                <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 16px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);border-radius:100px;font-size:0.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.5);">
                    <i data-lucide="x-circle" style="width:12px;height:12px;"></i> Inactivo
                </span>
            }
        </div>

        <div style="padding:24px 28px;display:flex;flex-direction:column;gap:20px;">
            <!-- Image -->
            <div style="display:flex;justify-content:center;">
                @if (!string.IsNullOrEmpty(Model.ImagenBase64))
                {
                    <div style="width:220px;height:220px;border-radius:16px;overflow:hidden;border:2px solid rgba(30,111,227,0.2);">
                        <img src="@Model.ImagenBase64" alt="@Model.Nombre" style="width:100%;height:100%;object-fit:cover;">
                    </div>
                }
                else
                {
                    <div style="width:220px;height:220px;border-radius:16px;background:rgba(30,111,227,0.05);border:1px solid rgba(30,111,227,0.15);display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="package" style="width:72px;height:72px;color:rgba(30,111,227,0.25);"></i>
                    </div>
                }
            </div>

            <!-- Fields grid -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="field-box">
                    <p class="field-label">Nombre</p>
                    <p class="field-value">@Model.Nombre</p>
                </div>
                <div class="field-box">
                    <p class="field-label">Categoría</p>
                    <p class="field-value">@(string.IsNullOrEmpty(Model.Categoria) ? "Sin categoría" : Model.Categoria)</p>
                </div>
                <div class="field-box" style="border-color:rgba(16,185,129,0.2);background:rgba(16,185,129,0.04);">
                    <p class="field-label" style="color:rgba(16,185,129,0.6);">Precio</p>
                    <p class="field-value" style="font-size:1.6rem;font-weight:900;color:#10B981;">$@Model.Precio.ToString("N2")</p>
                </div>
                <div class="field-box" style="border-color:rgba(30,111,227,0.2);background:rgba(30,111,227,0.04);">
                    <p class="field-label" style="color:rgba(30,111,227,0.6);">Stock Disponible</p>
                    <p class="field-value" style="font-size:1.6rem;font-weight:900;color:#3D8EFF;">@Model.Stock</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.Descripcion))
                {
                    <div class="field-box" style="grid-column:1/-1;">
                        <p class="field-label">Descripción</p>
                        <p class="field-value" style="font-size:0.88rem;color:rgba(255,255,255,0.7);">@Model.Descripcion</p>
                    </div>
                }
                <div class="field-box">
                    <p class="field-label">Fecha de Creación</p>
                    <p class="field-value" style="font-size:0.85rem;">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="field-box">
                    <p class="field-label">Última Actualización</p>
                    <p class="field-value" style="font-size:0.85rem;">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <!-- Actions -->
            <div style="display:flex;gap:12px;padding-top:16px;border-top:1px solid rgba(30,111,227,0.12);">
                <a href="/productos/editar/@Model.Id"
                   style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border-radius:12px;text-decoration:none;transition:opacity .2s;"
                   onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
                    <i data-lucide="edit" style="width:16px;height:16px;"></i> Editar Producto
                </a>
                <a href="/productos"
                   style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.5);font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border:1px solid rgba(255,255,255,0.08);border-radius:12px;text-decoration:none;transition:all .15s;"
                   onmouseover="this.style.background='rgba(255,255,255,0.08)';this.style.color='rgba(255,255,255,0.8)'" onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.color='rgba(255,255,255,0.5)'">
                    <i data-lucide="arrow-left" style="width:16px;height:16px;"></i> Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}

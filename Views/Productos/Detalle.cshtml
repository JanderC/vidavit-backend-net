@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detalle de Producto";
    ViewData["Subtitle"] = "Información completa del producto";
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
        <div class="bg-gradient-to-r from-blue-700 to-blue-900 p-8">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-3xl font-black text-white mb-2 uppercase tracking-wide">Detalle de Producto</h2>
                    <p class="text-white opacity-90 font-bold">@Model.Nombre</p>
                </div>
                <div class="text-right">
                    @if (Model.Activo)
                    {
                        <span class="inline-flex items-center px-6 py-3 bg-yellow-500 text-white rounded-full font-black uppercase tracking-wide shadow-xl">
                            <i data-lucide="check-circle" class="w-5 h-5 mr-2"></i>
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-6 py-3 bg-gray-500 text-white rounded-full font-black uppercase tracking-wide shadow-xl">
                            <i data-lucide="x-circle" class="w-5 h-5 mr-2"></i>
                            Inactivo
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                <div class="md:col-span-2 flex justify-center">
                    @if (!string.IsNullOrEmpty(Model.ImagenBase64))
                    {
                        <div class="w-64 h-64 bg-gray-100 rounded-2xl overflow-hidden shadow-lg">
                            <img src="@Model.ImagenBase64" alt="@Model.Nombre" class="w-full h-full object-cover">
                        </div>
                    }
                    else
                    {
                        <div class="w-64 h-64 bg-gray-100 rounded-2xl flex items-center justify-center shadow-lg">
                            <i data-lucide="package" class="w-24 h-24 text-gray-400"></i>
                        </div>
                    }
                </div>

                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <p class="text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Nombre</p>
                    <p class="text-xl font-bold text-gray-900">@Model.Nombre</p>
                </div>

                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <p class="text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Categoría</p>
                    <p class="text-xl font-bold text-gray-900">@(string.IsNullOrEmpty(Model.Categoria) ? "Sin categoría" : Model.Categoria)</p>
                </div>

                <div class="bg-yellow-50 p-6 rounded-xl border-2 border-yellow-300">
                    <p class="text-sm font-black text-yellow-800 uppercase tracking-wide mb-2">Precio</p>
                    <p class="text-3xl font-black text-yellow-600">$@Model.Precio.ToString("N2")</p>
                </div>

                <div class="bg-blue-50 p-6 rounded-xl border-2 border-blue-300">
                    <p class="text-sm font-black text-blue-800 uppercase tracking-wide mb-2">Stock Disponible</p>
                    <p class="text-3xl font-black text-blue-600">@Model.Stock</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Descripcion))
                {
                    <div class="md:col-span-2 bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                        <p class="text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Descripción</p>
                        <p class="text-gray-800 font-semibold">@Model.Descripcion</p>
                    </div>
                }

                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <p class="text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Fecha de Creación</p>
                    <p class="text-gray-900 font-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <p class="text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Última Actualización</p>
                    <p class="text-gray-900 font-bold">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <div class="flex gap-4 pt-6 border-t-2 border-gray-200">
                <a href="/productos/editar/@Model.Id"
                   class="flex-1 bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-black py-4 px-6 rounded-xl transition-all shadow-xl hover:shadow-2xl text-center uppercase tracking-wide flex items-center justify-center gap-2">
                    <i data-lucide="edit" class="w-5 h-5"></i>
                    Editar Producto
                </a>
                <a href="/productos"
                   class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 font-black py-4 px-6 rounded-xl transition-all text-center uppercase tracking-wide flex items-center justify-center gap-2">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                    Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}

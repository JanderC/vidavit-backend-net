@{
    ViewData["Title"] = "Vender Productos";
    ViewData["Subtitle"] = "Punto de venta - Power Fitness";
    Layout = "_AdminLayout";
}

<style>
    :root{--pf-blue:#3B82F6;--pf-blueB:#60A5FA;--pf-deep:#1E3A8A;--pf-purple:#7C3AED;--pf-card:#0D1526;--pf-border:#1E2D4A;--pf-text:#E2E8F0;--pf-soft:#94A3B8;--pf-muted:#64748B;--pf-green:#10B981;--pf-red:#EF4444;--pf-orange:#F59E0B;}
    .pf-input{width:100%;padding:.75rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:rgba(255,255,255,.03);color:var(--pf-text);font-weight:600;font-family:inherit;font-size:.9rem;outline:none;box-sizing:border-box;transition:border-color .2s;}
    .pf-input:focus{border-color:var(--pf-blue);}
    .pf-input::placeholder{color:var(--pf-muted);font-weight:400;}
    .pf-select{width:100%;padding:.75rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:var(--pf-card);color:var(--pf-text);font-weight:600;font-family:inherit;outline:none;box-sizing:border-box;}
    .pf-section{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;padding:1.25rem;}
    .pf-section-title{font-size:.85rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.1em;margin:0 0 1rem 0;}
    .tipo-pago-opt{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.1rem;background:rgba(255,255,255,.03);border:2px solid var(--pf-border);border-radius:.875rem;cursor:pointer;flex:1;transition:border-color .2s,background .2s;}
    .tipo-pago-opt input[type="radio"]{accent-color:var(--pf-blue);width:18px;height:18px;flex-shrink:0;}
</style>

<div style="max-width:72rem;margin:0 auto;">
    <div style="background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1.25rem;padding:2rem;box-shadow:0 4px 24px rgba(0,0,0,.4);">

        <!-- Header -->
        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding-bottom:1.25rem;border-bottom:1px solid var(--pf-border);">
            <div style="background:linear-gradient(135deg,var(--pf-green),#065F46);border-radius:.875rem;padding:1rem;flex-shrink:0;">
                <i data-lucide="shopping-cart" style="width:32px;height:32px;color:#fff;"></i>
            </div>
            <div>
                <h2 style="font-size:1.5rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.06em;margin:0 0 .2rem 0;">Venta de Productos</h2>
                <p style="font-size:.8rem;color:var(--pf-muted);font-weight:600;margin:0;">Con opción de pago parcial o fiado</p>
            </div>
        </div>

        <!-- Cliente -->
        <div class="pf-section" style="margin-bottom:1.25rem;border-left:3px solid var(--pf-blue);">
            <p class="pf-section-title" style="color:var(--pf-blueB);">Cliente (Opcional)</p>
            <p style="font-size:.78rem;color:var(--pf-muted);font-weight:600;margin-bottom:.875rem;">Deja vacío para venta rápida sin cliente</p>
            <div style="margin-bottom:.75rem;position:relative;">
                <input type="text" id="buscarClienteInput" placeholder="Buscar por nombre, apellido o cédula..." class="pf-input">
                <div id="resultadosBusqueda" class="hidden" style="position:absolute;z-index:10;top:100%;left:0;right:0;margin-top:.25rem;background:var(--pf-card);border:1px solid var(--pf-border);border-radius:.875rem;box-shadow:0 12px 32px rgba(0,0,0,.5);max-height:14rem;overflow-y:auto;"></div>
            </div>
            <div id="clienteInfo" class="hidden">
                <div style="display:flex;align-items:center;gap:.875rem;padding:1rem 1.25rem;background:rgba(59,130,246,.07);border:1px solid rgba(59,130,246,.2);border-radius:.875rem;">
                    <div style="width:42px;height:42px;background:rgba(59,130,246,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i data-lucide="user" style="width:20px;height:20px;color:var(--pf-blueB);"></i>
                    </div>
                    <div style="flex:1;">
                        <p style="font-weight:900;color:var(--pf-text);margin:0 0 .15rem 0;" id="clienteNombre"></p>
                        <p style="font-size:.78rem;color:var(--pf-muted);font-weight:700;margin:0;" id="clienteCedula"></p>
                    </div>
                    <button id="btnCambiarCliente" style="padding:.5rem 1rem;background:rgba(255,255,255,.06);border:1px solid var(--pf-border);color:var(--pf-soft);border-radius:.625rem;font-weight:800;font-size:.78rem;text-transform:uppercase;cursor:pointer;font-family:inherit;">Quitar</button>
                </div>
            </div>
        </div>

        <!-- Productos disponibles -->
        <div class="pf-section" style="margin-bottom:1.25rem;">
            <p class="pf-section-title">Productos Disponibles</p>
            <input type="text" id="buscarProducto" placeholder="Buscar producto..." class="pf-input" style="margin-bottom:1rem;">
            <div id="productosGrid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:.875rem;max-height:22rem;overflow-y:auto;">
                <div style="grid-column:span 4;text-align:center;padding:2rem;color:var(--pf-muted);">
                    <i data-lucide="loader" style="width:32px;height:32px;display:block;margin:0 auto .75rem;color:var(--pf-blue);"></i>
                    <p style="font-weight:700;margin:0;">Cargando productos...</p>
                </div>
            </div>
        </div>

        <!-- Carrito -->
        <div class="pf-section" style="margin-bottom:1.25rem;border-left:3px solid var(--pf-green);">
            <p class="pf-section-title" style="color:var(--pf-green);">Carrito de Compra</p>
            <div id="carritoItems" style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.25rem;">
                <p style="color:var(--pf-muted);text-align:center;padding:1rem;font-weight:600;">No hay productos en el carrito</p>
            </div>
            <div style="border-top:1px solid var(--pf-border);padding-top:1rem;display:flex;justify-content:space-between;align-items:center;">
                <span style="font-size:1.1rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.08em;">Total:</span>
                <span id="totalCarrito" style="font-size:1.5rem;font-weight:900;color:var(--pf-green);">$0.00</span>
            </div>
        </div>

        <!-- Forma de pago -->
        <div class="pf-section" style="margin-bottom:1.5rem;border-left:3px solid var(--pf-orange);">
            <p class="pf-section-title" style="color:var(--pf-orange);">Forma de Pago</p>
            <div style="display:flex;gap:.75rem;margin-bottom:1rem;">
                <label class="tipo-pago-opt">
                    <input type="radio" name="tipoPago" value="pagado" checked>
                    <div><p style="font-weight:800;color:var(--pf-text);margin:0 0 .1rem 0;font-size:.85rem;">Pago Completo</p><p style="font-size:.72rem;color:var(--pf-muted);margin:0;">100% del total</p></div>
                </label>
                <label class="tipo-pago-opt">
                    <input type="radio" name="tipoPago" value="parcial">
                    <div><p style="font-weight:800;color:var(--pf-text);margin:0 0 .1rem 0;font-size:.85rem;">Pago Parcial</p><p style="font-size:.72rem;color:var(--pf-muted);margin:0;">Abono + Deuda</p></div>
                </label>
                <label class="tipo-pago-opt">
                    <input type="radio" name="tipoPago" value="fiado">
                    <div><p style="font-weight:800;color:var(--pf-text);margin:0 0 .1rem 0;font-size:.85rem;">Fiado Completo</p><p style="font-size:.72rem;color:var(--pf-muted);margin:0;">Todo a deuda</p></div>
                </label>
            </div>

            <div style="margin-bottom:1rem;">
                <label style="font-size:.7rem;font-weight:800;color:var(--pf-soft);text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:.5rem;">Método de Pago</label>
                <select id="metodoPago" class="pf-select">
                    <option value="efectivo">Efectivo</option>
                    <option value="transferencia">Transferencia</option>
                </select>
            </div>

            <div id="montoPagadoContainer" class="hidden" style="margin-bottom:1rem;padding:1rem;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.25);border-radius:.875rem;">
                <label style="font-size:.7rem;font-weight:800;color:var(--pf-orange);text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:.5rem;">Monto a Pagar Ahora</label>
                <div style="display:flex;gap:1rem;align-items:flex-end;">
                    <div style="flex:1;">
                        <input type="number" id="montoPagado" step="0.01" min="0" placeholder="0.00" class="pf-input" style="font-size:1.1rem;">
                    </div>
                    <div style="flex:1;">
                        <p style="font-size:.72rem;color:var(--pf-muted);font-weight:700;margin:0 0 .25rem 0;">Saldo a Deber:</p>
                        <p id="saldoPendiente" style="font-size:1.4rem;font-weight:900;color:var(--pf-red);margin:0;">$0.00</p>
                    </div>
                </div>
            </div>

            <div>
                <label style="font-size:.7rem;font-weight:800;color:var(--pf-soft);text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:.5rem;">Notas</label>
                <textarea id="notasVenta" rows="2" placeholder="Observaciones adicionales..." class="pf-input" style="resize:none;"></textarea>
            </div>
        </div>

        <!-- Botones -->
        <div style="display:flex;gap:.875rem;">
            <button id="btnRegistrarVenta"
                    style="flex:1;background:linear-gradient(135deg,var(--pf-green),#065F46);color:#fff;font-weight:800;padding:1rem;border:none;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.9rem;text-transform:uppercase;letter-spacing:.08em;box-shadow:0 4px 20px rgba(16,185,129,.3);display:flex;align-items:center;justify-content:center;gap:.5rem;transition:transform .2s;"
                    onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                <i data-lucide="check-circle" style="width:18px;height:18px;"></i> Registrar Venta
            </button>
            <button id="btnLimpiar"
                    style="padding:1rem 1.75rem;background:rgba(255,255,255,.05);border:1px solid var(--pf-border);color:var(--pf-soft);font-weight:800;border-radius:.875rem;cursor:pointer;font-family:inherit;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;display:flex;align-items:center;gap:.5rem;transition:background .2s;"
                    onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">
                <i data-lucide="x-circle" style="width:16px;height:16px;"></i> Limpiar
            </button>
            <a href="/productos"
               style="padding:1rem 1.75rem;background:rgba(255,255,255,.05);border:1px solid var(--pf-border);color:var(--pf-soft);font-weight:800;border-radius:.875rem;text-decoration:none;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;display:flex;align-items:center;gap:.5rem;transition:background .2s;"
               onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">Cancelar</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let productos=[], clientes=[], carrito=[], clienteSeleccionado=null;

        async function cargarDatos() {
            try {
                const [cr,pr] = await Promise.all([fetch('/api/Clientes'),fetch('/api/Productos')]);
                clientes = await cr.json(); productos = await pr.json();
                renderProductos(productos);
            } catch(e) { console.error('Error:',e); alert('⚠ Error al cargar datos del sistema'); }
        }

        document.getElementById('buscarClienteInput').addEventListener('input', function(e) {
            const t=e.target.value.toLowerCase().trim(), r=document.getElementById('resultadosBusqueda');
            if (t.length<2) { r.classList.add('hidden'); return; }
            const m = clientes.filter(c=>(c.Nombre||c.nombre||'').toLowerCase().includes(t)||(c.Apellido||c.apellido||'').toLowerCase().includes(t)||(c.Cedula||c.cedula||'').includes(t)).slice(0,5);
            if (m.length>0) {
                r.innerHTML = m.map(c=>`<div onclick='seleccionarCliente(${JSON.stringify(c).replace(/'/g,"&apos;")})' style="display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;cursor:pointer;border-bottom:1px solid #1E2D4A;transition:background .15s;" onmouseover="this.style.background='rgba(59,130,246,.07)'" onmouseout="this.style.background='transparent'">
                    <div style="width:32px;height:32px;background:rgba(59,130,246,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i data-lucide="user" style="width:16px;height:16px;color:#60A5FA;"></i></div>
                    <div><p style="font-weight:800;color:#E2E8F0;margin:0 0 .1rem 0;">${c.Nombre||c.nombre} ${c.Apellido||c.apellido}</p><p style="font-size:.75rem;color:#64748B;margin:0;">Cédula: ${c.Cedula||c.cedula}</p></div></div>`).join('');
                r.classList.remove('hidden'); lucide.createIcons();
            } else { r.innerHTML='<p style="padding:1rem;color:#64748B;text-align:center;font-weight:600;">No se encontraron clientes</p>'; r.classList.remove('hidden'); }
        });

        function seleccionarCliente(c) {
            const id=c.Id||c.id, nombre=c.Nombre||c.nombre, apellido=c.Apellido||c.apellido, cedula=c.Cedula||c.cedula;
            clienteSeleccionado={id,nombre,apellido,cedula,...c};
            document.getElementById('buscarClienteInput').value='';
            document.getElementById('resultadosBusqueda').classList.add('hidden');
            document.getElementById('clienteNombre').textContent=`${nombre} ${apellido}`;
            document.getElementById('clienteCedula').textContent=`Cédula: ${cedula}`;
            document.getElementById('clienteInfo').classList.remove('hidden');
        }
        document.getElementById('btnCambiarCliente').addEventListener('click',()=>{ clienteSeleccionado=null; document.getElementById('clienteInfo').classList.add('hidden'); });

        document.getElementById('buscarProducto').addEventListener('input',function(e){
            const t=e.target.value.toLowerCase();
            renderProductos(productos.filter(p=>(p.Nombre||p.nombre||'').toLowerCase().includes(t)&&(p.Activo!==undefined?p.Activo:p.activo)));
        });

        function renderProductos(lista) {
            const g=document.getElementById('productosGrid');
            g.innerHTML = lista.map(p=>{
                const precio=p.Precio!==undefined?p.Precio:(p.precio||0), stock=p.Stock!==undefined?p.Stock:(p.stock||0);
                const nombre=p.Nombre||p.nombre||'Sin nombre', img=p.ImagenBase64||p.imagenBase64||null;
                return `<div style="background:rgba(255,255,255,.03);border:1px solid #1E2D4A;border-radius:.875rem;padding:1rem;${stock===0?'opacity:.5':''}">
                    <div style="aspect-ratio:1;background:rgba(59,130,246,.06);border-radius:.625rem;margin-bottom:.75rem;overflow:hidden;display:flex;align-items:center;justify-content:center;">
                        ${img?`<img src="${img}" style="width:100%;height:100%;object-fit:cover;">`:`<i data-lucide="package" style="width:40px;height:40px;color:#1E2D4A;"></i>`}
                    </div>
                    <h4 style="font-weight:800;font-size:.82rem;color:#E2E8F0;margin:0 0 .2rem 0;">${nombre}</h4>
                    <p style="font-size:.72rem;color:#64748B;margin:0 0 .5rem 0;">Stock: ${stock}</p>
                    <p style="font-size:1.05rem;font-weight:900;color:#10B981;margin:0 0 .75rem 0;">$${precio.toFixed(2)}</p>
                    <button onclick='agregarAlCarrito(${JSON.stringify(p).replace(/'/g,"&apos;")})' ${stock===0?'disabled':''}
                            style="width:100%;padding:.5rem;background:${stock===0?'rgba(100,116,139,.1)':'linear-gradient(135deg,#10B981,#065F46)'};color:${stock===0?'#64748B':'#fff'};border:none;border-radius:.5rem;font-weight:800;font-size:.75rem;text-transform:uppercase;cursor:${stock===0?'not-allowed':'pointer'};font-family:inherit;">
                        ${stock===0?'Sin Stock':'Agregar'}
                    </button></div>`;
            }).join('');
            lucide.createIcons();
        }

        function agregarAlCarrito(p) {
            const precio=p.Precio!==undefined?p.Precio:(p.precio||0), stock=p.Stock!==undefined?p.Stock:(p.stock||0), id=p.Id||p.id, nombre=p.Nombre||p.nombre;
            const ex=carrito.find(i=>i.producto.id===id);
            if (ex) { if(ex.cantidad<stock){ex.cantidad++;ex.total=ex.cantidad*ex.precioUnitario;}else{alert('⚠ No hay más stock disponible');} }
            else carrito.push({producto:{...p,id,precio,stock,nombre},cantidad:1,precioUnitario:precio,total:precio});
            renderCarrito();
        }

        function renderCarrito() {
            const c=document.getElementById('carritoItems');
            if (carrito.length===0) { c.innerHTML='<p style="color:#64748B;text-align:center;padding:1rem;font-weight:600;">No hay productos en el carrito</p>'; document.getElementById('totalCarrito').textContent='$0.00'; calcularSaldo(); return; }
            let total=0;
            c.innerHTML=carrito.map(item=>{total+=item.total; return `
                <div style="display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;background:rgba(255,255,255,.03);border:1px solid #1E2D4A;border-radius:.75rem;">
                    <div style="flex:1;"><p style="font-weight:800;font-size:.85rem;color:#E2E8F0;margin:0 0 .1rem 0;">${item.producto.nombre}</p><p style="font-size:.72rem;color:#64748B;margin:0;">$${item.precioUnitario.toFixed(2)} c/u</p></div>
                    <div style="display:flex;align-items:center;gap:.5rem;">
                        <button onclick="cambiarCantidad('${item.producto.id}',${item.cantidad-1})" style="width:32px;height:32px;background:rgba(255,255,255,.06);border:1px solid #1E2D4A;border-radius:.5rem;color:#E2E8F0;font-weight:900;cursor:pointer;">-</button>
                        <span style="width:36px;text-align:center;font-weight:900;color:#E2E8F0;">${item.cantidad}</span>
                        <button onclick="cambiarCantidad('${item.producto.id}',${item.cantidad+1})" style="width:32px;height:32px;background:rgba(255,255,255,.06);border:1px solid #1E2D4A;border-radius:.5rem;color:#E2E8F0;font-weight:900;cursor:pointer;">+</button>
                    </div>
                    <p style="font-weight:900;color:#10B981;font-size:.95rem;width:80px;text-align:right;">$${item.total.toFixed(2)}</p>
                    <button onclick="eliminarDelCarrito('${item.producto.id}')" style="padding:.4rem;color:#EF4444;background:transparent;border:none;cursor:pointer;margin-left:.5rem;border-radius:.4rem;transition:background .15s;" onmouseover="this.style.background='rgba(239,68,68,.1)'" onmouseout="this.style.background='transparent'">
                        <i data-lucide="trash-2" style="width:16px;height:16px;"></i>
                    </button>
                </div>`;}).join('');
            document.getElementById('totalCarrito').textContent=`$${total.toFixed(2)}`;
            calcularSaldo(); lucide.createIcons();
        }

        function cambiarCantidad(id,n) { const i=carrito.find(x=>x.producto.id===id); if(i&&n>=1&&n<=i.producto.stock){i.cantidad=n;i.total=n*i.precioUnitario;renderCarrito();}else if(i&&n>i.producto.stock){alert('⚠ No hay suficiente stock');} }
        function eliminarDelCarrito(id) { carrito=carrito.filter(i=>i.producto.id!==id); renderCarrito(); }

        document.querySelectorAll('input[name="tipoPago"]').forEach(r=>{
            r.addEventListener('change',function(){
                const c=document.getElementById('montoPagadoContainer');
                this.value==='parcial'?c.classList.remove('hidden'):c.classList.add('hidden');
                document.querySelectorAll('.tipo-pago-opt').forEach(o=>{ o.style.borderColor='#1E2D4A'; o.style.background='rgba(255,255,255,.03)'; });
                this.closest('.tipo-pago-opt').style.borderColor=this.value==='pagado'?'#10B981':this.value==='parcial'?'#F59E0B':'#EF4444';
                this.closest('.tipo-pago-opt').style.background=this.value==='pagado'?'rgba(16,185,129,.07)':this.value==='parcial'?'rgba(245,158,11,.07)':'rgba(239,68,68,.07)';
            });
        });

        document.getElementById('montoPagado')?.addEventListener('input',calcularSaldo);
        function calcularSaldo() {
            const total=carrito.reduce((s,i)=>s+i.total,0), m=parseFloat(document.getElementById('montoPagado')?.value||0);
            const el=document.getElementById('saldoPendiente'); if(el) el.textContent=`$${Math.max(0,total-m).toFixed(2)}`;
        }

        document.getElementById('btnRegistrarVenta').addEventListener('click', async function() {
            if (carrito.length===0) { alert('⚠ Debe agregar productos al carrito'); return; }
            const tipo=document.querySelector('input[name="tipoPago"]:checked').value;
            const notas=document.getElementById('notasVenta').value;
            const total=carrito.reduce((s,i)=>s+i.total,0);
            let montoPagado=total, msg='';
            if (tipo==='fiado') { montoPagado=0; msg=`¿Confirmar venta FIADA por $${total.toFixed(2)}? Se registrará como deuda.`; }
            else if (tipo==='parcial') {
                montoPagado=parseFloat(document.getElementById('montoPagado').value||0);
                if (montoPagado<=0||montoPagado>total) { alert('⚠ El monto debe ser mayor a 0 y menor o igual al total'); return; }
                msg=`¿Confirmar venta con PAGO PARCIAL?\nPaga ahora: $${montoPagado.toFixed(2)}\nQueda a deber: $${(total-montoPagado).toFixed(2)}`;
            } else { msg=`¿Confirmar venta PAGADA por $${total.toFixed(2)}?`; }
            if (!confirm(msg)) return;
            try {
                for (const item of carrito) {
                    const venta={clienteId:clienteSeleccionado?clienteSeleccionado.id:null,productoId:item.producto.id,cantidad:item.cantidad,precioUnitario:item.precioUnitario,total:item.total,montoPagado:tipo==='pagado'?item.total:(montoPagado*(item.total/total)),estadoPago:tipo,notas:notas||null,usuarioId:null,metodoPago:document.getElementById('metodoPago')?.value||'efectivo'};
                    const r=await fetch('/api/VentasProductos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(venta)});
                    const res=await r.json(); if(!res.success) throw new Error(res.message||'Error al registrar venta');
                }
                alert('✓ Venta registrada exitosamente'); limpiar(); await cargarDatos(); window.location.href='/productos';
            } catch(e) { alert('⚠ Error al registrar la venta: '+e.message); }
        });

        document.getElementById('btnLimpiar').addEventListener('click',limpiar);
        function limpiar() {
            carrito=[]; clienteSeleccionado=null;
            document.getElementById('clienteInfo').classList.add('hidden');
            document.getElementById('buscarClienteInput').value='';
            document.getElementById('notasVenta').value='';
            document.getElementById('buscarProducto').value='';
            document.getElementById('montoPagado').value='';
            document.getElementById('montoPagadoContainer').classList.add('hidden');
            document.querySelector('input[name="tipoPago"][value="pagado"]').checked=true;
            document.querySelectorAll('.tipo-pago-opt').forEach(o=>{o.style.borderColor='#1E2D4A';o.style.background='rgba(255,255,255,.03)';});
            renderCarrito(); renderProductos(productos);
        }

        document.addEventListener('click',e=>{ if(!e.target.closest('#buscarClienteInput')&&!e.target.closest('#resultadosBusqueda')) document.getElementById('resultadosBusqueda').classList.add('hidden'); });

        window.agregarAlCarrito=agregarAlCarrito; window.cambiarCantidad=cambiarCantidad; window.eliminarDelCarrito=eliminarDelCarrito; window.seleccionarCliente=seleccionarCliente;
        cargarDatos(); lucide.createIcons();
    </script>
}

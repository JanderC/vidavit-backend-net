@{
    ViewData["Title"] = "Crear Producto";
}

<div class="max-w-4xl mx-auto p-6">
    <div class="bg-white rounded-xl shadow-lg p-8">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Nuevo Producto</h2>

        <form id="productoForm" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Nombre -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre *</label>
                    <input type="text" name="nombre" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                </div>

                <!-- Categoría -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Categoría</label>
                    <select name="categoria"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                        <option value="suplementos">Suplementos</option>
                        <option value="bebidas">Bebidas</option>
                        <option value="snacks">Snacks</option>
                        <option value="accesorios">Accesorios</option>
                        <option value="otros">Otros</option>
                    </select>
                </div>

                <!-- Precio -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Precio *</label>
                    <input type="number" step="0.01" name="precio" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                </div>

                <!-- Stock -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Stock *</label>
                    <input type="number" name="stock" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary">
                </div>
            </div>

            <!-- Descripción -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Descripción</label>
                <textarea name="descripcion" rows="3"
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary"></textarea>
            </div>

            <!-- Imagen (opcional) -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Imagen del Producto</label>
                <input type="file" id="imagenInput" accept="image/*"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg">
                <input type="hidden" name="imagenBase64" id="imagenBase64">
            </div>

            <!-- Botones -->
            <div class="flex gap-4">
                <button type="submit"
                        class="flex-1 bg-vida-primary text-vida-dark font-bold py-3 px-6 rounded-lg hover:bg-yellow-400 transition">
                    Crear Producto
                </button>
                <a href="/productos"
                   class="flex-1 bg-gray-300 text-gray-700 font-bold py-3 px-6 rounded-lg hover:bg-gray-400 transition text-center">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Convertir imagen a Base64
        document.getElementById('imagenInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagenBase64').value = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        // Enviar formulario
        document.getElementById('productoForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const formData = new FormData(e.target);
            const data = {
                nombre: formData.get('nombre'),
                descripcion: formData.get('descripcion') || null,
                precio: parseFloat(formData.get('precio')),
                stock: parseInt(formData.get('stock')),
                categoria: formData.get('categoria'),
                imagenBase64: formData.get('imagenBase64') || null
            };

            try {
                const response = await fetch('/api/Productos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    alert('Producto creado exitosamente');
                    window.location.href = '/productos';
                } else {
                    alert('Error al crear producto');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al crear producto');
            }
        });
    </script>
}
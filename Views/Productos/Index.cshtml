@model IEnumerable<VidaFitBackend.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    ViewData["Subtitle"] = "Gestión de productos - POWER ZONE FIT TRAINER";
    Layout = "_AdminLayout";
}

<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-4xl font-black text-gray-900 uppercase tracking-wide">Gestión de Productos</h2>
        <div class="flex gap-3">
            <a href="/productos/crear"
               class="bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-black py-3 px-8 rounded-xl transition-all shadow-xl hover:shadow-2xl flex items-center gap-2 uppercase tracking-wide transform hover:scale-105">
                <i data-lucide="plus-circle" class="w-5 h-5"></i>
                Nuevo Producto
            </a>
            <a href="/productos/vender"
               class="bg-gradient-to-r from-emerald-600 to-emerald-800 hover:from-emerald-700 hover:to-emerald-900 text-white font-black py-3 px-8 rounded-xl transition-all shadow-xl hover:shadow-2xl flex items-center gap-2 uppercase tracking-wide transform hover:scale-105">
                <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                Vender Productos
            </a>
            <a href="/productos/cuentas-pendientes"
               class="bg-gradient-to-r from-orange-600 to-orange-800 hover:from-orange-700 hover:to-orange-900 text-white font-black py-3 px-8 rounded-xl transition-all shadow-xl hover:shadow-2xl flex items-center gap-2 uppercase tracking-wide transform hover:scale-105">
                <i data-lucide="alert-circle" class="w-5 h-5"></i>
                Cuentas Pendientes
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-6 mb-6 border-2 border-gray-200">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Buscar</label>
                <input type="text" id="buscarProducto" placeholder="Nombre o categoría..."
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 font-semibold">
            </div>
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Categoría</label>
                <select id="filtroCategoria"
                        class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 font-semibold bg-white">
                    <option value="">Todas</option>
                    <option value="suplementos">Suplementos</option>
                    <option value="bebidas">Bebidas</option>
                    <option value="snacks">Snacks</option>
                    <option value="accesorios">Accesorios</option>
                    <option value="otros">Otros</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Estado</label>
                <select id="filtroEstado"
                        class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 font-semibold bg-white">
                    <option value="">Todos</option>
                    <option value="activo">Activos</option>
                    <option value="inactivo">Inactivos</option>
                    <option value="sin-stock">Sin Stock</option>
                </select>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
        <table class="min-w-full divide-y-2 divide-gray-200">
            <thead class="bg-gradient-to-r from-gray-900 to-black">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Imagen</th>
                    <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Producto</th>
                    <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Categoría</th>
                    <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Precio</th>
                    <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Stock</th>
                    <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Estado</th>
                    <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y-2 divide-gray-200" id="productosTable">
                @foreach (var producto in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors producto-row"
                        data-nombre="@producto.Nombre.ToLower()"
                        data-categoria="@producto.Categoria?.ToLower()"
                        data-activo="@producto.Activo.ToString().ToLower()"
                        data-stock="@producto.Stock">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="w-16 h-16 bg-gray-200 rounded-xl flex items-center justify-center overflow-hidden border-2 border-gray-300">
                                @if (!string.IsNullOrEmpty(producto.ImagenBase64))
                                {
                                    <img src="@producto.ImagenBase64" class="w-full h-full object-cover" alt="@producto.Nombre">
                                }
                                else
                                {
                                    <i data-lucide="package" class="w-8 h-8 text-gray-400"></i>
                                }
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm font-black text-gray-900">@producto.Nombre</div>
                            <div class="text-sm text-gray-600 font-semibold">@producto.Descripcion</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-black rounded-full bg-blue-100 text-blue-800 uppercase tracking-wide">
                                @producto.Categoria
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-black text-emerald-600 text-lg">$@producto.Precio.ToString("N2")</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-black rounded-full uppercase tracking-wide @(producto.Stock > 10 ? "bg-green-100 text-green-800" : producto.Stock > 0 ? "bg-yellow-100 text-yellow-800" : "bg-blue-100 text-blue-800")">
                                @producto.Stock unidades
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-black rounded-full uppercase tracking-wide @(producto.Activo ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                                @(producto.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <div class="flex gap-2">
                                <a href="/productos/detalle/@producto.Id"
                                   class="text-blue-600 hover:text-blue-900 p-2 hover:bg-blue-50 rounded-lg transition-colors" title="Ver detalles">
                                    <i data-lucide="eye" class="w-5 h-5"></i>
                                </a>
                                <a href="/productos/editar/@producto.Id"
                                   class="text-amber-600 hover:text-amber-900 p-2 hover:bg-amber-50 rounded-lg transition-colors" title="Editar">
                                    <i data-lucide="edit" class="w-5 h-5"></i>
                                </a>
                                <button type="button" onclick="eliminarProducto('@producto.Id', '@producto.Nombre')"
                                        class="text-blue-600 hover:text-blue-900 p-2 hover:bg-blue-50 rounded-lg transition-colors cursor-pointer border-0 bg-transparent" title="Eliminar">
                                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('buscarProducto').addEventListener('input', filtrarProductos);
        document.getElementById('filtroCategoria').addEventListener('change', filtrarProductos);
        document.getElementById('filtroEstado').addEventListener('change', filtrarProductos);

        function filtrarProductos() {
            const busqueda = document.getElementById('buscarProducto').value.toLowerCase();
            const categoria = document.getElementById('filtroCategoria').value.toLowerCase();
            const estado = document.getElementById('filtroEstado').value.toLowerCase();

            const rows = document.querySelectorAll('.producto-row');

            rows.forEach(row => {
                const nombre = row.dataset.nombre;
                const cat = row.dataset.categoria;
                const activo = row.dataset.activo === 'true';
                const stock = parseInt(row.dataset.stock);

                let mostrar = true;

                if (busqueda && !nombre.includes(busqueda) && !cat.includes(busqueda)) {
                    mostrar = false;
                }

                if (categoria && cat !== categoria) {
                    mostrar = false;
                }

                if (estado === 'activo' && !activo) mostrar = false;
                if (estado === 'inactivo' && activo) mostrar = false;
                if (estado === 'sin-stock' && stock > 0) mostrar = false;

                row.style.display = mostrar ? '' : 'none';
            });
        }


        async function eliminarProducto(id, nombre) {
            if (!confirm(`¿Estás seguro de que deseas eliminar el producto "${nombre}"?\n\nEsta acción no se puede deshacer.`)) {
                return;
            }

            try {
                const response = await fetch(`/api/Productos/${id}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (response.ok) {
                    alert('✅ Producto eliminado exitosamente');
                    location.reload();
                } else {
                    const error = await response.text();
                    alert('❌ Error: ' + error);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('❌ Error al eliminar el producto');
            }
        }

        window.eliminarProducto = eliminarProducto;
        lucide.createIcons();
    </script>
}

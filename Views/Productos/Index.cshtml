@model IEnumerable<VidaFitBackend.Models.Producto>
@{
    ViewData["Title"] = "Productos";
    ViewData["Subtitle"] = "Gestión de productos - PowerZone";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --pz-blue: #2B4FD8;
        --pz-blue-dark: #1a3ab5;
        --pz-gold: #D4A017;
        --pz-gold-dark: #b8880e;
        --pz-border: rgba(43,79,216,0.18);
        --pz-text: #0f1535;
        --pz-muted: #4a5a8a;
        --pz-white: #ffffff;
    }

    .pz-page {
        background: linear-gradient(135deg, #f5f7ff 0%, #eef1ff 100%);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .pz-card {
        background: var(--pz-white);
        border: 1px solid var(--pz-border);
        border-radius: 1rem;
        box-shadow: 0 2px 12px rgba(43,79,216,0.08);
    }

    .pz-label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        color: var(--pz-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .pz-input {
        width: 100%;
        background: #f5f7ff;
        border: 2px solid var(--pz-border);
        color: var(--pz-text);
        border-radius: .6rem;
        padding: .75rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s, box-shadow .2s;
    }

        .pz-input:focus {
            border-color: #D4A017;
            box-shadow: 0 0 0 3px rgba(212,160,23,0.15);
        }

        .pz-input::placeholder {
            color: #8899bb;
        }

    select.pz-input option {
        background: #fff;
        color: var(--pz-text);
    }

    .pz-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .7rem 1.4rem;
        border-radius: .6rem;
        font-weight: 800;
        font-size: .875rem;
        border: none;
        cursor: pointer;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: .06em;
        transition: opacity .2s, transform .1s;
    }

        .pz-btn:hover {
            opacity: .88;
            transform: translateY(-1px);
        }

    .pz-btn-blue {
        background: linear-gradient(135deg, #2B4FD8, #1a3ab5);
        color: #fff;
    }

    .pz-btn-gold {
        background: linear-gradient(135deg, #D4A017, #b8880e);
        color: #fff;
    }

    .pz-btn-emerald {
        background: #059669;
        color: #fff;
    }

    .pz-btn-orange {
        background: #ea580c;
        color: #fff;
    }

    .pz-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pz-table th {
            background: linear-gradient(135deg, #0f1535, #1a2050);
            color: #D4A017;
            font-size: .75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            padding: 1rem 1.5rem;
            text-align: left;
            border-bottom: 2px solid #D4A017;
        }

        .pz-table td {
            padding: .9rem 1.5rem;
            border-bottom: 1px solid rgba(43,79,216,0.1);
            color: var(--pz-text);
            font-weight: 600;
        }

        .pz-table tr:hover td {
            background: rgba(43,79,216,0.04);
        }

        .pz-table tr:last-child td {
            border-bottom: none;
        }

    .pz-badge {
        display: inline-flex;
        align-items: center;
        padding: .25rem .7rem;
        border-radius: 9999px;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .pz-action-btn {
        padding: .5rem;
        border-radius: .5rem;
        border: none;
        cursor: pointer;
        background: transparent;
        transition: background .2s;
    }

        .pz-action-btn:hover {
            background: rgba(43,79,216,0.08);
        }
</style>

<div class="pz-page">
    <div class="max-w-7xl mx-auto space-y-5">

        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <div style="display:flex;align-items:center;gap:.75rem;">
                <div style="background:linear-gradient(135deg,#0f1535,#1a2050);padding:.5rem 1rem;border-radius:.5rem;box-shadow:0 4px 14px rgba(43,79,216,0.35);border-bottom:2px solid #D4A017;">
                    <span style="font-size:1.1rem;font-weight:900;color:#D4A017;letter-spacing:.05em;">POWER</span><span style="font-size:1.1rem;font-weight:900;color:#fff;opacity:0.85;">ZONE</span>
                </div>
                <h2 style="font-size:1.75rem;font-weight:900;color:var(--pz-text);text-transform:uppercase;letter-spacing:.04em;">Gestión de Productos</h2>
            </div>
            <div style="display:flex;gap:.75rem;flex-wrap:wrap;">
                <a href="/productos/crear" class="pz-btn pz-btn-blue">
                    <i data-lucide="plus-circle" style="width:1.1rem;height:1.1rem;"></i>
                    Nuevo Producto
                </a>
                <a href="/productos/vender" class="pz-btn pz-btn-gold">
                    <i data-lucide="shopping-cart" style="width:1.1rem;height:1.1rem;"></i>
                    Vender Productos
                </a>
                <a href="/caja" class="pz-btn pz-btn-orange">
                    <i data-lucide="alert-circle" style="width:1.1rem;height:1.1rem;"></i>
                    Ver deudas en caja
                </a>
            </div>
        </div>

        <!-- Filtros -->
        <div class="pz-card p-5">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="pz-label">Buscar</label>
                    <input type="text" id="buscarProducto" placeholder="Nombre o categoría..." class="pz-input">
                </div>
                <div>
                    <label class="pz-label">Categoría</label>
                    <select id="filtroCategoria" class="pz-input">
                        <option value="">Todas</option>
                        <option value="suplementos">Suplementos</option>
                        <option value="bebidas">Bebidas</option>
                        <option value="snacks">Snacks</option>
                        <option value="accesorios">Accesorios</option>
                        <option value="otros">Otros</option>
                    </select>
                </div>
                <div>
                    <label class="pz-label">Estado</label>
                    <select id="filtroEstado" class="pz-input">
                        <option value="">Todos</option>
                        <option value="activo">Activos</option>
                        <option value="inactivo">Inactivos</option>
                        <option value="sin-stock">Sin Stock</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="pz-card" style="overflow:hidden;">
            <table class="pz-table">
                <thead>
                    <tr>
                        <th>Imagen</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaProductos">
                    @foreach (var producto in Model)
                    {
                        <tr class="producto-row"
                            data-nombre="@producto.Nombre.ToLower()"
                            data-categoria="@producto.Categoria?.ToLower()"
                            data-activo="@producto.Activo.ToString().ToLower()"
                            data-stock="@producto.Stock">
                            <td>
                                <div style="width:3.5rem;height:3.5rem;background:rgba(43,79,216,0.06);border-radius:.6rem;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid var(--pz-border);">
                                    @if (!string.IsNullOrEmpty(producto.ImagenBase64))
                                    {
                                        <img src="@producto.ImagenBase64" style="width:100%;height:100%;object-fit:cover;" alt="@producto.Nombre">
                                    }
                                    else
                                    {
                                        <i data-lucide="package" style="width:1.5rem;height:1.5rem;color:#8899bb;"></i>
                                    }
                                </div>
                            </td>
                            <td>
                                <div style="font-weight:800;color:var(--pz-text);">@producto.Nombre</div>
                                <div style="font-size:.8rem;color:var(--pz-muted);font-weight:500;">@producto.Descripcion</div>
                            </td>
                            <td>
                                <span class="pz-badge" style="background:#dbeafe;color:#1d4ed8;border:1px solid #bfdbfe;">
                                    @producto.Categoria
                                </span>
                            </td>
                            <td>
                                <span style="font-size:1.05rem;font-weight:800;color:#D4A017;">$@producto.Precio.ToString("N2")</span>
                            </td>
                            <td>
                                <span class="pz-badge"
                                      style="@(producto.Stock > 10 ? "background:#dcfce7;color:#15803d;border:1px solid #bbf7d0;" : producto.Stock > 0 ? "background:#ffedd5;color:#c2410c;border:1px solid #fed7aa;" : "background:#fee2e2;color:#b91c1c;border:1px solid #fecaca;")">
                                    @producto.Stock unidades
                                </span>
                            </td>
                            <td>
                                <span class="pz-badge" style="@(producto.Activo ? "background:rgba(43,79,216,0.1);color:#2B4FD8;border:1px solid rgba(43,79,216,0.3);" : "background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb;")">
                                    @(producto.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <div style="display:flex;gap:.35rem;">
                                    <a href="/productos/detalle/@producto.Id" class="pz-action-btn" title="Ver detalles" style="color:#2B4FD8;">
                                        <i data-lucide="eye" style="width:1.25rem;height:1.25rem;"></i>
                                    </a>
                                    <a href="/productos/editar/@producto.Id" class="pz-action-btn" title="Editar" style="color:#d97706;">
                                        <i data-lucide="edit" style="width:1.25rem;height:1.25rem;"></i>
                                    </a>
                                    <button type="button" onclick="eliminarProducto('@producto.Id', '@producto.Nombre')"
                                            class="pz-action-btn" title="Eliminar" style="color:#dc2626;">
                                        <i data-lucide="trash-2" style="width:1.25rem;height:1.25rem;"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('buscarProducto').addEventListener('input', filtrarProductos);
        document.getElementById('filtroCategoria').addEventListener('change', filtrarProductos);
        document.getElementById('filtroEstado').addEventListener('change', filtrarProductos);

        function filtrarProductos() {
            const busqueda = document.getElementById('buscarProducto').value.toLowerCase();
            const categoria = document.getElementById('filtroCategoria').value.toLowerCase();
            const estado = document.getElementById('filtroEstado').value.toLowerCase();
            document.querySelectorAll('.producto-row').forEach(row => {
                const nombre = row.dataset.nombre, cat = row.dataset.categoria;
                const activo = row.dataset.activo === 'true', stock = parseInt(row.dataset.stock);
                let mostrar = true;
                if (busqueda && !nombre.includes(busqueda) && !cat.includes(busqueda)) mostrar = false;
                if (categoria && cat !== categoria) mostrar = false;
                if (estado === 'activo' && !activo) mostrar = false;
                if (estado === 'inactivo' && activo) mostrar = false;
                if (estado === 'sin-stock' && stock > 0) mostrar = false;
                row.style.display = mostrar ? '' : 'none';
            });
        }

        async function eliminarProducto(id, nombre) {
            if (!confirm(`¿Estás seguro de que deseas eliminar el producto "${nombre}"?\n\nEsta acción no se puede deshacer.`)) return;
            try {
                const response = await fetch(`/api/Productos/${id}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
                if (response.ok) { alert('✅ Producto eliminado exitosamente'); location.reload(); }
                else { alert('❌ Error: ' + await response.text()); }
            } catch (error) { alert('❌ Error al eliminar el producto'); }
        }

        window.eliminarProducto = eliminarProducto;

        const tbodyRef = document.getElementById('tablaProductos');
        const filasRazor = Array.from(tbodyRef.querySelectorAll('.producto-row'));
        const observer = new MutationObserver(() => {
            const filasActuales = Array.from(tbodyRef.querySelectorAll('.producto-row'));
            if (filasActuales.length > filasRazor.length) {
                tbodyRef.innerHTML = '';
                filasRazor.forEach(f => tbodyRef.appendChild(f));
                lucide.createIcons();
            }
        });
        observer.observe(tbodyRef, { childList: true });
        lucide.createIcons();
    </script>
}
@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Producto";
    ViewData["Subtitle"] = "Actualizar información del producto";
}

<style>
    :root {
        --vf-green: #39FF14;
        --vf-dark: #0a0a0a;
        --vf-card: #111111;
        --vf-border: #1f1f1f;
        --vf-text: #e5e5e5;
        --vf-muted: #6b7280;
    }

    .vf-page {
        background: var(--vf-dark);
        min-height: 100vh;
        padding: 1.5rem;
    }

    .vf-card {
        background: var(--vf-card);
        border: 1px solid var(--vf-border);
        border-radius: 1rem;
    }

    .vf-label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        color: var(--vf-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .vf-input {
        width: 100%;
        background: #1a1a1a;
        border: 2px solid var(--vf-border);
        color: var(--vf-text);
        border-radius: .6rem;
        padding: .75rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s,box-shadow .2s;
    }

        .vf-input:focus {
            border-color: var(--vf-green);
            box-shadow: 0 0 0 3px rgba(57,255,20,.12);
        }

        .vf-input::placeholder {
            color: var(--vf-muted);
        }

    select.vf-input option {
        background: #1a1a1a;
    }

    .vf-btn-primary {
        background: var(--vf-green);
        color: #0a0a0a;
        font-weight: 900;
        padding: .75rem 2rem;
        border-radius: .6rem;
        border: none;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: .06em;
        transition: opacity .2s,transform .1s;
    }

        .vf-btn-primary:hover {
            opacity: .85;
            transform: translateY(-1px);
        }

    .vf-btn-secondary {
        background: #1f1f1f;
        color: var(--vf-text);
        font-weight: 800;
        padding: .75rem 2rem;
        border-radius: .6rem;
        border: 1px solid var(--vf-border);
        text-transform: uppercase;
        letter-spacing: .06em;
        text-decoration: none;
        display: inline-block;
        transition: background .2s;
    }

        .vf-btn-secondary:hover {
            background: #2a2a2a;
        }

    .vf-file-input {
        width: 100%;
        background: #1a1a1a;
        border: 2px dashed var(--vf-border);
        color: var(--vf-text);
        border-radius: .6rem;
        padding: .6rem 1rem;
    }

        .vf-file-input::file-selector-button {
            background: var(--vf-green);
            color: #0a0a0a;
            font-weight: 800;
            padding: .4rem 1rem;
            border-radius: .4rem;
            border: none;
            cursor: pointer;
            margin-right: 1rem;
            text-transform: uppercase;
            font-size: .78rem;
        }
</style>

<div class="vf-page">
    <div class="max-w-2xl mx-auto">
        <div class="vf-card p-8">
            <!-- Header -->
            <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--vf-border);">
                <div style="background:var(--vf-green);border-radius:.75rem;padding:1rem;">
                    <i data-lucide="edit" style="width:2rem;height:2rem;color:#0a0a0a;display:block;"></i>
                </div>
                <div>
                    <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.2rem;">
                        <h2 style="font-size:1.6rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:.05em;">Editar Producto</h2>
                        <span style="background:var(--vf-green);color:#0a0a0a;font-size:.65rem;font-weight:900;padding:.15rem .55rem;border-radius:9999px;letter-spacing:.1em;">VIDAFIT</span>
                    </div>
                    <p style="color:var(--vf-muted);font-size:.875rem;font-weight:600;">Actualizar información del producto</p>
                </div>
            </div>

            <form id="form-producto" class="space-y-6">
                <input type="hidden" id="producto-id" value="@Model.Id">

                <div>
                    <label class="vf-label">Nombre *</label>
                    <input type="text" id="nombre" value="@Model.Nombre" required class="vf-input">
                </div>

                <div>
                    <label class="vf-label">Descripción</label>
                    <textarea id="descripcion" rows="2" class="vf-input" style="resize:none;">@Model.Descripcion</textarea>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="vf-label">Precio *</label>
                        <div style="position:relative;">
                            <span style="position:absolute;left:1rem;top:.85rem;color:var(--vf-green);font-weight:800;">$</span>
                            <input type="number" id="precio" step="0.01" value="@Model.Precio" required class="vf-input" style="padding-left:2rem;">
                        </div>
                    </div>
                    <div>
                        <label class="vf-label">Stock *</label>
                        <input type="number" id="stock" value="@Model.Stock" required class="vf-input">
                    </div>
                </div>

                <div>
                    <label class="vf-label">Categoría</label>
                    <select id="categoria" class="vf-input">
                        <option value="">Seleccionar...</option>
                        <option value="Suplementos" selected="@(Model.Categoria == "Suplementos")">Suplementos</option>
                        <option value="Bebidas" selected="@(Model.Categoria == "Bebidas")">Bebidas</option>
                        <option value="Snacks" selected="@(Model.Categoria == "Snacks")">Snacks</option>
                        <option value="Accesorios" selected="@(Model.Categoria == "Accesorios")">Accesorios</option>
                        <option value="Ropa" selected="@(Model.Categoria == "Ropa")">Ropa</option>
                    </select>
                </div>

                <div>
                    <label class="vf-label">Imagen</label>
                    @if (!string.IsNullOrEmpty(Model.ImagenBase64))
                    {
                        <img id="preview" src="data:image/jpeg;base64,@Model.ImagenBase64" style="margin-bottom:.75rem;width:8rem;height:8rem;object-fit:cover;border-radius:.75rem;border:2px solid var(--vf-border);">
                    }
                    else
                    {
                        <img id="preview" src="" style="margin-bottom:.75rem;width:8rem;height:8rem;object-fit:cover;border-radius:.75rem;border:2px solid var(--vf-border);display:none;">
                    }
                    <input type="file" id="imagen" accept="image/*" class="vf-file-input">
                </div>

                <div style="display:flex;justify-content:flex-end;gap:.75rem;padding-top:1.5rem;border-top:1px solid var(--vf-border);">
                    <a href="/productos" class="vf-btn-secondary">Cancelar</a>
                    <button type="submit" class="vf-btn-primary">Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let imagenBase64 = '@Model.ImagenBase64';

        document.getElementById('imagen').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    imagenBase64 = event.target.result.split(',')[1];
                    const preview = document.getElementById('preview');
                    preview.src = event.target.result;
                    preview.style.display = '';
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('form-producto').addEventListener('submit', async function(e) {
            e.preventDefault();
            const productoId = document.getElementById('producto-id').value;
            const producto = {
                id: productoId,
                nombre: document.getElementById('nombre').value,
                descripcion: document.getElementById('descripcion').value,
                precio: parseFloat(document.getElementById('precio').value),
                stock: parseInt(document.getElementById('stock').value),
                categoria: document.getElementById('categoria').value,
                imagenBase64: imagenBase64,
                activo: true
            };
            try {
                const response = await fetch(`${API_URL}/Productos/${productoId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(producto)
                });
                if (response.ok) {
                    alert('✓ Producto actualizado exitosamente');
                    window.location.href = '/productos';
                } else {
                    const error = await response.text();
                    alert('Error al actualizar: ' + error);
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            }
        });

        lucide.createIcons();
    </script>
}

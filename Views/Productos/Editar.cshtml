@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Producto";
    ViewData["Subtitle"] = "Actualizar información del producto";
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">

        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-800 p-8">
            <div class="flex items-center gap-4">
                <div>
                    <h2 class="text-3xl font-black text-white mb-2 uppercase tracking-wide">Editar Producto</h2>
                    <p class="text-white opacity-90 font-bold">@Model.Nombre</p>
                </div>
            </div>
        </div>

        <div class="p-8">
            <form id="form-producto" class="space-y-6">
                <input type="hidden" id="producto-id" value="@Model.Id">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <!-- Nombre -->
                    <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                        <label class="block text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Nombre *</label>
                        <input type="text" id="nombre" value="@Model.Nombre" required
                               class="w-full bg-white border-2 border-gray-200 rounded-lg px-4 py-3 font-semibold text-gray-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition">
                    </div>

                    <!-- Categoría -->
                    <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                        <label class="block text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Categoría</label>
                        <select id="categoria"
                                class="w-full bg-white border-2 border-gray-200 rounded-lg px-4 py-3 font-semibold text-gray-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition">
                            <option value="">Seleccionar...</option>
                            <option value="Suplementos" selected="@(Model.Categoria == "Suplementos")">Suplementos</option>
                            <option value="Bebidas" selected="@(Model.Categoria == "Bebidas")">Bebidas</option>
                            <option value="Snacks" selected="@(Model.Categoria == "Snacks")">Snacks</option>
                            <option value="Accesorios" selected="@(Model.Categoria == "Accesorios")">Accesorios</option>
                            <option value="Ropa" selected="@(Model.Categoria == "Ropa")">Ropa</option>
                        </select>
                    </div>

                    <!-- Precio -->
                    <div class="bg-emerald-50 p-6 rounded-xl border-2 border-emerald-300">
                        <label class="block text-sm font-black text-emerald-800 uppercase tracking-wide mb-2">Precio *</label>
                        <div class="relative">
                            <span class="absolute left-4 top-3.5 text-emerald-700 font-black">$</span>
                            <input type="number" id="precio" step="0.01" value="@Model.Precio" required
                                   class="w-full bg-white border-2 border-emerald-200 rounded-lg pl-8 pr-4 py-3 font-semibold text-gray-900 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition">
                        </div>
                    </div>

                    <!-- Stock -->
                    <div class="bg-blue-50 p-6 rounded-xl border-2 border-blue-300">
                        <label class="block text-sm font-black text-blue-800 uppercase tracking-wide mb-2">Stock *</label>
                        <input type="number" id="stock" value="@Model.Stock" required
                               class="w-full bg-white border-2 border-blue-200 rounded-lg px-4 py-3 font-semibold text-gray-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition">
                    </div>

                </div>

                <!-- Descripción -->
                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <label class="block text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Descripción</label>
                    <textarea id="descripcion" rows="3"
                              class="w-full bg-white border-2 border-gray-200 rounded-lg px-4 py-3 font-semibold text-gray-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition resize-none">@Model.Descripcion</textarea>
                </div>

                <!-- Imagen -->
                <div class="bg-gray-50 p-6 rounded-xl border-2 border-gray-200">
                    <label class="block text-sm font-black text-gray-600 uppercase tracking-wide mb-2">Imagen</label>
                    @if (!string.IsNullOrEmpty(Model.ImagenBase64))
                    {
                        <div class="mb-4 w-32 h-32 bg-gray-100 rounded-xl overflow-hidden shadow">
                            <img id="preview" src="@Model.ImagenBase64" alt="@Model.Nombre" class="w-full h-full object-cover">
                        </div>
                    }
                    else
                    {
                        <div class="mb-4 w-32 h-32 bg-gray-100 rounded-xl overflow-hidden shadow hidden" id="preview-wrapper">
                            <img id="preview" src="" alt="Preview" class="w-full h-full object-cover">
                        </div>
                    }
                    <input type="file" id="imagen" accept="image/*"
                           class="w-full text-gray-700 font-semibold file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:font-black file:uppercase file:text-sm file:bg-blue-600 file:text-white hover:file:bg-blue-700 transition">
                </div>

                <!-- Botones -->
                <div class="flex gap-4 pt-6 border-t-2 border-gray-200">
                    <button type="submit"
                            class="flex-1 bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-black py-4 px-6 rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide flex items-center justify-center gap-2">
                        <i data-lucide="save" class="w-5 h-5"></i>
                        Actualizar Producto
                    </button>
                    <a href="/productos"
                       class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 font-black py-4 px-6 rounded-xl transition-all text-center uppercase tracking-wide flex items-center justify-center gap-2">
                        <i data-lucide="arrow-left" class="w-5 h-5"></i>
                        Cancelar
                    </a>
                </div>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let imagenBase64 = '@Model.ImagenBase64';

        document.getElementById('imagen').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    imagenBase64 = event.target.result.split(',')[1];
                    const preview = document.getElementById('preview');
                    preview.src = event.target.result;
                    preview.classList.remove('hidden');
                    const wrapper = document.getElementById('preview-wrapper');
                    if (wrapper) wrapper.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('form-producto').addEventListener('submit', async function (e) {
            e.preventDefault();

            const productoId = document.getElementById('producto-id').value;

            const producto = {
                id: productoId,
                nombre: document.getElementById('nombre').value,
                descripcion: document.getElementById('descripcion').value,
                precio: parseFloat(document.getElementById('precio').value),
                stock: parseInt(document.getElementById('stock').value),
                categoria: document.getElementById('categoria').value,
                imagenBase64: imagenBase64,
                activo: true
            };

            try {
                const response = await fetch(`${API_URL}/Productos/${productoId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(producto)
                });

                if (response.ok) {
                    alert('✓ Producto actualizado exitosamente');
                    window.location.href = '/productos';
                } else {
                    const error = await response.text();
                    alert('Error al actualizar: ' + error);
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            }
        });

        document.querySelectorAll('input[type="number"]').forEach(function (input) {
            input.addEventListener('wheel', function (e) {
                e.preventDefault();
            }, { passive: false });
        });

        lucide.createIcons();
    </script>
}

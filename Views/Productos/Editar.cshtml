@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Producto";
    ViewData["Subtitle"] = "Actualizar información del producto";
}

<style>
    .pf-input {
        width: 100%;
        padding: 13px 16px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Inter',sans-serif;
        outline: none;
        transition: border-color .2s,box-shadow .2s;
        resize: none;
    }

        .pf-input::placeholder {
            color: rgba(255,255,255,0.2);
        }

        .pf-input:focus {
            border-color: #1E6FE3;
            box-shadow: 0 0 0 3px rgba(30,111,227,0.15);
        }

    .pf-label {
        display: block;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        margin-bottom: 8px;
    }

    .pf-select {
        width: 100%;
        padding: 13px 16px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Inter',sans-serif;
        outline: none;
    }

        .pf-select:focus {
            border-color: #1E6FE3;
        }

        .pf-select option {
            background: #0D0D20;
            color: #fff;
        }
</style>

<div style="max-width:640px;margin:0 auto;">
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:16px;padding:32px;">

        <!-- Header -->
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:28px;padding-bottom:24px;border-bottom:1px solid rgba(30,111,227,0.12);">
            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#D97706,#B45309);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i data-lucide="edit" style="width:24px;height:24px;color:#fff;"></i>
            </div>
            <div>
                <h2 style="font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:3px;color:#fff;margin:0;line-height:1;">Editar Producto</h2>
                <p style="font-size:0.78rem;color:rgba(255,255,255,0.35);margin:4px 0 0 0;font-weight:600;">Actualizar información</p>
            </div>
        </div>

        <form id="form-producto" style="display:flex;flex-direction:column;gap:20px;">
            <input type="hidden" id="producto-id" value="@Model.Id">

            <div>
                <label class="pf-label">Nombre *</label>
                <input type="text" id="nombre" value="@Model.Nombre" required class="pf-input">
            </div>

            <div>
                <label class="pf-label">Descripción</label>
                <textarea id="descripcion" rows="2" class="pf-input">@Model.Descripcion</textarea>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div>
                    <label class="pf-label">Precio *</label>
                    <input type="number" id="precio" step="0.01" value="@Model.Precio" required class="pf-input">
                </div>
                <div>
                    <label class="pf-label">Stock *</label>
                    <input type="number" id="stock" value="@Model.Stock" required class="pf-input">
                </div>
            </div>

            <div>
                <label class="pf-label">Categoría</label>
                <select id="categoria" class="pf-select">
                    <option value="">Seleccionar...</option>
                    <option value="Suplementos" selected="@(Model.Categoria == "Suplementos")">Suplementos</option>
                    <option value="Bebidas" selected="@(Model.Categoria == "Bebidas")">Bebidas</option>
                    <option value="Snacks" selected="@(Model.Categoria == "Snacks")">Snacks</option>
                    <option value="Accesorios" selected="@(Model.Categoria == "Accesorios")">Accesorios</option>
                    <option value="Ropa" selected="@(Model.Categoria == "Ropa")">Ropa</option>
                </select>
            </div>

            <div>
                <label class="pf-label">Imagen</label>
                @if (!string.IsNullOrEmpty(Model.ImagenBase64))
                {
                    <img id="preview" src="@Model.ImagenBase64"
                         style="width:100px;height:100px;object-fit:cover;border-radius:12px;border:2px solid rgba(30,111,227,0.3);margin-bottom:10px;display:block;">
                }
                else
                {
                    <img id="preview" src="" style="width:100px;height:100px;object-fit:cover;border-radius:12px;border:2px solid rgba(30,111,227,0.3);margin-bottom:10px;display:none;">
                }
                <input type="file" id="imagen" accept="image/*"
                       style="width:100%;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px dashed rgba(30,111,227,0.25);border-radius:12px;color:rgba(255,255,255,0.5);font-size:0.82rem;font-family:'Inter',sans-serif;">
            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;padding-top:20px;border-top:1px solid rgba(30,111,227,0.12);">
                <a href="/productos"
                   style="display:flex;align-items:center;gap:8px;padding:12px 22px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.5);font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border:1px solid rgba(255,255,255,0.08);border-radius:12px;text-decoration:none;transition:all .15s;"
                   onmouseover="this.style.background='rgba(255,255,255,0.08)';this.style.color='rgba(255,255,255,0.8)'" onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.color='rgba(255,255,255,0.5)'">
                    Cancelar
                </a>
                <button type="submit"
                        style="display:flex;align-items:center;gap:8px;padding:12px 24px;background:linear-gradient(135deg,#D97706,#B45309);color:#fff;font-weight:800;font-size:0.78rem;letter-spacing:1.5px;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer;transition:opacity .2s,transform .2s;"
                        onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.02)'" onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
                    <i data-lucide="save" style="width:15px;height:15px;"></i> Actualizar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let imagenBase64 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ImagenBase64 ?? ""));

        document.getElementById('imagen').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(ev) {
                    imagenBase64 = ev.target.result;
                    const preview = document.getElementById('preview');
                    preview.src = ev.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('form-producto').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('producto-id').value;
            const data = {
                id, nombre: document.getElementById('nombre').value,
                descripcion: document.getElementById('descripcion').value,
                precio: parseFloat(document.getElementById('precio').value),
                stock: parseInt(document.getElementById('stock').value),
                categoria: document.getElementById('categoria').value,
                imagenBase64, activo: true
            };
            try {
                const r = await fetch(`${API_URL}/Productos/${id}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
                if (r.ok) { alert('✓ Producto actualizado exitosamente'); window.location.href = '/productos'; }
                else { alert('Error al actualizar: ' + await r.text()); }
            } catch(e) { alert('Error: ' + e.message); }
        });

        document.querySelectorAll('input[type="number"]').forEach(i => i.addEventListener('wheel', e=>e.preventDefault(), {passive:false}));
        lucide.createIcons();
    </script>
}

@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Producto";
    ViewData["Subtitle"] = $"Actualizar información de {Model.Nombre}";
}

<div class="bg-white rounded-xl shadow-md p-6">
    <form id="form-producto" class="space-y-6">
        <input type="hidden" id="producto-id" value="@Model.Id">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Nombre <span class="text-red-500">*</span>
                </label>
                <input type="text" id="nombre" value="@Model.Nombre" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Precio <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <span class="absolute left-4 top-2.5 text-gray-500">$</span>
                    <input type="number" step="0.01" id="precio" value="@Model.Precio" required
                           class="w-full pl-8 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Stock <span class="text-red-500">*</span>
                </label>
                <input type="number" id="stock" value="@Model.Stock" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Categoría
                </label>
                <input type="text" id="categoria" value="@Model.Categoria"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
                Descripción
            </label>
            <textarea id="descripcion" rows="3"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">@Model.Descripcion</textarea>
        </div>

        <!-- Imagen del Producto -->
        <div>
            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                <i data-lucide="image" class="w-5 h-5 text-vida-primary"></i>
                Imagen del Producto
            </h3>

            <div class="flex items-center gap-4">
                <div id="preview-container">
                    @if (!string.IsNullOrEmpty(Model.ImagenBase64))
                    {
                        <img id="imagen-preview" src="data:image/jpeg;base64,@Model.ImagenBase64"
                             class="w-32 h-32 rounded-lg object-cover border-2 border-gray-300" alt="Preview">
                    }
                    else
                    {
                        <div id="imagen-preview" class="w-32 h-32 rounded-lg bg-gray-100 border-2 border-gray-300 flex items-center justify-center">
                            <i data-lucide="package" class="w-16 h-16 text-gray-400"></i>
                        </div>
                    }
                </div>

                <div class="flex-1">
                    <input type="file" id="imagen" accept="image/*" class="hidden">
                    <button type="button" onclick="document.getElementById('imagen').click()"
                            class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg border border-gray-300 transition-colors inline-flex items-center gap-2">
                        <i data-lucide="upload" class="w-4 h-4"></i>
                        Cambiar Imagen
                    </button>
                </div>
            </div>
        </div>

        <!-- Estado -->
        <div>
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="activo" @(Model.Activo ? "checked" : "")
                       class="w-4 h-4 text-vida-primary border-gray-300 rounded focus:ring-vida-primary">
                <span class="text-sm font-medium text-gray-700">Producto Activo</span>
            </label>
        </div>

        <!-- Botones -->
        <div class="flex justify-end gap-3 pt-4 border-t">
            <a href="/productos"
               class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center gap-2">
                <i data-lucide="x" class="w-4 h-4"></i>
                Cancelar
            </a>
            <button type="submit" id="btn-guardar"
                    class="px-6 py-2 bg-vida-primary hover:bg-vida-accent text-vida-dark font-semibold rounded-lg transition-all shadow-lg hover:shadow-xl inline-flex items-center gap-2">
                <i data-lucide="save" class="w-4 h-4"></i>
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let imagenBase64 = '@Model.ImagenBase64';

        // Preview de imagen
        document.getElementById('imagen').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    imagenBase64 = event.target.result.split(',')[1];
                    const preview = document.getElementById('imagen-preview');
                    if (preview.tagName === 'IMG') {
                        preview.src = event.target.result;
                    } else {
                        const img = document.createElement('img');
                        img.id = 'imagen-preview';
                        img.src = event.target.result;
                        img.className = 'w-32 h-32 rounded-lg object-cover border-2 border-gray-300';
                        preview.parentNode.replaceChild(img, preview);
                    }
                };
                reader.readAsDataURL(file);
            }
        });

        // Submit form
        document.getElementById('form-producto').addEventListener('submit', async function(e) {
            e.preventDefault();

            const btnGuardar = document.getElementById('btn-guardar');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Guardando...';

            const productoId = document.getElementById('producto-id').value;

            const producto = {
                id: productoId,
                nombre: document.getElementById('nombre').value,
                descripcion: document.getElementById('descripcion').value || null,
                precio: parseFloat(document.getElementById('precio').value),
                stock: parseInt(document.getElementById('stock').value),
                categoria: document.getElementById('categoria').value || null,
                imagenBase64: imagenBase64 || null,
                activo: document.getElementById('activo').checked
            };

            try {
                const response = await fetch(`${API_URL}/Productos/${productoId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(producto)
                });

                if (response.ok) {
                    alert('✓ Producto actualizado exitosamente');
                    window.location.href = '/productos';
                } else {
                    const error = await response.text();
                    alert('Error al actualizar: ' + error);
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            } finally {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Guardar Cambios';
                lucide.createIcons();
            }
        });

        lucide.createIcons();
    </script>
}

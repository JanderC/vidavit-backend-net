@model VidaFitBackend.Models.Producto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Producto";
    ViewData["Subtitle"] = "Actualizar información del producto";
}

<style>
    :root {
        --tg-green: #2EAD4B;
        --tg-green-dark: #1e8a38;
        --tg-border: #c6e8cf;
        --tg-black: #1a1a1a;
        --tg-dark: #2D2D2D;
        --tg-text: #111827;
        --tg-muted: #4b5563;
        --tg-white: #ffffff;
    }

    .tg-card {
        background: var(--tg-white);
        border-radius: 1.25rem;
        border: 2px solid #e5e7eb;
        box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    }

    .tg-header-icon {
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
        border-radius: .85rem;
        padding: 1rem;
        box-shadow: 0 4px 16px rgba(46,173,75,0.3);
    }

    .tg-label {
        display: block;
        font-size: .75rem;
        font-weight: 900;
        color: var(--tg-dark);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin-bottom: .5rem;
    }

    .tg-input {
        width: 100%;
        border: 2px solid #e5e7eb;
        color: var(--tg-text);
        border-radius: .65rem;
        padding: .8rem 1rem;
        outline: none;
        font-weight: 600;
        transition: border-color .2s, box-shadow .2s;
        font-size: .95rem;
        background: #fafafa;
    }

        .tg-input:focus {
            border-color: var(--tg-green);
            box-shadow: 0 0 0 3px rgba(46,173,75,0.15);
            background: #fff;
        }

        .tg-input::placeholder {
            color: #9ca3af;
        }

    .tg-btn-primary {
        background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
        color: var(--tg-white);
        font-weight: 900;
        padding: .85rem 2rem;
        border-radius: .75rem;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: all .2s;
        text-transform: uppercase;
        letter-spacing: .07em;
        box-shadow: 0 4px 16px rgba(46,173,75,0.35);
        font-size: .9rem;
    }

        .tg-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(46,173,75,0.45);
        }

    .tg-btn-secondary {
        background: #f3f4f6;
        color: var(--tg-dark);
        font-weight: 800;
        padding: .85rem 2rem;
        border-radius: .75rem;
        border: 2px solid #e5e7eb;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        transition: all .2s;
        text-transform: uppercase;
        letter-spacing: .07em;
        text-decoration: none;
        font-size: .9rem;
    }

        .tg-btn-secondary:hover {
            background: #e5e7eb;
            text-decoration: none;
            color: var(--tg-dark);
        }

    .tg-file-input {
        width: 100%;
        border: 2px dashed #c6e8cf;
        border-radius: .65rem;
        padding: .6rem 1rem;
        font-weight: 600;
        background: #f9fefb;
    }

        .tg-file-input::file-selector-button {
            background: linear-gradient(135deg, var(--tg-green), var(--tg-green-dark));
            color: var(--tg-white);
            font-weight: 800;
            padding: .4rem 1rem;
            border-radius: .4rem;
            border: none;
            cursor: pointer;
            margin-right: 1rem;
            text-transform: uppercase;
            font-size: .75rem;
        }
</style>

<div class="max-w-2xl mx-auto">
    <div class="tg-card p-8">

        <!-- Header -->
        <div class="flex items-center gap-4 mb-8 pb-6 border-b-2 border-gray-100">
            <div class="tg-header-icon">
                <i data-lucide="edit" class="w-8 h-8 text-white"></i>
            </div>
            <div>
                <h2 class="text-2xl font-black text-gray-900 uppercase tracking-wide">Editar Producto</h2>
                <p class="text-sm font-semibold mt-1" style="color:var(--tg-muted);">Actualizar información · Tallest GYM</p>
            </div>
        </div>

        <form id="form-producto" class="space-y-6">
            <input type="hidden" id="producto-id" value="@Model.Id">

            <div>
                <label class="tg-label">Nombre *</label>
                <input type="text" id="nombre" value="@Model.Nombre" required class="tg-input">
            </div>

            <div>
                <label class="tg-label">Descripción</label>
                <textarea id="descripcion" rows="2" class="tg-input">@Model.Descripcion</textarea>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="tg-label">Precio *</label>
                    <input type="number" id="precio" step="0.01" value="@Model.Precio" required class="tg-input">
                </div>
                <div>
                    <label class="tg-label">Stock *</label>
                    <input type="number" id="stock" value="@Model.Stock" required class="tg-input">
                </div>
            </div>

            <div>
                <label class="tg-label">Categoría</label>
                <select id="categoria" class="tg-input bg-white">
                    <option value="">Seleccionar...</option>
                    <option value="Suplementos" selected="@(Model.Categoria == "Suplementos")">Suplementos</option>
                    <option value="Bebidas" selected="@(Model.Categoria == "Bebidas")">Bebidas</option>
                    <option value="Snacks" selected="@(Model.Categoria == "Snacks")">Snacks</option>
                    <option value="Accesorios" selected="@(Model.Categoria == "Accesorios")">Accesorios</option>
                    <option value="Ropa" selected="@(Model.Categoria == "Ropa")">Ropa</option>
                </select>
            </div>

            <div>
                <label class="tg-label">Imagen</label>
                @if (!string.IsNullOrEmpty(Model.ImagenBase64))
                {
                    <img id="preview" src="data:image/jpeg;base64,@Model.ImagenBase64" class="mb-3 w-32 h-32 object-cover rounded-xl border-2 border-gray-200">
                }
                else
                {
                    <img id="preview" src="" class="mb-3 w-32 h-32 object-cover rounded-xl hidden border-2 border-gray-200">
                }
                <input type="file" id="imagen" accept="image/*" class="tg-file-input">
            </div>

            <div class="flex justify-end gap-3 pt-6 border-t-2 border-gray-100">
                <a href="/productos" class="tg-btn-secondary">
                    Cancelar
                </a>
                <button type="submit" class="tg-btn-primary">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    Actualizar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let imagenBase64 = '@Model.ImagenBase64';

        document.getElementById('imagen').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    imagenBase64 = event.target.result.split(',')[1];
                    const preview = document.getElementById('preview');
                    preview.src = event.target.result;
                    preview.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('form-producto').addEventListener('submit', async function(e) {
            e.preventDefault();
            const productoId = document.getElementById('producto-id').value;
            const producto = {
                id: productoId,
                nombre: document.getElementById('nombre').value,
                descripcion: document.getElementById('descripcion').value,
                precio: parseFloat(document.getElementById('precio').value),
                stock: parseInt(document.getElementById('stock').value),
                categoria: document.getElementById('categoria').value,
                imagenBase64: imagenBase64,
                activo: true
            };

            try {
                const response = await fetch(`${API_URL}/Productos/${productoId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(producto)
                });

                if (response.ok) {
                    alert('✓ Producto actualizado exitosamente');
                    window.location.href = '/productos';
                } else {
                    const error = await response.text();
                    alert('Error al actualizar: ' + error);
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            }
        });

        lucide.createIcons();
    </script>
}

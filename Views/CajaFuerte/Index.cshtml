        // =========================================================
        // ✅ ELIMINAR MOVIMIENTO — Flujo con modal de motivo
        // =========================================================
        function abrirModalEliminar(id, descripcion, origen) {
            _eliminarId = id;
            _eliminarOrigen = origen;
            document.getElementById('elim-descripcion-label').textContent = `"${descripcion || 'Sin descripción'}"`;
            document.getElementById('elim-motivo').value = '';
            document.getElementById('elim-error').classList.add('hidden');
            const btn = document.getElementById('btn-confirmar-elim');
            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="trash-2" class="w-4 h-4"></i> Eliminar';
            abrirModal('modal-eliminar');
        }

        async function confirmarEliminacion() {
            const motivo = document.getElementById('elim-motivo').value.trim();
            const errorEl = document.getElementById('elim-error');
            errorEl.classList.add('hidden');

            if (!motivo) {
                errorEl.textContent = 'El motivo es obligatorio para continuar';
                errorEl.classList.remove('hidden');
                return;
            }

            const btn = document.getElementById('btn-confirmar-elim');
            btn.disabled = true;
            btn.innerHTML = '<div class="animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full"></div> Eliminando...';

            try {
                const res = await fetch(`/api/cajafuerte/movimientos/${_eliminarId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ motivo })
                });
                const data = await res.json();

                if (data.success) {
                    cerrarModal('modal-eliminar');
                    cerrarModal('modal-detalle-dia');
                    showToast('Movimiento eliminado y balance actualizado', 'success');
                    cargarBalances();
                    cargarMovimientos();
                } else {
                    errorEl.textContent = data.message || 'No se pudo eliminar el movimiento';
                    errorEl.classList.remove('hidden');
                    btn.disabled = false;
                    btn.innerHTML = '<i data-lucide="trash-2" class="w-4 h-4"></i> Eliminar';
                    lucide.createIcons();
                }
            } catch (e) {
                errorEl.textContent = 'Error de conexión';
                errorEl.classList.remove('hidden');
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="trash-2" class="w-4 h-4"></i> Eliminar';
                lucide.createIcons();
            }
        }


                                            <p class="text-lg font-black text-blue-600">$${cons.totales.ingresos.toLocaleString('es-CO', { minimumFractionDigits: 2 })}</p>
                                        </div>
                                        <div class="bg-red-50 rounded-lg p-3">
                                            <p class="text-xs text-red-700 font-bold mb-1">Egresos</p>
                                            <p class="text-lg font-black text-red-600">$${cons.totales.egresos.toLocaleString('es-CO', { minimumFractionDigits: 2 })}</p>
                                        </div>
                                        <div class="bg-emerald-50 rounded-lg p-3">
                                            <p class="text-xs text-emerald-700 font-bold mb-1">Efectivo</p>
                                            <p class="text-lg font-black text-emerald-600">$${cons.efectivo.balance.toLocaleString('es-CO', { minimumFractionDigits: 2 })}</p>
                                        </div>
                                    </div>

        // Expandir/colapsar ventas del cierre dentro del modal de día
        const _detalleDiaCache = {};
        async function toggleDetalleCierreEnModal(detalleId, cierreId) {
            const panel = document.getElementById(detalleId);
            const btn = document.getElementById(`btn-${detalleId}`);
            const icon = btn?.querySelector('.toggle-icon-dd');
            const visible = !panel.classList.contains('hidden');

            panel.classList.toggle('hidden');
            icon?.classList.toggle('rotate-180');

            if (!visible && !_detalleDiaCache[cierreId]) {
                try {
                    const res = await fetch(`/api/cajafuerte/movimientos-diarios?cierreId=${cierreId}`);
                    const data = await res.json();
                    _detalleDiaCache[cierreId] = data;
                    renderVentasCierreEnModal(detalleId, data);
                } catch (e) {
                    panel.innerHTML = '<p class="text-xs text-red-500">Error al cargar ventas</p>';
                }
            } else if (!visible && _detalleDiaCache[cierreId]) {
                renderVentasCierreEnModal(detalleId, _detalleDiaCache[cierreId]);
            }
        }


                if (data.success) {
                    const container = document.getElementById('lista-consolidados');

                    if (data.consolidados && data.consolidados.length > 0) {
                        container.innerHTML = data.consolidados.map(cons => {
                            return `
                                <div class="bg-gradient-to-r from-purple-50 to-purple-100 rounded-xl p-6 border-l-4 border-purple-500 shadow-lg hover:shadow-xl transition-all cursor-pointer"
                                     onclick="verDetalleConsolidado('${cons.id}')">
                                    <div class="flex items-center justify-between mb-4">
                                        <div>
                                            <h4 class="text-xl font-black text-gray-900">${cons.periodo}</h4>
                                            <p class="text-sm text-gray-600 font-semibold">
                                                Consolidado el ${new Date(cons.fechaConsolidacion).toLocaleDateString('es-ES')}
                                            </p>
                                        </div>
                                        <div class="text-right">
                                            <p class="text-3xl font-black text-purple-600">$${cons.totales.balance.toLocaleString('es-CO', { minimumFractionDigits: 2 })}</p>

        function cerrarModalDetalleConsolidado() {
            document.getElementById('modalDetalleConsolidado').classList.add('hidden');
        }

        // =============================================
        // MODALES DE ACCIONES
        // =============================================

        // Cambiar Contraseña
        function abrirModalCambiarPassword() {
            document.getElementById('password-actual').value = '';
            document.getElementById('password-nueva').value = '';
            document.getElementById('password-confirmar').value = '';
            document.getElementById('modalCambiarPassword').classList.remove('hidden');
        }

        function cerrarModalCambiarPassword() {
            document.getElementById('modalCambiarPassword').classList.add('hidden');
        }

        async function confirmarCambiarPassword() {
            const actual = document.getElementById('password-actual').value;
            const nueva = document.getElementById('password-nueva').value;
            const confirmar = document.getElementById('password-confirmar').value;

            if (!actual || !nueva || !confirmar) {
                alert('❌ Por favor complete todos los campos');
                return;
            }

            if (nueva !== confirmar) {
                alert('❌ Las contraseñas nuevas no coinciden');
                return;
            }

            if (nueva.length < 4) {
                alert('❌ La contraseña debe tener al menos 4 caracteres');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/cajafuerte/cambiar-password`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        passwordActual: actual,
                        passwordNueva: nueva
                    })
                });

                const data = await response.json();

                if (data.success) {
                    alert('✅ Contraseña cambiada exitosamente');
                    passwordIngresada = nueva;
                    cerrarModalCambiarPassword();
                } else {
                    alert(`❌ ${data.message}`);
                }
            } catch (error) {
                console.error('Error al cambiar contraseña:', error);
                alert('❌ Error al cambiar contraseña');
            }
        }

        // Registrar Egreso
        function abrirModalRegistrarEgreso() {
            document.getElementById('egreso-metodo-pago').value = 'efectivo';
            document.getElementById('egreso-monto').value = '';
            document.getElementById('egreso-categoria').value = 'otros';
            document.getElementById('egreso-descripcion').value = '';
            document.getElementById('modalRegistrarEgreso').classList.remove('hidden');
        }

        function cerrarModalRegistrarEgreso() {
            document.getElementById('modalRegistrarEgreso').classList.add('hidden');
        }

        async function confirmarRegistrarEgreso() {
            const metodoPago = document.getElementById('egreso-metodo-pago').value;
            const monto = parseFloat(document.getElementById('egreso-monto').value);
            const categoria = document.getElementById('egreso-categoria').value;
            const descripcion = document.getElementById('egreso-descripcion').value;

            if (!monto || monto <= 0) {
                alert('❌ Por favor ingrese un monto válido');
                return;
            }

            if (!descripcion) {
                alert('❌ Por favor ingrese una descripción');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/cajafuerte/registrar-egreso`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        metodoPago,
                        monto,
                        categoria,
                        descripcion
                    })
                });

                const data = await response.json();

                if (data.success) {
                    alert(`✅ ${data.message}`);
                    cerrarModalRegistrarEgreso();
                    cargarDashboard();
                    cargarMovimientos();
                } else {
                    alert(`❌ ${data.message}`);
                }
            } catch (error) {
                console.error('Error al registrar egreso:', error);
                alert('❌ Error al registrar egreso');
            }
        }

        // Transferir a Caja
        function abrirModalTransferirACaja() {
            document.getElementById('transfer-monto').value = '';
            document.getElementById('modalTransferirACaja').classList.remove('hidden');
        }

        function cerrarModalTransferirACaja() {
            document.getElementById('modalTransferirACaja').classList.add('hidden');
        }

        async function confirmarTransferirACaja() {
            const monto = parseFloat(document.getElementById('transfer-monto').value);

            if (!monto || monto <= 0) {
                alert('❌ Por favor ingrese un monto válido');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/cajafuerte/transferir-a-caja`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ monto })
                });

                const data = await response.json();

                if (data.success) {
                    alert(`✅ ${data.message}`);
                    cerrarModalTransferirACaja();
                    cargarDashboard();
                    cargarMovimientos();
                } else {
                    alert(`❌ ${data.message}`);
                }
            } catch (error) {
                console.error('Error al transferir:', error);
                alert('❌ Error al realizar transferencia');
            }
        }

        // Asignar funciones globales
        window.verificarPasswordAcceso = verificarPasswordAcceso;
        window.cambiarVista = cambiarVista;
        window.cargarConsolidados = cargarConsolidados;
        window.verDetalleConsolidado = verDetalleConsolidado;
        window.cerrarModalDetalleConsolidado = cerrarModalDetalleConsolidado;
        window.abrirModalCambiarPassword = abrirModalCambiarPassword;
        window.cerrarModalCambiarPassword = cerrarModalCambiarPassword;
        window.confirmarCambiarPassword = confirmarCambiarPassword;
        window.abrirModalRegistrarEgreso = abrirModalRegistrarEgreso;
        window.cerrarModalRegistrarEgreso = cerrarModalRegistrarEgreso;
        window.confirmarRegistrarEgreso = confirmarRegistrarEgreso;
        window.abrirModalTransferirACaja = abrirModalTransferirACaja;
        window.cerrarModalTransferirACaja = cerrarModalTransferirACaja;
        window.confirmarTransferirACaja = confirmarTransferirACaja;
    </script>
}

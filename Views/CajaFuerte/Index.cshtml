        function toggleDesgloseCons(btn, mes, anio) {
            const card     = btn.closest('.border-2');
            const panel    = card.querySelector('.desglose-consolidado');
            const icon     = btn.querySelector('.toggle-cons-icon');
            const contenido= panel.querySelector('.desglose-contenido');
            const yaVisible= !panel.classList.contains('hidden');

            panel.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');

            if (!yaVisible && contenido.querySelector('.animate-spin')) {
                // Cargar por primera vez
                cargarDesgloseCons(mes, anio, contenido);
            }
        }

        async function cargarDesgloseCons(mes, anio, contenedorEl) {
            try {
                const res  = await fetch(`/api/cajafuerte/consolidados/preview?mes=${mes}&anio=${anio}`);
                const data = await res.json();

                if (!data.success || !data.desglosePorOrigen || data.desglosePorOrigen.length === 0) {
                    contenedorEl.innerHTML = '<p class="text-xs text-gray-400 italic text-center py-4">Sin movimientos para mostrar en este período.</p>';
                    return;
                }

                // Agrupar por origen para mostrar tabla bonita
                const ingresos = data.desglosePorOrigen.filter(x => x.tipo === 'ingreso');
                const egresos  = data.desglosePorOrigen.filter(x => x.tipo === 'egreso');

                let html = `
                <div class="grid md:grid-cols-2 gap-4">`;

                // Columna Ingresos
                html += `
                    <div>
                        <p class="text-xs font-black text-emerald-700 uppercase mb-2 flex items-center gap-1">
                            <i data-lucide="trending-up" class="w-3.5 h-3.5"></i> Origen de Ingresos
                        </p>
                        <div class="space-y-1">`;
                if (ingresos.length === 0) {
                    html += '<p class="text-xs text-gray-400 italic">Sin ingresos</p>';
                } else {
                    for (const x of ingresos) {
                        const metBadge = x.metodoPago === 'efectivo'
                            ? '<span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded text-xs font-bold ml-1">EF</span>'
                            : '<span class="bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded text-xs font-bold ml-1">TR</span>';
                        html += `
                            <div class="flex items-center justify-between bg-emerald-50 border border-emerald-100 rounded-lg px-3 py-2">
                                <div class="flex items-center gap-1 text-xs text-gray-700">
                                    ${getOrigenBadge(x.origen, x.origenLabel)}
                                    ${metBadge}
                                    <span class="text-gray-400 ml-1">(${x.cantidad})</span>
                                </div>
                                <span class="text-emerald-700 font-black text-xs">+${fmt(x.total)}</span>
                            </div>`;
                    }
                    const totalIng = ingresos.reduce((s, x) => s + x.total, 0);
                    html += `
                            <div class="flex justify-between border-t border-emerald-200 pt-1 mt-1 px-1">
                                <span class="text-xs font-black text-emerald-800">Total Ingresos</span>
                                <span class="text-xs font-black text-emerald-800">+${fmt(totalIng)}</span>
                            </div>`;
                }
                html += `</div></div>`;

                // Columna Egresos
                html += `
                    <div>
                        <p class="text-xs font-black text-red-700 uppercase mb-2 flex items-center gap-1">
                            <i data-lucide="trending-down" class="w-3.5 h-3.5"></i> Origen de Egresos
                        </p>
                        <div class="space-y-1">`;
                if (egresos.length === 0) {
                    html += '<p class="text-xs text-gray-400 italic">Sin egresos</p>';
                } else {
                    for (const x of egresos) {
                        const metBadge = x.metodoPago === 'efectivo'
                            ? '<span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded text-xs font-bold ml-1">EF</span>'
                            : '<span class="bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded text-xs font-bold ml-1">TR</span>';
                        const catLabel = x.categoria ? ` — ${formatCategoria(x.categoria)}` : '';
                        html += `
                            <div class="flex items-center justify-between bg-red-50 border border-red-100 rounded-lg px-3 py-2">
                                <div class="flex items-center gap-1 text-xs text-gray-700">
                                    ${getOrigenBadge(x.origen, x.origenLabel)}
                                    ${metBadge}
                                    ${catLabel ? `<span class="text-gray-400 text-xs">${catLabel}</span>` : ''}
                                    <span class="text-gray-400 ml-1">(${x.cantidad})</span>
                                </div>
                                <span class="text-red-600 font-black text-xs">-${fmt(x.total)}</span>
                            </div>`;
                    }
                    const totalEgr = egresos.reduce((s, x) => s + x.total, 0);
                    html += `
                            <div class="flex justify-between border-t border-red-200 pt-1 mt-1 px-1">
                                <span class="text-xs font-black text-red-800">Total Egresos</span>
                                <span class="text-xs font-black text-red-800">-${fmt(totalEgr)}</span>
                            </div>`;
                }
                html += `</div></div></div>`;

                // Nota si es calculado en tiempo real
                html += `
                <p class="text-xs text-gray-400 italic text-right mt-3">
                    * Desglose calculado en tiempo real desde los movimientos actuales de Caja Fuerte.
                    ${data.yaConsolidado ? 'Los totales del consolidado guardado pueden diferir si hubo cambios después de consolidar.' : ''}
                </p>`;

                contenedorEl.innerHTML = html;
                lucide.createIcons();
            } catch (e) {
                contenedorEl.innerHTML = '<p class="text-xs text-red-500 text-center py-4">Error al cargar desglose</p>';
            }
        }

        async function recalcularConsolidado(mes, anio, btnEl) {
            if (!confirm(`¿Recalcular el consolidado de ${mes}/${anio} desde los movimientos reales?\nEsto sobrescribirá los totales guardados.`)) return;

            btnEl.disabled = true;
            btnEl.innerHTML = '<div class="animate-spin w-3 h-3 border-2 border-purple-500 border-t-transparent rounded-full inline-block mr-1"></div> Recalculando...';

            try {
                const res  = await fetch('/api/cajafuerte/recalcular-consolidado', {
                    method: 'PUT', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mes, anio })
                });
                const data = await res.json();

                if (data.success) {
                    showToast(data.message, 'success');
                    cargarConsolidados();
                } else {
                    showToast(data.message || 'Error al recalcular', 'error');
                    btnEl.disabled = false;
                    btnEl.innerHTML = '<i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Recalcular';
                    lucide.createIcons();
                }
            } catch (e) {
                showToast('Error de conexión al recalcular', 'error');
                btnEl.disabled = false;
                btnEl.innerHTML = '<i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Recalcular';
                lucide.createIcons();
            }
        }

        // =========================================================
        // PREVIEW CONSOLIDADO (tiempo real)
        // =========================================================
        function abrirModalPreview() {
            abrirModal('modal-preview');
            cargarPreview();
        }

        async function cargarPreview() {
            const mes  = document.getElementById('preview-mes').value;
            const anio = document.getElementById('preview-anio').value;
            const cont = document.getElementById('preview-contenido');

            cont.innerHTML = '<div class="text-center py-8 text-gray-400"><div class="animate-spin w-8 h-8 border-4 border-teal-500 border-t-transparent rounded-full mx-auto mb-3"></div><p>Calculando...</p></div>';

            try {
                const res  = await fetch(`/api/cajafuerte/consolidados/preview?mes=${mes}&anio=${anio}`);
                const data = await res.json();
                if (!data.success) { cont.innerHTML = `<p class="text-red-500 text-center py-4">${data.message || 'Error'}</p>`; return; }

                let html = `
                <div class="space-y-4">
                    <!-- Estado -->
                    <div class="flex items-center gap-3 p-3 rounded-xl ${data.yaConsolidado ? 'bg-purple-50 border border-purple-200' : 'bg-teal-50 border border-teal-200'}">
                        <i data-lucide="${data.yaConsolidado ? 'archive' : 'clock'}" class="w-5 h-5 ${data.yaConsolidado ? 'text-purple-600' : 'text-teal-600'}"></i>
                        <div>
                            <p class="text-sm font-bold ${data.yaConsolidado ? 'text-purple-800' : 'text-teal-800'}">
                                ${data.yaConsolidado ? '✅ Ya consolidado — mostrando datos actuales vs guardados' : '📋 Sin consolidar — preview en tiempo real'}
                            </p>
                            <p class="text-xs text-gray-500">${data.cantidadMovimientos} movimiento(s) en ${data.periodo}</p>
                        </div>
                    </div>

                    <!-- Resumen general -->
                    <div class="grid grid-cols-3 gap-3">
                        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-3 text-center">
                            <p class="text-xs text-emerald-700 font-bold uppercase mb-1">Ingresos</p>
                            <p class="text-lg font-black text-emerald-700">+${fmt(data.totales.ingresos)}</p>
                            <p class="text-xs text-gray-400 mt-1">Ef: +${fmt(data.efectivo.ingresos)}<br>Tr: +${fmt(data.transferencias.ingresos)}</p>
                        </div>
                        <div class="bg-red-50 border border-red-200 rounded-xl p-3 text-center">
                            <p class="text-xs text-red-700 font-bold uppercase mb-1">Egresos</p>
                            <p class="text-lg font-black text-red-700">-${fmt(data.totales.egresos)}</p>
                            <p class="text-xs text-gray-400 mt-1">Ef: -${fmt(data.efectivo.egresos)}<br>Tr: -${fmt(data.transferencias.egresos)}</p>
                        </div>
                        <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-center">
                            <p class="text-xs text-amber-700 font-bold uppercase mb-1">Balance Neto</p>
                            <p class="text-lg font-black ${data.totales.balance >= 0 ? 'text-emerald-700' : 'text-red-600'}">${fmt(data.totales.balance)}</p>
                            <p class="text-xs text-gray-400 mt-1">Ef: ${fmt(data.efectivo.balance)}<br>Tr: ${fmt(data.transferencias.balance)}</p>
                        </div>
                    </div>`;

                // Desglose por origen
                if (data.desglosePorOrigen && data.desglosePorOrigen.length > 0) {
                    html += `
                    <div>
                        <p class="text-xs font-black text-gray-600 uppercase mb-2">Desglose por origen de movimientos</p>
                        <div class="space-y-1">`;
                    for (const x of data.desglosePorOrigen) {
                        const esIng = x.tipo === 'ingreso';
                        const cls   = esIng ? 'bg-emerald-50 border-emerald-100 text-emerald-700' : 'bg-red-50 border-red-100 text-red-600';
                        const metBadge = x.metodoPago === 'efectivo'
                            ? '<span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded text-xs font-bold">EF</span>'
                            : '<span class="bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded text-xs font-bold">TR</span>';

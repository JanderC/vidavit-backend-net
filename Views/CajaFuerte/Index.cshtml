        async function realizarTransferencia() {
            const monto = parseFloat(document.getElementById('transfer-monto').value);
            const descripcion = document.getElementById('transfer-descripcion').value.trim();
            const errorEl = document.getElementById('transfer-error');
            errorEl.classList.add('hidden');
            if (!monto || monto <= 0) { errorEl.textContent = 'El monto debe ser mayor a 0'; errorEl.classList.remove('hidden'); return; }
            if (monto > balanceEfectivoActual) { errorEl.textContent = `Saldo insuficiente. Disponible: ${fmt(balanceEfectivoActual)}`; errorEl.classList.remove('hidden'); return; }
            try {
                const res = await fetch('/api/cajafuerte/transferir-a-caja', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ monto, descripcion }) });
                const data = await res.json();
                if (data.success) { cerrarModal('modal-transferencia'); showToast(`${fmt(monto)} enviados a Caja Diaria`, 'success'); cargarBalances(); cargarMovimientos(); }
                else { errorEl.textContent = data.message || 'Error'; errorEl.classList.remove('hidden'); }
            } catch (e) { errorEl.textContent = 'Error de conexión'; errorEl.classList.remove('hidden'); }
        }

        async function cambiarPassword() {
            const actual = document.getElementById('pwd-actual').value;
            const nueva = document.getElementById('pwd-nueva').value;
            const confirmar = document.getElementById('pwd-confirmar').value;
            const errorEl = document.getElementById('pwd-error');
            errorEl.classList.add('hidden');
            if (!actual || !nueva || !confirmar) { errorEl.textContent = 'Complete todos los campos'; errorEl.classList.remove('hidden'); return; }
            if (nueva !== confirmar) { errorEl.textContent = 'Las contraseñas no coinciden'; errorEl.classList.remove('hidden'); return; }
            if (nueva.length < 4) { errorEl.textContent = 'Mínimo 4 caracteres'; errorEl.classList.remove('hidden'); return; }
            try {
                const res = await fetch('/api/cajafuerte/cambiar-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ passwordActual: actual, passwordNueva: nueva }) });
                const data = await res.json();
                if (data.success) { cerrarModal('modal-password'); showToast('Contraseña cambiada exitosamente', 'success'); }
                else { errorEl.textContent = data.message || 'Error'; errorEl.classList.remove('hidden'); }
            } catch (e) { errorEl.textContent = 'Error de conexión'; errorEl.classList.remove('hidden'); }
        }

        async function consolidarMes() {
            const mes = parseInt(document.getElementById('consolidar-mes').value);
            const anio = parseInt(document.getElementById('consolidar-anio').value);
            const errorEl = document.getElementById('consolidar-error');
            errorEl.classList.add('hidden');
            try {
                const res = await fetch('/api/cajafuerte/consolidar-mes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mes, anio }) });
                const data = await res.json();
                if (data.success) { cerrarModal('modal-consolidar'); showToast(data.message, 'success'); cargarConsolidados(); }
                else { errorEl.textContent = data.message || 'Error'; errorEl.classList.remove('hidden'); }
            } catch (e) { errorEl.textContent = 'Error de conexión'; errorEl.classList.remove('hidden'); }
        }

        // =========================================================
        // TABS Y FILTROS
        // =========================================================
        function cambiarTab(tab) {
            document.querySelectorAll('.tab-cf-content').forEach(c => c.classList.add('hidden'));
            document.querySelectorAll('.tab-cf-btn').forEach(b => { b.classList.remove('border-amber-600','bg-amber-50','text-amber-700'); b.classList.add('text-gray-500','border-transparent'); });
            document.getElementById(`content-${tab}`)?.classList.remove('hidden');
            const btn = document.getElementById(`tab-${tab}`);
            if (btn) { btn.classList.add('border-amber-600','bg-amber-50','text-amber-700'); btn.classList.remove('text-gray-500','border-transparent'); }
            if (tab === 'consolidados') cargarConsolidados();
        }

        function setVista(vista) {
            vistaActual = vista;
            document.querySelectorAll('.vista-btn').forEach(b => { b.classList.remove('border-amber-600','bg-amber-50','text-amber-700'); b.classList.add('border-gray-300','text-gray-600'); });
            const btn = document.getElementById(`btn-vista-${vista}`);
            if (btn) { btn.classList.add('border-amber-600','bg-amber-50','text-amber-700'); btn.classList.remove('border-gray-300','text-gray-600'); }
            cargarMovimientos(vista);
        }

        function buscarConRango() {
            const desde = document.getElementById('cf-fecha-desde').value;
            const hasta = document.getElementById('cf-fecha-hasta').value;
            if (!desde || !hasta) { showToast('Seleccione fechas de inicio y fin', 'error'); return; }
            if (desde > hasta) { showToast('La fecha inicio no puede ser mayor al fin', 'error'); return; }
            document.querySelectorAll('.vista-btn').forEach(b => { b.classList.remove('border-amber-600','bg-amber-50','text-amber-700'); b.classList.add('border-gray-300','text-gray-600'); });
            vistaActual = 'rango';
            cargarMovimientos(null, desde, hasta);
        }

        function limpiarFiltros() {
            document.getElementById('cf-filtro-tipo').value = '';
            document.getElementById('cf-filtro-metodo').value = '';
            setVista('mensual');
        }

        // =========================================================
        // MODALES
        // =========================================================
        function abrirModalIngreso()     { document.getElementById('ingreso-monto').value=''; document.getElementById('ingreso-descripcion').value=''; document.getElementById('ingreso-metodo').value='efectivo'; document.getElementById('ingreso-error').classList.add('hidden'); abrirModal('modal-ingreso'); }
        function abrirModalEgreso()      { document.getElementById('egreso-monto').value='';  document.getElementById('egreso-descripcion').value='';  document.getElementById('egreso-metodo').value='efectivo';  document.getElementById('egreso-error').classList.add('hidden');  abrirModal('modal-egreso');  }
        function abrirModalTransferencia(){ document.getElementById('transfer-monto').value=''; document.getElementById('transfer-descripcion').value=''; document.getElementById('transfer-error').classList.add('hidden'); document.getElementById('disp-efectivo-transfer').textContent = fmt(balanceEfectivoActual); abrirModal('modal-transferencia'); }
        function abrirModalPassword()    { ['pwd-actual','pwd-nueva','pwd-confirmar'].forEach(id=>document.getElementById(id).value=''); document.getElementById('pwd-error').classList.add('hidden'); abrirModal('modal-password'); }
        function abrirModalConsolidar()  { document.getElementById('consolidar-error').classList.add('hidden'); abrirModal('modal-consolidar'); }

        function abrirModal(id) { document.getElementById(id).classList.remove('hidden'); document.getElementById(id).classList.add('flex'); lucide.createIcons(); }
        function cerrarModal(id){ document.getElementById(id).classList.add('hidden'); document.getElementById(id).classList.remove('flex'); }

        document.addEventListener('click', (e) => {
            ['modal-ingreso','modal-egreso','modal-transferencia','modal-password','modal-consolidar','modal-preview','modal-eliminar','modal-detalle-dia'].forEach(id => {
                const modal = document.getElementById(id);
                if (modal && e.target === modal) cerrarModal(id);
            });
        });

        // =========================================================
        // HELPERS DE RENDER
        // =========================================================
        function normalizarMovimiento(_m) {
            return {
                id:          (_m.Id          ?? _m.id          ?? '').toString(),
                tipo:        (_m.Tipo        ?? _m.tipo        ?? '').toLowerCase(),
                origen:      (_m.Origen      ?? _m.origen      ?? ''),
                origenLabel: (_m.origenLabel ?? _m.OrigenLabel ?? ''),
                metodoPago:  (_m.MetodoPago  ?? _m.metodoPago  ?? '').toLowerCase(),
                monto:       (_m.Monto       ?? _m.monto       ?? 0),
                descripcion: (_m.Descripcion ?? _m.descripcion ?? ''),
                categoria:   (_m.Categoria   ?? _m.categoria   ?? null),
                fecha:       (_m.fecha       ?? _m.Fecha       ?? ''),
                esCierreCaja:(_m.esCierreCaja ?? (_m.origen ?? _m.Origen) === 'cierre_caja' ?? false),
                cierreCajaId:(_m.cierreCajaId ?? _m.CierreCajaId ?? null),
            };
        }

        function getOrigenBadge(origen, label) {
            const cfg = {
                'cierre_caja':              { cls: 'bg-amber-100 text-amber-700',    icon: 'lock' },
                'retiro_manual':            { cls: 'bg-red-100 text-red-700',        icon: 'arrow-up-right' },
                'transferencia_a_caja':     { cls: 'bg-blue-100 text-blue-700',      icon: 'arrow-right' },
                'transferencia_desde_caja': { cls: 'bg-indigo-100 text-indigo-700',  icon: 'arrow-left' },
                'ingreso_manual':           { cls: 'bg-emerald-100 text-emerald-700', icon: 'plus' },
            };
            const c = cfg[origen] || { cls: 'bg-gray-100 text-gray-600', icon: 'circle' };
            const displayLabel = label && label !== origen ? label : (cfg[origen] ? ({
                'cierre_caja':'Cierre Caja','retiro_manual':'Retiro Manual',
                'transferencia_a_caja':'→ Caja Diaria','transferencia_desde_caja':'← Desde Caja',
                'ingreso_manual':'Ingreso Manual'
            }[origen] || origen) : origen);
            return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-bold ${c.cls}">
                        <i data-lucide="${c.icon}" class="w-2.5 h-2.5"></i>${displayLabel}
                    </span>`;
        }

        function formatCategoria(cat) {
            const map = { nomina:'Nómina', pago_proveedores:'Proveedores', servicios_publicos:'Servicios',
                mantenimiento:'Mantenimiento', arriendo:'Arriendo', impuestos:'Impuestos',
                equipos:'Equipos', marketing:'Marketing', capital:'Capital',
                prestamo:'Préstamo', ajuste:'Ajuste', otros:'Otros' };
            return map[cat] || cat || '—';
        }

        // =========================================================
        // UTILIDADES
        // =========================================================
        function fmt(val) {
            return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val || 0);
        }
        // Parsea el string del servidor como hora LOCAL (sin conversión UTC)
        function parsearFechaLocal(iso) {
            if (!iso) return null;
            const partes = iso.split('T');
            const f = partes[0].split('-');
            const anio = parseInt(f[0], 10), mes = parseInt(f[1], 10) - 1, dia = parseInt(f[2], 10);
            let h = 0, m = 0, s = 0;
            if (partes[1]) {
                const t = partes[1].split(':');
                h = parseInt(t[0], 10) || 0;
                m = parseInt(t[1], 10) || 0;
                s = parseInt(t[2], 10) || 0;
            }
            return new Date(anio, mes, dia, h, m, s);
        }
        // Fecha + hora en formato 12h AM/PM — sin desfase UTC
        function fmtFecha(iso) {
            if (!iso) return '—';
            const d = parsearFechaLocal(iso);
            if (!d || isNaN(d.getTime())) return '—';
            const dia  = d.getDate();
            const mes  = d.toLocaleString('es-CO', { month: 'short' });
            const anio = d.getFullYear();
            const h24  = d.getHours();
            const min  = String(d.getMinutes()).padStart(2, '0');
            const ampm = h24 >= 12 ? 'PM' : 'AM';
            const h12  = h24 % 12 || 12;
            return `${dia} ${mes} ${anio}, ${h12}:${min} ${ampm}`;
        }
        // Solo fecha — sin desfase UTC
        function fmtFechaCorta(iso) {
            if (!iso) return '—';
            // Si viene solo fecha (YYYY-MM-DD) agregar T00:00:00 para evitar offset
            const d = parsearFechaLocal(iso.includes('T') ? iso : iso + 'T00:00:00');
            if (!d || isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('es-CO', { day:'2-digit', month:'short', year:'numeric' });
        }

        let toastTimeout;
        function showToast(msg, tipo = 'success') {
            clearTimeout(toastTimeout);
            const toast = document.getElementById('toast-cf');
            const inner = document.getElementById('toast-cf-inner');
            const icon  = document.getElementById('toast-cf-icon');
            document.getElementById('toast-cf-msg').textContent = msg;
            inner.className = `px-6 py-4 rounded-xl shadow-2xl text-white font-bold text-sm flex items-center gap-3 max-w-sm ${tipo === 'success' ? 'bg-emerald-600' : 'bg-red-600'}`;
            icon.setAttribute('data-lucide', tipo === 'success' ? 'check-circle' : 'x-circle');
            lucide.createIcons();
            toast.classList.remove('hidden');
            toastTimeout = setTimeout(() => toast.classList.add('hidden'), 3500);
        }
         document.querySelectorAll('input[type="number"]').forEach(function(input) {
            input.addEventListener('wheel', function(e) {
                e.preventDefault();
            }, { passive: false });
        });


    </script>
}

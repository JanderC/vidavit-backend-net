        // =========================================================
        // DETALLE DE VENTAS (cierre de caja diaria)
        // =========================================================
        const _detalleCierreCache = {};

        async function toggleDetalleCierre(detalleId, movimientoId) {
            const fila = document.getElementById(detalleId);
            const btn  = document.getElementById(`btn-${detalleId}`);
            if (!fila) return;

            const estaOculto = fila.classList.contains('hidden');
            fila.classList.toggle('hidden');
            lucide.createIcons();

            if (!estaOculto) {
                btn.innerHTML = '<i data-lucide="receipt-text" class="w-3 h-3"></i> Ver ventas';
                lucide.createIcons();
                return;
            }

            btn.innerHTML = '<i data-lucide="chevron-up" class="w-3 h-3"></i> Ocultar';
            lucide.createIcons();

            if (_detalleCierreCache[movimientoId]) {
                renderDetalleVentas(detalleId, _detalleCierreCache[movimientoId]);
                return;
            }

            const cierreId = btn.dataset.cierreId;
            if (!cierreId) {
                renderDetalleVentas(detalleId, null, 'No se encontró el ID del cierre');
                return;
            }

            try {
                const res  = await fetch(`/api/cajafuerte/movimientos-diarios?cierreId=${cierreId}`);
                const data = await res.json();
                _detalleCierreCache[movimientoId] = data;
                renderDetalleVentas(detalleId, data);
            } catch (e) {
                renderDetalleVentas(detalleId, null, 'Error al cargar ventas');
            }
        }

        function renderDetalleVentas(detalleId, data, errorMsg = null) {
            const container = document.getElementById(`contenido-${detalleId}`);
            if (!container) return;

            if (errorMsg || !data || !data.success) {
                container.innerHTML = `<p class="text-red-500 text-xs font-semibold">${errorMsg || 'Sin datos'}</p>`;
                return;
            }
            if (!data.data || data.data.length === 0) {
                container.innerHTML = '<p class="text-gray-400 text-xs italic">No se encontraron movimientos de caja diaria para este cierre.</p>';
                return;
            }

            const catMap = {
                membresia: 'Membresía', renovacion: 'Renovación', producto: 'Producto',
                abono_deuda: 'Abono Deuda', transferencia_cajafuerte: 'Desde Caja Fuerte', otro: 'Otro'
            };

            // Desglose rápido antes de la tabla
            const ingEf = data.data.filter(v => (v.Tipo ?? v.tipo ?? '').toLowerCase() === 'ingreso' && (v.MetodoPago ?? v.metodoPago ?? '') === 'efectivo').reduce((s, v) => s + (v.Monto ?? v.monto ?? 0), 0);
            const ingTr = data.data.filter(v => (v.Tipo ?? v.tipo ?? '').toLowerCase() === 'ingreso' && (v.MetodoPago ?? v.metodoPago ?? '') === 'transferencia').reduce((s, v) => s + (v.Monto ?? v.monto ?? 0), 0);
            const egrEf = data.data.filter(v => (v.Tipo ?? v.tipo ?? '').toLowerCase() === 'egreso'  && (v.MetodoPago ?? v.metodoPago ?? '') === 'efectivo').reduce((s, v) => s + (v.Monto ?? v.monto ?? 0), 0);
            const egrTr = data.data.filter(v => (v.Tipo ?? v.tipo ?? '').toLowerCase() === 'egreso'  && (v.MetodoPago ?? v.metodoPago ?? '') === 'transferencia').reduce((s, v) => s + (v.Monto ?? v.monto ?? 0), 0);

            let html = `
            <!-- Mini resumen del cierre -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-3">
                <div class="bg-green-50 border border-green-200 rounded-lg px-3 py-2 text-center">
                    <p class="text-xs text-green-700 font-bold">Ing. Efectivo</p>
                    <p class="text-sm font-black text-green-700">+${fmt(ingEf)}</p>
                </div>
                <div class="bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-center">
                    <p class="text-xs text-blue-700 font-bold">Ing. Transf.</p>
                    <p class="text-sm font-black text-blue-700">+${fmt(ingTr)}</p>
                </div>
                <div class="bg-orange-50 border border-orange-200 rounded-lg px-3 py-2 text-center">
                    <p class="text-xs text-orange-700 font-bold">Egr. Efectivo</p>
                    <p class="text-sm font-black text-orange-700">-${fmt(egrEf)}</p>
                </div>
                <div class="bg-red-50 border border-red-200 rounded-lg px-3 py-2 text-center">
                    <p class="text-xs text-red-700 font-bold">Egr. Transf.</p>
                    <p class="text-sm font-black text-red-700">-${fmt(egrTr)}</p>
                </div>
            </div>

            <!-- Tabla de movimientos -->
            <div class="overflow-x-auto rounded-xl border border-amber-200">
                <table class="w-full text-xs">
                    <thead>
                        <tr class="bg-amber-100 text-amber-800 font-black uppercase">
                            <th class="px-3 py-2 text-left">Tipo</th>
                            <th class="px-3 py-2 text-left">Categoría</th>
                            <th class="px-3 py-2 text-left">Método</th>
                            <th class="px-3 py-2 text-left">Descripción</th>
                            <th class="px-3 py-2 text-right">Monto</th>
                            <th class="px-3 py-2 text-center">Hora</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-amber-100 bg-white">`;

            for (const _v of data.data) {
                const v = {
                    tipo:       (_v.Tipo       ?? _v.tipo       ?? '').toLowerCase(),
                    monto:      (_v.Monto      ?? _v.monto      ?? 0),
                    descripcion:(_v.Descripcion?? _v.descripcion?? ''),
                    categoria:  (_v.Categoria  ?? _v.categoria  ?? null),
                    metodoPago: (_v.MetodoPago ?? _v.metodoPago ?? '').toLowerCase(),
                    fecha:      (_v.Fecha      ?? _v.fecha      ?? ''),
                };
                const esIng   = v.tipo === 'ingreso';
                const montoClass = esIng ? 'text-emerald-700 font-black' : 'text-red-600 font-black';
                const tipoClass  = esIng ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700';
                const metClass   = v.metodoPago === 'efectivo' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700';
                const hora = new Date(v.fecha).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
                const cat  = catMap[v.categoria] || v.categoria || '—';
                html += `
                    <tr class="hover:bg-amber-50/50">
                        <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded font-bold ${tipoClass}">${esIng ? '↑ Ingreso' : '↓ Egreso'}</span></td>
                        <td class="px-3 py-2 text-gray-600">${cat}</td>
                        <td class="px-3 py-2"><span class="px-1.5 py-0.5 rounded font-bold ${metClass}">${v.metodoPago === 'efectivo' ? 'Efectivo' : 'Transferencia'}</span></td>
                        <td class="px-3 py-2 text-gray-700 max-w-[220px] truncate" title="${v.descripcion || ''}">${v.descripcion || '—'}</td>
                        <td class="px-3 py-2 text-right ${montoClass}">${esIng ? '+' : '-'}${fmt(v.monto)}</td>
                        <td class="px-3 py-2 text-center text-gray-400 font-mono">${hora}</td>
                    </tr>`;
            }

            html += `
                    </tbody>
                    <tfoot>
                        <tr class="bg-amber-50 font-black text-amber-800">
                            <td colspan="4" class="px-3 py-2 text-xs uppercase">Totales del cierre</td>
                            <td class="px-3 py-2 text-right text-xs">
                                <span class="block text-emerald-700">+${fmt(data.totalIngresos)}</span>
                                <span class="block text-red-600">-${fmt(data.totalEgresos)}</span>
                            </td>
                            <td class="px-3 py-2 text-center text-xs font-black ${data.balance >= 0 ? 'text-emerald-700' : 'text-red-600'}">
                                ${data.balance >= 0 ? '+' : ''}${fmt(data.balance)}
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>`;

            container.innerHTML = html;
            lucide.createIcons();
        }

        // =========================================================
        // ACCIONES CRUD
        // =========================================================
        function selectMetodo(form, metodo) {
            document.getElementById(`${form}-metodo`).value = metodo;
            const ef = document.getElementById(`${form}-efectivo-btn`);
            const tr = document.getElementById(`${form}-transferencia-btn`);
            const colorActivo = form === 'ingreso'
                ? ['border-emerald-600', 'bg-emerald-50', 'text-emerald-700']
                : ['border-red-600', 'bg-red-50', 'text-red-700'];
            const colorInactivo = ['border-gray-300', 'text-gray-500', 'bg-white'];

            ef.classList.remove(...colorActivo, ...colorInactivo);
            tr.classList.remove(...colorActivo, ...colorInactivo);

            const base = ['border-2', 'font-bold', 'rounded-xl', 'text-sm', 'flex-1', 'py-3'];

            if (metodo === 'efectivo') {
                ef.classList.add(...colorActivo, ...base);
                tr.classList.add(...colorInactivo, ...base, 'hover:border-blue-500', 'hover:bg-blue-50');
            } else {
                tr.classList.add('border-blue-600', 'bg-blue-50', 'text-blue-700', ...base);
                ef.classList.add(...colorInactivo, ...base);
            }
        }

        async function registrarIngreso() {
            const monto      = parseFloat(document.getElementById('ingreso-monto').value);
            const descripcion= document.getElementById('ingreso-descripcion').value.trim();
            const metodo     = document.getElementById('ingreso-metodo').value;
            const categoria  = document.getElementById('ingreso-categoria').value;
            const errorEl    = document.getElementById('ingreso-error');
            errorEl.classList.add('hidden');
            if (!monto || monto <= 0) { errorEl.textContent = 'El monto debe ser mayor a 0'; errorEl.classList.remove('hidden'); return; }
            if (!descripcion)         { errorEl.textContent = 'Ingrese una descripción';       errorEl.classList.remove('hidden'); return; }
            try {
                const res  = await fetch('/api/cajafuerte/registrar-ingreso', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ monto, descripcion, metodoPago: metodo, categoria })
                });
                const data = await res.json();
                if (data.success) {
                    cerrarModal('modal-ingreso');
                    showToast(`Ingreso de ${fmt(monto)} registrado correctamente`, 'success');
                    cargarBalances(); cargarMovimientos();
                } else { errorEl.textContent = data.message || 'Error al registrar'; errorEl.classList.remove('hidden'); }
            } catch (e) { errorEl.textContent = 'Error de conexión'; errorEl.classList.remove('hidden'); }
        }

        async function registrarEgreso() {
            const monto      = parseFloat(document.getElementById('egreso-monto').value);
            const descripcion= document.getElementById('egreso-descripcion').value.trim();
            const metodo     = document.getElementById('egreso-metodo').value;
            const categoria  = document.getElementById('egreso-categoria').value;
            const errorEl    = document.getElementById('egreso-error');
            errorEl.classList.add('hidden');
            if (!monto || monto <= 0) { errorEl.textContent = 'El monto debe ser mayor a 0'; errorEl.classList.remove('hidden'); return; }
            if (!descripcion)         { errorEl.textContent = 'Ingrese una descripción';       errorEl.classList.remove('hidden'); return; }
            try {
                const res  = await fetch('/api/cajafuerte/registrar-egreso', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ monto, descripcion, metodoPago: metodo, categoria })
                });
                const data = await res.json();
                if (data.success) {
                    cerrarModal('modal-egreso');
                    showToast(`Egreso de ${fmt(monto)} registrado correctamente`, 'success');
                    cargarBalances(); cargarMovimientos();
                } else { errorEl.textContent = data.message || 'Error al registrar'; errorEl.classList.remove('hidden'); }
            } catch (e) { errorEl.textContent = 'Error de conexión'; errorEl.classList.remove('hidden'); }
        }

        async function realizarTransferencia() {
            const monto      = parseFloat(document.getElementById('transfer-monto').value);
            const descripcion= document.getElementById('transfer-descripcion').value.trim();
            const errorEl    = document.getElementById('transfer-error');
            errorEl.classList.add('hidden');
            if (!monto || monto <= 0) { errorEl.textContent = 'El monto debe ser mayor a 0'; errorEl.classList.remove('hidden'); return; }
            if (monto > balanceEfectivoActual) { errorEl.textContent = `Saldo insuficiente. Disponible: ${fmt(balanceEfectivoActual)}`; errorEl.classList.remove('hidden'); return; }
            try {
                const res  = await fetch('/api/cajafuerte/transferir-a-caja', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ monto, descripcion })
                });
                const data = await res.json();
                if (data.success) {
                    cerrarModal('modal-transferencia');
                    showToast(`${fmt(monto)} enviados a Caja Diaria`, 'success');
                    cargarBalances(); cargarMovimientos();
                } else { errorEl.textContent = data.message || 'Error al realizar transferencia'; errorEl.classList.remove('hidden'); }
            } catch (e) { errorEl.textContent = 'Error de conexión'; errorEl.classList.remove('hidden'); }
        }

        async function cambiarPassword() {
            const actual    = document.getElementById('pwd-actual').value;
            const nueva     = document.getElementById('pwd-nueva').value;
            const confirmar = document.getElementById('pwd-confirmar').value;
            const errorEl   = document.getElementById('pwd-error');
            errorEl.classList.add('hidden');
            if (!actual || !nueva || !confirmar) { errorEl.textContent = 'Complete todos los campos'; errorEl.classList.remove('hidden'); return; }
            if (nueva !== confirmar) { errorEl.textContent = 'Las contraseñas nuevas no coinciden'; errorEl.classList.remove('hidden'); return; }
            if (nueva.length < 4)   { errorEl.textContent = 'La nueva contraseña debe tener al menos 4 caracteres'; errorEl.classList.remove('hidden'); return; }
            try {
                const res  = await fetch('/api/cajafuerte/cambiar-password', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ passwordActual: actual, passwordNueva: nueva })
                });
                const data = await res.json();
                if (data.success) { cerrarModal('modal-password'); showToast('Contraseña cambiada exitosamente', 'success'); }
                else { errorEl.textContent = data.message || 'Error'; errorEl.classList.remove('hidden'); }
            } catch (e) { errorEl.textContent = 'Error de conexión'; errorEl.classList.remove('hidden'); }
        }

        async function consolidarMes() {
            const mes    = parseInt(document.getElementById('consolidar-mes').value);
            const anio   = parseInt(document.getElementById('consolidar-anio').value);
            const errorEl= document.getElementById('consolidar-error');
            errorEl.classList.add('hidden');
            try {
                const res  = await fetch('/api/cajafuerte/consolidar-mes', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mes, anio })
                });
                const data = await res.json();
                if (data.success) { cerrarModal('modal-consolidar'); showToast(data.message, 'success'); cargarConsolidados(); }
                else { errorEl.textContent = data.message || 'Error al consolidar'; errorEl.classList.remove('hidden'); }
            } catch (e) { errorEl.textContent = 'Error de conexión'; errorEl.classList.remove('hidden'); }
        }

        async function eliminarMovimiento(id, descripcion) {
            if (!confirm(`¿Eliminar el movimiento "${descripcion}"?\nEsta acción revertirá el monto del balance.`)) return;
            const motivo = prompt('Motivo de eliminación (opcional):') || 'Sin motivo especificado';
            try {
                const res  = await fetch(`/api/cajafuerte/movimientos/${id}`, {
                    method: 'DELETE', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ motivo })
                });
                const data = await res.json();
                if (data.success) { showToast('Movimiento eliminado y balance actualizado', 'success'); cargarBalances(); cargarMovimientos(); }
                else { showToast(data.message || 'Error al eliminar', 'error'); }
            } catch (e) { showToast('Error de conexión al eliminar', 'error'); }
        }

        // =========================================================
        // MODALES
        // =========================================================
        function abrirModalIngreso()     { document.getElementById('ingreso-monto').value=''; document.getElementById('ingreso-descripcion').value=''; document.getElementById('ingreso-metodo').value='efectivo'; document.getElementById('ingreso-error').classList.add('hidden'); abrirModal('modal-ingreso'); }
        function abrirModalEgreso()      { document.getElementById('egreso-monto').value='';  document.getElementById('egreso-descripcion').value='';  document.getElementById('egreso-metodo').value='efectivo';  document.getElementById('egreso-error').classList.add('hidden');  abrirModal('modal-egreso');  }
        function abrirModalTransferencia(){ document.getElementById('transfer-monto').value=''; document.getElementById('transfer-descripcion').value=''; document.getElementById('transfer-error').classList.add('hidden'); document.getElementById('disp-efectivo-transfer').textContent = fmt(balanceEfectivoActual); abrirModal('modal-transferencia'); }
        function abrirModalPassword()    { ['pwd-actual','pwd-nueva','pwd-confirmar'].forEach(id=>document.getElementById(id).value=''); document.getElementById('pwd-error').classList.add('hidden'); abrirModal('modal-password'); }
        function abrirModalConsolidar()  { document.getElementById('consolidar-error').classList.add('hidden'); abrirModal('modal-consolidar'); }

        function abrirModal(id) { document.getElementById(id).classList.remove('hidden'); document.getElementById(id).classList.add('flex'); lucide.createIcons(); }
        function cerrarModal(id){ document.getElementById(id).classList.add('hidden');    document.getElementById(id).classList.remove('flex'); }

        document.addEventListener('click', (e) => {
            ['modal-ingreso','modal-egreso','modal-transferencia','modal-password','modal-consolidar','modal-preview'].forEach(id => {
                const modal = document.getElementById(id);
                if (modal && e.target === modal) cerrarModal(id);
            });
        });

        // =========================================================
        // HELPERS DE RENDER
        // =========================================================
        function getOrigenBadge(origen, label) {
            const cfg = {
                'cierre_caja':              { cls: 'bg-amber-100 text-amber-700',   icon: 'lock' },
                'retiro_manual':            { cls: 'bg-red-100 text-red-700',       icon: 'arrow-up-right' },
                'transferencia_a_caja':     { cls: 'bg-blue-100 text-blue-700',     icon: 'arrow-right' },
                'transferencia_desde_caja': { cls: 'bg-indigo-100 text-indigo-700', icon: 'arrow-left' },
                'ingreso_manual':           { cls: 'bg-emerald-100 text-emerald-700',icon: 'plus' },
            };
            const c = cfg[origen] || { cls: 'bg-gray-100 text-gray-600', icon: 'circle' };
            return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-bold ${c.cls}">
                        <i data-lucide="${c.icon}" class="w-2.5 h-2.5"></i>${label || origen}
                    </span>`;
        }

        function formatCategoria(cat) {
            const map = {
                nomina:'Nómina', pago_proveedores:'Proveedores', servicios_publicos:'Servicios',
                mantenimiento:'Mantenimiento', arriendo:'Arriendo', impuestos:'Impuestos',
                equipos:'Equipos', marketing:'Marketing', capital:'Capital',
                prestamo:'Préstamo', ajuste:'Ajuste', otros:'Otros'
            };
            return map[cat] || cat || '—';
        }

        // =========================================================
        // UTILIDADES
        // =========================================================
        function fmt(val) {
            return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val || 0);
        }

        function fmtFecha(iso) {
            if (!iso) return '—';
            return new Date(iso).toLocaleString('es-CO', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
        }

        function fmtFechaCorta(iso) {
            if (!iso) return '—';
            return new Date(iso + 'T00:00:00').toLocaleDateString('es-CO', { day:'2-digit', month:'short', year:'numeric' });
        }

        let toastTimeout;
        function showToast(msg, tipo = 'success') {
            clearTimeout(toastTimeout);
            const toast = document.getElementById('toast-cf');
            const inner = document.getElementById('toast-cf-inner');
            const icon  = document.getElementById('toast-cf-icon');
            document.getElementById('toast-cf-msg').textContent = msg;
            inner.className = `px-6 py-4 rounded-xl shadow-2xl text-white font-bold text-sm flex items-center gap-3 max-w-sm ${tipo === 'success' ? 'bg-emerald-600' : 'bg-red-600'}`;
            icon.setAttribute('data-lucide', tipo === 'success' ? 'check-circle' : 'x-circle');
            lucide.createIcons();
            toast.classList.remove('hidden');
            toastTimeout = setTimeout(() => toast.classList.add('hidden'), 3500);
        }
    </script>
}

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Caja Fuerte";
    ViewData["Subtitle"] = "Gestión de fondos del negocio - TAURO GYM";
}

<!-- MODAL AUTENTICACIÓN -->
<div id="modal-auth" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-sm border-2 border-amber-400">
        <div class="text-center mb-6">
            <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="lock" class="w-8 h-8 text-amber-600"></i>
            </div>
            <h2 class="text-2xl font-black text-gray-800">Caja Fuerte</h2>
            <p class="text-sm text-gray-500 mt-1">Ingrese la contraseña para acceder</p>
        </div>
        <div class="space-y-4">
            <input type="password" id="auth-password" placeholder="••••••••"
                   class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl text-center text-xl tracking-widest focus:ring-2 focus:ring-amber-500 focus:border-amber-500 font-black"
                   onkeydown="if(event.key==='Enter') verificarAuth()">
            <div id="auth-error" class="hidden text-red-600 text-sm text-center font-semibold"></div>
            <button onclick="verificarAuth()" class="w-full py-3 bg-amber-600 hover:bg-amber-700 text-white font-black rounded-xl transition-all text-lg">
                <i data-lucide="unlock" class="w-5 h-5 inline-block mr-2"></i>INGRESAR
            </button>
        </div>
    </div>
</div>

<!-- CONTENIDO PRINCIPAL (oculto hasta autenticar) -->
<div id="contenido-principal" class="hidden space-y-6">

    <!-- HEADER CON ACCIONES -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-black text-gray-800 flex items-center gap-2">
                <i data-lucide="shield" class="w-7 h-7 text-amber-600"></i>
                Caja Fuerte
            </h2>
            <p class="text-sm text-gray-500 mt-1">Última actualización: <span id="ultima-actualizacion" class="font-semibold text-amber-700">—</span></p>
        </div>
        <div class="flex gap-2 flex-wrap">
            <button onclick="abrirModalIngreso()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl transition-all text-sm flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-4 h-4"></i> Registrar Ingreso
            </button>
            <button onclick="abrirModalEgreso()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition-all text-sm flex items-center gap-2">
                <i data-lucide="minus-circle" class="w-4 h-4"></i> Registrar Egreso
            </button>
            <button onclick="abrirModalTransferencia()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-all text-sm flex items-center gap-2">
                <i data-lucide="arrow-left-right" class="w-4 h-4"></i> Enviar a Caja Diaria
            </button>
            <button onclick="abrirModalPassword()" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-bold rounded-xl transition-all text-sm flex items-center gap-2">
                <i data-lucide="key" class="w-4 h-4"></i> Cambiar Clave
            </button>
        </div>
    </div>

    <!-- BALANCES PRINCIPALES -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Efectivo -->
        <div class="bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-2xl shadow-xl p-6 text-white">
            <div class="flex items-center justify-between mb-4">
                <p class="text-emerald-200 font-bold uppercase text-xs tracking-widest">Efectivo en Caja</p>
                <div class="w-10 h-10 bg-emerald-500/50 rounded-full flex items-center justify-center">
                    <i data-lucide="banknote" class="w-5 h-5 text-white"></i>
                </div>
            </div>
            <p class="text-4xl font-black" id="balance-efectivo">$0.00</p>
            <div class="mt-3 pt-3 border-t border-emerald-500/50 flex justify-between text-xs text-emerald-200">
                <span>↑ Ingresos hoy: <span id="ing-ef-hoy" class="font-bold text-white">$0</span></span>
                <span>↓ Egresos hoy: <span id="egr-ef-hoy" class="font-bold text-white">$0</span></span>
            </div>
        </div>

        <!-- Transferencias -->
        <div class="bg-gradient-to-br from-blue-600 to-blue-800 rounded-2xl shadow-xl p-6 text-white">
            <div class="flex items-center justify-between mb-4">
                <p class="text-blue-200 font-bold uppercase text-xs tracking-widest">Transferencias (Contable)</p>
                <div class="w-10 h-10 bg-blue-500/50 rounded-full flex items-center justify-center">
                    <i data-lucide="credit-card" class="w-5 h-5 text-white"></i>
                </div>
            </div>
            <p class="text-4xl font-black" id="balance-transferencias">$0.00</p>
            <div class="mt-3 pt-3 border-t border-blue-500/50 flex justify-between text-xs text-blue-200">
                <span>↑ Ingresos hoy: <span id="ing-tr-hoy" class="font-bold text-white">$0</span></span>
                <span>↓ Egresos hoy: <span id="egr-tr-hoy" class="font-bold text-white">$0</span></span>
            </div>
        </div>

        <!-- Total -->
        <div class="bg-gradient-to-br from-amber-500 to-amber-700 rounded-2xl shadow-xl p-6 text-white">
            <div class="flex items-center justify-between mb-4">
                <p class="text-amber-100 font-bold uppercase text-xs tracking-widest">Balance Total Acumulado</p>
                <div class="w-10 h-10 bg-amber-400/50 rounded-full flex items-center justify-center">
                    <i data-lucide="vault" class="w-5 h-5 text-white"></i>
                </div>
            </div>
            <p class="text-4xl font-black" id="balance-total">$0.00</p>
            <div class="mt-3 pt-3 border-t border-amber-400/50 flex justify-between text-xs text-amber-100">
                <span>Ingresos mes: <span id="ing-mes" class="font-bold text-white">$0</span></span>
                <span>Egresos mes: <span id="egr-mes" class="font-bold text-white">$0</span></span>
            </div>
        </div>
    </div>

    <!-- TABS -->
    <div class="bg-white rounded-2xl shadow-xl border-2 border-gray-200 overflow-hidden">
        <div class="flex border-b-2 border-gray-200 overflow-x-auto">
            <button onclick="cambiarTab('movimientos')" id="tab-movimientos"
                    class="tab-cf-btn flex-shrink-0 px-6 py-4 font-black uppercase tracking-wide transition-all text-sm border-b-4 border-amber-600 bg-amber-50 text-amber-700">
                <i data-lucide="list" class="w-4 h-4 inline-block mr-1"></i> Movimientos
            </button>
            <button onclick="cambiarTab('consolidados')" id="tab-consolidados"
                    class="tab-cf-btn flex-shrink-0 px-6 py-4 font-black uppercase tracking-wide transition-all text-sm hover:bg-gray-50 text-gray-500 border-b-4 border-transparent">
                <i data-lucide="archive" class="w-4 h-4 inline-block mr-1"></i> Consolidados Mensuales
            </button>
        </div>

        <!-- TAB MOVIMIENTOS -->
        <div id="content-movimientos" class="tab-cf-content p-6">
            <!-- FILTROS -->
            <div class="bg-gray-50 rounded-xl p-4 mb-6 border border-gray-200">
                <div class="flex flex-wrap gap-3 items-end">
                    <!-- Vista rápida -->
                    <div>
                        <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Vista Rápida</label>
                        <div class="flex gap-1">
                            <button onclick="setVista('diario')" id="btn-vista-diario"
                                    class="vista-btn px-3 py-2 text-xs font-bold rounded-lg border-2 border-gray-300 hover:border-amber-500 hover:bg-amber-50 transition-all">
                                Hoy
                            </button>
                            <button onclick="setVista('semanal')" id="btn-vista-semanal"
                                    class="vista-btn px-3 py-2 text-xs font-bold rounded-lg border-2 border-gray-300 hover:border-amber-500 hover:bg-amber-50 transition-all">
                                Esta Semana
                            </button>
                            <button onclick="setVista('mensual')" id="btn-vista-mensual"
                                    class="vista-btn px-3 py-2 text-xs font-bold rounded-lg border-2 border-amber-600 bg-amber-50 text-amber-700 transition-all">
                                Este Mes
                            </button>
                        </div>
                    </div>

                    <!-- Rango personalizado -->
                    <div>
                        <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Desde</label>
                        <input type="date" id="cf-fecha-desde"
                               class="px-3 py-2 border-2 border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    <div>
                        <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Hasta</label>
                        <input type="date" id="cf-fecha-hasta"
                               class="px-3 py-2 border-2 border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>

                    <!-- Filtro tipo -->
                    <div>
                        <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Tipo</label>
                        <select id="cf-filtro-tipo"
                                class="px-3 py-2 border-2 border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                            <option value="">Todos</option>
                            <option value="ingreso">Solo Ingresos</option>
                            <option value="egreso">Solo Egresos</option>
                        </select>
                    </div>

                    <!-- Filtro método pago -->
                    <div>
                        <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Método</label>
                        <select id="cf-filtro-metodo"
                                class="px-3 py-2 border-2 border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                            <option value="">Todos</option>
                            <option value="efectivo">Efectivo</option>
                            <option value="transferencia">Transferencia</option>
                        </select>
                    </div>

                    <button onclick="buscarConRango()"
                            class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg text-sm transition-all">
                        <i data-lucide="search" class="w-4 h-4 inline-block mr-1"></i>Buscar
                    </button>
                    <button onclick="limpiarFiltros()"
                            class="px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white font-bold rounded-lg text-sm transition-all">
                        <i data-lucide="x" class="w-4 h-4 inline-block mr-1"></i>Limpiar
                    </button>
                </div>
            </div>

            <!-- RESUMEN DEL PERÍODO -->
            <div id="resumen-periodo" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
                    <p class="text-xs text-emerald-700 font-bold uppercase mb-1">Ingresos Efectivo</p>
                    <p class="text-xl font-black text-emerald-700" id="res-ing-efectivo">$0.00</p>
                </div>
                <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
                    <p class="text-xs text-blue-700 font-bold uppercase mb-1">Ingresos Transferencia</p>
                    <p class="text-xl font-black text-blue-700" id="res-ing-transferencia">$0.00</p>
                </div>
                <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
                    <p class="text-xs text-red-700 font-bold uppercase mb-1">Egresos Totales</p>
                    <p class="text-xl font-black text-red-700" id="res-egresos">$0.00</p>
                </div>
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
                    <p class="text-xs text-amber-700 font-bold uppercase mb-1">Balance del Período</p>
                    <p class="text-xl font-black" id="res-balance">$0.00</p>
                </div>
            </div>

            <!-- PERÍODO MOSTRADO -->
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-black text-gray-700 uppercase tracking-wide flex items-center gap-2">
                    <i data-lucide="calendar" class="w-4 h-4 text-amber-600"></i>
                    Período: <span id="label-periodo" class="text-amber-700 ml-1">Este Mes</span>
                </h3>
                <span class="text-xs text-gray-500 bg-gray-100 px-3 py-1 rounded-full font-semibold" id="cantidad-movimientos-label">0 movimientos</span>
            </div>

            <!-- LISTA DE MOVIMIENTOS AGRUPADOS POR DÍA -->
            <div id="lista-movimientos-cf">
                <div class="text-center py-12 text-gray-400">
                    <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                    <p class="font-semibold">Cargando movimientos...</p>
                </div>
            </div>
        </div>

        <!-- TAB CONSOLIDADOS -->
        <div id="content-consolidados" class="tab-cf-content hidden p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-black text-gray-800 uppercase tracking-wide">Consolidados Mensuales</h3>
                <button onclick="abrirModalConsolidar()" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-xl text-sm">
                    <i data-lucide="archive" class="w-4 h-4 inline-block mr-1"></i> Consolidar Mes
                </button>
            </div>
            <div id="lista-consolidados">
                <div class="text-center py-12 text-gray-400">
                    <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                    <p>Cargando consolidados...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODALES ==================== -->
<!-- MODAL INGRESO MANUAL -->
<div id="modal-ingreso" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md border-2 border-emerald-400">
        <h3 class="text-lg font-black text-gray-800 mb-4 flex items-center gap-2">
            <i data-lucide="plus-circle" class="w-5 h-5 text-emerald-600"></i> Registrar Ingreso Manual
        </h3>
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Método de Pago *</label>
                <div class="flex gap-2">
                    <button onclick="selectMetodo('ingreso', 'efectivo')" id="ingreso-efectivo-btn"
                            class="flex-1 py-3 border-2 border-emerald-600 bg-emerald-50 text-emerald-700 font-bold rounded-xl text-sm">
                        <i data-lucide="banknote" class="w-4 h-4 inline mr-1"></i> Efectivo
                    </button>
                    <button onclick="selectMetodo('ingreso', 'transferencia')" id="ingreso-transferencia-btn"
                            class="flex-1 py-3 border-2 border-gray-300 text-gray-500 font-bold rounded-xl text-sm hover:border-blue-500 hover:bg-blue-50">
                        <i data-lucide="credit-card" class="w-4 h-4 inline mr-1"></i> Transferencia
                    </button>
                </div>
                <input type="hidden" id="ingreso-metodo" value="efectivo">
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Monto *</label>
                <input type="number" id="ingreso-monto" placeholder="0.00" step="0.01" min="0.01"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-xl font-black text-center">
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Descripción *</label>
                <input type="text" id="ingreso-descripcion" placeholder="Ej: Préstamo bancario, Capital inicial..."
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500">
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Categoría</label>
                <select id="ingreso-categoria" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500">
                    <option value="capital">Capital / Inversión</option>
                    <option value="prestamo">Préstamo</option>
                    <option value="ajuste">Ajuste de Balance</option>
                    <option value="otros">Otros</option>
                </select>
            </div>
        </div>
        <div id="ingreso-error" class="hidden mt-2 text-red-600 text-sm font-semibold"></div>
        <div class="flex gap-3 mt-6">
            <button onclick="cerrarModal('modal-ingreso')" class="flex-1 py-3 border-2 border-gray-300 text-gray-600 font-bold rounded-xl hover:bg-gray-50">Cancelar</button>
            <button onclick="registrarIngreso()" class="flex-1 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-xl">Registrar Ingreso</button>
        </div>
    </div>
</div>

<!-- MODAL EGRESO MANUAL -->
<div id="modal-egreso" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md border-2 border-red-400">
        <h3 class="text-lg font-black text-gray-800 mb-4 flex items-center gap-2">
            <i data-lucide="minus-circle" class="w-5 h-5 text-red-600"></i> Registrar Egreso
        </h3>
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Método de Pago *</label>
                <div class="flex gap-2">
                    <button onclick="selectMetodo('egreso', 'efectivo')" id="egreso-efectivo-btn"
                            class="flex-1 py-3 border-2 border-red-600 bg-red-50 text-red-700 font-bold rounded-xl text-sm">
                        <i data-lucide="banknote" class="w-4 h-4 inline mr-1"></i> Efectivo
                    </button>
                    <button onclick="selectMetodo('egreso', 'transferencia')" id="egreso-transferencia-btn"
                            class="flex-1 py-3 border-2 border-gray-300 text-gray-500 font-bold rounded-xl text-sm hover:border-blue-500 hover:bg-blue-50">
                        <i data-lucide="credit-card" class="w-4 h-4 inline mr-1"></i> Transferencia
                    </button>
                </div>
                <input type="hidden" id="egreso-metodo" value="efectivo">
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Monto *</label>
                <input type="number" id="egreso-monto" placeholder="0.00" step="0.01" min="0.01"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 text-xl font-black text-center">
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Categoría *</label>
                <select id="egreso-categoria" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500">
                    <option value="nomina">Nómina / Salarios</option>
                    <option value="pago_proveedores">Pago a Proveedores</option>
                    <option value="servicios_publicos">Servicios Públicos</option>
                    <option value="mantenimiento">Mantenimiento / Reparaciones</option>
                    <option value="arriendo">Arriendo / Alquiler</option>
                    <option value="impuestos">Impuestos / Obligaciones</option>
                    <option value="equipos">Compra de Equipos</option>
                    <option value="marketing">Marketing / Publicidad</option>
                    <option value="otros">Otros</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Descripción *</label>
                <input type="text" id="egreso-descripcion" placeholder="Ej: Pago nómina febrero, Factura electricidad..."
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500">
            </div>
        </div>
        <div id="egreso-error" class="hidden mt-2 text-red-600 text-sm font-semibold"></div>
        <div class="flex gap-3 mt-6">
            <button onclick="cerrarModal('modal-egreso')" class="flex-1 py-3 border-2 border-gray-300 text-gray-600 font-bold rounded-xl hover:bg-gray-50">Cancelar</button>
            <button onclick="registrarEgreso()" class="flex-1 py-3 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl">Registrar Egreso</button>
        </div>
    </div>
</div>

<!-- MODAL TRANSFERENCIA A CAJA DIARIA -->
<div id="modal-transferencia" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md border-2 border-blue-400">
        <h3 class="text-lg font-black text-gray-800 mb-4 flex items-center gap-2">
            <i data-lucide="arrow-left-right" class="w-5 h-5 text-blue-600"></i> Enviar Efectivo a Caja Diaria
        </h3>
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-3 mb-4 text-sm text-blue-700">
            <p>Disponible en efectivo: <strong id="disp-efectivo-transfer" class="text-blue-800 text-base">$0.00</strong></p>
        </div>
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Monto a Enviar (Efectivo) *</label>
                <input type="number" id="transfer-monto" placeholder="0.00" step="0.01" min="0.01"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 text-xl font-black text-center">
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Descripción (Opcional)</label>
                <input type="text" id="transfer-descripcion" placeholder="Ej: Capital de trabajo semana"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500">
            </div>
        </div>
        <div id="transfer-error" class="hidden mt-2 text-red-600 text-sm font-semibold"></div>
        <div class="flex gap-3 mt-6">
            <button onclick="cerrarModal('modal-transferencia')" class="flex-1 py-3 border-2 border-gray-300 text-gray-600 font-bold rounded-xl hover:bg-gray-50">Cancelar</button>
            <button onclick="realizarTransferencia()" class="flex-1 py-3 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-xl">Enviar a Caja Diaria</button>
        </div>
    </div>
</div>

<!-- MODAL CAMBIAR CONTRASEÑA -->
<div id="modal-password" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md border-2 border-gray-400">
        <h3 class="text-lg font-black text-gray-800 mb-4 flex items-center gap-2">
            <i data-lucide="key" class="w-5 h-5 text-gray-600"></i> Cambiar Contraseña
        </h3>
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Contraseña Actual</label>
                <input type="password" id="pwd-actual" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-gray-500">
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Nueva Contraseña</label>
                <input type="password" id="pwd-nueva" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-gray-500">
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Confirmar Nueva Contraseña</label>
                <input type="password" id="pwd-confirmar" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-gray-500">
            </div>
        </div>
        <div id="pwd-error" class="hidden mt-2 text-red-600 text-sm font-semibold"></div>
        <div class="flex gap-3 mt-6">
            <button onclick="cerrarModal('modal-password')" class="flex-1 py-3 border-2 border-gray-300 text-gray-600 font-bold rounded-xl hover:bg-gray-50">Cancelar</button>
            <button onclick="cambiarPassword()" class="flex-1 py-3 bg-gray-700 hover:bg-gray-800 text-white font-black rounded-xl">Cambiar Contraseña</button>
        </div>
    </div>
</div>

<!-- MODAL CONSOLIDAR MES -->
<div id="modal-consolidar" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md border-2 border-purple-400">
        <h3 class="text-lg font-black text-gray-800 mb-4 flex items-center gap-2">
            <i data-lucide="archive" class="w-5 h-5 text-purple-600"></i> Consolidar Mes
        </h3>
        <div class="bg-yellow-50 border border-yellow-300 rounded-xl p-3 mb-4 text-sm text-yellow-800">
            <p><strong>⚠️ Importante:</strong> El consolidado archiva el resumen mensual para histórico. Los movimientos originales se conservan.</p>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Mes</label>
                <select id="consolidar-mes" class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500">
                    <option value="1">Enero</option>
                    <option value="2">Febrero</option>
                    <option value="3">Marzo</option>
                    <option value="4">Abril</option>
                    <option value="5">Mayo</option>
                    <option value="6">Junio</option>
                    <option value="7">Julio</option>
                    <option value="8">Agosto</option>
                    <option value="9">Septiembre</option>
                    <option value="10">Octubre</option>
                    <option value="11">Noviembre</option>
                    <option value="12">Diciembre</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-black text-gray-600 mb-1 uppercase">Año</label>
                <input type="number" id="consolidar-anio" value="2025" min="2020" max="2099"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500">
            </div>
        </div>
        <div id="consolidar-error" class="hidden mt-2 text-red-600 text-sm font-semibold"></div>
        <div class="flex gap-3 mt-6">
            <button onclick="cerrarModal('modal-consolidar')" class="flex-1 py-3 border-2 border-gray-300 text-gray-600 font-bold rounded-xl hover:bg-gray-50">Cancelar</button>
            <button onclick="consolidarMes()" class="flex-1 py-3 bg-purple-600 hover:bg-purple-700 text-white font-black rounded-xl">Consolidar</button>
        </div>
    </div>
</div>

<!-- TOAST -->
<div id="toast-cf" class="fixed bottom-6 right-6 z-[100] hidden">
    <div id="toast-cf-inner" class="px-6 py-4 rounded-xl shadow-2xl text-white font-bold text-sm flex items-center gap-3 max-w-sm">
        <i id="toast-cf-icon" data-lucide="check-circle" class="w-5 h-5 flex-shrink-0"></i>
        <span id="toast-cf-msg"></span>
    </div>
</div>

@section Scripts {
    <script>
        // =========================================================
        // ESTADO GLOBAL
        // =========================================================
        let vistaActual = 'mensual';
        let balanceEfectivoActual = 0;
        let autenticado = false;

        // =========================================================
        // INICIALIZACIÓN
        // =========================================================
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            // Inicializar fechas de filtro con el mes actual
            const hoy = new Date();
            const primerDia = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
            document.getElementById('cf-fecha-desde').value = primerDia.toISOString().split('T')[0];
            document.getElementById('cf-fecha-hasta').value = hoy.toISOString().split('T')[0];

            // Inicializar selector de mes en consolidar
            document.getElementById('consolidar-mes').value = hoy.getMonth() + 1;
            document.getElementById('consolidar-anio').value = hoy.getFullYear();
        });

        // =========================================================
        // AUTENTICACIÓN
        // =========================================================
        async function verificarAuth() {
            const password = document.getElementById('auth-password').value;
            const errorEl = document.getElementById('auth-error');

            if (!password) { errorEl.textContent = 'Ingrese la contraseña'; errorEl.classList.remove('hidden'); return; }

            try {
                const res = await fetch('/api/cajafuerte/verificar-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password })
                });
                const data = await res.json();

                if (data.success) {
                    autenticado = true;
                    document.getElementById('modal-auth').classList.add('hidden');
                    document.getElementById('contenido-principal').classList.remove('hidden');
                    lucide.createIcons();
                    cargarDashboard();
                    cargarMovimientos();
                } else {
                    errorEl.textContent = 'Contraseña incorrecta. Intente de nuevo.';
                    errorEl.classList.remove('hidden');
                    document.getElementById('auth-password').value = '';
                    document.getElementById('auth-password').focus();
                }
            } catch (e) {
                errorEl.textContent = 'Error de conexión. Intente de nuevo.';
                errorEl.classList.remove('hidden');
            }
        }

        // =========================================================
        // DASHBOARD
        // =========================================================
        async function cargarDashboard() {
            try {
                const res = await fetch('/api/cajafuerte/dashboard');
                const data = await res.json();
                if (!data.success) return;

                balanceEfectivoActual = data.balances.efectivo;

                document.getElementById('balance-efectivo').textContent = fmt(data.balances.efectivo);
                document.getElementById('balance-transferencias').textContent = fmt(data.balances.transferencias);
                document.getElementById('balance-total').textContent = fmt(data.balances.total);
                document.getElementById('ultima-actualizacion').textContent = fmtFecha(data.balances.ultimaActualizacion);

                document.getElementById('ing-ef-hoy').textContent = fmt(data.hoy.efectivo.ingresos);
                document.getElementById('egr-ef-hoy').textContent = fmt(data.hoy.efectivo.egresos);
                document.getElementById('ing-tr-hoy').textContent = fmt(data.hoy.transferencias.ingresos);
                document.getElementById('egr-tr-hoy').textContent = fmt(data.hoy.transferencias.egresos);
                document.getElementById('ing-mes').textContent = fmt(data.mes.totalIngresos);
                document.getElementById('egr-mes').textContent = fmt(data.mes.totalEgresos);

                // Actualizar disponible en modal transferencia
                document.getElementById('disp-efectivo-transfer').textContent = fmt(data.balances.efectivo);

                lucide.createIcons();
            } catch (e) {
                console.error('Error cargando dashboard CF:', e);
            }
        }

        // =========================================================
        // MOVIMIENTOS
        // =========================================================
        async function cargarMovimientos(vistaParm = null, desdeParm = null, hastaParm = null) {
            const vista = vistaParm || vistaActual;
            const tipo = document.getElementById('cf-filtro-tipo').value;
            const metodo = document.getElementById('cf-filtro-metodo').value;

            let url = `/api/cajafuerte/movimientos?vista=${vista}`;

            if (desdeParm && hastaParm) {
                url = `/api/cajafuerte/movimientos?desde=${desdeParm}&hasta=${hastaParm}`;
            }
            if (tipo) url += `&tipo=${tipo}`;
            if (metodo) url += `&metodoPago=${metodo}`;

            const container = document.getElementById('lista-movimientos-cf');
            container.innerHTML = '<div class="text-center py-12 text-gray-400"><div class="animate-spin w-8 h-8 border-4 border-amber-500 border-t-transparent rounded-full mx-auto mb-3"></div><p class="font-semibold">Cargando...</p></div>';

            try {
                const res = await fetch(url);
                const data = await res.json();
                if (!data.success) { container.innerHTML = '<p class="text-center text-red-500 py-8">Error al cargar movimientos</p>'; return; }

                // Actualizar resumen
                document.getElementById('res-ing-efectivo').textContent = fmt(data.totales.ingresosEfectivo);
                document.getElementById('res-ing-transferencia').textContent = fmt(data.totales.ingresosTransferencia);
                document.getElementById('res-egresos').textContent = fmt(data.totales.totalEgresos);
                const balEl = document.getElementById('res-balance');
                balEl.textContent = fmt(data.totales.balance);
                balEl.className = `text-xl font-black ${data.totales.balance >= 0 ? 'text-emerald-700' : 'text-red-600'}`;

                // Período
                document.getElementById('cantidad-movimientos-label').textContent = `${data.totales.cantidad} movimientos`;

                const labVista = { diario: 'Hoy', semanal: 'Esta Semana', mensual: 'Este Mes', rango: 'Rango Personalizado' };
                document.getElementById('label-periodo').textContent = desdeParm
                    ? `${fmtFechaCorta(data.periodo.desde)} — ${fmtFechaCorta(data.periodo.hasta)}`
                    : (labVista[vista] || 'Período');

                // Renderizar movimientos agrupados por día
                if (!data.movimientosPorDia || data.movimientosPorDia.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-16 text-gray-400">
                            <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-3 opacity-40"></i>
                            <p class="font-bold text-lg">Sin movimientos en este período</p>
                            <p class="text-sm mt-1">Los movimientos de cierres de caja y manuales aparecerán aquí</p>
                        </div>`;
                    lucide.createIcons();
                    return;
                }

                let html = '';
                for (const dia of data.movimientosPorDia) {
                    const fecha = new Date(dia.fecha + 'T00:00:00');
                    const fechaStr = fecha.toLocaleDateString('es-CO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
                    const balColor = dia.balance >= 0 ? 'text-emerald-700 bg-emerald-50' : 'text-red-600 bg-red-50';

                    html += `
                    <div class="mb-4 border border-gray-200 rounded-xl overflow-hidden shadow-sm">
                        <!-- Cabecera del día -->
                        <div class="bg-gray-50 px-4 py-3 flex items-center justify-between border-b border-gray-200 cursor-pointer hover:bg-gray-100 transition-all"
                             onclick="toggleDia(this)">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center">
                                    <i data-lucide="calendar" class="w-4 h-4 text-amber-700"></i>
                                </div>
                                <div>
                                    <p class="font-black text-gray-800 text-sm capitalize">${fechaStr}</p>
                                    <p class="text-xs text-gray-500">${dia.cantidad} movimiento${dia.cantidad !== 1 ? 's' : ''}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-4 text-xs font-bold">
                                <span class="text-emerald-600">↑ ${fmt(dia.totalIngresos)}</span>
                                <span class="text-red-600">↓ ${fmt(dia.totalEgresos)}</span>
                                <span class="px-2 py-1 rounded-lg ${balColor} font-black">${dia.balance >= 0 ? '+' : ''}${fmt(dia.balance)}</span>
                                <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400 toggle-icon transition-transform"></i>
                            </div>
                        </div>

                        <!-- Movimientos del día -->
                        <div class="dia-movimientos">
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50/50">
                                    <tr class="text-xs text-gray-500 font-bold uppercase border-b border-gray-100">
                                        <th class="px-4 py-2 text-left">Tipo</th>
                                        <th class="px-4 py-2 text-left">Origen</th>
                                        <th class="px-4 py-2 text-left">Método</th>
                                        <th class="px-4 py-2 text-left">Descripción</th>
                                        <th class="px-4 py-2 text-left">Categoría</th>
                                        <th class="px-4 py-2 text-right">Monto</th>
                                        <th class="px-4 py-2 text-center">Hora</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-50">`;

                    for (const m of dia.movimientos) {
                        const esIngreso = m.tipo === 'ingreso';
                        const tipoClass = esIngreso ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700';
                        const metodoClass = m.metodoPago === 'efectivo' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700';
                        const metodoIcon = m.metodoPago === 'efectivo' ? 'banknote' : 'credit-card';
                        const montoClass = esIngreso ? 'text-emerald-700 font-black' : 'text-red-600 font-black';
                        const hora = new Date(m.fecha).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });

                        html += `
                                    <tr class="hover:bg-gray-50/70 transition-all">
                                        <td class="px-4 py-3">
                                            <span class="px-2 py-1 rounded-lg text-xs font-bold ${tipoClass}">
                                                ${esIngreso ? '↑ INGRESO' : '↓ EGRESO'}
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-gray-600 text-xs font-semibold">
                                            ${getOrigenBadge(m.origen, m.origenLabel)}
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="px-2 py-1 rounded-lg text-xs font-bold ${metodoClass} flex items-center gap-1 w-fit">
                                                <i data-lucide="${metodoIcon}" class="w-3 h-3"></i>
                                                ${m.metodoPago === 'efectivo' ? 'Efectivo' : 'Transferencia'}
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-gray-700 text-xs max-w-[200px] truncate" title="${m.descripcion || ''}">
                                            ${m.descripcion || '—'}
                                        </td>
                                        <td class="px-4 py-3 text-gray-500 text-xs">
                                            ${m.categoria ? `<span class="bg-gray-100 px-2 py-0.5 rounded-lg">${formatCategoria(m.categoria)}</span>` : '—'}
                                        </td>
                                        <td class="px-4 py-3 text-right ${montoClass} text-sm">
                                            ${esIngreso ? '+' : '-'}${fmt(m.monto)}
                                        </td>
                                        <td class="px-4 py-3 text-center text-xs text-gray-400 font-mono">${hora}</td>
                                    </tr>`;
                    }

                    html += `
                                </tbody>
                                <tfoot>
                                    <tr class="bg-gray-50 border-t-2 border-gray-200">
                                        <td colspan="5" class="px-4 py-2 text-xs font-black text-gray-600 uppercase">Totales del día</td>
                                        <td class="px-4 py-2 text-right">
                                            <span class="text-xs text-emerald-600 font-bold block">+${fmt(dia.totalIngresos)}</span>
                                            <span class="text-xs text-red-600 font-bold block">-${fmt(dia.totalEgresos)}</span>
                                        </td>
                                        <td class="px-4 py-2 text-center text-xs font-black ${dia.balance >= 0 ? 'text-emerald-700' : 'text-red-600'}">
                                            ${dia.balance >= 0 ? '+' : ''}${fmt(dia.balance)}
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>`;
                }

                container.innerHTML = html;
                lucide.createIcons();
            } catch (e) {
                console.error('Error cargando movimientos CF:', e);
                container.innerHTML = '<p class="text-center text-red-500 py-8 font-semibold">Error al cargar movimientos</p>';
            }
        }

        function getOrigenBadge(origen, label) {
            const clases = {
                'cierre_caja': 'bg-amber-100 text-amber-700',
                'retiro_manual': 'bg-gray-100 text-gray-700',
                'transferencia_a_caja': 'bg-blue-100 text-blue-700',
                'transferencia_desde_caja': 'bg-purple-100 text-purple-700',
                'ingreso_manual': 'bg-teal-100 text-teal-700'
            };
            const cls = clases[origen] || 'bg-gray-100 text-gray-600';
            return `<span class="px-2 py-0.5 rounded-lg text-xs font-bold ${cls}">${label || origen}</span>`;
        }

        function formatCategoria(cat) {
            const map = {
                'nomina': 'Nómina', 'pago_proveedores': 'Proveedores', 'servicios_publicos': 'Servicios',
                'mantenimiento': 'Mantenimiento', 'arriendo': 'Arriendo', 'impuestos': 'Impuestos',
                'equipos': 'Equipos', 'marketing': 'Marketing', 'capital': 'Capital',
                'prestamo': 'Préstamo', 'ajuste': 'Ajuste', 'otros': 'Otros',
                'cierre_caja': 'Cierre Caja', 'transferencia_cajafuerte': 'Desde CF'
            };
            return map[cat] || cat;
        }

        function toggleDia(header) {
            const content = header.nextElementSibling;
            const icon = header.querySelector('.toggle-icon');
            content.classList.toggle('hidden');
            icon.style.transform = content.classList.contains('hidden') ? 'rotate(-90deg)' : '';
        }

        // =========================================================
        // FILTROS Y VISTAS
        // =========================================================
        function setVista(vista) {
            vistaActual = vista;
            document.querySelectorAll('.vista-btn').forEach(b => {
                b.classList.remove('border-amber-600', 'bg-amber-50', 'text-amber-700');
                b.classList.add('border-gray-300', 'text-gray-600');
            });
            const btn = document.getElementById(`btn-vista-${vista}`);
            if (btn) {
                btn.classList.add('border-amber-600', 'bg-amber-50', 'text-amber-700');
                btn.classList.remove('border-gray-300', 'text-gray-600');
            }
            cargarMovimientos(vista);
        }

        function buscarConRango() {
            const desde = document.getElementById('cf-fecha-desde').value;
            const hasta = document.getElementById('cf-fecha-hasta').value;

            if (!desde || !hasta) {
                showToast('Seleccione fechas de inicio y fin', 'error');
                return;
            }
            if (desde > hasta) {
                showToast('La fecha inicio no puede ser mayor a la fecha fin', 'error');
                return;
            }

            // Limpiar selección de vistas rápidas
            document.querySelectorAll('.vista-btn').forEach(b => {
                b.classList.remove('border-amber-600', 'bg-amber-50', 'text-amber-700');
                b.classList.add('border-gray-300', 'text-gray-600');
            });

            vistaActual = 'rango';
            cargarMovimientos(null, desde, hasta);
        }

        function limpiarFiltros() {
            document.getElementById('cf-filtro-tipo').value = '';
            document.getElementById('cf-filtro-metodo').value = '';
            setVista('mensual');
        }

        // =========================================================
        // TABS
        // =========================================================
        function cambiarTab(tab) {
            document.querySelectorAll('.tab-cf-content').forEach(c => c.classList.add('hidden'));
            document.querySelectorAll('.tab-cf-btn').forEach(b => {
                b.classList.remove('border-amber-600', 'bg-amber-50', 'text-amber-700');
                b.classList.add('text-gray-500', 'border-transparent');
            });

            document.getElementById(`content-${tab}`)?.classList.remove('hidden');
            const btn = document.getElementById(`tab-${tab}`);
            if (btn) {
                btn.classList.add('border-amber-600', 'bg-amber-50', 'text-amber-700');
                btn.classList.remove('text-gray-500', 'border-transparent');
            }

            if (tab === 'consolidados') cargarConsolidados();
        }

        // =========================================================
        // CONSOLIDADOS
        // =========================================================
        async function cargarConsolidados() {
            const container = document.getElementById('lista-consolidados');
            container.innerHTML = '<div class="text-center py-12 text-gray-400"><div class="animate-spin w-8 h-8 border-4 border-purple-500 border-t-transparent rounded-full mx-auto mb-3"></div><p>Cargando...</p></div>';

            try {
                const res = await fetch('/api/cajafuerte/consolidados');
                const data = await res.json();

                if (!data.consolidados || data.consolidados.length === 0) {
                    container.innerHTML = '<p class="text-center text-gray-500 py-8">No hay consolidados mensuales aún.</p>';
                    return;
                }

                let html = '<div class="space-y-4">';
                for (const c of data.consolidados) {
                    html += `
                    <div class="border border-purple-200 rounded-xl overflow-hidden">
                        <div class="bg-purple-50 px-4 py-3 flex items-center justify-between border-b border-purple-200">
                            <div>
                                <p class="font-black text-gray-800">${c.periodo}</p>
                                <p class="text-xs text-gray-500">Consolidado el ${fmtFecha(c.fechaConsolidacion)}</p>
                            </div>
                            <div class="text-right">
                                <p class="text-lg font-black ${c.totales.balance >= 0 ? 'text-emerald-700' : 'text-red-600'}">${fmt(c.totales.balance)}</p>
                                <p class="text-xs text-gray-500">Balance neto</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-3 divide-x divide-gray-200 text-center text-sm">
                            <div class="p-3">
                                <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Efectivo</p>
                                <p class="text-emerald-600 font-bold text-xs">↑ ${fmt(c.efectivo.ingresos)}</p>
                                <p class="text-red-600 font-bold text-xs">↓ ${fmt(c.efectivo.egresos)}</p>
                                <p class="font-black text-sm mt-1 ${c.efectivo.balance >= 0 ? 'text-emerald-700' : 'text-red-600'}">${fmt(c.efectivo.balance)}</p>
                            </div>
                            <div class="p-3">
                                <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Transferencias</p>
                                <p class="text-emerald-600 font-bold text-xs">↑ ${fmt(c.transferencias.ingresos)}</p>
                                <p class="text-red-600 font-bold text-xs">↓ ${fmt(c.transferencias.egresos)}</p>
                                <p class="font-black text-sm mt-1 ${c.transferencias.balance >= 0 ? 'text-emerald-700' : 'text-red-600'}">${fmt(c.transferencias.balance)}</p>
                            </div>
                            <div class="p-3">
                                <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Total</p>
                                <p class="text-emerald-600 font-bold text-xs">↑ ${fmt(c.totales.ingresos)}</p>
                                <p class="text-red-600 font-bold text-xs">↓ ${fmt(c.totales.egresos)}</p>
                                <p class="font-black text-sm mt-1 ${c.totales.balance >= 0 ? 'text-emerald-700' : 'text-red-600'}">${fmt(c.totales.balance)}</p>
                            </div>
                        </div>
                    </div>`;
                }
                html += '</div>';
                container.innerHTML = html;
                lucide.createIcons();
            } catch (e) {
                container.innerHTML = '<p class="text-center text-red-500 py-8">Error al cargar consolidados</p>';
            }
        }

        // =========================================================
        // ACCIONES CRUD
        // =========================================================
        function selectMetodo(form, metodo) {
            document.getElementById(`${form}-metodo`).value = metodo;
            const ef = document.getElementById(`${form}-efectivo-btn`);
            const tr = document.getElementById(`${form}-transferencia-btn`);
            const colorActivo = form === 'ingreso' ? ['border-emerald-600', 'bg-emerald-50', 'text-emerald-700'] : ['border-red-600', 'bg-red-50', 'text-red-700'];
            const colorInactivo = ['border-gray-300', 'text-gray-500', 'bg-white'];

            [ef, tr].forEach(b => { b.className = b.className.replace(colorActivo[0], '').replace(colorActivo[1], '').replace(colorActivo[2], ''); });
            ef.classList.remove(...colorInactivo, colorActivo[0], colorActivo[1], colorActivo[2]);
            tr.classList.remove(...colorInactivo, colorActivo[0], colorActivo[1], colorActivo[2]);

            if (metodo === 'efectivo') {
                ef.classList.add(...colorActivo, 'border-2', 'font-bold', 'rounded-xl', 'text-sm', 'flex-1', 'py-3');
                tr.classList.add(...colorInactivo, 'border-2', 'font-bold', 'rounded-xl', 'text-sm', 'flex-1', 'py-3', 'hover:border-blue-500', 'hover:bg-blue-50');
            } else {
                tr.classList.add('border-blue-600', 'bg-blue-50', 'text-blue-700', 'border-2', 'font-bold', 'rounded-xl', 'text-sm', 'flex-1', 'py-3');
                ef.classList.add(...colorInactivo, 'border-2', 'font-bold', 'rounded-xl', 'text-sm', 'flex-1', 'py-3');
            }
        }

        async function registrarIngreso() {
            const monto = parseFloat(document.getElementById('ingreso-monto').value);
            const descripcion = document.getElementById('ingreso-descripcion').value.trim();
            const metodo = document.getElementById('ingreso-metodo').value;
            const categoria = document.getElementById('ingreso-categoria').value;
            const errorEl = document.getElementById('ingreso-error');
            errorEl.classList.add('hidden');

            if (!monto || monto <= 0) { errorEl.textContent = 'El monto debe ser mayor a 0'; errorEl.classList.remove('hidden'); return; }
            if (!descripcion) { errorEl.textContent = 'Ingrese una descripción'; errorEl.classList.remove('hidden'); return; }

            try {
                const res = await fetch('/api/cajafuerte/registrar-ingreso', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ monto, descripcion, metodoPago: metodo, categoria })
                });
                const data = await res.json();

                if (data.success) {
                    cerrarModal('modal-ingreso');
                    showToast(`Ingreso de ${fmt(monto)} registrado correctamente`, 'success');
                    cargarDashboard();
                    cargarMovimientos();
                } else {
                    errorEl.textContent = data.message || 'Error al registrar';
                    errorEl.classList.remove('hidden');
                }
            } catch (e) {
                errorEl.textContent = 'Error de conexión';
                errorEl.classList.remove('hidden');
            }
        }


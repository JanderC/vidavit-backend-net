        function toggleDesgloseCons(btn, mes, anio) {
            const card = btn.closest('.border-2');
            const panel = card.querySelector('.desglose-consolidado');
            const icon = btn.querySelector('.toggle-cons-icon');
            const contenido = panel.querySelector('.desglose-contenido');
            const yaVisible = !panel.classList.contains('hidden');
            panel.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');
            if (!yaVisible && contenido.querySelector('.animate-spin')) cargarDesgloseCons(mes, anio, contenido);
        }

        async function cargarDesgloseCons(mes, anio, contenedorEl) {
            try {
                const res = await fetch(`/api/cajafuerte/consolidados/preview?mes=${mes}&anio=${anio}`);
                const data = await res.json();
                if (!data.success || !data.desglosePorOrigen?.length) {
                    contenedorEl.innerHTML = '<p class="text-xs text-gray-400 italic text-center py-4">Sin movimientos para mostrar.</p>'; return;
                }
                const ingresos = data.desglosePorOrigen.filter(x => x.tipo === 'ingreso');
                const egresos  = data.desglosePorOrigen.filter(x => x.tipo === 'egreso');
                let html = '<div class="grid md:grid-cols-2 gap-4">';
                html += buildDesgloseColumna(ingresos, true);
                html += buildDesgloseColumna(egresos, false);
                html += '</div><p class="text-xs text-gray-400 italic text-right mt-3">* Calculado en tiempo real desde movimientos actuales.</p>';
                contenedorEl.innerHTML = html;
                lucide.createIcons();
            } catch (e) { contenedorEl.innerHTML = '<p class="text-xs text-red-500 text-center py-4">Error al cargar desglose</p>'; }
        }

        function buildDesgloseColumna(items, esIngreso) {
            const color = esIngreso ? 'emerald' : 'red';
            const icon  = esIngreso ? 'trending-up' : 'trending-down';
            const label = esIngreso ? 'Origen de Ingresos' : 'Origen de Egresos';
            let html = `<div><p class="text-xs font-black text-${color}-700 uppercase mb-2 flex items-center gap-1"><i data-lucide="${icon}" class="w-3.5 h-3.5"></i> ${label}</p><div class="space-y-1">`;
            if (!items.length) { html += '<p class="text-xs text-gray-400 italic">Sin registros</p>'; }
            else {
                for (const x of items) {
                    const met = x.metodoPago === 'efectivo' ? '<span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded text-xs font-bold ml-1">EF</span>' : '<span class="bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded text-xs font-bold ml-1">TR</span>';
                    html += `<div class="flex items-center justify-between bg-${color}-50 border border-${color}-100 rounded-lg px-3 py-2">
                        <div class="flex items-center gap-1 text-xs text-gray-700">${getOrigenBadge(x.origen, x.origenLabel)}${met}<span class="text-gray-400 ml-1">(${x.cantidad})</span></div>
                        <span class="text-${color}-700 font-black text-xs">${esIngreso ? '+' : '-'}${fmt(x.total)}</span>
                    </div>`;
                }
                const total = items.reduce((s, x) => s + x.total, 0);
                html += `<div class="flex justify-between border-t border-${color}-200 pt-1 mt-1 px-1"><span class="text-xs font-black text-${color}-800">Total</span><span class="text-xs font-black text-${color}-800">${esIngreso ? '+' : '-'}${fmt(total)}</span></div>`;
            }
            html += '</div></div>';
            return html;
        }

        async function recalcularConsolidado(mes, anio, btnEl) {
            if (!confirm(`¿Recalcular el consolidado de ${mes}/${anio}?`)) return;
            btnEl.disabled = true;
            btnEl.innerHTML = '<div class="animate-spin w-3 h-3 border-2 border-purple-500 border-t-transparent rounded-full inline-block mr-1"></div> Recalculando...';
            try {
                const res = await fetch('/api/cajafuerte/recalcular-consolidado', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mes, anio }) });
                const data = await res.json();
                if (data.success) { showToast(data.message, 'success'); cargarConsolidados(); }
                else { showToast(data.message || 'Error al recalcular', 'error'); btnEl.disabled = false; btnEl.innerHTML = '<i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Recalcular'; lucide.createIcons(); }
            } catch (e) { showToast('Error de conexión', 'error'); btnEl.disabled = false; btnEl.innerHTML = '<i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Recalcular'; lucide.createIcons(); }
        }


        // ✅ Restaurar un movimiento eliminado
        async function restaurarMovimiento(movimientoOriginalId, tipo, origen, metodoPago, monto, descripcion, categoria) {
            if (!confirm(`¿Restaurar este movimiento?\n"${descripcion}" — ${fmt(monto)}\n\nEsto creará un nuevo movimiento con los mismos datos y ajustará el balance.`)) return;

            try {
                // Registrar el ingreso/egreso manualmente para restaurar el balance
                const esIngreso = tipo === 'ingreso';
                const endpoint = esIngreso ? '/api/cajafuerte/registrar-ingreso' : '/api/cajafuerte/registrar-egreso';

                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        monto,
                        descripcion: `[RESTAURADO] ${descripcion}`,
                        metodoPago,
                        categoria: categoria || (esIngreso ? 'ajuste' : 'otros')
                    })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Movimiento restaurado correctamente', 'success');
                    cargarBalances();
                    cargarMovimientos();
                    cargarAuditoria();
                } else {
                    showToast(data.message || 'Error al restaurar', 'error');
                }
            } catch (e) {
                showToast('Error de conexión al restaurar', 'error');
            }
        }


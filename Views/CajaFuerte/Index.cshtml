@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Caja Fuerte";
    ViewData["Subtitle"] = "Gestión Financiera Principal - ELITE GYM";
}

<style>
    .modal-overlay {
        background-color: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(5px);
    }
</style>

<!-- MODAL DE AUTENTICACIÓN (Primera vez que entran) -->
<div id="modalAutenticacion" class="fixed inset-0 z-50 flex items-center justify-center modal-overlay">
    <div class="bg-gradient-to-br from-gray-900 to-black rounded-3xl shadow-2xl max-w-md w-full mx-4 border-4 border-yellow-500 transform scale-95 animate-pulse">
        <div class="p-8">
            <div class="text-center mb-6">
                <div class="w-20 h-20 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-2xl">
                    <i data-lucide="vault" class="w-10 h-10 text-black"></i>
                </div>
                <h3 class="text-3xl font-black text-yellow-500 uppercase tracking-wide mb-2">Caja Fuerte</h3>
                <p class="text-gray-400 font-semibold">Ingrese la contraseña de acceso</p>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-300 mb-2">Contraseña</label>
                    <input type="password"
                           id="input-password-acceso"
                           class="w-full px-4 py-3 bg-gray-800 border-2 border-gray-700 rounded-xl text-white font-bold focus:border-yellow-500 focus:outline-none transition-all text-center tracking-widest text-xl"
                           placeholder="••••••"
                           maxlength="20">
                </div>

                <div id="error-password-acceso" class="hidden bg-red-500/20 border-2 border-red-500 rounded-xl p-3">
                    <p class="text-red-500 text-sm font-bold text-center">❌ Contraseña incorrecta</p>
                </div>

                <button onclick="verificarPasswordAcceso()"
                        class="w-full px-6 py-4 bg-gradient-to-r from-yellow-500 to-yellow-600 hover:from-yellow-600 hover:to-yellow-700 text-black font-black rounded-xl shadow-xl hover:shadow-2xl transform hover:scale-105 transition-all uppercase tracking-wide text-lg">
                    <i data-lucide="unlock" class="w-5 h-5 inline-block mr-2"></i>
                    Acceder
                </button>
            </div>

            <div class="mt-6 text-center">
                <p class="text-xs text-gray-500 font-semibold">Esta funcion esta en desarrollo y pruebas</p>
                <p class="text-xs text-gray-500">Desde aca se podra administrar todo sus ingresos y ver su totalidad del dinero</p>
                <p class="text-xs text-gray-500">584247551680</p>
            </div>
        </div>
    </div>
</div>

<!-- CONTENIDO PRINCIPAL (Oculto hasta autenticación exitosa) -->
<div id="contenidoPrincipal" class="hidden space-y-6">

    <!-- RESUMEN GENERAL DE CAJA FUERTE -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-2xl shadow-xl p-6 border-l-4 border-yellow-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-yellow-700 font-black uppercase tracking-wide mb-1">Efectivo Total</p>
                    <p class="text-3xl font-black text-yellow-600" id="balance-efectivo">$0.00</p>
                    <p class="text-xs text-yellow-600 font-semibold mt-1">Dinero físico</p>
                </div>
                <div class="w-12 h-12 bg-yellow-200 rounded-full flex items-center justify-center">
                    <i data-lucide="banknote" class="w-6 h-6 text-yellow-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl shadow-xl p-6 border-l-4 border-purple-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-purple-700 font-black uppercase tracking-wide mb-1">Transferencias</p>
                    <p class="text-3xl font-black text-purple-600" id="balance-transferencias">$0.00</p>
                    <p class="text-xs text-purple-600 font-semibold mt-1">Registro contable</p>
                </div>
                <div class="w-12 h-12 bg-purple-200 rounded-full flex items-center justify-center">
                    <i data-lucide="credit-card" class="w-6 h-6 text-purple-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-2xl shadow-xl p-6 border-l-4 border-emerald-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-emerald-700 font-black uppercase tracking-wide mb-1">Balance Total</p>
                    <p class="text-3xl font-black text-emerald-600" id="balance-total">$0.00</p>
                    <p class="text-xs text-emerald-600 font-semibold mt-1">Efectivo + Transferencias</p>
                </div>
                <div class="w-12 h-12 bg-emerald-200 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-6 h-6 text-emerald-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-2xl shadow-xl p-6 border-l-4 border-gray-600">
            <div class="flex items-center justify-between">
                <div class="flex-1">
                    <p class="text-sm text-gray-700 font-black uppercase tracking-wide mb-3">Acciones Rápidas</p>
                    <div class="space-y-2">
                        <button onclick="abrirModalCambiarPassword()"
                                class="w-full px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition-all">
                            <i data-lucide="key" class="w-3 h-3 inline-block mr-1"></i>
                            Cambiar Contraseña
                        </button>
                        <button onclick="abrirModalRegistrarEgreso()"
                                class="w-full px-3 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-lg transition-all">
                            <i data-lucide="arrow-down" class="w-3 h-3 inline-block mr-1"></i>
                            Registrar Egreso
                        </button>
                        <button onclick="abrirModalTransferirACaja()"
                                class="w-full px-3 py-2 bg-green-600 hover:bg-green-700 text-white text-xs font-bold rounded-lg transition-all">
                            <i data-lucide="arrow-right" class="w-3 h-3 inline-block mr-1"></i>
                            Transferir a Caja
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MOVIMIENTOS DEL MES ACTUAL -->
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
        <h3 class="text-lg font-black text-gray-800 mb-4 uppercase tracking-wide flex items-center gap-2">
            <i data-lucide="calendar" class="w-5 h-5 text-blue-600"></i>
            Movimientos del Mes Actual
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-4 border border-blue-200">
                <p class="text-xs text-blue-700 font-bold uppercase mb-1">Ingresos Totales</p>
                <p class="text-2xl font-black text-blue-600" id="ingresos-mes">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-xl p-4 border border-red-200">
                <p class="text-xs text-red-700 font-bold uppercase mb-1">Egresos Totales</p>
                <p class="text-2xl font-black text-red-600" id="egresos-mes">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-xl p-4 border border-emerald-200">
                <p class="text-xs text-emerald-700 font-bold uppercase mb-1">Balance del Mes</p>
                <p class="text-2xl font-black text-emerald-600" id="balance-mes">$0.00</p>
            </div>
        </div>
    </div>

    <!-- TABS DE NAVEGACIÓN -->
    <div class="bg-white rounded-2xl shadow-xl border-2 border-gray-200 overflow-hidden">
        <div class="border-b-2 border-gray-200 bg-gradient-to-r from-gray-50 to-gray-100">
            <div class="flex space-x-1 p-2">
                <button onclick="cambiarVista('diario')"
                        id="tab-diario"
                        class="tab-button flex-1 px-6 py-3 font-black uppercase text-sm tracking-wide rounded-lg transition-all bg-gradient-to-r from-blue-600 to-blue-700 text-white shadow-lg">
                    <i data-lucide="sun" class="w-4 h-4 inline-block mr-2"></i>
                    Diario
                </button>
                <button onclick="cambiarVista('semanal')"
                        id="tab-semanal"
                        class="tab-button flex-1 px-6 py-3 font-black uppercase text-sm tracking-wide rounded-lg transition-all text-gray-600 hover:bg-gray-200">
                    <i data-lucide="calendar-days" class="w-4 h-4 inline-block mr-2"></i>
                    Semanal
                </button>
                <button onclick="cambiarVista('mensual')"
                        id="tab-mensual"
                        class="tab-button flex-1 px-6 py-3 font-black uppercase text-sm tracking-wide rounded-lg transition-all text-gray-600 hover:bg-gray-200">
                    <i data-lucide="calendar" class="w-4 h-4 inline-block mr-2"></i>
                    Mensual
                </button>
                <button onclick="cambiarVista('historico')"
                        id="tab-historico"
                        class="tab-button flex-1 px-6 py-3 font-black uppercase text-sm tracking-wide rounded-lg transition-all text-gray-600 hover:bg-gray-200">
                    <i data-lucide="archive" class="w-4 h-4 inline-block mr-2"></i>
                    Histórico
                </button>
            </div>
        </div>

        <!-- CONTENIDO DE LAS VISTAS -->
        <div class="p-6">
            <!-- Vista Diario/Semanal/Mensual -->
            <div id="vista-movimientos">
                <div class="mb-4 flex items-center gap-4">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Fecha</label>
                        <input type="date"
                               id="filtro-fecha"
                               class="px-4 py-2 border-2 border-gray-300 rounded-lg focus:border-blue-500 focus:outline-none font-semibold">
                    </div>
                    <div class="flex-1"></div>
                    <div class="text-right">
                        <p class="text-xs text-gray-600 font-bold uppercase">Total Movimientos</p>
                        <p class="text-2xl font-black text-gray-900" id="total-movimientos-vista">0</p>
                    </div>
                </div>

                <div id="lista-movimientos" class="space-y-3">
                    <!-- Los movimientos se cargarán aquí dinámicamente -->
                </div>
            </div>

            <!-- Vista Histórico (Consolidados) -->
            <div id="vista-historico" class="hidden">
                <div class="mb-6">
                    <h4 class="text-xl font-black text-gray-800 uppercase tracking-wide mb-2">Consolidados Mensuales</h4>
                    <p class="text-sm text-gray-600 font-semibold">Resúmenes de meses anteriores (los movimientos detallados se eliminan después de consolidar)</p>
                </div>

                <div id="lista-consolidados" class="space-y-4">
                    <!-- Los consolidados se cargarán aquí dinámicamente -->
                </div>
            </div>
        </div>
    </div>
</div>
<!-- MODALES -->
<!-- Modal: Cambiar Contraseña -->
<div id="modalCambiarPassword" class="fixed inset-0 z-50 hidden flex items-center justify-center modal-overlay">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full mx-4 border-4 border-blue-500">
        <div class="p-8">
            <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-wide">Cambiar Contraseña</h3>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Contraseña Actual</label>
                    <input type="password"
                           id="password-actual"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none font-semibold"
                           placeholder="Ingrese contraseña actual">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Nueva Contraseña</label>
                    <input type="password"
                           id="password-nueva"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none font-semibold"
                           placeholder="Ingrese nueva contraseña">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Confirmar Nueva Contraseña</label>
                    <input type="password"
                           id="password-confirmar"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none font-semibold"
                           placeholder="Confirme la nueva contraseña">
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <button onclick="cerrarModalCambiarPassword()"
                        class="flex-1 px-6 py-3 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold rounded-xl transition-all">
                    Cancelar
                </button>
                <button onclick="confirmarCambiarPassword()"
                        class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-all">
                    Cambiar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Registrar Egreso -->
<div id="modalRegistrarEgreso" class="fixed inset-0 z-50 hidden flex items-center justify-center modal-overlay">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full mx-4 border-4 border-red-500">
        <div class="p-8">
            <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-wide">Registrar Egreso</h3>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Método de Pago</label>
                    <select id="egreso-metodo-pago"
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-red-500 focus:outline-none font-semibold">
                        <option value="efectivo">Efectivo</option>
                        <option value="transferencia">Transferencia</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Monto</label>
                    <input type="number"
                           id="egreso-monto"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-red-500 focus:outline-none font-semibold"
                           placeholder="0.00"
                           step="0.01"
                           min="0">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Categoría</label>
                    <select id="egreso-categoria"
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-red-500 focus:outline-none font-semibold">
                        <option value="pago_proveedores">Pago a Proveedores</option>
                        <option value="servicios_publicos">Servicios Públicos</option>
                        <option value="mantenimiento">Mantenimiento</option>
                        <option value="nomina">Nómina</option>
                        <option value="otros">Otros</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Descripción</label>
                    <textarea id="egreso-descripcion"
                              rows="3"
                              class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-red-500 focus:outline-none font-semibold"
                              placeholder="Descripción del egreso..."></textarea>
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <button onclick="cerrarModalRegistrarEgreso()"
                        class="flex-1 px-6 py-3 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold rounded-xl transition-all">
                    Cancelar
                </button>
                <button onclick="confirmarRegistrarEgreso()"
                        class="flex-1 px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition-all">
                    Registrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Transferir a Caja Diaria -->
<div id="modalTransferirACaja" class="fixed inset-0 z-50 hidden flex items-center justify-center modal-overlay">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full mx-4 border-4 border-green-500">
        <div class="p-8">
            <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-wide">Transferir a Caja Diaria</h3>

            <div class="bg-yellow-50 border-2 border-yellow-500 rounded-xl p-4 mb-4">
                <p class="text-sm font-bold text-yellow-800">
                    <i data-lucide="info" class="w-4 h-4 inline-block mr-1"></i>
                    Efectivo disponible: <span id="efectivo-disponible-transfer">$0.00</span>
                </p>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Monto a Transferir</label>
                    <input type="number"
                           id="transfer-monto"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-green-500 focus:outline-none font-semibold text-2xl text-center"
                           placeholder="0.00"
                           step="0.01"
                           min="0">
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <button onclick="cerrarModalTransferirACaja()"
                        class="flex-1 px-6 py-3 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold rounded-xl transition-all">
                    Cancelar
                </button>
                <button onclick="confirmarTransferirACaja()"
                        class="flex-1 px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-xl transition-all">
                    Transferir
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Detalle de Consolidado -->
<div id="modalDetalleConsolidado" class="fixed inset-0 z-50 hidden flex items-center justify-center modal-overlay">
    <div class="bg-white rounded-3xl shadow-2xl max-w-2xl w-full mx-4 border-4 border-purple-500">
        <div class="p-8">
            <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-wide" id="titulo-consolidado">Detalle del Consolidado</h3>

            <div id="contenido-consolidado" class="space-y-4">
                <!-- Contenido dinámico del consolidado -->
            </div>

            <div class="mt-6">
                <button onclick="cerrarModalDetalleConsolidado()"
                        class="w-full px-6 py-3 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold rounded-xl transition-all">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let vistaActual = 'diario';
        let passwordIngresada = '';

        // =============================================
        // AUTENTICACIÓN
        // =============================================

        async function verificarPasswordAcceso() {
            const password = document.getElementById('input-password-acceso').value;

            if (!password) {
                alert('Por favor ingrese la contraseña');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/cajafuerte/verificar-password`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password })
                });

                const data = await response.json();

                if (data.success) {
                    passwordIngresada = password;
                    document.getElementById('modalAutenticacion').classList.add('hidden');
                    document.getElementById('contenidoPrincipal').classList.remove('hidden');
                    cargarDashboard();
                    cargarMovimientos();
                } else {
                    document.getElementById('error-password-acceso').classList.remove('hidden');
                    document.getElementById('input-password-acceso').value = '';
                }
            } catch (error) {
                console.error('Error al verificar contraseña:', error);
                alert('❌ Error al verificar contraseña');
            }
        }

        // Permitir enter para autenticar
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('input-password-acceso').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    verificarPasswordAcceso();
                }
            });

            // Establecer fecha de hoy
            const hoy = new Date().toISOString().split('T')[0];
            document.getElementById('filtro-fecha').value = hoy;

            // Listener para cambio de fecha
            document.getElementById('filtro-fecha').addEventListener('change', function() {
                cargarMovimientos();
            });
        });

        // =============================================
        // DASHBOARD Y RESUMEN
        // =============================================

        async function cargarDashboard() {
            try {
                const response = await fetch(`${API_URL}/cajafuerte/dashboard`);
                const data = await response.json();

                if (data.success) {
                    // Actualizar balances
                    document.getElementById('balance-efectivo').textContent = `$${data.balances.efectivo.toLocaleString('es-CO', { minimumFractionDigits: 2 })}`;
                    document.getElementById('balance-transferencias').textContent = `$${data.balances.transferencias.toLocaleString('es-CO', { minimumFractionDigits: 2 })}`;
                    document.getElementById('balance-total').textContent = `$${data.balances.total.toLocaleString('es-CO', { minimumFractionDigits: 2 })}`;

                    // Actualizar movimientos del mes
                    document.getElementById('ingresos-mes').textContent = `$${data.movimientosMes.total.ingresos.toLocaleString('es-CO', { minimumFractionDigits: 2 })}`;
                    document.getElementById('egresos-mes').textContent = `$${data.movimientosMes.total.egresos.toLocaleString('es-CO', { minimumFractionDigits: 2 })}`;
                    document.getElementById('balance-mes').textContent = `$${data.movimientosMes.total.balance.toLocaleString('es-CO', { minimumFractionDigits: 2 })}`;

                    // Actualizar efectivo disponible para transferir
                    document.getElementById('efectivo-disponible-transfer').textContent = `$${data.balances.efectivo.toLocaleString('es-CO', { minimumFractionDigits: 2 })}`;
                }
            } catch (error) {
                console.error('Error al cargar dashboard:', error);
            }
        }

        // =============================================
        // MOVIMIENTOS
        // =============================================

        async function cargarMovimientos() {
            try {
                const fecha = document.getElementById('filtro-fecha').value;
                const response = await fetch(`${API_URL}/cajafuerte/movimientos?vista=${vistaActual}&fecha=${fecha}`);
                const data = await response.json();

                if (data.success) {
                    const container = document.getElementById('lista-movimientos');
                    document.getElementById('total-movimientos-vista').textContent = data.totales.cantidad;

                    if (data.movimientos && data.movimientos.length > 0) {
                        container.innerHTML = data.movimientos.map(mov => {
                            const esIngreso = mov.tipo === 'ingreso';
                            const colorClass = esIngreso ? 'border-green-500 bg-green-50' : 'border-red-500 bg-red-50';
                            const iconColor = esIngreso ? 'text-green-600' : 'text-red-600';
                            const icon = esIngreso ? 'arrow-down-circle' : 'arrow-up-circle';
                            const fecha = new Date(mov.fecha);

                            return `
                                <div class="border-l-4 ${colorClass} rounded-xl p-4 shadow hover:shadow-lg transition-all">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center">
                                                <i data-lucide="${icon}" class="w-5 h-5 ${iconColor}"></i>
                                            </div>
                                            <div>
                                                <p class="font-black text-gray-900">${mov.descripcion || 'Sin descripción'}</p>
                                                <p class="text-sm text-gray-600 font-semibold">
                                                    ${mov.origen.replace(/_/g, ' ').toUpperCase()} • ${mov.metodoPago.toUpperCase()}
                                                    ${mov.categoria ? ' • ' + mov.categoria.replace(/_/g, ' ').toUpperCase() : ''}
                                                </p>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <p class="text-2xl font-black ${iconColor}">
                                                ${esIngreso ? '+' : '-'}$${mov.monto.toLocaleString('es-CO', { minimumFractionDigits: 2 })}
                                            </p>
                                            <p class="text-xs text-gray-500 font-semibold">
                                                ${fecha.toLocaleDateString('es-ES')} ${fecha.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }).join('');
                        lucide.createIcons();
                    } else {
                        container.innerHTML = `
                            <div class="bg-gray-50 rounded-2xl p-12 text-center border-2 border-gray-200">
                                <i data-lucide="inbox" class="w-16 h-16 text-gray-400 mx-auto mb-4"></i>
                                <h3 class="text-xl font-black text-gray-600 mb-2">No hay movimientos</h3>
                                <p class="text-gray-500 font-semibold">No se encontraron movimientos para este período</p>
                            </div>
                        `;
                        lucide.createIcons();
                    }
                }
            } catch (error) {
                console.error('Error al cargar movimientos:', error);
            }
        }

        // =============================================
        // TABS Y VISTAS
        // =============================================

        function cambiarVista(vista) {
            vistaActual = vista;

            // Actualizar tabs
            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('bg-gradient-to-r', 'from-blue-600', 'to-blue-700', 'text-white', 'shadow-lg');
                btn.classList.add('text-gray-600', 'hover:bg-gray-200');
            });

            document.getElementById(`tab-${vista}`).classList.remove('text-gray-600', 'hover:bg-gray-200');
            document.getElementById(`tab-${vista}`).classList.add('bg-gradient-to-r', 'from-blue-600', 'to-blue-700', 'text-white', 'shadow-lg');

            // Mostrar/ocultar vistas
            if (vista === 'historico') {
                document.getElementById('vista-movimientos').classList.add('hidden');
                document.getElementById('vista-historico').classList.remove('hidden');
                cargarConsolidados();
            } else {
                document.getElementById('vista-movimientos').classList.remove('hidden');
                document.getElementById('vista-historico').classList.add('hidden');
                cargarMovimientos();
            }
        }

        // =============================================
        // CONSOLIDADOS HISTÓRICOS
        // =============================================


                                    <p class="text-xs text-gray-600 font-semibold">Efectivo + Transferencias</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-4xl font-black text-emerald-600">$${cons.totales.balance.toLocaleString('es-CO', { minimumFractionDigits: 2 })}</p>

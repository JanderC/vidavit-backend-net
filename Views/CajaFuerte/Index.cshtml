                            <div class="bg-gray-50 rounded-2xl p-12 text-center border-2 border-gray-200">
                                <i data-lucide="archive" class="w-16 h-16 text-gray-400 mx-auto mb-4"></i>
                                <h3 class="text-xl font-black text-gray-600 mb-2">No hay consolidados</h3>
                                <p class="text-gray-500 font-semibold">No se han consolidado meses anteriores aún</p>
                            </div>
                        `;

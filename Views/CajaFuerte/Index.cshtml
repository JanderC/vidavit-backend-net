        // =========================================================
        // ✅ MODAL DETALLE DEL DÍA
        // =========================================================
        async function abrirDetalleDia(fechaISO, fechaStr) {
            document.getElementById('modal-dia-titulo').textContent = fechaStr.charAt(0).toUpperCase() + fechaStr.slice(1);
            document.getElementById('modal-dia-subtitulo').textContent = 'Cargando movimientos...';

            // Resetear resumen
            ['res-dia-ing-ef','res-dia-ing-tr','res-dia-egr'].forEach(id => document.getElementById(id).textContent = '$0');
            document.getElementById('res-dia-balance').textContent = '$0';
            document.getElementById('modal-dia-contenido').innerHTML = `
                <div class="text-center py-10 text-gray-400">
                    <div class="animate-spin w-8 h-8 border-4 border-amber-500 border-t-transparent rounded-full mx-auto mb-3"></div>
                    <p class="font-semibold">Cargando...</p>
                </div>`;

            abrirModal('modal-detalle-dia');

            try {
                const res = await fetch(`/api/cajafuerte/movimientos?vista=diario&desde=${fechaISO}&hasta=${fechaISO}`);
                const data = await res.json();
                if (!data.success) throw new Error('error api');

                const movsRaw = data.movimientos || [];
                const movs = movsRaw.map(m => ({ ...m, tipo: (m.tipo ?? m.Tipo ?? "").toLowerCase(), metodoPago: (m.metodoPago ?? m.MetodoPago ?? "").toLowerCase(), monto: m.monto ?? m.Monto ?? 0, fecha: m.fecha ?? m.Fecha ?? "", origen: (m.origen ?? m.Origen ?? "").toLowerCase(), descripcion: m.descripcion ?? m.Descripcion ?? "", categoria: m.categoria ?? m.Categoria ?? null, id: m.id ?? m.Id ?? "", cierreCajaId: m.cierreCajaId ?? m.CierreCajaId ?? null, movimientoCajaId: m.movimientoCajaId ?? m.MovimientoCajaId ?? null, esCierreCaja: m.esCierreCaja ?? false, esTransferenciaCaja: m.esTransferenciaCaja ?? false }));

                // Calcular resumen
                const ingEf = movs.filter(m => m.tipo === 'ingreso' && m.metodoPago === 'efectivo').reduce((s, m) => s + m.monto, 0);
                const ingTr = movs.filter(m => m.tipo === 'ingreso' && m.metodoPago === 'transferencia').reduce((s, m) => s + m.monto, 0);
                const egr   = movs.filter(m => m.tipo === 'egreso').reduce((s, m) => s + m.monto, 0);
                const bal   = (ingEf + ingTr) - egr;

                document.getElementById('res-dia-ing-ef').textContent = fmt(ingEf);
                document.getElementById('res-dia-ing-tr').textContent = fmt(ingTr);
                document.getElementById('res-dia-egr').textContent = fmt(egr);
                const balEl = document.getElementById('res-dia-balance');
                balEl.textContent = fmt(bal);
                balEl.className = `text-lg font-black ${bal >= 0 ? 'text-emerald-700' : 'text-red-600'}`;
                document.getElementById('modal-dia-subtitulo').textContent = `${movs.length} movimiento${movs.length !== 1 ? 's' : ''} en este día`;

                if (movs.length === 0) {
                    document.getElementById('modal-dia-contenido').innerHTML = `
                        <div class="text-center py-10 text-gray-400">
                            <i data-lucide="inbox" class="w-10 h-10 mx-auto mb-2 opacity-40"></i>
                            <p class="font-semibold">Sin movimientos para este día</p>
                        </div>`;
                    lucide.createIcons();
                    return;
                }

                renderTablaMovimientosDia(movs);

            } catch (e) {
                document.getElementById('modal-dia-contenido').innerHTML = '<p class="text-center text-red-500 py-8 font-semibold">Error al cargar los movimientos del día</p>';
            }
        }


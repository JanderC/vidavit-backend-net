                            </div>
                        </div>
                    </div>`;
                }).join('');
                return `<div class="deuda-grupo">
                    <div class="deuda-grupo-head">
                        <div style="display:flex;align-items:center;gap:.75rem;">
                            <div style="width:44px;height:44px;border-radius:50%;background:rgba(59,130,246,.1);color:var(--pf-blueB);font-weight:900;font-size:.9rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">${iniciales}</div>
                            <div>
                                <h3 style="font-size:1rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;margin:0 0 .1rem 0;">${nombre}</h3>
                                <p style="font-size:.72rem;color:var(--pf-muted);font-weight:600;font-family:monospace;margin:0;">Cédula: ${cedula}</p>
                            </div>
                        </div>
                        <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
                            <div style="text-align:right;">
                                <p style="font-size:.68rem;color:var(--pf-muted);font-weight:800;text-transform:uppercase;margin:0 0 .2rem 0;">Saldo total</p>
                                <p style="font-size:1.35rem;font-weight:900;color:var(--pf-red);margin:0;">$${saldo.toFixed(2)}</p>
                                <p style="font-size:.68rem;color:var(--pf-muted);font-weight:600;margin:0;">${dc.length} deuda${dc.length!==1?'s':''} pendiente${dc.length!==1?'s':''}</p>
                            </div>
                            <a href="/Caja/Historial?clienteId=${cid}" style="padding:.55rem 1.1rem;background:linear-gradient(135deg,var(--pf-purple),#4C1D95);color:#fff;border-radius:.75rem;text-decoration:none;font-weight:800;font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;display:inline-flex;align-items:center;gap:.4rem;">
                                <i data-lucide="history" style="width:14px;height:14px;"></i>Historial
                            </a>
                        </div>
                    </div>
                    <div style="padding:1rem;display:flex;flex-direction:column;gap:.625rem;">${filas}</div>
                </div>`;
            }).join('');
            lucide.createIcons();
        }

        function abrirModalAbonar(deudaId){
            const deuda=deudasData.find(d=>(d.Id||d.id)===deudaId);if(!deuda)return;
            deudaSeleccionada=deuda;
            const nombre=deuda.clienteNombre||deuda.cliente?.nombre||'—',concepto=deuda.Concepto||deuda.concepto||'—',saldo=deuda.Saldo||deuda.saldo||0;
            document.getElementById('modal-cliente-nombre').textContent=nombre;
            document.getElementById('modal-concepto').textContent=concepto;
            document.getElementById('modal-saldo').textContent=`$${saldo.toFixed(2)}`;
            document.getElementById('input-monto-abono').value=saldo.toFixed(2);
            document.getElementById('modalAbonarDeuda').classList.remove('hidden');
            lucide.createIcons();
        }
        function cerrarModalAbonar(){document.getElementById('modalAbonarDeuda').classList.add('hidden');deudaSeleccionada=null;}
        async function confirmarAbono(){
            const monto=parseFloat(document.getElementById('input-monto-abono').value);
            const metodo=document.getElementById('input-metodo-abono').value;
            const saldoActual=deudaSeleccionada.Saldo||deudaSeleccionada.saldo||0;
            const deudaId=deudaSeleccionada.Id||deudaSeleccionada.id;
            const concepto=deudaSeleccionada.Concepto||deudaSeleccionada.concepto||'';
            if(isNaN(monto)||monto<=0){alert('❌ Monto inválido');return;}
            if(monto>saldoActual){alert('❌ El monto no puede ser mayor al saldo pendiente');return;}
            try {
                const r=await fetch(`${API_URL}/Deudas/abonar`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({deudaId,monto,metodoPago:metodo,notas:`Abono a deuda - ${concepto}`})});
                const res=await r.json();
                if(res.success){cerrarModalAbonar();await cargarDeudas();cargarResumen();}
                else alert(`❌ ${res.message}`);
            } catch(e){alert('❌ Error al registrar abono');}
        }
        async function pagarCompleto(deudaId){
            const deuda=deudasData.find(d=>(d.Id||d.id)===deudaId);if(!deuda)return;
            const saldo=deuda.Saldo||deuda.saldo||0;
            if(!confirm(`¿Pagar completamente $${saldo.toFixed(2)}?`))return;
            try {
                const r=await fetch(`${API_URL}/Deudas/abonar`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({deudaId:deuda.Id||deuda.id,monto:saldo,metodoPago:'efectivo',notas:'Pago completo de deuda'})});
                const res=await r.json();
                if(res.success){alert('✅ Deuda pagada completamente');cargarDeudas();cargarResumen();}
                else alert(`❌ Error: ${res.message}`);
            } catch(e){alert('❌ Error al pagar deuda');}
        }

        async function cargarDiasPendientes(){
            const cont=document.getElementById('lista-dias-pendientes');
            try {
                const r=await fetch(`${API_URL}/Caja/pendientes`),data=await r.json();
                if(data.success&&data.diasPendientes?.length>0){
                    cont.innerHTML=data.diasPendientes.map(dia=>{
                        const bc=(dia.balance||0)>=0?'var(--pf-green)':'var(--pf-red)';
                        return `<div class="dia-pend">
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:.75rem;">
                                <div>
                                    <h4 style="font-size:.95rem;font-weight:900;color:var(--pf-text);margin:0 0 .25rem 0;">${formatearFechaLargaUTC(dia.fecha)}</h4>
                                    <p style="font-size:.78rem;color:var(--pf-muted);font-weight:600;margin:0;">${dia.cantidadMovimientos} movimientos sin cerrar</p>
                                </div>
                                <button onclick="abrirModalCerrarDia('${dia.fecha}',${dia.cantidadMovimientos},${dia.balance})"
                                        style="padding:.6rem 1.25rem;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;border:none;border-radius:.75rem;font-weight:800;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:.4rem;">
                                    <i data-lucide="lock" style="width:14px;height:14px;"></i> Cerrar Día
                                </button>
                            </div>
                            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem;">
                                <div style="background:rgba(59,130,246,.07);border:1px solid rgba(59,130,246,.2);border-radius:.75rem;padding:.875rem;">
                                    <p style="font-size:.68rem;color:rgba(96,165,250,.7);font-weight:800;text-transform:uppercase;margin:0 0 .25rem 0;">Ingresos</p>
                                    <p style="font-weight:900;color:var(--pf-blueB);font-size:1rem;margin:0;">$${dia.totalIngresos.toFixed(2)}</p>
                                </div>
                                <div style="background:rgba(239,68,68,.07);border:1px solid rgba(239,68,68,.2);border-radius:.75rem;padding:.875rem;">
                                    <p style="font-size:.68rem;color:rgba(248,113,113,.7);font-weight:800;text-transform:uppercase;margin:0 0 .25rem 0;">Egresos</p>
                                    <p style="font-weight:900;color:var(--pf-red);font-size:1rem;margin:0;">$${dia.totalEgresos.toFixed(2)}</p>
                                </div>
                                <div style="background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.2);border-radius:.75rem;padding:.875rem;">
                                    <p style="font-size:.68rem;color:rgba(16,185,129,.7);font-weight:800;text-transform:uppercase;margin:0 0 .25rem 0;">Balance</p>
                                    <p style="font-weight:900;font-size:1rem;color:${bc};margin:0;">$${dia.balance.toFixed(2)}</p>
                                </div>
                            </div>
                        </div>`;
                    }).join('');
                } else {
                    cont.innerHTML=`<div style="text-align:center;padding:3rem;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.2);border-radius:1rem;">
                        <i data-lucide="check-circle" style="width:52px;height:52px;color:var(--pf-green);display:block;margin:0 auto 1rem;"></i>
                        <h3 style="font-size:1rem;font-weight:900;color:var(--pf-green);margin:0 0 .35rem 0;">¡Todo al día!</h3>
                        <p style="color:rgba(16,185,129,.7);font-weight:700;margin:0;">No hay días pendientes por cerrar</p>
                    </div>`;
                }
                lucide.createIcons();
            } catch(e){console.error('Error:',e);}
        }

        function abrirModalCerrarDia(fecha,cant,balance){
            fechaDiaCerrar=fecha;
            const fo=new Date(fecha);
            document.getElementById('modal-fecha-cerrar').textContent=fo.toLocaleDateString('es-ES',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
            document.getElementById('modal-cantidad-movimientos').textContent=cant;
            document.getElementById('modal-balance-dia').textContent=`$${balance.toFixed(2)}`;
            document.getElementById('modalCerrarDiaEspecifico').classList.remove('hidden');
            lucide.createIcons();
        }
        function cerrarModalDiaEspecifico(){document.getElementById('modalCerrarDiaEspecifico').classList.add('hidden');fechaDiaCerrar=null;}
        async function confirmarCierreDiaEspecifico(){
            try {
                const obs=document.getElementById('input-observaciones-cierre-dia').value;
                const soloFecha=fechaDiaCerrar.split('T')[0];
                const r=await fetch(`${API_URL}/Caja/cerrar`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({fecha:soloFecha,observaciones:obs})});
                const data=await r.json();
                if(data.success){alert(`✅ ${data.message}`);cerrarModalDiaEspecifico();cargarResumen();cargarDiasPendientes();}
                else alert(`❌ ${data.message}`);
            } catch(e){alert('❌ Error al cerrar el día');}
        }

        document.querySelectorAll('input[type="number"]').forEach(i=>i.addEventListener('wheel',e=>e.preventDefault(),{passive:false}));
        document.addEventListener('keydown',e=>{if(e.key==='Escape'){cerrarModalCerrarCaja();cerrarModalDiaEspecifico();cerrarModalAbonar();}});
        document.addEventListener('click',e=>{
            const mc=document.getElementById('modal-cerrar-caja');if(e.target===mc)cerrarModalCerrarCaja();
            const md=document.getElementById('modalCerrarDiaEspecifico');if(e.target===md)cerrarModalDiaEspecifico();
            const ma=document.getElementById('modalAbonarDeuda');if(e.target===ma)cerrarModalAbonar();
        });

        window.addEventListener('load',function(){
            const hoy=obtenerFechaLocalISO();
            document.getElementById('fecha-desde').value=hoy;
            document.getElementById('fecha-hasta').value=hoy;
            cargarResumen(); cargarMovimientos(); lucide.createIcons();
        });

        window.cambiarTab=cambiarTab;window.cargarMovimientos=cargarMovimientos;
        window.cargarResumenSemanal=cargarResumenSemanal;window.cargarHistorialCierres=cargarHistorialCierres;
        window.abrirModalCerrarCaja=abrirModalCerrarCaja;window.cerrarModalCerrarCaja=cerrarModalCerrarCaja;
        window.confirmarCierreCaja=confirmarCierreCaja;window.registrarIngreso=registrarIngreso;
        window.registrarEgreso=registrarEgreso;window.cargarDeudas=cargarDeudas;
        window.filtrarDeudas=filtrarDeudas;window.debounceBusquedaDeuda=debounceBusquedaDeuda;
        window.filtroEstadoDeuda=filtroEstadoDeuda;window.abrirModalAbonar=abrirModalAbonar;
        window.cerrarModalAbonar=cerrarModalAbonar;window.confirmarAbono=confirmarAbono;
        window.pagarCompleto=pagarCompleto;window.abrirModalCerrarDia=abrirModalCerrarDia;
        window.cerrarModalDiaEspecifico=cerrarModalDiaEspecifico;window.confirmarCierreDiaEspecifico=confirmarCierreDiaEspecifico;
    </script>
}

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Caja";
    ViewData["Subtitle"] = "Control financiero completo - TAURO GYM";
}

<div class="space-y-6">
    <!-- RESUMEN GENERAL DE CAJA -->
    <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
        <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-2xl shadow-xl p-6 border-l-4 border-emerald-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-emerald-700 font-black uppercase tracking-wide mb-1">Efectivo en Caja</p>
                    <p class="text-3xl font-black text-emerald-600" id="efectivo-caja">$0.00</p>
                    <p class="text-xs text-emerald-600 font-semibold mt-1">+ Saldo anterior incluido</p>
                </div>
                <div class="w-12 h-12 bg-emerald-200 rounded-full flex items-center justify-center">
                    <i data-lucide="wallet" class="w-6 h-6 text-emerald-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl shadow-xl p-6 border-l-4 border-purple-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-purple-700 font-black uppercase tracking-wide mb-1">Saldo Cierre Anterior</p>
                    <p class="text-3xl font-black text-purple-600" id="saldo-anterior">$0.00</p>
                    <p class="text-xs text-purple-600 font-semibold mt-1" id="fecha-saldo-anterior"></p>
                </div>
                <div class="w-12 h-12 bg-purple-200 rounded-full flex items-center justify-center">
                    <i data-lucide="history" class="w-6 h-6 text-purple-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl shadow-xl p-6 border-l-4 border-blue-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-blue-700 font-black uppercase tracking-wide mb-1">Ingresos Hoy</p>
                    <p class="text-3xl font-black text-blue-600" id="ingresos-hoy">$0.00</p>
                    <p class="text-xs text-blue-600 font-semibold mt-1" id="detalle-ingresos">Efectivo + Transferencia</p>
                </div>
                <div class="w-12 h-12 bg-blue-200 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-6 h-6 text-blue-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-2xl shadow-xl p-6 border-l-4 border-red-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-red-700 font-black uppercase tracking-wide mb-1">Egresos Hoy</p>
                    <p class="text-3xl font-black text-red-600" id="egresos-hoy">$0.00</p>
                    <p class="text-xs text-red-600 font-semibold mt-1" id="detalle-egresos">Efectivo + Transferencia</p>
                </div>
                <div class="w-12 h-12 bg-red-200 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-down" class="w-6 h-6 text-red-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-amber-50 to-amber-100 rounded-2xl shadow-xl p-6 border-l-4 border-amber-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-amber-700 font-black uppercase tracking-wide mb-1">Deudas Pendientes</p>
                    <p class="text-3xl font-black text-amber-600" id="deudas-pendientes">$0.00</p>
                    <p class="text-xs text-amber-600 font-semibold mt-1">Total por cobrar</p>
                </div>
                <div class="w-12 h-12 bg-amber-200 rounded-full flex items-center justify-center">
                    <i data-lucide="alert-circle" class="w-6 h-6 text-amber-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl shadow-xl p-6 border-l-4 border-slate-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-700 font-black uppercase tracking-wide mb-1">Balance Total</p>
                    <p class="text-3xl font-black text-slate-600" id="balance-total">$0.00</p>
                    <button onclick="abrirModalCerrarCaja()"
                            class="mt-2 px-3 py-1 bg-slate-600 hover:bg-slate-700 text-white text-xs font-bold rounded-lg transition-all">
                        <i data-lucide="lock" class="w-3 h-3 inline-block mr-1"></i>
                        CERRAR CAJA
                    </button>
                </div>
                <div class="w-12 h-12 bg-slate-200 rounded-full flex items-center justify-center">
                    <i data-lucide="calculator" class="w-6 h-6 text-slate-600"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS DE NAVEGACIÓN -->
    <div class="bg-white rounded-2xl shadow-xl border-2 border-gray-200 overflow-hidden">
        <div class="flex border-b-2 border-gray-200">
            <button onclick="cambiarTab('movimientos')" id="tab-movimientos"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all border-b-4 border-red-600 bg-red-50 text-red-600">
                <i data-lucide="list" class="w-5 h-5 inline-block mr-2"></i>
                Movimientos
            </button>
            <button onclick="cambiarTab('deudas')" id="tab-deudas"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-gray-50">
                <i data-lucide="file-text" class="w-5 h-5 inline-block mr-2"></i>
                Deudas Clientes
            </button>
            <button onclick="cambiarTab('semanal')" id="tab-semanal"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-gray-50">
                <i data-lucide="calendar" class="w-5 h-5 inline-block mr-2"></i>
                Resumen Semanal
            </button>
            <button onclick="cambiarTab('cierres')" id="tab-cierres"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-gray-50">
                <i data-lucide="archive" class="w-5 h-5 inline-block mr-2"></i>
                Historial Cierres
            </button>
            <button onclick="cambiarTab('registrar')" id="tab-registrar"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-gray-50">
                <i data-lucide="plus-circle" class="w-5 h-5 inline-block mr-2"></i>
                Registrar
            </button>
        </div>
    </div>

    <!-- TAB: MOVIMIENTOS -->
    <div id="content-movimientos" class="tab-content">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200 mb-4">
            <div class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Desde</label>
                    <input type="date" id="fecha-desde"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Hasta</label>
                    <input type="date" id="fecha-hasta"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Categoría</label>
                    <select id="filtro-categoria"
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                        <option value="">Todas</option>
                        <option value="membresia">Membresías</option>
                        <option value="renovacion">Renovaciones</option>
                        <option value="producto">Productos</option>
                        <option value="abono_deuda">Abonos Deuda</option>
                        <option value="otro">Otros</option>
                    </select>
                </div>
                <button onclick="cargarMovimientos()"
                        class="px-8 py-3 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                    <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                    Filtrar
                </button>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
            <div class="p-4 border-b-2 border-gray-200 bg-gray-50">
                <h3 class="text-xl font-black uppercase tracking-wide text-gray-900">Historial de Movimientos</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-100 border-b-2 border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Fecha</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Tipo</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Categoría</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Descripción</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Método</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-700 uppercase tracking-wider">Monto</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-movimientos" class="divide-y divide-gray-200">
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-gray-500 font-bold">
                                Cargando movimientos...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB: DEUDAS CLIENTES -->
    <div id="content-deudas" class="tab-content hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200 mb-4">
            <input type="text" id="buscar-deuda" placeholder="Buscar cliente..."
                   class="w-full px-5 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold"
                   onkeyup="filtrarDeudas()">
        </div>

        <div id="lista-deudas" class="space-y-4">
            <div class="text-center py-12 text-gray-500 font-bold">
                Cargando deudas...
            </div>
        </div>
    </div>

    <!-- TAB: RESUMEN SEMANAL -->
    <div id="content-semanal" class="tab-content hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200 mb-4">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-black text-gray-900 uppercase tracking-wide">Resumen Semanal (Lunes a Sábado)</h3>
                <button onclick="cargarResumenSemanal()"
                        class="px-6 py-2 bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-black rounded-xl transition-all shadow-xl">
                    <i data-lucide="refresh-cw" class="w-4 h-4 inline-block mr-2"></i>
                    Actualizar
                </button>
            </div>
            <p class="text-gray-600 font-semibold" id="periodo-semanal">Cargando...</p>
        </div>

        <!-- Totales Semanales -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl shadow-xl p-6 border-l-4 border-blue-600">
                <p class="text-sm text-blue-700 font-black uppercase tracking-wide mb-1">Total Ingresos</p>
                <p class="text-3xl font-black text-blue-600" id="total-ingresos-semana">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-2xl shadow-xl p-6 border-l-4 border-red-600">
                <p class="text-sm text-red-700 font-black uppercase tracking-wide mb-1">Total Egresos</p>
                <p class="text-3xl font-black text-red-600" id="total-egresos-semana">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-2xl shadow-xl p-6 border-l-4 border-emerald-600">
                <p class="text-sm text-emerald-700 font-black uppercase tracking-wide mb-1">Balance</p>
                <p class="text-3xl font-black text-emerald-600" id="balance-semana">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl shadow-xl p-6 border-l-4 border-purple-600">
                <p class="text-sm text-purple-700 font-black uppercase tracking-wide mb-1">Movimientos</p>
                <p class="text-3xl font-black text-purple-600" id="cantidad-movimientos-semana">0</p>
            </div>
        </div>

        <!-- Tabla por Día -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
            <div class="p-4 border-b-2 border-gray-200 bg-gray-50">
                <h3 class="text-xl font-black uppercase tracking-wide text-gray-900">Desglose por Día</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-100 border-b-2 border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Día</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-700 uppercase tracking-wider">Ingresos</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-700 uppercase tracking-wider">Egresos</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-700 uppercase tracking-wider">Balance</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-700 uppercase tracking-wider">Efectivo</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-700 uppercase tracking-wider">Transferencia</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-700 uppercase tracking-wider">Movimientos</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-resumen-semanal" class="divide-y divide-gray-200">
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-gray-500 font-bold">
                                Cargando resumen semanal...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB: HISTORIAL CIERRES -->
    <div id="content-cierres" class="tab-content hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200 mb-4">
            <div class="flex items-center justify-between">
                <h3 class="text-2xl font-black text-gray-900 uppercase tracking-wide">Historial de Cierres de Caja</h3>
                <button onclick="cargarHistorialCierres()"
                        class="px-6 py-2 bg-gradient-to-r from-purple-600 to-purple-800 hover:from-purple-700 hover:to-purple-900 text-white font-black rounded-xl transition-all shadow-xl">
                    <i data-lucide="refresh-cw" class="w-4 h-4 inline-block mr-2"></i>
                    Actualizar
                </button>
            </div>
        </div>

        <div id="lista-cierres" class="space-y-4">
            <div class="bg-white rounded-2xl shadow-xl p-8 text-center border-2 border-gray-200">
                <p class="text-gray-500 font-bold">Cargando historial...</p>
            </div>
        </div>
    </div>

    <!-- TAB: REGISTRAR -->
    <div id="content-registrar" class="tab-content hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Formulario de Ingreso -->
            <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-green-200">
                <h3 class="text-2xl font-black text-green-700 mb-6 uppercase tracking-wide flex items-center">
                    <i data-lucide="plus-circle" class="w-6 h-6 mr-2"></i>
                    Registrar Ingreso
                </h3>
                <form onsubmit="registrarIngreso(event)" class="space-y-4">
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Categoría</label>
                        <select id="ingreso-categoria" required
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-600 focus:border-green-600 font-semibold">
                            <option value="membresia">Membresía</option>
                            <option value="renovacion">Renovación</option>
                            <option value="producto">Producto</option>
                            <option value="abono_deuda">Abono Deuda</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Monto</label>
                        <input type="number" id="ingreso-monto" step="0.01" required
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-600 focus:border-green-600 font-semibold"
                               placeholder="0.00">
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Método de Pago</label>
                        <select id="ingreso-metodo" required
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-600 focus:border-green-600 font-semibold">
                            <option value="efectivo">Efectivo</option>
                            <option value="transferencia">Transferencia</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Descripción</label>
                        <textarea id="ingreso-descripcion" rows="3" required
                                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-600 focus:border-green-600 font-semibold"
                                  placeholder="Detalles del ingreso"></textarea>
                    </div>
                    <button type="submit"
                            class="w-full py-4 bg-gradient-to-r from-green-600 to-green-800 hover:from-green-700 hover:to-green-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                        <i data-lucide="check-circle" class="w-5 h-5 inline-block mr-2"></i>
                        Registrar Ingreso
                    </button>
                </form>
            </div>

            <!-- Formulario de Egreso -->
            <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-red-200">
                <h3 class="text-2xl font-black text-red-700 mb-6 uppercase tracking-wide flex items-center">
                    <i data-lucide="minus-circle" class="w-6 h-6 mr-2"></i>
                    Registrar Egreso
                </h3>
                <form onsubmit="registrarEgreso(event)" class="space-y-4">
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Categoría</label>
                        <select id="egreso-categoria" required
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                            <option value="salario">Salario</option>
                            <option value="servicio">Servicio</option>
                            <option value="compra">Compra</option>
                            <option value="mantenimiento">Mantenimiento</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Monto</label>
                        <input type="number" id="egreso-monto" step="0.01" required
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold"
                               placeholder="0.00">
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Método de Pago</label>
                        <select id="egreso-metodo" required
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                            <option value="efectivo">Efectivo</option>
                            <option value="transferencia">Transferencia</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Descripción</label>
                        <textarea id="egreso-descripcion" rows="3" required
                                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold"
                                  placeholder="Detalles del egreso"></textarea>
                    </div>
                    <button type="submit"
                            class="w-full py-4 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                        <i data-lucide="alert-circle" class="w-5 h-5 inline-block mr-2"></i>
                        Registrar Egreso
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE CIERRE DE CAJA -->
<div id="modal-cerrar-caja" class="fixed inset-0 bg-black bg-opacity-70 hidden items-center justify-center z-50" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl mx-4 transform transition-all">
        <div class="bg-gradient-to-r from-amber-600 to-amber-800 text-white px-8 py-6 rounded-t-3xl">
            <h3 class="text-3xl font-black uppercase tracking-wide flex items-center">
                <i data-lucide="lock" class="w-8 h-8 mr-3"></i>
                Cerrar Caja
            </h3>
        </div>

        <div class="p-8">
            <!-- Resumen del cierre -->
            <div class="bg-gray-50 rounded-2xl p-6 mb-6 border-2 border-gray-200">
                <h4 class="text-lg font-black text-gray-900 mb-4 uppercase">Resumen del Cierre</h4>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm text-gray-600 font-bold mb-1">Saldo Anterior:</p>
                        <p class="text-2xl font-black text-purple-600" id="cierre-saldo-anterior">$0.00</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 font-bold mb-1">Efectivo Final:</p>
                        <p class="text-2xl font-black text-emerald-600" id="cierre-efectivo-final">$0.00</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 font-bold mb-1">Ingresos Hoy:</p>
                        <p class="text-xl font-black text-blue-600" id="cierre-ingresos">$0.00</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 font-bold mb-1">Egresos Hoy:</p>
                        <p class="text-xl font-black text-red-600" id="cierre-egresos">$0.00</p>
                    </div>
                    <div class="col-span-2">
                        <p class="text-sm text-gray-600 font-bold mb-1">Balance General:</p>
                        <p class="text-3xl font-black text-amber-600" id="cierre-balance">$0.00</p>
                    </div>
                </div>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Observaciones (Opcional)</label>
                <textarea id="cierre-observaciones" rows="3"
                          class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-amber-600 focus:border-amber-600 font-semibold"
                          placeholder="Notas adicionales sobre el cierre..."></textarea>
            </div>

            <div class="flex gap-4">
                <button onclick="cerrarModalCerrarCaja()"
                        class="flex-1 px-6 py-4 bg-gray-200 hover:bg-gray-300 text-gray-800 font-black rounded-xl transition-all uppercase tracking-wide">
                    <i data-lucide="x" class="w-5 h-5 inline-block mr-2"></i>
                    Cancelar
                </button>
                <button onclick="confirmarCierreCaja()"
                        class="flex-1 px-6 py-4 bg-gradient-to-r from-amber-600 to-amber-800 hover:from-amber-700 hover:to-amber-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                    <i data-lucide="check-circle" class="w-5 h-5 inline-block mr-2"></i>
                    Confirmar Cierre
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARA ABONAR DEUDA -->
<div id="modalAbonarDeuda" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4">
        <div class="bg-gradient-to-r from-emerald-600 to-emerald-800 text-white p-6 rounded-t-2xl">
            <div class="flex items-center justify-between">
                <h3 class="text-2xl font-black uppercase tracking-wide">Abonar a Deuda</h3>
                <button onclick="cerrarModalAbonar()" class="text-white hover:text-gray-200">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <div class="p-6">
            <div class="mb-4">
                <p class="text-sm text-gray-600 font-bold uppercase mb-1">Cliente</p>
                <p class="text-lg font-black text-gray-900" id="modal-cliente-nombre">-</p>
            </div>

            <div class="mb-4">
                <p class="text-sm text-gray-600 font-bold uppercase mb-1">Concepto</p>
                <p class="text-lg font-black text-gray-900" id="modal-concepto">-</p>
            </div>

            <div class="mb-4">
                <p class="text-sm text-gray-600 font-bold uppercase mb-1">Saldo Pendiente</p>
                <p class="text-2xl font-black text-red-600" id="modal-saldo">$0.00</p>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Monto a Abonar</label>
                <input type="number" step="0.01" id="input-monto-abono"
                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-600 focus:outline-none font-bold text-lg">
            </div>

            <div class="mb-6">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Método de Pago</label>
                <select id="input-metodo-abono"
                        class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:border-emerald-600 focus:outline-none font-bold">
                    <option value="efectivo">Efectivo</option>
                    <option value="transferencia">Transferencia</option>
                </select>
            </div>

            <div class="flex gap-3">
                <button onclick="cerrarModalAbonar()"
                        class="flex-1 px-6 py-3 bg-gray-200 text-gray-900 rounded-xl hover:bg-gray-300 font-black uppercase tracking-wide transition-all">
                    Cancelar
                </button>
                <button onclick="confirmarAbono()"
                        class="flex-1 px-6 py-3 bg-gradient-to-r from-emerald-600 to-emerald-800 text-white rounded-xl hover:from-emerald-700 hover:to-emerald-900 font-black uppercase tracking-wide transition-all">
                    Confirmar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                const API_URL = '/api';

                // ========================================
                // GESTIÓN DE TABS
                // ========================================
                function cambiarTab(tab) {
                    // Ocultar todos los contenidos
                    document.querySelectorAll('.tab-content').forEach(content => {
                        content.classList.add('hidden');
                    });

                    // Quitar estilos activos de todos los tabs
                    document.querySelectorAll('.tab-btn').forEach(btn => {
                        btn.classList.remove('border-b-4', 'border-red-600', 'bg-red-50', 'text-red-600');
                    });

                    // Mostrar contenido seleccionado
                    document.getElementById(`content-${tab}`).classList.remove('hidden');

                    // Activar tab seleccionado
                    const activeTab = document.getElementById(`tab-${tab}`);
                    activeTab.classList.add('border-b-4', 'border-red-600', 'bg-red-50', 'text-red-600');

                    // Cargar datos específicos del tab
                    if (tab === 'semanal') {
                        cargarResumenSemanal();
                    } else if (tab === 'cierres') {
                        cargarHistorialCierres();
                    } else if (tab === 'deudas') {
                        cargarDeudas();
                    }

                    lucide.createIcons();
                }

                // ========================================
                // CARGAR RESUMEN PRINCIPAL
                // ========================================
                async function cargarResumen() {
                    try {
                        const [responseHoy, responseSaldoAnterior] = await Promise.all([
                            fetch(`${API_URL}/Caja/hoy`),
                            fetch(`${API_URL}/Caja/saldo-anterior`)
                        ]);

                        const dataHoy = await responseHoy.json();
                        const dataSaldoAnterior = await responseSaldoAnterior.json();

                        if (dataHoy.success) {
                            const saldoAnterior = dataSaldoAnterior.success ? dataSaldoAnterior.saldoAnterior : 0;
                            const efectivoHoy = (dataHoy.ingresosEfectivo || 0) - (dataHoy.egresosEfectivo || 0);
                            const efectivoTotal = saldoAnterior + efectivoHoy;

                            // Actualizar tarjetas
                            document.getElementById('efectivo-caja').textContent = `$${efectivoTotal.toFixed(2)}`;
                            document.getElementById('saldo-anterior').textContent = `$${saldoAnterior.toFixed(2)}`;
                            document.getElementById('ingresos-hoy').textContent = `$${(dataHoy.ingresos || 0).toFixed(2)}`;
                            document.getElementById('egresos-hoy').textContent = `$${(dataHoy.egresos || 0).toFixed(2)}`;
                            document.getElementById('balance-total').textContent = `$${(dataHoy.balance || 0).toFixed(2)}`;

                            // Detalles
                            document.getElementById('detalle-ingresos').textContent =
                                `Efectivo: $${(dataHoy.ingresosEfectivo || 0).toFixed(2)} | Transf: $${(dataHoy.ingresosTransferencia || 0).toFixed(2)}`;
                            document.getElementById('detalle-egresos').textContent =
                                `Efectivo: $${(dataHoy.egresosEfectivo || 0).toFixed(2)} | Transf: $${(dataHoy.egresosTransferencia || 0).toFixed(2)}`;

                            if (dataSaldoAnterior.success && dataSaldoAnterior.fechaCierre) {
                                const fecha = new Date(dataSaldoAnterior.fechaCierre);
                                document.getElementById('fecha-saldo-anterior').textContent =
                                    `Cierre: ${fecha.toLocaleDateString('es-ES')}`;
                            }
                        }

                        // Cargar deudas pendientes
                        const responseDeudas = await fetch(`${API_URL}/Deudas?estado=pendiente`);
                        const deudasData = await responseDeudas.json();

                        if (deudasData.success) {
                            document.getElementById('deudas-pendientes').textContent = `$${deudasData.totalSaldoPendiente.toFixed(2)}`;
                        }
                    } catch (error) {
                        console.error('Error al cargar resumen:', error);
                    }
                }

                // ========================================
                // CARGAR MOVIMIENTOS
                // ========================================
                async function cargarMovimientos() {
                    try {
                        const desde = document.getElementById('fecha-desde').value;
                        const hasta = document.getElementById('fecha-hasta').value;
                        const categoria = document.getElementById('filtro-categoria').value;

                        let url = `${API_URL}/Caja/movimientos?`;
                        if (desde) url += `desde=${desde}&`;
                        if (hasta) url += `hasta=${hasta}&`;
                        if (categoria) url += `categoria=${categoria}&`;

                        const response = await fetch(url);
                        const data = await response.json();

                        const tbody = document.getElementById('tabla-movimientos');

                        if (data.success && data.movimientos.length > 0) {
                            tbody.innerHTML = data.movimientos.map(m => {
                                const fecha = new Date(m.Fecha);
                                const tipoColor = m.Tipo === 'ingreso' ? 'text-green-600' : 'text-red-600';
                                const metodoBadge = m.MetodoPago === 'efectivo'
                                    ? '<span class="px-2 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded">Efectivo</span>'
                                    : '<span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs font-bold rounded">Transferencia</span>';

                                return `
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 text-sm font-semibold text-gray-900">
                                            ${fecha.toLocaleDateString('es-ES')} ${fecha.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="px-3 py-1 ${tipoColor} bg-opacity-10 rounded-full text-xs font-black uppercase">${m.Tipo}</span>
                                        </td>
                                        <td class="px-6 py-4 text-sm font-semibold text-gray-700">${m.Categoria}</td>
                                        <td class="px-6 py-4 text-sm font-semibold text-gray-600">${m.Descripcion}</td>
                                        <td class="px-6 py-4">${metodoBadge}</td>
                                        <td class="px-6 py-4 text-right text-lg font-black ${tipoColor}">$${m.Monto.toFixed(2)}</td>
                                    </tr>
                                `;
                            }).join('');
                        } else {
                            tbody.innerHTML = `
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center text-gray-500 font-bold">
                                        No hay movimientos para mostrar
                                    </td>
                                </tr>
                            `;
                        }
                    } catch (error) {
                        console.error('Error al cargar movimientos:', error);
                    }
                }

                // ========================================
                // RESUMEN SEMANAL
                // ========================================
                async function cargarResumenSemanal() {
                    try {
                        const response = await fetch(`${API_URL}/Caja/resumen-semanal`);
                        const data = await response.json();

                        if (data.success) {
                            // Actualizar período
                            const desde = new Date(data.periodo.desde);
                            const hasta = new Date(data.periodo.hasta);
                            document.getElementById('periodo-semanal').textContent =
                                `Semana del ${desde.toLocaleDateString('es-ES')} al ${hasta.toLocaleDateString('es-ES')}`;

                            // Actualizar totales
                            document.getElementById('total-ingresos-semana').textContent = `$${data.totales.ingresos.toFixed(2)}`;
                            document.getElementById('total-egresos-semana').textContent = `$${data.totales.egresos.toFixed(2)}`;
                            document.getElementById('balance-semana').textContent = `$${data.totales.balance.toFixed(2)}`;
                            document.getElementById('cantidad-movimientos-semana').textContent = data.totales.cantidadMovimientos;

                            // Actualizar tabla por día
                            const tbody = document.getElementById('tabla-resumen-semanal');
                            tbody.innerHTML = data.resumenPorDia.map(dia => {
                                const balanceColor = dia.balance >= 0 ? 'text-emerald-600' : 'text-red-600';
                                return `
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 text-sm font-black text-gray-900 uppercase">${dia.diaNombre}</td>
                                        <td class="px-6 py-4 text-right text-lg font-black text-blue-600">$${dia.ingresos.toFixed(2)}</td>
                                        <td class="px-6 py-4 text-right text-lg font-black text-red-600">$${dia.egresos.toFixed(2)}</td>
                                        <td class="px-6 py-4 text-right text-lg font-black ${balanceColor}">$${dia.balance.toFixed(2)}</td>
                                        <td class="px-6 py-4 text-right text-sm font-semibold text-gray-700">$${dia.ingresosEfectivo.toFixed(2)}</td>
                                        <td class="px-6 py-4 text-right text-sm font-semibold text-gray-700">$${dia.ingresosTransferencia.toFixed(2)}</td>
                                        <td class="px-6 py-4 text-center">
                                            <span class="px-3 py-1 bg-purple-100 text-purple-800 text-xs font-bold rounded-full">${dia.cantidadMovimientos}</span>
                                        </td>
                                    </tr>
                                `;
                            }).join('');
                        }
                    } catch (error) {
                        console.error('Error al cargar resumen semanal:', error);
                    }
                }

                // ========================================
                // HISTORIAL DE CIERRES
                // ========================================
                async function cargarHistorialCierres() {
                    try {
                        const response = await fetch(`${API_URL}/Caja/historial-cierres?limit=20`);
                        const data = await response.json();

                        const container = document.getElementById('lista-cierres');

                        if (data.success && data.cierres.length > 0) {
                            container.innerHTML = data.cierres.map(cierre => {
                                const fecha = new Date(cierre.fechaCierre);
                                const tipoBadge = cierre.tipo === 'automatico'
                                    ? '<span class="px-3 py-1 bg-blue-100 text-blue-800 text-xs font-bold rounded-full">AUTOMÁTICO</span>'
                                    : '<span class="px-3 py-1 bg-purple-100 text-purple-800 text-xs font-bold rounded-full">MANUAL</span>';

                                return `
                                    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
                                        <div class="flex items-center justify-between mb-4">
                                            <div>
                                                <h4 class="text-lg font-black text-gray-900">${fecha.toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</h4>
                                                <p class="text-sm text-gray-600 font-semibold">${fecha.toLocaleTimeString('es-ES')}</p>
                                            </div>
                                            ${tipoBadge}
                                        </div>

                                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                                            <div class="bg-purple-50 rounded-xl p-3">
                                                <p class="text-xs text-purple-700 font-bold mb-1">Saldo Inicial</p>
                                                <p class="text-lg font-black text-purple-600">$${cierre.efectivoInicial.toFixed(2)}</p>
                                            </div>
                                            <div class="bg-emerald-50 rounded-xl p-3">
                                                <p class="text-xs text-emerald-700 font-bold mb-1">Efectivo Final</p>
                                                <p class="text-lg font-black text-emerald-600">$${cierre.efectivoFinal.toFixed(2)}</p>
                                            </div>
                                            <div class="bg-blue-50 rounded-xl p-3">
                                                <p class="text-xs text-blue-700 font-bold mb-1">Ingresos</p>
                                                <p class="text-lg font-black text-blue-600">$${cierre.totalIngresos.toFixed(2)}</p>
                                            </div>
                                            <div class="bg-red-50 rounded-xl p-3">
                                                <p class="text-xs text-red-700 font-bold mb-1">Egresos</p>
                                                <p class="text-lg font-black text-red-600">$${cierre.totalEgresos.toFixed(2)}</p>
                                            </div>
                                        </div>

                                        <div class="bg-amber-50 rounded-xl p-4">
                                            <div class="flex items-center justify-between">
                                                <div>
                                                    <p class="text-sm text-amber-700 font-bold mb-1">Balance General</p>
                                                    <p class="text-2xl font-black text-amber-600">$${cierre.balanceGeneral.toFixed(2)}</p>
                                                </div>
                                                <div class="text-right">
                                                    <p class="text-xs text-gray-600 font-semibold">Movimientos</p>
                                                    <p class="text-xl font-black text-gray-900">${cierre.cantidadMovimientos}</p>
                                                </div>
                                            </div>
                                        </div>

                                        ${cierre.observaciones ? `
                                            <div class="mt-4 bg-gray-50 rounded-xl p-3">
                                                <p class="text-xs text-gray-600 font-bold mb-1">Observaciones:</p>
                                                <p class="text-sm text-gray-700 font-semibold">${cierre.observaciones}</p>
                                            </div>
                                        ` : ''}
                                    </div>
                                `;
                            }).join('');
                        } else {
                            container.innerHTML = `
                                <div class="bg-white rounded-2xl shadow-xl p-8 text-center border-2 border-gray-200">
                                    <p class="text-gray-500 font-bold">No hay cierres registrados aún</p>
                                </div>
                            `;
                        }
                    } catch (error) {
                        console.error('Error al cargar historial de cierres:', error);
                    }
                }

                // ========================================
                // MODAL CERRAR CAJA
                // ========================================
                async function abrirModalCerrarCaja() {
                    try {
                        const [responseHoy, responseSaldoAnterior] = await Promise.all([
                            fetch(`${API_URL}/Caja/hoy`),
                            fetch(`${API_URL}/Caja/saldo-anterior`)
                        ]);

                        const dataHoy = await responseHoy.json();
                        const dataSaldoAnterior = await responseSaldoAnterior.json();

                        if (dataHoy.success) {
                            const saldoAnterior = dataSaldoAnterior.success ? dataSaldoAnterior.saldoAnterior : 0;
                            const efectivoHoy = (dataHoy.ingresosEfectivo || 0) - (dataHoy.egresosEfectivo || 0);
                            const efectivoFinal = saldoAnterior + efectivoHoy;

                            document.getElementById('cierre-saldo-anterior').textContent = `$${saldoAnterior.toFixed(2)}`;
                            document.getElementById('cierre-efectivo-final').textContent = `$${efectivoFinal.toFixed(2)}`;
                            document.getElementById('cierre-ingresos').textContent = `$${(dataHoy.ingresos || 0).toFixed(2)}`;
                            document.getElementById('cierre-egresos').textContent = `$${(dataHoy.egresos || 0).toFixed(2)}`;
                            document.getElementById('cierre-balance').textContent = `$${(dataHoy.balance || 0).toFixed(2)}`;
                        }

                        document.getElementById('modal-cerrar-caja').style.display = 'flex';
                        lucide.createIcons();
                    } catch (error) {
                        console.error('Error al abrir modal:', error);
                        alert('❌ Error al cargar datos del cierre');
                    }
                }

                function cerrarModalCerrarCaja() {
                    document.getElementById('modal-cerrar-caja').style.display = 'none';
                    document.getElementById('cierre-observaciones').value = '';
                }

                async function confirmarCierreCaja() {
                    try {
                        const observaciones = document.getElementById('cierre-observaciones').value;

                        const response = await fetch(`${API_URL}/Caja/cerrar-caja`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                observaciones: observaciones
                                // No enviar usuarioId, será null por defecto
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            const cierre = result.cierre;
                            const mensaje = `✅ CAJA CERRADA EXITOSAMENTE

        📊 RESUMEN DEL CIERRE:
        ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        💰 Efectivo Inicial: $${cierre.efectivoInicial.toLocaleString()}
        📈 Ingresos Efectivo: $${cierre.ingresosEfectivo.toLocaleString()}
        📉 Egresos Efectivo: $${cierre.egresosEfectivo.toLocaleString()}
        💵 Efectivo Final: $${cierre.efectivoFinal.toLocaleString()}

        💳 Ingresos Transferencia: $${cierre.ingresosTransferencia.toLocaleString()}
        💳 Egresos Transferencia: $${cierre.egresosTransferencia.toLocaleString()}

        📊 TOTALES:
        ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        💵 Total Ingresos: $${cierre.totalIngresos.toLocaleString()}
        💸 Total Egresos: $${cierre.totalEgresos.toLocaleString()}
        📊 Balance General: $${cierre.balanceGeneral.toLocaleString()}
        📋 Movimientos: ${cierre.cantidadMovimientos}`;

                            alert(mensaje);
                            cerrarModalCerrarCaja();
                            cargarResumen();
                            cambiarTab('cierres');
                        } else {
                            alert(`❌ Error: ${result.message}`);
                        }
                    } catch (error) {
                        console.error('Error al cerrar caja:', error);
                        alert('❌ Error al procesar el cierre de caja');
                    }
                }

                // ========================================
                // REGISTRAR MOVIMIENTOS
                // ========================================
                async function registrarIngreso(event) {
                    event.preventDefault();

                    const monto = parseFloat(document.getElementById('ingreso-monto').value);
                    const categoria = document.getElementById('ingreso-categoria').value;
                    const metodo = document.getElementById('ingreso-metodo').value;
                    const descripcion = document.getElementById('ingreso-descripcion').value;

                    try {
                        const response = await fetch(`${API_URL}/Caja/ingreso`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                categoria: categoria,
                                monto: monto,
                                descripcion: descripcion,
                                metodoPago: metodo
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            alert('✅ Ingreso registrado exitosamente');
                            event.target.reset();
                            cargarResumen();
                            cambiarTab('movimientos');
                        } else {
                            alert(`❌ Error: ${result.message}`);
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('❌ Error al registrar ingreso');
                    }
                }

                async function registrarEgreso(event) {
                    event.preventDefault();

                    const monto = parseFloat(document.getElementById('egreso-monto').value);
                    const categoria = document.getElementById('egreso-categoria').value;
                    const metodo = document.getElementById('egreso-metodo').value;
                    const descripcion = document.getElementById('egreso-descripcion').value;

                    try {
                        const response = await fetch(`${API_URL}/Caja/egreso`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                categoria: categoria,
                                monto: monto,
                                descripcion: descripcion,
                                metodoPago: metodo
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            alert('✅ Egreso registrado exitosamente');
                            event.target.reset();
                            cargarResumen();
                            cambiarTab('movimientos');
                        } else {
                            alert(`❌ Error: ${result.message}`);
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('❌ Error al registrar egreso');
                    }
                }

                // ========================================
                // DEUDAS
                // ========================================
                let deudasData = [];
                let deudaSeleccionada = null;

                async function cargarDeudas() {
                    try {
                        const response = await fetch(`${API_URL}/Deudas?estado=pendiente`);
                        const data = await response.json();

                        if (!data.success) {
                            document.getElementById('lista-deudas').innerHTML = `
                                <div class="text-center py-12 text-red-500 font-bold">
                                    Error al cargar deudas
                                </div>
                            `;
                            return;
                        }

                        deudasData = data.data;

                        if (deudasData.length === 0) {
                            document.getElementById('lista-deudas').innerHTML = `
                                <div class="bg-white rounded-2xl shadow-xl p-12 text-center border-2 border-gray-200">
                                    <i data-lucide="check-circle" class="w-16 h-16 mx-auto text-emerald-600 mb-4"></i>
                                    <p class="text-xl font-black text-gray-900 uppercase">No hay deudas pendientes</p>
                                    <p class="text-gray-600 mt-2 font-semibold">Todos los clientes están al día</p>
                                </div>
                            `;
                            lucide.createIcons();
                            return;
                        }

                        renderDeudas(deudasData);
                    } catch (error) {
                        console.error('Error cargando deudas:', error);
                    }
                }

                function renderDeudas(deudas) {
                    const container = document.getElementById('lista-deudas');

                    container.innerHTML = deudas.map(deuda => `
                        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200 hover:shadow-2xl transition-shadow">
                            <div class="flex justify-between items-start">
                                <div class="flex-1">
                                    <div class="flex items-center gap-3 mb-2">
                                        <h3 class="text-2xl font-black text-gray-900 uppercase tracking-wide">
                                            ${deuda.clienteNombre}
                                        </h3>
                                        <span class="px-3 py-1 rounded-full text-xs font-black uppercase bg-amber-100 text-amber-800">
                                            Pendiente
                                        </span>
                                    </div>
                                    <p class="text-sm text-gray-600 font-bold mb-3">Cédula: ${deuda.clienteCedula}</p>

                                    <div class="bg-gray-50 rounded-xl p-4 mb-4 border-2 border-gray-200">
                                        <p class="text-sm text-gray-600 font-bold uppercase mb-1">Concepto</p>
                                        <p class="text-base text-gray-900 font-black">${deuda.Concepto}</p>
                                    </div>

                                    <div class="grid grid-cols-3 gap-4 mb-4">
                                        <div>
                                            <p class="text-xs text-gray-600 font-bold uppercase mb-1">Total</p>
                                            <p class="text-lg font-black text-gray-900">$${deuda.MontoTotal.toFixed(2)}</p>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-bold uppercase mb-1">Pagado</p>
                                            <p class="text-lg font-black text-emerald-600">$${deuda.MontoPagado.toFixed(2)}</p>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-bold uppercase mb-1">Saldo</p>
                                            <p class="text-2xl font-black text-red-600">$${deuda.Saldo.toFixed(2)}</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="ml-6 flex flex-col gap-2">
                                    <button onclick="abrirModalAbonar('${deuda.Id}')"
                                            class="px-6 py-3 bg-gradient-to-r from-emerald-600 to-emerald-800 hover:from-emerald-700 hover:to-emerald-900 text-white font-black rounded-xl transition-all shadow-lg uppercase tracking-wide transform hover:scale-105">
                                        <i data-lucide="dollar-sign" class="w-5 h-5 inline-block mr-2"></i>
                                        Abonar
                                    </button>
                                    <button onclick="pagarCompleto('${deuda.Id}')"
                                            class="px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-black rounded-xl transition-all shadow-lg uppercase tracking-wide transform hover:scale-105">
                                        <i data-lucide="check-circle" class="w-5 h-5 inline-block mr-2"></i>
                                        Pagar Todo
                                    </button>
                                </div>
                            </div>
                        </div>
                    `).join('');

                    lucide.createIcons();
                }

                function filtrarDeudas() {
                    const query = document.getElementById('buscar-deuda').value.toLowerCase();
                    const filtradas = deudasData.filter(d =>
                        d.clienteNombre.toLowerCase().includes(query) ||
                        d.clienteCedula.includes(query) ||
                        d.Concepto.toLowerCase().includes(query)
                    );
                    renderDeudas(filtradas);
                }

                function abrirModalAbonar(deudaId) {
                    const deuda = deudasData.find(d => d.Id === deudaId);
                    if (!deuda) return;

                    deudaSeleccionada = deuda;
                    document.getElementById('modal-cliente-nombre').textContent = deuda.clienteNombre;
                    document.getElementById('modal-concepto').textContent = deuda.Concepto;
                    document.getElementById('modal-saldo').textContent = `$${deuda.Saldo.toFixed(2)}`;
                    document.getElementById('input-monto-abono').value = deuda.Saldo.toFixed(2);
                    document.getElementById('modalAbonarDeuda').classList.remove('hidden');
                    lucide.createIcons();
                }

                function cerrarModalAbonar() {
                    document.getElementById('modalAbonarDeuda').classList.add('hidden');
                    deudaSeleccionada = null;
                }

                async function confirmarAbono() {
                    const monto = parseFloat(document.getElementById('input-monto-abono').value);
                    const metodo = document.getElementById('input-metodo-abono').value;

                    if (isNaN(monto) || monto <= 0) {
                        alert('❌ Monto inválido');
                        return;
                    }

                    if (monto > deudaSeleccionada.Saldo) {
                        alert('❌ El monto no puede ser mayor al saldo pendiente');
                        return;
                    }

                    try {
                        const response = await fetch(`${API_URL}/Deudas/abonar`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                deudaId: deudaSeleccionada.Id,
                                monto: monto,
                                metodoPago: metodo,
                                notas: `Abono a deuda - ${deudaSeleccionada.Concepto}`
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            alert(`✅ ${result.message}`);
                            cerrarModalAbonar();
                            cargarDeudas();
                            cargarResumen();
                        } else {
                            alert(`❌ Error: ${result.message}`);
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('❌ Error al registrar abono');
                    }
                }

                async function pagarCompleto(deudaId) {
                    const deuda = deudasData.find(d => d.Id === deudaId);
                    if (!deuda) return;

                    if (!confirm(`¿Pagar completamente $${deuda.Saldo.toFixed(2)}?`)) return;

                    try {
                        const response = await fetch(`${API_URL}/Deudas/abonar`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                deudaId: deuda.Id,
                                monto: deuda.Saldo,
                                metodoPago: 'efectivo',
                                notas: 'Pago completo de deuda'
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            alert('✅ Deuda pagada completamente');
                            cargarDeudas();
                            cargarResumen();
                        } else {
                            alert(`❌ Error: ${result.message}`);
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('❌ Error al pagar deuda');
                    }
                }

                // ========================================
                // INICIALIZACIÓN
                // ========================================
                window.addEventListener('load', function() {
                    cargarResumen();
                    cargarMovimientos();
                    lucide.createIcons();
                });

                // Asignar funciones globales
                window.cambiarTab = cambiarTab;
                window.cargarMovimientos = cargarMovimientos;
                window.cargarResumenSemanal = cargarResumenSemanal;
                window.cargarHistorialCierres = cargarHistorialCierres;
                window.abrirModalCerrarCaja = abrirModalCerrarCaja;
                window.cerrarModalCerrarCaja = cerrarModalCerrarCaja;
                window.confirmarCierreCaja = confirmarCierreCaja;
                window.registrarIngreso = registrarIngreso;
                window.registrarEgreso = registrarEgreso;
                window.cargarDeudas = cargarDeudas;
                window.filtrarDeudas = filtrarDeudas;
                window.abrirModalAbonar = abrirModalAbonar;
                window.cerrarModalAbonar = cerrarModalAbonar;
                window.confirmarAbono = confirmarAbono;
                window.pagarCompleto = pagarCompleto;
    </script>
}

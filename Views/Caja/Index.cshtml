@section Scripts {
    <script>
        const API_URL = '/api';
        let fechaDiaCerrar = null;

        function parsearFechaLocal(fechaString) {
            if (!fechaString) return null;
            const partes = fechaString.split('T');
            const fecha = partes[0].split('-');
            const anio = parseInt(fecha[0], 10), mes = parseInt(fecha[1], 10) - 1, dia = parseInt(fecha[2], 10);
            let horas=0, minutos=0, segundos=0;
            if (partes[1]) { const t=partes[1].split(':'); horas=parseInt(t[0],10)||0; minutos=parseInt(t[1],10)||0; segundos=parseInt(t[2],10)||0; }
            return new Date(anio, mes, dia, horas, minutos, segundos);
        }
        function parsearFechaUTC(s) { return new Date(s); }
        function formatearFechaHoraUTC(s) {
            const f=parsearFechaLocal(s); if(!f||isNaN(f)) return '—';
            const dia=f.getDate(), mes=f.getMonth()+1, anio=f.getFullYear();
            const h24=f.getHours(), mm=String(f.getMinutes()).padStart(2,'0');
            const ampm=h24>=12?'PM':'AM', h12=h24%12||12;
            return `${dia}/${mes}/${anio} ${h12}:${mm} ${ampm}`;
        }
        function formatearFechaUTC(s) {
            const f=parsearFechaLocal(s); if(!f||isNaN(f)) return '—';
            return `${f.getDate()}/${f.getMonth()+1}/${f.getFullYear()}`;
        }
        function formatearFechaLargaUTC(s) {
            const f=parsearFechaLocal(s); if(!f||isNaN(f)) return '—';
            return f.toLocaleDateString('es-ES',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
        }
        function obtenerFechaLocalISO() {
            const h=new Date();
            return `${h.getFullYear()}-${String(h.getMonth()+1).padStart(2,'0')}-${String(h.getDate()).padStart(2,'0')}`;
        }

        function cambiarTab(tab) {
            document.querySelectorAll('.tab-content').forEach(c=>c.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
            document.getElementById(`content-${tab}`).classList.remove('hidden');
            document.getElementById(`tab-${tab}`).classList.add('active');
            if (tab==='semanal') cargarResumenSemanal();
            else if (tab==='cierres') cargarHistorialCierres();
            else if (tab==='deudas') cargarDeudas();
            else if (tab==='pendientes') cargarDiasPendientes();
            lucide.createIcons();
        }

        async function cargarResumen() {
            try {
                const r=await fetch(`${API_URL}/Caja/dashboard`), data=await r.json();
                if (data.success) {
                    const set=(id,v)=>{const el=document.getElementById(id);if(el)el.textContent=`$${(v||0).toFixed(2)}`;};
                    set('efectivo-hoy',data.cajaHoy.efectivo.balance);
                    set('transferencias-hoy',data.cajaHoy.transferencia.balance);
                    set('ingresos-hoy',data.cajaHoy.totalIngresos);
                    set('egresos-hoy',data.cajaHoy.totalEgresos);
                    set('balance-total',data.cajaHoy.balance);
                    set('venta-membresias',data.cajaHoy.categorias.membresias);
                    set('venta-productos',data.cajaHoy.categorias.productos);
                    set('venta-abonos',data.cajaHoy.categorias.abonos);
                    set('venta-otros',data.cajaHoy.categorias.otros);
                    const di=document.getElementById('detalle-ingresos');

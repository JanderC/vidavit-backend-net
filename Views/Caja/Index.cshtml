                    set('cierre-balance',data.cajaHoy.balance);
                    set('cierre-productos-total',data.cajaHoy.categorias.productos||0);
                    const m=document.getElementById('modal-cerrar-caja');
                    if(m){m.classList.remove('hidden');lucide.createIcons();}

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Caja";
    ViewData["Subtitle"] = "Control financiero completo - TAURO GYM";
}

<div class="space-y-6">
    <!-- TABS DE NAVEGACIÓN -->
    <div class="bg-white rounded-2xl shadow-xl border-2 border-gray-200 overflow-hidden">
        <div class="flex border-b-2 border-gray-200">
            <button onclick="cambiarTab('balance')" id="tab-balance"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all border-b-4 border-red-600 bg-red-50 text-red-600">
                <i data-lucide="wallet" class="w-5 h-5 inline-block mr-2"></i>
                Balance & Movimientos
            </button>
        </div>
    </div>

    <!-- CONTENIDO TAB BALANCE -->
    <div id="content-balance" class="tab-content">
        <!-- FILTROS DE FECHA -->
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
            <div class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Desde</label>
                    <input type="date" id="fecha-desde"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Hasta</label>
                    <input type="date" id="fecha-hasta"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <button onclick="cargarBalance()"
                        class="px-8 py-3 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                    <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                    Filtrar
                </button>
            </div>
        </div>

        <!-- RESUMEN DE CAJA CON DESGLOSE DETALLADO -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
            <!-- TARJETA DE INGRESOS -->
            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-emerald-600">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Ingresos Totales</p>
                        <p class="text-4xl font-black text-emerald-600" id="total-ingresos">$0.00</p>
                    </div>
                    <div class="w-14 h-14 bg-emerald-100 rounded-full flex items-center justify-center">
                        <i data-lucide="trending-up" class="w-7 h-7 text-emerald-600"></i>
                    </div>
                </div>

                <!-- Desglose de ingresos -->
                <div class="mt-4 pt-4 border-t-2 border-gray-100 space-y-2">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">💪 Membresías:</span>
                        <span class="font-bold text-emerald-700" id="ingreso-membresia">$0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">🛒 Productos:</span>
                        <span class="font-bold text-emerald-700" id="ingreso-producto">$0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">💵 Abonos:</span>
                        <span class="font-bold text-emerald-700" id="ingreso-abono">$0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">📝 Otros:</span>
                        <span class="font-bold text-emerald-700" id="ingreso-otro">$0.00</span>
                    </div>
                </div>
            </div>

            <!-- TARJETA DE EGRESOS -->
            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-red-600">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Egresos Totales</p>
                        <p class="text-4xl font-black text-red-600" id="total-egresos">$0.00</p>
                    </div>
                    <div class="w-14 h-14 bg-red-100 rounded-full flex items-center justify-center">
                        <i data-lucide="trending-down" class="w-7 h-7 text-red-600"></i>
                    </div>
                </div>

                <!-- Desglose de egresos -->
                <div class="mt-4 pt-4 border-t-2 border-gray-100 space-y-2">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">👤 Salarios:</span>
                        <span class="font-bold text-red-700" id="egreso-salario">$0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">📦 Compras:</span>
                        <span class="font-bold text-red-700" id="egreso-compra">$0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">🔧 Servicios:</span>
                        <span class="font-bold text-red-700" id="egreso-servicio">$0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">📝 Otros:</span>
                        <span class="font-bold text-red-700" id="egreso-otro">$0.00</span>
                    </div>
                </div>
            </div>

            <!-- TARJETA DE BALANCE -->
            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-blue-600">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Balance Neto</p>
                        <p class="text-4xl font-black text-blue-600" id="balance-total">$0.00</p>
                    </div>
                    <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center">
                        <i data-lucide="wallet" class="w-7 h-7 text-blue-600"></i>
                    </div>
                </div>

                <!-- Resumen de métodos de pago -->
                <div class="mt-4 pt-4 border-t-2 border-gray-100 space-y-2">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">💵 Efectivo:</span>
                        <span class="font-bold text-blue-700" id="metodo-efectivo">$0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">💳 Tarjeta:</span>
                        <span class="font-bold text-blue-700" id="metodo-tarjeta">$0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600">🏦 Transferencia:</span>
                        <span class="font-bold text-blue-700" id="metodo-transferencia">$0.00</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- FILTROS ADICIONALES -->
        <div class="bg-white rounded-2xl shadow-xl p-4 mb-6 border-2 border-gray-200">
            <div class="flex flex-wrap items-center gap-3">
                <span class="font-black text-gray-700 uppercase text-sm">Filtrar por:</span>

                <select id="filtro-tipo" onchange="aplicarFiltros()"
                        class="px-4 py-2 border-2 border-gray-300 rounded-lg font-semibold text-sm focus:ring-2 focus:ring-blue-600">
                    <option value="">Todos los movimientos</option>
                    <option value="ingreso">Solo Ingresos</option>
                    <option value="egreso">Solo Egresos</option>
                </select>

                <select id="filtro-categoria" onchange="aplicarFiltros()"
                        class="px-4 py-2 border-2 border-gray-300 rounded-lg font-semibold text-sm focus:ring-2 focus:ring-blue-600">
                    <option value="">Todas las categorías</option>
                    <optgroup label="Ingresos">
                        <option value="membresia">💪 Membresías</option>
                        <option value="producto">🛒 Productos</option>
                        <option value="abono_deuda">💵 Abonos</option>
                    </optgroup>
                    <optgroup label="Egresos">
                        <option value="salario">👤 Salarios</option>
                        <option value="compra_producto">📦 Compras</option>
                        <option value="servicio">🔧 Servicios</option>
                        <option value="mantenimiento">🛠️ Mantenimiento</option>
                        <option value="renta">🏢 Renta</option>
                    </optgroup>
                </select>

                <select id="filtro-metodo" onchange="aplicarFiltros()"
                        class="px-4 py-2 border-2 border-gray-300 rounded-lg font-semibold text-sm focus:ring-2 focus:ring-blue-600">
                    <option value="">Todos los métodos</option>
                    <option value="efectivo">💵 Efectivo</option>
                    <option value="tarjeta">💳 Tarjeta</option>
                    <option value="transferencia">🏦 Transferencia</option>
                    <option value="cheque">📝 Cheque</option>
                </select>

                <button onclick="limpiarFiltros()"
                        class="ml-auto px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg font-bold text-sm uppercase transition-colors">
                    <i data-lucide="x-circle" class="w-4 h-4 inline mr-1"></i>
                    Limpiar
                </button>
            </div>
        </div>

        <!-- BOTONES DE ACCIÓN -->
        <div class="flex gap-4">
            <button onclick="abrirModalIngreso()"
                    class="flex-1 px-6 py-4 bg-gradient-to-r from-emerald-600 to-emerald-800 hover:from-emerald-700 hover:to-emerald-900 text-white font-black rounded-xl shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105 transition-all">
                <i data-lucide="plus-circle" class="w-5 h-5 inline-block mr-2"></i>
                Registrar Ingreso
            </button>
            <button onclick="abrirModalEgreso()"
                    class="flex-1 px-6 py-4 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105 transition-all">
                <i data-lucide="minus-circle" class="w-5 h-5 inline-block mr-2"></i>
                Registrar Egreso
            </button>
        </div>

        <!-- TABLA DE MOVIMIENTOS -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
            <div class="px-6 py-4 border-b-2 border-gray-200 bg-gradient-to-r from-gray-900 to-black">
                <h3 class="text-xl font-black text-white uppercase tracking-wide">Movimientos de Caja</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b-2 border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Fecha</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Tipo</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Categoría</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Descripción</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Método</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-600 uppercase">Monto</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase">Usuario</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-movimientos" class="bg-white divide-y-2 divide-gray-200">
                        <tr>
                            <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                                Cargando movimientos...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- CONTENEDOR DE MODALES -->
<div id="modal-container"></div>

@section Scripts {
    <script src="/home/claude/script_caja_fixed.js"></script>
    <script>
        const API_BASE = '/api';

        // Inicializar fechas al cargar la página
        window.addEventListener('DOMContentLoaded', function() {
            const hoy = new Date();
            const primerDiaMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);

            document.getElementById('fecha-desde').valueAsDate = primerDiaMes;
            document.getElementById('fecha-hasta').valueAsDate = hoy;

            cargarBalance();

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });

        // Tabs
        function cambiarTab(tab) {
            document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-red-600', 'bg-red-50', 'text-red-600');
                btn.classList.add('border-transparent');
            });

            document.getElementById(`content-${tab}`).classList.remove('hidden');
            document.getElementById(`tab-${tab}`).classList.add('border-red-600', 'bg-red-50', 'text-red-600');
        }

        // Cargar balance con logs
        async function cargarBalance() {
            try {
                const desde = document.getElementById('fecha-desde').value;
                const hasta = document.getElementById('fecha-hasta').value;

                console.log('📅 Cargando balance:', { desde, hasta });

                let url = `${API_BASE}/Caja/balance`;
                const params = new URLSearchParams();
                if (desde) params.append('desde', desde);
                if (hasta) params.append('hasta', hasta);
                if (params.toString()) url += '?' + params.toString();

                console.log('🔗 URL:', url);

                const response = await fetch(url);
                const result = await response.json();

                console.log('📊 Respuesta balance:', result);

                if (result.success) {
                    document.getElementById('total-ingresos').textContent = `$${result.ingresos.toFixed(2)}`;
                    document.getElementById('total-egresos').textContent = `$${result.egresos.toFixed(2)}`;
                    document.getElementById('balance-total').textContent = `$${result.balance.toFixed(2)}`;

                    const balanceEl = document.getElementById('balance-total');
                    balanceEl.className = result.balance >= 0
                        ? 'text-4xl font-black text-blue-600'
                        : 'text-4xl font-black text-red-600';

                    actualizarDesgloseIngresos(result.ingresosPorCategoria || []);
                    actualizarDesgloseEgresos(result.egresosPorCategoria || []);

                    await cargarMovimientos();
                } else {
                    console.error('❌ Error en respuesta:', result.message);
                }
            } catch (error) {
                console.error('❌ Error al cargar balance:', error);
                alert('Error al cargar balance de caja');
            }
        }

        function actualizarDesgloseIngresos(ingresosPorCategoria) {
            const categorias = { 'membresia': 0, 'producto': 0, 'abono_deuda': 0, 'otro': 0 };
            ingresosPorCategoria.forEach(item => {
                if (categorias.hasOwnProperty(item.categoria)) {
                    categorias[item.categoria] = item.total;
                } else {
                    categorias['otro'] += item.total;
                }
            });
            document.getElementById('ingreso-membresia').textContent = `$${categorias.membresia.toFixed(2)}`;
            document.getElementById('ingreso-producto').textContent = `$${categorias.producto.toFixed(2)}`;
            document.getElementById('ingreso-abono').textContent = `$${categorias.abono_deuda.toFixed(2)}`;
            document.getElementById('ingreso-otro').textContent = `$${categorias.otro.toFixed(2)}`;
        }

        function actualizarDesgloseEgresos(egresosPorCategoria) {
            const categorias = { 'salario': 0, 'compra_producto': 0, 'servicio': 0, 'mantenimiento': 0, 'renta': 0, 'otro': 0 };
            egresosPorCategoria.forEach(item => {
                if (categorias.hasOwnProperty(item.categoria)) {
                    categorias[item.categoria] = item.total;
                } else {
                    categorias['otro'] += item.total;
                }
            });
            document.getElementById('egreso-salario').textContent = `$${categorias.salario.toFixed(2)}`;
            document.getElementById('egreso-compra').textContent = `$${categorias.compra_producto.toFixed(2)}`;
            document.getElementById('egreso-servicio').textContent = `$${categorias.servicio.toFixed(2)}`;
            const otrosTotal = categorias.mantenimiento + categorias.renta + categorias.otro;
            document.getElementById('egreso-otro').textContent = `$${otrosTotal.toFixed(2)}`;
        }

        async function cargarMovimientos() {
            try {
                const desde = document.getElementById('fecha-desde').value;
                const hasta = document.getElementById('fecha-hasta').value;
                const tipo = document.getElementById('filtro-tipo')?.value || '';
                const categoria = document.getElementById('filtro-categoria')?.value || '';
                const metodoPago = document.getElementById('filtro-metodo')?.value || '';

                console.log('📋 Cargando movimientos:', { desde, hasta, tipo, categoria, metodoPago });

                let url = `${API_BASE}/Caja/movimientos`;
                const params = new URLSearchParams();
                if (desde) params.append('desde', desde);
                if (hasta) params.append('hasta', hasta);
                if (tipo) params.append('tipo', tipo);
                if (categoria) params.append('categoria', categoria);

                if (params.toString()) url += '?' + params.toString();

                console.log('🔗 URL movimientos:', url);

                const response = await fetch(url);
                const result = await response.json();

                console.log('📋 Respuesta movimientos:', result);

                if (result.success) {
                    let movimientos = result.data || [];
                    if (metodoPago) {
                        movimientos = movimientos.filter(m => m.metodoPago === metodoPago);
                    }

                    console.log(`✅ ${movimientos.length} movimientos encontrados`);
                    mostrarMovimientos(movimientos);
                    calcularMetodosPago(movimientos);
                } else {
                    console.error('❌ Error en respuesta movimientos:', result.message);
                }
            } catch (error) {
                console.error('❌ Error al cargar movimientos:', error);
                alert('Error al cargar movimientos');
            }
        }

        function mostrarMovimientos(movimientos) {
            const tbody = document.getElementById('tabla-movimientos');

            if (!movimientos || movimientos.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="px-6 py-8 text-center text-gray-500">No hay movimientos en el período seleccionado</td></tr>`;
                return;
            }

            tbody.innerHTML = movimientos.map(m => {
                const fecha = new Date(m.fecha);
                const colorTipo = m.tipo === 'ingreso' ? 'text-emerald-600' : 'text-red-600';
                const iconoCategoria = obtenerIconoCategoria(m.categoria);
                const nombreCategoria = formatearCategoria(m.categoria);

                return `
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">${fecha.toLocaleDateString('es-ES')}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-3 py-1 rounded-full text-xs font-black uppercase ${m.tipo === 'ingreso' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}">${m.tipo}</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-700">${iconoCategoria} ${nombreCategoria}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">${m.descripcion}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-700">${formatearMetodoPago(m.metodoPago)}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-black ${colorTipo}">${m.tipo === 'ingreso' ? '+' : '-'}$${m.monto.toFixed(2)}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-700">${m.usuario || 'Sistema'}</td>
                    </tr>
                `;
            }).join('');
        }

        function obtenerIconoCategoria(categoria) {
            const iconos = { 'membresia': '💪', 'producto': '🛒', 'abono_deuda': '💵', 'salario': '👤', 'compra_producto': '📦', 'servicio': '🔧', 'mantenimiento': '🛠️', 'renta': '🏢', 'otro': '📝' };
            return iconos[categoria] || '📄';
        }

        function formatearCategoria(categoria) {
            const nombres = { 'membresia': 'Membresía', 'producto': 'Producto', 'abono_deuda': 'Abono Deuda', 'salario': 'Salario', 'compra_producto': 'Compra', 'servicio': 'Servicio', 'mantenimiento': 'Mantenimiento', 'renta': 'Renta', 'otro': 'Otro' };
            return nombres[categoria] || categoria;
        }

        function formatearMetodoPago(metodo) {
            const iconos = { 'efectivo': '💵 Efectivo', 'tarjeta': '💳 Tarjeta', 'transferencia': '🏦 Transferencia', 'cheque': '📝 Cheque' };
            return iconos[metodo] || metodo;
        }

        function calcularMetodosPago(movimientos) {
            const metodos = { 'efectivo': 0, 'tarjeta': 0, 'transferencia': 0, 'cheque': 0 };
            movimientos.forEach(m => {
                if (m.tipo === 'ingreso' && metodos.hasOwnProperty(m.metodoPago)) {
                    metodos[m.metodoPago] += m.monto;
                }
            });
            document.getElementById('metodo-efectivo').textContent = `$${metodos.efectivo.toFixed(2)}`;
            document.getElementById('metodo-tarjeta').textContent = `$${metodos.tarjeta.toFixed(2)}`;
            document.getElementById('metodo-transferencia').textContent = `$${metodos.transferencia.toFixed(2)}`;
        }

        function aplicarFiltros() {
            cargarMovimientos();
        }

        function limpiarFiltros() {
            if (document.getElementById('filtro-tipo')) document.getElementById('filtro-tipo').value = '';
            if (document.getElementById('filtro-categoria')) document.getElementById('filtro-categoria').value = '';
            if (document.getElementById('filtro-metodo')) document.getElementById('filtro-metodo').value = '';
            cargarMovimientos();
        }

        // MODAL INGRESO
        function abrirModalIngreso() {
            const modalHTML = `
                <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
                    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
                        <div class="sticky top-0 bg-gradient-to-r from-emerald-600 to-emerald-800 px-6 py-5 rounded-t-2xl border-b-4 border-emerald-900">
                            <div class="flex items-center justify-between">
                                <h3 class="text-2xl font-black text-white uppercase tracking-wide">
                                    <i data-lucide="plus-circle" class="w-6 h-6 inline mr-2"></i>
                                    Registrar Ingreso
                                </h3>
                                <button onclick="cerrarModalIngreso()" class="text-white hover:text-emerald-100 transition-colors">
                                    <i data-lucide="x" class="w-7 h-7"></i>
                                </button>
                            </div>
                        </div>
                        <form id="formIngreso" class="p-6 space-y-5">
                            <div>
                                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Tipo de Ingreso *</label>
                                <select id="categoriaIngreso" required class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 font-semibold">
                                    <option value="">-- Seleccionar --</option>
                                    <option value="membresia">💪 Membresía</option>
                                    <option value="producto">🛒 Venta de Producto</option>
                                    <option value="abono_deuda">💵 Abono a Deuda</option>

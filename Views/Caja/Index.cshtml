        function cerrarModalCerrarCaja() {
            const m=document.getElementById('modal-cerrar-caja');
            if(m){m.classList.add('hidden'); const o=document.getElementById('cierre-observaciones');if(o)o.value='';}
        }
        function resetearValoresCaja() {
            ['efectivo-hoy','transferencias-hoy','ingresos-hoy','egresos-hoy','balance-total','deudas-pendientes','venta-membresias','venta-productos','venta-abonos','venta-otros'].forEach(id=>{const el=document.getElementById(id);if(el)el.textContent='$0.00';});
        }
        async function confirmarCierreCaja() {
            const obs=document.getElementById('cierre-observaciones')?.value||'';
            if(!confirm('¿Estás seguro de cerrar la caja? Esta acción registrará el cierre del día.')) return;
            try {
                const r=await fetch(`${API_URL}/Caja/cerrar`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({Fecha:obtenerFechaLocalISO(),observaciones:obs,tipoCierre:'manual'})});
                const data=await r.json();
                if(data.success){cerrarModalCerrarCaja();alert('✅ Caja cerrada exitosamente');resetearValoresCaja();await cargarResumen();await cargarMovimientos();}
                else alert('❌ Error al cerrar caja: '+(data.message||'Error desconocido'));
            } catch(e){alert('❌ Error al cerrar la caja. Intenta nuevamente.');}
        }

        async function registrarIngreso(event) {
            event.preventDefault();
            const monto=parseFloat(document.getElementById('ingreso-monto').value);
            const cat=document.getElementById('ingreso-categoria').value;
            const metodo=document.getElementById('ingreso-metodo').value;
            const desc=document.getElementById('ingreso-descripcion').value;
            try {
                const r=await fetch(`${API_URL}/Caja/ingreso`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({categoria:cat,monto,descripcion:desc,metodoPago:metodo})});
                const res=await r.json();
                if(res.success){alert('✅ Ingreso registrado exitosamente');event.target.reset();cargarResumen();cambiarTab('movimientos');}
                else alert(`❌ Error: ${res.message}`);
            } catch(e){alert('❌ Error al registrar ingreso');}
        }

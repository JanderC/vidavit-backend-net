                async function confirmarCierreCaja() {
            try {
                const observaciones = document.getElementById('observaciones-cierre')?.value || '';

                // Confirmar antes de cerrar
                if (!confirm('¿Estás seguro de cerrar la caja? Esta acción registrará el cierre del día.')) {
                    return;
                }

                // Mostrar loading
                const btnConfirmar = document.getElementById('btn-confirmar-cierre');
                if (btnConfirmar) {
                    btnConfirmar.disabled = true;
                    btnConfirmar.innerHTML = '<i data-lucide="loader" class="w-5 h-5 animate-spin"></i> Cerrando...';
                    lucide.createIcons();
                }

                // Realizar el cierre
                const response = await fetch(`${API_URL}/Caja/cerrar`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        Fecha: obtenerFechaLocalISO(),
                        observaciones: observaciones,
                        tipoCierre: 'manual'
                    })
                });

                const data = await response.json();

                if (data.success) {
                    // Cerrar modal
                    cerrarModalCerrarCaja();

                    // Mostrar mensaje de éxito
                    alert('✅ Caja cerrada exitosamente');

                    // Resetear valores
                    resetearValoresCaja();

                    // Recargar datos
                    await cargarResumen();
                    await cargarMovimientos();
                    await cargarResumenSemanal();
                    await cargarHistorialCierres();

                } else {
                    alert('❌ Error al cerrar caja: ' + (data.message || 'Error desconocido'));
                }

            } catch (error) {
                console.error('Error al confirmar cierre:', error);
                alert('❌ Error al cerrar la caja. Por favor intenta nuevamente.');
            } finally {
                // Restaurar botón
                const btnConfirmar = document.getElementById('btn-confirmar-cierre');
                if (btnConfirmar) {
                    btnConfirmar.disabled = false;
                    btnConfirmar.innerHTML = '<i data-lucide="check" class="w-5 h-5"></i> Confirmar Cierre';
                    lucide.createIcons();
                }
            }
        }


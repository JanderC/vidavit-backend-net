                                    </div>
                                    ${tipoBadge}
                                </div>
                                <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-4">
                                    <div class="bg-emerald-50 rounded-xl p-3">
                                        <p class="text-xs text-emerald-700 font-bold mb-1">Efectivo Final</p>
                                        <p class="text-lg font-black text-emerald-600">$${(cierre.EfectivoFinal || 0).toFixed(2)}</p>
                                    </div>
                                    <div class="bg-blue-50 rounded-xl p-3">
                                        <p class="text-xs text-blue-700 font-bold mb-1">Ingresos</p>

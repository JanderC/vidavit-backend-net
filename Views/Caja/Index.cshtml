                                async function abrirModalCerrarCaja() {
            try {
                // Cargar datos actuales de la caja
                const response = await fetch(`${API_URL}/Caja/dashboard`);
                const data = await response.json();

                if (data.success && data.cajaHoy) {
                    // ACTUALIZAR VALORES DEL MODAL DE CIERRE

                    // Efectivo Final
                    const efectivoFinal = document.getElementById('cierre-efectivo-final');
                    if (efectivoFinal) {
                        efectivoFinal.textContent = `$${(data.cajaHoy.efectivo.balance || 0).toFixed(2)}`;
                    }

                    // Transferencias
                    const transferencias = document.getElementById('cierre-transferencias');
                    if (transferencias) {
                        transferencias.textContent = `$${(data.cajaHoy.transferencia.balance || 0).toFixed(2)}`;
                    }

                    // Ingresos Hoy
                    const ingresos = document.getElementById('cierre-ingresos');
                    if (ingresos) {
                        ingresos.textContent = `$${(data.cajaHoy.totalIngresos || 0).toFixed(2)}`;
                    }

                    // Egresos Hoy
                    const egresos = document.getElementById('cierre-egresos');
                    if (egresos) {
                        egresos.textContent = `$${(data.cajaHoy.totalEgresos || 0).toFixed(2)}`;
                    }

                    // Balance General
                    const balance = document.getElementById('cierre-balance');
                    if (balance) {
                        balance.textContent = `$${(data.cajaHoy.balance || 0).toFixed(2)}`;
                    }

                    // PRODUCTOS - Usar datos reales del backend
                    const productosEfectivo = data.cajaHoy.categorias.productosEfectivo || 0;
                    const productosTransferencia = data.cajaHoy.categorias.productosTransferencia || 0;
                    const productosTotal = data.cajaHoy.categorias.productos || 0;

                    // Productos Efectivo
                    const productosEfectivoEl = document.getElementById('cierre-productos-efectivo');
                    if (productosEfectivoEl) {
                        productosEfectivoEl.textContent = `$${productosEfectivo.toFixed(2)}`;
                    }

                    // Productos Transferencia
                    const productosTransferenciaEl = document.getElementById('cierre-productos-transferencia');
                    if (productosTransferenciaEl) {
                        productosTransferenciaEl.textContent = `$${productosTransferencia.toFixed(2)}`;
                    }

                    // Total Productos
                    const productosTotalEl = document.getElementById('cierre-productos-total');
                    if (productosTotalEl) {
                        productosTotalEl.textContent = `$${productosTotal.toFixed(2)}`;
                    }

                    // MOSTRAR EL MODAL
                    const modal = document.getElementById('modal-cerrar-caja');
                    if (modal) {
                        modal.style.display = "flex";
                        modal.classList.remove('hidden');
                        lucide.createIcons(); // Actualizar iconos
                    } else {
                        console.error('Modal no encontrado en el DOM');
                    }

                } else {
                    console.error('Error en la respuesta del API:', data.message || 'Respuesta inválida');
                    alert('Error al cargar los datos de la caja');
                }

            } catch (error) {
                console.error('Error al abrir modal de cierre:', error);
                alert('Error al cargar los datos. Por favor intenta nuevamente.');
            }
        }
                function cerrarModalCerrarCaja() {

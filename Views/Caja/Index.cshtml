                                </p>
                                <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;font-size:.78rem;color:var(--pf-soft);font-weight:600;">
                                    <span>Total: <strong style="color:var(--pf-text);">$${total.toFixed(2)}</strong></span>
                                    <span>Pagado: <strong style="color:var(--pf-green);">$${pagado.toFixed(2)}</strong></span>
                                    <span>Saldo: <strong style="color:var(--pf-red);font-size:.9rem;">$${s.toFixed(2)}</strong></span>
                                </div>
                                <div class="pf-progress-bar"><div class="pf-progress-fill" style="width:${pct.toFixed(1)}%;background:${pct>=100?'var(--pf-green)':'var(--pf-red)'};"></div></div>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:.35rem;flex-shrink:0;">
                                <button onclick="abrirModalAbonar('${id}')" style="padding:.45rem .875rem;background:linear-gradient(135deg,var(--pf-green),#065F46);color:#fff;border:none;border-radius:.625rem;font-weight:800;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:.3rem;">
                                    <i data-lucide="dollar-sign" style="width:13px;height:13px;"></i>Abonar
                                </button>
                                <button onclick="pagarCompleto('${id}')" style="padding:.45rem .875rem;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;border:none;border-radius:.625rem;font-weight:800;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:.3rem;">

        // ── DEUDAS ─────────────────────────────────────────
        let deudasData=[],deudaSeleccionada=null,_filtroEstadoDeuda='',_busquedaDeuda='',_debounceDeuda=null;
        function calcularEstadoRealDeuda(d){if(d.Estado==='pagada'||d.Estado==='cancelada')return d.Estado;return d.Estado||'pendiente';}
        async function cargarDeudas() {
            try {
                const r=await fetch(`${API_URL}/Deudas?incluirPagadas=false&porPagina=500`),data=await r.json();
                if(!data.success){document.getElementById('lista-deudas').innerHTML='<div style="text-align:center;padding:3rem;color:var(--pf-red);font-weight:700;">Error al cargar deudas</div>';return;}
                deudasData=(data.items||data.data||[]).map(d=>{d._estadoReal=calcularEstadoRealDeuda(d);return d;});
                actualizarResumenDeudas();renderDeudas(deudasData);lucide.createIcons();
            } catch(e){console.error('Error:',e);}
        }
        function actualizarResumenDeudas(){
            const pend=deudasData.filter(d=>d._estadoReal==='pendiente');
            const saldo=pend.reduce((s,d)=>s+(d.Saldo||0),0);
            const set=(id,v)=>{const el=document.getElementById(id);if(el)el.textContent=v;};
            set('rv-deuda-total',`$${saldo.toFixed(2)}`);set('rs-deuda-total',`${pend.length} deudas`);
            set('rv-deuda-pendiente',`$${saldo.toFixed(2)}`);set('rs-deuda-pendiente',`${pend.length} ${pend.length===1?'deuda':'deudas'}`);
            const dpEl=document.getElementById('deudas-pendientes');if(dpEl)dpEl.textContent=`$${saldo.toFixed(2)}`;
        }
        function filtroEstadoDeuda(estado){
            _filtroEstadoDeuda=estado;
            document.querySelectorAll('.ftd-btn').forEach(b=>{b.style.background='transparent';b.style.color='var(--pf-muted)';});
            const mapTab={'':'ft-d-todos','pendiente':'ft-d-pendiente'};
            if(mapTab[estado]){const el=document.getElementById(mapTab[estado]);if(el){el.style.background='var(--pf-blue)';el.style.color='#fff';}}
            renderDeudas(deudasData);
        }
        function debounceBusquedaDeuda(val){_busquedaDeuda=val;clearTimeout(_debounceDeuda);_debounceDeuda=setTimeout(()=>renderDeudas(deudasData),300);}
        function filtrarDeudas(){_busquedaDeuda=(document.getElementById('buscar-deuda')||{}).value||'';renderDeudas(deudasData);}
        function chipEstadoDeuda(estado){
            if(estado==='pagada') return '<span class="chip chip-green">✓ Pagada</span>';
            if(estado==='cancelada') return '<span class="chip chip-gray">Cancelada</span>';
            return '<span class="chip chip-amber">Pendiente</span>';
        }
        function renderDeudas(deudas) {
            const cont=document.getElementById('lista-deudas');
            let filtradas=deudas;
            if(_filtroEstadoDeuda) filtradas=deudas.filter(d=>d._estadoReal===_filtroEstadoDeuda);
            if(_busquedaDeuda.trim()){const q=_busquedaDeuda.toLowerCase();filtradas=filtradas.filter(d=>(d.clienteNombre||d.cliente?.nombre||'').toLowerCase().includes(q)||(d.clienteCedula||d.cliente?.cedula||'').toLowerCase().includes(q)||(d.Concepto||d.concepto||'').toLowerCase().includes(q));}
            if(filtradas.length===0){cont.innerHTML=`<div style="text-align:center;padding:3rem;background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;color:var(--pf-muted);">
                <i data-lucide="inbox" style="width:48px;height:48px;display:block;margin:0 auto 1rem;"></i><p style="font-weight:700;margin:0;">Sin resultados</p></div>`;lucide.createIcons();return;}
            const grupos=new Map();
            filtradas.forEach(d=>{const cid=d.cliente?.Id||d.cliente?.id||d.ClienteId||d.clienteId||'sin-cliente',nombre=d.clienteNombre||d.cliente?.nombre||'—',cedula=d.clienteCedula||d.cliente?.cedula||'—';if(!grupos.has(cid))grupos.set(cid,{cid,nombre,cedula,deudas:[]});grupos.get(cid).deudas.push(d);});
            cont.innerHTML=[...grupos.values()].map(({cid,nombre,cedula,deudas:dc})=>{
                const saldo=dc.reduce((s,d)=>s+(d.Saldo||d.saldo||0),0);
                const iniciales=nombre.split(' ').filter(Boolean).map(n=>n[0]).join('').substring(0,2).toUpperCase()||'?';
                const filas=dc.map(deuda=>{
                    const concepto=deuda.Concepto||deuda.concepto||'—',total=deuda.MontoTotal||deuda.montoTotal||0,pagado=deuda.MontoPagado||deuda.montoPagado||0,s=deuda.Saldo||deuda.saldo||0,id=deuda.Id||deuda.id,estado=deuda._estadoReal;
                    const pct=total>0?Math.min(100,(pagado/total)*100):0;
                    const fechaStr=(deuda.FechaCreacion||deuda.fechaCreacion)?formatearFechaUTC(deuda.FechaCreacion||deuda.fechaCreacion):'—';
                    return `<div class="deuda-item">

@section Scripts {
    <script>
        const API_URL = '/api';
        let fechaDiaCerrar = null;

        // ========================================
        // FUNCIÓN HELPER PARA FECHAS
        // ========================================
        /**
         * Convierte una fecha UTC del servidor y la muestra como está (sin convertir a zona horaria local)
         * Esto muestra la hora real que tiene la fecha en UTC
         */
        function parsearFechaUTC(fechaString) {
            const fecha = new Date(fechaString);
            return fecha;
        }

        /**
         * Formatea una fecha UTC mostrando la hora UTC (no la convierte a local)
         * Ejemplo: "2026-02-06T11:19:11.703466Z" -> "6/2/2026 11:19"
         */
        function formatearFechaHoraUTC(fechaString) {
            const fecha = new Date(fechaString);

            // Obtener componentes UTC directamente
            const dia = fecha.getUTCDate();
            const mes = fecha.getUTCMonth() + 1;
            const anio = fecha.getUTCFullYear();
            const horas = String(fecha.getUTCHours()).padStart(2, '0');
            const minutos = String(fecha.getUTCMinutes()).padStart(2, '0');

            // Formatear como "DD/MM/YYYY HH:MM"
            return `${dia}/${mes}/${anio} ${horas}:${minutos}`;
        }

        /**
         * Formatea solo la fecha UTC (sin hora)
         */
        function formatearFechaUTC(fechaString) {
            const fecha = new Date(fechaString);
            const dia = fecha.getUTCDate();
            const mes = fecha.getUTCMonth() + 1;
            const anio = fecha.getUTCFullYear();
            return `${dia}/${mes}/${anio}`;
        }

        /**
         * Formatea fecha UTC con formato largo
         * Ejemplo: "miércoles, 6 de febrero de 2026"
         */
        function formatearFechaLargaUTC(fechaString) {
            const fecha = new Date(fechaString);
            // Crear fecha local con los valores UTC para formatear correctamente
            const fechaUTC = new Date(fecha.getUTCFullYear(), fecha.getUTCMonth(), fecha.getUTCDate());
            return fechaUTC.toLocaleDateString('es-ES', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
        }
        function obtenerFechaLocalISO() {
            const hoy = new Date();
            const year = hoy.getFullYear();
            const month = String(hoy.getMonth() + 1).padStart(2, '0');
            const day = String(hoy.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function cambiarTab(tab) {
            // Ocultar todos los contenidos
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.add('hidden');
            });

            // Quitar estilos activos de todos los tabs
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-b-4', 'border-red-600', 'bg-red-50', 'text-red-600');
            });

            // Mostrar contenido seleccionado
            document.getElementById(`content-${tab}`).classList.remove('hidden');

            // Activar tab seleccionado
            const activeTab = document.getElementById(`tab-${tab}`);
            activeTab.classList.add('border-b-4', 'border-red-600', 'bg-red-50', 'text-red-600');

            // Cargar datos específicos del tab
            if (tab === 'semanal') {
                cargarResumenSemanal();
            } else if (tab === 'cierres') {
                cargarHistorialCierres();
            } else if (tab === 'deudas') {
                cargarDeudas();
            } else if (tab === 'pendientes') {
                cargarDiasPendientes();
            }

            lucide.createIcons();
        }

        // ========================================
        // CARGAR RESUMEN PRINCIPAL
        // ========================================
                async function cargarResumen() {
            try {
                const response = await fetch(`${API_URL}/Caja/dashboard`);
                const data = await response.json();

                if (data.success) {
                    // ========================================
                    // FUNCIÓN AUXILIAR PARA ACTUALIZAR ELEMENTOS DE FORMA SEGURA
                    // ========================================
                    const actualizarElemento = (id, valor) => {
                        const elemento = document.getElementById(id);
                        if (elemento) {
                            elemento.textContent = `$${(valor || 0).toFixed(2)}`;
                        } else {
                            console.warn(`⚠️ Elemento no encontrado en el DOM: ${id}`);
                        }
                    };

                    // ========================================
                    // ACTUALIZAR TARJETAS PRINCIPALES
                    // ========================================
                    actualizarElemento('efectivo-hoy', data.cajaHoy.efectivo.balance);
                    actualizarElemento('transferencias-hoy', data.cajaHoy.transferencia.balance);
                    actualizarElemento('ingresos-hoy', data.cajaHoy.totalIngresos);
                    actualizarElemento('egresos-hoy', data.cajaHoy.totalEgresos);
                    actualizarElemento('balance-total', data.cajaHoy.balance);

                    // ========================================
                    // ACTUALIZAR DESGLOSE DE VENTAS (SI EXISTEN LOS ELEMENTOS)
                    // ========================================
                    actualizarElemento('venta-membresias', data.cajaHoy.categorias.membresias);
                    actualizarElemento('venta-productos', data.cajaHoy.categorias.productos);
                    actualizarElemento('venta-abonos', data.cajaHoy.categorias.abonos);
                    actualizarElemento('venta-otros', data.cajaHoy.categorias.otros);

                    // Tarjeta "Productos Vendidos" (usa el mismo valor que venta-productos)
                    actualizarElemento('productos-vendidos', data.cajaHoy.categorias.productos);

                    // ========================================
                    // ACTUALIZAR DETALLES (CON VALIDACIÓN)
                    // ========================================
                    const detalleIngresos = document.getElementById('detalle-ingresos');
                    if (detalleIngresos) {
                        const efectivoIng = data.cajaHoy.efectivo.ingresos || 0;
                        const transfIng = data.cajaHoy.transferencia.ingresos || 0;
                        detalleIngresos.textContent =
                            `Efectivo: $${efectivoIng.toFixed(2)} | Transf: $${transfIng.toFixed(2)}`;
                    }

                    const detalleEgresos = document.getElementById('detalle-egresos');
                    if (detalleEgresos) {
                        const efectivoEgr = data.cajaHoy.efectivo.egresos || 0;
                        const transfEgr = data.cajaHoy.transferencia.egresos || 0;
                        detalleEgresos.textContent =
                            `Efectivo: $${efectivoEgr.toFixed(2)} | Transf: $${transfEgr.toFixed(2)}`;
                    }

                    const detalleTransf = document.getElementById('detalle-transferencias');
                    if (detalleTransf) {
                        detalleTransf.textContent = 'Balance en transf.';
                    }
                } else {
                    console.error('Error en la respuesta del API:', data.message);
                }

                // ========================================
                // CARGAR DEUDAS PENDIENTES (OPCIONAL - NO CRÍTICO)
                // ========================================
                try {
                    const responseDeudas = await fetch(`${API_URL}/Deudas?estado=pendiente`);
                    const deudasData = await responseDeudas.json();

                    if (deudasData.success) {
                        const deudasElement = document.getElementById('deudas-pendientes');
                        if (deudasElement) {
                            const saldoPendiente = deudasData.totalSaldoPendiente || 0;
                            deudasElement.textContent = `$${saldoPendiente.toFixed(2)}`;
                        }
                    }
                } catch (errorDeudas) {
                    console.warn('⚠️ Error al cargar deudas (no crítico):', errorDeudas);
                    // No detener la ejecución si falla la carga de deudas
                }

                // MOSTRAR ALERTA SI HAY DÍAS PENDIENTES
                if (data.alertas && data.alertas.tieneMovimientosPendientesAnteriores) {
                    const alerta = document.getElementById('alerta-dias-pendientes');
                    const cantidad = document.getElementById('cantidad-dias-pendientes');
                    if (alerta && cantidad) {
                        cantidad.textContent = data.alertas.movimientosPendientesAnteriores;
                        alerta.classList.remove('hidden');
                    }
                } else {
                    const alerta = document.getElementById('alerta-dias-pendientes');
                    if (alerta) {
                        alerta.classList.add('hidden');
                    }
                }

            } catch (error) {
                console.error('❌ Error al cargar resumen de caja:', error);

                // Mostrar error en consola pero no romper la aplicación
                console.error('Detalles del error:', {
                    mensaje: error.message,
                    stack: error.stack
                });
            }
        }
        // ========================================
        // CARGAR MOVIMIENTOS
        // ========================================
        async function cargarMovimientos() {
            try {
                const desde = document.getElementById('fecha-desde').value;
                const hasta = document.getElementById('fecha-hasta').value;
                const categoria = document.getElementById('filtro-categoria').value;

                let url = `${API_URL}/Caja/movimientos?`;
                if (desde) url += `desde=${desde}&`;
                if (hasta) url += `hasta=${hasta}&`;
                if (categoria) url += `categoria=${categoria}&`;

                const response = await fetch(url);
                const data = await response.json();

                const tbody = document.getElementById('tabla-movimientos');

                if (data.success && data.data && data.data.length > 0) {
                    tbody.innerHTML = data.data.map(m => {
                        const tipoColor = m.Tipo === 'ingreso' ? 'text-green-600' : 'text-red-600';
                        const metodoBadge = m.MetodoPago === 'efectivo'
                            ? '<span class="px-2 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded">Efectivo</span>'
                            : '<span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs font-bold rounded">Transferencia</span>';

                        return `
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm font-semibold text-gray-900">
                                    ${formatearFechaHoraUTC(m.Fecha)}
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 ${tipoColor} bg-opacity-10 rounded-full text-xs font-black uppercase">${m.Tipo}</span>
                                </td>
                                <td class="px-6 py-4 text-sm font-semibold text-gray-700">${m.Categoria}</td>
                                <td class="px-6 py-4 text-sm font-semibold text-gray-600">${m.Descripcion}</td>
                                <td class="px-6 py-4">${metodoBadge}</td>
                                <td class="px-6 py-4 text-right text-lg font-black ${tipoColor}">$${m.Monto.toFixed(2)}</td>
                            </tr>
                        `;
                    }).join('');
                } else {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-gray-500 font-bold">
                                No hay movimientos para mostrar
                            </td>
                        </tr>
                    `;
                }
            } catch (error) {
                console.error('Error al cargar movimientos:', error);
                const tbody = document.getElementById('tabla-movimientos');
                if (tbody) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-red-500 font-bold">
                                Error al cargar movimientos
                            </td>
                        </tr>
                    `;
                }
            }
        }

        // ========================================
        // RESUMEN SEMANAL
        // ========================================
                async function cargarResumenSemanal() {
            try {
                const response = await fetch(`${API_URL}/Caja/semanal`);

                // Verificar si la respuesta es válida
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const text = await response.text();
                if (!text) {
                    throw new Error('Respuesta vacía del servidor');
                }

                const data = JSON.parse(text);

                if (data.success && data.periodo && data.totales) {
                    // ========================================
                    // ACTUALIZAR PERÍODO
                    // ========================================
                    const periodoElement = document.getElementById('periodo-semanal');
                    if (periodoElement) {
                        periodoElement.textContent =
                            `Semana del ${formatearFechaUTC(data.periodo.desde)} al ${formatearFechaUTC(data.periodo.hasta)}`;
                    }

                    // ========================================
                    // ACTUALIZAR TOTALES CON VALIDACIÓN
                    // ========================================
                    const totalesElementos = {
                        'total-ingresos-semana': data.totales.ingresos,
                        'total-egresos-semana': data.totales.egresos,
                        'balance-semana': data.totales.balance,
                        'total-productos-semana': data.totales.productosVendidos, // ✅ NUEVO
                        'cantidad-movimientos-semana': data.totales.cantidadMovimientos
                    };

                    for (const [id, valor] of Object.entries(totalesElementos)) {
                        const elemento = document.getElementById(id);
                        if (elemento) {
                            if (id === 'cantidad-movimientos-semana') {
                                elemento.textContent = valor || 0;
                            } else {
                                elemento.textContent = `$${(valor || 0).toFixed(2)}`;
                            }
                        }
                    }

                    // ========================================
                    // ACTUALIZAR TABLA POR DÍA (CON PRODUCTOS)
                    // ========================================
                    const tbody = document.getElementById('tabla-resumen-semanal');
                    if (tbody && data.resumenPorDia && data.resumenPorDia.length > 0) {
                        tbody.innerHTML = data.resumenPorDia.map(dia => {
                            const balanceColor = (dia.balance || 0) >= 0 ? 'text-emerald-600' : 'text-red-600';
                            return `
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4 text-sm font-black text-gray-900 uppercase">${dia.diaNombre || ''}</td>

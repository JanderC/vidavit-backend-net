                                    <td class="px-6 py-4 text-right text-lg font-black text-blue-600">$${(dia.ingresos || 0).toFixed(2)}</td>
                                    <td class="px-6 py-4 text-right text-lg font-black text-red-600">$${(dia.egresos || 0).toFixed(2)}</td>
                                    <td class="px-6 py-4 text-right text-lg font-black ${balanceColor}">$${(dia.balance || 0).toFixed(2)}</td>
                                    <td class="px-6 py-4 text-right text-sm font-semibold text-white">$${(dia.ingresosEfectivo || 0).toFixed(2)}</td>
                                    <td class="px-6 py-4 text-right text-sm font-semibold text-white">$${(dia.ingresosTransferencia || 0).toFixed(2)}</td>
                                    <td class="px-6 py-4 text-right text-lg font-black text-amber-600 bg-amber-50">$${(dia.productosVendidos || 0).toFixed(2)}</td>
                                    <td class="px-6 py-4 text-center">
                                        <span class="px-3 py-1 bg-blue-500/10 text-[#3D8EFF] text-xs font-bold rounded-full">${dia.cantidadMovimientos || 0}</span>
                                    </td>
                                </tr>
                            `;
                        }).join('');
                    } else {
                        // Mensaje si no hay datos
                        if (tbody) {
                            tbody.innerHTML = `
                                <tr>
                                    <td colspan="8" class="px-6 py-12 text-center text-white/40 font-bold">
                                        No hay datos disponibles para esta semana
                                    </td>
                                </tr>
                            `;
                        }
                    }
                }
            } catch (error) {
                console.error('Error al cargar resumen semanal:', error);

                // Mostrar error en la tabla
                const tbody = document.getElementById('tabla-resumen-semanal');
                if (tbody) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="8" class="px-6 py-12 text-center text-red-500 font-bold">
                                Error al cargar los datos
                            </td>
                        </tr>
                    `;
                }
            }
        }

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Caja";
    ViewData["Subtitle"] = "Control financiero completo - TAURO GYM";
}

<div class="space-y-6">
    <!-- TABS DE NAVEGACIÓN -->
    <div class="bg-white rounded-2xl shadow-xl border-2 border-gray-200 overflow-hidden">
        <div class="flex border-b-2 border-gray-200">
            <button onclick="cambiarTab('balance')" id="tab-balance"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all border-b-4 border-red-600 bg-red-50 text-red-600">
                <i data-lucide="wallet" class="w-5 h-5 inline-block mr-2"></i>
                Balance & Movimientos
            </button>
            <button onclick="cambiarTab('empleados')" id="tab-empleados"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all border-b-4 border-transparent hover:bg-gray-50">
                <i data-lucide="users-2" class="w-5 h-5 inline-block mr-2"></i>
                Empleados
            </button>
            <button onclick="cambiarTab('deudas')" id="tab-deudas"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all border-b-4 border-transparent hover:bg-gray-50">
                <i data-lucide="file-text" class="w-5 h-5 inline-block mr-2"></i>
                Deudas
            </button>
        </div>
    </div>

    <!-- CONTENIDO TAB BALANCE -->
    <div id="content-balance" class="tab-content">
        <!-- FILTROS DE FECHA -->
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
            <div class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Desde</label>
                    <input type="date" id="fecha-desde"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Hasta</label>
                    <input type="date" id="fecha-hasta"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <button onclick="cargarBalance()"
                        class="px-8 py-3 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                    <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                    Filtrar
                </button>
            </div>
        </div>

        <!-- RESUMEN DE CAJA -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-emerald-600">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Ingresos</p>
                        <p class="text-4xl font-black text-emerald-600" id="total-ingresos">$0.00</p>
                    </div>
                    <div class="w-14 h-14 bg-emerald-100 rounded-full flex items-center justify-center">
                        <i data-lucide="trending-up" class="w-7 h-7 text-emerald-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-red-600">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Egresos</p>
                        <p class="text-4xl font-black text-red-600" id="total-egresos">$0.00</p>
                    </div>
                    <div class="w-14 h-14 bg-red-100 rounded-full flex items-center justify-center">
                        <i data-lucide="trending-down" class="w-7 h-7 text-red-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-6 border-l-4 border-blue-600">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Balance</p>
                        <p class="text-4xl font-black text-blue-600" id="balance-total">$0.00</p>
                    </div>
                    <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center">
                        <i data-lucide="wallet" class="w-7 h-7 text-blue-600"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTONES DE ACCIÓN -->
        <div class="flex gap-4">
            <button onclick="abrirModalIngreso()"
                    class="flex-1 px-6 py-4 bg-gradient-to-r from-emerald-600 to-emerald-800 hover:from-emerald-700 hover:to-emerald-900 text-white font-black rounded-xl shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105 transition-all">
                <i data-lucide="plus-circle" class="w-5 h-5 inline-block mr-2"></i>
                Registrar Ingreso
            </button>
            <button onclick="abrirModalEgreso()"
                    class="flex-1 px-6 py-4 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105 transition-all">
                <i data-lucide="minus-circle" class="w-5 h-5 inline-block mr-2"></i>
                Registrar Egreso
            </button>
        </div>

        <!-- TABLA DE MOVIMIENTOS -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
            <div class="px-6 py-4 border-b-2 border-gray-200 bg-gradient-to-r from-gray-900 to-black">
                <h3 class="text-xl font-black text-white uppercase tracking-wide">Movimientos de Caja</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b-2 border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Fecha</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Tipo</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Categoría</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Descripción</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Método</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-600 uppercase">Monto</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase">Usuario</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-movimientos" class="bg-white divide-y-2 divide-gray-200">
                        <tr>
                            <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                                Cargando movimientos...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- CONTENIDO TAB EMPLEADOS -->
    <div id="content-empleados" class="tab-content hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-black text-gray-900 uppercase tracking-wide">Gestión de Empleados</h3>
                <button onclick="abrirModalEmpleado()"
                        class="px-6 py-3 bg-gradient-to-r from-red-600 to-red-800 text-white font-black rounded-xl shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105 transition-all">
                    <i data-lucide="user-plus" class="w-5 h-5 inline-block mr-2"></i>
                    Nuevo Empleado
                </button>
            </div>

            <div id="lista-empleados" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="text-center py-8 text-gray-500">
                    Cargando empleados...
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENIDO TAB DEUDAS -->
    <div id="content-deudas" class="tab-content hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-black text-gray-900 uppercase tracking-wide">Gestión de Deudas</h3>
                <button onclick="abrirModalDeuda()"
                        class="px-6 py-3 bg-gradient-to-r from-red-600 to-red-800 text-white font-black rounded-xl shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105 transition-all">
                    <i data-lucide="file-plus" class="w-5 h-5 inline-block mr-2"></i>
                    Nueva Deuda
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b-2 border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Cliente</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-600 uppercase">Concepto</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-600 uppercase">Monto Total</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-600 uppercase">Saldo</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase">Estado</th>
                            <th class="px-6 py-4 text-center text-xs font-black text-gray-600 uppercase">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-deudas" class="bg-white divide-y-2 divide-gray-200">
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                                Cargando deudas...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODALES (se implementan con JavaScript) -->
<div id="modal-container"></div>

@section Scripts {
    <script>
        // Variables globales
        let tabActual = 'balance';
        const API_BASE = '/api';

        // Inicialización
        document.addEventListener('DOMContentLoaded', function() {
            configurarFechas();

            // Verificar si hay un tab inicial desde el servidor
            const tabInicial = '@ViewData["TabInicial"]' || 'balance';
            if (tabInicial && tabInicial !== '') {
                cambiarTab(tabInicial);
            } else {
                cargarBalance();
            }

            lucide.createIcons();
        });

        function configurarFechas() {
            const hoy = new Date().toISOString().split('T')[0];
            const hace30Dias = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
            document.getElementById('fecha-desde').value = hace30Dias;
            document.getElementById('fecha-hasta').value = hoy;
        }

        // TABS
        function cambiarTab(tab) {
            tabActual = tab;

            // Ocultar todos los contenidos
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-red-600', 'bg-red-50', 'text-red-600');
                btn.classList.add('border-transparent');
            });

            // Mostrar contenido activo
            document.getElementById('content-' + tab).classList.remove('hidden');
            const btnActivo = document.getElementById('tab-' + tab);
            btnActivo.classList.add('border-red-600', 'bg-red-50', 'text-red-600');
            btnActivo.classList.remove('border-transparent');

            // Cargar datos según el tab
            if (tab === 'balance') cargarBalance();
            else if (tab === 'empleados') cargarEmpleados();
            else if (tab === 'deudas') cargarDeudas();

            lucide.createIcons();
        }

        // BALANCE Y MOVIMIENTOS
        async function cargarBalance() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;

            try {
                const response = await fetch(`${API_BASE}/caja/balance?desde=${desde}&hasta=${hasta}`);
                const data = await response.json();

                if (data.success) {
                    document.getElementById('total-ingresos').textContent = '$' + data.ingresos.toFixed(2);
                    document.getElementById('total-egresos').textContent = '$' + data.egresos.toFixed(2);
                    document.getElementById('balance-total').textContent = '$' + data.balance.toFixed(2);

                    cargarMovimientos();
                }
            } catch (error) {
                console.error('Error al cargar balance:', error);
            }
        }

        async function cargarMovimientos() {
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;

            try {
                const response = await fetch(`${API_BASE}/caja/movimientos?desde=${desde}&hasta=${hasta}`);
                const data = await response.json();

                const tbody = document.getElementById('tabla-movimientos');
                if (data.success && data.data.length > 0) {
                    tbody.innerHTML = data.data.map(m => {
                        // Manejo defensivo de propiedades
                        const fecha = m.fecha || m.Fecha;
                        const tipo = m.tipo || m.Tipo || '';
                        const categoria = m.categoria || m.Categoria || '';
                        const descripcion = m.descripcion || m.Descripcion || '-';
                        const metodoPago = m.metodoPago || m.MetodoPago || '-';
                        const monto = m.monto || m.Monto || 0;
                        const usuario = m.usuario || m.Usuario || 'N/A';

                        return `
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold">
                                ${new Date(fecha).toLocaleDateString('es-ES')}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-black uppercase ${tipo === 'ingreso' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}">
                                    ${tipo}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm font-semibold">${categoria}</td>
                            <td class="px-6 py-4 text-sm">${descripcion}</td>
                            <td class="px-6 py-4 text-sm font-semibold">${metodoPago}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <span class="text-lg font-black ${tipo === 'ingreso' ? 'text-emerald-600' : 'text-red-600'}">
                                    $${monto.toFixed(2)}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center text-sm font-semibold">${usuario}</td>
                        </tr>
                    `;
                    }).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="7" class="px-6 py-8 text-center text-gray-500">No hay movimientos en este período</td></tr>';
                }
                lucide.createIcons();
            } catch (error) {
                console.error('Error al cargar movimientos:', error);
                const tbody = document.getElementById('tabla-movimientos');
                tbody.innerHTML = '<tr><td colspan="7" class="px-6 py-8 text-center text-red-500">Error al cargar movimientos</td></tr>';
            }
        }

        // EMPLEADOS
        async function cargarEmpleados() {
            try {
                const response = await fetch(`${API_BASE}/empleados`);
                const data = await response.json();

                const container = document.getElementById('lista-empleados');
                if (data.success && data.data.length > 0) {
                    container.innerHTML = data.data.map(e => {
                        // Manejo defensivo de propiedades
                        const id = e.id || e.Id;
                        const nombre = e.nombre || e.Nombre || '';
                        const apellido = e.apellido || e.Apellido || '';
                        const cedula = e.cedula || e.Cedula || '';
                        const cargo = e.cargo || e.Cargo || 'Sin cargo';
                        const salario = e.salario || e.Salario || 0;
                        const activo = e.activo !== undefined ? e.activo : (e.Activo !== undefined ? e.Activo : true);

                        return `
                        <div class="bg-white border-2 border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all">
                            <div class="flex items-start justify-between mb-4">
                                <div>
                                    <h4 class="text-lg font-black text-gray-900">${nombre} ${apellido}</h4>
                                    <p class="text-sm text-gray-600">${cargo}</p>
                                </div>
                                <span class="px-3 py-1 rounded-full text-xs font-black uppercase ${activo ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-800'}">
                                    ${activo ? 'Activo' : 'Inactivo'}
                                </span>
                            </div>
                            <div class="space-y-2 text-sm">
                                <p><strong>Cédula:</strong> ${cedula}</p>
                                <p><strong>Salario:</strong> $${salario.toFixed(2)}</p>
                            </div>
                            <div class="mt-4 flex gap-2">
                                <button onclick="pagarSalario('${id}')" class="flex-1 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-sm">
                                    Pagar
                                </button>
                                <button onclick="verHistorialPagos('${id}')" class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-sm">
                                    Historial
                                </button>
                            </div>
                        </div>
                    `;
                    }).join('');
                } else {
                    container.innerHTML = '<div class="col-span-full text-center py-8 text-gray-500">No hay empleados registrados</div>';
                }
            } catch (error) {
                console.error('Error al cargar empleados:', error);
                const container = document.getElementById('lista-empleados');
                container.innerHTML = '<div class="col-span-full text-center py-8 text-red-500">Error al cargar empleados</div>';
            }
        }

        // DEUDAS
        async function cargarDeudas() {
            try {
                const response = await fetch(`${API_BASE}/deudas`);
                const data = await response.json();

                const tbody = document.getElementById('tabla-deudas');
                if (data.success && data.data.length > 0) {
                    tbody.innerHTML = data.data.map(d => {
                        // Manejo defensivo de propiedades (PascalCase y camelCase)
                        const clienteNombre = d.clienteNombre || d.ClienteNombre || 'N/A';
                        const concepto = d.concepto || d.Concepto || 'Sin concepto';
                        const montoTotal = d.montoTotal || d.MontoTotal || 0;
                        const saldo = d.saldo || d.Saldo || 0;
                        const estado = d.estado || d.Estado || 'pendiente';
                        const id = d.id || d.Id;

                        return `
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-semibold">${clienteNombre}</td>
                            <td class="px-6 py-4">${concepto}</td>
                            <td class="px-6 py-4 text-right font-black text-gray-900">$${montoTotal.toFixed(2)}</td>
                            <td class="px-6 py-4 text-right font-black text-red-600">$${saldo.toFixed(2)}</td>
                            <td class="px-6 py-4 text-center">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-black uppercase ${
                                    estado === 'pagada' ? 'bg-emerald-100 text-emerald-800' :
                                    estado === 'vencida' ? 'bg-red-100 text-red-800' :
                                    'bg-yellow-100 text-yellow-800'
                                }">
                                    ${estado}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <button onclick="abonarDeuda('${id}')" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-sm">
                                    Abonar
                                </button>
                            </td>
                        </tr>
                    `;
                    }).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">No hay deudas registradas</td></tr>';
                }
                lucide.createIcons();
            } catch (error) {
                console.error('Error al cargar deudas:', error);
                const tbody = document.getElementById('tabla-deudas');
                tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-red-500">Error al cargar deudas. Ver consola para detalles.</td></tr>';
            }
        }

        // ==================== FUNCIONES DE MODALES ====================

        function abrirModalIngreso() {
            alert('Modal de ingreso - Implementar según necesidad del proyecto');
        }

        function abrirModalEgreso() {
            alert('Modal de egreso - Implementar según necesidad del proyecto');
        }

        function abrirModalEmpleado() {
            alert('Modal de empleado - Implementar según necesidad del proyecto');
        }

        function abrirModalDeuda() {
            alert('Modal de deuda - Implementar según necesidad del proyecto');
        }

        function pagarSalario(empleadoId) {
            alert('Pagar salario - Empleado: ' + empleadoId);
        }

        function verHistorialPagos(empleadoId) {
            alert('Ver historial - Empleado: ' + empleadoId);
        }

        // ==================== ABONAR DEUDA - MODAL FUNCIONAL ====================
        async function abonarDeuda(deudaId) {
            try {
                // Obtener detalles de la deuda
                const response = await fetch(`${API_BASE}/deudas`);
                const data = await response.json();

                if (!data.success) {
                    alert('Error al cargar deudas');
                    return;
                }

                const deuda = data.data.find(d => (d.id || d.Id) === deudaId);
                if (!deuda) {
                    alert('Deuda no encontrada');
                    return;
                }

                // Extraer propiedades con manejo defensivo
                const clienteNombre = deuda.clienteNombre || deuda.ClienteNombre || 'N/A';
                const concepto = deuda.concepto || deuda.Concepto || 'Sin concepto';
                const montoTotal = deuda.montoTotal || deuda.MontoTotal || 0;
                const montoPagado = deuda.montoPagado || deuda.MontoPagado || 0;
                const saldo = deuda.saldo || deuda.Saldo || 0;

                // Crear modal
                const modalHTML = `
                    <div id="modalAbonarDeuda" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
                        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
                            <div class="p-6 border-b-2 border-gray-200 bg-gradient-to-r from-emerald-600 to-emerald-800">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <div class="bg-white p-3 rounded-xl">
                                            <i data-lucide="dollar-sign" class="w-6 h-6 text-emerald-600"></i>
                                        </div>
                                        <div>
                                            <h3 class="text-2xl font-black text-white uppercase tracking-wide">Abonar a Deuda</h3>
                                            <p class="text-emerald-100 text-sm font-semibold">${clienteNombre}</p>
                                        </div>
                                    </div>
                                    <button onclick="cerrarModalAbono()" class="text-white hover:bg-emerald-700 p-2 rounded-lg transition-all">
                                        <i data-lucide="x" class="w-6 h-6"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="p-6 space-y-6">
                                <!-- INFORMACIÓN DE LA DEUDA -->
                                <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-300 rounded-xl p-5">
                                    <h4 class="font-black text-blue-900 mb-3 uppercase tracking-wide flex items-center gap-2">
                                        <i data-lucide="info" class="w-5 h-5"></i>
                                        Detalles de la Deuda
                                    </h4>
                                    <div class="space-y-2 text-sm">
                                        <div class="flex justify-between">
                                            <span class="text-blue-700 font-bold">Concepto:</span>
                                            <span class="text-blue-900 font-black">${concepto}</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-blue-700 font-bold">Monto Total:</span>
                                            <span class="text-blue-900 font-black">$${montoTotal.toFixed(2)}</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-blue-700 font-bold">Ya Pagado:</span>
                                            <span class="text-emerald-600 font-black">$${montoPagado.toFixed(2)}</span>
                                        </div>
                                        <div class="flex justify-between pt-2 border-t-2 border-blue-300">
                                            <span class="text-blue-700 font-bold text-lg">Saldo Pendiente:</span>
                                            <span class="text-red-600 font-black text-2xl">$${saldo.toFixed(2)}</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- OPCIONES DE PAGO -->
                                <div>
                                    <label class="block text-sm font-black text-gray-700 mb-3 uppercase tracking-wide">
                                        Seleccione tipo de pago:
                                    </label>
                                    <div class="grid grid-cols-2 gap-4">
                                        <label class="relative cursor-pointer">
                                            <input type="radio" name="tipoPagoAbono" value="completo" checked
                                                   onchange="actualizarMontoAbono(${saldo})"
                                                   class="peer sr-only">
                                            <div class="p-5 border-2 border-gray-300 rounded-xl peer-checked:border-emerald-600 peer-checked:bg-emerald-50 transition-all">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">
                                                        <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600"></i>
                                                    </div>
                                                    <div>
                                                        <p class="font-black text-gray-900 uppercase">Pago Completo</p>
                                                        <p class="text-sm text-gray-600 font-semibold">$${saldo.toFixed(2)}</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </label>

                                        <label class="relative cursor-pointer">
                                            <input type="radio" name="tipoPagoAbono" value="parcial"
                                                   onchange="actualizarMontoAbono(0)"
                                                   class="peer sr-only">
                                            <div class="p-5 border-2 border-gray-300 rounded-xl peer-checked:border-orange-600 peer-checked:bg-orange-50 transition-all">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                                                        <i data-lucide="coins" class="w-5 h-5 text-orange-600"></i>
                                                    </div>
                                                    <div>
                                                        <p class="font-black text-gray-900 uppercase">Abono Parcial</p>
                                                        <p class="text-sm text-gray-600 font-semibold">Monto personalizado</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <!-- MONTO DEL ABONO -->
                                <div>
                                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                                        Monto a Abonar *
                                    </label>
                                    <input type="number" id="montoAbono" step="0.01" min="0.01" max="${saldo}"
                                           value="${saldo.toFixed(2)}" required
                                           oninput="calcularNuevoSaldo(${saldo})"
                                           class="w-full px-5 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 font-bold text-2xl text-emerald-600">
                                </div>

                                <!-- NUEVO SALDO -->
                                <div id="nuevoSaldoContainer" class="p-5 bg-gradient-to-r from-yellow-50 to-orange-50 border-2 border-yellow-400 rounded-xl">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-sm text-yellow-700 font-bold uppercase tracking-wide">Nuevo Saldo Pendiente:</p>
                                            <p class="text-3xl font-black text-orange-600" id="nuevoSaldo">$0.00</p>
                                        </div>
                                        <div class="bg-yellow-200 p-3 rounded-xl">
                                            <i data-lucide="trending-down" class="w-8 h-8 text-yellow-700"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- MÉTODO DE PAGO -->
                                <div>
                                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                                        Método de Pago *
                                    </label>
                                    <select id="metodoPagoAbono" required
                                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 font-semibold">
                                        <option value="efectivo">Efectivo</option>
                                        <option value="tarjeta">Tarjeta</option>
                                        <option value="transferencia">Transferencia</option>
                                    </select>
                                </div>

                                <!-- NOTAS -->
                                <div>
                                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                                        Notas (Opcional)
                                    </label>
                                    <textarea id="notasAbono" rows="2" placeholder="Observaciones del abono..."
                                              class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 font-semibold"></textarea>
                                </div>

                                <!-- BOTONES -->
                                <div class="flex gap-4 pt-4 border-t-2 border-gray-200">
                                    <button onclick="confirmarAbono('${deudaId}', ${saldo})"
                                            class="flex-1 bg-gradient-to-r from-emerald-600 to-emerald-800 hover:from-emerald-700 hover:to-emerald-900 text-white font-black py-4 px-6 rounded-xl shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105 transition-all">
                                        <i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i>
                                        Registrar Abono
                                    </button>
                                    <button onclick="cerrarModalAbono()"
                                            class="px-8 py-4 bg-gray-300 hover:bg-gray-400 text-gray-900 font-black rounded-xl uppercase tracking-wide transition-all">
                                        Cancelar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                document.getElementById('modal-container').innerHTML = modalHTML;
                lucide.createIcons();

            } catch (error) {
                console.error('Error al abrir modal:', error);
                alert('Error al cargar detalles de la deuda');
            }
        }

        function actualizarMontoAbono(monto) {
            const montoInput = document.getElementById('montoAbono');
            if (monto > 0) {
                montoInput.value = monto.toFixed(2);
                montoInput.readOnly = true;
            } else {
                montoInput.value = '';
                montoInput.readOnly = false;
                montoInput.focus();
            }
            calcularNuevoSaldo(parseFloat(montoInput.max));
        }

        function calcularNuevoSaldo(saldoActual) {
            const montoAbono = parseFloat(document.getElementById('montoAbono').value) || 0;
            const nuevoSaldo = Math.max(0, saldoActual - montoAbono);
            document.getElementById('nuevoSaldo').textContent = '$' + nuevoSaldo.toFixed(2);

            const container = document.getElementById('nuevoSaldoContainer');
            if (nuevoSaldo === 0) {
                container.className = 'p-5 bg-gradient-to-r from-emerald-50 to-green-50 border-2 border-emerald-400 rounded-xl';
                container.querySelector('p:first-child').textContent = '✅ Deuda Saldada Completamente:';
                document.getElementById('nuevoSaldo').className = 'text-3xl font-black text-emerald-600';
            } else {
                container.className = 'p-5 bg-gradient-to-r from-yellow-50 to-orange-50 border-2 border-yellow-400 rounded-xl';
                container.querySelector('p:first-child').textContent = 'Nuevo Saldo Pendiente:';
                document.getElementById('nuevoSaldo').className = 'text-3xl font-black text-orange-600';
            }
        }

        async function confirmarAbono(deudaId, saldoActual) {
            const montoAbono = parseFloat(document.getElementById('montoAbono').value);
            const metodoPago = document.getElementById('metodoPagoAbono').value;
            const notas = document.getElementById('notasAbono').value;

            // Validaciones
            if (!montoAbono || montoAbono <= 0) {
                alert('⚠️ El monto debe ser mayor a $0');
                return;
            }

            if (montoAbono > saldoActual) {
                alert('⚠️ El monto no puede ser mayor al saldo pendiente');
                return;
            }

            const nuevoSaldo = saldoActual - montoAbono;
            const mensaje = nuevoSaldo === 0
                ? `¿Confirmar PAGO COMPLETO de la deuda?\n\n💰 Monto: $${montoAbono.toFixed(2)}\n✅ La deuda quedará SALDADA`
                : `¿Confirmar ABONO PARCIAL?\n\n💵 Abono: $${montoAbono.toFixed(2)}\n🔸 Quedará pendiente: $${nuevoSaldo.toFixed(2)}`;

            if (!confirm(mensaje)) return;

            try {
                const response = await fetch(`${API_BASE}/deudas/abonar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        deudaId: deudaId,
                        monto: montoAbono,
                        metodoPago: metodoPago,
                        notas: notas || null,
                        usuarioId: null // TODO: Obtener del usuario logueado
                    })
                });

                const result = await response.json();

                if (result.success) {
                    const mensajeExito = nuevoSaldo === 0
                        ? '✅ ¡Deuda pagada completamente!\n\n💰 Se registró el abono en caja'
                        : `✅ Abono registrado exitosamente\n\n💵 Abono: $${montoAbono.toFixed(2)}\n🔸 Saldo pendiente: $${nuevoSaldo.toFixed(2)}`;

                    alert(mensajeExito);
                    cerrarModalAbono();
                    cargarDeudas(); // Recargar tabla
                    cargarBalance(); // Actualizar balance
                } else {
                    alert('❌ Error: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('❌ Error al registrar abono: ' + error.message);
            }
        }

        function cerrarModalAbono() {
            document.getElementById('modal-container').innerHTML = '';
        }
    </script>
}

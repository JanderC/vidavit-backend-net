@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Caja";
    ViewData["Subtitle"] = "Control financiero completo - Power Fitness";
}

<style>
    :root{--pf-blue:#3B82F6;--pf-blueB:#60A5FA;--pf-deep:#1E3A8A;--pf-purple:#7C3AED;--pf-card:#0D1526;--pf-border:#1E2D4A;--pf-text:#E2E8F0;--pf-soft:#94A3B8;--pf-muted:#64748B;--pf-green:#10B981;--pf-red:#EF4444;--pf-orange:#F59E0B;}
    .pf-input{width:100%;padding:.75rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:rgba(255,255,255,.03);color:var(--pf-text);font-weight:600;font-family:inherit;font-size:.9rem;outline:none;box-sizing:border-box;transition:border-color .2s;}
    .pf-input:focus{border-color:var(--pf-blue);}
    .pf-input::placeholder{color:var(--pf-muted);font-weight:400;}
    .pf-select{width:100%;padding:.75rem 1rem;border:2px solid var(--pf-border);border-radius:.75rem;background:var(--pf-card);color:var(--pf-text);font-weight:600;font-family:inherit;font-size:.9rem;outline:none;box-sizing:border-box;}
    .pf-label{display:block;font-size:.7rem;font-weight:800;color:var(--pf-soft);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.1em;}

    /* ── KPI Cards ── */
    .kpi-card{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;padding:1.25rem;position:relative;overflow:hidden;transition:transform .2s,box-shadow .2s;}
    .kpi-card:hover{transform:translateY(-3px);box-shadow:0 12px 36px rgba(0,0,0,.4);}
    .kpi-card::before{content:'';position:absolute;top:0;left:0;bottom:0;width:4px;border-radius:1rem 0 0 1rem;}
    .kpi-green::before{background:var(--pf-green);}
    .kpi-purple::before{background:var(--pf-purple);}
    .kpi-blue::before{background:var(--pf-blue);}
    .kpi-red::before{background:var(--pf-red);}
    .kpi-orange::before{background:var(--pf-orange);}
    .kpi-slate::before{background:#94A3B8;}
    .kpi-icon{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .kpi-green  .kpi-icon{background:rgba(16,185,129,.12);}
    .kpi-purple .kpi-icon{background:rgba(124,58,237,.12);}
    .kpi-blue   .kpi-icon{background:rgba(59,130,246,.12);}
    .kpi-red    .kpi-icon{background:rgba(239,68,68,.12);}
    .kpi-orange .kpi-icon{background:rgba(245,158,11,.12);}
    .kpi-slate  .kpi-icon{background:rgba(148,163,184,.12);}
    .kpi-green  .kpi-icon i{color:var(--pf-green)!important;}
    .kpi-purple .kpi-icon i{color:#A78BFA!important;}
    .kpi-blue   .kpi-icon i{color:var(--pf-blueB)!important;}
    .kpi-red    .kpi-icon i{color:var(--pf-red)!important;}
    .kpi-orange .kpi-icon i{color:var(--pf-orange)!important;}
    .kpi-slate  .kpi-icon i{color:var(--pf-soft)!important;}
    .kpi-lbl{font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.35rem;}
    .kpi-green  .kpi-lbl{color:rgba(16,185,129,.7);}
    .kpi-purple .kpi-lbl{color:rgba(167,139,250,.7);}
    .kpi-blue   .kpi-lbl{color:rgba(96,165,250,.7);}
    .kpi-red    .kpi-lbl{color:rgba(239,68,68,.7);}
    .kpi-orange .kpi-lbl{color:rgba(245,158,11,.7);}
    .kpi-slate  .kpi-lbl{color:rgba(148,163,184,.7);}
    .kpi-val{font-size:1.75rem;font-weight:900;color:#fff;}
    .kpi-sub{font-size:.72rem;font-weight:600;color:var(--pf-muted);margin-top:.2rem;}

    /* ── Desglose ── */
    .desglose-card{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;padding:1.5rem;margin-bottom:1.25rem;}
    .desglose-item{border:1px solid var(--pf-border);border-radius:.75rem;padding:1rem;transition:border-color .2s;}
    .desglose-item:hover{border-color:rgba(59,130,246,.3);}

    /* ── Tabs ── */
    .tab-wrap{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;overflow:hidden;margin-bottom:1.25rem;}
    .tab-bar{display:flex;border-bottom:1px solid var(--pf-border);}
    .tab-btn{flex:1;padding:.875rem .75rem;font-weight:800;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;background:transparent;border:none;border-bottom:3px solid transparent;color:var(--pf-muted);cursor:pointer;font-family:inherit;transition:color .2s,border-color .2s,background .2s;display:flex;align-items:center;justify-content:center;gap:.35rem;}
    .tab-btn:hover{background:rgba(59,130,246,.05);color:var(--pf-blueB);}
    .tab-btn.active{color:var(--pf-blueB);border-bottom-color:var(--pf-blue);background:rgba(59,130,246,.06);}
    .tab-btn i{width:16px!important;height:16px!important;}

    /* ── Tabla movimientos ── */
    .pf-table{width:100%;border-collapse:collapse;}
    .pf-table thead tr{background:linear-gradient(135deg,var(--pf-deep),#111827);border-bottom:2px solid var(--pf-blue);}
    .pf-table th{padding:.875rem 1.25rem;font-size:.68rem;font-weight:800;color:rgba(255,255,255,.85);text-transform:uppercase;letter-spacing:.12em;text-align:left;}
    .pf-table th:last-child{text-align:right;}
    .pf-table tbody tr{border-bottom:1px solid var(--pf-border);transition:background .15s;}
    .pf-table tbody tr:hover{background:rgba(59,130,246,.04);}
    .pf-table td{padding:.875rem 1.25rem;font-size:.88rem;font-weight:600;color:var(--pf-text);}
    .pf-table td:last-child{text-align:right;}

    /* ── Resumen semanal ── */
    .semana-thead{background:linear-gradient(135deg,var(--pf-deep),var(--pf-blue));}
    .semana-thead th{padding:.875rem 1.25rem;font-size:.72rem;font-weight:800;color:#fff;text-transform:uppercase;letter-spacing:.08em;text-align:right;}
    .semana-thead th:first-child{text-align:left;}
    .semana-tfoot{background:rgba(6,11,24,.5);border-top:2px solid var(--pf-border);}
    .semana-tfoot td{padding:.875rem 1.25rem;font-weight:900;text-align:right;}
    .semana-tfoot td:first-child{text-align:left;color:var(--pf-text);}

    /* ── Deudas cliente card ── */
    .deuda-grupo{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;overflow:hidden;transition:box-shadow .2s;margin-bottom:1rem;}
    .deuda-grupo:hover{box-shadow:0 8px 28px rgba(0,0,0,.35);}
    .deuda-grupo-head{padding:1.1rem 1.25rem;border-bottom:1px solid var(--pf-border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;}
    .deuda-item{padding:.875rem 1.25rem;background:rgba(255,255,255,.02);border:1px solid var(--pf-border);border-radius:.75rem;transition:background .15s;}
    .deuda-item:hover{background:rgba(59,130,246,.04);}
    .pf-progress-bar{height:6px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden;margin-top:.5rem;}
    .pf-progress-fill{height:100%;border-radius:999px;}

    /* ── Días pendientes ── */
    .dia-pend{background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.25);border-left:4px solid var(--pf-orange);border-radius:.875rem;padding:1.25rem;margin-bottom:.875rem;}

    /* ── Cierre card ── */
    .cierre-card{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;padding:1.5rem;margin-bottom:.875rem;transition:box-shadow .2s;}
    .cierre-card:hover{box-shadow:0 8px 28px rgba(0,0,0,.35);}

    /* ── Formulario registrar ── */
    .form-card{background:var(--pf-card);border-radius:1rem;padding:1.75rem;box-shadow:0 4px 20px rgba(0,0,0,.3);}
    .form-card-green{border:1px solid rgba(16,185,129,.25);}
    .form-card-red  {border:1px solid rgba(239,68,68,.25);}

    /* ── Modal overlay ── */
    .pf-modal{position:fixed;inset:0;background:rgba(6,11,24,.8);backdrop-filter:blur(6px);z-index:50;display:flex;align-items:center;justify-content:center;padding:1rem;}
    .pf-modal.hidden{display:none;}
    .pf-modal-card{background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1.25rem;width:100%;max-width:720px;box-shadow:0 25px 60px rgba(0,0,0,.6);overflow:hidden;}
    .pf-modal-header{padding:1.5rem 2rem;border-bottom:1px solid var(--pf-border);display:flex;align-items:center;gap:1rem;}
    .pf-modal-body{padding:1.75rem 2rem;}
    .pf-modal-footer{padding:1.25rem 2rem;border-top:1px solid var(--pf-border);display:flex;gap:.75rem;justify-content:flex-end;}

    /* ── Chips ── */
    .chip{display:inline-flex;align-items:center;padding:.22rem .75rem;border-radius:999px;font-size:.7rem;font-weight:800;text-transform:uppercase;}
    .chip-green {background:rgba(16,185,129,.1);color:var(--pf-green);border:1px solid rgba(16,185,129,.25);}
    .chip-amber {background:rgba(245,158,11,.1);color:var(--pf-orange);border:1px solid rgba(245,158,11,.25);}
    .chip-blue  {background:rgba(59,130,246,.1);color:var(--pf-blueB);border:1px solid rgba(59,130,246,.25);}
    .chip-red   {background:rgba(239,68,68,.1);color:var(--pf-red);border:1px solid rgba(239,68,68,.25);}
    .chip-gray  {background:rgba(100,116,139,.1);color:var(--pf-soft);border:1px solid rgba(100,116,139,.2);}
    .chip-purple{background:rgba(124,58,237,.1);color:#A78BFA;border:1px solid rgba(124,58,237,.25);}

    /* ── Btn ── */
    .pf-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.7rem 1.5rem;border:none;border-radius:.875rem;font-weight:800;font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;text-decoration:none;transition:transform .2s,box-shadow .2s;}
    .pf-btn:hover{transform:scale(1.03);}
    .pf-btn-blue  {background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;box-shadow:0 4px 16px rgba(59,130,246,.3);}
    .pf-btn-green {background:linear-gradient(135deg,var(--pf-green),#065F46);color:#fff;box-shadow:0 4px 16px rgba(16,185,129,.3);}
    .pf-btn-red   {background:linear-gradient(135deg,#DC2626,#991B1B);color:#fff;box-shadow:0 4px 14px rgba(220,38,38,.3);}
    .pf-btn-gray  {background:rgba(255,255,255,.06);border:1px solid var(--pf-border);color:var(--pf-soft);}
    .pf-btn-ghost {background:transparent;border:1px solid var(--pf-border);color:var(--pf-soft);}
</style>

<div style="display:flex;flex-direction:column;gap:1.25rem;">

    <!-- KPI Cards -->
    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:1rem;">
        <div class="kpi-card kpi-green">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                <p class="kpi-lbl">Efectivo Hoy</p>
                <div class="kpi-icon"><i data-lucide="wallet" style="width:22px;height:22px;"></i></div>
            </div>
            <p class="kpi-val" id="efectivo-hoy">$0.00</p>
            <p class="kpi-sub">Balance en efectivo</p>
        </div>
        <div class="kpi-card kpi-purple">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                <p class="kpi-lbl">Transferencias</p>
                <div class="kpi-icon"><i data-lucide="credit-card" style="width:22px;height:22px;"></i></div>
            </div>
            <p class="kpi-val" id="transferencias-hoy">$0.00</p>
            <p class="kpi-sub" id="detalle-transferencias">Ingresos del día</p>
        </div>
        <div class="kpi-card kpi-blue">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                <p class="kpi-lbl">Ingresos Hoy</p>
                <div class="kpi-icon"><i data-lucide="trending-up" style="width:22px;height:22px;"></i></div>
            </div>
            <p class="kpi-val" id="ingresos-hoy">$0.00</p>
            <p class="kpi-sub" id="detalle-ingresos">Efectivo + Transferencia</p>
        </div>
        <div class="kpi-card kpi-red">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                <p class="kpi-lbl">Egresos Hoy</p>
                <div class="kpi-icon"><i data-lucide="trending-down" style="width:22px;height:22px;"></i></div>
            </div>
            <p class="kpi-val" id="egresos-hoy">$0.00</p>
            <p class="kpi-sub" id="detalle-egresos">Efectivo + Transferencia</p>
        </div>
        <div class="kpi-card kpi-orange">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                <p class="kpi-lbl">Deudas Pendientes</p>
                <div class="kpi-icon"><i data-lucide="alert-circle" style="width:22px;height:22px;"></i></div>
            </div>
            <p class="kpi-val" id="deudas-pendientes">$0.00</p>
            <p class="kpi-sub">Total por cobrar</p>
        </div>
        <div class="kpi-card kpi-slate">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                <p class="kpi-lbl">Balance Total</p>
                <div class="kpi-icon"><i data-lucide="calculator" style="width:22px;height:22px;"></i></div>
            </div>
            <p class="kpi-val" id="balance-total">$0.00</p>
            <button onclick="abrirModalCerrarCaja()"
                    style="margin-top:.5rem;padding:.35rem .875rem;background:linear-gradient(135deg,var(--pf-blue),var(--pf-purple));color:#fff;border:none;border-radius:.5rem;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:.3rem;">
                <i data-lucide="lock" style="width:12px;height:12px;"></i> Cerrar Caja
            </button>
        </div>
    </div>

    <!-- Desglose ventas -->
    <div class="desglose-card">
        <h3 style="font-size:.9rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.08em;margin:0 0 1rem 0;display:flex;align-items:center;gap:.5rem;">
            <i data-lucide="pie-chart" style="width:18px;height:18px;color:var(--pf-blueB);"></i> Desglose de Ventas del Día
        </h3>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:.875rem;">
            <div class="desglose-item" style="border-left:3px solid var(--pf-red);">
                <p style="font-size:.68rem;font-weight:800;color:rgba(239,68,68,.7);text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Membresías</p>
                <p style="font-size:1.5rem;font-weight:900;color:var(--pf-red);margin:0;" id="venta-membresias">$0.00</p>
            </div>
            <div class="desglose-item" style="border-left:3px solid var(--pf-orange);">
                <p style="font-size:.68rem;font-weight:800;color:rgba(245,158,11,.7);text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Productos</p>
                <p style="font-size:1.5rem;font-weight:900;color:var(--pf-orange);margin:0;" id="venta-productos">$0.00</p>
            </div>
            <div class="desglose-item" style="border-left:3px solid var(--pf-green);">
                <p style="font-size:.68rem;font-weight:800;color:rgba(16,185,129,.7);text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Abonos a Deudas</p>
                <p style="font-size:1.5rem;font-weight:900;color:var(--pf-green);margin:0;" id="venta-abonos">$0.00</p>
            </div>
            <div class="desglose-item" style="border-left:3px solid var(--pf-blue);">
                <p style="font-size:.68rem;font-weight:800;color:rgba(96,165,250,.7);text-transform:uppercase;letter-spacing:.1em;margin:0 0 .3rem 0;">Otros</p>
                <p style="font-size:1.5rem;font-weight:900;color:var(--pf-blueB);margin:0;" id="venta-otros">$0.00</p>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tab-wrap">
        <div class="tab-bar">
            <button onclick="cambiarTab('movimientos')" id="tab-movimientos" class="tab-btn active">
                <i data-lucide="list"></i> Movimientos
            </button>
            <button onclick="cambiarTab('pendientes')" id="tab-pendientes" class="tab-btn">
                <i data-lucide="calendar-clock"></i> Días Pendientes
            </button>
            <button onclick="cambiarTab('deudas')" id="tab-deudas" class="tab-btn">
                <i data-lucide="file-text"></i> Deudas Clientes
            </button>
            <button onclick="cambiarTab('semanal')" id="tab-semanal" class="tab-btn">
                <i data-lucide="calendar"></i> Resumen Semanal
            </button>
            <button onclick="cambiarTab('cierres')" id="tab-cierres" class="tab-btn">
                <i data-lucide="archive"></i> Historial Cierres
            </button>
            <button onclick="cambiarTab('registrar')" id="tab-registrar" class="tab-btn">
                <i data-lucide="plus-circle"></i> Registrar
            </button>
        </div>
    </div>

    <!-- TAB: Movimientos -->
    <div id="content-movimientos" class="tab-content">
        <div class="desglose-card" style="margin-bottom:1rem;">
            <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:1rem;">
                <div style="flex:1;min-width:180px;">
                    <label class="pf-label">Fecha Desde</label>
                    <input type="date" id="fecha-desde" class="pf-input">
                </div>
                <div style="flex:1;min-width:180px;">
                    <label class="pf-label">Fecha Hasta</label>
                    <input type="date" id="fecha-hasta" class="pf-input">
                </div>
                <div style="flex:1;min-width:180px;">
                    <label class="pf-label">Categoría</label>
                    <select id="filtro-categoria" class="pf-select">
                        <option value="">Todas</option>
                        <option value="membresia">Membresías</option>
                        <option value="renovacion">Renovaciones</option>
                        <option value="producto">Productos</option>
                        <option value="abono_deuda">Abonos Deuda</option>
                        <option value="otro">Otros</option>
                    </select>
                </div>
                <button onclick="cargarMovimientos()" class="pf-btn pf-btn-blue">
                    <i data-lucide="filter" style="width:16px;height:16px;"></i> Filtrar
                </button>
            </div>
        </div>
        <div style="background:var(--pf-card);border:1px solid var(--pf-border);border-radius:1rem;overflow:hidden;">
            <div style="padding:.875rem 1.5rem;border-bottom:1px solid var(--pf-border);">
                <h3 style="font-size:.95rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.08em;margin:0;">Historial de Movimientos</h3>
            </div>
            <div style="overflow-x:auto;">
                <table class="pf-table">
                    <thead><tr>
                        <th>Fecha</th><th>Tipo</th><th>Categoría</th><th>Descripción</th><th>Método</th><th>Monto</th>
                    </tr></thead>
                    <tbody id="tabla-movimientos">
                        <tr><td colspan="6" style="padding:3rem;text-align:center;color:var(--pf-muted);font-weight:700;">Cargando movimientos...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB: Días Pendientes -->
    <div id="content-pendientes" class="tab-content hidden">
        <div class="desglose-card">
            <h3 style="font-size:.95rem;font-weight:900;color:var(--pf-text);text-transform:uppercase;letter-spacing:.08em;margin:0 0 1.25rem 0;display:flex;align-items:center;gap:.5rem;">
                <i data-lucide="calendar-clock" style="width:18px;height:18px;color:var(--pf-orange);"></i> Días con Movimientos Sin Cerrar
            </h3>
            <div id="lista-dias-pendientes">
                <p style="text-align:center;padding:3rem;color:var(--pf-muted);font-weight:700;">Cargando...</p>
            </div>
        </div>
    </div>

    <!-- TAB: Deudas Clientes -->
    <div id="content-deudas" class="tab-content hidden">
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1rem;">
            <div onclick="filtroEstadoDeuda('')" class="kpi-card kpi-slate" style="cursor:pointer;">
                <p style="font-size:.68rem;font-weight:800;color:var(--pf-muted);text-transform:uppercase;letter-spacing:.1em;margin:0 0 .35rem 0;">Total por cobrar</p>
                <p style="font-size:1.75rem;font-weight:900;color:var(--pf-text);margin:0 0 .2rem 0;" id="rv-deuda-total">—</p>
                <p style="font-size:.72rem;color:var(--pf-muted);font-weight:600;margin:0;" id="rs-deuda-total">0 deudas</p>
            </div>
            <div onclick="filtroEstadoDeuda('pendiente')" class="kpi-card kpi-orange" style="cursor:pointer;">
                <p class="kpi-lbl">Deudas pendientes</p>
                <p style="font-size:1.75rem;font-weight:900;color:var(--pf-orange);margin:0 0 .2rem 0;" id="rv-deuda-pendiente">—</p>
                <p style="font-size:.72rem;color:var(--pf-muted);font-weight:600;margin:0;" id="rs-deuda-pendiente">0 deudas</p>
            </div>
            <a href="/Caja/DeudasPagadas"
               style="background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.25);border-left:4px solid var(--pf-green);border-radius:1rem;padding:1.25rem;text-decoration:none;display:flex;flex-direction:column;justify-content:space-between;transition:box-shadow .2s;"
               onmouseover="this.style.boxShadow='0 8px 28px rgba(16,185,129,.2)'" onmouseout="this.style.boxShadow='none'">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>

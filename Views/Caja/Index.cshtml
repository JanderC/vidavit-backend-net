                async function cargarHistorialCierres() {
            try {
                const response = await fetch(`${API_URL}/Caja/cierres?limite=20`);

                // Verificar si la respuesta es válida
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const text = await response.text();
                if (!text) {
                    throw new Error('Respuesta vacía del servidor');
                }

                const data = JSON.parse(text);

                const container = document.getElementById('lista-cierres');

                if (!container) {
                    console.error('Container lista-cierres no encontrado');
                    return;
                }

                if (data.success && data.data && Array.isArray(data.data) && data.data.length > 0) {
                    container.innerHTML = data.data.map(cierre => {
                        const tipoBadge = cierre.TipoCierre === 'automatico'

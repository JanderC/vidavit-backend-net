        // ========================================
        // DEUDAS — CON FIX DE VENCIDAS Y RESUMEN
        // ========================================
        let deudasData = [];
        let deudaSeleccionada = null;
        let _filtroEstadoDeuda = '';
        let _busquedaDeuda = '';
        let _debounceDeuda = null;

        // Estado real: las deudas NO se vencen. Solo: pendiente, pagada, cancelada.
        function calcularEstadoRealDeuda(d) {
            if (d.Estado === 'pagada' || d.Estado === 'cancelada') return d.Estado;
            return d.Estado || 'pendiente';
        }

        async function sincronizarVencidas() {
            // Función conservada por compatibilidad, ya no aplica.
            console.info('Las deudas no se vencen; sincronización no necesaria.');
        }

        async function cargarDeudas() {
            try {
                // Solo deudas pendientes en la vista de caja
                const response = await fetch(`${API_URL}/Deudas?incluirPagadas=false&porPagina=500`);
                const data = await response.json();

                if (!data.success) {
                    document.getElementById('lista-deudas').innerHTML =
                        '<div class="text-center py-12 text-red-500 font-bold">Error al cargar deudas</div>';
                    return;
                }

                // Compatible con ambas formas de respuesta (items o data)
                deudasData = (data.items || data.data || []).map(d => {
                    d._estadoReal = calcularEstadoRealDeuda(d);
                    return d;
                });

                actualizarResumenDeudas();
                renderDeudas(deudasData);
                lucide.createIcons();
            } catch (error) {
                console.error('Error cargando deudas:', error);
            }
        }

        function actualizarResumenDeudas() {
            const pendientes = deudasData.filter(d => d._estadoReal === 'pendiente');
            const totalSaldo = pendientes.reduce((s, d) => s + (d.Saldo || 0), 0);

            const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
            set('rv-deuda-total',     `$${totalSaldo.toFixed(2)}`);
            set('rs-deuda-total',     `${pendientes.length} deudas`);
            set('rv-deuda-pendiente', `$${totalSaldo.toFixed(2)}`);
            set('rs-deuda-pendiente', `${pendientes.length} ${pendientes.length === 1 ? 'deuda' : 'deudas'}`);

            const dpEl = document.getElementById('deudas-pendientes');
            if (dpEl) dpEl.textContent = `$${totalSaldo.toFixed(2)}`;
        }

        function filtroEstadoDeuda(estado) {
            _filtroEstadoDeuda = estado;
            document.querySelectorAll('.ftd-btn').forEach(b => {
                b.classList.remove('bg-[#0D0D20]', 'shadow', 'text-red-600');
                b.classList.add('text-white/40');
            });
            const mapTab = { '': 'ft-d-todos', 'pendiente': 'ft-d-pendiente' };
            if (mapTab[estado]) {
                const el = document.getElementById(mapTab[estado]);
                if (el) {
                    el.classList.add('bg-[#0D0D20]', 'shadow', 'text-red-600');
                    el.classList.remove('text-white/40');
                }
            }
            renderDeudas(deudasData);
        }

        function debounceBusquedaDeuda(val) {
            _busquedaDeuda = val;
            clearTimeout(_debounceDeuda);
            _debounceDeuda = setTimeout(() => renderDeudas(deudasData), 300);
        }

        // Mantener compatibilidad con onkeyup="filtrarDeudas()"
        function filtrarDeudas() {
            _busquedaDeuda = (document.getElementById('buscar-deuda') || {}).value || '';
            renderDeudas(deudasData);
        }

        function chipEstadoDeuda(estado) {
            if (estado === 'pagada')    return '<span class="px-3 py-1 rounded-full text-xs font-black uppercase bg-green-100 text-green-800">✓ Pagada</span>';
            if (estado === 'cancelada') return '<span class="px-3 py-1 rounded-full text-xs font-black uppercase bg-white/5 text-white/50">Cancelada</span>';
            return '<span class="px-3 py-1 rounded-full text-xs font-black uppercase bg-amber-100 text-amber-800">Pendiente</span>';
        }

        function infoVencimientoDeuda(d) {
            if (!d.FechaVencimiento) return '';
            const fechaStr = formatearFechaUTC(d.FechaVencimiento);
            return `<p class="text-xs text-white/30 font-semibold mt-1"><i data-lucide="calendar" class="w-3 h-3 inline-block mr-1"></i>Fecha límite: ${fechaStr}</p>`;
        }

        function renderDeudas(deudas) {
            const container = document.getElementById('lista-deudas');

            // Aplicar filtro de estado
            let filtradas = deudas;
            if (_filtroEstadoDeuda) {
                filtradas = deudas.filter(d => d._estadoReal === _filtroEstadoDeuda);
            }

            // Aplicar búsqueda
            if (_busquedaDeuda.trim()) {
                const q = _busquedaDeuda.toLowerCase();
                filtradas = filtradas.filter(d =>
                    (d.clienteNombre || d.cliente?.nombre || '').toLowerCase().includes(q) ||
                    (d.clienteCedula || d.cliente?.cedula || '').toLowerCase().includes(q) ||
                    (d.Concepto || d.concepto || '').toLowerCase().includes(q)
                );
            }

            if (filtradas.length === 0) {
                container.innerHTML = `
                    <div class="bg-[#0D0D20] rounded-2xl shadow-xl p-12 text-center border-2 border-white/8">
                        <i data-lucide="inbox" class="w-16 h-16 mx-auto text-white/30 mb-4"></i>
                        <p class="text-xl font-black text-white uppercase">Sin resultados</p>
                        <p class="text-white/50 mt-2 font-semibold">Prueba ajustando los filtros</p>
                    </div>`;
                lucide.createIcons();
                return;
            }

            // ── Agrupar por cliente ──────────────────────────────────────
            const grupos = new Map();
            filtradas.forEach(d => {
                const cid    = d.cliente?.Id || d.cliente?.id || d.ClienteId || d.clienteId || 'sin-cliente';
                const nombre = d.clienteNombre || d.cliente?.nombre || '—';
                const cedula = d.clienteCedula || d.cliente?.cedula || '—';
                if (!grupos.has(cid)) grupos.set(cid, { cid, nombre, cedula, deudas: [] });
                grupos.get(cid).deudas.push(d);
            });

            container.innerHTML = [...grupos.values()].map(({ cid, nombre, cedula, deudas: deudasCliente }) => {

                // Totales del cliente
                const totalSaldo  = deudasCliente.reduce((s, d) => s + (d.Saldo || d.saldo || 0), 0);
                const totalDeuda  = deudasCliente.reduce((s, d) => s + (d.MontoTotal || d.montoTotal || 0), 0);
                const iniciales   = nombre.split(' ').filter(Boolean).map(n => n[0]).join('').substring(0,2).toUpperCase() || '?';

                // Filas de deudas internas
                const filasDeudas = deudasCliente.map(deuda => {
                    const concepto  = deuda.Concepto    || deuda.concepto    || '—';
                    const total     = deuda.MontoTotal   || deuda.montoTotal  || 0;
                    const pagado    = deuda.MontoPagado  || deuda.montoPagado || 0;
                    const saldo     = deuda.Saldo        || deuda.saldo       || 0;
                    const id        = deuda.Id           || deuda.id;
                    const estado    = deuda._estadoReal;
                    const pct       = total > 0 ? Math.min(100, (pagado / total) * 100) : 0;
                    const fechaStr  = deuda.FechaCreacion || deuda.fechaCreacion
                        ? formatearFechaUTC(deuda.FechaCreacion || deuda.fechaCreacion)
                        : '—';

                    return `
                    <div class="border border-white/5 rounded-xl p-4 bg-[#111428] hover:bg-[#0D0D20] transition-colors">
                        <div class="flex items-start justify-between gap-3 flex-wrap">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1 flex-wrap">
                                    <span class="text-sm font-black text-white">${concepto}</span>
                                    ${chipEstadoDeuda(estado)}
                                </div>
                                <div class="flex items-center gap-4 text-xs text-white/40 font-semibold mb-2">
                                    <span><i data-lucide="calendar" class="w-3 h-3 inline-block mr-1"></i>${fechaStr}</span>
                                </div>
                                <div class="flex items-center gap-4 flex-wrap">
                                    <span class="text-xs text-white/40 font-semibold">Total: <span class="text-white font-black">$${total.toFixed(2)}</span></span>
                                    <span class="text-xs text-white/40 font-semibold">Pagado: <span class="text-emerald-600 font-black">$${pagado.toFixed(2)}</span></span>
                                    <span class="text-xs text-white/40 font-semibold">Saldo: <span class="text-red-600 font-black text-sm">$${saldo.toFixed(2)}</span></span>
                                </div>
                                <!-- Barra de progreso -->
                                <div class="w-full bg-white/8 rounded-full h-1.5 mt-2">
                                    <div class="h-1.5 rounded-full ${pct >= 100 ? 'bg-emerald-500' : 'bg-red-400'}" style="width:${pct.toFixed(1)}%"></div>
                                </div>
                            </div>
                            <div class="flex flex-col gap-1.5 flex-shrink-0">
                                <button onclick="abrirModalAbonar('${id}')"
                                        class="px-4 py-2 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white text-xs font-black rounded-lg transition-all shadow uppercase">
                                    <i data-lucide="dollar-sign" class="w-3.5 h-3.5 inline-block mr-1"></i>Abonar
                                </button>
                                <button onclick="pagarCompleto('${id}')"
                                        class="px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white text-xs font-black rounded-lg transition-all shadow uppercase">
                                    <i data-lucide="check-circle" class="w-3.5 h-3.5 inline-block mr-1"></i>Pagar Todo
                                </button>
                            </div>
                        </div>
                    </div>`;
                }).join('');

                return `
                <div class="bg-[#0D0D20] rounded-2xl shadow-xl border-2 border-white/8 hover:shadow-2xl transition-shadow overflow-hidden">
                    <!-- Cabecera del cliente -->
                    <div class="p-5 border-b border-white/5 flex items-center justify-between gap-4 flex-wrap">
                        <div class="flex items-center gap-3">
                            <div class="w-11 h-11 rounded-full bg-blue-500/10 text-[#3D8EFF] font-black text-sm flex items-center justify-center flex-shrink-0">
                                ${iniciales}
                            </div>
                            <div>
                                <h3 class="text-lg font-black text-white uppercase tracking-wide leading-tight">${nombre}</h3>
                                <p class="text-xs text-white/40 font-semibold">Cédula: ${cedula}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 flex-wrap">
                            <div class="text-right">
                                <p class="text-xs text-white/40 font-bold uppercase">Saldo total</p>
                                <p class="text-xl font-black text-red-600">$${totalSaldo.toFixed(2)}</p>
                                <p class="text-xs text-white/30 font-semibold">${deudasCliente.length} deuda${deudasCliente.length !== 1 ? 's' : ''} pendiente${deudasCliente.length !== 1 ? 's' : ''}</p>
                            </div>
                            <a href="/Caja/Historial?clienteId=${cid}"
                               class="px-4 py-2 bg-gradient-to-r from-[#1E6FE3] to-[#1550B0] hover:from-[#1550B0] hover:to-[#0d3d8a] text-white text-xs font-black rounded-xl transition-all shadow uppercase flex items-center gap-1.5">
                                <i data-lucide="history" class="w-3.5 h-3.5"></i>Historial
                            </a>
                        </div>
                    </div>
                    <!-- Deudas del cliente -->
                    <div class="p-4 space-y-3">
                        ${filasDeudas}
                    </div>
                </div>`;
            }).join('');

            lucide.createIcons();
        }

        function abrirModalAbonar(deudaId) {
            const deuda = deudasData.find(d => (d.Id || d.id) === deudaId);
            if (!deuda) return;

            deudaSeleccionada = deuda;
            const nombre  = deuda.clienteNombre || deuda.cliente?.nombre || '—';
            const concepto = deuda.Concepto || deuda.concepto || '—';
            const saldo   = deuda.Saldo || deuda.saldo || 0;

            document.getElementById('modal-cliente-nombre').textContent = nombre;
            document.getElementById('modal-concepto').textContent = concepto;
            document.getElementById('modal-saldo').textContent = `$${saldo.toFixed(2)}`;
            document.getElementById('input-monto-abono').value = saldo.toFixed(2);
            document.getElementById('modalAbonarDeuda').classList.remove('hidden');
            lucide.createIcons();
        }

        function cerrarModalAbonar() {
            document.getElementById('modalAbonarDeuda').classList.add('hidden');
            deudaSeleccionada = null;
        }

        async function confirmarAbono() {
            const monto       = parseFloat(document.getElementById('input-monto-abono').value);
            const metodo      = document.getElementById('input-metodo-abono').value;
            const saldoActual = deudaSeleccionada.Saldo || deudaSeleccionada.saldo || 0;
            const deudaId     = deudaSeleccionada.Id   || deudaSeleccionada.id;
            const concepto    = deudaSeleccionada.Concepto || deudaSeleccionada.concepto || '';
            const clienteNom  = document.getElementById('modal-cliente-nombre')?.textContent || '';

            if (isNaN(monto) || monto <= 0) { mostrarToast('El monto es inválido', 'error'); return; }
            if (monto > saldoActual)         { mostrarToast('El monto no puede superar el saldo pendiente', 'error'); return; }

            // Loading
            const btn = document.querySelector('#modalAbonarDeuda button[onclick="confirmarAbono()"]');
            if (btn) { btn.disabled = true; btn.textContent = 'Registrando…'; }
            document.getElementById('modalAbonarDeuda').classList.add('hidden');

            const loadingEl = document.getElementById('modalLoadingMovimiento');
            document.getElementById('loadingMovSpinner').style.color = '#16a34a';
            document.getElementById('loadingMovBar').style.background = '#16a34a';
            document.getElementById('loadingMovTitulo').textContent = 'Registrando Abono';
            document.getElementById('loadingMovMsg').textContent = 'Guardando el pago en el sistema...';
            loadingEl.classList.remove('hidden');

            let result = null;
            let intentos = 0;
            while (intentos < 2) {
                try {
                    const r = await fetch(`${API_URL}/Deudas/abonar`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ deudaId, monto, metodoPago: metodo, notas: `Abono a deuda - ${concepto}` })
                    });
                    if (!r.ok) { const err = await r.json().catch(() => ({})); throw new Error(err.message || `Error HTTP ${r.status}`); }
                    result = await r.json();
                    if (!result.success) throw new Error(result.message || 'Error desconocido');
                    break;
                } catch (err) {
                    intentos++;
                    if (intentos < 2) {
                        document.getElementById('loadingMovMsg').textContent = 'Reintentando...';
                        await new Promise(r => setTimeout(r, 800));
                    } else {
                        loadingEl.classList.add('hidden');
                        if (btn) { btn.disabled = false; btn.textContent = 'Confirmar'; }
                        document.getElementById('modalAbonarDeuda').classList.remove('hidden');
                        mostrarToast('Error al registrar abono: ' + err.message, 'error');
                        return;
                    }
                }
            }

            loadingEl.classList.add('hidden');
            deudaSeleccionada = null;

            // Modal de detalle
            const ahora = new Date();
            document.getElementById('detalleMovHeader').className = 'px-8 py-6 rounded-t-3xl text-center text-white bg-gradient-to-r from-green-600 to-green-800';
            document.getElementById('detalleMovTitulo').textContent = '¡Abono Registrado!';
            document.getElementById('detalleMovFecha').textContent = ahora.toLocaleString('es');
            document.getElementById('detalleMovMonto').textContent = '$' + monto.toFixed(2);
            document.getElementById('detalleMovMonto').className = 'text-3xl font-black text-green-600';
            document.getElementById('detalleMovCategoria').textContent = 'Abono a deuda · ' + (concepto || clienteNom);
            document.getElementById('detalleMovMetodo').textContent = metodo;
            document.getElementById('detalleMovDescripcion').textContent = `Saldo anterior: $${saldoActual.toFixed(2)} → Saldo nuevo: $${(saldoActual - monto).toFixed(2)}`;
            document.getElementById('modalDetalleMovimiento').classList.remove('hidden');
            lucide.createIcons();
        }

        async function pagarCompleto(deudaId) {
            const deuda = deudasData.find(d => (d.Id || d.id) === deudaId);
            if (!deuda) return;
            const saldo   = deuda.Saldo   || deuda.saldo   || 0;
            const concepto = deuda.Concepto || deuda.concepto || '';
            const clienteNomPago = deuda.ClienteNombre || deuda.clienteNombre || '';

            // Loading inmediato, sin confirm bloqueante
            const loadingEl = document.getElementById('modalLoadingMovimiento');
            document.getElementById('loadingMovSpinner').style.color = '#16a34a';
            document.getElementById('loadingMovBar').style.background = '#16a34a';
            document.getElementById('loadingMovTitulo').textContent = 'Pagando Deuda Completa';
            document.getElementById('loadingMovMsg').textContent = 'Registrando el pago en el sistema...';
            loadingEl.classList.remove('hidden');

            let result = null;
            let intentos = 0;
            while (intentos < 2) {
                try {
                    const response = await fetch(`${API_URL}/Deudas/abonar`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ deudaId: deuda.Id || deuda.id, monto: saldo, metodoPago: 'efectivo', notas: 'Pago completo de deuda' })
                    });
                    if (!response.ok) { const err = await response.json().catch(() => ({})); throw new Error(err.message || `Error HTTP ${response.status}`); }
                    result = await response.json();
                    if (!result.success) throw new Error(result.message || 'Error desconocido');
                    break;
                } catch (err) {
                    intentos++;
                    if (intentos < 2) {
                        document.getElementById('loadingMovMsg').textContent = 'Reintentando...';
                        await new Promise(r => setTimeout(r, 800));
                    } else {
                        loadingEl.classList.add('hidden');
                        mostrarToast('Error al pagar deuda: ' + err.message, 'error');
                        return;
                    }
                }
            }

            loadingEl.classList.add('hidden');

            // Modal de detalle
            const ahora = new Date();
            document.getElementById('detalleMovHeader').className = 'px-8 py-6 rounded-t-3xl text-center text-white bg-gradient-to-r from-emerald-600 to-emerald-800';
            document.getElementById('detalleMovTitulo').textContent = '¡Deuda Pagada!';
            document.getElementById('detalleMovFecha').textContent = ahora.toLocaleString('es');
            document.getElementById('detalleMovMonto').textContent = '$' + saldo.toFixed(2);
            document.getElementById('detalleMovMonto').className = 'text-3xl font-black text-emerald-600';
            document.getElementById('detalleMovCategoria').textContent = 'Pago completo · ' + (concepto || clienteNomPago);
            document.getElementById('detalleMovMetodo').textContent = 'Efectivo';
            document.getElementById('detalleMovDescripcion').textContent = 'Deuda saldada al 100%. Saldo restante: $0.00';
            document.getElementById('modalDetalleMovimiento').classList.remove('hidden');
            lucide.createIcons();
        }


        // ========================================
        // DÍAS PENDIENTES
        // ========================================
        async function cargarDiasPendientes() {
            try {
                const response = await fetch(`${API_URL}/Caja/pendientes`);
                const data = await response.json();

                const container = document.getElementById('lista-dias-pendientes');

                if (data.success && data.diasPendientes && data.diasPendientes.length > 0) {
                    container.innerHTML = data.diasPendientes.map(dia => {
                        const balanceColor = dia.balance >= 0 ? 'text-emerald-600' : 'text-red-600';

                        return `
                            <div class="bg-gradient-to-r from-[#111428] to-[#0D0D20] rounded-xl p-6 border-l-4 border-yellow-500 shadow-lg">
                                <div class="flex items-center justify-between mb-4">
                                    <div>
                                        <h4 class="text-lg font-black text-white">
                                            ${formatearFechaLargaUTC(dia.fecha)}
                                        </h4>
                                        <p class="text-sm text-white/50 font-semibold">
                                            ${dia.cantidadMovimientos} movimientos sin cerrar
                                        </p>
                                    </div>
                                    <button onclick="abrirModalCerrarDia('${dia.fecha}', ${dia.cantidadMovimientos}, ${dia.balance})"
                                            class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold rounded-lg transition-all">
                                        <i data-lucide="lock" class="w-4 h-4 inline-block mr-1"></i>
                                        Cerrar Día
                                    </button>
                                </div>
                                <div class="grid grid-cols-3 gap-4">
                                    <div class="bg-blue-50 rounded-lg p-3">
                                        <p class="text-xs text-blue-700 font-bold mb-1">Ingresos</p>
                                        <p class="text-lg font-black text-blue-600">$${dia.totalIngresos.toFixed(2)}</p>
                                    </div>
                                    <div class="bg-red-50 rounded-lg p-3">
                                        <p class="text-xs text-red-700 font-bold mb-1">Egresos</p>
                                        <p class="text-lg font-black text-red-600">$${dia.totalEgresos.toFixed(2)}</p>
                                    </div>
                                    <div class="bg-emerald-50 rounded-lg p-3">
                                        <p class="text-xs text-emerald-700 font-bold mb-1">Balance</p>
                                        <p class="text-lg font-black ${balanceColor}">$${dia.balance.toFixed(2)}</p>
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');
                    lucide.createIcons();
                } else {
                    container.innerHTML = `
                        <div class="bg-emerald-50 rounded-2xl p-12 text-center border-2 border-emerald-200">
                            <i data-lucide="check-circle" class="w-16 h-16 text-emerald-500 mx-auto mb-4"></i>
                            <h3 class="text-xl font-black text-emerald-800 mb-2">¡Todo al día!</h3>
                            <p class="text-emerald-700 font-semibold">No hay días pendientes por cerrar</p>
                        </div>
                    `;
                    lucide.createIcons();
                }
            } catch (error) {
                console.error('Error al cargar días pendientes:', error);
            }
        }

        function abrirModalCerrarDia(fecha, cantidadMovimientos, balance) {
            fechaDiaCerrar = fecha;
            const fechaObj = new Date(fecha);
            document.getElementById('modal-fecha-cerrar').textContent =
                fechaObj.toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            document.getElementById('modal-cantidad-movimientos').textContent = cantidadMovimientos;
            document.getElementById('modal-balance-dia').textContent = `$${balance.toFixed(2)}`;
            document.getElementById('modalCerrarDiaEspecifico').classList.remove('hidden');
            lucide.createIcons();
        }

        function cerrarModalDiaEspecifico() {
            document.getElementById('modalCerrarDiaEspecifico').classList.add('hidden');
            fechaDiaCerrar = null;
        }

        async function confirmarCierreDiaEspecifico() {
            try {
                const observaciones = document.getElementById('input-observaciones-cierre-dia').value;

                // Extraer solo la fecha (YYYY-MM-DD) sin la hora
                const soloFecha = fechaDiaCerrar.split('T')[0];

                const response = await fetch(`${API_URL}/Caja/cerrar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fecha: soloFecha,
                        observaciones
                    })
                });

                const data = await response.json();

                if (data.success) {
                    alert(`✅ ${data.message}`);
                    cerrarModalDiaEspecifico();
                    cargarResumen();
                    cargarDiasPendientes();
                } else {
                    alert(`❌ ${data.message}`);
                }
            } catch (error) {
                console.error('Error al cerrar día:', error);
                alert('❌ Error al cerrar el día');
            }
        }

         document.querySelectorAll('input[type="number"]').forEach(function(input) {
            input.addEventListener('wheel', function(e) {
                e.preventDefault();
            }, { passive: false });
        });


        // ========================================
        // INICIALIZACIÓN
        // ========================================
        window.addEventListener('load', function() {
            // Establecer fecha de hoy en los filtros (usando hora local, NO UTC)
            const fechaHoy = obtenerFechaLocalISO();

            document.getElementById('fecha-desde').value = fechaHoy;
            document.getElementById('fecha-hasta').value = fechaHoy;

            cargarResumen();
            cargarMovimientos();
            lucide.createIcons();
        });

        // Asignar funciones globales
        window.cambiarTab = cambiarTab;
        window.cargarMovimientos = cargarMovimientos;
        window.cargarResumenSemanal = cargarResumenSemanal;
        window.cargarHistorialCierres = cargarHistorialCierres;
        window.abrirModalCerrarCaja = abrirModalCerrarCaja;
        window.cerrarModalCerrarCaja = cerrarModalCerrarCaja;
        function mostrarToast(mensaje, tipo) {
            const colores = { error: 'bg-red-600', success: 'bg-green-600', info: 'bg-blue-600' };
            const color = colores[tipo] || 'bg-[#111428]';
            const toast = document.createElement('div');
            toast.className = `fixed bottom-6 right-6 z-[100] ${color} text-white px-6 py-4 rounded-2xl shadow-2xl font-bold text-sm flex items-center gap-3`;
            toast.innerHTML = `<span>${mensaje}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.4s'; setTimeout(() => toast.remove(), 400); }, 4000);
        }

        function cerrarDetalleMovimiento() {
            document.getElementById('modalDetalleMovimiento').classList.add('hidden');
            cargarResumen();
            cargarMovimientos();
            cambiarTab('movimientos');
        }

        window.cerrarDetalleMovimiento = cerrarDetalleMovimiento;
        window.confirmarCierreCaja = confirmarCierreCaja;
        window.registrarIngreso = registrarIngreso;
        window.registrarEgreso = registrarEgreso;
        window.cargarDeudas = cargarDeudas;
        window.filtrarDeudas = filtrarDeudas;
        window.abrirModalAbonar = abrirModalAbonar;
        window.cerrarModalAbonar = cerrarModalAbonar;
        window.confirmarAbono = confirmarAbono;
        window.pagarCompleto = pagarCompleto;
    </script>
}

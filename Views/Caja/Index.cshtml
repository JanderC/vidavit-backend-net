@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Caja";
    ViewData["Subtitle"] = "Control financiero completo -  ELITE GYM";
}

<div class="space-y-6">
    <!-- ALERTA DE DÍAS PENDIENTES -->
    <div id="alerta-dias-pendientes" class="hidden bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded-lg shadow-lg">
        <div class="flex items-center">
            <div class="flex-shrink-0">
                <i data-lucide="alert-triangle" class="w-6 h-6 text-yellow-600"></i>
            </div>
            <div class="ml-3 flex-1">
                <p class="text-sm font-bold text-yellow-800">
                    ⚠️ Hay <span id="cantidad-dias-pendientes">0</span> día(s) anterior(es) con movimientos sin cerrar
                </p>
                <p class="text-xs text-yellow-700 mt-1">
                    Se recomienda cerrar los días anteriores antes de continuar
                </p>
            </div>
            <button onclick="cambiarTab('pendientes')" class="ml-4 px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white text-sm font-bold rounded-lg transition-all">
                Ver Días Pendientes
            </button>
        </div>
    </div>

    <!-- RESUMEN GENERAL DE CAJA -->
    <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
        <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-2xl shadow-xl p-6 border-l-4 border-emerald-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-emerald-700 font-black uppercase tracking-wide mb-1">Efectivo Hoy</p>
                    <p class="text-3xl font-black text-emerald-600" id="efectivo-hoy">$0.00</p>
                    <p class="text-xs text-emerald-600 font-semibold mt-1">Balance en efectivo</p>
                </div>
                <div class="w-12 h-12 bg-emerald-200 rounded-full flex items-center justify-center">
                    <i data-lucide="wallet" class="w-6 h-6 text-emerald-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl shadow-xl p-6 border-l-4 border-purple-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-purple-700 font-black uppercase tracking-wide mb-1">Transferencias Hoy</p>
                    <p class="text-3xl font-black text-purple-600" id="transferencias-hoy">$0.00</p>
                    <p class="text-xs text-purple-600 font-semibold mt-1" id="detalle-transferencias">Ingresos del día</p>
                </div>
                <div class="w-12 h-12 bg-purple-200 rounded-full flex items-center justify-center">
                    <i data-lucide="credit-card" class="w-6 h-6 text-purple-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl shadow-xl p-6 border-l-4 border-blue-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-blue-700 font-black uppercase tracking-wide mb-1">Ingresos Hoy</p>
                    <p class="text-3xl font-black text-blue-600" id="ingresos-hoy">$0.00</p>
                    <p class="text-xs text-blue-600 font-semibold mt-1" id="detalle-ingresos">Efectivo + Transferencia</p>
                </div>
                <div class="w-12 h-12 bg-blue-200 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-6 h-6 text-blue-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-2xl shadow-xl p-6 border-l-4 border-red-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-red-700 font-black uppercase tracking-wide mb-1">Egresos Hoy</p>
                    <p class="text-3xl font-black text-red-600" id="egresos-hoy">$0.00</p>
                    <p class="text-xs text-red-600 font-semibold mt-1" id="detalle-egresos">Efectivo + Transferencia</p>
                </div>
                <div class="w-12 h-12 bg-red-200 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-down" class="w-6 h-6 text-red-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-amber-50 to-amber-100 rounded-2xl shadow-xl p-6 border-l-4 border-amber-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-amber-700 font-black uppercase tracking-wide mb-1">Deudas Pendientes</p>
                    <p class="text-3xl font-black text-amber-600" id="deudas-pendientes">$0.00</p>
                    <p class="text-xs text-amber-600 font-semibold mt-1">Total por cobrar</p>
                </div>
                <div class="w-12 h-12 bg-amber-200 rounded-full flex items-center justify-center">
                    <i data-lucide="alert-circle" class="w-6 h-6 text-amber-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl shadow-xl p-6 border-l-4 border-slate-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-700 font-black uppercase tracking-wide mb-1">Balance Total</p>
                    <p class="text-3xl font-black text-slate-600" id="balance-total">$0.00</p>
                    <button onclick="abrirModalCerrarCaja()"
                            class="mt-2 px-3 py-1 bg-slate-600 hover:bg-slate-700 text-white text-xs font-bold rounded-lg transition-all">
                        <i data-lucide="lock" class="w-3 h-3 inline-block mr-1"></i>
                        CERRAR CAJA
                    </button>
                </div>
                <div class="w-12 h-12 bg-slate-200 rounded-full flex items-center justify-center">
                    <i data-lucide="calculator" class="w-6 h-6 text-slate-600"></i>
                </div>
            </div>
        </div>
    </div>


    <!-- DESGLOSE DE VENTAS DEL DÍA -->
    <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
        <h3 class="text-lg font-black text-gray-800 mb-4 uppercase tracking-wide flex items-center gap-2">
            <i data-lucide="pie-chart" class="w-5 h-5 text-blue-600"></i>
            Desglose de Ventas del Día
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-xl p-4 border border-red-200">
                <p class="text-xs text-red-700 font-bold uppercase mb-1">Membresías</p>
                <p class="text-2xl font-black text-red-600" id="venta-membresias">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-amber-50 to-amber-100 rounded-xl p-4 border border-amber-200">
                <p class="text-xs text-amber-700 font-bold uppercase mb-1">Productos</p>
                <p class="text-2xl font-black text-amber-600" id="venta-productos">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-xl p-4 border border-emerald-200">
                <p class="text-xs text-emerald-700 font-bold uppercase mb-1">Abonos a Deudas</p>
                <p class="text-2xl font-black text-emerald-600" id="venta-abonos">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-4 border border-blue-200">
                <p class="text-xs text-blue-700 font-bold uppercase mb-1">Otros</p>
                <p class="text-2xl font-black text-blue-600" id="venta-otros">$0.00</p>
            </div>
        </div>
    </div>


    <!-- TABS DE NAVEGACIÓN -->
    <div class="bg-white rounded-2xl shadow-xl border-2 border-gray-200 overflow-hidden">
        <div class="flex border-b-2 border-gray-200">
            <button onclick="cambiarTab('movimientos')" id="tab-movimientos"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all border-b-4 border-red-600 bg-red-50 text-red-600">
                <i data-lucide="list" class="w-5 h-5 inline-block mr-2"></i>
                Movimientos
            </button>
            <button onclick="cambiarTab('pendientes')" id="tab-pendientes"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-gray-50">
                <i data-lucide="calendar-clock" class="w-5 h-5 inline-block mr-2"></i>
                Días Pendientes
            </button>
            <button onclick="cambiarTab('deudas')" id="tab-deudas"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-gray-50">
                <i data-lucide="file-text" class="w-5 h-5 inline-block mr-2"></i>
                Deudas Clientes
            </button>
            <button onclick="cambiarTab('semanal')" id="tab-semanal"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-gray-50">
                <i data-lucide="calendar" class="w-5 h-5 inline-block mr-2"></i>
                Resumen Semanal
            </button>
            <button onclick="cambiarTab('cierres')" id="tab-cierres"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-gray-50">
                <i data-lucide="archive" class="w-5 h-5 inline-block mr-2"></i>
                Historial Cierres
            </button>
            <button onclick="cambiarTab('registrar')" id="tab-registrar"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-gray-50">
                <i data-lucide="plus-circle" class="w-5 h-5 inline-block mr-2"></i>
                Registrar
            </button>
        </div>
    </div>

    <!-- TAB: MOVIMIENTOS -->
    <div id="content-movimientos" class="tab-content">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200 mb-4">
            <div class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Desde</label>
                    <input type="date" id="fecha-desde"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Fecha Hasta</label>
                    <input type="date" id="fecha-hasta"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">Categoría</label>
                    <select id="filtro-categoria"
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                        <option value="">Todas</option>
                        <option value="membresia">Membresías</option>
                        <option value="renovacion">Renovaciones</option>
                        <option value="producto">Productos</option>
                        <option value="abono_deuda">Abonos Deuda</option>
                        <option value="otro">Otros</option>
                    </select>
                </div>
                <button onclick="cargarMovimientos()"
                        class="px-8 py-3 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                    <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                    Filtrar
                </button>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-gray-200">
            <div class="p-4 border-b-2 border-gray-200 bg-gray-50">
                <h3 class="text-xl font-black uppercase tracking-wide text-gray-900">Historial de Movimientos</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-100 border-b-2 border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Fecha</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Tipo</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Categoría</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Descripción</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-gray-700 uppercase tracking-wider">Método</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-gray-700 uppercase tracking-wider">Monto</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-movimientos" class="divide-y divide-gray-200">
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-gray-500 font-bold">
                                Cargando movimientos...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    <!-- TAB: DÍAS PENDIENTES -->
    <div id="content-pendientes" class="tab-content hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
            <h3 class="text-xl font-black text-gray-900 uppercase tracking-wide mb-6">
                <i data-lucide="calendar-clock" class="w-6 h-6 inline-block mr-2 text-yellow-600"></i>
                Días con Movimientos Sin Cerrar
            </h3>
            <div id="lista-dias-pendientes" class="space-y-4">
                <p class="text-center text-gray-500 font-semibold py-8">Cargando...</p>
            </div>
        </div>
    </div>

    <!-- TAB: DEUDAS CLIENTES -->
    <div id="content-deudas" class="tab-content hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200 mb-4">
            <input type="text" id="buscar-deuda" placeholder="Buscar cliente..."
                   class="w-full px-5 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold"
                   onkeyup="filtrarDeudas()">
        </div>

        <div id="lista-deudas" class="space-y-4">
            <div class="text-center py-12 text-gray-500 font-bold">
                Cargando deudas...
            </div>
        </div>
    </div>

    <!-- TAB: RESUMEN SEMANAL -->
    <!-- TAB: RESUMEN SEMANAL -->
    <div id="content-semanal" class="tab-content hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-black text-gray-800 uppercase tracking-wide flex items-center gap-2">
                    <i data-lucide="calendar-range" class="w-6 h-6 text-blue-600"></i>
                    Resumen de los Últimos 7 Días
                </h3>
                <p class="text-sm text-gray-600 font-bold" id="periodo-semanal">Cargando...</p>
            </div>

            <!-- TABLA -->
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead class="bg-gradient-to-r from-red-600 to-red-700 text-white">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-black uppercase">Día</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Ingresos</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Egresos</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Balance</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Efectivo</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Transferencia</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase bg-amber-600">
                                <i data-lucide="shopping-bag" class="w-4 h-4 inline-block mr-1"></i>
                                Productos Vendidos
                            </th>
                            <th class="px-6 py-4 text-center text-sm font-black uppercase">Movimientos</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-resumen-semanal" class="divide-y divide-gray-200">
                        <!-- Los datos se cargan dinámicamente con JavaScript -->
                    </tbody>
                    <tfoot class="bg-gray-50 border-t-2 border-gray-300">
                        <tr>
                            <td class="px-6 py-4 text-sm font-black uppercase text-gray-900">TOTAL</td>
                            <td class="px-6 py-4 text-right text-xl font-black text-blue-600" id="total-ingresos-semana">$0.00</td>
                            <td class="px-6 py-4 text-right text-xl font-black text-red-600" id="total-egresos-semana">$0.00</td>
                            <td class="px-6 py-4 text-right text-xl font-black text-emerald-600" id="balance-semana">$0.00</td>
                            <td class="px-6 py-4" colspan="2"></td>
                            <td class="px-6 py-4 text-right text-xl font-black text-amber-600 bg-amber-50" id="total-productos-semana">$0.00</td>
                            <td class="px-6 py-4 text-center">
                                <span class="px-3 py-1 bg-purple-100 text-purple-800 text-xs font-bold rounded-full" id="cantidad-movimientos-semana">0</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <!-- TAB: HISTORIAL CIERRES -->
    <div id="content-cierres" class="tab-content hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-gray-200 mb-4">
            <div class="flex items-center justify-between">
                <h3 class="text-2xl font-black text-gray-900 uppercase tracking-wide">Historial de Cierres de Caja</h3>
                <button onclick="cargarHistorialCierres()"
                        class="px-6 py-2 bg-gradient-to-r from-purple-600 to-purple-800 hover:from-purple-700 hover:to-purple-900 text-white font-black rounded-xl transition-all shadow-xl">
                    <i data-lucide="refresh-cw" class="w-4 h-4 inline-block mr-2"></i>
                    Actualizar
                </button>
            </div>
        </div>

        <div id="lista-cierres" class="space-y-4">
            <div class="bg-white rounded-2xl shadow-xl p-8 text-center border-2 border-gray-200">
                <p class="text-gray-500 font-bold">Cargando historial...</p>
            </div>
        </div>
    </div>

    <!-- TAB: REGISTRAR -->
    <div id="content-registrar" class="tab-content hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Formulario de Ingreso -->
            <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-green-200">
                <h3 class="text-2xl font-black text-green-700 mb-6 uppercase tracking-wide flex items-center">
                    <i data-lucide="plus-circle" class="w-6 h-6 mr-2"></i>
                    Registrar Ingreso
                </h3>
                <form onsubmit="registrarIngreso(event)" class="space-y-4">
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Categoría</label>
                        <select id="ingreso-categoria" required
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-600 focus:border-green-600 font-semibold">
                            <option value="membresia">Membresía</option>
                            <option value="renovacion">Renovación</option>
                            <option value="producto">Producto</option>
                            <option value="abono_deuda">Abono Deuda</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Monto</label>
                        <input type="number" id="ingreso-monto" step="0.01" required
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-600 focus:border-green-600 font-semibold"
                               placeholder="0.00">
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Método de Pago</label>
                        <select id="ingreso-metodo" required
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-600 focus:border-green-600 font-semibold">
                            <option value="efectivo">Efectivo</option>
                            <option value="transferencia">Transferencia</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Descripción</label>
                        <textarea id="ingreso-descripcion" rows="3" required
                                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-600 focus:border-green-600 font-semibold"
                                  placeholder="Detalles del ingreso"></textarea>
                    </div>
                    <button type="submit"
                            class="w-full py-4 bg-gradient-to-r from-green-600 to-green-800 hover:from-green-700 hover:to-green-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                        <i data-lucide="check-circle" class="w-5 h-5 inline-block mr-2"></i>
                        Registrar Ingreso
                    </button>
                </form>
            </div>

            <!-- Formulario de Egreso -->
            <div class="bg-white rounded-2xl shadow-xl p-6 border-2 border-red-200">
                <h3 class="text-2xl font-black text-red-700 mb-6 uppercase tracking-wide flex items-center">
                    <i data-lucide="minus-circle" class="w-6 h-6 mr-2"></i>
                    Registrar Egreso
                </h3>
                <form onsubmit="registrarEgreso(event)" class="space-y-4">
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Categoría</label>
                        <select id="egreso-categoria" required
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                            <option value="salario">Salario</option>
                            <option value="servicio">Servicio</option>
                            <option value="compra">Compra</option>
                            <option value="mantenimiento">Mantenimiento</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Monto</label>
                        <input type="number" id="egreso-monto" step="0.01" required
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold"
                               placeholder="0.00">
                    </div>
                    <div>
                        <label class="block text-sm font-black text-gray-700 mb-2 uppercase">Método de Pago</label>
                        <select id="egreso-metodo" required
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                            <option value="efectivo">Efectivo</option>
                            <option value="transferencia">Transferencia</option>
                        </select>
                    </div>
                    <div>

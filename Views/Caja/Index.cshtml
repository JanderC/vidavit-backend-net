@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Caja";
    ViewData["Subtitle"] = "Control financiero completo - POWER FITNESS";
}

<style>
    /* ─── Tabs ─── */
    .tab-btn {
        background: transparent !important;
        color: rgba(255,255,255,0.4) !important;
        border-bottom-color: transparent !important;
    }
    .tab-btn.border-b-4.border-red-600 {
        color: #1E6FE3 !important;
        border-bottom-color: #1E6FE3 !important;
        background: rgba(30,111,227,0.06) !important;
    }
    .tab-btn:hover { background: rgba(255,255,255,0.04) !important; color: #fff !important; }

    /* ─── Filtro deudas ─── */
    .ftd-btn { color: rgba(255,255,255,0.4) !important; }
    .ftd-btn.bg-[\#0D0D20] { background: rgba(30,111,227,0.12) !important; color: #1E6FE3 !important; box-shadow: none !important; }

    /* ─── Tabla encabezado semanal ─── */
    thead.bg-gradient-to-r.from-red-600 { background: linear-gradient(90deg,#1E6FE3,#0d4fa8) !important; }
    th.bg-amber-600 { background: rgba(217,119,6,0.7) !important; }
    tfoot td.bg-amber-50 { background: rgba(217,119,6,0.06) !important; }

    /* ─── Scrollbar ─── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #05050F; }
    ::-webkit-scrollbar-thumb { background: linear-gradient(180deg,#1E6FE3,#6B3FA0); border-radius:3px; }

    /* ─── Select options ─── */
    select option { background: #0D0D20; color: #fff; }

    /* ─── Inputs focus ─── */
    input:focus, select:focus, textarea:focus {
        border-color: #1E6FE3 !important;
        box-shadow: 0 0 0 3px rgba(30,111,227,0.15) !important;
        outline: none !important;
    }
</style>

<div class="space-y-6">
    <!-- ALERTA DE DÍAS PENDIENTES -->
    <!-- RESUMEN GENERAL DE CAJA -->
    <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
        <div class="bg-gradient-to-br from-emerald-50 to-[#111428] rounded-2xl shadow-xl p-6 border-l-4 border-emerald-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-emerald-700 font-black uppercase tracking-wide mb-1">Efectivo Hoy</p>
                    <p class="text-3xl font-black text-emerald-600" id="efectivo-hoy">$0.00</p>
                    <p class="text-xs text-emerald-600 font-semibold mt-1">Balance en efectivo</p>
                </div>
                <div class="w-12 h-12 bg-emerald-200 rounded-full flex items-center justify-center">
                    <i data-lucide="wallet" class="w-6 h-6 text-emerald-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl shadow-xl p-6 border-l-4 border-[#1E6FE3] transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-[#3D8EFF] font-black uppercase tracking-wide mb-1">Transferencias Hoy</p>
                    <p class="text-3xl font-black text-[#3D8EFF]" id="transferencias-hoy">$0.00</p>
                    <p class="text-xs text-[#3D8EFF] font-semibold mt-1" id="detalle-transferencias">Ingresos del día</p>
                </div>
                <div class="w-12 h-12 bg-purple-200 rounded-full flex items-center justify-center">
                    <i data-lucide="credit-card" class="w-6 h-6 text-[#3D8EFF]"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl shadow-xl p-6 border-l-4 border-blue-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-blue-700 font-black uppercase tracking-wide mb-1">Ingresos Hoy</p>
                    <p class="text-3xl font-black text-blue-600" id="ingresos-hoy">$0.00</p>
                    <p class="text-xs text-blue-600 font-semibold mt-1" id="detalle-ingresos">Efectivo + Transferencia</p>
                </div>
                <div class="w-12 h-12 bg-blue-200 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-6 h-6 text-blue-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-2xl shadow-xl p-6 border-l-4 border-red-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-red-700 font-black uppercase tracking-wide mb-1">Egresos Hoy</p>
                    <p class="text-3xl font-black text-red-600" id="egresos-hoy">$0.00</p>
                    <p class="text-xs text-red-600 font-semibold mt-1" id="detalle-egresos">Efectivo + Transferencia</p>
                </div>
                <div class="w-12 h-12 bg-red-200 rounded-full flex items-center justify-center">
                    <i data-lucide="trending-down" class="w-6 h-6 text-red-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-[#111428] to-[#0D0D20] rounded-2xl shadow-xl p-6 border-l-4 border-amber-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-amber-700 font-black uppercase tracking-wide mb-1">Deudas Pendientes</p>
                    <p class="text-3xl font-black text-amber-600" id="deudas-pendientes">$0.00</p>
                    <p class="text-xs text-amber-600 font-semibold mt-1">Total por cobrar</p>
                </div>
                <div class="w-12 h-12 bg-amber-200 rounded-full flex items-center justify-center">
                    <i data-lucide="alert-circle" class="w-6 h-6 text-amber-600"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl shadow-xl p-6 border-l-4 border-slate-600 transform hover:scale-105 transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-700 font-black uppercase tracking-wide mb-1">Balance Total</p>
                    <p class="text-3xl font-black text-slate-600" id="balance-total">$0.00</p>
                    <button onclick="abrirModalCerrarCaja()"
                            class="mt-2 px-3 py-1 bg-slate-600 hover:bg-slate-700 text-white text-xs font-bold rounded-lg transition-all">
                        <i data-lucide="lock" class="w-3 h-3 inline-block mr-1"></i>
                        CERRAR CAJA
                    </button>
                </div>
                <div class="w-12 h-12 bg-slate-200 rounded-full flex items-center justify-center">
                    <i data-lucide="calculator" class="w-6 h-6 text-slate-600"></i>
                </div>
            </div>
        </div>
    </div>


    <!-- BADGE DÍA CERRADO -->
    <div id="badge-dia-cerrado" class="hidden bg-gradient-to-r from-emerald-600 to-emerald-800 text-white px-6 py-3 rounded-xl shadow-lg flex items-center gap-3 font-black text-sm">
        <i data-lucide="lock" class="w-5 h-5"></i>
        <span></span>
        <span class="ml-auto text-xs font-semibold text-emerald-200">Los datos mostrados incluyen todos los movimientos del día</span>
    </div>

    <!-- DESGLOSE DE VENTAS DEL DÍA -->
    <div class="bg-[#0D0D20] rounded-2xl shadow-xl p-6 border-2 border-white/8">
        <h3 class="text-lg font-black text-white mb-4 uppercase tracking-wide flex items-center gap-2">
            <i data-lucide="pie-chart" class="w-5 h-5 text-blue-600"></i>
            Desglose de Ventas del Día
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-xl p-4 border border-red-200">
                <p class="text-xs text-red-700 font-bold uppercase mb-1">Membresías</p>
                <p class="text-2xl font-black text-red-600" id="venta-membresias">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-[#111428] to-[#0D0D20] rounded-xl p-4 border border-amber-200">
                <p class="text-xs text-amber-700 font-bold uppercase mb-1">Productos</p>
                <p class="text-2xl font-black text-amber-600" id="venta-productos">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-emerald-50 to-[#111428] rounded-xl p-4 border border-emerald-200">
                <p class="text-xs text-emerald-700 font-bold uppercase mb-1">Abonos a Deudas</p>
                <p class="text-2xl font-black text-emerald-600" id="venta-abonos">$0.00</p>
            </div>
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-4 border border-blue-200">
                <p class="text-xs text-blue-700 font-bold uppercase mb-1">Otros</p>
                <p class="text-2xl font-black text-blue-600" id="venta-otros">$0.00</p>
            </div>
        </div>
    </div>


    <!-- TABS DE NAVEGACIÓN -->
    <div class="bg-[#0D0D20] rounded-2xl shadow-xl border-2 border-white/8 overflow-hidden">
        <div class="flex border-b-2 border-white/8">
            <button onclick="cambiarTab('movimientos')" id="tab-movimientos"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all border-b-4 border-red-600 bg-red-50 text-red-600">
                <i data-lucide="list" class="w-5 h-5 inline-block mr-2"></i>
                Movimientos
            </button>
            <button onclick="cambiarTab('pendientes')" id="tab-pendientes"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-[#111428]">
                <i data-lucide="calendar-clock" class="w-5 h-5 inline-block mr-2"></i>
                Días Pendientes
            </button>
            <button onclick="cambiarTab('deudas')" id="tab-deudas"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-[#111428]">
                <i data-lucide="file-text" class="w-5 h-5 inline-block mr-2"></i>
                Deudas Clientes
            </button>
            <button onclick="cambiarTab('semanal')" id="tab-semanal"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-[#111428]">
                <i data-lucide="calendar" class="w-5 h-5 inline-block mr-2"></i>
                Resumen Semanal
            </button>
            <button onclick="cambiarTab('cierres')" id="tab-cierres"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-[#111428]">
                <i data-lucide="archive" class="w-5 h-5 inline-block mr-2"></i>
                Historial Cierres
            </button>
            <button onclick="cambiarTab('registrar')" id="tab-registrar"
                    class="tab-btn flex-1 px-6 py-4 font-black uppercase tracking-wide transition-all hover:bg-[#111428]">
                <i data-lucide="plus-circle" class="w-5 h-5 inline-block mr-2"></i>
                Registrar
            </button>
        </div>
    </div>

    <!-- TAB: MOVIMIENTOS -->
    <div id="content-movimientos" class="tab-content">
        <div class="bg-[#0D0D20] rounded-2xl shadow-xl p-6 border-2 border-white/8 mb-4">
            <div class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-white mb-2 uppercase tracking-wide">Fecha Desde</label>
                    <input type="date" id="fecha-desde"
                           class="w-full px-4 py-3 border-2 border-white/10 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-white mb-2 uppercase tracking-wide">Fecha Hasta</label>
                    <input type="date" id="fecha-hasta"
                           class="w-full px-4 py-3 border-2 border-white/10 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-black text-white mb-2 uppercase tracking-wide">Categoría</label>
                    <select id="filtro-categoria"
                            class="w-full px-4 py-3 border-2 border-white/10 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold">
                        <option value="">Todas</option>
                        <option value="membresia">Membresías</option>
                        <option value="renovacion">Renovaciones</option>
                        <option value="producto">Productos</option>
                        <option value="abono_deuda">Abonos Deuda</option>
                        <option value="otro">Otros</option>
                    </select>
                </div>
                <button onclick="cargarMovimientos()"
                        class="px-8 py-3 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                    <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                    Filtrar
                </button>
            </div>
        </div>

        <div class="bg-[#0D0D20] rounded-2xl shadow-xl overflow-hidden border-2 border-white/8">
            <div class="p-4 border-b-2 border-white/8 bg-[#111428]">
                <h3 class="text-xl font-black uppercase tracking-wide text-white">Historial de Movimientos</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-white/5 border-b-2 border-white/8">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Fecha</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Tipo</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Categoría</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Descripción</th>
                            <th class="px-6 py-4 text-left text-xs font-black text-white uppercase tracking-wider">Método</th>
                            <th class="px-6 py-4 text-right text-xs font-black text-white uppercase tracking-wider">Monto</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-movimientos" class="divide-y divide-white/6">
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-white/40 font-bold">
                                Cargando movimientos...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    <!-- TAB: DÍAS PENDIENTES -->
    <div id="content-pendientes" class="tab-content hidden">
        <div class="bg-[#0D0D20] rounded-2xl shadow-xl p-6 border-2 border-white/8">
            <h3 class="text-xl font-black text-white uppercase tracking-wide mb-6">
                <i data-lucide="calendar-clock" class="w-6 h-6 inline-block mr-2 text-yellow-600"></i>
                Días con Movimientos Sin Cerrar
            </h3>
            <div id="lista-dias-pendientes" class="space-y-4">
                <p class="text-center text-white/40 font-semibold py-8">Cargando...</p>
            </div>
        </div>
    </div>

    <!-- TAB: DEUDAS CLIENTES -->
    <div id="content-deudas" class="tab-content hidden">
        <!-- Tarjetas resumen -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <div onclick="filtroEstadoDeuda('')" class="bg-[#0D0D20] rounded-2xl shadow-xl p-4 border-2 border-white/8 cursor-pointer hover:shadow-2xl transition-all border-l-4 border-l-slate-500">
                <p class="text-xs text-white/40 font-black uppercase mb-1">Total por cobrar</p>
                <p class="text-2xl font-black text-slate-700" id="rv-deuda-total">—</p>
                <p class="text-xs text-white/30 font-semibold" id="rs-deuda-total">0 deudas</p>
            </div>
            <div onclick="filtroEstadoDeuda('pendiente')" class="bg-[#0D0D20] rounded-2xl shadow-xl p-4 border-2 border-white/8 cursor-pointer hover:shadow-2xl transition-all border-l-4 border-l-amber-500">
                <p class="text-xs text-white/40 font-black uppercase mb-1">Deudas pendientes</p>
                <p class="text-2xl font-black text-amber-600" id="rv-deuda-pendiente">—</p>
                <p class="text-xs text-white/30 font-semibold" id="rs-deuda-pendiente">0 deudas</p>
            </div>
            <!-- Botón que lleva a la vista de deudas pagadas -->
            <a href="/Caja/DeudasPagadas"
               class="bg-gradient-to-br from-[#0D0D20] to-[#111428] rounded-2xl shadow-xl p-4 border-2 border-emerald-200 hover:shadow-2xl transition-all border-l-4 border-l-emerald-600 flex flex-col justify-between group cursor-pointer no-underline">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-emerald-700 font-black uppercase mb-1">Deudas Pagadas</p>
                        <p class="text-sm text-emerald-600 font-semibold">Ver historial completo</p>
                    </div>
                    <div class="w-10 h-10 bg-emerald-200 rounded-full flex items-center justify-center group-hover:bg-emerald-300 transition-all">
                        <i data-lucide="check-circle" class="w-5 h-5 text-emerald-700"></i>
                    </div>
                </div>
                <p class="text-xs text-emerald-600 font-bold mt-2 flex items-center gap-1">
                    <i data-lucide="arrow-right" class="w-3 h-3"></i> Ir a deudas pagadas
                </p>
            </a>
        </div>
        <!-- Búsqueda + filtros -->
        <div class="bg-[#0D0D20] rounded-2xl shadow-xl p-4 border-2 border-white/8 mb-4 flex flex-wrap items-center gap-3">
            <div class="flex-1 min-w-[200px] relative">
                <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-white/30"></i>
                <input type="text" id="buscar-deuda" placeholder="Buscar por nombre, cedula o concepto..."
                       class="w-full pl-9 pr-4 py-3 border-2 border-white/10 rounded-xl focus:ring-2 focus:ring-red-600 focus:border-red-600 font-semibold"
                       oninput="debounceBusquedaDeuda(this.value)">
            </div>
            <div class="flex gap-1 bg-white/5 rounded-xl p-1">
                <button onclick="filtroEstadoDeuda('')" id="ft-d-todos" class="ftd-btn px-4 py-2 rounded-lg text-sm font-black uppercase tracking-wide bg-[#0D0D20] shadow text-red-600">Todos</button>
                <button onclick="filtroEstadoDeuda('pendiente')" id="ft-d-pendiente" class="ftd-btn px-4 py-2 rounded-lg text-sm font-black uppercase tracking-wide text-white/40 hover:bg-[#111428]">Pendientes</button>
            </div>
        </div>
        <div id="lista-deudas" class="space-y-4">
            <div class="text-center py-12 text-white/40 font-bold">Cargando deudas...</div>
        </div>
    </div>

    <!-- TAB: RESUMEN SEMANAL -->
    <!-- TAB: RESUMEN SEMANAL -->
    <div id="content-semanal" class="tab-content hidden">
        <div class="bg-[#0D0D20] rounded-2xl shadow-xl p-6 border-2 border-white/8">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-black text-white uppercase tracking-wide flex items-center gap-2">
                    <i data-lucide="calendar-range" class="w-6 h-6 text-blue-600"></i>
                    Resumen de los Últimos 7 Días
                </h3>
                <p class="text-sm text-white/50 font-bold" id="periodo-semanal">Cargando...</p>
            </div>

            <!-- TABLA -->
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead class="bg-gradient-to-r from-red-600 to-red-700 text-white">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-black uppercase">Día</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Ingresos</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Egresos</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Balance</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Efectivo</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase">Transferencia</th>
                            <th class="px-6 py-4 text-right text-sm font-black uppercase bg-amber-600">
                                <i data-lucide="shopping-bag" class="w-4 h-4 inline-block mr-1"></i>
                                Productos Vendidos
                            </th>
                            <th class="px-6 py-4 text-center text-sm font-black uppercase">Movimientos</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-resumen-semanal" class="divide-y divide-white/6">
                        <!-- Los datos se cargan dinámicamente con JavaScript -->
                    </tbody>
                    <tfoot class="bg-[#111428] border-t-2 border-white/10">
                        <tr>
                            <td class="px-6 py-4 text-sm font-black uppercase text-white">TOTAL</td>
                            <td class="px-6 py-4 text-right text-xl font-black text-blue-600" id="total-ingresos-semana">$0.00</td>
                            <td class="px-6 py-4 text-right text-xl font-black text-red-600" id="total-egresos-semana">$0.00</td>
                            <td class="px-6 py-4 text-right text-xl font-black text-emerald-600" id="balance-semana">$0.00</td>
                            <td class="px-6 py-4" colspan="2"></td>
                            <td class="px-6 py-4 text-right text-xl font-black text-amber-600 bg-amber-50" id="total-productos-semana">$0.00</td>
                            <td class="px-6 py-4 text-center">
                                <span class="px-3 py-1 bg-blue-500/10 text-[#3D8EFF] text-xs font-bold rounded-full" id="cantidad-movimientos-semana">0</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <!-- TAB: HISTORIAL CIERRES -->
    <div id="content-cierres" class="tab-content hidden">
        <div class="bg-[#0D0D20] rounded-2xl shadow-xl p-6 border-2 border-white/8 mb-4">
            <div class="flex items-center justify-between">
                <h3 class="text-2xl font-black text-white uppercase tracking-wide">Historial de Cierres de Caja</h3>
                <button onclick="cargarHistorialCierres()"
                        class="px-6 py-2 bg-gradient-to-r from-[#1E6FE3] to-[#1550B0] hover:from-[#1550B0] hover:to-[#0d3d8a] text-white font-black rounded-xl transition-all shadow-xl">
                    <i data-lucide="refresh-cw" class="w-4 h-4 inline-block mr-2"></i>
                    Actualizar
                </button>
            </div>
        </div>

        <div id="lista-cierres" class="space-y-4">
            <div class="bg-[#0D0D20] rounded-2xl shadow-xl p-8 text-center border-2 border-white/8">
                <p class="text-white/40 font-bold">Cargando historial...</p>
            </div>
        </div>
    </div>

    <!-- TAB: REGISTRAR -->

        async function registrarIngreso() {
            const categoria = document.getElementById('categoriaIngreso').value;
            const descripcion = document.getElementById('descripcionIngreso').value;
            const monto = parseFloat(document.getElementById('montoIngreso').value);
            const metodoPago = document.getElementById('metodoPagoIngreso').value;

            if (!categoria || !descripcion || !monto || !metodoPago) {
                alert('⚠️ Por favor complete todos los campos');
                return;
            }

            if (!confirm(`¿Confirmar ingreso por $${monto.toFixed(2)}?`)) return;

            try {
                const response = await fetch(`${API_BASE}/Caja/ingreso`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        categoria: categoria,
                        descripcion: descripcion,
                        monto: monto,
                        metodoPago: metodoPago,
                        usuarioId: '00000000-0000-0000-0000-000000000000'
                    })
                });

                const result = await response.json();

                if (result.success) {
                    alert('✅ Ingreso registrado exitosamente');
                    cerrarModalIngreso();
                    cargarBalance();
                } else {
                    alert('❌ Error: ' + result.message);

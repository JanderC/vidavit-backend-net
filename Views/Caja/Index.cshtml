                    }

                    // PRODUCTOS - Usar datos reales del backend
                    const productosEfectivo = data.cajaHoy.categorias.productosEfectivo || 0;
                    const productosTransferencia = data.cajaHoy.categorias.productosTransferencia || 0;
                    const productosTotal = data.cajaHoy.categorias.productos || 0;


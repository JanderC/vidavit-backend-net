@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Power Fitness Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'pf-blue':        '#3B82F6',
                        'pf-blue-bright': '#60A5FA',
                        'pf-blue-deep':   '#1E3A8A',
                        'pf-purple':      '#7C3AED',
                        'pf-dark':        '#060B18',
                        'pf-card':        '#0D1526',
                        'pf-border':      '#1E2D4A',
                    }
                }
            }
        }
    </script>

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            --pf-blue:        #3B82F6;
            --pf-blue-bright: #60A5FA;
            --pf-blue-deep:   #1E3A8A;
            --pf-purple:      #7C3AED;
            --pf-purple-light:#A78BFA;
            --pf-dark:        #060B18;
            --pf-card:        #0D1526;
            --pf-border:      #1E2D4A;
            --pf-text:        #E2E8F0;
            --pf-text-muted:  #64748B;
            --pf-text-soft:   #94A3B8;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--pf-dark);
            color: var(--pf-text);
        }

        /* ─ Scrollbar ─ */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--pf-dark); }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--pf-blue) 0%, var(--pf-purple) 100%);
            border-radius: 999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, var(--pf-blue-bright) 0%, var(--pf-blue) 100%);
        }

        /* ─ Sidebar ─ */
        .pf-sidebar {
            position: fixed;
            left: 0; top: 0;
            height: 100vh;
            width: 15rem;
            background: linear-gradient(180deg, #0D1526 0%, #060B18 100%);
            border-right: 1px solid var(--pf-border);
            z-index: 50;
            display: flex;
            flex-direction: column;
        }

        /* Línea de acento lateral */
        .pf-sidebar::after {
            content: '';
            position: absolute;
            top: 0; right: -1px;
            width: 1px;
            height: 100%;
            background: linear-gradient(180deg, var(--pf-blue), var(--pf-purple), transparent);
        }

        /* ─ Logo área ─ */
        .pf-sidebar-logo {
            padding: 1.4rem 1.25rem;
            border-bottom: 1px solid var(--pf-border);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .5rem;
        }

        .pf-logo-box {
            padding: .6rem 1.5rem;
            background: linear-gradient(135deg, var(--pf-blue-deep), var(--pf-purple) 140%);
            border-radius: .75rem;
            border: 1px solid rgba(96,165,250,.2);
            box-shadow: 0 4px 20px rgba(59,130,246,.2);
            text-align: center;
        }

        .pf-logo-power {
            font-size: 1.6rem;
            font-weight: 900;
            color: #fff;
            letter-spacing: .18em;
            text-transform: uppercase;
            line-height: 1;
            display: block;
        }

        .pf-logo-fitness {
            font-size: .55rem;
            font-weight: 800;
            color: var(--pf-blue-bright);
            letter-spacing: .45em;
            text-transform: uppercase;
            display: block;
            margin-top: .1rem;
        }

        .pf-sidebar-subtitle {
            font-size: .62rem;
            font-weight: 700;
            color: var(--pf-text-muted);
            letter-spacing: .15em;
            text-transform: uppercase;
        }

        /* ─ Nav ─ */
        .pf-nav {
            flex: 1;
            overflow-y: auto;
            padding: 1rem .75rem;
        }

        .pf-nav-group {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--pf-border);
        }

        .pf-nav-group-label {
            font-size: .58rem;
            font-weight: 800;
            color: var(--pf-text-muted);
            letter-spacing: .2em;
            text-transform: uppercase;
            padding: 0 .75rem;
            margin-bottom: .6rem;
            display: block;
        }

        .pf-nav-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem .75rem;
            border-radius: .625rem;
            color: var(--pf-text-soft);
            text-decoration: none;
            font-size: .85rem;
            font-weight: 600;
            position: relative;
            overflow: hidden;
            transition: color .2s, background .2s;
            margin-bottom: .2rem;
        }

        /* Borde izquierdo de acento */
        .pf-nav-link::before {
            content: '';
            position: absolute;
            left: 0; top: 0;
            height: 100%;
            width: 3px;
            background: linear-gradient(180deg, var(--pf-blue), var(--pf-purple));
            border-radius: 999px;
            transform: scaleY(0);
            transition: transform .2s;
        }

        .pf-nav-link:hover {
            color: #fff;
            background: rgba(59,130,246,.08);
        }

        .pf-nav-link:hover::before { transform: scaleY(1); }

        .pf-nav-link.active {
            color: var(--pf-blue-bright);
            background: rgba(59,130,246,.1);
        }
        .pf-nav-link.active::before { transform: scaleY(1); }

        .pf-nav-link i {
            width: 18px !important;
            height: 18px !important;
            color: var(--pf-blue-bright);
            flex-shrink: 0;
        }

        .pf-nav-link .pf-icon-gold { color: #F59E0B !important; }

        /* ─ Footer sidebar ─ */
        .pf-sidebar-footer {
            padding: 1rem .75rem;
            border-top: 1px solid var(--pf-border);
            background: linear-gradient(0deg, rgba(6,11,24,.9), transparent);
        }

        .pf-user-row {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: .75rem;
        }

        .pf-user-avatar {
            width: 38px; height: 38px;
            border-radius: .625rem;
            background: linear-gradient(135deg, var(--pf-blue-deep), var(--pf-purple));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 900;
            font-size: 1rem;
            flex-shrink: 0;
            border: 1px solid rgba(96,165,250,.2);
        }

        .pf-user-name {
            font-size: .82rem;
            font-weight: 700;
            color: var(--pf-text);
        }

        .pf-user-role {
            font-size: .62rem;
            font-weight: 600;
            color: var(--pf-text-muted);
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .pf-logout-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            padding: .65rem 1rem;
            background: linear-gradient(135deg, var(--pf-blue-deep), var(--pf-purple-dark, #4C1D95));
            border: 1px solid rgba(96,165,250,.2);
            border-radius: .625rem;
            color: var(--pf-blue-bright);
            font-size: .8rem;
            font-weight: 700;
            font-family: inherit;
            letter-spacing: .08em;
            cursor: pointer;
            transition: background .2s, box-shadow .2s, color .2s;
        }

        .pf-logout-btn:hover {
            background: linear-gradient(135deg, var(--pf-blue), var(--pf-purple));
            color: #fff;
            box-shadow: 0 4px 16px rgba(59,130,246,.3);
        }

        .pf-logout-btn i {
            width: 16px !important; height: 16px !important;
        }

        /* ─ Main ─ */
        .pf-main { margin-left: 15rem; min-height: 100vh; }

        /* ─ Header ─ */
        .pf-header {
            position: sticky;
            top: 0;
            z-index: 40;
            background: rgba(13,21,38,.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--pf-border);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Línea inferior de acento */
        .pf-header::after {
            content: '';
            position: absolute;
            bottom: -1px; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, var(--pf-blue), var(--pf-purple), transparent);
        }

        .pf-header-title {
            font-size: 1.5rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
            background: linear-gradient(135deg, var(--pf-blue-bright), var(--pf-purple-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .pf-header-subtitle {
            font-size: .72rem;
            font-weight: 600;
            color: var(--pf-text-muted);
            letter-spacing: .08em;
            margin-top: .15rem;
        }

        .pf-time-chip {
            padding: .5rem 1rem;
            background: rgba(255,255,255,.03);
            border: 1px solid var(--pf-border);
            border-radius: .625rem;
            text-align: right;
        }

        .pf-time-label {
            font-size: .58rem;
            font-weight: 700;
            color: var(--pf-text-muted);
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .pf-time-value {
            font-size: .82rem;
            font-weight: 700;
            color: var(--pf-blue-bright);
        }

        /* ─ Content ─ */
        .pf-content { padding: 2rem; }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- ══ SIDEBAR ══ -->
    <aside class="pf-sidebar">

        <!-- Logo -->
        <div class="pf-sidebar-logo">
            <div class="pf-logo-box">
                <span class="pf-logo-power">Power</span>
                <span class="pf-logo-fitness">Fitness</span>
            </div>
            <span class="pf-sidebar-subtitle">Panel Administrativo</span>
        </div>

        <!-- Navegación -->
        <nav class="pf-nav">

            <a href="/admin/dashboard" class="pf-nav-link">
                <i data-lucide="layout-dashboard"></i>
                Dashboard
            </a>

            <a href="/clientes" class="pf-nav-link">
                <i data-lucide="users"></i>
                Clientes
            </a>

            <a href="/membresias" class="pf-nav-link">
                <i data-lucide="credit-card"></i>
                Membresías
            </a>

            <a href="/membresias/planes" class="pf-nav-link">
                <i data-lucide="star"></i>
                Planes
            </a>

            <a href="/productos" class="pf-nav-link">
                <i data-lucide="package"></i>
                Tienda
            </a>

            <!-- Gestión Financiera -->
            <div class="pf-nav-group">
                <span class="pf-nav-group-label">Gestión Financiera</span>

                <a href="/caja" class="pf-nav-link">
                    <i data-lucide="wallet"></i>
                    Caja Diaria
                </a>

                <a href="/cajafuerte" class="pf-nav-link">
                    <i data-lucide="vault" class="pf-icon-gold"></i>
                    Caja Fuerte
                </a>
            </div>

            <!-- Reportes -->
            <div class="pf-nav-group">
                <span class="pf-nav-group-label">Reportes</span>

                <a href="/reportes/ingresos-membresias" class="pf-nav-link">
                    <i data-lucide="trending-up"></i>
                    Ingresos Membresías
                </a>

                <a href="/reportes/asistencia" class="pf-nav-link">
                    <i data-lucide="calendar-check"></i>
                    Asistencia
                </a>

                <a href="/reportes/productos-mas-vendidos" class="pf-nav-link">
                    <i data-lucide="shopping-cart"></i>
                    Productos Vendidos
                </a>

                <a href="/reportes/clientes-inactivos" class="pf-nav-link">
                    <i data-lucide="user-x"></i>
                    Clientes Inactivos
                </a>
            </div>

        </nav>

        <!-- Footer usuario -->
        <div class="pf-sidebar-footer">
            <div class="pf-user-row">
                <div class="pf-user-avatar">A</div>
                <div>
                    <div class="pf-user-name">Administrador</div>
                    <div class="pf-user-role">Power Fitness</div>
                </div>
            </div>
            <form action="/admin/logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="pf-logout-btn">
                    <i data-lucide="log-out"></i>
                    Cerrar Sesión
                </button>
            </form>
        </div>

    </aside>

    <!-- ══ MAIN ══ -->
    <main class="pf-main">

        <!-- Header -->
        <header class="pf-header">
            <div>
                <div class="pf-header-title">@ViewData["Title"]</div>
                @if (ViewData["Subtitle"] != null)
                {
                    <div class="pf-header-subtitle">@ViewData["Subtitle"]</div>
                }
            </div>
            <div class="pf-time-chip">
                <div class="pf-time-label">Última actualización</div>
                <div class="pf-time-value" id="current-time"></div>
            </div>
        </header>

        <!-- Contenido -->
        <div class="pf-content">
            @RenderBody()
        </div>

    </main>

    <script>
        lucide.createIcons();

        function updateTime() {
            const now = new Date();
            const timeStr = now.toLocaleString('es-ES', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            });
            const el = document.getElementById('current-time');
            if (el) el.textContent = timeStr;
        }
        updateTime();
        setInterval(updateTime, 60000);

        // Marcar enlace activo
        const links = document.querySelectorAll('.pf-nav-link');
        links.forEach(link => {
            if (link.getAttribute('href') === window.location.pathname) {
                link.classList.add('active');
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

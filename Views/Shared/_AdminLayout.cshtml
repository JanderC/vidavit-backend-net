@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PowerZone Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'pz-blue':      '#2B4FD8',
                        'pz-blue-dark': '#1a3ab5',
                        'pz-blue-light':'#4a6ee0',
                        'pz-gold':      '#D4A017',
                        'pz-gold-dark': '#b8880e',
                        'pz-dark':      '#0f1535',
                        'pz-dark2':     '#1a2050',
                        'pz-silver':    '#8899bb',
                    }
                }
            }
        }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }

        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #0f1535;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #D4A017 0%, #b8880e 100%);
            border-radius: 5px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(180deg, #e8bb2e 0%, #D4A017 100%);
            }

        /* Sidebar nav items */
        .nav-item {
            position: relative;
            overflow: hidden;
        }

            .nav-item::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                height: 100%;
                width: 4px;
                background: linear-gradient(180deg, #D4A017 0%, #e8bb2e 100%);
                transform: scaleY(0);
                transition: transform 0.3s ease;
            }

            .nav-item:hover::before,
            .nav-item.active::before {
                transform: scaleY(1);
            }

            .nav-item:hover {
                background: rgba(43, 79, 216, 0.12);
            }

            .nav-item.active {
                background: rgba(212, 160, 23, 0.1);
            }

        /* Logo glow */
        .logo-container {
            animation: pulse-glow 3s ease-in-out infinite;
        }

        @@keyframes pulse-glow {
            0%, 100% {
                box-shadow: 0 0 15px rgba(212,160,23,0.3);
            }

            50% {
                box-shadow: 0 0 30px rgba(212,160,23,0.6), 0 0 60px rgba(43,79,216,0.2);
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body class="bg-gray-50">

    <!-- ===== SIDEBAR ===== -->
    <aside class="fixed left-0 top-0 h-screen w-64 text-white shadow-2xl z-50 border-r-2"
           style="background: linear-gradient(180deg, #060b1e 0%, #0f1535 50%, #1a2050 100%); border-color: #D4A017;">

        <!-- Logo -->
        <div class="p-6 border-b-2" style="border-color: #D4A017;">
            <div class="flex flex-col items-center gap-3">
                <div class="logo-container inline-block px-6 py-3 rounded-xl"
                     style="background:#060b1e; border: 2px solid #D4A017;">
                    <h1 class="text-3xl font-black tracking-widest">
                        <span class="text-white">POWER</span><span style="color:#D4A017;">ZONE</span>
                    </h1>
                </div>
                <p class="text-xs uppercase tracking-widest font-bold" style="color:#8899bb;">Panel Administrativo</p>
            </div>
        </div>

        <!-- Nav -->
        <nav class="p-4 space-y-2 overflow-y-auto h-[calc(100vh-280px)]">
            <a href="/admin/dashboard" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all group">
                <i data-lucide="layout-dashboard" class="w-5 h-5 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                <span class="font-semibold">Dashboard</span>
            </a>

            <a href="/clientes" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all group">
                <i data-lucide="users" class="w-5 h-5 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                <span class="font-semibold">Clientes</span>
            </a>

            <a href="/membresias" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all group">
                <i data-lucide="credit-card" class="w-5 h-5 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                <span class="font-semibold">Membresías</span>
            </a>

            <a href="/membresias/planes" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all group">
                <i data-lucide="star" class="w-5 h-5 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                <span class="font-semibold">Planes</span>
            </a>

            <a href="/productos" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all group">
                <i data-lucide="package" class="w-5 h-5 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                <span class="font-semibold">Tienda</span>
            </a>

            <!-- Gestión Financiera -->
            <div class="pt-4 border-t-2 mt-4" style="border-color: rgba(43,79,216,0.3);">
                <p class="text-xs uppercase font-black mb-3 px-4 tracking-wider" style="color:#8899bb;">Gestión Financiera</p>

                <a href="/caja" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all group">
                    <i data-lucide="wallet" class="w-5 h-5 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                    <span class="font-semibold">Caja Diaria</span>
                </a>

                <a href="/cajafuerte" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all group">
                    <i data-lucide="vault" class="w-5 h-5 group-hover:scale-110 transition-transform" style="color:#2B4FD8;"></i>
                    <span class="font-semibold">Caja Fuerte</span>
                </a>
            </div>

            <!-- Reportes -->
            <div class="pt-4 border-t-2 mt-4" style="border-color: rgba(43,79,216,0.3);">
                <p class="text-xs uppercase font-black mb-3 px-4 tracking-wider" style="color:#8899bb;">Reportes</p>

                <a href="/reportes/ingresos-membresias" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all text-sm group">
                    <i data-lucide="trending-up" class="w-4 h-4 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                    <span>Ingresos Membresías</span>
                </a>

                <a href="/reportes/asistencia" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all text-sm group">
                    <i data-lucide="calendar-check" class="w-4 h-4 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                    <span>Asistencia</span>
                </a>

                <a href="/reportes/productos-mas-vendidos" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all text-sm group">
                    <i data-lucide="shopping-cart" class="w-4 h-4 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                    <span>Productos Vendidos</span>
                </a>

                <a href="/reportes/clientes-inactivos" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-900 transition-all text-sm group">
                    <i data-lucide="user-x" class="w-4 h-4 group-hover:scale-110 transition-transform" style="color:#D4A017;"></i>
                    <span>Clientes Inactivos</span>
                </a>
            </div>
        </nav>

        <!-- Footer del sidebar -->
        <div class="absolute bottom-0 left-0 right-0 p-4 border-t-2"
             style="border-color: rgba(43,79,216,0.3); background: linear-gradient(to top, #060b1e, transparent);">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center text-white font-black text-lg shadow-lg"
                     style="background: linear-gradient(135deg, #2B4FD8, #1a3ab5);">
                    A
                </div>
                <div class="flex-1">
                    <p class="text-sm font-bold">Administrador</p>
                    <p class="text-xs uppercase tracking-wide" style="color:#8899bb;">POWERZONE</p>
                </div>
            </div>
            <form action="/admin/logout" method="post" class="w-full">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl transition-all font-bold shadow-xl transform hover:scale-105"
                        style="background: linear-gradient(135deg, #D4A017, #b8880e);"
                        onmouseover="this.style.background='linear-gradient(135deg,#e8bb2e,#D4A017)'; this.style.boxShadow='0 8px 25px rgba(212,160,23,0.5)';"
                        onmouseout="this.style.background='linear-gradient(135deg,#D4A017,#b8880e)'; this.style.boxShadow='';">
                    <i data-lucide="log-out" class="w-5 h-5"></i>
                    Cerrar Sesión
                </button>
            </form>
        </div>
    </aside>

    <!-- ===== MAIN ===== -->
    <main class="ml-64 min-h-screen">

        <!-- Header -->
        <header class="bg-white shadow-lg sticky top-0 z-40 border-b-4" style="border-color: #D4A017;">
            <div class="px-8 py-5">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-4xl font-black uppercase tracking-wide"
                            style="background: linear-gradient(135deg, #2B4FD8, #D4A017); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                            @ViewData["Title"]
                        </h2>
                        @if (ViewData["Subtitle"] != null)
                        {
                            <p class="text-sm text-gray-600 mt-2 font-semibold">@ViewData["Subtitle"]</p>
                        }
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="text-right px-6 py-3 rounded-xl border"
                             style="background:#0f1535; border-color: rgba(212,160,23,0.3);">
                            <p class="text-xs uppercase tracking-wide font-bold" style="color:#8899bb;">Última actualización</p>
                            <p class="text-sm font-bold text-white" id="current-time"></p>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="p-8">
            @RenderBody()
        </div>
    </main>

    <script>
        lucide.createIcons();

        function updateTime() {
            const now = new Date();
            const timeStr = now.toLocaleString('es-ES', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            });
            const el = document.getElementById('current-time');
            if (el) el.textContent = timeStr;
        }
        updateTime();
        setInterval(updateTime, 60000);
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
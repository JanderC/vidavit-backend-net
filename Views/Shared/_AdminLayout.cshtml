@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tallest GYM Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'tallest-green':      '#22c55e',
                        'tallest-green-dark': '#15803d',
                        'tallest-green-deep': '#166534',
                        'tallest-black':      '#000000',
                        'tallest-dark':       '#0a0a0a',
                        'tallest-gray':       '#111111',
                    }
                }
            }
        }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }

        /* Scrollbar global */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #0d0d0d;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(180deg, #4ade80 0%, #22c55e 100%);
            }

        /* ── Sidebar ── */
        .sidebar {
            background: linear-gradient(180deg, #000000 0%, #050f05 50%, #000000 100%);
            border-right: 1px solid rgba(34, 197, 94, 0.2);
        }

        .sidebar-logo-wrapper {
            border-bottom: 1px solid rgba(34, 197, 94, 0.2);
        }

        .logo-badge {
            background: linear-gradient(135deg, #166534 0%, #15803d 100%);
            border: 1px solid rgba(34, 197, 94, 0.35);
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.15);
            animation: logo-pulse 3s ease-in-out infinite;
        }

        /* Nav items */
        .nav-item {
            position: relative;
            overflow: hidden;
            transition: all 0.25s ease;
            border-radius: .65rem;
            color: #9ca3af;
        }

            .nav-item::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                height: 100%;
                width: 3px;
                background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
                transform: scaleY(0);
                transition: transform 0.25s ease;
                border-radius: 0 2px 2px 0;
            }

            .nav-item:hover::before,
            .nav-item.active::before {
                transform: scaleY(1);
            }

            .nav-item:hover {
                background: rgba(34, 197, 94, 0.08);
                color: #f9fafb;
            }

            .nav-item.active {
                background: rgba(34, 197, 94, 0.12);
                color: #f9fafb;
            }

            .nav-item .nav-icon {
                color: #22c55e;
                transition: transform 0.2s ease;
            }

            .nav-item:hover .nav-icon {
                transform: scale(1.15);
            }

        /* Section label in nav */
        .nav-section-label {
            font-size: .65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: rgba(34, 197, 94, 0.45);
            padding: 0 1rem;
            margin-bottom: .5rem;
        }

        /* Divider */
        .nav-divider {
            border-color: rgba(255,255,255,0.06);
            margin: .75rem 0;
        }

        /* ── Header ── */
        .admin-header {
            background: #0d0d0d;
            border-bottom: 1px solid rgba(34, 197, 94, 0.2);
        }

        .header-title {
            background: linear-gradient(90deg, #22c55e, #4ade80);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .time-badge {
            background: rgba(34, 197, 94, 0.06);
            border: 1px solid rgba(34, 197, 94, 0.18);
            border-radius: .75rem;
        }

        /* ── Main content area ── */
        .main-content {
            background: #0d0d0d;
            min-height: 100vh;
        }

        /* ── User card at bottom ── */
        .user-avatar {
            background: linear-gradient(135deg, #166534 0%, #15803d 100%);
            box-shadow: 0 4px 14px rgba(34, 197, 94, 0.2);
        }

        /* Logout button */
        .btn-logout {
            background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);
            transition: all 0.3s ease;
        }

            .btn-logout:hover {
                background: linear-gradient(135deg, #16a34a 0%, #166534 100%);
                box-shadow: 0 6px 20px rgba(34, 197, 94, 0.35);
                transform: scale(1.03);
            }

        /* Accent dot pulse */
        .dot-pulse {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            animation: dot-blink 2s ease-in-out infinite;
        }
       
    </style>

    @RenderSection("Styles", required: false)
</head>
<body class="bg-black">

    <!-- ══════════════ SIDEBAR ══════════════ -->
    <aside class="sidebar fixed left-0 top-0 h-screen w-64 text-white shadow-2xl z-50">

        <!-- Logo / Brand -->
        <div class="sidebar-logo-wrapper p-5">
            <div class="flex flex-col items-center gap-2">
                <div class="logo-badge w-full text-center px-5 py-3 rounded-xl">
                    <h1 class="text-2xl text-white tracking-[4px]">TALLEST GYM</h1>
                </div>
                <div class="flex items-center gap-2 mt-1">
                    <div class="dot-pulse"></div>
                    <p class="text-[10px] text-green-600 uppercase tracking-[3px] font-bold">Panel Administrativo</p>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="p-3 space-y-1 overflow-y-auto h-[calc(100vh-280px)]">

            <!-- Principal -->
            <a href="/admin/dashboard" class="nav-item flex items-center gap-3 px-4 py-3 group">
                <i data-lucide="layout-dashboard" class="nav-icon w-5 h-5"></i>
                <span class="font-semibold text-sm">Dashboard</span>
            </a>

            <a href="/clientes" class="nav-item flex items-center gap-3 px-4 py-3 group">
                <i data-lucide="users" class="nav-icon w-5 h-5"></i>
                <span class="font-semibold text-sm">Clientes</span>
            </a>

            <a href="/membresias" class="nav-item flex items-center gap-3 px-4 py-3 group">
                <i data-lucide="credit-card" class="nav-icon w-5 h-5"></i>
                <span class="font-semibold text-sm">Membresías</span>
            </a>

            <a href="/membresias/planes" class="nav-item flex items-center gap-3 px-4 py-3 group">
                <i data-lucide="star" class="nav-icon w-5 h-5"></i>
                <span class="font-semibold text-sm">Planes</span>
            </a>

            <a href="/productos" class="nav-item flex items-center gap-3 px-4 py-3 group">
                <i data-lucide="package" class="nav-icon w-5 h-5"></i>
                <span class="font-semibold text-sm">Tienda</span>
            </a>

            <!-- Gestión Financiera -->
            <hr class="nav-divider border-t mt-3 pt-1">
            <p class="nav-section-label">Gestión Financiera</p>

            <a href="/caja" class="nav-item flex items-center gap-3 px-4 py-3 group">
                <i data-lucide="wallet" class="nav-icon w-5 h-5"></i>
                <span class="font-semibold text-sm">Caja Diaria</span>
            </a>

            <a href="/cajafuerte" class="nav-item flex items-center gap-3 px-4 py-3 group">
                <i data-lucide="vault" class="w-5 h-5" style="color:#eab308"></i>
                <span class="font-semibold text-sm">Caja Fuerte</span>
            </a>

            <!-- Reportes -->
            <hr class="nav-divider border-t mt-3 pt-1">
            <p class="nav-section-label">Reportes</p>

            <a href="/reportes/ingresos-membresias" class="nav-item flex items-center gap-3 px-4 py-2.5 group">
                <i data-lucide="trending-up" class="nav-icon w-4 h-4"></i>
                <span class="text-sm">Ingresos Membresías</span>
            </a>

            <a href="/reportes/asistencia" class="nav-item flex items-center gap-3 px-4 py-2.5 group">
                <i data-lucide="calendar-check" class="nav-icon w-4 h-4"></i>
                <span class="text-sm">Asistencia</span>
            </a>

            <a href="/reportes/productos-mas-vendidos" class="nav-item flex items-center gap-3 px-4 py-2.5 group">
                <i data-lucide="shopping-cart" class="nav-icon w-4 h-4"></i>
                <span class="text-sm">Productos Vendidos</span>
            </a>

            <a href="/reportes/clientes-inactivos" class="nav-item flex items-center gap-3 px-4 py-2.5 group">
                <i data-lucide="user-x" class="nav-icon w-4 h-4"></i>
                <span class="text-sm">Clientes Inactivos</span>
            </a>
        </nav>

        <!-- User + Logout -->
        <div class="absolute bottom-0 left-0 right-0 p-4" style="background:linear-gradient(to top, #000 60%, transparent); border-top:1px solid rgba(34,197,94,0.12)">
            <div class="flex items-center gap-3 mb-3">
                <div class="user-avatar w-11 h-11 rounded-xl flex items-center justify-center text-white font-black text-base">
                    A
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-bold text-gray-200 truncate">Administrador</p>
                    <p class="text-[10px] text-green-600 uppercase tracking-widest font-bold truncate">Tallest GYM</p>
                </div>
            </div>
            <form action="/admin/logout" method="post" class="w-full">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-bold text-white text-sm shadow-lg">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                    Cerrar Sesión
                </button>
            </form>
        </div>
    </aside>

    <!-- ══════════════ MAIN ══════════════ -->
    <main class="ml-64 min-h-screen main-content">

        <!-- Header -->
        <header class="admin-header sticky top-0 z-40">
            <div class="px-8 py-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="header-title text-3xl uppercase">
                            @ViewData["Title"]
                        </h2>
                        @if (ViewData["Subtitle"] != null)
                        {
                            <p class="text-xs text-gray-500 mt-1 font-semibold uppercase tracking-widest">@ViewData["Subtitle"]</p>
                        }
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="time-badge px-5 py-2.5 text-right">
                            <p class="text-[10px] text-green-700 uppercase tracking-widest font-bold">Última actualización</p>
                            <p class="text-sm text-green-400 font-bold" id="current-time"></p>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <div class="p-8">
            @RenderBody()
        </div>
    </main>

    <script>
        lucide.createIcons();

        function updateTime() {
            const now = new Date();
            const timeStr = now.toLocaleString('es-ES', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            });
            const el = document.getElementById('current-time');
            if (el) el.textContent = timeStr;
        }
        updateTime();
        setInterval(updateTime, 60000);

        // Mark active nav item
        const currentPath = window.location.pathname;
        document.querySelectorAll('.nav-item').forEach(link => {
            if (link.getAttribute('href') === currentPath) {
                link.classList.add('active');
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

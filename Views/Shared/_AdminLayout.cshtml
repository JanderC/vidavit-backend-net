@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ELIT GYM Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'elit-red': '#E31E24',
                        'elit-dark': '#000000',
                        'elit-gray': '#1a1a1a',
                        'elit-light': '#FFFFFF',
                        'elit-accent': '#FF0000'
                    }
                }
            }
        }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@500;600;700&family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: #f5f5f5;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }

        .elit-logo-text {
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            letter-spacing: 4px;
        }

        /* Scrollbar personalizado */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #000;
        }

        ::-webkit-scrollbar-thumb {
            background: #E31E24;
            border-radius: 5px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #FF0000;
            }

        /* Transiciones */
        .sidebar {
            transition: transform 0.3s ease-in-out;
        }

        .nav-item {
            position: relative;
            transition: all 0.3s ease;
        }

            .nav-item::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                height: 100%;
                width: 3px;
                background: #E31E24;
                transform: scaleY(0);
                transition: transform 0.3s ease;
            }

            .nav-item:hover::before,
            .nav-item.active::before {
                transform: scaleY(1);
            }

            .nav-item:hover {
                background: rgba(227, 30, 36, 0.1);
                padding-left: 1.25rem;
            }

        .logo-glow {
            filter: drop-shadow(0 0 15px rgba(227, 30, 36, 0.5));
        }

        /* Overlay para cerrar sidebar en móvil */
        .sidebar-overlay {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease-in-out;
        }

            .sidebar-overlay.active {
                opacity: 1;
                pointer-events: auto;
            }

        /* Animación del botón hamburguesa */
        .hamburger span {
            transition: all 0.3s ease;
        }

        .hamburger.active span:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }

        .hamburger.active span:nth-child(2) {
            opacity: 0;
        }

        .hamburger.active span:nth-child(3) {
            transform: rotate(-45deg) translate(7px, -6px);
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- OVERLAY PARA MÓVIL -->
    <div class="sidebar-overlay fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden" id="sidebarOverlay"></div>

    <!-- SIDEBAR -->
    <aside class="sidebar fixed left-0 top-0 h-screen w-64 bg-black text-white z-50 shadow-2xl" id="sidebar">
        <!-- Logo Header -->
        <div class="p-6 border-b-2 border-elit-red bg-gradient-to-b from-elit-gray to-black">
            <div class="flex flex-col items-center gap-3">
                <img src="/images/LogoElite.png" alt="ELIT GYM" class="w-32 h-32 object-contain logo-glow" />
                <div class="text-center">
                    <h1 class="text-3xl font-black text-white elit-logo-text">ELIT GYM</h1>
                    <div class="inline-block px-4 py-1 bg-elit-red rounded-full mt-2">
                        <p class="text-xs text-white uppercase tracking-widest font-bold">Panel Admin</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="p-4 space-y-1 overflow-y-auto h-[calc(100vh-320px)]">
            <!-- Dashboard -->
            <a href="/admin/dashboard" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all group">
                <i data-lucide="layout-dashboard" class="w-5 h-5 text-elit-red"></i>
                <span class="font-semibold">Dashboard</span>
            </a>

            <!-- Clientes -->
            <a href="/clientes" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all group">
                <i data-lucide="users" class="w-5 h-5 text-elit-red"></i>
                <span class="font-semibold">Clientes</span>
            </a>

            <!-- Membresías -->
            <a href="/membresias" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all group">
                <i data-lucide="credit-card" class="w-5 h-5 text-elit-red"></i>
                <span class="font-semibold">Membresías</span>
            </a>

            <!-- Planes -->
            <a href="/membresias/planes" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all group">
                <i data-lucide="star" class="w-5 h-5 text-elit-red"></i>
                <span class="font-semibold">Planes</span>
            </a>

            <!-- Tienda -->
            <a href="/productos" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all group">
                <i data-lucide="package" class="w-5 h-5 text-elit-red"></i>
                <span class="font-semibold">Tienda</span>
            </a>

            <!-- Sección Financiera -->
            <div class="pt-4 mt-4 border-t border-gray-800">
                <p class="text-xs text-gray-500 uppercase font-bold mb-3 px-4 tracking-wider">Gestión Financiera</p>

                <a href="/caja" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all group">
                    <i data-lucide="wallet" class="w-5 h-5 text-elit-red"></i>
                    <span class="font-semibold">Caja Diaria</span>
                </a>

                <a href="/cajafuerte" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all group">
                    <i data-lucide="vault" class="w-5 h-5 text-yellow-400"></i>
                    <span class="font-semibold">Caja Fuerte</span>
                </a>
            </div>

            <!-- Sección Reportes -->
            <div class="pt-4 mt-4 border-t border-gray-800">
                <p class="text-xs text-gray-500 uppercase font-bold mb-3 px-4 tracking-wider">Reportes</p>

                <a href="/reportes/ingresos-membresias" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all text-sm group">
                    <i data-lucide="trending-up" class="w-4 h-4 text-elit-red"></i>
                    <span class="font-medium">Ingresos Membresías</span>
                </a>

                <a href="/reportes/asistencia" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all text-sm group">
                    <i data-lucide="calendar-check" class="w-4 h-4 text-elit-red"></i>
                    <span class="font-medium">Asistencia</span>
                </a>

                <a href="/reportes/productos-mas-vendidos" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all text-sm group">
                    <i data-lucide="shopping-cart" class="w-4 h-4 text-elit-red"></i>
                    <span class="font-medium">Productos Vendidos</span>
                </a>

                <a href="/reportes/clientes-inactivos" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg transition-all text-sm group">
                    <i data-lucide="user-x" class="w-4 h-4 text-elit-red"></i>
                    <span class="font-medium">Clientes Inactivos</span>
                </a>
            </div>
        </nav>

        <!-- User Section -->
        <div class="absolute bottom-0 left-0 right-0 p-4 border-t-2 border-elit-red bg-gradient-to-t from-elit-gray to-black">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-12 h-12 rounded-lg bg-elit-red flex items-center justify-center text-white font-black text-xl shadow-lg">
                    A
                </div>
                <div class="flex-1">
                    <p class="text-sm font-bold text-white">Administrador</p>
                    <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold">ELIT GYM</p>
                </div>
            </div>
            <form action="/admin/logout" method="post" class="w-full">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-elit-red hover:bg-red-700 rounded-lg transition-all font-bold shadow-lg uppercase tracking-wide">
                    <i data-lucide="log-out" class="w-5 h-5"></i>
                    Cerrar Sesión
                </button>
            </form>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="lg:ml-64 min-h-screen bg-gray-50">
        <!-- Header -->
        <header class="bg-white shadow-md border-b-4 border-elit-red sticky top-0 z-30">
            <div class="px-4 sm:px-8 py-4 sm:py-6">
                <div class="flex items-center justify-between">
                    <!-- Botón Hamburguesa (solo móvil) -->
                    <button class="lg:hidden hamburger flex flex-col gap-1.5 p-2 rounded-lg hover:bg-gray-100 transition-colors" id="hamburgerBtn">
                        <span class="block w-6 h-0.5 bg-gray-900"></span>
                        <span class="block w-6 h-0.5 bg-gray-900"></span>
                        <span class="block w-6 h-0.5 bg-gray-900"></span>
                    </button>

                    <div class="flex-1 lg:flex-none">
                        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-gray-900 uppercase tracking-wide">
                            @ViewData["Title"]
                        </h2>
                        @if (ViewData["Subtitle"] != null)
                        {
                            <p class="text-xs sm:text-sm text-gray-600 mt-1 sm:mt-2 font-semibold">@ViewData["Subtitle"]</p>
                        }
                    </div>

                    <div class="hidden sm:flex items-center gap-4">
                        <div class="text-right px-4 lg:px-6 py-2 lg:py-3 bg-black rounded-lg border-2 border-elit-red shadow-lg">
                            <p class="text-xs text-gray-400 uppercase tracking-wide font-bold hidden lg:block">Última actualización</p>
                            <p class="text-xs lg:text-sm text-white font-bold" id="current-time"></p>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <div class="p-4 sm:p-6 lg:p-8">
            @RenderBody()
        </div>
    </main>

    <script>
        // Inicializar iconos de Lucide
        lucide.createIcons();

        // Actualizar reloj
        function updateTime() {
            const now = new Date();
            const timeStr = now.toLocaleString('es-ES', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
            const timeElement = document.getElementById('current-time');
            if (timeElement) {
                timeElement.textContent = timeStr;
            }
        }
        updateTime();
        setInterval(updateTime, 60000);

        // Marcar elemento activo en navegación
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            const navItems = document.querySelectorAll('.nav-item');

            navItems.forEach(item => {
                if (item.getAttribute('href') === currentPath) {
                    item.classList.add('active');
                    item.style.background = 'rgba(227, 30, 36, 0.15)';
                    item.style.paddingLeft = '1.25rem';
                }
            });

            // Control del menú hamburguesa
            const hamburgerBtn = document.getElementById('hamburgerBtn');
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            function toggleSidebar() {
                sidebar.classList.toggle('active');
                sidebarOverlay.classList.toggle('active');
                hamburgerBtn.classList.toggle('active');

                // Prevenir scroll del body cuando el menú está abierto
                if (sidebar.classList.contains('active')) {
                    document.body.style.overflow = 'hidden';
                } else {
                    document.body.style.overflow = '';
                }
            }

            function closeSidebar() {
                sidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
                hamburgerBtn.classList.remove('active');
                document.body.style.overflow = '';
            }

            // Toggle sidebar al hacer click en hamburguesa
            if (hamburgerBtn) {
                hamburgerBtn.addEventListener('click', toggleSidebar);
            }

            // Cerrar sidebar al hacer click en overlay
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', closeSidebar);
            }

            // Cerrar sidebar al hacer click en un link (solo en móvil)
            navItems.forEach(item => {
                item.addEventListener('click', function() {
                    if (window.innerWidth < 1024) {
                        closeSidebar();
                    }
                });
            });

            // Cerrar sidebar al cambiar a desktop
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 1024) {
                    closeSidebar();
                }
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
    
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JONELGYM</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'tauro-red': '#E31E24',
                        'tauro-dark': '#000000',
                        'tauro-gray': '#1a1a1a',
                        'tauro-light-red': '#FF4448',
                        'tauro-accent': '#C41E23'
                    }
                }
            }
        }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #000000 100%);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }

        .animate-pulse-red {
            animation: pulse-red 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }


        .text-glow {
            animation: glow 2s ease-in-out infinite;
        }

        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #0a0a0a;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #E31E24 0%, #C41E23 100%);
            border-radius: 5px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(180deg, #FF4448 0%, #E31E24 100%);
            }

        .tauro-card {
            transition: all 0.3s ease;
            border: 2px solid rgba(227, 30, 36, 0.2);
        }

            .tauro-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(227, 30, 36, 0.4);
                border-color: rgba(227, 30, 36, 0.6);
            }

        .btn-tauro {
            background: linear-gradient(135deg, #E31E24 0%, #C41E23 100%);
            transition: all 0.3s ease;
        }

            .btn-tauro:hover {
                background: linear-gradient(135deg, #FF4448 0%, #E31E24 100%);
                box-shadow: 0 8px 25px rgba(227, 30, 36, 0.5);
                transform: scale(1.05);
            }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body class="bg-black text-gray-100">
    @RenderBody()

    <script>
        lucide.createIcons();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

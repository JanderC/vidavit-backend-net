<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POWER FITNESS</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'pf-blue':       '#1E6FE3',
                        'pf-blue-dark':  '#1550B0',
                        'pf-purple':     '#6B3FA0',
                        'pf-purple-dark':'#4A2878',
                        'pf-dark':       '#05050F',
                        'pf-gray':       '#0D0D1A',
                        'pf-mid':        '#12122A',
                        'pf-accent':     '#3D8EFF',
                    }
                }
            }
        }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #05050F 0%, #0D0D1A 50%, #05050F 100%);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #05050F;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #1E6FE3 0%, #6B3FA0 100%);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #3D8EFF 0%, #1E6FE3 100%);
        }

        .pf-card {
            transition: all 0.3s ease;
            border: 1px solid rgba(30, 111, 227, 0.2);
        }

        .pf-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 36px rgba(30, 111, 227, 0.3);
            border-color: rgba(30, 111, 227, 0.5);
        }

        .btn-pf {
            background: linear-gradient(135deg, #1E6FE3 0%, #6B3FA0 100%);
            transition: all 0.3s ease;
        }

        .btn-pf:hover {
            background: linear-gradient(135deg, #3D8EFF 0%, #1E6FE3 100%);
            box-shadow: 0 6px 20px rgba(30, 111, 227, 0.45);
            transform: scale(1.04);
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body class="text-gray-100" style="background-color:#05050F;">
    @RenderBody()

    <script>
        lucide.createIcons();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

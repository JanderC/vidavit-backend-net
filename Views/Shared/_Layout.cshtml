<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Power Fitness</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'pf-blue':        '#3B82F6',
                        'pf-blue-bright': '#60A5FA',
                        'pf-blue-deep':   '#1E3A8A',
                        'pf-purple':      '#7C3AED',
                        'pf-dark':        '#060B18',
                        'pf-card':        '#0D1526',
                        'pf-border':      '#1E2D4A',
                    }
                }
            }
        }
    </script>

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            --pf-blue:        #3B82F6;
            --pf-blue-bright: #60A5FA;
            --pf-blue-deep:   #1E3A8A;
            --pf-purple:      #7C3AED;
            --pf-purple-light:#A78BFA;
            --pf-dark:        #060B18;
            --pf-card:        #0D1526;
            --pf-border:      #1E2D4A;
            --pf-text:        #E2E8F0;
            --pf-text-muted:  #64748B;
            --pf-text-soft:   #94A3B8;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #060B18 0%, #0D1526 50%, #060B18 100%);
            color: var(--pf-text);
            min-height: 100vh;
        }

        /* ─ Scrollbar ─ */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--pf-dark); }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--pf-blue) 0%, var(--pf-purple) 100%);
            border-radius: 999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, var(--pf-blue-bright) 0%, var(--pf-blue) 100%);
        }

        /* ─ Tarjeta genérica ─ */
        .pf-card {
            background: var(--pf-card);
            border: 1px solid var(--pf-border);
            border-radius: 1rem;
            transition: transform .25s, box-shadow .25s;
        }

        .pf-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 36px rgba(59,130,246,.15);
            border-color: rgba(96,165,250,.25);
        }

        /* ─ Botón primario ─ */
        .pf-btn {
            background: linear-gradient(135deg, var(--pf-blue) 0%, var(--pf-purple) 100%);
            color: #fff;
            border: none;
            border-radius: .75rem;
            font-family: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: box-shadow .25s, transform .2s;
            box-shadow: 0 4px 16px rgba(59,130,246,.25);
        }

        .pf-btn:hover {
            box-shadow: 0 8px 28px rgba(59,130,246,.4);
            transform: translateY(-1px) scale(1.02);
        }

        .pf-btn:active {
            transform: scale(.98);
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    @RenderBody()

    <script>
        lucide.createIcons();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

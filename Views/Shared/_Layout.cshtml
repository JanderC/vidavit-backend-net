<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PowerZone</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'pz-blue':      '#2B4FD8',
                        'pz-blue-dark': '#1a3ab5',
                        'pz-blue-light':'#4a6ee0',
                        'pz-gold':      '#D4A017',
                        'pz-gold-dark': '#b8880e',
                        'pz-dark':      '#0f1535',
                        'pz-dark2':     '#1a2050',
                        'pz-silver':    '#8899bb',
                    }
                }
            }
        }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #060b1e 0%, #0f1535 50%, #1a2050 100%);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }

        .animate-pulse-red {
            animation: pulse-red 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        .text-glow {
            animation: glow 2s ease-in-out infinite;
        }

        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #060b1e;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #D4A017 0%, #b8880e 100%);
            border-radius: 5px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(180deg, #e8bb2e 0%, #D4A017 100%);
            }

        .tauro-card {
            transition: all 0.3s ease;
            border: 2px solid rgba(43, 79, 216, 0.2);
        }

            .tauro-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(43, 79, 216, 0.35);
                border-color: rgba(212, 160, 23, 0.5);
            }

        .btn-tauro {
            background: linear-gradient(135deg, #D4A017 0%, #b8880e 100%);
            transition: all 0.3s ease;
        }

            .btn-tauro:hover {
                background: linear-gradient(135deg, #e8bb2e 0%, #D4A017 100%);
                box-shadow: 0 8px 25px rgba(212, 160, 23, 0.5);
                transform: scale(1.05);
            }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body class="text-gray-100" style="background:#060b1e;">
    @RenderBody()

    <script>
        lucide.createIcons();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
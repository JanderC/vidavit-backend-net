@model VidaFitBackend.Models.Cliente
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"{Model.Nombre} {Model.Apellido}";
    ViewData["Subtitle"] = "Información detallada del cliente";
}

<style>
    :root {
        --pf-blue:   #3B82F6; --pf-blueB: #60A5FA; --pf-deep: #1E3A8A;
        --pf-purple: #7C3AED; --pf-dark:  #060B18; --pf-card: #0D1526;
        --pf-border: #1E2D4A; --pf-text:  #E2E8F0; --pf-soft: #94A3B8;
        --pf-muted:  #64748B; --pf-green: #10B981; --pf-red:  #EF4444;
        --pf-orange: #F59E0B;
    }
    .pf-card {
        background: var(--pf-card);
        border: 1px solid var(--pf-border);
        border-radius: 1.125rem;
        padding: 2rem;
        box-shadow: 0 4px 24px rgba(0,0,0,.35);
        margin-bottom: 1.5rem;
    }
    .pf-info-cell {
        background: rgba(255,255,255,.03);
        border: 1px solid var(--pf-border);
        border-radius: .75rem;
        padding: 1rem;
    }
    .pf-info-label {
        font-size: .68rem; font-weight: 800; color: var(--pf-muted);
        text-transform: uppercase; letter-spacing: .12em; margin-bottom: .35rem;
    }
    .pf-info-value { font-weight: 800; color: var(--pf-text); font-size: 1rem; }
    .pf-badge {
        display: inline-flex; align-items: center; gap: .35rem;
        padding: .3rem .875rem; border-radius: 999px;
        font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em;
        border: 1px solid;
    }
    .pf-badge i { width: 14px !important; height: 14px !important; }
    .pf-badge-green  { color: var(--pf-green);  background: rgba(16,185,129,.1);   border-color: rgba(16,185,129,.3); }
    .pf-badge-red    { color: var(--pf-red);    background: rgba(239,68,68,.1);    border-color: rgba(239,68,68,.3); }
    .pf-badge-purple { color: #A78BFA;           background: rgba(124,58,237,.1);   border-color: rgba(124,58,237,.3); }
    .pf-section-title {
        font-size: 1.2rem; font-weight: 900; color: var(--pf-text);
        text-transform: uppercase; letter-spacing: .08em;
        display: flex; align-items: center; gap: .75rem;
        margin-bottom: 1.25rem; padding-bottom: .875rem;
        border-bottom: 1px solid var(--pf-border);
    }
    .pf-section-title i { color: var(--pf-blueB) !important; }
    .pf-membresia-card {
        border: 1px solid var(--pf-border);
        border-radius: .875rem;
        padding: 1.25rem 1.5rem;
        transition: border-color .2s;
        margin-bottom: .75rem;
        background: rgba(255,255,255,.02);
    }
    .pf-membresia-card:hover { border-color: var(--pf-blue); }
    .pf-checkin-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: .875rem 1rem; border: 1px solid var(--pf-border);
        border-radius: .75rem; margin-bottom: .5rem;
        transition: background .15s;
    }
    .pf-checkin-row:hover { background: rgba(59,130,246,.04); }
</style>

<div>
    <!-- Encabezado acciones -->
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem;">
        <a href="/clientes"
           style="display:inline-flex; align-items:center; gap:.5rem; color:#64748B; font-weight:700; text-decoration:none; font-size:.85rem; transition:color .2s;"
           onmouseover="this.style.color='#60A5FA'" onmouseout="this.style.color='#64748B'">
            <i data-lucide="arrow-left" style="width:18px;height:18px;"></i>
            Volver a Clientes
        </a>
        <div style="display:flex; gap:.75rem;">
            <a href="/clientes/edit/@Model.Id"
               style="display:inline-flex; align-items:center; gap:.5rem; padding:.65rem 1.5rem; background:linear-gradient(135deg,#92400E,#B45309); color:#FCD34D; border-radius:.875rem; text-decoration:none; font-weight:800; font-size:.82rem; text-transform:uppercase; letter-spacing:.06em; box-shadow:0 4px 16px rgba(180,83,9,.25); transition:transform .2s;"
               onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                <i data-lucide="edit" style="width:16px;height:16px;"></i>
                Editar
            </a>
        </div>
    </div>

    <!-- Información Principal -->
    <div class="pf-card">
        <div style="display:flex; align-items:flex-start; gap:1.5rem;">
            <!-- Foto -->
            <div style="flex-shrink:0;">
                @if (!string.IsNullOrEmpty(Model.FotoBase64))
                {
                    <img src="data:image/jpeg;base64,@Model.FotoBase64"
                         style="width:140px;height:140px;border-radius:1rem;object-fit:cover;border:3px solid #3B82F6;box-shadow:0 8px 32px rgba(59,130,246,.2);" alt="@Model.Nombre">
                }
                else
                {
                    <div style="width:140px;height:140px;border-radius:1rem;background:rgba(59,130,246,.08);border:3px solid #1E2D4A;display:flex;align-items:center;justify-content:center;">
                        <i data-lucide="user" style="width:64px;height:64px;color:#1E2D4A;"></i>
                    </div>
                }
            </div>

            <!-- Info -->
            <div style="flex:1;">
                <h2 style="font-size:2rem; font-weight:900; color:#E2E8F0; text-transform:uppercase; letter-spacing:.06em; margin:0 0 1.25rem 0;">@Model.Nombre @Model.Apellido</h2>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:.875rem; margin-bottom:1.25rem;">
                    <div class="pf-info-cell">
                        <div class="pf-info-label">Cédula</div>
                        <div class="pf-info-value" style="font-family:monospace;color:#60A5FA;">@Model.Cedula</div>
                    </div>
                    <div class="pf-info-cell">
                        <div class="pf-info-label">Teléfono</div>
                        <div class="pf-info-value">@Model.Telefono</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div class="pf-info-cell">
                            <div class="pf-info-label">Email</div>
                            <div class="pf-info-value" style="font-size:.9rem;">@Model.Email</div>
                        </div>
                    }
                    @if (Model.FechaNacimiento.HasValue)
                    {
                        <div class="pf-info-cell">
                            <div class="pf-info-label">Fecha de Nacimiento</div>
                            <div class="pf-info-value">@Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Direccion))
                {
                    <div class="pf-info-cell" style="margin-bottom:1rem;">
                        <div class="pf-info-label">Dirección</div>
                        <div style="color:#94A3B8;font-weight:600;font-size:.9rem;">@Model.Direccion</div>
                    </div>
                }

                <div style="display:flex; gap:.5rem; flex-wrap:wrap;">
                    @if (Model.Activo)
                    {
                        <span class="pf-badge pf-badge-green">
                            <i data-lucide="check-circle"></i> Activo
                        </span>
                    }
                    else
                    {
                        <span class="pf-badge pf-badge-red">
                            <i data-lucide="x-circle"></i> Inactivo
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.HuellaTemplate))
                    {
                        <span class="pf-badge pf-badge-purple">
                            <i data-lucide="fingerprint"></i> Con Huella
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Membresías -->
    <div class="pf-card">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem;">
            <h3 class="pf-section-title" style="margin:0;border:none;padding:0;">
                <i data-lucide="credit-card"></i>
                Membresías
            </h3>
            <button onclick="window.location.href='/membresias/crear?clienteId=@Model.Id'"
                    style="display:inline-flex; align-items:center; gap:.5rem; padding:.65rem 1.25rem; background:linear-gradient(135deg,#3B82F6,#7C3AED); color:#fff; border:none; border-radius:.875rem; font-weight:800; font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; cursor:pointer; font-family:inherit; box-shadow:0 4px 16px rgba(59,130,246,.3); transition:transform .2s;"
                    onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                <i data-lucide="plus" style="width:16px;height:16px;"></i>
                Nueva Membresía
            </button>
        </div>
        <div id="membresias-list">
            <div style="text-align:center;padding:2rem;color:#64748B;">
                <i data-lucide="loader" style="width:36px;height:36px;display:block;margin:0 auto .75rem;color:#3B82F6;"></i>
                <p style="font-weight:700;margin:0;">Cargando membresías...</p>
            </div>
        </div>
    </div>

    <!-- Check-ins -->
    <div class="pf-card">
        <h3 class="pf-section-title">
            <i data-lucide="history"></i>
            Historial de Check-ins
        </h3>
        <div id="checkins-list">
            <div style="text-align:center;padding:2rem;color:#64748B;">
                <i data-lucide="loader" style="width:36px;height:36px;display:block;margin:0 auto .75rem;color:#3B82F6;"></i>
                <p style="font-weight:700;margin:0;">Cargando historial...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        const clienteId = '@Model.Id';

        const PF = {
            green:'#10B981', orange:'#F59E0B', red:'#EF4444',
            blue:'#3B82F6', blueB:'#60A5FA', border:'#1E2D4A',
            text:'#E2E8F0', soft:'#94A3B8', muted:'#64748B'
        };

        async function loadMembresias() {
            try {
                const response = await fetch(`${API_URL}/Clientes/${clienteId}/membresias`);
                const membresias = await response.json();
                const container = document.getElementById('membresias-list');

                if (membresias.length === 0) {
                    container.innerHTML = `
                        <div style="text-align:center;padding:2.5rem 1rem;color:${PF.muted};">
                            <i data-lucide="inbox" style="width:48px;height:48px;display:block;margin:0 auto .75rem;"></i>
                            <p style="font-weight:700;font-size:1rem;margin:0;">No hay membresías registradas</p>
                        </div>`;
                } else {
                    container.innerHTML = membresias.map(m => {
                        const fechaVenc   = new Date(m.fechaVencimiento || m.FechaVencimiento);
                        const fechaInicio = new Date(m.fechaInicio || m.FechaInicio);
                        const montoPagado = m.montoPagado || m.MontoPagado || 0;
                        const estado      = m.estado || m.Estado || 'desconocido';
                        const planNombre  = m.plan?.nombre || m.Plan?.Nombre || m.plan?.Nombre || m.Plan?.nombre || 'Plan';
                        const hoy         = new Date();
                        const diasRestantes = Math.ceil((fechaVenc - hoy) / (1000 * 60 * 60 * 24));

                        let badgeColor = PF.soft, badgeBg = 'rgba(100,116,139,.1)', badgeBorder = 'rgba(100,116,139,.2)', estadoIcon = 'circle';
                        if (estado === 'activa') {
                            if (diasRestantes <= 3)      { badgeColor='#F87171'; badgeBg='rgba(239,68,68,.1)'; badgeBorder='rgba(239,68,68,.3)'; estadoIcon='alert-circle'; }
                            else if (diasRestantes <= 7) { badgeColor=PF.orange; badgeBg='rgba(245,158,11,.1)'; badgeBorder='rgba(245,158,11,.3)'; estadoIcon='alert-triangle'; }
                            else                         { badgeColor=PF.green;  badgeBg='rgba(16,185,129,.1)'; badgeBorder='rgba(16,185,129,.3)'; estadoIcon='check-circle'; }
                        } else if (estado === 'vencida') {
                            badgeColor='#F87171'; badgeBg='rgba(239,68,68,.1)'; badgeBorder='rgba(239,68,68,.3)'; estadoIcon='x-circle';
                        }

                        return `
                            <div class="pf-membresia-card">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <div style="flex:1;">
                                        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.75rem;">
                                            <span style="font-weight:900;color:${PF.text};font-size:1rem;text-transform:uppercase;">${planNombre}</span>
                                            <span style="display:inline-flex;align-items:center;gap:.3rem;padding:.25rem .75rem;background:${badgeBg};color:${badgeColor};border:1px solid ${badgeBorder};border-radius:999px;font-size:.68rem;font-weight:800;text-transform:uppercase;">
                                                <i data-lucide="${estadoIcon}" style="width:11px;height:11px;"></i>
                                                ${estado}
                                            </span>
                                        </div>
                                        <div style="font-size:.82rem;color:${PF.soft};font-weight:600;">
                                            <span>Inicio: ${fechaInicio.toLocaleDateString('es-ES')}</span>
                                            <span style="margin:0 .5rem;">•</span>
                                            <span>Vence: ${fechaVenc.toLocaleDateString('es-ES')}</span>
                                            ${estado === 'activa' ? `<span style="margin:0 .5rem;">•</span><span style="font-weight:800;color:${PF.blueB};">${diasRestantes} días restantes</span>` : ''}
                                        </div>
                                        <div style="font-size:.85rem;color:${PF.muted};margin-top:.5rem;">
                                            Monto: <span style="font-weight:900;color:${PF.green};font-size:1rem;">$${montoPagado.toFixed(2)}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>`;
                    }).join('');
                }
                lucide.createIcons();
            } catch (error) { console.error('Error cargando membresías:', error); }
        }

        async function loadCheckIns() {
            try {
                const response = await fetch(`${API_URL}/CheckIn/cliente/${clienteId}?limit=20`);
                const data = await response.json();
                const checkIns = data.checkIns;
                const container = document.getElementById('checkins-list');

                if (checkIns.length === 0) {
                    container.innerHTML = `
                        <div style="text-align:center;padding:2.5rem 1rem;color:${PF.muted};">
                            <i data-lucide="inbox" style="width:48px;height:48px;display:block;margin:0 auto .75rem;"></i>
                            <p style="font-weight:700;font-size:1rem;margin:0;">No hay check-ins registrados</p>
                        </div>`;
                } else {
                    container.innerHTML = checkIns.map(ci => {
                        const fecha   = new Date(ci.FechaHora || ci.fechaHora);
                        const exitoso = ci.Exitoso !== undefined ? ci.Exitoso : ci.exitoso;
                        const metodo  = ci.Metodo || ci.metodo;
                        const nota    = ci.Nota   || ci.nota;
                        const iconColor = exitoso ? PF.green : PF.red;
                        const icon      = exitoso ? 'check-circle' : 'x-circle';
                        return `
                            <div class="pf-checkin-row">
                                <div style="display:flex;align-items:center;gap:1rem;">
                                    <i data-lucide="${icon}" style="width:22px;height:22px;color:${iconColor};"></i>
                                    <div>
                                        <p style="font-weight:800;color:${PF.text};margin:0 0 .2rem 0;">${fecha.toLocaleDateString('es-ES')} ${fecha.toLocaleTimeString('es-ES')}</p>
                                        <p style="font-size:.78rem;color:${PF.soft};font-weight:600;margin:0;">${nota || 'Check-in exitoso'}</p>
                                    </div>
                                </div>
                                <span style="padding:.3rem .875rem;background:rgba(59,130,246,.08);color:${PF.blueB};border:1px solid rgba(59,130,246,.2);border-radius:.625rem;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;">
                                    ${metodo}
                                </span>
                            </div>`;
                    }).join('');
                }
                lucide.createIcons();
            } catch (error) { console.error('Error cargando check-ins:', error); }
        }

        window.addEventListener('load', function() {
            loadMembresias();
            loadCheckIns();
            lucide.createIcons();
        });
    </script>
}

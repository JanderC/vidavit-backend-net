@model VidaFitBackend.Models.Cliente
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"{Model.Nombre} {Model.Apellido}";
    ViewData["Subtitle"] = "Información detallada del cliente";
}

<div class="space-y-6">
    <!-- Header con acciones -->
    <div class="flex items-center justify-between">
        <a href="/clientes" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 font-bold transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
            Volver a Clientes
        </a>

        <div class="flex gap-3">
            <a href="/clientes/edit/@Model.Id"
               class="px-6 py-3 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white rounded-xl transition-all inline-flex items-center gap-2 font-black uppercase tracking-wide shadow-xl hover:shadow-2xl transform hover:scale-105">
                <i data-lucide="edit" class="w-5 h-5"></i>
                Editar
            </a>
        </div>
    </div>

    <!-- Información Principal -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
        <div class="flex items-start gap-6">
            <!-- Foto -->
            <div class="flex-shrink-0">
                @if (!string.IsNullOrEmpty(Model.FotoBase64))
                {
                    <img src="data:image/jpeg;base64,@Model.FotoBase64"
                         class="w-40 h-40 rounded-2xl object-cover border-4 border-orange-600 shadow-xl" alt="@Model.Nombre">
                }
                else
                {
                    <div class="w-40 h-40 rounded-2xl bg-gray-100 border-4 border-gray-300 flex items-center justify-center">
                        <i data-lucide="user" class="w-20 h-20 text-gray-400"></i>
                    </div>
                }
            </div>

            <!-- Información -->
            <div class="flex-1">
                <h2 class="text-4xl font-black text-gray-900 mb-4 uppercase tracking-wide">@Model.Nombre @Model.Apellido</h2>

                <div class="grid grid-cols-2 gap-6 mt-6">
                    <div class="bg-gray-50 p-4 rounded-xl border-2 border-gray-200">
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Cédula</p>
                        <p class="font-black text-gray-900 text-lg">@Model.Cedula</p>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-xl border-2 border-gray-200">
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Teléfono</p>
                        <p class="font-black text-gray-900 text-lg">@Model.Telefono</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div class="bg-gray-50 p-4 rounded-xl border-2 border-gray-200">
                            <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Email</p>
                            <p class="font-bold text-gray-900">@Model.Email</p>
                        </div>
                    }
                    @if (Model.FechaNacimiento.HasValue)
                    {
                        <div class="bg-gray-50 p-4 rounded-xl border-2 border-gray-200">
                            <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Fecha de Nacimiento</p>
                            <p class="font-black text-gray-900 text-lg">@Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")</p>
                        </div>
                    }
                    @if (Model.Peso.HasValue)
                    {
                        <div class="bg-orange-50 p-4 rounded-xl border-2 border-orange-200">
                            <p class="text-sm text-orange-700 mb-1 font-black uppercase tracking-wide flex items-center gap-1">
                                <i data-lucide="weight" class="w-4 h-4"></i>
                                Peso
                            </p>
                            <p class="font-black text-orange-600 text-2xl">@Model.Peso.Value.ToString("F1") kg</p>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Direccion))
                {
                    <div class="mt-6 bg-gray-50 p-4 rounded-xl border-2 border-gray-200">
                        <p class="text-sm text-gray-600 mb-1 font-black uppercase tracking-wide">Dirección</p>
                        <p class="font-bold text-gray-900">@Model.Direccion</p>
                    </div>
                }

                <div class="mt-6 flex gap-3">
                    @if (Model.Activo)
                    {
                        <span class="px-4 py-2 bg-orange-100 text-orange-800 font-black rounded-full uppercase tracking-wide text-xs inline-flex items-center gap-2">
                            <i data-lucide="check-circle" class="w-4 h-4"></i> Activo
                        </span>
                    }
                    else
                    {
                        <span class="px-4 py-2 bg-red-100 text-orange-800 font-black rounded-full uppercase tracking-wide text-xs inline-flex items-center gap-2">
                            <i data-lucide="x-circle" class="w-4 h-4"></i> Inactivo
                        </span>
                    }

                    @if (!string.IsNullOrEmpty(Model.HuellaTemplate))
                    {
                        <span class="px-4 py-2 bg-gray-100 text-purple-800 font-black rounded-full uppercase tracking-wide text-xs inline-flex items-center gap-2">
                            <i data-lucide="fingerprint" class="w-4 h-4"></i> Con Huella
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Membresías -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-2xl font-black text-gray-900 flex items-center gap-3 uppercase tracking-wide">
                <i data-lucide="credit-card" class="w-6 h-6 text-orange-600"></i>
                Membresías
            </h3>
            <button onclick="window.location.href='/membresias/crear?clienteId=@Model.Id'"
                    class="px-6 py-3 bg-gradient-to-r from-orange-600 to-orange-800 hover:from-orange-700 hover:to-orange-900 text-white font-black rounded-xl transition-all inline-flex items-center gap-2 shadow-xl hover:shadow-2xl uppercase tracking-wide transform hover:scale-105">
                <i data-lucide="plus" class="w-5 h-5"></i>
                Nueva Membresía
            </button>
        </div>

        <div id="membresias-list" class="space-y-4">
            <div class="text-center py-12 text-gray-500">
                <i data-lucide="loader" class="w-10 h-10 mx-auto mb-3 animate-spin"></i>
                <p class="font-bold">Cargando membresías...</p>
            </div>
        </div>
    </div>

    <!-- Historial de Check-ins -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
        <h3 class="text-2xl font-black text-gray-900 mb-6 flex items-center gap-3 uppercase tracking-wide">
            <i data-lucide="history" class="w-6 h-6 text-orange-600"></i>
            Historial de Check-ins
        </h3>

        <div id="checkins-list" class="space-y-3">
            <div class="text-center py-12 text-gray-500">
                <i data-lucide="loader" class="w-10 h-10 mx-auto mb-3 animate-spin"></i>
                <p class="font-bold">Cargando historial...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        const clienteId = '@Model.Id';

        // Cargar membresías
        async function loadMembresias() {
            try {
                const response = await fetch(`${API_URL}/Clientes/${clienteId}/membresias`);
                const membresias = await response.json();

                const container = document.getElementById('membresias-list');

                if (membresias.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-12 text-gray-500">
                            <i data-lucide="inbox" class="w-16 h-16 mx-auto mb-4 text-gray-400"></i>
                            <p class="font-bold text-lg">No hay membresías registradas</p>
                        </div>
                    `;
                } else {
                    container.innerHTML = membresias.map(m => {
                        const fechaVenc = new Date(m.fechaVencimiento || m.FechaVencimiento);
                        const fechaInicio = new Date(m.fechaInicio || m.FechaInicio);
                        const montoPagado = m.montoPagado || m.MontoPagado || 0;
                        const estado = m.estado || m.Estado || 'desconocido';
                        const planNombre = m.plan?.nombre || m.Plan?.Nombre || m.plan?.Nombre || m.Plan?.nombre || 'Plan';

                        const hoy = new Date();
                        const diasRestantes = Math.ceil((fechaVenc - hoy) / (1000 * 60 * 60 * 24));

                        let estadoClass = 'bg-gray-100 text-gray-800';
                        let estadoIcon = 'circle';

                        if (estado === 'activa') {
                            if (diasRestantes <= 3) {
                                estadoClass = 'bg-red-100 text-orange-800';
                                estadoIcon = 'alert-circle';
                            } else if (diasRestantes <= 7) {
                                estadoClass = 'bg-amber-100 text-amber-800';
                                estadoIcon = 'alert-triangle';
                            } else {
                                estadoClass = 'bg-orange-100 text-orange-800';
                                estadoIcon = 'check-circle';
                            }
                        } else if (estado === 'vencida') {
                            estadoClass = 'bg-red-100 text-orange-800';
                            estadoIcon = 'x-circle';
                        }

                        return `
                            <div class="p-6 border-2 border-gray-200 rounded-2xl hover:border-orange-600 transition-all shadow-lg hover:shadow-xl">
                                <div class="flex items-center justify-between">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-3 mb-3">
                                            <span class="font-black text-gray-900 text-lg uppercase">${planNombre}</span>
                                            <span class="px-4 py-2 ${estadoClass} font-black rounded-full uppercase tracking-wide text-xs inline-flex items-center gap-2">
                                                <i data-lucide="${estadoIcon}" class="w-4 h-4"></i>
                                                ${estado}
                                            </span>
                                        </div>
                                        <div class="text-sm text-gray-600 font-bold">
                                            <span>Inicio: ${fechaInicio.toLocaleDateString('es-ES')}</span>
                                            <span class="mx-2">•</span>
                                            <span>Vence: ${fechaVenc.toLocaleDateString('es-ES')}</span>
                                            ${estado === 'activa' ? `<span class="mx-2">•</span><span class="font-black text-orange-600">${diasRestantes} días restantes</span>` : ''}
                                        </div>
                                        <div class="text-sm text-gray-700 mt-2">
                                            Monto: <span class="font-black text-orange-600 text-lg">$${montoPagado.toFixed(2)}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');
                }

                lucide.createIcons();
            } catch (error) {
                console.error('Error cargando membresías:', error);
            }
        }

        // Cargar check-ins
        async function loadCheckIns() {
            try {
                const response = await fetch(`${API_URL}/CheckIn/cliente/${clienteId}?limit=20`);
                const data = await response.json();
                const checkIns = data.checkIns;

                const container = document.getElementById('checkins-list');

                if (checkIns.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-12 text-gray-500">
                            <i data-lucide="inbox" class="w-16 h-16 mx-auto mb-4 text-gray-400"></i>
                            <p class="font-bold text-lg">No hay check-ins registrados</p>
                        </div>
                    `;
                } else {
                    container.innerHTML = checkIns.map(ci => {
                        const fecha = new Date(ci.FechaHora || ci.fechaHora);
                        const exitoso = ci.Exitoso !== undefined ? ci.Exitoso : ci.exitoso;
                        const metodo = ci.Metodo || ci.metodo;
                        const nota = ci.Nota || ci.nota;

                        const iconClass = exitoso ? 'text-orange-500' : 'text-orange-500';
                        const icon = exitoso ? 'check-circle' : 'x-circle';

                        return `
                            <div class="flex items-center justify-between p-4 border-2 border-gray-200 rounded-xl hover:bg-gray-50 hover:border-orange-600 transition-all">
                                <div class="flex items-center gap-4">
                                    <i data-lucide="${icon}" class="w-6 h-6 ${iconClass}"></i>
                                    <div>
                                        <p class="font-black text-gray-900">${fecha.toLocaleDateString('es-ES')} ${fecha.toLocaleTimeString('es-ES')}</p>
                                        <p class="text-sm text-gray-600 font-semibold">${nota || 'Check-in exitoso'}</p>
                                    </div>
                                </div>
                                <span class="px-4 py-2 bg-gray-100 text-gray-900 font-black rounded-xl uppercase tracking-wide text-xs">
                                    ${metodo}
                                </span>
                            </div>
                        `;
                    }).join('');
                }

                lucide.createIcons();
            } catch (error) {
                console.error('Error cargando check-ins:', error);
            }
        }

        // Cargar datos al iniciar
        window.addEventListener('load', function() {
            loadMembresias();
            loadCheckIns();
            lucide.createIcons();
        });
    </script>
}

@model VidaFitBackend.Models.Cliente
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"{Model.Nombre} {Model.Apellido}";
    ViewData["Subtitle"] = "Información detallada del cliente";
}

<style>
    .tz-panel {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.15);
        border-radius: 1rem;
        overflow: hidden;
    }

    .tz-panel-header {
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid rgba(34,197,94,0.12);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .tz-panel-header h3 {
            display: flex;
            align-items: center;
            gap: .6rem;
            font-size: 1rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #f9fafb;
        }

            .tz-panel-header h3 i {
                color: #22c55e;
            }

    .tz-field {
        background: rgba(34,197,94,0.04);
        border: 1px solid rgba(34,197,94,0.1);
        border-radius: .65rem;
        padding: .85rem 1rem;
    }

    .tz-field-label {
        font-size: .65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #6b7280;
        margin-bottom: .25rem;
    }

    .tz-field-value {
        font-weight: 700;
        color: #f9fafb;
        font-size: .95rem;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .3rem .75rem;
        border-radius: 99px;
        font-size: .7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .badge-active {
        background: rgba(16,185,129,0.12);
        color: #10b981;
        border: 1px solid rgba(16,185,129,0.25);
    }

    .badge-inactive {
        background: rgba(239,68,68,0.12);
        color: #ef4444;
        border: 1px solid rgba(239,68,68,0.25);
    }

    .badge-huella {
        background: rgba(168,85,247,0.12);
        color: #a855f7;
        border: 1px solid rgba(168,85,247,0.25);
    }

    .tz-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .65rem 1.25rem;
        border-radius: .65rem;
        background: linear-gradient(135deg,#22c55e,#15803d);
        color: #fff;
        font-weight: 800;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        text-decoration: none;
        transition: all .2s;
    }

        .tz-btn-primary:hover {
            background: linear-gradient(135deg,#16a34a,#166534);
            box-shadow: 0 4px 16px rgba(34,197,94,0.3);
            transform: translateY(-1px);
        }

    .tz-btn-amber {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .65rem 1.25rem;
        border-radius: .65rem;
        background: linear-gradient(135deg,#f59e0b,#b45309);
        color: #fff;
        font-weight: 800;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        text-decoration: none;
        transition: all .2s;
    }

        .tz-btn-amber:hover {
            background: linear-gradient(135deg,#d97706,#92400e);
            transform: translateY(-1px);
        }

    .membresia-card {
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        transition: border-color .15s, background .15s;
    }

        .membresia-card:hover {
            border-color: rgba(34,197,94,0.25);
            background: rgba(34,197,94,0.03);
        }

    .checkin-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .75rem 1rem;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: .65rem;
        transition: background .15s;
    }

        .checkin-row:hover {
            background: rgba(34,197,94,0.03);
        }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        color: #6b7280;
        font-weight: 700;
        font-size: .82rem;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: .07em;
        transition: color .15s;
    }

        .back-link:hover {
            color: #22c55e;
        }
</style>

<div class="space-y-6">

    <!-- Toolbar -->
    <div class="flex items-center justify-between flex-wrap gap-3">
        <a href="/clientes" class="back-link">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Volver a Clientes
        </a>
        <a href="/clientes/edit/@Model.Id" class="tz-btn-amber">
            <i data-lucide="edit" class="w-4 h-4"></i>
            Editar Cliente
        </a>
    </div>

    <!-- Información Principal -->
    <div class="tz-panel">
        <div class="tz-panel-header">
            <h3><i data-lucide="user"></i> Información Personal</h3>
        </div>
        <div style="padding:1.5rem">
            <div style="display:flex;align-items:flex-start;gap:1.5rem;flex-wrap:wrap">

                <!-- Foto -->
                <div style="flex-shrink:0">
                    @if (!string.IsNullOrEmpty(Model.FotoBase64))
                    {
                        <img src="data:image/jpeg;base64,@Model.FotoBase64"
                             style="width:8rem;height:8rem;border-radius:.85rem;object-fit:cover;border:2px solid rgba(34,197,94,0.4)"
                             alt="@Model.Nombre" />
                    }
                    else
                    {
                        <div style="width:8rem;height:8rem;border-radius:.85rem;background:rgba(34,197,94,0.06);border:2px solid rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center">
                            <i data-lucide="user" style="width:3rem;height:3rem;color:#374151"></i>
                        </div>
                    }
                </div>

                <!-- Data -->
                <div style="flex:1;min-width:0">
                    <h2 style="font-size:1.75rem;font-weight:900;color:#f9fafb;text-transform:uppercase;letter-spacing:.05em;margin-bottom:1rem">
                        @Model.Nombre @Model.Apellido
                    </h2>

                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(10rem,1fr));gap:.75rem;margin-bottom:1rem">
                        <div class="tz-field">
                            <div class="tz-field-label">Cédula</div>
                            <div class="tz-field-value" style="font-family:monospace">@Model.Cedula</div>
                        </div>
                        <div class="tz-field">
                            <div class="tz-field-label">Teléfono</div>
                            <div class="tz-field-value">@(Model.Telefono ?? "—")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <div class="tz-field">
                                <div class="tz-field-label">Email</div>
                                <div class="tz-field-value" style="font-size:.85rem">@Model.Email</div>
                            </div>
                        }
                        @if (Model.FechaNacimiento.HasValue)
                        {
                            <div class="tz-field">
                                <div class="tz-field-label">Fecha de Nacimiento</div>
                                <div class="tz-field-value">@Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")</div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Direccion))
                    {
                        <div class="tz-field" style="margin-bottom:.75rem">
                            <div class="tz-field-label">Dirección</div>
                            <div class="tz-field-value" style="font-size:.88rem">@Model.Direccion</div>
                        </div>
                    }

                    <div style="display:flex;gap:.5rem;flex-wrap:wrap">
                        @if (Model.Activo)
                        {
                            <span class="badge badge-active">
                                <i data-lucide="check-circle" style="width:.8rem;height:.8rem"></i> Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">
                                <i data-lucide="x-circle" style="width:.8rem;height:.8rem"></i> Inactivo
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.HuellaTemplate))
                        {
                            <span class="badge badge-huella">
                                <i data-lucide="fingerprint" style="width:.8rem;height:.8rem"></i> Con Huella
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Membresías -->
    <div class="tz-panel">
        <div class="tz-panel-header">
            <h3><i data-lucide="credit-card"></i> Membresías</h3>
            <button onclick="window.location.href='/membresias/crear?clienteId=@Model.Id'"
                    class="tz-btn-primary" style="cursor:pointer;border:none;padding:.5rem 1rem">
                <i data-lucide="plus" style="width:.9rem;height:.9rem"></i>
                Nueva Membresía
            </button>
        </div>
        <div style="padding:1.25rem">
            <div id="membresias-list" class="space-y-3">
                <div style="text-align:center;padding:3rem;color:#6b7280">
                    <i data-lucide="loader" style="width:2rem;height:2rem;display:block;margin:0 auto .75rem;color:#374151" class="animate-spin"></i>
                    <p style="font-weight:700;font-size:.85rem">Cargando membresías...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Check-ins -->
    <div class="tz-panel">
        <div class="tz-panel-header">
            <h3><i data-lucide="history"></i> Historial de Check-ins</h3>
        </div>
        <div style="padding:1.25rem">
            <div id="checkins-list" class="space-y-2">
                <div style="text-align:center;padding:3rem;color:#6b7280">
                    <i data-lucide="loader" style="width:2rem;height:2rem;display:block;margin:0 auto .75rem;color:#374151" class="animate-spin"></i>
                    <p style="font-weight:700;font-size:.85rem">Cargando historial...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        const clienteId = '@Model.Id';

        async function loadMembresias() {
            try {
                const response = await fetch(`${API_URL}/Clientes/${clienteId}/membresias`);
                const membresias = await response.json();
                const container = document.getElementById('membresias-list');

                if (membresias.length === 0) {
                    container.innerHTML = `
                        <div style="text-align:center;padding:3rem;color:#6b7280">
                            <i data-lucide="inbox" style="width:2.5rem;height:2.5rem;display:block;margin:0 auto .75rem;color:#374151"></i>
                            <p style="font-weight:700">No hay membresías registradas</p>
                        </div>`;
                } else {
                    container.innerHTML = membresias.map(m => {
                        const fechaVenc   = new Date(m.fechaVencimiento || m.FechaVencimiento);
                        const fechaInicio = new Date(m.fechaInicio      || m.FechaInicio);
                        const montoPagado = m.montoPagado || m.MontoPagado || 0;
                        const estado      = m.estado || m.Estado || 'desconocido';
                        const planNombre  = m.plan?.nombre || m.Plan?.Nombre || m.plan?.Nombre || m.Plan?.nombre || 'Plan';
                        const hoy         = new Date();
                        const diasRestantes = Math.ceil((fechaVenc - hoy) / (1000 * 60 * 60 * 24));

                        let badgeStyle = 'background:rgba(75,85,99,0.15);color:#9ca3af;border:1px solid rgba(75,85,99,0.25)';
                        if (estado === 'activa') {
                            if (diasRestantes <= 3)      badgeStyle = 'background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3)';
                            else if (diasRestantes <= 7) badgeStyle = 'background:rgba(245,158,11,0.15);color:#f59e0b;border:1px solid rgba(245,158,11,0.3)';
                            else                         badgeStyle = 'background:rgba(16,185,129,0.12);color:#10b981;border:1px solid rgba(16,185,129,0.25)';
                        } else if (estado === 'vencida') {
                            badgeStyle = 'background:rgba(239,68,68,0.12);color:#ef4444;border:1px solid rgba(239,68,68,0.25)';
                        }

                        return `
                            <div class="membresia-card">
                                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
                                    <div style="flex:1">
                                        <div style="display:flex;align-items:center;gap:.65rem;margin-bottom:.5rem;flex-wrap:wrap">
                                            <span style="font-weight:900;color:#f9fafb;font-size:.95rem;text-transform:uppercase">${planNombre}</span>
                                            <span style="${badgeStyle};padding:.2rem .65rem;border-radius:99px;font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em">${estado}</span>
                                        </div>
                                        <div style="font-size:.78rem;color:#9ca3af;font-weight:600">
                                            Inicio: ${fechaInicio.toLocaleDateString('es-ES')}
                                            &nbsp;·&nbsp;
                                            Vence: ${fechaVenc.toLocaleDateString('es-ES')}
                                            ${estado === 'activa' ? `&nbsp;·&nbsp;<span style="color:#22c55e;font-weight:800">${diasRestantes}d restantes</span>` : ''}
                                        </div>
                                        <div style="font-size:.82rem;color:#9ca3af;margin-top:.35rem">
                                            Pagado: <span style="color:#22c55e;font-weight:900">$${montoPagado.toFixed(2)}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>`;
                    }).join('');
                }
                lucide.createIcons();
            } catch (error) {
                console.error('Error cargando membresías:', error);
            }
        }

        async function loadCheckIns() {
            try {
                const response = await fetch(`${API_URL}/CheckIn/cliente/${clienteId}?limit=20`);
                const data = await response.json();
                const checkIns = data.checkIns;
                const container = document.getElementById('checkins-list');

                if (checkIns.length === 0) {
                    container.innerHTML = `
                        <div style="text-align:center;padding:3rem;color:#6b7280">
                            <i data-lucide="inbox" style="width:2.5rem;height:2.5rem;display:block;margin:0 auto .75rem;color:#374151"></i>
                            <p style="font-weight:700">No hay check-ins registrados</p>
                        </div>`;
                } else {
                    container.innerHTML = checkIns.map(ci => {
                        const fecha   = new Date(ci.FechaHora || ci.fechaHora);
                        const exitoso = ci.Exitoso !== undefined ? ci.Exitoso : ci.exitoso;
                        const metodo  = ci.Metodo  || ci.metodo;
                        const nota    = ci.Nota    || ci.nota;

                        return `
                            <div class="checkin-row">
                                <div style="display:flex;align-items:center;gap:.75rem">
                                    <i data-lucide="${exitoso ? 'check-circle' : 'x-circle'}"
                                       style="width:1.25rem;height:1.25rem;color:${exitoso ? '#10b981' : '#ef4444'};flex-shrink:0"></i>
                                    <div>
                                        <p style="font-weight:700;color:#d1d5db;font-size:.85rem">
                                            ${fecha.toLocaleDateString('es-ES')} · ${fecha.toLocaleTimeString('es-ES')}
                                        </p>
                                        <p style="font-size:.72rem;color:#6b7280;font-weight:600">${nota || 'Check-in exitoso'}</p>
                                    </div>
                                </div>
                                <span style="background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.15);color:#22c55e;padding:.25rem .6rem;border-radius:.4rem;font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em">
                                    ${metodo}
                                </span>
                            </div>`;
                    }).join('');
                }
                lucide.createIcons();
            } catch (error) {
                console.error('Error cargando check-ins:', error);
            }
        }

        window.addEventListener('load', function () {
            loadMembresias();
            loadCheckIns();
            lucide.createIcons();
        });
    </script>
}

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clientes";
    ViewData["Subtitle"] = "Gestión de miembros de Power Fitness";
}

<div style="margin-bottom:1.5rem; display:flex; align-items:center; justify-content:space-between; gap:1rem;">
    <div style="flex:1; max-width:28rem;">
        <input type="text" id="search-input" placeholder="Buscar por nombre, apellido o cédula..."
               style="width:100%; padding:.75rem 1.25rem; border:2px solid #1E2D4A; border-radius:.875rem; background:#0D1526; color:#E2E8F0; font-weight:600; outline:none; box-sizing:border-box; font-family:inherit; font-size:.9rem;"
               onfocus="this.style.borderColor='#3B82F6'" onblur="this.style.borderColor='#1E2D4A'">
    </div>

    <div style="display:flex; align-items:center; gap:.75rem;">
        <button id="sort-btn" onclick="toggleSort()"
                style="display:inline-flex; align-items:center; gap:.5rem; padding:.75rem 1.25rem; background:#0D1526; border:2px solid #1E2D4A; color:#94A3B8; font-weight:800; border-radius:.875rem; cursor:pointer; text-transform:uppercase; letter-spacing:.06em; font-family:inherit; font-size:.8rem; transition:border-color .2s, color .2s;"
                onmouseover="this.style.borderColor='#3B82F6';this.style.color='#60A5FA'" onmouseout="this.style.borderColor='#1E2D4A';this.style.color='#94A3B8'">
            <i data-lucide="arrow-down-wide-narrow" id="sort-icon" style="width:18px;height:18px;"></i>
            <span id="sort-label">Más recientes</span>
        </button>

        <a href="/clientes/crear"
           style="display:inline-flex; align-items:center; gap:.5rem; padding:.75rem 2rem; background:linear-gradient(135deg,#3B82F6,#7C3AED); color:#fff; font-weight:800; border-radius:.875rem; text-decoration:none; text-transform:uppercase; letter-spacing:.06em; font-size:.85rem; box-shadow:0 4px 20px rgba(59,130,246,.3); transition:box-shadow .2s, transform .2s;"
           onmouseover="this.style.transform='scale(1.03)';this.style.boxShadow='0 8px 28px rgba(59,130,246,.45)'" onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 20px rgba(59,130,246,.3)'">
            <i data-lucide="user-plus" style="width:18px;height:18px;"></i>
            Nuevo Cliente
        </a>
    </div>
</div>

<div id="clientes-container"
     style="background:#0D1526; border-radius:1rem; overflow:hidden; border:1px solid #1E2D4A; box-shadow:0 4px 24px rgba(0,0,0,.4);">
    <div style="padding:2rem; text-align:center;">
        <div style="width:48px; height:48px; border:4px solid rgba(59,130,246,.15); border-top-color:#3B82F6; border-radius:50%; margin:0 auto 1rem;"></div>
        <p style="color:#64748B; font-weight:700;">Cargando clientes...</p>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let clientesData = [];
        let clientesFiltrados = [];
        let ordenDesc = true;
        let paginaActual = 1;
        const POR_PAGINA = 10;

        /* ── Paleta ── */
        const PF = {
            dark:    '#060B18', card:  '#0D1526', border: '#1E2D4A',
            blue:    '#3B82F6', blueB: '#60A5FA', purple: '#7C3AED',
            green:   '#10B981', orange:'#F59E0B', red:    '#EF4444',
            text:    '#E2E8F0', soft:  '#94A3B8',
        };

        async function loadClientes() {
            try {
                const response = await fetch(`${API_URL}/Clientes`);
                clientesData = await response.json();
                aplicarFiltroYOrden();
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('clientes-container').innerHTML = `
                    <div style="padding:2rem; text-align:center;">
                        <i data-lucide="alert-circle" style="width:48px;height:48px;color:${PF.red};display:block;margin:0 auto 1rem;"></i>
                        <p style="color:${PF.red};font-weight:700;">Error al cargar los clientes</p>
                    </div>`;
                lucide.createIcons();
            }
        }

        function aplicarFiltroYOrden() {
            const q = document.getElementById('search-input').value.toLowerCase();
            let resultado = clientesData.filter(c =>
                c.Nombre.toLowerCase().includes(q) ||
                c.Apellido.toLowerCase().includes(q) ||
                c.Cedula.toLowerCase().includes(q)
            );
            resultado.sort((a, b) => {
                const diff = new Date(b.CreatedAt) - new Date(a.CreatedAt);
                return ordenDesc ? diff : -diff;
            });
            clientesFiltrados = resultado;
            paginaActual = 1;
            renderClientes();
        }

        function toggleSort() {
            ordenDesc = !ordenDesc;
            document.getElementById('sort-label').textContent = ordenDesc ? 'Más recientes' : 'Más antiguos';
            document.getElementById('sort-icon').setAttribute('data-lucide', ordenDesc ? 'arrow-down-wide-narrow' : 'arrow-up-wide-narrow');
            lucide.createIcons();
            aplicarFiltroYOrden();
        }

        function renderClientes() {
            const container = document.getElementById('clientes-container');
            const total = clientesFiltrados.length;

            if (total === 0) {
                container.innerHTML = `
                    <div style="padding:3rem; text-align:center;">
                        <i data-lucide="users" style="width:56px;height:56px;color:${PF.soft};display:block;margin:0 auto 1rem;"></i>
                        <p style="color:${PF.soft};font-size:1.1rem;font-weight:700;margin:0 0 .75rem 0;">No hay clientes registrados</p>
                        <a href="/clientes/crear" style="color:${PF.blueB};font-weight:800;text-transform:uppercase;letter-spacing:.06em;font-size:.8rem;">
                            Registrar primer cliente →
                        </a>
                    </div>`;
                lucide.createIcons();
                return;
            }

            const totalPaginas = Math.ceil(total / POR_PAGINA);
            paginaActual = Math.min(paginaActual, totalPaginas);
            const inicio = (paginaActual - 1) * POR_PAGINA;
            const pagina = clientesFiltrados.slice(inicio, inicio + POR_PAGINA);

            container.innerHTML = `
                <table style="width:100%; border-collapse:collapse;">
                    <thead>
                        <tr style="background:linear-gradient(135deg,${PF.dark},#111827); border-bottom:2px solid ${PF.blue};">
                            <th style="padding:.875rem 1.5rem; text-align:left; font-size:.7rem; font-weight:800; color:rgba(255,255,255,.85); text-transform:uppercase; letter-spacing:.12em;">Cliente</th>
                            <th style="padding:.875rem 1.5rem; text-align:left; font-size:.7rem; font-weight:800; color:rgba(255,255,255,.85); text-transform:uppercase; letter-spacing:.12em;">Cédula</th>
                            <th style="padding:.875rem 1.5rem; text-align:left; font-size:.7rem; font-weight:800; color:rgba(255,255,255,.85); text-transform:uppercase; letter-spacing:.12em;">Contacto</th>
                            <th style="padding:.875rem 1.5rem; text-align:left; font-size:.7rem; font-weight:800; color:rgba(255,255,255,.85); text-transform:uppercase; letter-spacing:.12em;">Estado</th>
                            <th style="padding:.875rem 1.5rem; text-align:right; font-size:.7rem; font-weight:800; color:rgba(255,255,255,.85); text-transform:uppercase; letter-spacing:.12em;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${pagina.map(c => `
                            <tr style="border-bottom:1px solid ${PF.border}; transition:background .15s;"
                                onmouseover="this.style.background='rgba(59,130,246,.05)'" onmouseout="this.style.background='transparent'">
                                <td style="padding:1rem 1.5rem;">
                                    <div style="display:flex; align-items:center; gap:.75rem;">
                                        ${c.FotoBase64
                                            ? `<img src="data:image/jpeg;base64,${c.FotoBase64}" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid ${PF.blue};">`
                                            : `<div style="width:44px;height:44px;border-radius:50%;background:rgba(59,130,246,.1);border:2px solid ${PF.border};display:flex;align-items:center;justify-content:center;">
                                                   <i data-lucide="user" style="width:22px;height:22px;color:${PF.soft};"></i>
                                               </div>`
                                        }
                                        <div>
                                            <div style="font-weight:800;color:${PF.text};font-size:1rem;">${c.Nombre} ${c.Apellido}</div>
                                            <div style="font-size:.75rem;color:${PF.soft};font-weight:600;">ID: ${c.Id?.toString().substring(0,8)}...</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="padding:1rem 1.5rem;">
                                    <span style="font-weight:700;color:${PF.blueB};font-family:monospace;font-size:.9rem;">${c.Cedula}</span>
                                </td>
                                <td style="padding:1rem 1.5rem;">
                                    <div style="font-size:.85rem;color:${PF.soft};font-weight:600;">
                                        ${c.Telefono ? `<div>${c.Telefono}</div>` : ''}
                                        ${c.Email    ? `<div>${c.Email}</div>`    : ''}
                                        ${!c.Telefono && !c.Email ? '<span style="color:#374151">—</span>' : ''}
                                    </div>
                                </td>
                                <td style="padding:1rem 1.5rem;">
                                    <div style="display:flex;flex-direction:column;gap:.4rem;">
                                        ${c.Activo
                                            ? `<span style="display:inline-flex;align-items:center;gap:.3rem;padding:.25rem .75rem;background:rgba(16,185,129,.12);color:${PF.green};border:1px solid rgba(16,185,129,.3);border-radius:999px;font-size:.68rem;font-weight:800;text-transform:uppercase;">
                                                   <i data-lucide="check-circle" style="width:11px;height:11px;"></i> Activo
                                               </span>`
                                            : `<span style="display:inline-flex;align-items:center;gap:.3rem;padding:.25rem .75rem;background:rgba(239,68,68,.12);color:${PF.red};border:1px solid rgba(239,68,68,.3);border-radius:999px;font-size:.68rem;font-weight:800;text-transform:uppercase;">
                                                   <i data-lucide="x-circle" style="width:11px;height:11px;"></i> Inactivo
                                               </span>`
                                        }
                                        ${c.HuellaTemplate
                                            ? `<span style="display:inline-flex;align-items:center;gap:.3rem;padding:.25rem .75rem;background:rgba(124,58,237,.12);color:${PF.purple};border:1px solid rgba(124,58,237,.3);border-radius:999px;font-size:.68rem;font-weight:800;text-transform:uppercase;">
                                                   <i data-lucide="fingerprint" style="width:11px;height:11px;"></i> Con huella
                                               </span>`
                                            : `<span style="display:inline-flex;align-items:center;gap:.3rem;padding:.25rem .75rem;background:rgba(100,116,139,.1);color:${PF.soft};border:1px solid rgba(100,116,139,.2);border-radius:999px;font-size:.68rem;font-weight:800;text-transform:uppercase;">
                                                   <i data-lucide="fingerprint" style="width:11px;height:11px;"></i> Sin huella
                                               </span>`
                                        }
                                    </div>
                                </td>
                                <td style="padding:1rem 1.5rem;">
                                    <div style="display:flex;align-items:center;justify-content:flex-end;gap:.35rem;">
                                        <a href="/clientes/detalle/${c.Id}" title="Ver detalles"
                                           style="padding:.45rem;color:${PF.blueB};border-radius:.5rem;display:flex;transition:background .15s;"
                                           onmouseover="this.style.background='rgba(96,165,250,.12)'" onmouseout="this.style.background='transparent'">
                                            <i data-lucide="eye" style="width:18px;height:18px;"></i>
                                        </a>
                                        <a href="/clientes/editar/${c.Id}" title="Editar"
                                           style="padding:.45rem;color:${PF.orange};border-radius:.5rem;display:flex;transition:background .15s;"
                                           onmouseover="this.style.background='rgba(245,158,11,.12)'" onmouseout="this.style.background='transparent'">
                                            <i data-lucide="edit" style="width:18px;height:18px;"></i>
                                        </a>
                                        ${!c.HuellaTemplate
                                            ? `<a href="/clientes/capturar-huella/${c.Id}" title="Capturar huella"
                                                  style="padding:.45rem;color:#A78BFA;border-radius:.5rem;display:flex;transition:background .15s;"
                                                  onmouseover="this.style.background='rgba(167,139,250,.12)'" onmouseout="this.style.background='transparent'">
                                                   <i data-lucide="fingerprint" style="width:18px;height:18px;"></i>
                                               </a>`
                                            : ''
                                        }
                                        <a href="/membresias/crear?clienteId=${c.Id}" title="Nueva membresía"
                                           style="padding:.45rem;color:${PF.green};border-radius:.5rem;display:flex;transition:background .15s;"
                                           onmouseover="this.style.background='rgba(16,185,129,.12)'" onmouseout="this.style.background='transparent'">
                                            <i data-lucide="plus-circle" style="width:18px;height:18px;"></i>
                                        </a>
                                        <button onclick="deleteCliente('${c.Id}')" title="Eliminar"
                                                style="padding:.45rem;color:${PF.red};border-radius:.5rem;display:flex;background:transparent;border:none;cursor:pointer;transition:background .15s;"
                                                onmouseover="this.style.background='rgba(239,68,68,.12)'" onmouseout="this.style.background='transparent'">
                                            <i data-lucide="trash-2" style="width:18px;height:18px;"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>

                <!-- Footer paginación -->
                <div style="padding:.875rem 1.5rem; background:rgba(6,11,24,.5); border-top:1px solid ${PF.border}; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
                    <p style="font-size:.8rem; font-weight:600; color:${PF.soft};">
                        Mostrando
                        <span style="font-weight:900;color:${PF.text};">${inicio + 1}–${Math.min(inicio + POR_PAGINA, total)}</span>
                        de
                        <span style="font-weight:900;color:${PF.text};">${total}</span>
                        cliente${total !== 1 ? 's' : ''}
                    </p>

                    ${totalPaginas > 1 ? `
                    <div style="display:flex;align-items:center;gap:.35rem;">
                        <button onclick="irPagina(${paginaActual - 1})" ${paginaActual === 1 ? 'disabled' : ''}
                                style="padding:.5rem;border-radius:.5rem;border:2px solid ${paginaActual === 1 ? PF.border : PF.border};color:${paginaActual === 1 ? '#374151' : PF.soft};background:transparent;cursor:${paginaActual === 1 ? 'not-allowed' : 'pointer'};">
                            <i data-lucide="chevron-left" style="width:18px;height:18px;"></i>
                        </button>

                        ${paginasVisibles(paginaActual, totalPaginas)
                            .map(p => p === '...'
                                ? `<span style="padding:0 .35rem;color:${PF.soft};font-weight:700;">…</span>`
                                : `<button onclick="irPagina(${p})"
                                           style="width:36px;height:36px;border-radius:.5rem;border:2px solid ${p === paginaActual ? PF.blue : PF.border};background:${p === paginaActual ? PF.blue : 'transparent'};color:${p === paginaActual ? '#fff' : PF.soft};font-weight:800;cursor:pointer;font-size:.82rem;">
                                       ${p}
                                   </button>`
                            ).join('')}

                        <button onclick="irPagina(${paginaActual + 1})" ${paginaActual === totalPaginas ? 'disabled' : ''}
                                style="padding:.5rem;border-radius:.5rem;border:2px solid ${PF.border};color:${paginaActual === totalPaginas ? '#374151' : PF.soft};background:transparent;cursor:${paginaActual === totalPaginas ? 'not-allowed' : 'pointer'};">
                            <i data-lucide="chevron-right" style="width:18px;height:18px;"></i>
                        </button>
                    </div>
                    ` : ''}
                </div>
            `;

            lucide.createIcons();
        }

        function paginasVisibles(actual, total) {
            const pages = [];
            for (let i = 1; i <= total; i++) {
                if (i === 1 || i === total || Math.abs(i - actual) <= 1) pages.push(i);
            }
            const result = [];
            for (let i = 0; i < pages.length; i++) {
                if (i > 0 && pages[i] - pages[i - 1] > 1) result.push('...');
                result.push(pages[i]);
            }
            return result;
        }

        function irPagina(pagina) {
            const totalPaginas = Math.ceil(clientesFiltrados.length / POR_PAGINA);
            if (pagina < 1 || pagina > totalPaginas) return;
            paginaActual = pagina;
            renderClientes();
            document.getElementById('clientes-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        document.getElementById('search-input').addEventListener('input', aplicarFiltroYOrden);

        async function deleteCliente(id) {
            if (!confirm('¿Estás seguro de eliminar este cliente? Esta acción no se puede deshacer.')) return;
            try {
                const response = await fetch(`${API_URL}/Clientes/${id}`, { method: 'DELETE' });
                if (response.ok) {
                    alert('✓ Cliente eliminado exitosamente');
                    loadClientes();
                } else {
                    alert('Error al eliminar el cliente');
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            }
        }

        window.addEventListener('load', loadClientes);
    </script>
}

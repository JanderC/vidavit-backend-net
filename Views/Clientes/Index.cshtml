@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clientes";
    ViewData["Subtitle"] = "Gestión de miembros de Tallest GYM";
}

<style>
    /* ── Tallest GYM — Clientes Index ── */
    .tz-search {
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        color: #f9fafb;
        transition: border-color .2s, box-shadow .2s;
    }

        .tz-search::placeholder {
            color: #4b5563;
        }

        .tz-search:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.12);
        }

    .tz-sort-btn {
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        color: #9ca3af;
        transition: all .2s;
    }

        .tz-sort-btn:hover {
            border-color: #22c55e;
            color: #22c55e;
        }

    .tz-new-btn {
        background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);
        color: #fff;
        transition: all .25s;
    }

        .tz-new-btn:hover {
            background: linear-gradient(135deg, #16a34a 0%, #166534 100%);
            box-shadow: 0 6px 20px rgba(34,197,94,0.35);
            transform: translateY(-1px);
        }

    /* Table container */
    .tz-table-wrap {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.15);
        border-radius: 1rem;
        overflow: hidden;
    }

    .tz-thead th {
        padding: .9rem 1.5rem;
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #f9fafb;
        text-align: left;
    }

        .tz-thead th:last-child {
            text-align: right;
        }

    .tz-row {
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: background .15s;
    }

        .tz-row:hover {
            background: rgba(34,197,94,0.04);
        }

        .tz-row td {
            padding: 1rem 1.5rem;
            vertical-align: middle;
        }

    .avatar-img {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(34,197,94,0.4);
    }

    .avatar-placeholder {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        background: rgba(34,197,94,0.08);
        border: 2px solid rgba(34,197,94,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Status badges */
    .badge-active {
        background: rgba(16,185,129,0.12);
        color: #10b981;
        border: 1px solid rgba(16,185,129,0.25);
    }

    .badge-inactive {
        background: rgba(239,68,68,0.12);
        color: #ef4444;
        border: 1px solid rgba(239,68,68,0.25);
    }

    .badge-huella {
        background: rgba(168,85,247,0.12);
        color: #a855f7;
        border: 1px solid rgba(168,85,247,0.25);
    }

    .badge-nohuella {
        background: rgba(75,85,99,0.15);
        color: #6b7280;
        border: 1px solid rgba(75,85,99,0.25);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .2rem .65rem;
        border-radius: 99px;
        font-size: .65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    /* Action buttons */
    .act-btn {
        padding: .4rem;
        border-radius: .5rem;
        transition: background .15s;
        display: inline-flex;
        align-items: center;
    }

    .act-btn-eye {
        color: #60a5fa;
    }

        .act-btn-eye:hover {
            background: rgba(96,165,250,0.1);
        }

    .act-btn-edit {
        color: #fbbf24;
    }

        .act-btn-edit:hover {
            background: rgba(251,191,36,0.1);
        }

    .act-btn-fp {
        color: #a855f7;
    }

        .act-btn-fp:hover {
            background: rgba(168,85,247,0.1);
        }

    .act-btn-mem {
        color: #22c55e;
    }

        .act-btn-mem:hover {
            background: rgba(34,197,94,0.1);
        }

    .act-btn-del {
        color: #ef4444;
    }

        .act-btn-del:hover {
            background: rgba(239,68,68,0.1);
        }

    /* Footer / pagination */
    .tz-footer {
        background: rgba(0,0,0,0.6);
        border-top: 1px solid rgba(34,197,94,0.1);
        padding: .85rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .page-btn {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: .5rem;
        border: 1px solid rgba(34,197,94,0.2);
        background: transparent;
        color: #9ca3af;
        font-weight: 800;
        font-size: .8rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all .15s;
    }

        .page-btn:hover:not(:disabled) {
            border-color: #22c55e;
            color: #22c55e;
        }

        .page-btn.active {
            background: #22c55e;
            border-color: #22c55e;
            color: #fff;
        }

        .page-btn:disabled {
            opacity: .3;
            cursor: not-allowed;
        }
</style>

<!-- Toolbar -->
<div class="mb-6 flex items-center justify-between gap-4 flex-wrap">
    <div class="flex-1" style="max-width:26rem">
        <input type="text" id="search-input" placeholder="Buscar por nombre, apellido o cédula..."
               class="tz-search w-full px-5 py-3 rounded-xl font-semibold text-sm" />
    </div>

    <div class="flex items-center gap-3">
        <button id="sort-btn" onclick="toggleSort()"
                class="tz-sort-btn inline-flex items-center gap-2 px-5 py-3 rounded-xl font-black text-sm uppercase tracking-wide">
            <i data-lucide="arrow-down-wide-narrow" id="sort-icon" class="w-4 h-4"></i>
            <span id="sort-label">Más recientes</span>
        </button>

        <a href="/clientes/crear"
           class="tz-new-btn inline-flex items-center gap-2 px-7 py-3 rounded-xl font-black text-sm uppercase tracking-wide shadow-lg">
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            Nuevo Cliente
        </a>
    </div>
</div>

<!-- Table container -->
<div id="clientes-container" class="tz-table-wrap">
    <div class="p-10 text-center">
        <div class="w-10 h-10 border-4 border-green-500 border-t-transparent rounded-full mx-auto mb-4"
             style="animation:spin .8s linear infinite"></div>
        <p class="text-gray-500 font-bold text-sm uppercase tracking-widest">Cargando clientes...</p>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let clientesData = [];
        let clientesFiltrados = [];
        let ordenDesc = true;
        let paginaActual = 1;
        const POR_PAGINA = 10;

        async function loadClientes() {
            try {
                const response = await fetch(`${API_URL}/Clientes`);
                clientesData = await response.json();
                aplicarFiltroYOrden();
            } catch (error) {
                document.getElementById('clientes-container').innerHTML = `
                    <div class="p-10 text-center">
                        <i data-lucide="alert-circle" class="w-10 h-10 mx-auto mb-3" style="color:#ef4444"></i>
                        <p style="color:#ef4444;font-weight:700">Error al cargar los clientes</p>
                    </div>`;
                lucide.createIcons();
            }
        }

        function aplicarFiltroYOrden() {
            const q = document.getElementById('search-input').value.toLowerCase();
            let resultado = clientesData.filter(c =>
                c.Nombre.toLowerCase().includes(q) ||
                c.Apellido.toLowerCase().includes(q) ||
                c.Cedula.toLowerCase().includes(q)
            );
            resultado.sort((a, b) => {
                const diff = new Date(b.CreatedAt) - new Date(a.CreatedAt);
                return ordenDesc ? diff : -diff;
            });
            clientesFiltrados = resultado;
            paginaActual = 1;
            renderClientes();
        }

        function toggleSort() {
            ordenDesc = !ordenDesc;
            document.getElementById('sort-label').textContent = ordenDesc ? 'Más recientes' : 'Más antiguos';
            document.getElementById('sort-icon').setAttribute('data-lucide', ordenDesc ? 'arrow-down-wide-narrow' : 'arrow-up-wide-narrow');
            lucide.createIcons();
            aplicarFiltroYOrden();
        }

        function renderClientes() {
            const container = document.getElementById('clientes-container');
            const total = clientesFiltrados.length;

            if (total === 0) {
                container.innerHTML = `
                    <div class="p-14 text-center">
                        <i data-lucide="users" class="w-14 h-14 mx-auto mb-4" style="color:#374151"></i>
                        <p style="color:#6b7280;font-weight:700;font-size:1rem">No hay clientes registrados</p>
                        <a href="/clientes/crear" style="color:#22c55e;font-weight:800;font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;margin-top:.75rem;display:inline-block">
                            + Registrar primer cliente
                        </a>
                    </div>`;
                lucide.createIcons();
                return;
            }

            const totalPaginas = Math.ceil(total / POR_PAGINA);
            paginaActual = Math.min(paginaActual, totalPaginas);
            const inicio = (paginaActual - 1) * POR_PAGINA;
            const pagina = clientesFiltrados.slice(inicio, inicio + POR_PAGINA);

            container.innerHTML = `
                <div style="overflow-x:auto">
                    <table style="width:100%;border-collapse:collapse">
                        <thead class="tz-thead" style="background:linear-gradient(90deg,#050f05,#0d0d0d);border-bottom:1px solid rgba(34,197,94,0.2)">
                            <tr>
                                <th>Cliente</th>
                                <th>Cédula</th>
                                <th>Contacto</th>
                                <th>Estado</th>
                                <th style="text-align:right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${pagina.map(c => `
                                <tr class="tz-row">
                                    <td>
                                        <div style="display:flex;align-items:center;gap:.75rem">
                                            ${c.FotoBase64
                                                ? `<img src="data:image/jpeg;base64,${c.FotoBase64}" class="avatar-img" alt="${c.Nombre}">`
                                                : `<div class="avatar-placeholder"><i data-lucide="user" style="width:1.1rem;height:1.1rem;color:#22c55e"></i></div>`
                                            }
                                            <div>
                                                <div style="font-weight:900;color:#f9fafb;font-size:1rem">${c.Nombre} ${c.Apellido}</div>
                                                <div style="font-size:.72rem;color:#6b7280;font-weight:600;margin-top:.1rem">
                                                    Reg: ${new Date(c.CreatedAt).toLocaleDateString('es-ES')}
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="font-family:monospace;font-weight:700;color:#d1d5db;font-size:.95rem">${c.Cedula}</span>
                                    </td>
                                    <td>
                                        <div style="font-weight:700;color:#d1d5db;font-size:.9rem">${c.Telefono || '—'}</div>
                                        ${c.Email ? `<div style="font-size:.75rem;color:#6b7280;font-weight:600">${c.Email}</div>` : ''}
                                    </td>
                                    <td>
                                        <div style="display:flex;flex-direction:column;gap:.3rem">
                                            ${c.Activo
                                                ? `<span class="badge badge-active"><i data-lucide="check-circle" style="width:.75rem;height:.75rem"></i> Activo</span>`
                                                : `<span class="badge badge-inactive"><i data-lucide="x-circle" style="width:.75rem;height:.75rem"></i> Inactivo</span>`
                                            }
                                            ${c.HuellaTemplate
                                                ? `<span class="badge badge-huella"><i data-lucide="fingerprint" style="width:.75rem;height:.75rem"></i> Con huella</span>`
                                                : `<span class="badge badge-nohuella"><i data-lucide="fingerprint" style="width:.75rem;height:.75rem"></i> Sin huella</span>`
                                            }
                                        </div>
                                    </td>
                                    <td style="text-align:right;white-space:nowrap">
                                        <div style="display:inline-flex;align-items:center;gap:.25rem">
                                            <a href="/clientes/detalle/${c.Id}" class="act-btn act-btn-eye" title="Ver detalles">
                                                <i data-lucide="eye" style="width:1.1rem;height:1.1rem"></i>
                                            </a>
                                            <a href="/clientes/editar/${c.Id}" class="act-btn act-btn-edit" title="Editar">
                                                <i data-lucide="edit" style="width:1.1rem;height:1.1rem"></i>
                                            </a>
                                            ${!c.HuellaTemplate
                                                ? `<a href="/clientes/capturar-huella/${c.Id}" class="act-btn act-btn-fp" title="Capturar huella">
                                                       <i data-lucide="fingerprint" style="width:1.1rem;height:1.1rem"></i>
                                                   </a>`
                                                : ''
                                            }
                                            <a href="/membresias/crear?clienteId=${c.Id}" class="act-btn act-btn-mem" title="Nueva membresía">
                                                <i data-lucide="plus-circle" style="width:1.1rem;height:1.1rem"></i>
                                            </a>
                                            <button onclick="deleteCliente('${c.Id}')" class="act-btn act-btn-del" title="Eliminar">
                                                <i data-lucide="trash-2" style="width:1.1rem;height:1.1rem"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>

                <div class="tz-footer">
                    <p style="font-size:.8rem;color:#6b7280;font-weight:600">
                        Mostrando
                        <span style="font-weight:900;color:#d1d5db">${inicio + 1}–${Math.min(inicio + POR_PAGINA, total)}</span>
                        de
                        <span style="font-weight:900;color:#d1d5db">${total}</span>
                        cliente${total !== 1 ? 's' : ''}
                    </p>

                    ${totalPaginas > 1 ? `
                    <div style="display:flex;align-items:center;gap:.3rem">
                        <button onclick="irPagina(${paginaActual - 1})" ${paginaActual === 1 ? 'disabled' : ''} class="page-btn">
                            <i data-lucide="chevron-left" style="width:1rem;height:1rem"></i>
                        </button>
                        ${paginasVisibles(paginaActual, totalPaginas).map(p =>
                            p === '...'
                                ? `<span style="padding:0 .25rem;color:#4b5563;font-weight:700">…</span>`
                                : `<button onclick="irPagina(${p})" class="page-btn ${p === paginaActual ? 'active' : ''}">${p}</button>`
                        ).join('')}
                        <button onclick="irPagina(${paginaActual + 1})" ${paginaActual === totalPaginas ? 'disabled' : ''} class="page-btn">
                            <i data-lucide="chevron-right" style="width:1rem;height:1rem"></i>
                        </button>
                    </div>
                    ` : ''}
                </div>
            `;

            lucide.createIcons();
        }

        function paginasVisibles(actual, total) {
            const pages = [];
            for (let i = 1; i <= total; i++) {
                if (i === 1 || i === total || Math.abs(i - actual) <= 1) pages.push(i);
            }
            const result = [];
            for (let i = 0; i < pages.length; i++) {
                if (i > 0 && pages[i] - pages[i - 1] > 1) result.push('...');
                result.push(pages[i]);
            }
            return result;
        }

        function irPagina(pagina) {
            const totalPaginas = Math.ceil(clientesFiltrados.length / POR_PAGINA);
            if (pagina < 1 || pagina > totalPaginas) return;
            paginaActual = pagina;
            renderClientes();
            document.getElementById('clientes-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        document.getElementById('search-input').addEventListener('input', aplicarFiltroYOrden);

        async function deleteCliente(id) {
            if (!confirm('¿Estás seguro de eliminar este cliente? Esta acción no se puede deshacer.')) return;
            try {
                const response = await fetch(`${API_URL}/Clientes/${id}`, { method: 'DELETE' });
                if (response.ok) {
                    alert('✓ Cliente eliminado exitosamente');
                    loadClientes();
                } else {
                    alert('Error al eliminar el cliente');
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            }
        }

        window.addEventListener('load', loadClientes);
    </script>
}

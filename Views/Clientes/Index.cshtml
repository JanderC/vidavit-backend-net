@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clientes";
    ViewData["Subtitle"] = "Gestión de miembros de POWER FITNESS";
}

<style>
    .pf-input {
        width: 100%;
        padding: 11px 18px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .pf-input::placeholder { color: rgba(255,255,255,0.25); }
    .pf-input:focus {
        border-color: #1E6FE3;
        box-shadow: 0 0 0 3px rgba(30,111,227,0.15);
    }

    .pf-table { width: 100%; border-collapse: collapse; }
    .pf-table thead tr { border-bottom: 1px solid rgba(30,111,227,0.2); }
    .pf-table thead th {
        padding: 14px 20px;
        text-align: left;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
    }
    .pf-table thead th:last-child { text-align: right; }
    .pf-table tbody tr {
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: background 0.15s;
    }
    .pf-table tbody tr:hover { background: rgba(30,111,227,0.05); }
    .pf-table tbody td { padding: 14px 20px; }

    .pf-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 100px;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px; height: 34px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: background 0.15s;
        text-decoration: none;
    }

    .page-btn {
        width: 36px; height: 36px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.1);
        background: transparent;
        color: rgba(255,255,255,0.5);
        font-weight: 800;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.15s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .page-btn:hover:not(:disabled) {
        border-color: #1E6FE3;
        color: #3D8EFF;
    }
    .page-btn.active {
        background: #1E6FE3;
        border-color: #1E6FE3;
        color: #fff;
    }
    .page-btn:disabled { opacity: 0.3; cursor: not-allowed; }
</style>

<!-- Toolbar -->
<div style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap;">
    <div style="flex:1;max-width:400px;">
        <input type="text" id="search-input" placeholder="Buscar por nombre, apellido o cédula..."
               class="pf-input" />
    </div>
    <div style="display:flex;align-items:center;gap:10px;">
        <button id="sort-btn" onclick="toggleSort()"
                style="display:inline-flex;align-items:center;gap:8px;padding:11px 18px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:rgba(255,255,255,0.6);font-weight:800;font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;cursor:pointer;transition:all 0.15s;"
                onmouseover="this.style.borderColor='rgba(30,111,227,0.4)';this.style.color='#7EB8FF'"
                onmouseout="this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(255,255,255,0.6)'">
            <i data-lucide="arrow-down-wide-narrow" id="sort-icon" style="width:16px;height:16px;"></i>
            <span id="sort-label">Más recientes</span>
        </button>
        <a href="/clientes/crear"
           style="display:inline-flex;align-items:center;gap:8px;padding:11px 20px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;border-radius:12px;text-decoration:none;transition:opacity 0.2s,transform 0.2s;"
           onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.03)'"
           onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
            <i data-lucide="user-plus" style="width:16px;height:16px;"></i>
            Nuevo Cliente
        </a>
    </div>
</div>

<!-- Table container -->
<div id="clientes-container"
     style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:16px;overflow:hidden;">
    <div style="padding:48px;text-align:center;">
        <div class="animate-spin" style="width:40px;height:40px;border:3px solid rgba(30,111,227,0.2);border-left-color:#1E6FE3;border-radius:50%;margin:0 auto 16px;"></div>
        <p style="color:rgba(255,255,255,0.35);font-weight:600;font-size:0.85rem;letter-spacing:1px;text-transform:uppercase;">Cargando clientes...</p>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let clientesData = [];
        let clientesFiltrados = [];
        let ordenDesc = true;
        let paginaActual = 1;
        const POR_PAGINA = 10;

        async function loadClientes() {
            try {
                const response = await fetch(`${API_URL}/Clientes`);
                clientesData = await response.json();
                aplicarFiltroYOrden();
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('clientes-container').innerHTML = `
                    <div style="padding:48px;text-align:center;">
                        <i data-lucide="alert-circle" style="width:40px;height:40px;color:#F87171;margin:0 auto 12px;display:block;"></i>
                        <p style="color:#F87171;font-weight:700;">Error al cargar los clientes</p>
                    </div>`;
                lucide.createIcons();
            }
        }

        function aplicarFiltroYOrden() {
            const q = document.getElementById('search-input').value.toLowerCase();
            let resultado = clientesData.filter(c =>
                c.Nombre.toLowerCase().includes(q) ||
                c.Apellido.toLowerCase().includes(q) ||
                c.Cedula.toLowerCase().includes(q)
            );
            resultado.sort((a, b) => {
                const diff = new Date(b.CreatedAt) - new Date(a.CreatedAt);
                return ordenDesc ? diff : -diff;
            });
            clientesFiltrados = resultado;
            paginaActual = 1;
            renderClientes();
        }

        function toggleSort() {
            ordenDesc = !ordenDesc;
            document.getElementById('sort-label').textContent = ordenDesc ? 'Más recientes' : 'Más antiguos';
            document.getElementById('sort-icon').setAttribute('data-lucide', ordenDesc ? 'arrow-down-wide-narrow' : 'arrow-up-wide-narrow');
            lucide.createIcons();
            aplicarFiltroYOrden();
        }

        function renderClientes() {
            const container = document.getElementById('clientes-container');
            const total = clientesFiltrados.length;

            if (total === 0) {
                container.innerHTML = `
                    <div style="padding:48px;text-align:center;">
                        <i data-lucide="users" style="width:48px;height:48px;color:rgba(255,255,255,0.15);margin:0 auto 14px;display:block;"></i>
                        <p style="color:rgba(255,255,255,0.4);font-weight:700;margin:0 0 12px 0;">No hay clientes registrados</p>
                        <a href="/clientes/crear" style="color:#3D8EFF;font-weight:800;font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;text-decoration:none;">
                            Registrar primer cliente →
                        </a>
                    </div>`;
                lucide.createIcons();
                return;
            }

            const totalPaginas = Math.ceil(total / POR_PAGINA);
            paginaActual = Math.min(paginaActual, totalPaginas);
            const inicio = (paginaActual - 1) * POR_PAGINA;
            const pagina = clientesFiltrados.slice(inicio, inicio + POR_PAGINA);

            container.innerHTML = `
                <table class="pf-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Cédula</th>
                            <th>Contacto</th>
                            <th>Estado</th>
                            <th style="text-align:right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${pagina.map(c => `
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:12px;">
                                        ${c.FotoBase64
                                            ? `<img src="data:image/jpeg;base64,${c.FotoBase64}" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid rgba(30,111,227,0.4);flex-shrink:0;">`
                                            : `<div style="width:44px;height:44px;border-radius:50%;background:rgba(30,111,227,0.1);border:1px solid rgba(30,111,227,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                                   <i data-lucide="user" style="width:20px;height:20px;color:rgba(30,111,227,0.6);"></i>
                                               </div>`
                                        }
                                        <div>
                                            <div style="font-weight:800;color:#fff;font-size:0.95rem;">${c.Nombre} ${c.Apellido}</div>
                                            <div style="font-size:0.72rem;color:rgba(255,255,255,0.3);margin-top:2px;">
                                                Registrado: ${new Date(c.CreatedAt).toLocaleDateString('es-ES')}
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span style="font-family:monospace;font-weight:700;color:rgba(255,255,255,0.8);font-size:0.9rem;">${c.Cedula}</span>
                                </td>
                                <td>
                                    <div style="font-weight:700;color:rgba(255,255,255,0.8);font-size:0.85rem;">${c.Telefono || '—'}</div>
                                    ${c.Email ? `<div style="font-size:0.75rem;color:rgba(255,255,255,0.35);margin-top:2px;">${c.Email}</div>` : ''}
                                </td>
                                <td>
                                    <div style="display:flex;flex-direction:column;gap:5px;">
                                        ${c.Activo
                                            ? `<span class="pf-badge" style="background:rgba(16,185,129,0.1);color:#10B981;border:1px solid rgba(16,185,129,0.2);">
                                                   <i data-lucide="check-circle" style="width:10px;height:10px;"></i> Activo
                                               </span>`
                                            : `<span class="pf-badge" style="background:rgba(248,113,113,0.1);color:#F87171;border:1px solid rgba(248,113,113,0.2);">
                                                   <i data-lucide="x-circle" style="width:10px;height:10px;"></i> Inactivo
                                               </span>`
                                        }
                                        ${c.HuellaTemplate
                                            ? `<span class="pf-badge" style="background:rgba(107,63,160,0.12);color:#a78bfa;border:1px solid rgba(107,63,160,0.25);">
                                                   <i data-lucide="fingerprint" style="width:10px;height:10px;"></i> Con huella
                                               </span>`
                                            : `<span class="pf-badge" style="background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.3);border:1px solid rgba(255,255,255,0.08);">
                                                   <i data-lucide="fingerprint" style="width:10px;height:10px;"></i> Sin huella
                                               </span>`
                                        }
                                    </div>
                                </td>
                                <td style="text-align:right;">
                                    <div style="display:flex;align-items:center;justify-content:flex-end;gap:4px;">
                                        <a href="/clientes/detalle/${c.Id}" class="action-btn" title="Ver detalles"
                                           style="background:rgba(30,111,227,0.08);" onmouseover="this.style.background='rgba(30,111,227,0.18)'" onmouseout="this.style.background='rgba(30,111,227,0.08)'">
                                            <i data-lucide="eye" style="width:15px;height:15px;color:#3D8EFF;"></i>
                                        </a>
                                        <a href="/clientes/editar/${c.Id}" class="action-btn" title="Editar"
                                           style="background:rgba(217,119,6,0.08);" onmouseover="this.style.background='rgba(217,119,6,0.18)'" onmouseout="this.style.background='rgba(217,119,6,0.08)'">
                                            <i data-lucide="edit" style="width:15px;height:15px;color:#D97706;"></i>
                                        </a>
                                        ${!c.HuellaTemplate
                                            ? `<a href="/clientes/capturar-huella/${c.Id}" class="action-btn" title="Capturar huella"
                                                  style="background:rgba(107,63,160,0.08);" onmouseover="this.style.background='rgba(107,63,160,0.18)'" onmouseout="this.style.background='rgba(107,63,160,0.08)'">
                                                   <i data-lucide="fingerprint" style="width:15px;height:15px;color:#a78bfa;"></i>
                                               </a>`
                                            : ''
                                        }
                                        <a href="/membresias/crear?clienteId=${c.Id}" class="action-btn" title="Nueva membresía"
                                           style="background:rgba(16,185,129,0.08);" onmouseover="this.style.background='rgba(16,185,129,0.18)'" onmouseout="this.style.background='rgba(16,185,129,0.08)'">
                                            <i data-lucide="plus-circle" style="width:15px;height:15px;color:#10B981;"></i>
                                        </a>
                                        <button onclick="deleteCliente('${c.Id}')" class="action-btn" title="Eliminar"
                                                style="background:rgba(248,113,113,0.08);" onmouseover="this.style.background='rgba(248,113,113,0.18)'" onmouseout="this.style.background='rgba(248,113,113,0.08)'">
                                            <i data-lucide="trash-2" style="width:15px;height:15px;color:#F87171;"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>

                <!-- Footer paginación -->
                <div style="padding:14px 20px;border-top:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                    <p style="font-size:0.78rem;color:rgba(255,255,255,0.35);font-weight:600;margin:0;">
                        Mostrando <strong style="color:rgba(255,255,255,0.7);">${inicio + 1}–${Math.min(inicio + POR_PAGINA, total)}</strong>
                        de <strong style="color:rgba(255,255,255,0.7);">${total}</strong> cliente${total !== 1 ? 's' : ''}
                    </p>

                    ${totalPaginas > 1 ? `
                    <div style="display:flex;align-items:center;gap:4px;">
                        <button onclick="irPagina(${paginaActual - 1})" ${paginaActual === 1 ? 'disabled' : ''} class="page-btn">
                            <i data-lucide="chevron-left" style="width:14px;height:14px;"></i>
                        </button>
                        ${paginasVisibles(paginaActual, totalPaginas).map(p =>
                            p === '...'
                                ? `<span style="color:rgba(255,255,255,0.3);font-weight:700;padding:0 4px;">…</span>`
                                : `<button onclick="irPagina(${p})" class="page-btn ${p === paginaActual ? 'active' : ''}">${p}</button>`
                        ).join('')}
                        <button onclick="irPagina(${paginaActual + 1})" ${paginaActual === totalPaginas ? 'disabled' : ''} class="page-btn">
                            <i data-lucide="chevron-right" style="width:14px;height:14px;"></i>
                        </button>
                    </div>
                    ` : ''}
                </div>
            `;

            lucide.createIcons();
        }

        function paginasVisibles(actual, total) {
            const pages = [];
            for (let i = 1; i <= total; i++) {
                if (i === 1 || i === total || Math.abs(i - actual) <= 1) pages.push(i);
            }
            const result = [];
            for (let i = 0; i < pages.length; i++) {
                if (i > 0 && pages[i] - pages[i - 1] > 1) result.push('...');
                result.push(pages[i]);
            }
            return result;
        }

        function irPagina(pagina) {
            const totalPaginas = Math.ceil(clientesFiltrados.length / POR_PAGINA);
            if (pagina < 1 || pagina > totalPaginas) return;
            paginaActual = pagina;
            renderClientes();
            document.getElementById('clientes-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        document.getElementById('search-input').addEventListener('input', aplicarFiltroYOrden);

        async function deleteCliente(id) {
            if (!confirm('¿Estás seguro de eliminar este cliente? Esta acción no se puede deshacer.')) return;
            try {
                const response = await fetch(`${API_URL}/Clientes/${id}`, { method: 'DELETE' });
                if (response.ok) {
                    alert('✓ Cliente eliminado exitosamente');
                    loadClientes();
                } else {
                    alert('Error al eliminar el cliente');
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            }
        }

        window.addEventListener('load', loadClientes);
    </script>
}

@model VidaFitBackend.Models.Cliente
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Cliente";
    ViewData["Subtitle"] = $"Actualizar información de {Model.Nombre} {Model.Apellido}";
}

<div class="bg-white rounded-xl shadow-md p-6">
    <form id="form-cliente" class="space-y-6">
        <input type="hidden" id="cliente-id" value="@Model.Id">

        <!-- Información Personal -->
        <div>
            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                <i data-lucide="user" class="w-5 h-5 text-vida-primary"></i>
                Información Personal
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Nombre <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="nombre" value="@Model.Nombre" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Apellido <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="apellido" value="@Model.Apellido" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Cédula <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="cedula" value="@Model.Cedula" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Teléfono <span class="text-red-500">*</span>
                    </label>
                    <input type="tel" id="telefono" value="@Model.Telefono" required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Email
                    </label>
                    <input type="email" id="email" value="@Model.Email"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Fecha de Nacimiento
                    </label>
                    <input type="date" id="fechaNacimiento" value="@(Model.FechaNacimiento?.ToString("yyyy-MM-dd"))"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">
                </div>
            </div>

            <div class="mt-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Dirección
                </label>
                <textarea id="direccion" rows="2"
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent">@Model.Direccion</textarea>
            </div>
        </div>

        <!-- Foto del Cliente -->
        <div>
            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                <i data-lucide="camera" class="w-5 h-5 text-vida-primary"></i>
                Fotografía
            </h3>

            <div class="flex items-center gap-4">
                <div id="preview-container">
                    @if (!string.IsNullOrEmpty(Model.FotoBase64))
                    {
                        <img id="foto-preview" src="data:image/jpeg;base64,@Model.FotoBase64"
                             class="w-32 h-32 rounded-lg object-cover border-2 border-gray-300" alt="Preview">
                    }
                    else
                    {
                        <div class="w-32 h-32 rounded-lg bg-gray-100 border-2 border-gray-300 flex items-center justify-center">
                            <i data-lucide="user" class="w-16 h-16 text-gray-400"></i>
                        </div>
                    }
                </div>

                <div class="flex-1">
                    <input type="file" id="foto" accept="image/*" class="hidden">
                    <button type="button" onclick="document.getElementById('foto').click()"
                            class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg border border-gray-300 transition-colors inline-flex items-center gap-2">
                        <i data-lucide="upload" class="w-4 h-4"></i>
                        Cambiar Foto
                    </button>
                </div>
            </div>
        </div>

        <!-- Huella Digital -->
        <div>
            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
                <i data-lucide="fingerprint" class="w-5 h-5 text-vida-primary"></i>
                Huella Digital
            </h3>

            @if (!string.IsNullOrEmpty(Model.HuellaTemplate))
            {
                <div class="flex items-center justify-between p-4 bg-green-50 border border-green-200 rounded-lg">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center">
                            <i data-lucide="check" class="w-6 h-6 text-white"></i>
                        </div>
                        <div>
                            <p class="font-semibold text-green-800">Huella Registrada</p>
                            <p class="text-sm text-green-600">El cliente tiene su huella digital registrada</p>
                        </div>
                    </div>
                    <a href="/clientes/capturefingerprint/@Model.Id"
                       class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors inline-flex items-center gap-2">
                        <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                        Recapturar
                    </a>
                </div>
            }
            else
            {
                <div class="flex items-center justify-between p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 bg-yellow-500 rounded-full flex items-center justify-center">
                            <i data-lucide="alert-triangle" class="w-6 h-6 text-white"></i>
                        </div>
                        <div>
                            <p class="font-semibold text-yellow-800">Sin Huella</p>
                            <p class="text-sm text-yellow-600">Este cliente no tiene huella registrada</p>
                        </div>
                    </div>
                    <a href="/clientes/capturefingerprint/@Model.Id"
                       class="px-4 py-2 bg-vida-primary hover:bg-vida-accent text-vida-dark font-semibold rounded-lg transition-all inline-flex items-center gap-2">
                        <i data-lucide="fingerprint" class="w-4 h-4"></i>
                        Registrar Huella
                    </a>
                </div>
            }
        </div>

        <!-- Estado -->
        <div>
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="activo" @(Model.Activo ? "checked" : "")
                       class="w-4 h-4 text-vida-primary border-gray-300 rounded focus:ring-vida-primary">
                <span class="text-sm font-medium text-gray-700">Cliente Activo</span>
            </label>
        </div>

        <!-- Botones -->
        <div class="flex justify-end gap-3 pt-4 border-t">
            <a href="/clientes/details/@Model.Id"
               class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center gap-2">
                <i data-lucide="x" class="w-4 h-4"></i>
                Cancelar
            </a>
            <button type="submit" id="btn-guardar"
                    class="px-6 py-2 bg-vida-primary hover:bg-vida-accent text-vida-dark font-semibold rounded-lg transition-all shadow-lg hover:shadow-xl inline-flex items-center gap-2">
                <i data-lucide="save" class="w-4 h-4"></i>
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let fotoBase64 = '@Model.FotoBase64';

        // Preview de foto
        document.getElementById('foto').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    fotoBase64 = event.target.result.split(',')[1];
                    const preview = document.getElementById('foto-preview');
                    preview.src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        // Submit form
        document.getElementById('form-cliente').addEventListener('submit', async function(e) {
            e.preventDefault();

            const btnGuardar = document.getElementById('btn-guardar');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Guardando...';

            const clienteId = document.getElementById('cliente-id').value;

            const cliente = {
                id: clienteId,
                nombre: document.getElementById('nombre').value,
                apellido: document.getElementById('apellido').value,
                cedula: document.getElementById('cedula').value,
                telefono: document.getElementById('telefono').value,
                email: document.getElementById('email').value || null,
                fechaNacimiento: document.getElementById('fechaNacimiento').value || null,
                direccion: document.getElementById('direccion').value || null,
                fotoBase64: fotoBase64,
                activo: document.getElementById('activo').checked,
                huellaTemplate: '@Model.HuellaTemplate',
                huellaDigital: null
            };

            try {
                const response = await fetch(`${API_URL}/Clientes/${clienteId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(cliente)
                });

                if (response.ok) {
                    alert('✓ Cliente actualizado exitosamente');
                    window.location.href = `/clientes/details/${clienteId}`;
                } else {
                    alert('Error al actualizar');
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            } finally {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Guardar Cambios';
                lucide.createIcons();
            }
        });

        lucide.createIcons();
    </script>
}
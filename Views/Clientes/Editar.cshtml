@model VidaFitBackend.Models.Cliente
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Cliente";
    ViewData["Subtitle"] = $"Actualizar información de {Model.Nombre} {Model.Apellido}";
}

<style>
    :root {
        --pf-blue:   #3B82F6; --pf-blueB: #60A5FA; --pf-deep:   #1E3A8A;
        --pf-purple: #7C3AED; --pf-dark:  #060B18; --pf-card:   #0D1526;
        --pf-border: #1E2D4A; --pf-text:  #E2E8F0; --pf-soft:   #94A3B8;
        --pf-muted:  #64748B; --pf-green: #10B981; --pf-red:    #EF4444;
        --pf-orange: #F59E0B;
    }
    .pf-input {
        width: 100%; padding: .75rem 1rem;
        border: 2px solid var(--pf-border);
        border-radius: .75rem;
        background: rgba(255,255,255,.03);
        color: var(--pf-text);
        font-weight: 600; font-family: inherit; font-size: .9rem;
        outline: none; box-sizing: border-box;
        transition: border-color .2s, background .2s;
    }
    .pf-input:focus { border-color: var(--pf-blue); background: rgba(59,130,246,.05); }
    .pf-input::placeholder { color: var(--pf-muted); font-weight: 400; }
    .pf-label {
        display: block; font-size: .72rem; font-weight: 800;
        color: var(--pf-soft); margin-bottom: .5rem;
        text-transform: uppercase; letter-spacing: .1em;
    }
    .pf-required { color: var(--pf-blue); }
    .pf-section-title {
        font-size: 1.1rem; font-weight: 900; color: var(--pf-text);
        text-transform: uppercase; letter-spacing: .08em;
        display: flex; align-items: center; gap: .6rem;
        margin: 0 0 1.25rem 0; padding-bottom: .875rem;
        border-bottom: 1px solid var(--pf-border);
    }
    .pf-section-title i { color: var(--pf-blueB) !important; }
</style>

<div style="background:#0D1526; border-radius:1.25rem; border:1px solid #1E2D4A; padding:2rem; box-shadow:0 4px 24px rgba(0,0,0,.4);">
    <form id="form-cliente" style="display:flex;flex-direction:column;gap:2rem;">
        <input type="hidden" id="cliente-id" value="@Model.Id">

        <!-- Información Personal -->
        <div>
            <h3 class="pf-section-title">
                <i data-lucide="user"></i>
                Información Personal
            </h3>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">
                <div>
                    <label class="pf-label">Nombre <span class="pf-required">*</span></label>
                    <input type="text" id="nombre" value="@Model.Nombre" required class="pf-input">
                </div>
                <div>
                    <label class="pf-label">Apellido <span class="pf-required">*</span></label>
                    <input type="text" id="apellido" value="@Model.Apellido" required class="pf-input">
                </div>
                <div>
                    <label class="pf-label">Cédula <span class="pf-required">*</span></label>
                    <input type="text" id="cedula" value="@Model.Cedula" required class="pf-input">
                </div>
                <div>
                    <label class="pf-label">Teléfono</label>
                    <input type="tel" id="telefono" value="@Model.Telefono" class="pf-input">
                </div>
                <div>
                    <label class="pf-label">Email</label>
                    <input type="email" id="email" value="@Model.Email" class="pf-input">
                </div>
                <div>
                    <label class="pf-label">Fecha de Nacimiento</label>
                    <input type="date" id="fechaNacimiento" value="@(Model.FechaNacimiento?.ToString("yyyy-MM-dd"))" class="pf-input">
                </div>
            </div>
            <div style="margin-top:1.25rem;">
                <label class="pf-label">Dirección</label>
                <textarea id="direccion" rows="2" class="pf-input">@Model.Direccion</textarea>
            </div>
        </div>

        <!-- Fotografía -->
        <div>
            <h3 class="pf-section-title">
                <i data-lucide="camera"></i>
                Fotografía
            </h3>
            <div style="display:flex; align-items:center; gap:1rem;">
                <div id="preview-container">
                    @if (!string.IsNullOrEmpty(Model.FotoBase64))
                    {
                        <img id="foto-preview" src="data:image/jpeg;base64,@Model.FotoBase64"
                             style="width:96px;height:96px;border-radius:.875rem;object-fit:cover;border:2px solid #1E2D4A;" alt="Preview">
                    }
                    else
                    {
                        <div style="width:96px;height:96px;border-radius:.875rem;background:rgba(59,130,246,.06);border:2px solid #1E2D4A;display:flex;align-items:center;justify-content:center;">
                            <i data-lucide="user" style="width:48px;height:48px;color:#1E2D4A;"></i>
                        </div>
                    }
                </div>
                <div>
                    <input type="file" id="foto" accept="image/*" style="display:none;">
                    <button type="button" onclick="document.getElementById('foto').click()"
                            style="display:inline-flex; align-items:center; gap:.5rem; padding:.65rem 1.25rem; background:rgba(255,255,255,.05); border:1px solid #1E2D4A; color:#94A3B8; border-radius:.75rem; cursor:pointer; font-weight:800; font-size:.82rem; text-transform:uppercase; letter-spacing:.06em; font-family:inherit; transition:background .2s, color .2s;"
                            onmouseover="this.style.background='rgba(59,130,246,.1)';this.style.color='#60A5FA'" onmouseout="this.style.background='rgba(255,255,255,.05)';this.style.color='#94A3B8'">
                        <i data-lucide="upload" style="width:16px;height:16px;"></i>
                        Cambiar Foto
                    </button>
                </div>
            </div>
        </div>

        <!-- Huella Digital -->
        <div>
            <h3 class="pf-section-title">
                <i data-lucide="fingerprint"></i>
                Huella Digital
            </h3>
            @if (!string.IsNullOrEmpty(Model.HuellaTemplate))
            {
                <div style="display:flex;align-items:center;justify-content:space-between;padding:1.25rem;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.25);border-radius:.875rem;">
                    <div style="display:flex;align-items:center;gap:.875rem;">
                        <div style="width:48px;height:48px;background:rgba(16,185,129,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid rgba(16,185,129,.3);">
                            <i data-lucide="check" style="width:24px;height:24px;color:#10B981;"></i>
                        </div>
                        <div>
                            <p style="font-weight:900;color:#10B981;font-size:.9rem;text-transform:uppercase;margin:0 0 .2rem 0;">Huella Registrada</p>
                            <p style="font-size:.78rem;color:#6EE7B7;font-weight:600;margin:0;">El cliente tiene su huella digital registrada</p>
                        </div>
                    </div>
                    <a href="/clientes/capturefingerprint/@Model.Id"
                       style="display:inline-flex;align-items:center;gap:.5rem;padding:.65rem 1.25rem;background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.3);color:#10B981;border-radius:.875rem;text-decoration:none;font-weight:800;font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;transition:background .2s;"
                       onmouseover="this.style.background='rgba(16,185,129,.25)'" onmouseout="this.style.background='rgba(16,185,129,.15)'">
                        <i data-lucide="refresh-cw" style="width:15px;height:15px;"></i>
                        Recapturar
                    </a>
                </div>
            }
            else
            {
                <div style="display:flex;align-items:center;justify-content:space-between;padding:1.25rem;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.25);border-radius:.875rem;">
                    <div style="display:flex;align-items:center;gap:.875rem;">
                        <div style="width:48px;height:48px;background:rgba(245,158,11,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid rgba(245,158,11,.3);">
                            <i data-lucide="alert-triangle" style="width:24px;height:24px;color:#F59E0B;"></i>
                        </div>
                        <div>
                            <p style="font-weight:900;color:#F59E0B;font-size:.9rem;text-transform:uppercase;margin:0 0 .2rem 0;">Sin Huella</p>
                            <p style="font-size:.78rem;color:#FCD34D;font-weight:600;margin:0;">Este cliente no tiene huella registrada</p>
                        </div>
                    </div>
                    <a href="/clientes/capturefingerprint/@Model.Id"
                       style="display:inline-flex;align-items:center;gap:.5rem;padding:.65rem 1.25rem;background:linear-gradient(135deg,#3B82F6,#7C3AED);color:#fff;border-radius:.875rem;text-decoration:none;font-weight:800;font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;box-shadow:0 4px 14px rgba(59,130,246,.3);transition:transform .2s;"
                       onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                        <i data-lucide="fingerprint" style="width:15px;height:15px;"></i>
                        Registrar Huella
                    </a>
                </div>
            }
        </div>

        <!-- Cliente Activo -->
        <div>
            <label style="display:flex;align-items:center;gap:.625rem;cursor:pointer;">
                <input type="checkbox" id="activo" @(Model.Activo ? "checked" : "")
                       style="width:18px;height:18px;accent-color:#3B82F6;cursor:pointer;">
                <span style="font-size:.8rem;font-weight:800;color:#94A3B8;text-transform:uppercase;letter-spacing:.1em;">Cliente Activo</span>
            </label>
        </div>

        <!-- Botones -->
        <div style="display:flex;justify-content:flex-end;gap:.75rem;padding-top:1.25rem;border-top:1px solid #1E2D4A;">
            <a href="/clientes/details/@Model.Id"
               style="display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 2rem;background:rgba(255,255,255,.05);border:1px solid #1E2D4A;color:#94A3B8;border-radius:.875rem;text-decoration:none;font-weight:800;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;transition:background .2s;"
               onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">
                <i data-lucide="x" style="width:16px;height:16px;"></i>
                Cancelar
            </a>
            <button type="submit" id="btn-guardar"
                    style="display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 2rem;background:linear-gradient(135deg,#3B82F6,#7C3AED);color:#fff;border:none;border-radius:.875rem;font-weight:800;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;font-family:inherit;box-shadow:0 4px 20px rgba(59,130,246,.3);transition:transform .2s, box-shadow .2s;"
                    onmouseover="this.style.transform='scale(1.02)';this.style.boxShadow='0 8px 28px rgba(59,130,246,.45)'" onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 20px rgba(59,130,246,.3)'">
                <i data-lucide="save" style="width:16px;height:16px;"></i>
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let fotoBase64 = '@Model.FotoBase64';

        document.getElementById('foto').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    fotoBase64 = event.target.result.split(',')[1];
                    const preview = document.getElementById('foto-preview');
                    if (preview) preview.src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('form-cliente').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btnGuardar = document.getElementById('btn-guardar');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader" style="width:16px;height:16px;"></i> Guardando...';
            lucide.createIcons();

            const clienteId = document.getElementById('cliente-id').value;
            const cliente = {
                id:              clienteId,
                nombre:          document.getElementById('nombre').value,
                apellido:        document.getElementById('apellido').value,
                cedula:          document.getElementById('cedula').value,
                telefono:        document.getElementById('telefono').value,
                email:           document.getElementById('email').value || null,
                fechaNacimiento: document.getElementById('fechaNacimiento').value || null,
                direccion:       document.getElementById('direccion').value || null,
                fotoBase64:      fotoBase64,
                activo:          document.getElementById('activo').checked,
                huellaTemplate:  '@Model.HuellaTemplate',
                huellaDigital:   null
            };

            try {
                const response = await fetch(`${API_URL}/Clientes/${clienteId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(cliente)
                });
                if (response.ok) {
                    alert('✓ Cliente actualizado exitosamente');
                    window.location.href = `/clientes/details/${clienteId}`;
                } else {
                    alert('Error al actualizar');
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            } finally {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = '<i data-lucide="save" style="width:16px;height:16px;"></i> GUARDAR CAMBIOS';
                lucide.createIcons();
            }
        });

        lucide.createIcons();
    </script>
}

@model VidaFitBackend.Models.Cliente
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Cliente";
    ViewData["Subtitle"] = $"Actualizar información de {Model.Nombre} {Model.Apellido}";
}

<style>
    .tz-card {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.15);
        border-radius: 1rem;
        padding: 2rem;
    }

    .tz-section-title {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-size: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #f9fafb;
        padding-bottom: .85rem;
        border-bottom: 1px solid rgba(34,197,94,0.12);
        margin-bottom: 1.25rem;
    }

        .tz-section-title i {
            color: #22c55e;
        }

    .tz-label {
        display: block;
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #6b7280;
        margin-bottom: .4rem;
    }

        .tz-label .req {
            color: #ef4444;
        }

    .tz-input {
        width: 100%;
        padding: .7rem 1rem;
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        border-radius: .65rem;
        color: #f9fafb;
        font-weight: 600;
        font-size: .9rem;
        transition: border-color .2s, box-shadow .2s;
        box-sizing: border-box;
    }

        .tz-input::placeholder {
            color: #374151;
        }

        .tz-input:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }

    .tz-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .75rem 1.5rem;
        border-radius: .65rem;
        background: linear-gradient(135deg,#22c55e,#15803d);
        color: #fff;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        border: none;
        cursor: pointer;
        transition: all .2s;
    }

        .tz-btn-primary:hover {
            background: linear-gradient(135deg,#16a34a,#166534);
            box-shadow: 0 4px 16px rgba(34,197,94,0.3);
            transform: translateY(-1px);
        }

        .tz-btn-primary:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }

    .tz-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .75rem 1.5rem;
        border-radius: .65rem;
        background: transparent;
        border: 1px solid rgba(34,197,94,0.2);
        color: #9ca3af;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        text-decoration: none;
        transition: all .2s;
    }

        .tz-btn-ghost:hover {
            border-color: #22c55e;
            color: #f9fafb;
        }

    .tz-btn-upload {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .6rem 1.25rem;
        border-radius: .65rem;
        background: rgba(34,197,94,0.08);
        border: 1px solid rgba(34,197,94,0.2);
        color: #22c55e;
        font-weight: 800;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        cursor: pointer;
        transition: all .2s;
    }

        .tz-btn-upload:hover {
            background: rgba(34,197,94,0.14);
            border-color: #22c55e;
        }

    .huella-ok {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        background: rgba(16,185,129,0.06);
        border: 1px solid rgba(16,185,129,0.25);
        border-radius: .75rem;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .huella-missing {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        background: rgba(245,158,11,0.06);
        border: 1px solid rgba(245,158,11,0.25);
        border-radius: .75rem;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: .6rem;
        cursor: pointer;
        user-select: none;
    }

        .checkbox-label input[type=checkbox] {
            width: 1.1rem;
            height: 1.1rem;
            accent-color: #22c55e;
            cursor: pointer;
        }

        .checkbox-label span {
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #9ca3af;
        }

    .avatar-preview {
        width: 7rem;
        height: 7rem;
        border-radius: .75rem;
        object-fit: cover;
        border: 2px solid rgba(34,197,94,0.3);
    }

    .avatar-placeholder {
        width: 7rem;
        height: 7rem;
        border-radius: .75rem;
        background: rgba(34,197,94,0.06);
        border: 2px solid rgba(34,197,94,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="tz-card">
    <form id="form-cliente" class="space-y-8">
        <input type="hidden" id="cliente-id" value="@Model.Id" />

        <!-- Información Personal -->
        <div>
            <div class="tz-section-title">
                <i data-lucide="user" style="width:1.1rem;height:1.1rem"></i>
                Información Personal
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(13rem,1fr));gap:1rem">
                <div>
                    <label class="tz-label">Nombre <span class="req">*</span></label>
                    <input type="text" id="nombre" value="@Model.Nombre" required class="tz-input" />
                </div>
                <div>
                    <label class="tz-label">Apellido <span class="req">*</span></label>
                    <input type="text" id="apellido" value="@Model.Apellido" required class="tz-input" />
                </div>
                <div>
                    <label class="tz-label">Cédula <span class="req">*</span></label>
                    <input type="text" id="cedula" value="@Model.Cedula" required class="tz-input" style="font-family:monospace" />
                </div>
                <div>
                    <label class="tz-label">Teléfono</label>
                    <input type="tel" id="telefono" value="@Model.Telefono" class="tz-input" />
                </div>
                <div>
                    <label class="tz-label">Email</label>
                    <input type="email" id="email" value="@Model.Email" class="tz-input" />
                </div>
                <div>
                    <label class="tz-label">Fecha de Nacimiento</label>
                    <input type="date" id="fechaNacimiento" value="@(Model.FechaNacimiento?.ToString("yyyy-MM-dd"))" class="tz-input" />
                </div>
            </div>

            <div style="margin-top:1rem">
                <label class="tz-label">Dirección</label>
                <textarea id="direccion" rows="2" class="tz-input" style="resize:vertical">@Model.Direccion</textarea>
            </div>
        </div>

        <!-- Fotografía -->
        <div>
            <div class="tz-section-title">
                <i data-lucide="camera" style="width:1.1rem;height:1.1rem"></i>
                Fotografía
            </div>

            <div style="display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap">
                <div id="preview-container">
                    @if (!string.IsNullOrEmpty(Model.FotoBase64))
                    {
                        <img id="foto-preview" src="data:image/jpeg;base64,@Model.FotoBase64"
                             class="avatar-preview" alt="Preview" />
                    }
                    else
                    {
                        <div class="avatar-placeholder">
                            <i data-lucide="user" style="width:2.5rem;height:2.5rem;color:#374151"></i>
                        </div>
                    }
                </div>
                <div>
                    <input type="file" id="foto" accept="image/*" class="hidden" />
                    <button type="button" onclick="document.getElementById('foto').click()" class="tz-btn-upload">
                        <i data-lucide="upload" style="width:.9rem;height:.9rem"></i>
                        Cambiar Foto
                    </button>
                    <p style="font-size:.7rem;color:#4b5563;font-weight:600;margin-top:.4rem">JPG, PNG · máx. 5MB</p>
                </div>
            </div>
        </div>

        <!-- Huella Digital -->
        <div>
            <div class="tz-section-title">
                <i data-lucide="fingerprint" style="width:1.1rem;height:1.1rem"></i>
                Huella Digital
            </div>

            @if (!string.IsNullOrEmpty(Model.HuellaTemplate))
            {
                <div class="huella-ok">
                    <div style="display:flex;align-items:center;gap:.75rem">
                        <div style="width:2.75rem;height:2.75rem;border-radius:50%;background:rgba(16,185,129,0.15);border:2px solid rgba(16,185,129,0.35);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i data-lucide="check" style="width:1.1rem;height:1.1rem;color:#10b981"></i>
                        </div>
                        <div>
                            <p style="font-weight:800;color:#10b981;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em">Huella Registrada</p>
                            <p style="font-size:.72rem;color:#6b7280;font-weight:600">El cliente tiene su huella digital registrada</p>
                        </div>
                    </div>
                    <a href="/clientes/capturefingerprint/@Model.Id"
                       style="display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1rem;border-radius:.6rem;background:linear-gradient(135deg,#10b981,#059669);color:#fff;font-weight:800;font-size:.75rem;text-transform:uppercase;letter-spacing:.07em;text-decoration:none">
                        <i data-lucide="refresh-cw" style="width:.85rem;height:.85rem"></i>
                        Recapturar
                    </a>
                </div>
            }
            else
            {
                <div class="huella-missing">
                    <div style="display:flex;align-items:center;gap:.75rem">
                        <div style="width:2.75rem;height:2.75rem;border-radius:50%;background:rgba(245,158,11,0.12);border:2px solid rgba(245,158,11,0.3);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i data-lucide="alert-triangle" style="width:1.1rem;height:1.1rem;color:#f59e0b"></i>
                        </div>
                        <div>
                            <p style="font-weight:800;color:#f59e0b;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em">Sin Huella</p>
                            <p style="font-size:.72rem;color:#6b7280;font-weight:600">Este cliente no tiene huella registrada</p>
                        </div>
                    </div>
                    <a href="/clientes/capturefingerprint/@Model.Id"
                       style="display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1rem;border-radius:.6rem;background:linear-gradient(135deg,#22c55e,#15803d);color:#fff;font-weight:800;font-size:.75rem;text-transform:uppercase;letter-spacing:.07em;text-decoration:none">
                        <i data-lucide="fingerprint" style="width:.85rem;height:.85rem"></i>
                        Registrar Huella
                    </a>
                </div>
            }
        </div>

        <!-- Estado activo -->
        <div>
            <label class="checkbox-label">
                <input type="checkbox" id="activo" @(Model.Activo ? "checked" : "") />
                <span>Cliente Activo</span>
            </label>
        </div>

        <!-- Botones -->
        <div style="display:flex;justify-content:flex-end;gap:.75rem;padding-top:1.25rem;border-top:1px solid rgba(34,197,94,0.1)">
            <a href="/clientes/details/@Model.Id" class="tz-btn-ghost">
                <i data-lucide="x" style="width:.9rem;height:.9rem"></i>
                Cancelar
            </a>
            <button type="submit" id="btn-guardar" class="tz-btn-primary">
                <i data-lucide="save" style="width:.9rem;height:.9rem"></i>
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let fotoBase64 = '@Model.FotoBase64';

        document.getElementById('foto').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (event) {
                fotoBase64 = event.target.result.split(',')[1];
                let preview = document.getElementById('foto-preview');
                const container = document.getElementById('preview-container');
                if (!preview) {
                    container.innerHTML = `<img id="foto-preview" class="avatar-preview" alt="Preview" />`;
                    preview = document.getElementById('foto-preview');
                }
                preview.src = event.target.result;
            };
            reader.readAsDataURL(file);
        });

        document.getElementById('form-cliente').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('btn-guardar');
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader" style="width:.9rem;height:.9rem" class="animate-spin"></i> Guardando...';
            lucide.createIcons();

            const clienteId = document.getElementById('cliente-id').value;

            const cliente = {
                id:              clienteId,
                nombre:          document.getElementById('nombre').value,
                apellido:        document.getElementById('apellido').value,
                cedula:          document.getElementById('cedula').value,
                telefono:        document.getElementById('telefono').value,
                email:           document.getElementById('email').value || null,
                fechaNacimiento: document.getElementById('fechaNacimiento').value || null,
                direccion:       document.getElementById('direccion').value || null,
                fotoBase64:      fotoBase64,
                activo:          document.getElementById('activo').checked,
                huellaTemplate:  '@Model.HuellaTemplate',
                huellaDigital:   null
            };

            try {
                const response = await fetch(`${API_URL}/Clientes/${clienteId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(cliente)
                });

                if (response.ok) {
                    alert('✓ Cliente actualizado exitosamente');
                    window.location.href = `/clientes/details/${clienteId}`;
                } else {
                    alert('Error al actualizar el cliente');
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="save" style="width:.9rem;height:.9rem"></i> Guardar Cambios';
                lucide.createIcons();
            }
        });

        lucide.createIcons();
    </script>
}

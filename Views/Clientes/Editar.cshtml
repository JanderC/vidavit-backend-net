@model VidaFitBackend.Models.Cliente
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Cliente";
    ViewData["Subtitle"] = $"Actualizar información de {Model.Nombre} {Model.Apellido}";
}

<div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
    <form id="form-cliente" class="space-y-8">
        <input type="hidden" id="cliente-id" value="@Model.Id">

        <div>
            <h3 class="text-2xl font-black text-gray-900 mb-6 flex items-center gap-2 uppercase tracking-wide border-b-2 border-gray-200 pb-4">
                <i data-lucide="user" class="w-6 h-6 text-#FF8C00"></i>
                Información Personal
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                        Nombre <span class="text-#FF8C00">*</span>
                    </label>
                    <input type="text" id="nombre" value="@Model.Nombre" required
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-#FF8C00 focus:border-#FF8C00 font-semibold">
                </div>

                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                        Apellido <span class="text-#FF8C00">*</span>
                    </label>
                    <input type="text" id="apellido" value="@Model.Apellido" required
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-#FF8C00 focus:border-#FF8C00 font-semibold">
                </div>

                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                        Cédula <span class="text-#FF8C00">*</span>
                    </label>
                    <input type="text" id="cedula" value="@Model.Cedula" required
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-#FF8C00 focus:border-#FF8C00 font-semibold">
                </div>

                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                        Teléfono <span class="text-#FF8C00">*</span>
                    </label>
                    <input type="tel" id="telefono" value="@Model.Telefono"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-#FF8C00 focus:border-#FF8C00 font-semibold">
                </div>

                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                        Email
                    </label>
                    <input type="email" id="email" value="@Model.Email"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-#FF8C00 focus:border-#FF8C00 font-semibold">
                </div>

                <div>
                    <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                        Fecha de Nacimiento
                    </label>
                    <input type="date" id="fechaNacimiento" value="@(Model.FechaNacimiento?.ToString("yyyy-MM-dd"))"
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-#FF8C00 focus:border-#FF8C00 font-semibold">
                </div>
            </div>

            <div class="mt-6">
                <label class="block text-sm font-black text-gray-700 mb-2 uppercase tracking-wide">
                    Dirección
                </label>
                <textarea id="direccion" rows="2"
                          class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-#FF8C00 focus:border-#FF8C00 font-semibold">@Model.Direccion</textarea>
            </div>
        </div>

        <div>
            <h3 class="text-2xl font-black text-gray-900 mb-6 flex items-center gap-2 uppercase tracking-wide border-b-2 border-gray-200 pb-4">
                <i data-lucide="camera" class="w-6 h-6 text-#FF8C00"></i>
                Fotografía
            </h3>

            <div class="flex items-center gap-4">
                <div id="preview-container">
                    @if (!string.IsNullOrEmpty(Model.FotoBase64))
                    {
                        <img id="foto-preview" src="data:image/jpeg;base64,@Model.FotoBase64"
                             class="w-32 h-32 rounded-xl object-cover border-2 border-gray-300" alt="Preview">
                    }
                    else
                    {
                        <div class="w-32 h-32 rounded-xl bg-gray-200 border-2 border-gray-300 flex items-center justify-center">
                            <i data-lucide="user" class="w-16 h-16 text-gray-400"></i>
                        </div>
                    }
                </div>

                <div class="flex-1">
                    <input type="file" id="foto" accept="image/*" class="hidden">
                    <button type="button" onclick="document.getElementById('foto').click()"
                            class="px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-900 rounded-xl border-2 border-gray-300 transition-all inline-flex items-center gap-2 font-black uppercase tracking-wide">
                        <i data-lucide="upload" class="w-5 h-5"></i>
                        Cambiar Foto
                    </button>
                </div>
            </div>
        </div>

        <div>
            <h3 class="text-2xl font-black text-gray-900 mb-6 flex items-center gap-2 uppercase tracking-wide border-b-2 border-gray-200 pb-4">
                <i data-lucide="fingerprint" class="w-6 h-6 text-#FF8C00"></i>
                Huella Digital
            </h3>

            @if (!string.IsNullOrEmpty(Model.HuellaTemplate))
            {
                <div class="flex items-center justify-between p-5 bg-emerald-50 border-2 border-emerald-500 rounded-xl">
                    <div class="flex items-center gap-3">
                        <div class="w-14 h-14 bg-emerald-500 rounded-full flex items-center justify-center">
                            <i data-lucide="check" class="w-7 h-7 text-white"></i>
                        </div>
                        <div>
                            <p class="font-black text-emerald-900 text-lg uppercase tracking-wide">Huella Registrada</p>
                            <p class="text-sm text-emerald-700 font-semibold">El cliente tiene su huella digital registrada</p>
                        </div>
                    </div>
                    <a href="/clientes/capturefingerprint/@Model.Id"
                       class="px-6 py-3 bg-gradient-to-r from-emerald-600 to-emerald-800 hover:from-emerald-700 hover:to-emerald-900 text-white rounded-xl transition-all inline-flex items-center gap-2 font-black uppercase tracking-wide shadow-lg">
                        <i data-lucide="refresh-cw" class="w-5 h-5"></i>
                        Recapturar
                    </a>
                </div>
            }
            else
            {
                <div class="flex items-center justify-between p-5 bg-amber-50 border-2 border-amber-500 rounded-xl">
                    <div class="flex items-center gap-3">
                        <div class="w-14 h-14 bg-amber-500 rounded-full flex items-center justify-center">
                            <i data-lucide="alert-triangle" class="w-7 h-7 text-white"></i>
                        </div>
                        <div>
                            <p class="font-black text-amber-900 text-lg uppercase tracking-wide">Sin Huella</p>
                            <p class="text-sm text-amber-700 font-semibold">Este cliente no tiene huella registrada</p>
                        </div>
                    </div>
                    <a href="/clientes/capturefingerprint/@Model.Id"
                       class="px-6 py-3 bg-gradient-to-r from-#FF8C00 to-#FF9D1F hover:from-#FFA500 hover:to-orange-900 text-white font-black rounded-xl transition-all inline-flex items-center gap-2 uppercase tracking-wide shadow-lg">
                        <i data-lucide="fingerprint" class="w-5 h-5"></i>
                        Registrar Huella
                    </a>
                </div>
            }
        </div>

        <div>
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="activo" @(Model.Activo ? "checked" : "")
                       class="w-5 h-5 text-#FF8C00 border-gray-300 rounded focus:ring-#FF8C00">
                <span class="text-sm font-black text-gray-700 uppercase tracking-wide">Cliente Activo</span>
            </label>
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t-2 border-gray-200">
            <a href="/clientes/details/@Model.Id"
               class="px-8 py-3 border-2 border-gray-300 text-gray-800 rounded-xl hover:bg-gray-100 transition-all inline-flex items-center gap-2 font-black uppercase tracking-wide">
                <i data-lucide="x" class="w-5 h-5"></i>
                Cancelar
            </a>
            <button type="submit" id="btn-guardar"
                    class="px-8 py-3 bg-gradient-to-r from-#FF8C00 to-#FF9D1F hover:from-#FFA500 hover:to-orange-900 text-white font-black rounded-xl transition-all shadow-xl hover:shadow-2xl inline-flex items-center gap-2 uppercase tracking-wide">
                <i data-lucide="save" class="w-5 h-5"></i>
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        let fotoBase64 = '@Model.FotoBase64';

        document.getElementById('foto').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    fotoBase64 = event.target.result.split(',')[1];
                    const preview = document.getElementById('foto-preview');
                    preview.src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('form-cliente').addEventListener('submit', async function(e) {
            e.preventDefault();

            const btnGuardar = document.getElementById('btn-guardar');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader" class="w-5 h-5 animate-spin"></i> Guardando...';

            const clienteId = document.getElementById('cliente-id').value;

            const cliente = {
                id: clienteId,
                nombre: document.getElementById('nombre').value,
                apellido: document.getElementById('apellido').value,
                cedula: document.getElementById('cedula').value,
                telefono: document.getElementById('telefono').value,
                email: document.getElementById('email').value || null,
                fechaNacimiento: document.getElementById('fechaNacimiento').value || null,
                direccion: document.getElementById('direccion').value || null,
                fotoBase64: fotoBase64,
                activo: document.getElementById('activo').checked,
                huellaTemplate: '@Model.HuellaTemplate',
                huellaDigital: null
            };

            try {
                const response = await fetch(`${API_URL}/Clientes/${clienteId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(cliente)
                });

                if (response.ok) {
                    alert('✓ Cliente actualizado exitosamente');
                    window.location.href = `/clientes/details/${clienteId}`;
                } else {
                    alert('Error al actualizar');
                }
            } catch (error) {
                alert('Error de conexión: ' + error.message);
            } finally {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = '<i data-lucide="save" class="w-5 h-5"></i> GUARDAR CAMBIOS';
                lucide.createIcons();
            }
        });

        lucide.createIcons();
    </script>
}

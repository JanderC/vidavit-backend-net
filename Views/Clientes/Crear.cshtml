@model VidaFitBackend.Models.Cliente
@{
    ViewData["Title"] = "Crear Cliente";
    ViewData["Subtitle"] = "Registrar nuevo cliente en el sistema";
    Layout = "_AdminLayout";
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-xl shadow-lg p-8">
        <div class="flex items-center gap-3 mb-6">
            <div class="bg-vida-primary rounded-full p-3">
                <i data-lucide="user-plus" class="w-6 h-6 text-vida-dark"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Nuevo Cliente</h2>
                <p class="text-sm text-gray-600">Complete el formulario. Después podrá registrar su huella digital.</p>
            </div>
        </div>

        <form asp-action="Crear" method="post" enctype="multipart/form-data" class="space-y-6">
            @Html.AntiForgeryToken()

            <!-- Banner de campos requeridos -->
            <div class="bg-vida-primary/10 border-l-4 border-vida-primary rounded-lg p-4">
                <div class="flex items-start gap-3">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-vida-primary mt-0.5"></i>
                    <div>
                        <h4 class="font-semibold text-gray-800 mb-1">Campos Obligatorios</h4>
                        <p class="text-sm text-gray-700">
                            Solo se requieren: <span class="font-semibold">Nombre, Apellido y Cédula</span>. 
                            Todos los demás campos son opcionales.
                        </p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Nombre -->
                <div>
                    <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-2">
                        Nombre <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Nombre"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent"
                           placeholder="Ingrese el nombre"
                           required />
                    <span asp-validation-for="Nombre" class="text-red-500 text-sm"></span>
                </div>

                <!-- Apellido -->
                <div>
                    <label asp-for="Apellido" class="block text-sm font-medium text-gray-700 mb-2">
                        Apellido <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Apellido"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent"
                           placeholder="Ingrese el apellido"
                           required />
                    <span asp-validation-for="Apellido" class="text-red-500 text-sm"></span>
                </div>

                <!-- Cédula -->
                <div>
                    <label asp-for="Cedula" class="block text-sm font-medium text-gray-700 mb-2">
                        Cédula <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Cedula"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent"
                           placeholder="Ej: 001-1234567-8"
                           required />
                    <span asp-validation-for="Cedula" class="text-red-500 text-sm"></span>
                </div>

                <!-- Teléfono -->
                <div>
                    <label asp-for="Telefono" class="block text-sm font-medium text-gray-700 mb-2">
                        Teléfono (Opcional)
                    </label>
                    <input asp-for="Telefono"
                           type="tel"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent"
                           placeholder="Ej: 809-555-1234" />
                    <span asp-validation-for="Telefono" class="text-red-500 text-sm"></span>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-2">
                        Email (Opcional)
                    </label>
                    <input asp-for="Email"
                           type="email"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent"
                           placeholder="cliente@ejemplo.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                </div>

                <!-- Fecha de Nacimiento -->
                <div>
                    <label asp-for="FechaNacimiento" class="block text-sm font-medium text-gray-700 mb-2">
                        Fecha de Nacimiento (Opcional)
                    </label>
                    <input asp-for="FechaNacimiento"
                           type="date"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent" />
                    <span asp-validation-for="FechaNacimiento" class="text-red-500 text-sm"></span>
                </div>
            </div>

            <!-- Dirección -->
            <div>
                <label asp-for="Direccion" class="block text-sm font-medium text-gray-700 mb-2">
                    Dirección (Opcional)
                </label>
                <textarea asp-for="Direccion"
                          rows="2"
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vida-primary focus:border-transparent"
                          placeholder="Calle, número, sector, ciudad"></textarea>
                <span asp-validation-for="Direccion" class="text-red-500 text-sm"></span>
            </div>

            <!-- Foto del Cliente -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Foto del Cliente (Opcional)
                </label>
                <div class="flex items-center gap-4">
                    <div id="preview-container" class="hidden">
                        <img id="foto-preview" class="w-32 h-32 object-cover rounded-lg border-2 border-gray-300" />
                    </div>
                    <div class="flex-1">
                        <input type="file"
                               id="fotoInput"
                               accept="image/*"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-vida-primary file:text-vida-dark file:font-semibold hover:file:bg-vida-accent" />
                        <p class="text-xs text-gray-500 mt-1">Formatos: JPG, PNG (máx. 5MB)</p>
                    </div>
                </div>
                <input asp-for="FotoBase64" type="hidden" id="fotoBase64Input" />
            </div>

            <!-- Info sobre huella -->
            <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded">
                <div class="flex items-start gap-3">
                    <i data-lucide="info" class="w-5 h-5 text-blue-600 mt-0.5"></i>
                    <div>
                        <h4 class="font-semibold text-blue-900 mb-1">Registro de Huella Digital</h4>
                        <p class="text-sm text-blue-800">
                            Después de crear el cliente, será redirigido automáticamente a la pantalla de captura de huella digital.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Botones de Acción -->
            <div class="flex gap-4 pt-4 border-t">
                <button type="submit"
                        class="flex-1 bg-vida-primary text-vida-dark font-bold py-3 px-6 rounded-lg hover:bg-vida-accent transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    Crear Cliente y Continuar
                </button>
                <a href="/clientes"
                   class="flex-1 bg-gray-300 text-gray-700 font-bold py-3 px-6 rounded-lg hover:bg-gray-400 transition-all text-center flex items-center justify-center gap-2">
                    <i data-lucide="x" class="w-5 h-5"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Inicializar iconos
        lucide.createIcons();

        // Manejo de la imagen
        const fotoInput = document.getElementById('fotoInput');
        const fotoBase64Input = document.getElementById('fotoBase64Input');
        const preview = document.getElementById('foto-preview');
        const previewContainer = document.getElementById('preview-container');

        fotoInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                // Validar tamaño (5MB máximo)
                if (file.size > 5 * 1024 * 1024) {
                    alert('La imagen es muy grande. El tamaño máximo es 5MB.');
                    fotoInput.value = '';
                    return;
                }

                // Leer y convertir a Base64
                const reader = new FileReader();
                reader.onload = function(e) {
                    const base64 = e.target.result;
                    fotoBase64Input.value = base64;
                    preview.src = base64;
                    previewContainer.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            } else {
                previewContainer.classList.add('hidden');
                fotoBase64Input.value = '';
            }
        });
    </script>
}

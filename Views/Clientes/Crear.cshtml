@model VidaFitBackend.Models.Cliente
@{
    ViewData["Title"] = "Crear Cliente";
    ViewData["Subtitle"] = "Registrar nuevo miembro en Power Fitness";
    Layout = "_AdminLayout";
}

<style>
    /* ── Variables ── */
    :root {
        --pf-blue:    #3B82F6;
        --pf-blueB:   #60A5FA;
        --pf-deep:    #1E3A8A;
        --pf-purple:  #7C3AED;
        --pf-dark:    #060B18;
        --pf-card:    #0D1526;
        --pf-border:  #1E2D4A;
        --pf-text:    #E2E8F0;
        --pf-soft:    #94A3B8;
        --pf-muted:   #64748B;
        --pf-green:   #10B981;
        --pf-red:     #EF4444;
        --pf-orange:  #F59E0B;
    }

    /* ── Modal overlay ── */
    #modalExito {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(6,11,24,.8);
        backdrop-filter: blur(6px);
        align-items: center;
        justify-content: center;
    }
    #modalExito.show { display: flex; }

    .modal-card {
        background: var(--pf-card);
        border: 1px solid var(--pf-border);
        border-radius: 1.25rem;
        width: 100%;
        max-width: 520px;
        margin: 1rem;
        box-shadow: 0 25px 60px rgba(0,0,0,.6);
        overflow: hidden;
    }

    .modal-header {
        background: linear-gradient(135deg, var(--pf-deep), var(--pf-purple));
        padding: 1.75rem 2rem 1.5rem;
        text-align: center;
        border-bottom: 1px solid rgba(96,165,250,.2);
    }

    .modal-checkmark {
        width: 64px; height: 64px;
        background: rgba(255,255,255,.12);
        border: 2px solid rgba(255,255,255,.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto .875rem;
        font-size: 1.75rem;
    }

    .modal-title {
        font-size: 1.35rem;
        font-weight: 900;
        color: #fff;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .modal-subtitle {
        font-size: .8rem;
        color: rgba(255,255,255,.65);
        margin-top: .25rem;
        font-weight: 600;
    }

    .modal-cliente-nombre {
        display: inline-block;
        margin-top: .625rem;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: .5rem;
        padding: .35rem 1.1rem;
        color: #fff;
        font-weight: 800;
        font-size: .9rem;
    }

    .modal-body { padding: 1.75rem 2rem; }

    .modal-pregunta {
        text-align: center;
        font-size: .9rem;
        font-weight: 700;
        color: var(--pf-text);
        margin-bottom: 1.25rem;
    }
    .modal-pregunta span {
        display: block;
        font-size: .78rem;
        color: var(--pf-muted);
        font-weight: 500;
        margin-top: .25rem;
    }

    .modal-opciones { display: flex; flex-direction: column; gap: .75rem; }

    .opcion-btn {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-radius: .875rem;
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: transform .18s, box-shadow .18s;
        text-align: left;
        width: 100%;
        font-family: inherit;
    }
    .opcion-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.3); }

    .opcion-huella {
        background: linear-gradient(135deg, var(--pf-blue), var(--pf-purple));
        color: #fff;
    }
    .opcion-lista {
        background: rgba(255,255,255,.04);
        border-color: var(--pf-border);
        color: var(--pf-text);
    }
    .opcion-lista:hover { background: rgba(255,255,255,.07); }
    .opcion-nuevo {
        background: transparent;
        border-color: var(--pf-border);
        color: var(--pf-soft);
    }
    .opcion-nuevo:hover { background: rgba(255,255,255,.04); color: var(--pf-text); }

    .opcion-icon {
        width: 44px; height: 44px;
        border-radius: .625rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }
    .opcion-huella .opcion-icon { background: rgba(255,255,255,.18); }
    .opcion-lista  .opcion-icon { background: rgba(59,130,246,.12); }
    .opcion-nuevo  .opcion-icon { background: rgba(255,255,255,.06); }

    .opcion-texto strong {
        display: block;
        font-size: .82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .opcion-texto small { font-size: .75rem; opacity: .7; font-weight: 500; }
    .opcion-arrow { margin-left: auto; font-size: 1.1rem; opacity: .55; flex-shrink: 0; }

    /* Badge */
    .node-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: rgba(16,185,129,.12);
        border: 1px solid rgba(16,185,129,.3);
        color: var(--pf-green);
        border-radius: .375rem;
        padding: 2px 8px;
        font-size: .65rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        margin-top: .25rem;
    }
    .node-badge::before {
        content: '';
        width: 6px; height: 6px;
        border-radius: 50%;
        background: var(--pf-green);
        display: inline-block;
    }

    /* Toast error */
    #toastError {
        display: none;
        position: fixed;
        top: 1.5rem; right: 1.5rem;
        z-index: 10000;
        background: var(--pf-card);
        border: 1px solid rgba(239,68,68,.35);
        border-left: 4px solid var(--pf-red);
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        max-width: 380px;
        box-shadow: 0 10px 30px rgba(0,0,0,.4);
    }
    #toastError.show { display: block; }

    .toast-title { font-weight: 800; color: var(--pf-red); font-size: .85rem; margin-bottom: .25rem; }
    .toast-msg   { font-size: .8rem; color: var(--pf-soft); font-weight: 500; }

    /* Spinner botón */
    .btn-spinner {
        display: inline-block;
        width: 16px; height: 16px;
        border: 2px solid rgba(255,255,255,.3);
        border-top-color: #fff;
        border-radius: 50%;
        flex-shrink: 0;
    }

    /* Inputs */
    .pf-input {
        width: 100%;
        padding: .75rem 1rem;
        border: 2px solid var(--pf-border);
        border-radius: .75rem;
        background: rgba(255,255,255,.03);
        color: var(--pf-text);
        font-weight: 600;
        font-family: inherit;
        font-size: .9rem;
        outline: none;
        box-sizing: border-box;
        transition: border-color .2s;
    }
    .pf-input:focus { border-color: var(--pf-blue); background: rgba(59,130,246,.05); }
    .pf-input::placeholder { color: var(--pf-muted); font-weight: 400; }
    .pf-input.border-red-500 { border-color: var(--pf-red) !important; }

    .pf-label {
        display: block;
        font-size: .72rem;
        font-weight: 800;
        color: var(--pf-soft);
        margin-bottom: .5rem;
        text-transform: uppercase;
        letter-spacing: .1em;
    }
    .pf-required { color: var(--pf-blue); }
</style>

<!-- Modal éxito -->
<div id="modalExito">
    <div class="modal-card">
        <div class="modal-header">
            <div class="modal-checkmark">✓</div>
            <div class="modal-title">¡Cliente Creado!</div>
            <div class="modal-subtitle">El registro se guardó correctamente</div>
            <div class="modal-cliente-nombre" id="modalNombreCliente">—</div>
        </div>
        <div class="modal-body">
            <div class="modal-pregunta">
                ¿Qué deseas hacer ahora?
                <span>Puedes registrar la huella digital del cliente de inmediato</span>
            </div>
            <div class="modal-opciones">
                <a id="btnRegistrarHuella" href="#" target="_blank" class="opcion-btn opcion-huella">
                    <div class="opcion-icon">✋</div>
                    <div class="opcion-texto">
                        <strong>Registrar Huella Digital</strong>
                        <small>Abre el sistema biométrico con los datos pre-cargados</small>
                        <div class="node-badge">Sistema Node.js activo</div>
                    </div>
                    <div class="opcion-arrow">→</div>
                </a>
                <a href="/clientes" class="opcion-btn opcion-lista">
                    <div class="opcion-icon">👥</div>
                    <div class="opcion-texto">
                        <strong>Ir al Listado de Clientes</strong>
                        <small>Ver todos los clientes registrados</small>
                    </div>
                    <div class="opcion-arrow">→</div>
                </a>
                <button type="button" class="opcion-btn opcion-nuevo" onclick="resetFormulario()">
                    <div class="opcion-icon">➕</div>
                    <div class="opcion-texto">
                        <strong>Crear Otro Cliente</strong>
                        <small>Registrar un nuevo miembro</small>
                    </div>
                    <div class="opcion-arrow">↩</div>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast error -->
<div id="toastError">
    <div class="toast-title">❌ Error al crear el cliente</div>
    <div class="toast-msg" id="toastMensaje">—</div>
</div>

<!-- Formulario -->
<div style="max-width:56rem; margin:0 auto;">
    <div style="background:#0D1526; border-radius:1.25rem; border:1px solid #1E2D4A; padding:2rem; box-shadow:0 4px 24px rgba(0,0,0,.4);">

        <!-- Header formulario -->
        <div style="display:flex; align-items:center; gap:1rem; margin-bottom:2rem; padding-bottom:1.25rem; border-bottom:1px solid #1E2D4A;">
            <div style="background:linear-gradient(135deg,#1E3A8A,#7C3AED); border-radius:.875rem; padding:1rem; flex-shrink:0;">
                <i data-lucide="user-plus" style="width:32px;height:32px;color:#fff;"></i>
            </div>
            <div>
                <h2 style="font-size:1.5rem; font-weight:900; color:#E2E8F0; text-transform:uppercase; letter-spacing:.06em; margin:0 0 .25rem 0;">Nuevo Cliente</h2>
                <p style="font-size:.8rem; color:#64748B; font-weight:600; margin:0;">Complete el formulario. Al guardar podrás registrar la huella digital del cliente.</p>
            </div>
        </div>

        <!-- Aviso campos obligatorios -->
        <div style="background:rgba(59,130,246,.07); border-left:4px solid #3B82F6; border-radius:.75rem; padding:1rem 1.25rem; margin-bottom:1.5rem; display:flex; align-items:flex-start; gap:.75rem;">
            <i data-lucide="alert-circle" style="width:20px;height:20px;color:#60A5FA;flex-shrink:0;margin-top:.1rem;"></i>
            <div>
                <h4 style="font-weight:800; color:#60A5FA; margin:0 0 .25rem 0; font-size:.8rem; text-transform:uppercase; letter-spacing:.08em;">Campos Obligatorios</h4>
                <p style="font-size:.8rem; color:#94A3B8; font-weight:600; margin:0;">
                    Solo se requieren: <strong style="color:#E2E8F0;">Nombre, Apellido y Cédula</strong>. Todos los demás campos son opcionales.
                </p>
            </div>
        </div>

        <form id="formCrearCliente" style="display:flex;flex-direction:column;gap:1.25rem;" novalidate>
            @Html.AntiForgeryToken()

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">
                <div>
                    <label class="pf-label">Nombre <span class="pf-required">*</span></label>
                    <input id="inputNombre" name="nombre" type="text" class="pf-input" placeholder="Ingrese el nombre" required />
                    <span style="color:#EF4444;font-size:.75rem;font-weight:700;" id="errNombre"></span>
                </div>
                <div>
                    <label class="pf-label">Apellido <span class="pf-required">*</span></label>
                    <input id="inputApellido" name="apellido" type="text" class="pf-input" placeholder="Ingrese el apellido" required />
                    <span style="color:#EF4444;font-size:.75rem;font-weight:700;" id="errApellido"></span>
                </div>
                <div>
                    <label class="pf-label">Cédula <span class="pf-required">*</span></label>
                    <input id="inputCedula" name="cedula" type="text" class="pf-input" placeholder="Ej: 001-1234567-8" required />
                    <span style="color:#EF4444;font-size:.75rem;font-weight:700;" id="errCedula"></span>
                </div>
                <div>
                    <label class="pf-label">Teléfono (Opcional)</label>
                    <input id="inputTelefono" name="telefono" type="tel" class="pf-input" placeholder="Ej: 809-555-1234" />
                </div>
                <div>
                    <label class="pf-label">Email (Opcional)</label>
                    <input id="inputEmail" name="email" type="email" class="pf-input" placeholder="cliente@ejemplo.com" />
                </div>
                <div>
                    <label class="pf-label">Fecha de Nacimiento (Opcional)</label>
                    <input id="inputFechaNac" name="fechaNacimiento" type="date" class="pf-input" />
                </div>
            </div>

            <div>
                <label class="pf-label">Dirección (Opcional)</label>
                <textarea id="inputDireccion" name="direccion" rows="2" class="pf-input" placeholder="Calle, número, sector, ciudad"></textarea>
            </div>

            <!-- Foto -->
            <div>
                <label class="pf-label">Foto del Cliente (Opcional)</label>
                <div style="display:flex; align-items:center; gap:1rem;">
                    <div id="preview-container" class="hidden">
                        <img id="foto-preview" style="width:96px;height:96px;object-fit:cover;border-radius:.75rem;border:2px solid #1E2D4A;" />
                    </div>
                    <div style="flex:1;">
                        <input type="file" id="fotoInput" accept="image/*"
                               style="width:100%; padding:.5rem .875rem; border:2px solid #1E2D4A; border-radius:.75rem; background:rgba(255,255,255,.03); color:#94A3B8; font-family:inherit; box-sizing:border-box;" />
                        <p style="font-size:.72rem; color:#64748B; margin-top:.4rem; font-weight:600;">Formatos: JPG, PNG (máx. 5MB)</p>
                    </div>
                </div>
                <input type="hidden" id="fotoBase64Input" />
            </div>

            <!-- Info huella -->
            <div style="background:rgba(59,130,246,.07); border-left:4px solid #3B82F6; border-radius:.75rem; padding:1rem 1.25rem; display:flex; align-items:flex-start; gap:.75rem;">
                <i data-lucide="fingerprint" style="width:22px;height:22px;color:#60A5FA;flex-shrink:0;margin-top:.1rem;"></i>
                <div>
                    <h4 style="font-weight:800; color:#60A5FA; margin:0 0 .25rem 0; font-size:.78rem; text-transform:uppercase; letter-spacing:.08em;">Registro de Huella Digital</h4>
                    <p style="font-size:.8rem; color:#94A3B8; font-weight:600; margin:0;">
                        Al guardar el cliente, se abrirá una ventana para registrar su huella en el <strong style="color:#E2E8F0;">sistema biométrico</strong>.
                    </p>
                </div>
            </div>

            <!-- Botones -->
            <div style="display:flex; gap:1rem; padding-top:1.25rem; border-top:1px solid #1E2D4A;">
                <button type="submit" id="btnGuardar"
                        style="flex:1; background:linear-gradient(135deg,#3B82F6,#7C3AED); color:#fff; font-weight:800; padding:1rem; border:none; border-radius:.875rem; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:.5rem; text-transform:uppercase; letter-spacing:.08em; font-family:inherit; font-size:.9rem; box-shadow:0 4px 20px rgba(59,130,246,.3); transition:box-shadow .2s, transform .2s;"
                        onmouseover="this.style.transform='scale(1.02)';this.style.boxShadow='0 8px 28px rgba(59,130,246,.45)'" onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 20px rgba(59,130,246,.3)'">
                    <i data-lucide="save" style="width:18px;height:18px;" id="iconGuardar"></i>
                    <span id="textoGuardar">Crear Cliente</span>
                </button>
                <a href="/clientes"
                   style="flex:1; background:rgba(255,255,255,.05); border:1px solid #1E2D4A; color:#94A3B8; font-weight:800; padding:1rem; border-radius:.875rem; text-align:center; text-decoration:none; display:flex; align-items:center; justify-content:center; gap:.5rem; text-transform:uppercase; letter-spacing:.08em; font-size:.9rem; transition:background .2s;"
                   onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='rgba(255,255,255,.05)'">
                    <i data-lucide="x" style="width:18px;height:18px;"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
        const NODE_URL = 'http://localhost:3000';

        const fotoInput         = document.getElementById('fotoInput');
        const fotoBase64Input   = document.getElementById('fotoBase64Input');
        const preview           = document.getElementById('foto-preview');
        const previewContainer  = document.getElementById('preview-container');

        fotoInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) { previewContainer.classList.add('hidden'); fotoBase64Input.value = ''; return; }
            if (file.size > 5 * 1024 * 1024) {
                mostrarToastError('La imagen es muy grande. El tamaño máximo es 5MB.');
                fotoInput.value = ''; return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                const base64 = e.target.result;
                fotoBase64Input.value = base64;
                preview.src = base64;
                previewContainer.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        });

        function validarFormulario() {
            let ok = true;
            const campos = [
                { id: 'inputNombre',   err: 'errNombre',   msg: 'El nombre es obligatorio.' },
                { id: 'inputApellido', err: 'errApellido', msg: 'El apellido es obligatorio.' },
                { id: 'inputCedula',   err: 'errCedula',   msg: 'La cédula es obligatoria.' },
            ];
            campos.forEach(c => {
                const input = document.getElementById(c.id);
                const errEl = document.getElementById(c.err);
                if (!input.value.trim()) {
                    errEl.textContent = c.msg;
                    input.classList.add('border-red-500');
                    ok = false;
                } else {
                    errEl.textContent = '';
                    input.classList.remove('border-red-500');
                }
            });
            return ok;
        }

        document.getElementById('formCrearCliente').addEventListener('submit', async function(e) {
            e.preventDefault();
            if (!validarFormulario()) return;
            setBtnLoading(true);
            const payload = {
                nombre:          document.getElementById('inputNombre').value.trim(),
                apellido:        document.getElementById('inputApellido').value.trim(),
                cedula:          document.getElementById('inputCedula').value.trim(),
                telefono:        document.getElementById('inputTelefono').value.trim() || null,
                email:           document.getElementById('inputEmail').value.trim() || null,
                fechaNacimiento: document.getElementById('inputFechaNac').value || null,
                direccion:       document.getElementById('inputDireccion').value.trim() || null,
                fotoBase64:      document.getElementById('fotoBase64Input').value || null,
                activo:          true
            };
            try {
                const response = await fetch('/api/clientes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (response.status === 400) {
                    const txt = await response.text();
                    mostrarToastError(txt || 'Ya existe un cliente con esa cédula.');
                    setBtnLoading(false); return;
                }
                if (!response.ok) throw new Error(`Error del servidor: ${response.status}`);
                const cliente = await response.json();
                mostrarModalExito(cliente);
            } catch (err) {
                console.error('Error al crear cliente:', err);
                mostrarToastError(err.message || 'Error inesperado. Intenta de nuevo.');
            } finally {
                setBtnLoading(false);
            }
        });

        function mostrarModalExito(cliente) {
            const nombre = `${cliente.Nombre || cliente.nombre} ${cliente.Apellido || cliente.apellido}`;
            const cedula = cliente.Cedula || cliente.cedula;
            document.getElementById('modalNombreCliente').textContent = nombre;
            const nodeUrl = `${NODE_URL}/register?cedula=${encodeURIComponent(cedula)}&nombre=${encodeURIComponent(nombre)}`;
            document.getElementById('btnRegistrarHuella').href = nodeUrl;
            const modal = document.getElementById('modalExito');
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function cerrarModal() {
            document.getElementById('modalExito').classList.remove('show');
            document.body.style.overflow = '';
        }

        document.getElementById('modalExito').addEventListener('click', function(e) {
            if (e.target === this) cerrarModal();
        });

        function resetFormulario() {
            cerrarModal();
            document.getElementById('formCrearCliente').reset();
            fotoBase64Input.value = '';
            previewContainer.classList.add('hidden');
            ['errNombre','errApellido','errCedula'].forEach(id => {
                document.getElementById(id).textContent = '';
            });
            ['inputNombre','inputApellido','inputCedula'].forEach(id => {
                document.getElementById(id).classList.remove('border-red-500');
            });
            document.getElementById('inputNombre').focus();
        }

        function setBtnLoading(loading) {
            const btn   = document.getElementById('btnGuardar');
            const icono = document.getElementById('iconGuardar');
            const texto = document.getElementById('textoGuardar');
            btn.disabled = loading;
            if (loading) {
                icono.outerHTML = '<div class="btn-spinner" id="iconGuardar"></div>';
                texto.textContent = 'Guardando...';
            } else {
                const spinnerEl = document.getElementById('iconGuardar');
                if (spinnerEl) {
                    spinnerEl.outerHTML = '<i data-lucide="save" style="width:18px;height:18px;" id="iconGuardar"></i>';
                    lucide.createIcons();
                }
                texto.textContent = 'Crear Cliente';
            }
        }

        let toastTimer = null;
        function mostrarToastError(msg) {
            document.getElementById('toastMensaje').textContent = msg;
            const toast = document.getElementById('toastError');
            toast.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove('show'), 5000);
        }

        ['inputNombre','inputApellido','inputCedula'].forEach(id => {
            document.getElementById(id).addEventListener('input', function() {
                this.classList.remove('border-red-500');
            });
        });
    </script>
}

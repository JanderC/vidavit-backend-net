@model VidaFitBackend.Models.Cliente
@{
    ViewData["Title"] = "Crear Cliente";
    ViewData["Subtitle"] = "Registrar nuevo miembro en Tallest GYM";
    Layout = "_AdminLayout";
}

<style>
    /* ── Modal Overlay ── */
    #modalExito {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(6px);
        align-items: center;
        justify-content: center;
    }

        #modalExito.show {
            display: flex;
        }

    .modal-card {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.3);
        border-radius: 1.25rem;
        width: 100%;
        max-width: 500px;
        margin: 1rem;
        box-shadow: 0 25px 60px rgba(0,0,0,0.6), 0 0 40px rgba(34,197,94,0.1);
        overflow: hidden;
    }

    .modal-header {
        background: linear-gradient(135deg, #166534, #15803d);
        padding: 1.75rem 2rem 1.5rem;
        text-align: center;
        position: relative;
    }

        .modal-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: rgba(34,197,94,0.4);
        }

    .modal-checkmark {
        width: 3.5rem;
        height: 3.5rem;
        background: rgba(255,255,255,0.12);
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto .85rem;
        font-size: 1.4rem;
    }

    .modal-title {
        font-size: 1.3rem;
        font-weight: 900;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .modal-subtitle {
        font-size: .78rem;
        color: rgba(255,255,255,.7);
        margin-top: .25rem;
        font-weight: 600;
    }

    .modal-cliente-nombre {
        display: inline-block;
        margin-top: .65rem;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: .5rem;
        padding: .35rem 1rem;
        color: #fff;
        font-weight: 800;
        font-size: .9rem;
    }

    .modal-body {
        padding: 1.5rem 2rem;
    }

    .modal-pregunta {
        text-align: center;
        font-size: .9rem;
        font-weight: 700;
        color: #d1d5db;
        margin-bottom: 1rem;
    }

        .modal-pregunta span {
            display: block;
            font-size: .75rem;
            color: #6b7280;
            font-weight: 500;
            margin-top: .2rem;
        }

    .modal-opciones {
        display: flex;
        flex-direction: column;
        gap: .65rem;
    }

    .opcion-btn {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: .9rem 1.1rem;
        border-radius: .75rem;
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        text-align: left;
        width: 100%;
        font-family: inherit;
        transition: all .18s;
    }

        .opcion-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.3);
        }

    .opcion-huella {
        background: linear-gradient(135deg,#22c55e,#15803d);
        color: #fff;
    }

        .opcion-huella:hover {
            background: linear-gradient(135deg,#16a34a,#166534);
            box-shadow: 0 6px 20px rgba(34,197,94,0.35) !important;
        }

    .opcion-lista {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.08);
        color: #d1d5db;
    }

        .opcion-lista:hover {
            background: rgba(255,255,255,0.07);
            border-color: rgba(34,197,94,0.2);
        }

    .opcion-nuevo {
        background: transparent;
        border-color: rgba(255,255,255,0.06);
        color: #6b7280;
    }

        .opcion-nuevo:hover {
            background: rgba(255,255,255,0.03);
            border-color: rgba(255,255,255,0.12);
            color: #d1d5db;
        }

    .opcion-icon {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: .6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
        background: rgba(255,255,255,0.12);
    }

    .opcion-lista .opcion-icon, .opcion-nuevo .opcion-icon {
        background: rgba(34,197,94,0.08);
    }

    .opcion-texto strong {
        display: block;
        font-size: .8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .opcion-texto small {
        font-size: .72rem;
        opacity: .75;
        font-weight: 500;
        margin-top: .15rem;
        display: block;
    }

    .opcion-arrow {
        margin-left: auto;
        opacity: .5;
        flex-shrink: 0;
    }

    .node-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        background: rgba(16,185,129,0.12);
        border: 1px solid rgba(16,185,129,0.3);
        color: #10b981;
        border-radius: .35rem;
        padding: .15rem .5rem;
        font-size: .65rem;
        font-weight: 800;
        text-transform: uppercase;
        margin-top: .25rem;
    }

        .node-badge::before {
            content: '';
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #10b981;
            display: inline-block;
        }

    /* ── Toast ── */
    #toastError {
        display: none;
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 10000;
        background: #0d0d0d;
        border: 1px solid rgba(239,68,68,0.3);
        border-left: 4px solid #ef4444;
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        max-width: 22rem;
        box-shadow: 0 8px 25px rgba(0,0,0,0.4);
    }

        #toastError.show {
            display: block;
        }

    .toast-title {
        font-weight: 800;
        color: #ef4444;
        font-size: .82rem;
        margin-bottom: .25rem;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .toast-msg {
        font-size: .78rem;
        color: #9ca3af;
        font-weight: 500;
    }

    /* ── Spinner ── */
    .btn-spinner {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #fff;
        border-radius: 50%;
        flex-shrink: 0;
        animation: spin .7s linear infinite;
    }

    /* ── Form card ── */
    .tz-card {
        background: #0d0d0d;
        border: 1px solid rgba(34,197,94,0.15);
        border-radius: 1rem;
        padding: 2rem;
    }

    .tz-label {
        display: block;
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #6b7280;
        margin-bottom: .4rem;
    }

        .tz-label .req {
            color: #ef4444;
        }

    .tz-input {
        width: 100%;
        padding: .7rem 1rem;
        background: #111;
        border: 1px solid rgba(34,197,94,0.2);
        border-radius: .65rem;
        color: #f9fafb;
        font-weight: 600;
        font-size: .9rem;
        transition: border-color .2s, box-shadow .2s;
        box-sizing: border-box;
    }

        .tz-input::placeholder {
            color: #374151;
        }

        .tz-input:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }

        .tz-input.error {
            border-color: #ef4444;
        }

    .tz-section-title {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-size: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #f9fafb;
        padding-bottom: .85rem;
        border-bottom: 1px solid rgba(34,197,94,0.12);
        margin-bottom: 1.25rem;
    }

        .tz-section-title i {
            color: #22c55e;
        }

    .tz-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .85rem 1.5rem;
        border-radius: .65rem;
        background: linear-gradient(135deg,#22c55e,#15803d);
        color: #fff;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        border: none;
        cursor: pointer;
        transition: all .2s;
        flex: 1;
        justify-content: center;
    }

        .tz-btn-primary:hover {
            background: linear-gradient(135deg,#16a34a,#166534);
            box-shadow: 0 4px 16px rgba(34,197,94,0.3);
            transform: translateY(-1px);
        }

        .tz-btn-primary:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }

    .tz-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .85rem 1.5rem;
        border-radius: .65rem;
        background: transparent;
        border: 1px solid rgba(255,255,255,0.1);
        color: #6b7280;
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        text-decoration: none;
        transition: all .2s;
        flex: 1;
        justify-content: center;
    }

        .tz-btn-ghost:hover {
            border-color: rgba(34,197,94,0.3);
            color: #d1d5db;
        }

    .info-box {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        padding: 1rem 1.25rem;
        border-radius: .75rem;
    }

    .info-box-warn {
        background: rgba(239,68,68,0.06);
        border: 1px solid rgba(239,68,68,0.2);
    }

    .info-box-blue {
        background: rgba(59,130,246,0.06);
        border: 1px solid rgba(59,130,246,0.2);
    }

    .info-box-title {
        font-weight: 800;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        margin-bottom: .25rem;
    }

    .info-box-text {
        font-size: .78rem;
        font-weight: 500;
    }
</style>

<!-- Modal Éxito -->
<div id="modalExito">
    <div class="modal-card">
        <div class="modal-header">
            <div class="modal-checkmark">✓</div>
            <div class="modal-title">¡Cliente Creado!</div>
            <div class="modal-subtitle">El registro se guardó correctamente</div>
            <div class="modal-cliente-nombre" id="modalNombreCliente">—</div>
        </div>
        <div class="modal-body">
            <div class="modal-pregunta">
                ¿Qué deseas hacer ahora?
                <span>Puedes registrar la huella digital del cliente de inmediato</span>
            </div>
            <div class="modal-opciones">
                <a id="btnRegistrarHuella" href="#" target="_blank" class="opcion-btn opcion-huella">
                    <div class="opcion-icon">✋</div>
                    <div class="opcion-texto">
                        <strong>Registrar Huella Digital</strong>
                        <small>Abre el sistema biométrico con los datos pre-cargados</small>
                        <div class="node-badge">Sistema Node.js activo</div>
                    </div>
                    <div class="opcion-arrow">→</div>
                </a>
                <a href="/clientes" class="opcion-btn opcion-lista">
                    <div class="opcion-icon">👥</div>
                    <div class="opcion-texto">
                        <strong>Ir al Listado de Clientes</strong>
                        <small>Ver todos los clientes registrados</small>
                    </div>
                    <div class="opcion-arrow">→</div>
                </a>
                <button type="button" class="opcion-btn opcion-nuevo" onclick="resetFormulario()">
                    <div class="opcion-icon">➕</div>
                    <div class="opcion-texto">
                        <strong>Crear Otro Cliente</strong>
                        <small>Registrar un nuevo miembro</small>
                    </div>
                    <div class="opcion-arrow">↩</div>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Error -->
<div id="toastError">
    <div class="toast-title">❌ Error al crear el cliente</div>
    <div class="toast-msg" id="toastMensaje">—</div>
</div>

<!-- Formulario Principal -->
<div class="max-w-4xl mx-auto">
    <div class="tz-card">

        <!-- Header del form -->
        <div class="tz-section-title" style="font-size:1.15rem;margin-bottom:1.5rem">
            <i data-lucide="user-plus" style="width:1.25rem;height:1.25rem"></i>
            Nuevo Cliente
        </div>

        <!-- Aviso campos obligatorios -->
        <div class="info-box info-box-warn mb-6">
            <i data-lucide="alert-circle" style="width:1.1rem;height:1.1rem;color:#ef4444;margin-top:.1rem;flex-shrink:0"></i>
            <div>
                <div class="info-box-title" style="color:#ef4444">Campos Obligatorios</div>
                <p class="info-box-text" style="color:#9ca3af">
                    Solo se requieren: <strong style="color:#d1d5db">Nombre, Apellido y Cédula</strong>.
                    Todos los demás campos son opcionales.
                </p>
            </div>
        </div>

        <form id="formCrearCliente" class="space-y-6" novalidate>
            @Html.AntiForgeryToken()

            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(13rem,1fr));gap:1rem">
                <div>
                    <label class="tz-label">Nombre <span class="req">*</span></label>
                    <input id="inputNombre" name="nombre" type="text" class="tz-input" placeholder="Ingrese el nombre" required />
                    <span class="toast-title" id="errNombre" style="font-size:.72rem;display:block;margin-top:.25rem"></span>
                </div>
                <div>
                    <label class="tz-label">Apellido <span class="req">*</span></label>
                    <input id="inputApellido" name="apellido" type="text" class="tz-input" placeholder="Ingrese el apellido" required />
                    <span class="toast-title" id="errApellido" style="font-size:.72rem;display:block;margin-top:.25rem"></span>
                </div>
                <div>
                    <label class="tz-label">Cédula <span class="req">*</span></label>
                    <input id="inputCedula" name="cedula" type="text" class="tz-input" placeholder="Ej: 001-1234567-8" required style="font-family:monospace" />
                    <span class="toast-title" id="errCedula" style="font-size:.72rem;display:block;margin-top:.25rem"></span>
                </div>
                <div>
                    <label class="tz-label">Teléfono (Opcional)</label>
                    <input id="inputTelefono" name="telefono" type="tel" class="tz-input" placeholder="Ej: 809-555-1234" />
                </div>
                <div>
                    <label class="tz-label">Email (Opcional)</label>
                    <input id="inputEmail" name="email" type="email" class="tz-input" placeholder="cliente@ejemplo.com" />
                </div>
                <div>
                    <label class="tz-label">Fecha de Nacimiento (Opcional)</label>
                    <input id="inputFechaNac" name="fechaNacimiento" type="date" class="tz-input" />
                </div>
            </div>

            <div>
                <label class="tz-label">Dirección (Opcional)</label>
                <textarea id="inputDireccion" name="direccion" rows="2" class="tz-input" style="resize:vertical"
                          placeholder="Calle, número, sector, ciudad"></textarea>
            </div>

            <!-- Foto -->
            <div>
                <label class="tz-label">Foto del Cliente (Opcional)</label>
                <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
                    <div id="preview-container" style="display:none">
                        <img id="foto-preview" style="width:5rem;height:5rem;object-fit:cover;border-radius:.65rem;border:2px solid rgba(34,197,94,0.3)" />
                    </div>
                    <div>
                        <input type="file" id="fotoInput" accept="image/*"
                               style="display:block;font-size:.78rem;color:#9ca3af;background:#111;border:1px solid rgba(34,197,94,0.2);border-radius:.65rem;padding:.5rem .75rem;width:auto" />
                        <p style="font-size:.7rem;color:#4b5563;font-weight:600;margin-top:.3rem">JPG, PNG · máx. 5MB</p>
                    </div>
                </div>
                <input type="hidden" id="fotoBase64Input" />
            </div>

            <!-- Info huella -->
            <div class="info-box info-box-blue">
                <i data-lucide="fingerprint" style="width:1.1rem;height:1.1rem;color:#60a5fa;margin-top:.1rem;flex-shrink:0"></i>
                <div>
                    <div class="info-box-title" style="color:#60a5fa">Registro de Huella Digital</div>
                    <p class="info-box-text" style="color:#9ca3af">
                        Al guardar el cliente, se abrirá una ventana para registrar su huella en el
                        <strong style="color:#d1d5db">sistema biométrico</strong>. Los datos se pre-cargan automáticamente.
                    </p>
                </div>
            </div>

            <!-- Botones -->
            <div style="display:flex;gap:.75rem;padding-top:1.25rem;border-top:1px solid rgba(34,197,94,0.1)">
                <button type="submit" id="btnGuardar" class="tz-btn-primary">
                    <i data-lucide="save" style="width:.9rem;height:.9rem" id="iconGuardar"></i>
                    <span id="textoGuardar">Crear Cliente</span>
                </button>
                <a href="/clientes" class="tz-btn-ghost">
                    <i data-lucide="x" style="width:.9rem;height:.9rem"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        const NODE_URL = 'http://localhost:3000';

        // Foto preview
        const fotoInput = document.getElementById('fotoInput');
        const fotoBase64Input = document.getElementById('fotoBase64Input');
        const preview = document.getElementById('foto-preview');
        const previewContainer = document.getElementById('preview-container');

        fotoInput.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) { previewContainer.style.display = 'none'; fotoBase64Input.value = ''; return; }
            if (file.size > 5 * 1024 * 1024) { mostrarToastError('La imagen es muy grande. El tamaño máximo es 5MB.'); fotoInput.value = ''; return; }
            const reader = new FileReader();
            reader.onload = function (e) {
                const base64 = e.target.result;
                fotoBase64Input.value = base64;
                preview.src = base64;
                previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(file);
        });

        // Validación
        function validarFormulario() {
            let ok = true;
            const campos = [
                { id: 'inputNombre',   err: 'errNombre',   msg: 'El nombre es obligatorio.' },
                { id: 'inputApellido', err: 'errApellido', msg: 'El apellido es obligatorio.' },
                { id: 'inputCedula',   err: 'errCedula',   msg: 'La cédula es obligatoria.' },
            ];
            campos.forEach(c => {
                const input = document.getElementById(c.id);
                const errEl = document.getElementById(c.err);
                if (!input.value.trim()) {
                    errEl.textContent = c.msg;
                    input.classList.add('error');
                    ok = false;
                } else {
                    errEl.textContent = '';
                    input.classList.remove('error');
                }
            });
            return ok;
        }

        // Submit
        document.getElementById('formCrearCliente').addEventListener('submit', async function (e) {
            e.preventDefault();
            if (!validarFormulario()) return;
            setBtnLoading(true);

            const payload = {
                nombre:          document.getElementById('inputNombre').value.trim(),
                apellido:        document.getElementById('inputApellido').value.trim(),
                cedula:          document.getElementById('inputCedula').value.trim(),
                telefono:        document.getElementById('inputTelefono').value.trim() || null,
                email:           document.getElementById('inputEmail').value.trim() || null,
                fechaNacimiento: document.getElementById('inputFechaNac').value || null,
                direccion:       document.getElementById('inputDireccion').value.trim() || null,
                fotoBase64:      document.getElementById('fotoBase64Input').value || null,
                activo:          true
            };

            try {
                const response = await fetch('/api/clientes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (response.status === 400) {
                    const txt = await response.text();
                    mostrarToastError(txt || 'Ya existe un cliente con esa cédula.');
                    setBtnLoading(false); return;
                }
                if (!response.ok) throw new Error(`Error del servidor: ${response.status}`);
                const cliente = await response.json();
                mostrarModalExito(cliente);
            } catch (err) {
                mostrarToastError(err.message || 'Error inesperado. Intenta de nuevo.');
            } finally {
                setBtnLoading(false);
            }
        });

        function mostrarModalExito(cliente) {
            const nombre = `${cliente.Nombre || cliente.nombre} ${cliente.Apellido || cliente.apellido}`;
            const cedula = cliente.Cedula || cliente.cedula;
            document.getElementById('modalNombreCliente').textContent = nombre;
            const nodeUrl = `${NODE_URL}/register?cedula=${encodeURIComponent(cedula)}&nombre=${encodeURIComponent(nombre)}`;
            document.getElementById('btnRegistrarHuella').href = nodeUrl;
            document.getElementById('modalExito').classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function cerrarModal() {
            document.getElementById('modalExito').classList.remove('show');
            document.body.style.overflow = '';
        }

        document.getElementById('modalExito').addEventListener('click', function (e) {
            if (e.target === this) cerrarModal();
        });

        function resetFormulario() {
            cerrarModal();
            document.getElementById('formCrearCliente').reset();
            fotoBase64Input.value = '';
            previewContainer.style.display = 'none';
            ['errNombre','errApellido','errCedula'].forEach(id => document.getElementById(id).textContent = '');
            ['inputNombre','inputApellido','inputCedula'].forEach(id => document.getElementById(id).classList.remove('error'));
            document.getElementById('inputNombre').focus();
        }

        function setBtnLoading(loading) {
            const btn   = document.getElementById('btnGuardar');
            const texto = document.getElementById('textoGuardar');
            btn.disabled = loading;
            if (loading) {
                document.getElementById('iconGuardar').outerHTML = '<div class="btn-spinner" id="iconGuardar"></div>';
                texto.textContent = 'Guardando...';
            } else {
                const spinner = document.getElementById('iconGuardar');
                if (spinner) { spinner.outerHTML = '<i data-lucide="save" style="width:.9rem;height:.9rem" id="iconGuardar"></i>'; lucide.createIcons(); }
                texto.textContent = 'Crear Cliente';
            }
        }

        let toastTimer = null;
        function mostrarToastError(msg) {
            document.getElementById('toastMensaje').textContent = msg;
            const toast = document.getElementById('toastError');
            toast.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove('show'), 5000);
        }

        ['inputNombre','inputApellido','inputCedula'].forEach(id => {
            document.getElementById(id).addEventListener('input', function () { this.classList.remove('error'); });
        });

        lucide.createIcons();
    </script>
}

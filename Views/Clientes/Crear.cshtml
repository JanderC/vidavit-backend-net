@model VidaFitBackend.Models.Cliente
@{
    ViewData["Title"] = "Crear Cliente";
    ViewData["Subtitle"] = "Registrar nuevo miembro en POWER FITNESS";
    Layout = "_AdminLayout";
}

<style>
    /* ── Field base ── */
    .pf-input {
        width: 100%;
        padding: 13px 16px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(30,111,227,0.2);
        border-radius: 12px;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .pf-input::placeholder { color: rgba(255,255,255,0.2); }
    .pf-input:focus {
        border-color: #1E6FE3;
        box-shadow: 0 0 0 3px rgba(30,111,227,0.15);
    }
    .pf-input.error { border-color: #F87171; }

    .pf-label {
        display: block;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        margin-bottom: 8px;
    }

    /* ── Modal ── */
    #modalExito {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0,0,0,0.7);
        backdrop-filter: blur(6px);
        align-items: center;
        justify-content: center;
    }
    #modalExito.show { display: flex; }

    .modal-card {
        background: #0D0D20;
        border: 1px solid rgba(30,111,227,0.25);
        border-radius: 20px;
        width: 100%;
        max-width: 500px;
        margin: 16px;
        box-shadow: 0 32px 80px rgba(0,0,0,0.6);
        overflow: hidden;
    }

    .modal-header {
        background: linear-gradient(135deg, #1E6FE3, #6B3FA0);
        padding: 28px 32px 24px;
        text-align: center;
    }

    .modal-checkmark {
        width: 60px; height: 60px;
        background: rgba(255,255,255,0.15);
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 14px;
        font-size: 26px;
    }

    .opcion-btn {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px 18px;
        border-radius: 12px;
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s;
        text-align: left;
        width: 100%;
        font-family: 'Inter', sans-serif;
    }
    .opcion-btn:hover { transform: translateY(-1px); }

    .opcion-huella {
        background: linear-gradient(135deg, #1E6FE3, #6B3FA0);
        color: #fff;
    }
    .opcion-huella:hover { opacity: 0.9; box-shadow: 0 6px 20px rgba(30,111,227,0.35); color:#fff; }

    .opcion-lista {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.7);
    }
    .opcion-lista:hover { background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.15); color:#fff; }

    .opcion-nuevo {
        background: transparent;
        border-color: rgba(255,255,255,0.06);
        color: rgba(255,255,255,0.4);
    }
    .opcion-nuevo:hover { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.7); }

    .opcion-icon {
        width: 42px; height: 42px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }
    .opcion-huella .opcion-icon { background: rgba(255,255,255,0.15); }
    .opcion-lista  .opcion-icon { background: rgba(255,255,255,0.06); }
    .opcion-nuevo  .opcion-icon { background: rgba(255,255,255,0.04); }

    .opcion-texto strong {
        display: block;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .opcion-texto small { font-size: 0.72rem; opacity: 0.65; }
    .opcion-arrow { margin-left: auto; font-size: 16px; opacity: 0.5; flex-shrink: 0; }

    /* Node badge */
    .node-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(16,185,129,0.12);
        border: 1px solid rgba(16,185,129,0.25);
        color: #10B981;
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin-top: 4px;
    }
    .node-badge::before {
        content: '';
        width: 5px; height: 5px;
        border-radius: 50%;
        background: #10B981;
        display: inline-block;
    }

    /* Toast */
    #toastError {
        display: none;
        position: fixed;
        top: 24px; right: 24px;
        z-index: 10000;
        background: #0D0D20;
        border: 1px solid rgba(248,113,113,0.3);
        border-left: 4px solid #F87171;
        border-radius: 12px;
        padding: 16px 20px;
        max-width: 360px;
        box-shadow: 0 12px 32px rgba(0,0,0,0.5);
    }
    #toastError.show { display: block; }

    /* Spinner */
    .btn-spinner {
        display: inline-block;
        width: 15px; height: 15px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        flex-shrink: 0;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

<!-- Modal éxito -->
<div id="modalExito">
    <div class="modal-card">
        <div class="modal-header">
            <div class="modal-checkmark">✓</div>
            <div style="font-size:1.2rem;font-weight:900;color:#fff;letter-spacing:1px;text-transform:uppercase;">¡Cliente Creado!</div>
            <div style="font-size:0.8rem;color:rgba(255,255,255,0.65);margin-top:4px;font-weight:600;">El registro se guardó correctamente</div>
            <div id="modalNombreCliente"
                 style="display:inline-block;margin-top:12px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);border-radius:8px;padding:6px 18px;color:#fff;font-weight:800;font-size:0.95rem;">—</div>
        </div>
        <div style="padding:24px 28px;">
            <p style="text-align:center;font-size:0.85rem;font-weight:700;color:rgba(255,255,255,0.6);margin:0 0 18px 0;">
                ¿Qué deseas hacer ahora?
                <span style="display:block;font-size:0.75rem;color:rgba(255,255,255,0.35);font-weight:500;margin-top:3px;">
                    Puedes registrar la huella digital del cliente de inmediato
                </span>
            </p>
            <div style="display:flex;flex-direction:column;gap:10px;">
                <a id="btnRegistrarHuella" href="#" target="_blank" class="opcion-btn opcion-huella">
                    <div class="opcion-icon">✋</div>
                    <div class="opcion-texto">
                        <strong>Registrar Huella Digital</strong>
                        <small>Abre el sistema biométrico con los datos pre-cargados</small>
                        <div class="node-badge">Sistema Node.js activo</div>
                    </div>
                    <div class="opcion-arrow">→</div>
                </a>
                <a href="/clientes" class="opcion-btn opcion-lista">
                    <div class="opcion-icon">👥</div>
                    <div class="opcion-texto">
                        <strong>Ir al Listado de Clientes</strong>
                        <small>Ver todos los clientes registrados</small>
                    </div>
                    <div class="opcion-arrow">→</div>
                </a>
                <button type="button" class="opcion-btn opcion-nuevo" onclick="resetFormulario()">
                    <div class="opcion-icon">➕</div>
                    <div class="opcion-texto">
                        <strong>Crear Otro Cliente</strong>
                        <small>Registrar un nuevo miembro</small>
                    </div>
                    <div class="opcion-arrow">↩</div>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast error -->
<div id="toastError">
    <div style="font-weight:800;color:#F87171;font-size:0.85rem;margin-bottom:4px;">❌ Error al crear el cliente</div>
    <div style="font-size:0.8rem;color:rgba(255,255,255,0.6);font-weight:500;" id="toastMensaje">—</div>
</div>

<!-- Formulario -->
<div style="max-width:860px;margin:0 auto;">
    <div style="background:#0D0D20;border:1px solid rgba(30,111,227,0.15);border-radius:16px;padding:32px;">

        <!-- Header -->
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:28px;padding-bottom:24px;border-bottom:1px solid rgba(30,111,227,0.12);">
            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i data-lucide="user-plus" style="width:24px;height:24px;color:#fff;"></i>
            </div>
            <div>
                <h2 style="font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:3px;color:#fff;margin:0;line-height:1;">Nuevo Cliente</h2>
                <p style="font-size:0.78rem;color:rgba(255,255,255,0.35);margin:4px 0 0 0;font-weight:600;">
                    Complete el formulario. Al guardar podrás registrar la huella digital del cliente.
                </p>
            </div>
        </div>

        <!-- Info banner -->
        <div style="background:rgba(30,111,227,0.06);border:1px solid rgba(30,111,227,0.18);border-left:3px solid #1E6FE3;border-radius:10px;padding:14px 18px;margin-bottom:24px;display:flex;align-items:flex-start;gap:12px;">
            <i data-lucide="alert-circle" style="width:18px;height:18px;color:#3D8EFF;flex-shrink:0;margin-top:1px;"></i>
            <div>
                <p style="font-size:0.72rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:#3D8EFF;margin:0 0 3px 0;">Campos Obligatorios</p>
                <p style="font-size:0.8rem;color:rgba(255,255,255,0.5);font-weight:600;margin:0;">
                    Solo se requieren: <strong style="color:rgba(255,255,255,0.8);">Nombre, Apellido y Cédula</strong>. Todos los demás son opcionales.
                </p>
            </div>
        </div>

        <form id="formCrearCliente" novalidate>
            @Html.AntiForgeryToken()

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">

                <div>
                    <label class="pf-label">Nombre <span style="color:#F87171;">*</span></label>
                    <input id="inputNombre" name="nombre" type="text" class="pf-input" placeholder="Ingrese el nombre" required />
                    <span style="font-size:0.72rem;color:#F87171;font-weight:700;margin-top:4px;display:block;" id="errNombre"></span>
                </div>

                <div>
                    <label class="pf-label">Apellido <span style="color:#F87171;">*</span></label>
                    <input id="inputApellido" name="apellido" type="text" class="pf-input" placeholder="Ingrese el apellido" required />
                    <span style="font-size:0.72rem;color:#F87171;font-weight:700;margin-top:4px;display:block;" id="errApellido"></span>
                </div>

                <div>
                    <label class="pf-label">Cédula <span style="color:#F87171;">*</span></label>
                    <input id="inputCedula" name="cedula" type="text" class="pf-input" placeholder="Ej: 001-1234567-8" required />
                    <span style="font-size:0.72rem;color:#F87171;font-weight:700;margin-top:4px;display:block;" id="errCedula"></span>
                </div>

                <div>
                    <label class="pf-label">Teléfono (Opcional)</label>
                    <input id="inputTelefono" name="telefono" type="tel" class="pf-input" placeholder="Ej: 809-555-1234" />
                </div>

                <div>
                    <label class="pf-label">Email (Opcional)</label>
                    <input id="inputEmail" name="email" type="email" class="pf-input" placeholder="cliente@ejemplo.com" />
                </div>

                <div>
                    <label class="pf-label">Fecha de Nacimiento (Opcional)</label>
                    <input id="inputFechaNac" name="fechaNacimiento" type="date" class="pf-input" />
                </div>
            </div>

            <div style="margin-top:20px;">
                <label class="pf-label">Dirección (Opcional)</label>
                <textarea id="inputDireccion" name="direccion" rows="2" class="pf-input" placeholder="Calle, número, sector, ciudad"></textarea>
            </div>

            <!-- Foto -->
            <div style="margin-top:20px;">
                <label class="pf-label">Foto del Cliente (Opcional)</label>
                <div style="display:flex;align-items:center;gap:16px;">
                    <div id="preview-container" style="display:none;">
                        <img id="foto-preview" style="width:100px;height:100px;object-fit:cover;border-radius:12px;border:2px solid rgba(30,111,227,0.3);" />
                    </div>
                    <div style="flex:1;">
                        <input type="file" id="fotoInput" accept="image/*"
                               style="width:100%;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(30,111,227,0.2);border-radius:12px;color:rgba(255,255,255,0.5);font-size:0.82rem;font-family:'Inter',sans-serif;" />
                        <p style="font-size:0.7rem;color:rgba(255,255,255,0.25);margin:6px 0 0 0;font-weight:600;">Formatos: JPG, PNG (máx. 5MB)</p>
                    </div>
                </div>
                <input type="hidden" id="fotoBase64Input" />
            </div>

            <!-- Info huella -->
            <div style="margin-top:20px;background:rgba(107,63,160,0.06);border:1px solid rgba(107,63,160,0.2);border-left:3px solid #6B3FA0;border-radius:10px;padding:14px 18px;display:flex;align-items:flex-start;gap:12px;">
                <i data-lucide="fingerprint" style="width:18px;height:18px;color:#a78bfa;flex-shrink:0;margin-top:1px;"></i>
                <div>
                    <p style="font-size:0.72rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:#a78bfa;margin:0 0 3px 0;">Registro de Huella Digital</p>
                    <p style="font-size:0.8rem;color:rgba(255,255,255,0.45);font-weight:600;margin:0;">
                        Al guardar el cliente, se abrirá una ventana para registrar su huella en el
                        <strong style="color:rgba(255,255,255,0.7);">sistema biométrico</strong>. Los datos se pre-cargan automáticamente.
                    </p>
                </div>
            </div>

            <!-- Botones -->
            <div style="display:flex;gap:12px;margin-top:28px;padding-top:24px;border-top:1px solid rgba(30,111,227,0.12);">
                <button type="submit" id="btnGuardar"
                        style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);color:#fff;font-weight:800;font-size:0.85rem;letter-spacing:1.5px;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer;transition:opacity 0.2s,transform 0.2s;"
                        onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.02)'"
                        onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
                    <i data-lucide="save" style="width:18px;height:18px;" id="iconGuardar"></i>
                    <span id="textoGuardar">Crear Cliente</span>
                </button>
                <a href="/clientes"
                   style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.5);font-weight:800;font-size:0.85rem;letter-spacing:1.5px;text-transform:uppercase;border:1px solid rgba(255,255,255,0.08);border-radius:12px;text-decoration:none;transition:background 0.15s,color 0.15s;"
                   onmouseover="this.style.background='rgba(255,255,255,0.08)';this.style.color='rgba(255,255,255,0.8)'"
                   onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.color='rgba(255,255,255,0.5)'">
                    <i data-lucide="x" style="width:18px;height:18px;"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
        const NODE_URL = 'http://localhost:3000';

        const fotoInput         = document.getElementById('fotoInput');
        const fotoBase64Input   = document.getElementById('fotoBase64Input');
        const preview           = document.getElementById('foto-preview');
        const previewContainer  = document.getElementById('preview-container');

        fotoInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) { previewContainer.style.display = 'none'; fotoBase64Input.value = ''; return; }
            if (file.size > 5 * 1024 * 1024) {
                mostrarToastError('La imagen es muy grande. El tamaño máximo es 5MB.');
                fotoInput.value = ''; return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                fotoBase64Input.value = e.target.result;
                preview.src = e.target.result;
                previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(file);
        });

        function validarFormulario() {
            let ok = true;
            const campos = [
                { id: 'inputNombre',   err: 'errNombre',   msg: 'El nombre es obligatorio.' },
                { id: 'inputApellido', err: 'errApellido', msg: 'El apellido es obligatorio.' },
                { id: 'inputCedula',   err: 'errCedula',   msg: 'La cédula es obligatoria.' },
            ];
            campos.forEach(c => {
                const input = document.getElementById(c.id);
                const errEl = document.getElementById(c.err);
                if (!input.value.trim()) {
                    errEl.textContent = c.msg;
                    input.classList.add('error');
                    ok = false;
                } else {
                    errEl.textContent = '';
                    input.classList.remove('error');
                }
            });
            return ok;
        }

        document.getElementById('formCrearCliente').addEventListener('submit', async function(e) {
            e.preventDefault();
            if (!validarFormulario()) return;
            setBtnLoading(true);
            const payload = {
                nombre:          document.getElementById('inputNombre').value.trim(),
                apellido:        document.getElementById('inputApellido').value.trim(),
                cedula:          document.getElementById('inputCedula').value.trim(),
                telefono:        document.getElementById('inputTelefono').value.trim() || null,
                email:           document.getElementById('inputEmail').value.trim() || null,
                fechaNacimiento: document.getElementById('inputFechaNac').value || null,
                direccion:       document.getElementById('inputDireccion').value.trim() || null,
                fotoBase64:      document.getElementById('fotoBase64Input').value || null,
                activo:          true
            };
            try {
                const response = await fetch('/api/clientes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (response.status === 400) {
                    const txt = await response.text();
                    mostrarToastError(txt || 'Ya existe un cliente con esa cédula.');
                    setBtnLoading(false); return;
                }
                if (!response.ok) throw new Error(`Error del servidor: ${response.status}`);
                const cliente = await response.json();
                mostrarModalExito(cliente);
            } catch (err) {
                console.error('Error al crear cliente:', err);
                mostrarToastError(err.message || 'Error inesperado. Intenta de nuevo.');
            } finally {
                setBtnLoading(false);
            }
        });

        function mostrarModalExito(cliente) {
            const nombre = `${cliente.Nombre || cliente.nombre} ${cliente.Apellido || cliente.apellido}`;
            const cedula = cliente.Cedula || cliente.cedula;
            document.getElementById('modalNombreCliente').textContent = nombre;
            const nodeUrl = `${NODE_URL}/register?cedula=${encodeURIComponent(cedula)}&nombre=${encodeURIComponent(nombre)}`;
            document.getElementById('btnRegistrarHuella').href = nodeUrl;
            document.getElementById('modalExito').classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function cerrarModal() {
            document.getElementById('modalExito').classList.remove('show');
            document.body.style.overflow = '';
        }

        document.getElementById('modalExito').addEventListener('click', function(e) {
            if (e.target === this) cerrarModal();
        });

        function resetFormulario() {
            cerrarModal();
            document.getElementById('formCrearCliente').reset();
            fotoBase64Input.value = '';
            previewContainer.style.display = 'none';
            ['errNombre','errApellido','errCedula'].forEach(id => { document.getElementById(id).textContent = ''; });
            ['inputNombre','inputApellido','inputCedula'].forEach(id => { document.getElementById(id).classList.remove('error'); });
            document.getElementById('inputNombre').focus();
        }

        function setBtnLoading(loading) {
            const btn   = document.getElementById('btnGuardar');
            const icono = document.getElementById('iconGuardar');
            const texto = document.getElementById('textoGuardar');
            btn.disabled = loading;
            if (loading) {
                icono.outerHTML = '<div class="btn-spinner" id="iconGuardar"></div>';
                texto.textContent = 'Guardando...';
            } else {
                const spinnerEl = document.getElementById('iconGuardar');
                if (spinnerEl) { spinnerEl.outerHTML = '<i data-lucide="save" style="width:18px;height:18px;" id="iconGuardar"></i>'; lucide.createIcons(); }
                texto.textContent = 'Crear Cliente';
            }
        }

        let toastTimer = null;
        function mostrarToastError(msg) {
            document.getElementById('toastMensaje').textContent = msg;
            const toast = document.getElementById('toastError');
            toast.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove('show'), 5000);
        }

        ['inputNombre','inputApellido','inputCedula'].forEach(id => {
            document.getElementById(id).addEventListener('input', function() { this.classList.remove('error'); });
        });
    </script>
}

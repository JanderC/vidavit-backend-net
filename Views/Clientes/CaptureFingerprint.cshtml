@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Capturar Huella";
    ViewData["Subtitle"] = $"Registrar huella de {ViewBag.ClienteNombre}";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-gray-200">
        <div id="reader-status" class="mb-6 p-5 rounded-xl border-2">
            <div class="flex items-center gap-3">
                <div id="status-icon" class="w-14 h-14 rounded-full flex items-center justify-center">
                    <i data-lucide="loader" class="w-7 h-7 animate-spin"></i>
                </div>
                <div class="flex-1">
                    <p id="status-title" class="font-bold text-lg">Verificando lector...</p>
                    <p id="status-message" class="text-sm text-gray-600 font-semibold">Espera un momento</p>
                </div>
            </div>
        </div>

        <div id="instrucciones" class="hidden mb-6 bg-blue-50 rounded-xl p-5 border-2 border-blue-300">
            <h3 class="font-black text-blue-900 mb-3 flex items-center gap-2 uppercase tracking-wide">
                <i data-lucide="info" class="w-5 h-5 text-blue-600"></i>
                Instrucciones Importantes
            </h3>
            <ol class="list-decimal list-inside space-y-2 text-sm text-blue-900 font-semibold">
                <li>Limpia y seca bien tu dedo antes de comenzar</li>
                <li>Coloca el dedo firmemente en el centro del sensor</li>
                <li>Mantén el dedo quieto durante toda la captura</li>
                <li>No presiones demasiado fuerte</li>
                <li>El proceso tomará 3 capturas para mayor precisión</li>
            </ol>
        </div>

        <div id="capture-area" class="hidden text-center py-12">
            <div class="mb-8 flex justify-center">
                <div class="relative">
                    <div class="absolute inset-0 bg-red-600 rounded-full blur-3xl opacity-30 animate-pulse"></div>
                    <div class="relative bg-gradient-to-br from-red-600 to-red-800 p-12 rounded-full shadow-2xl">
                        <i data-lucide="fingerprint" class="w-32 h-32 text-white" stroke-width="1.5"></i>
                    </div>
                </div>
            </div>

            <h3 class="text-3xl font-black text-gray-800 mb-3 uppercase tracking-wide">Coloca tu dedo en el sensor</h3>
            <p class="text-gray-600 mb-2">Cliente: <span class="font-black text-red-600">@ViewBag.ClienteNombre</span></p>
            <p class="text-sm text-gray-500 mb-10 font-semibold">El lector está listo para capturar tu huella</p>

            <button id="btn-capture" onclick="captureFingerprint()"
                    class="px-10 py-4 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all shadow-2xl hover:shadow-3xl inline-flex items-center gap-3 text-xl uppercase tracking-wide transform hover:scale-105">
                <i data-lucide="scan" class="w-6 h-6"></i>
                Iniciar Captura
            </button>
        </div>

        <div id="loading-area" class="hidden text-center py-12">
            <div class="mb-8 flex justify-center">
                <div class="relative">
                    <div class="absolute inset-0 bg-blue-600 rounded-full blur-3xl opacity-50 animate-pulse"></div>
                    <div class="relative bg-gradient-to-br from-blue-600 to-cyan-600 p-12 rounded-full">
                        <i data-lucide="fingerprint" class="w-28 h-28 text-white animate-pulse" stroke-width="1.5"></i>
                    </div>
                </div>
            </div>

            <h3 class="text-3xl font-black text-gray-800 mb-4 uppercase tracking-wide" id="loading-title">Procesando huella...</h3>
            <p class="text-gray-600 mb-8 font-bold text-lg" id="loading-message">No muevas el dedo</p>

            <div class="max-w-md mx-auto bg-gray-200 rounded-full h-4 mb-3 shadow-inner">
                <div id="progress-bar" class="bg-gradient-to-r from-blue-600 to-cyan-600 h-4 rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>
            <p class="text-sm text-gray-500 font-bold" id="progress-text">Captura 0 de 3</p>
        </div>

        <div id="result-area" class="hidden text-center py-8">
            <div id="result-icon" class="mb-8 flex justify-center"></div>
            <h3 id="result-title" class="text-4xl font-black mb-4"></h3>
            <p id="result-message" class="text-gray-600 mb-10 text-lg font-semibold"></p>

            <div class="flex justify-center gap-3">
                <button onclick="window.location.href='/clientes'"
                        class="px-8 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-xl transition-colors inline-flex items-center gap-2 font-bold uppercase tracking-wide">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                    Volver a Clientes
                </button>
                <button id="btn-retry" onclick="location.reload()"
                        class="hidden px-8 py-3 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white font-black rounded-xl transition-all inline-flex items-center gap-2 uppercase tracking-wide">
                    <i data-lucide="refresh-cw" class="w-5 h-5"></i>
                    Intentar Nuevamente
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        const clienteId = '@ViewBag.ClienteId';
        let readerConnected = false;

        window.addEventListener('load', async function() {
            await checkReaderStatus();
        });

        async function checkReaderStatus() {
            try {
                const response = await fetch(`${API_URL}/Fingerprint/status`);
                const data = await response.json();

                readerConnected = data.connected;

                const statusDiv = document.getElementById('reader-status');
                const statusIcon = document.getElementById('status-icon');
                const statusTitle = document.getElementById('status-title');
                const statusMessage = document.getElementById('status-message');

                if (data.connected) {
                    statusDiv.className = 'mb-6 p-5 rounded-xl border-2 border-emerald-500 bg-emerald-50';
                    statusIcon.className = 'w-14 h-14 rounded-full flex items-center justify-center bg-emerald-500';
                    statusIcon.innerHTML = '<i data-lucide="check-circle" class="w-7 h-7 text-white"></i>';
                    statusTitle.textContent = '✓ Lector Conectado';
                    statusMessage.textContent = 'U.are.U 4500 detectado y listo';

                    document.getElementById('instrucciones').classList.remove('hidden');
                    document.getElementById('capture-area').classList.remove('hidden');
                } else {
                    statusDiv.className = 'mb-6 p-5 rounded-xl border-2 border-red-500 bg-red-50';
                    statusIcon.className = 'w-14 h-14 rounded-full flex items-center justify-center bg-red-500';
                    statusIcon.innerHTML = '<i data-lucide="x-circle" class="w-7 h-7 text-white"></i>';
                    statusTitle.textContent = '✗ Lector No Conectado';
                    statusMessage.textContent = 'Verifica la conexión USB del lector U.are.U 4500';
                }

                lucide.createIcons();
            } catch (error) {
                console.error('Error verificando lector:', error);
            }
        }

        async function captureFingerprint() {
            if (!readerConnected) {
                alert('El lector de huellas no está conectado');
                return;
            }

            document.getElementById('capture-area').classList.add('hidden');
            document.getElementById('loading-area').classList.remove('hidden');

            simulateProgress();

            try {
                const response = await fetch(`${API_URL}/Fingerprint/capture/${clienteId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await response.json();

                document.getElementById('loading-area').classList.add('hidden');
                document.getElementById('result-area').classList.remove('hidden');

                const resultIcon = document.getElementById('result-icon');
                const resultTitle = document.getElementById('result-title');
                const resultMessage = document.getElementById('result-message');

                if (data.success) {
                    resultIcon.innerHTML = `
                        <div class="relative">
                            <div class="absolute inset-0 bg-emerald-500 rounded-full blur-3xl opacity-30"></div>
                            <div class="relative w-40 h-40 bg-gradient-to-br from-emerald-500 to-emerald-700 rounded-full flex items-center justify-center shadow-2xl">
                                <i data-lucide="check" class="w-24 h-24 text-white" stroke-width="2"></i>
                            </div>
                        </div>
                    `;
                    resultTitle.textContent = '¡HUELLA CAPTURADA!';
                    resultTitle.className = 'text-4xl font-black mb-4 text-emerald-700 uppercase tracking-wide';
                    resultMessage.textContent = 'La huella digital se registró correctamente. El cliente ya puede usar el sistema de check-in biométrico.';
                } else {
                    resultIcon.innerHTML = `
                        <div class="relative">
                            <div class="absolute inset-0 bg-red-500 rounded-full blur-3xl opacity-30"></div>
                            <div class="relative w-40 h-40 bg-gradient-to-br from-red-500 to-red-700 rounded-full flex items-center justify-center shadow-2xl">
                                <i data-lucide="alert-circle" class="w-24 h-24 text-white" stroke-width="2"></i>
                            </div>
                        </div>
                    `;
                    resultTitle.textContent = 'ERROR AL CAPTURAR';
                    resultTitle.className = 'text-4xl font-black mb-4 text-red-700 uppercase tracking-wide';
                    resultMessage.textContent = data.message || 'No se pudo capturar la huella. Por favor intenta nuevamente.';
                    document.getElementById('btn-retry').classList.remove('hidden');
                }

                lucide.createIcons();
            } catch (error) {
                document.getElementById('loading-area').classList.add('hidden');
                document.getElementById('result-area').classList.remove('hidden');

                const resultIcon = document.getElementById('result-icon');
                const resultTitle = document.getElementById('result-title');
                const resultMessage = document.getElementById('result-message');

                resultIcon.innerHTML = `
                    <div class="relative">
                        <div class="absolute inset-0 bg-red-500 rounded-full blur-3xl opacity-30"></div>
                        <div class="relative w-40 h-40 bg-gradient-to-br from-red-500 to-red-700 rounded-full flex items-center justify-center shadow-2xl">
                            <i data-lucide="x" class="w-24 h-24 text-white" stroke-width="2"></i>
                        </div>
                    </div>
                `;
                resultTitle.textContent = 'ERROR DE CONEXIÓN';
                resultTitle.className = 'text-4xl font-black mb-4 text-red-700 uppercase tracking-wide';
                resultMessage.textContent = 'No se pudo conectar con el servidor. Verifica tu conexión e intenta nuevamente.';
                document.getElementById('btn-retry').classList.remove('hidden');

                lucide.createIcons();
            }
        }

        function simulateProgress() {
            let progress = 0;
            const progressBar = document.getElementById('progress-bar');
            const progressText = document.getElementById('progress-text');
            const loadingTitle = document.getElementById('loading-title');
            const loadingMessage = document.getElementById('loading-message');

            const interval = setInterval(() => {
                progress += 10;
                progressBar.style.width = progress + '%';

                if (progress === 33) {
                    progressText.textContent = 'Captura 1 de 3';
                    loadingMessage.textContent = 'Primera captura completada';
                } else if (progress === 66) {
                    progressText.textContent = 'Captura 2 de 3';
                    loadingMessage.textContent = 'Segunda captura completada';
                } else if (progress === 100) {
                    progressText.textContent = 'Captura 3 de 3';
                    loadingTitle.textContent = 'FINALIZANDO REGISTRO...';
                    loadingMessage.textContent = 'Procesando datos biométricos';
                    clearInterval(interval);
                }
            }, 800);
        }

        lucide.createIcons();
    </script>
}

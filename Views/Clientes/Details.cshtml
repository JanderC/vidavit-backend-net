@model VidaFitBackend.Models.Cliente
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"{Model.Nombre} {Model.Apellido}";
    ViewData["Subtitle"] = "Información detallada del cliente";
}

<div class="space-y-6">
    <!-- Header con acciones -->
    <div class="flex items-center justify-between">
        <a href="/clientes" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-800">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Volver a Clientes
        </a>

        <div class="flex gap-2">
            <a href="/clientes/edit/@Model.Id"
               class="px-4 py-2 bg-yellow-500 hover:bg-yellow-600 text-white rounded-lg transition-colors inline-flex items-center gap-2">
                <i data-lucide="edit" class="w-4 h-4"></i>
                Editar
            </a>
        </div>
    </div>

    <!-- Información Principal -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-start gap-6">
            <!-- Foto -->
            <div class="flex-shrink-0">
                @if (!string.IsNullOrEmpty(Model.FotoBase64))
                {
                    <img src="data:image/jpeg;base64,@Model.FotoBase64"
                         class="w-32 h-32 rounded-lg object-cover border-2 border-gray-300" alt="@Model.Nombre">
                }
                else
                {
                    <div class="w-32 h-32 rounded-lg bg-gray-100 border-2 border-gray-300 flex items-center justify-center">
                        <i data-lucide="user" class="w-16 h-16 text-gray-400"></i>
                    </div>
                }
            </div>

            <!-- Información -->
            <div class="flex-1">
                <h2 class="text-3xl font-bold text-gray-800 mb-2">@Model.Nombre @Model.Apellido</h2>

                <div class="grid grid-cols-2 gap-4 mt-4">
                    <div>
                        <p class="text-sm text-gray-500">Cédula</p>
                        <p class="font-semibold">@Model.Cedula</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Teléfono</p>
                        <p class="font-semibold">@Model.Telefono</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div>
                            <p class="text-sm text-gray-500">Email</p>
                            <p class="font-semibold">@Model.Email</p>
                        </div>
                    }
                    @if (Model.FechaNacimiento.HasValue)
                    {
                        <div>
                            <p class="text-sm text-gray-500">Fecha de Nacimiento</p>
                            <p class="font-semibold">@Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")</p>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Direccion))
                {
                    <div class="mt-4">
                        <p class="text-sm text-gray-500">Dirección</p>
                        <p class="font-semibold">@Model.Direccion</p>
                    </div>
                }

                <div class="mt-4">
                    @if (Model.Activo)
                    {
                        <span class="px-3 py-1 bg-green-100 text-green-800 text-sm font-semibold rounded-full">
                            <i data-lucide="check-circle" class="w-3 h-3 inline"></i> Activo
                        </span>
                    }
                    else
                    {
                        <span class="px-3 py-1 bg-red-100 text-red-800 text-sm font-semibold rounded-full">
                            <i data-lucide="x-circle" class="w-3 h-3 inline"></i> Inactivo
                        </span>
                    }

                    @if (!string.IsNullOrEmpty(Model.HuellaTemplate))
                    {
                        <span class="ml-2 px-3 py-1 bg-purple-100 text-purple-800 text-sm font-semibold rounded-full">
                            <i data-lucide="fingerprint" class="w-3 h-3 inline"></i> Con Huella
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Membresías -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                <i data-lucide="credit-card" class="w-5 h-5 text-vida-primary"></i>
                Membresías
            </h3>
            <button onclick="window.location.href='/membresias/create?clienteId=@Model.Id'"
                    class="px-4 py-2 bg-vida-primary hover:bg-vida-accent text-vida-dark font-semibold rounded-lg transition-all inline-flex items-center gap-2">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Nueva Membresía
            </button>
        </div>

        <div id="membresias-list" class="space-y-3">
            <div class="text-center py-8 text-gray-500">
                <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                <p>Cargando membresías...</p>
            </div>
        </div>
    </div>

    <!-- Historial de Check-ins -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
            <i data-lucide="history" class="w-5 h-5 text-vida-primary"></i>
            Historial de Check-ins
        </h3>

        <div id="checkins-list" class="space-y-2">
            <div class="text-center py-8 text-gray-500">
                <i data-lucide="loader" class="w-8 h-8 mx-auto mb-2 animate-spin"></i>
                <p>Cargando historial...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api';
        const clienteId = '@Model.Id';

        // Cargar membresías
        async function loadMembresias() {
            try {
                const response = await fetch(`${API_URL}/Clientes/${clienteId}/membresias`);
                const membresias = await response.json();

                const container = document.getElementById('membresias-list');

                if (membresias.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-8 text-gray-500">
                            <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 text-gray-400"></i>
                            <p>No hay membresías registradas</p>
                        </div>
                    `;
                } else {
                    container.innerHTML = membresias.map(m => {
                        const fechaVenc = new Date(m.fechaVencimiento);
                        const hoy = new Date();
                        const diasRestantes = Math.ceil((fechaVenc - hoy) / (1000 * 60 * 60 * 24));

                        let estadoClass = 'bg-gray-100 text-gray-800';
                        let estadoIcon = 'circle';

                        if (m.estado === 'activa') {
                            if (diasRestantes <= 3) {
                                estadoClass = 'bg-red-100 text-red-800';
                                estadoIcon = 'alert-circle';
                            } else if (diasRestantes <= 7) {
                                estadoClass = 'bg-yellow-100 text-yellow-800';
                                estadoIcon = 'alert-triangle';
                            } else {
                                estadoClass = 'bg-green-100 text-green-800';
                                estadoIcon = 'check-circle';
                            }
                        } else if (m.estado === 'vencida') {
                            estadoClass = 'bg-red-100 text-red-800';
                            estadoIcon = 'x-circle';
                        }

                        return `
                            <div class="p-4 border border-gray-200 rounded-lg hover:border-vida-primary transition-colors">
                                <div class="flex items-center justify-between">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-2 mb-2">
                                            <span class="font-semibold text-gray-800">${m.plan?.nombre || 'Plan'}</span>
                                            <span class="px-2 py-1 ${estadoClass} text-xs font-semibold rounded-full inline-flex items-center gap-1">
                                                <i data-lucide="${estadoIcon}" class="w-3 h-3"></i>
                                                ${m.estado}
                                            </span>
                                        </div>
                                        <div class="text-sm text-gray-600">
                                            <span>Inicio: ${new Date(m.fechaInicio).toLocaleDateString('es-ES')}</span>
                                            <span class="mx-2">•</span>
                                            <span>Vence: ${fechaVenc.toLocaleDateString('es-ES')}</span>
                                            ${m.estado === 'activa' ? `<span class="mx-2">•</span><span class="font-semibold">${diasRestantes} días restantes</span>` : ''}
                                        </div>
                                        <div class="text-sm text-gray-500 mt-1">
                                            Monto: <span class="font-semibold">$${m.montoPagado.toFixed(2)}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');
                }

                lucide.createIcons();
            } catch (error) {
                console.error('Error cargando membresías:', error);
            }
        }

        // Cargar check-ins
        async function loadCheckIns() {
            try {
                const response = await fetch(`${API_URL}/CheckIn/cliente/${clienteId}?limit=20`);
                const data = await response.json();
                const checkIns = data.checkIns;

                const container = document.getElementById('checkins-list');

                if (checkIns.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-8 text-gray-500">
                            <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 text-gray-400"></i>
                            <p>No hay check-ins registrados</p>
                        </div>
                    `;
                } else {
                    container.innerHTML = checkIns.map(ci => {
                        const fecha = new Date(ci.fechaHora);
                        const iconClass = ci.exitoso ? 'text-green-500' : 'text-red-500';
                        const icon = ci.exitoso ? 'check-circle' : 'x-circle';

                        return `
                            <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="${icon}" class="w-5 h-5 ${iconClass}"></i>
                                    <div>
                                        <p class="font-semibold text-gray-800">${fecha.toLocaleDateString('es-ES')} ${fecha.toLocaleTimeString('es-ES')}</p>
                                        <p class="text-sm text-gray-600">${ci.nota || 'Check-in exitoso'}</p>
                                    </div>
                                </div>
                                <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs font-semibold rounded">
                                    ${ci.metodo}
                                </span>
                            </div>
                        `;
                    }).join('');
                }

                lucide.createIcons();
            } catch (error) {
                console.error('Error cargando check-ins:', error);
            }
        }

        // Cargar datos al iniciar
        window.addEventListener('load', function() {
            loadMembresias();
            loadCheckIns();
            lucide.createIcons();
        });
    </script>
}
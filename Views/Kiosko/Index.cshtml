@{
    Layout = "_Layout";
    ViewData["Title"] = "Check-In Power Fitness";
}

<div id="kiosko-app" class="min-h-screen"></div>

<style>
    html, body {
        height: 100%;
        overflow: hidden;
        margin: 0;
        padding: 0;
    }

    #kiosko-app {
        height: 100vh;
        overflow: hidden;
    }

    /* ── Variables de marca ── */
    :root {
        --pf-blue: #3B82F6;
        --pf-blue-bright: #60A5FA;
        --pf-blue-deep: #1E3A8A;
        --pf-purple: #7C3AED;
        --pf-purple-light: #A78BFA;
        --pf-dark: #060B18;
        --pf-card: #0D1526;
        --pf-border: #1E2D4A;
        --pf-green: #10B981;
        --pf-orange: #F59E0B;
        --pf-red: #EF4444;
    }
</style>

@section Scripts {
    <script>
        /* ── Paleta centralizada ── */
        const PF = {
            dark:          '#060B18',
            card:          '#0D1526',
            cardAlt:       '#111827',
            border:        '#1E2D4A',
            blue:          '#3B82F6',
            blueBright:    '#60A5FA',
            blueDeep:      '#1E3A8A',
            purple:        '#7C3AED',
            purpleLight:   '#A78BFA',
            green:         '#10B981',
            greenDark:     '#065F46',
            orange:        '#F59E0B',
            red:           '#EF4444',
            text:          '#E2E8F0',
            textMuted:     '#64748B',
            textSoft:      '#94A3B8',
        };

        /* ── Estilos compartidos (inline) ── */
        const S = {
            screen:    `background: linear-gradient(135deg, ${PF.dark} 0%, ${PF.card} 50%, ${PF.dark} 100%); height: 100vh; overflow: hidden; position: relative; display: flex; flex-direction: column;`,
            orbs:      `position: absolute; inset: 0; opacity: 0.12; pointer-events: none;`,
            header:    `position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 18px 48px; flex-shrink: 0;`,
            body:      `position: relative; z-index: 10; flex: 1; display: flex; align-items: center; justify-content: center; padding: 20px 48px; gap: 32px; min-height: 0;`,
            footer:    `position: relative; z-index: 10; display: flex; justify-content: center; padding: 14px 48px; flex-shrink: 0;`,
            card:      `backdrop-filter: blur(10px); border-radius: 20px; padding: 28px 36px;`,
            btnPrimary:`padding: 14px 48px; border: none; border-radius: 12px; font-size: 1.1rem; font-weight: 900; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; color: #fff;`,
        };

        /* ── Orbe decorativo ── */
        function orb(color, pos) {
            const positions = {
                tl: 'top:-80px; left:-80px;',
                br: 'bottom:-80px; right:-80px;',
                tr: 'top:-80px; right:-80px;',
                bl: 'bottom:-80px; left:-80px;',
            };
            return `<div style="position:absolute; ${positions[pos]} width:400px; height:400px; border-radius:50%; background:${color}; filter:blur(80px);"></div>`;
        }

        /* ── Logo Power Fitness ── */
        function logoBox() {
            return `
                <div style="display:inline-flex; flex-direction:column; align-items:center; gap:2px; padding:.5rem 1.5rem; background:linear-gradient(135deg,${PF.blueDeep},${PF.purple}); border-radius:.75rem; border:1px solid rgba(96,165,250,.25); box-shadow:0 4px 20px rgba(59,130,246,.25);">
                    <span style="font-size:1.5rem; font-weight:900; color:#fff; letter-spacing:.18em; text-transform:uppercase; line-height:1;">POWER</span>
                    <span style="font-size:.5rem; font-weight:800; color:${PF.blueBright}; letter-spacing:.45em; text-transform:uppercase;">FITNESS</span>
                </div>
            `;
        }

        class KioskoApp {
            constructor() {
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    diasVencidos: null,
                    membresia: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                };
                this.fingerprintCheckInterval = null;
                this.render();
                this.startClock();
                this.startFingerprintDetection();
            }

            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.render();

                if (this.state.mode === 'success' || this.state.mode === 'error' || this.state.mode === 'already-checked-in') {
                    this.stopFingerprintDetection();
                    setTimeout(() => {
                        this.reset();
                        this.startFingerprintDetection();
                    }, 6000);
                }
            }

            reset() {
                this.setState({
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    diasVencidos: null,
                    membresia: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                });
            }

            startClock() {
                setInterval(() => {
                    const timeEl = document.getElementById('clock-time');
                    const dateEl = document.getElementById('clock-date');
                    if (timeEl && dateEl) {
                        const now = new Date();
                        timeEl.textContent = now.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });
                        dateEl.textContent = now.toLocaleDateString('es-ES', {
                            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                        });
                    }
                }, 1000);
            }

            startFingerprintDetection() {
                this.fingerprintCheckInterval = setInterval(async () => {
                    if (this.state.mode === 'idle' && !this.state.isProcessing) {
                        await this.checkFingerprintSensor();
                    }
                }, 800);
            }

            stopFingerprintDetection() {
                if (this.fingerprintCheckInterval) {
                    clearInterval(this.fingerprintCheckInterval);
                    this.fingerprintCheckInterval = null;
                }
            }

            async checkFingerprintSensor() {
                if (this.state.isProcessing) return;

                try {
                    this.state.isProcessing = true;
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 2000);

                    const response = await fetch('/kiosko/checkin-huella', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);
                    const data = await response.json();

                    if (data.cliente || data.useCedula) {
                        this.state.isProcessing = false;
                        await this.handleFingerprintDetected(data);
                    } else {
                        this.state.isProcessing = false;
                    }
                } catch (error) {
                    this.state.isProcessing = false;
                }
            }

            async handleFingerprintDetected(data) {
                this.stopFingerprintDetection();

                if (data.useCedula && !data.cliente) {
                    this.setState({
                        mode: 'cedula',
                        message: data.message || 'Huella no reconocida. Usa tu cédula.'
                    });
                    return;
                }

                // ========== NUEVO: MANEJAR CHECK-IN DUPLICADO ==========
                if (data.yaHizoCheckIn && data.ultimoCheckIn) {
                    this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                    await new Promise(resolve => setTimeout(resolve, 1500));

                    this.setState({
                        mode: 'already-checked-in',
                        cliente: data.cliente,
                        message: data.message,
                        ultimoCheckIn: data.ultimoCheckIn
                    });
                    return;
                }
                // =======================================================

                this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                await new Promise(resolve => setTimeout(resolve, 1500));

                if (data.success && data.cliente) {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'success',
                        cliente: data.cliente,
                        diasRestantes: diasRestantes,
                        diasVencidos: null,
                        membresia: data.membresia || null,
                        message: data.message,
                        similarity: data.similarity,
                        deuda: data.deuda || null
                    });
                } else {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'error',
                        message: data.message || 'No se pudo verificar la huella',
                        diasRestantes: diasRestantes,
                        diasVencidos: data.membresia?.diasVencidos ?? null,
                        membresia: data.membresia || null,
                        deuda: data.deuda || null
                    });
                }
            }

            async handleCedulaConsulta() {
                // Leer siempre desde el DOM para evitar desfase con state
                const inputEl = document.getElementById('cedula-input');
                if (inputEl) this.state.cedula = inputEl.value;

                if (!this.state.cedula.trim()) {
                    this.setState({ message: 'Por favor ingresa tu cédula' });
                    return;
                }

                this.stopFingerprintDetection();
                this.setState({ mode: 'scanning', message: 'Consultando información...' });

                try {
                    const response = await fetch('/kiosko/checkin-cedula', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cedula: this.state.cedula })
                    });

                    const data = await response.json();

                    // ========== NUEVO: MANEJAR CHECK-IN DUPLICADO ==========
                    if (data.yaHizoCheckIn && data.ultimoCheckIn) {
                        this.setState({
                            mode: 'already-checked-in',
                            cliente: data.cliente,
                            message: data.message,
                            ultimoCheckIn: data.ultimoCheckIn
                        });
                        return;
                    }
                    // =======================================================

                    if (data.success && data.cliente) {
                        const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                        this.setState({
                            mode: 'success',
                            cliente: data.cliente,
                            diasRestantes: diasRestantes,
                            diasVencidos: null,
                            membresia: data.membresia || null,
                            message: data.message,
                            deuda: data.deuda || null
                        });
                    } else {
                        this.setState({
                            mode: 'error',
                            message: data.message || 'No se pudo verificar la cédula',
                            diasVencidos: data.membresia?.diasVencidos ?? null,
                            membresia: data.membresia || null,
                            deuda: data.deuda || null
                        });
                    }
                } catch (error) {
                    this.setState({
                        mode: 'error',
                        message: 'Error al consultar cédula. Intenta nuevamente.'
                    });
                }
            }

            /* ════════════════════════════════════════════
               PANTALLA IDLE
            ════════════════════════════════════════════ */
            renderIdle() {
                return `
                    <div style="${S.screen} align-items:center; justify-content:center;">

                        <div style="${S.orbs}">
                            ${orb(PF.blue,   'tl')}
                            ${orb(PF.purple, 'br')}
                        </div>

                        <!-- Grid decorativo -->
                        <div style="position:absolute; inset:0; background-image:linear-gradient(rgba(59,130,246,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,.04) 1px,transparent 1px); background-size:50px 50px; pointer-events:none;"></div>

                        <div style="position:relative; z-index:10; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2rem; padding:2rem; text-align:center; width:100%;">

                            <!-- Logo -->
                            <div>${logoBox()}</div>

                            <!-- Reloj -->
                            <div>
                                <div id="clock-time" style="font-size:5rem; font-weight:900; color:#fff; letter-spacing:0.05em; line-height:1; text-shadow:0 0 40px rgba(96,165,250,.3);"></div>
                                <div id="clock-date" style="font-size:1.4rem; font-weight:700; color:${PF.blueBright}; text-transform:capitalize; margin-top:6px;"></div>
                            </div>

                            <!-- Input cédula -->
                            <div style="width:100%; max-width:640px; background:rgba(13,21,38,.7); backdrop-filter:blur(10px); border:2px solid ${PF.blue}; border-radius:20px; padding:2.5rem; box-shadow:0 8px 40px rgba(59,130,246,.15);">

                                <h2 style="font-size:1.6rem; font-weight:900; color:#fff; margin:0 0 1.5rem 0; text-transform:uppercase; letter-spacing:0.1em;">Ingresa tu Cédula</h2>

                                <input
                                    type="text"
                                    id="cedula-input"
                                    value="${this.state.cedula}"
                                    oninput="app.state.cedula = this.value"
                                    onkeydown="if(event.key === 'Enter') app.handleCedulaConsulta()"
                                    placeholder="000-0000000-0"
                                    style="width:100%; padding:1.5rem 2rem; font-size:3rem; font-weight:900; text-align:center; background:#fff; border:3px solid ${PF.blue}; border-radius:12px; color:${PF.blueDeep}; outline:none; box-sizing:border-box;"
                                    autofocus
                                />

                                ${this.state.message ? `
                                    <p style="font-size:1.2rem; color:${PF.blueBright}; margin:1rem 0 0 0; text-align:center; font-weight:700;">${this.state.message}</p>
                                ` : ''}

                                <button onclick="app.handleCedulaConsulta()"
                                    style="width:100%; margin-top:1.5rem; padding:1.25rem; background:linear-gradient(135deg,${PF.blue},${PF.purple}); color:#fff; border:none; border-radius:12px; font-size:1.4rem; font-weight:900; cursor:pointer; text-transform:uppercase; letter-spacing:0.08em; box-shadow:0 4px 20px rgba(59,130,246,.35);"
                                    onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                                    VERIFICAR
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            /* ════════════════════════════════════════════
               PANTALLA SCANNING
            ════════════════════════════════════════════ */
            renderScanning() {
                return `
                    <div style="${S.screen} align-items:center; justify-content:center;">
                        <div style="${S.orbs}">
                            ${orb(PF.blue,   'tl')}
                            ${orb(PF.purple, 'br')}
                        </div>

                        <div style="position:relative; z-index:10; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:100vh; padding:2rem; text-align:center; gap:2rem;">

                            <div style="margin-bottom:1rem;">${logoBox()}</div>


                            <div style="position:relative; width:160px; height:160px;">
                                <div style="width:160px; height:160px; border-radius:50%; background:linear-gradient(135deg,${PF.blue},${PF.purple}); display:flex; align-items:center; justify-content:center; box-shadow:0 8px 40px rgba(59,130,246,.5);">
                                    <svg style="width:90px; height:90px; color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                    </svg>
                                </div>
                                <div style="position:absolute; inset:-10px; border-radius:50%; border:3px solid rgba(96,165,250,.2);"></div>
                                <div style="position:absolute; inset:-20px; border-radius:50%; border:2px solid rgba(124,58,237,.12);"></div>
                            </div>

                            <h2 style="font-size:3.5rem; font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:0.08em; margin:0;">${this.state.message}</h2>
                            <p style="font-size:1.6rem; font-weight:700; color:${PF.blueBright}; margin:0;">Por favor espera...</p>
                        </div>
                    </div>
                `;
            }

            /* ════════════════════════════════════════════
               PANTALLA SUCCESS
            ════════════════════════════════════════════ */
            renderSuccess() {
                const { cliente, diasRestantes, similarity, deuda, membresia } = this.state;
                return `
                    <div style="${S.screen}">
                        <div style="${S.orbs}">
                            ${orb(PF.green,  'tl')}
                            ${orb(PF.blue,   'br')}
                        </div>

                        <!-- HEADER -->
                        <div style="${S.header} border-bottom:2px solid rgba(16,185,129,.25);">
                            ${logoBox()}
                            <h2 style="font-size:2.4rem; font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:0.08em; margin:0;">¡Acceso Autorizado!</h2>
                            <div style="width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg,${PF.green},#065F46); display:flex; align-items:center; justify-content:center; box-shadow:0 0 24px rgba(16,185,129,.5); border:2px solid rgba(52,211,153,.3);">
                                <svg style="width:38px; height:38px; color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div style="${S.body}">

                            <!-- Foto -->
                            ${cliente.fotoBase64 ? `
                                <div style="flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:12px;">
                                    <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                         alt="${cliente.nombre}"
                                         style="width:200px; height:200px; border-radius:50%; object-fit:cover; box-shadow:0 8px 40px rgba(0,0,0,.8); border:4px solid ${PF.green};" />
                                    ${similarity ? `
                                        <div style="background:rgba(16,185,129,.1); border:1px solid rgba(16,185,129,.35); border-radius:8px; padding:5px 14px; text-align:center;">
                                            <p style="font-size:0.75rem; color:${PF.green}; font-weight:700; margin:0;">🔒 ${similarity.toFixed(1)}% coincidencia</p>
                                        </div>
                                    ` : ''}
                                </div>
                            ` : ''}

                            <!-- Info cliente -->
                            <div style="flex:1; background:rgba(13,21,38,.65); backdrop-filter:blur(10px); border:2px solid ${PF.green}; border-radius:20px; padding:28px 36px; min-width:0;">
                                <h3 style="font-size:2.6rem; font-weight:900; color:#fff; margin:0 0 16px 0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${cliente.nombre}</h3>

                                ${membresia?.tipoPlan ? `
                                    <div style="display:inline-block; background:rgba(59,130,246,.12); border:2px solid rgba(96,165,250,.3); border-radius:10px; padding:6px 16px; margin-bottom:20px;">
                                        <p style="font-size:0.7rem; color:${PF.blueBright}; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin:0;">Plan Activo</p>
                                        <p style="font-size:1.4rem; font-weight:900; color:#fff; margin:0;">${membresia.tipoPlan}</p>
                                    </div>
                                ` : ''}

                                ${diasRestantes !== null && diasRestantes !== undefined ? `
                                    <div style="border-top:2px solid rgba(255,255,255,.1); padding-top:16px; margin-top:4px;">
                                        <p style="font-size:0.85rem; color:${PF.green}; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin:0 0 6px 0;">Días Restantes de Membresía</p>
                                        <p style="font-size:3.5rem; font-weight:900; margin:0; color:${diasRestantes <= 3 ? PF.orange : '#fff'};">
                                            ${diasRestantes} ${diasRestantes === 1 ? 'DÍA' : 'DÍAS'}
                                        </p>
                                    </div>
                                ` : ''}

                                <div style="margin-top:20px; padding-top:16px; border-top:2px solid rgba(255,255,255,.1);">
                                    <p style="font-size:1.1rem; color:#fff; font-weight:700; margin:0;">¡Sin prisa, pero con DISCIPLINA! 💪</p>
                                    <p style="font-size:0.95rem; color:${PF.blueBright}; font-weight:600; margin:4px 0 0 0;">(Insiste, Persiste, Resiste)</p>
                                </div>
                            </div>

                            <!-- Deuda -->
                            ${deuda && deuda.tieneDeuda ? `
                                <div style="flex-shrink:0; width:280px; background:rgba(13,21,38,.7); backdrop-filter:blur(10px); border:3px solid ${PF.orange}; border-radius:20px; padding:24px 28px; text-align:center;">
                                    <div style="width:52px; height:52px; border-radius:50%; background:rgba(245,158,11,.15); display:flex; align-items:center; justify-content:center; margin:0 auto 12px; border:1px solid rgba(245,158,11,.3);">
                                        <svg style="width:30px; height:30px; color:${PF.orange};" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                    <p style="font-size:0.75rem; color:${PF.orange}; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 8px 0;">⚠️ Deuda Pendiente</p>
                                    <p style="font-size:2.8rem; font-weight:900; color:${PF.orange}; margin:0 0 8px 0; text-shadow:0 0 20px rgba(245,158,11,.3);">
                                        $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                    </p>
                                    <p style="font-size:0.9rem; color:${PF.orange}; font-weight:600; margin:0 0 10px 0;">
                                        ${deuda.cantidadDeudas} ${deuda.cantidadDeudas === 1 ? 'pago pendiente' : 'pagos pendientes'}
                                    </p>
                                    <p style="font-size:0.85rem; color:#fff; font-weight:600; margin:0;">Acércate a recepción</p>
                                </div>
                            ` : ''}
                        </div>

                        <!-- FOOTER -->
                        <div style="${S.footer} border-top:2px solid rgba(16,185,129,.2);">
                            <p style="font-size:1rem; color:rgba(255,255,255,.45); margin:0;">Check-In registrado correctamente · Power Fitness</p>
                        </div>
                    </div>
                `;
            }

            /* ════════════════════════════════════════════
               PANTALLA ALREADY CHECKED IN
            ════════════════════════════════════════════ */
            renderAlreadyCheckedIn() {
                const { cliente, message, ultimoCheckIn } = this.state;
                return `
                    <div style="${S.screen}">
                        <div style="${S.orbs}">
                            ${orb(PF.orange, 'tl')}
                            ${orb(PF.purple, 'br')}
                        </div>

                        <!-- HEADER -->
                        <div style="${S.header} border-bottom:2px solid rgba(245,158,11,.3);">
                            ${logoBox()}
                            <h2 style="font-size:2.4rem; font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:0.08em; margin:0;">¡Ya Registrado Hoy!</h2>
                            <div style="width:64px; height:64px; border-radius:50%; background:${PF.orange}; display:flex; align-items:center; justify-content:center; box-shadow:0 0 24px rgba(245,158,11,.5);">
                                <svg style="width:38px; height:38px; color:#fff;" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div style="${S.body}">
                            ${cliente?.fotoBase64 ? `
                                <div style="flex-shrink:0;">
                                    <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                         alt="${cliente?.nombre}"
                                         style="width:180px; height:180px; border-radius:50%; object-fit:cover; box-shadow:0 8px 40px rgba(0,0,0,.8); border:4px solid ${PF.orange};" />
                                </div>
                            ` : ''}

                            <div style="flex:1; background:rgba(13,21,38,.65); backdrop-filter:blur(10px); border:2px solid ${PF.orange}; border-radius:20px; padding:28px 36px;">
                                <h3 style="font-size:2.4rem; font-weight:900; color:#fff; margin:0 0 12px 0;">${cliente?.nombre || 'Usuario'}</h3>
                                <p style="font-size:1.3rem; color:#fff; font-weight:700; margin:0 0 20px 0; padding-bottom:16px; border-bottom:2px solid rgba(255,255,255,.12);">${message}</p>

                                ${ultimoCheckIn ? `
                                    <div>
                                        <p style="font-size:0.8rem; color:${PF.orange}; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin:0 0 8px 0;">⏰ Último Check-In registrado</p>
                                        <p style="font-size:3.5rem; font-weight:900; color:${PF.orange}; margin:0 0 8px 0;">${ultimoCheckIn.horaFormateada}</p>
                                        <p style="font-size:1rem; color:rgba(255,255,255,.65); margin:0 0 4px 0;">Hace ${ultimoCheckIn.horasTranscurridas.toFixed(1)} horas</p>
                                        <p style="font-size:0.95rem; color:rgba(255,255,255,.45); margin:0;">Podrás registrar nuevamente en ${ultimoCheckIn.horasRestantes.toFixed(1)} horas</p>
                                    </div>
                                ` : ''}

                                <div style="margin-top:20px; padding-top:16px; border-top:2px solid rgba(245,158,11,.25);">
                                    <p style="font-size:1.1rem; color:#fff; font-weight:700; margin:0;">¡Sigue con tu rutina! 💪</p>
                                    <p style="font-size:0.9rem; color:${PF.blueBright}; font-weight:600; margin:4px 0 0 0;">(Insiste, Persiste, Resiste)</p>
                                </div>
                            </div>
                        </div>

                        <!-- FOOTER -->
                        <div style="${S.footer} border-top:2px solid rgba(245,158,11,.2);">
                            <button onclick="app.reset();"
                                style="padding:14px 48px; background:${PF.orange}; color:#fff; border:none; border-radius:12px; font-size:1.1rem; font-weight:900; cursor:pointer; text-transform:uppercase; letter-spacing:0.05em; box-shadow:0 4px 20px rgba(245,158,11,.3);"
                                onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                ENTENDIDO
                            </button>
                        </div>
                    </div>
                `;
            }

            /* ════════════════════════════════════════════
               PANTALLA ERROR
            ════════════════════════════════════════════ */
            renderError() {
                const { diasVencidos, deuda, membresia } = this.state;
                return `
                    <div style="${S.screen}">
                        <div style="${S.orbs}">
                            ${orb(PF.red,    'tl')}
                            ${orb(PF.purple, 'br')}
                        </div>

                        <!-- HEADER -->
                        <div style="${S.header} border-bottom:2px solid rgba(239,68,68,.3);">
                            ${logoBox()}
                            <h2 style="font-size:2.4rem; font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:0.08em; margin:0;">Acceso Denegado</h2>
                            <div style="width:64px; height:64px; border-radius:50%; background:${PF.red}; display:flex; align-items:center; justify-content:center; box-shadow:0 0 24px rgba(239,68,68,.5); border:2px solid rgba(248,113,113,.3);">
                                <svg style="width:38px; height:38px; color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div style="${S.body}">
                            <div style="flex:1; max-width:680px; background:rgba(13,21,38,.65); backdrop-filter:blur(10px); border:2px solid ${PF.red}; border-radius:20px; padding:32px 40px; text-align:center;">
                                <p style="font-size:1.6rem; color:#fff; font-weight:800; margin:0 0 20px 0;">${this.state.message}</p>

                                ${membresia?.tipoPlan ? `
                                    <div style="display:inline-block; background:rgba(239,68,68,.1); border:2px solid rgba(239,68,68,.35); border-radius:10px; padding:8px 20px; margin-bottom:20px;">
                                        <p style="font-size:0.7rem; color:${PF.red}; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin:0;">Último Plan</p>
                                        <p style="font-size:1.4rem; font-weight:900; color:#fff; margin:0;">${membresia.tipoPlan}</p>
                                    </div>
                                ` : ''}

                                ${diasVencidos !== null && diasVencidos !== undefined && diasVencidos > 0 ? `
                                    <div style="border-top:2px solid rgba(239,68,68,.3); padding-top:20px; margin-top:8px;">
                                        <p style="font-size:0.85rem; color:${PF.red}; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 8px 0;">Membresía vencida hace</p>
                                        <p style="font-size:4rem; font-weight:900; color:${PF.orange}; margin:0 0 8px 0;">
                                            ${diasVencidos} ${diasVencidos === 1 ? 'DÍA' : 'DÍAS'}
                                        </p>
                                        <p style="font-size:1rem; color:#fff; font-weight:600; margin:0;">Renueva en recepción para volver a entrenar</p>
                                    </div>
                                ` : ''}

                                <div style="margin-top:24px; padding-top:16px; border-top:2px solid rgba(239,68,68,.2);">
                                    <p style="font-size:1.05rem; color:rgba(255,255,255,.75); font-weight:600; margin:0;">Dirígete a recepción para asistencia</p>
                                </div>
                            </div>

                            ${deuda && deuda.tieneDeuda ? `
                                <div style="flex-shrink:0; width:280px; background:rgba(13,21,38,.7); backdrop-filter:blur(10px); border:3px solid ${PF.orange}; border-radius:20px; padding:28px; text-align:center;">
                                    <p style="font-size:0.75rem; color:${PF.orange}; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 10px 0;">⚠️ Monto Pendiente</p>
                                    <p style="font-size:2.8rem; font-weight:900; color:${PF.orange}; margin:0 0 8px 0; text-shadow:0 0 20px rgba(245,158,11,.3);">
                                        $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                    </p>
                                    <p style="font-size:0.9rem; color:${PF.orange}; font-weight:600; margin:0 0 10px 0;">
                                        ${deuda.cantidadDeudas} ${deuda.cantidadDeudas === 1 ? 'pago pendiente' : 'pagos pendientes'}
                                    </p>
                                    <p style="font-size:0.85rem; color:#fff; font-weight:600; margin:0;">Recuerda ponerte al día</p>
                                </div>
                            ` : ''}
                        </div>

                        <!-- FOOTER -->
                        <div style="${S.footer} border-top:2px solid rgba(239,68,68,.2);">
                            <button onclick="app.reset();"
                                style="padding:14px 48px; background:${PF.red}; color:#fff; border:none; border-radius:12px; font-size:1.1rem; font-weight:900; cursor:pointer; text-transform:uppercase; letter-spacing:0.05em; box-shadow:0 4px 20px rgba(239,68,68,.3);"
                                onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                VOLVER AL INICIO
                            </button>
                        </div>
                    </div>
                `;
            }

            render() {
                const container = document.getElementById('kiosko-app');
                let html = '';

                switch(this.state.mode) {
                    case 'idle':
                    case 'cedula':            html = this.renderIdle();             break;
                    case 'scanning':          html = this.renderScanning();         break;
                    case 'success':           html = this.renderSuccess();           break;
                    case 'error':             html = this.renderError();             break;
                    case 'already-checked-in':html = this.renderAlreadyCheckedIn(); break;
                }

                container.innerHTML = html;

                // Foco inicial solo al montar la pantalla idle por primera vez
                if (this.state.mode === 'idle' || this.state.mode === 'cedula') {
                    setTimeout(() => {
                        const input = document.getElementById('cedula-input');
                        if (input) input.focus();
                    }, 50);
                }
            }
        }

        const app = new KioskoApp();
    </script>
}

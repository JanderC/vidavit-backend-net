@{
    Layout = "_Layout";
    ViewData["Title"] = "Check-In POWER FITNESS";
}

<div id="kiosko-app"></div>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
        height: 100%;
        width: 100%;
        overflow: hidden;
        position: fixed;
        top: 0; left: 0;
    }

    #kiosko-app {
        height: 100vh;
        width: 100vw;
        overflow: hidden;
        position: fixed;
        top: 0; left: 0;
    }

    /* Shared screen shell */
    .kiosko-screen {
        background: #05050F;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
    }

    /* Ambient orbs — static, no keyframes */
    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        pointer-events: none;
    }

    /* Grid pattern overlay */
    .grid-overlay {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(30,111,227,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(30,111,227,0.03) 1px, transparent 1px);
        background-size: 52px 52px;
        pointer-events: none;
    }

    /* Header bar */
    .screen-header {
        position: relative;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 48px;
        border-bottom: 1px solid rgba(30,111,227,0.2);
        flex-shrink: 0;
    }

    .screen-logo {
        height: 60px;
        width: 60px;
        object-fit: contain;
        filter: drop-shadow(0 4px 12px rgba(0,0,0,0.9));
    }

    /* Footer bar */
    .screen-footer {
        position: relative;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px 48px;
        border-top: 1px solid rgba(30,111,227,0.12);
        flex-shrink: 0;
    }

    /* Status badge pill */
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 18px;
        border-radius: 100px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* Cards */
    .info-card {
        background: rgba(5,5,15,0.7);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        padding: 28px 36px;
    }

    /* Buttons */
    .btn-primary {
        padding: 16px 52px;
        background: linear-gradient(135deg, #1E6FE3 0%, #6B3FA0 100%);
        color: #fff;
        border: none;
        border-radius: 14px;
        font-size: 1.1rem;
        font-weight: 900;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        transition: opacity 0.2s, transform 0.2s;
    }
    .btn-primary:hover { opacity: 0.88; transform: scale(1.04); }

    .btn-secondary {
        padding: 16px 36px;
        background: rgba(255,255,255,0.07);
        color: rgba(255,255,255,0.7);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 14px;
        font-size: 1.1rem;
        font-weight: 800;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        transition: background 0.2s, color 0.2s;
    }
    .btn-secondary:hover { background: rgba(255,255,255,0.12); color: #fff; }

    .btn-white {
        padding: 16px 52px;
        background: #fff;
        color: #05050F;
        border: none;
        border-radius: 14px;
        font-size: 1.1rem;
        font-weight: 900;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        transition: opacity 0.2s, transform 0.2s;
    }
    .btn-white:hover { opacity: 0.9; transform: scale(1.03); }

    /* Fingerprint ring — CSS border only, no keyframes */
    .fp-ring {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1E6FE3 0%, #6B3FA0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 40px rgba(30,111,227,0.4);
    }

    /* Spinner for scanning — CSS only, uses transform rotate via JS */
    .spin-icon {
        animation: spin-slow 1.2s linear infinite;
    }
    /* Cedula input */
    .cedula-input {
        width: 100%;
        padding: 22px 28px;
        font-size: 3.5rem;
        font-weight: 900;
        text-align: center;
        background: rgba(255,255,255,0.05);
        border: 2px solid rgba(30,111,227,0.4);
        border-radius: 16px;
        color: #fff;
        outline: none;
        font-family: 'Inter', monospace;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .cedula-input::placeholder { color: rgba(255,255,255,0.15); }
    .cedula-input:focus {
        border-color: #1E6FE3;
        box-shadow: 0 0 0 4px rgba(30,111,227,0.15);
    }

    /* Debt card — amber accent */
    .debt-card {
        flex-shrink: 0;
        width: 270px;
        background: rgba(5,5,15,0.75);
        backdrop-filter: blur(12px);
        border: 2px solid #D4A017;
        border-radius: 20px;
        padding: 24px 24px;
        text-align: center;
    }
</style>

@section Scripts {
    <script>
        class KioskoApp {
            constructor() {
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    diasVencidos: null,
                    membresia: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                };
                this.fingerprintCheckInterval = null;
                this.render();
                this.startClock();
                this.startFingerprintDetection();
            }

            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.render();
                if (this.state.mode === 'success' || this.state.mode === 'error' || this.state.mode === 'already-checked-in') {
                    this.stopFingerprintDetection();
                    setTimeout(() => {
                        this.reset();
                        this.startFingerprintDetection();
                    }, 6000);
                }
            }

            reset() {
                this.setState({
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    diasVencidos: null,
                    membresia: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                });
            }

            startClock() {
                setInterval(() => {
                    const timeEl = document.getElementById('clock-time');
                    const dateEl = document.getElementById('clock-date');
                    if (timeEl && dateEl) {
                        const now = new Date();
                        timeEl.textContent = now.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });
                        dateEl.textContent = now.toLocaleDateString('es-ES', {
                            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                        });
                    }
                }, 1000);
            }

            startFingerprintDetection() {
                this.fingerprintCheckInterval = setInterval(async () => {
                    if (this.state.mode === 'idle' && !this.state.isProcessing) {
                        await this.checkFingerprintSensor();
                    }
                }, 800);
            }

            stopFingerprintDetection() {
                if (this.fingerprintCheckInterval) {
                    clearInterval(this.fingerprintCheckInterval);
                    this.fingerprintCheckInterval = null;
                }
            }

            async checkFingerprintSensor() {
                if (this.state.isProcessing) return;
                try {
                    this.state.isProcessing = true;
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 2000);
                    const response = await fetch('/kiosko/checkin-huella', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        signal: controller.signal
                    });
                    clearTimeout(timeoutId);
                    const data = await response.json();
                    if (data.cliente || data.useCedula) {
                        this.state.isProcessing = false;
                        await this.handleFingerprintDetected(data);
                    } else {
                        this.state.isProcessing = false;
                    }
                } catch (error) {
                    this.state.isProcessing = false;
                }
            }

            async handleFingerprintDetected(data) {
                this.stopFingerprintDetection();
                if (data.useCedula && !data.cliente) {
                    this.setState({ mode: 'cedula', message: data.message || 'Huella no reconocida. Usa tu cédula.' });
                    return;
                }
                if (data.yaHizoCheckIn && data.ultimoCheckIn) {
                    this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                    await new Promise(resolve => setTimeout(resolve, 1500));
                    this.setState({ mode: 'already-checked-in', cliente: data.cliente, message: data.message, ultimoCheckIn: data.ultimoCheckIn });
                    return;
                }
                this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                await new Promise(resolve => setTimeout(resolve, 1500));
                if (data.success && data.cliente) {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'success',
                        cliente: data.cliente,
                        diasRestantes: diasRestantes,
                        diasVencidos: null,
                        membresia: data.membresia || null,
                        message: data.message,
                        similarity: data.similarity,
                        deuda: data.deuda || null
                    });
                } else {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'error',
                        message: data.message || 'No se pudo verificar la huella',
                        diasRestantes: diasRestantes,
                        diasVencidos: data.membresia?.diasVencidos ?? null,
                        membresia: data.membresia || null,
                        deuda: data.deuda || null
                    });
                }
            }

            async handleCedulaConsulta() {
                if (!this.state.cedula.trim()) {
                    this.setState({ message: 'Por favor ingresa tu cédula' });
                    return;
                }
                this.stopFingerprintDetection();
                this.setState({ mode: 'scanning', message: 'Consultando información...' });
                try {
                    const response = await fetch('/kiosko/checkin-cedula', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cedula: this.state.cedula })
                    });
                    const data = await response.json();
                    if (data.yaHizoCheckIn && data.ultimoCheckIn) {
                        this.setState({ mode: 'already-checked-in', cliente: data.cliente, message: data.message, ultimoCheckIn: data.ultimoCheckIn });
                        return;
                    }
                    if (data.success && data.cliente) {
                        const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                        this.setState({
                            mode: 'success',
                            cliente: data.cliente,
                            diasRestantes: diasRestantes,
                            diasVencidos: null,
                            membresia: data.membresia || null,
                            message: data.message,
                            deuda: data.deuda || null
                        });
                    } else {
                        this.setState({
                            mode: 'error',
                            message: data.message || 'No se pudo verificar la cédula',
                            diasVencidos: data.membresia?.diasVencidos ?? null,
                            membresia: data.membresia || null,
                            deuda: data.deuda || null
                        });
                    }
                } catch (error) {
                    this.setState({ mode: 'error', message: 'Error al consultar cédula. Intenta nuevamente.' });
                }
            }

            // ══════════════════════════════════════════════════════
            //  RENDER IDLE
            // ══════════════════════════════════════════════════════
            renderIdle() {
                return `
                    <div class="kiosko-screen" style="align-items:center; justify-content:center;">
                        <!-- orbs -->
                        <div class="orb" style="width:420px;height:420px;background:#1E6FE3;opacity:0.10;top:-100px;left:-80px;"></div>
                        <div class="orb" style="width:360px;height:360px;background:#6B3FA0;opacity:0.10;bottom:-80px;right:-60px;"></div>
                        <div class="grid-overlay"></div>

                        <div style="position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;gap:28px;padding:32px 48px;text-align:center;">

                            <!-- Logo -->
                            <img src="/images/power-fitness-logo.png" alt="Power Fitness"
                                 style="height:96px;width:96px;object-fit:contain;filter:drop-shadow(0 4px 24px rgba(30,111,227,0.5));" />

                            <!-- Clock -->
                            <div>
                                <div id="clock-time" style="font-size:5rem;font-weight:900;color:#fff;letter-spacing:0.04em;line-height:1;"></div>
                                <div id="clock-date" style="font-size:1.3rem;font-weight:700;color:#3D8EFF;text-transform:capitalize;margin-top:6px;"></div>
                            </div>

                            <!-- Fingerprint icon -->
                            <div class="fp-ring">
                                <svg style="width:74px;height:74px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4">
                                    </path>
                                </svg>
                            </div>

                            <!-- Text -->
                            <div>
                                <h1 style="font-size:2.8rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 8px 0;">
                                    Sistema de Check-In
                                </h1>
                                <p style="font-size:1.5rem;font-weight:700;background:linear-gradient(135deg,#3D8EFF,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin:0 0 6px 0;">
                                    Coloca tu dedo en el lector
                                </p>
                                <p style="font-size:0.95rem;color:rgba(255,255,255,0.4);margin:0;">
                                    Si no tienes lector, utiliza la cédula del cliente
                                </p>
                            </div>

                            <!-- Button -->
                            <button class="btn-white" onclick="app.setState({ mode: 'cedula' })">
                                USAR CÉDULA
                            </button>
                        </div>
                    </div>
                `;
            }

            // ══════════════════════════════════════════════════════
            //  RENDER CEDULA
            // ══════════════════════════════════════════════════════
            renderCedula() {
                return `
                    <div class="kiosko-screen" style="align-items:center;justify-content:center;">
                        <div class="orb" style="width:380px;height:380px;background:#1E6FE3;opacity:0.10;top:-80px;left:-60px;"></div>
                        <div class="orb" style="width:320px;height:320px;background:#6B3FA0;opacity:0.10;bottom:-60px;right:-50px;"></div>
                        <div class="grid-overlay"></div>

                        <div style="position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;gap:28px;width:100%;max-width:680px;padding:0 24px;">

                            <img src="/images/power-fitness-logo.png" alt="Power Fitness"
                                 style="height:90px;width:90px;object-fit:contain;filter:drop-shadow(0 4px 20px rgba(30,111,227,0.5));" />

                            <h2 style="font-size:2.6rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:0.07em;text-align:center;margin:0;">
                                Ingresa tu Cédula
                            </h2>

                            <div style="width:100%;background:rgba(5,5,15,0.7);backdrop-filter:blur(12px);border:1px solid rgba(30,111,227,0.25);border-radius:20px;padding:32px;">
                                <input
                                    type="text"
                                    id="cedula-input"
                                    value="${this.state.cedula}"
                                    oninput="app.setState({ cedula: event.target.value })"
                                    onkeypress="if(event.key === 'Enter') app.handleCedulaConsulta()"
                                    placeholder="000-0000000-0"
                                    class="cedula-input"
                                    autofocus
                                />

                                ${this.state.message ? `
                                    <p style="font-size:1.2rem;color:rgba(255,255,255,0.7);font-weight:700;text-align:center;margin-top:16px;">${this.state.message}</p>
                                ` : ''}

                                <div style="margin-top:24px;display:flex;gap:14px;">
                                    <button class="btn-primary" style="flex:1;" onclick="app.handleCedulaConsulta()">
                                        VERIFICAR
                                    </button>
                                    <button class="btn-secondary" onclick="app.reset(); app.startFingerprintDetection();">
                                        VOLVER
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            // ══════════════════════════════════════════════════════
            //  RENDER SCANNING
            // ══════════════════════════════════════════════════════
            renderScanning() {
                return `
                    <div class="kiosko-screen" style="align-items:center;justify-content:center;">
                        <div class="orb" style="width:400px;height:400px;background:#1E6FE3;opacity:0.12;top:-80px;left:-60px;"></div>
                        <div class="orb" style="width:340px;height:340px;background:#6B3FA0;opacity:0.12;bottom:-60px;right:-50px;"></div>
                        <div class="grid-overlay"></div>

                        <div style="position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;gap:32px;text-align:center;">
                            <img src="/images/power-fitness-logo.png" alt="Power Fitness"
                                 style="height:80px;width:80px;object-fit:contain;filter:drop-shadow(0 4px 20px rgba(30,111,227,0.5));"/>

                            <!-- Spinner -->
                            <div style="width:160px;height:160px;border-radius:50%;background:linear-gradient(135deg,#1E6FE3,#6B3FA0);display:flex;align-items:center;justify-content:center;box-shadow:0 8px 40px rgba(30,111,227,0.35);">
                                <svg class="spin-icon" style="width:88px;height:88px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                </svg>
                            </div>

                            <h2 style="font-size:3.2rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:0.07em;margin:0;">
                                ${this.state.message}
                            </h2>
                            <p style="font-size:1.4rem;font-weight:700;background:linear-gradient(135deg,#3D8EFF,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin:0;">
                                Por favor espera...
                            </p>
                        </div>
                    </div>
                `;
            }

            // ══════════════════════════════════════════════════════
            //  RENDER SUCCESS
            // ══════════════════════════════════════════════════════
            renderSuccess() {
                const { cliente, diasRestantes, similarity, deuda, membresia } = this.state;
                return `
                    <div class="kiosko-screen">
                        <!-- orbs -->
                        <div class="orb" style="width:380px;height:380px;background:#00C851;opacity:0.08;top:-80px;left:-60px;"></div>
                        <div class="orb" style="width:360px;height:360px;background:#1E6FE3;opacity:0.10;bottom:-60px;right:-50px;"></div>
                        <div class="grid-overlay"></div>

                        <!-- HEADER -->
                        <div class="screen-header">
                            <img src="/images/power-fitness-logo.png" alt="Power Fitness" class="screen-logo" />
                            <h2 style="font-size:2rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:0.07em;margin:0;">
                                ¡Acceso Autorizado!
                            </h2>
                            <div style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#00C851,#007E33);display:flex;align-items:center;justify-content:center;box-shadow:0 0 20px rgba(0,200,81,0.4);">
                                <svg style="width:34px;height:34px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div style="position:relative;z-index:10;flex:1;display:flex;align-items:center;justify-content:center;padding:16px 48px;gap:28px;min-height:0;overflow:hidden;">

                            <!-- Photo -->
                            ${cliente.fotoBase64 ? `
                                <div style="flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:10px;">
                                    <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                         alt="${cliente.nombre}"
                                         style="width:190px;height:190px;border-radius:50%;object-fit:cover;box-shadow:0 8px 40px rgba(0,0,0,0.8);border:4px solid #1E6FE3;" />
                                    ${similarity ? `
                                        <div style="background:rgba(30,111,227,0.12);border:1px solid rgba(30,111,227,0.3);border-radius:8px;padding:5px 12px;text-align:center;">
                                            <p style="font-size:0.72rem;color:#7EB8FF;font-weight:700;margin:0;">🔒 ${similarity.toFixed(1)}% coincidencia</p>
                                        </div>
                                    ` : ''}
                                </div>
                            ` : ''}

                            <!-- Info card -->
                            <div class="info-card" style="flex:1;border:1px solid rgba(0,200,81,0.3);">
                                <h3 style="font-size:2.4rem;font-weight:900;color:#fff;margin:0 0 14px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    ${cliente.nombre}
                                </h3>

                                ${membresia?.tipoPlan ? `
                                    <div style="display:inline-block;background:rgba(30,111,227,0.12);border:1px solid rgba(30,111,227,0.35);border-radius:10px;padding:6px 16px;margin-bottom:18px;">
                                        <p style="font-size:0.65rem;color:#7EB8FF;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;margin:0;">Plan Activo</p>
                                        <p style="font-size:1.3rem;font-weight:900;color:#fff;margin:0;">${membresia.tipoPlan}</p>
                                    </div>
                                ` : ''}

                                ${diasRestantes !== null && diasRestantes !== undefined ? `
                                    <div style="border-top:1px solid rgba(255,255,255,0.1);padding-top:14px;margin-top:4px;">
                                        <p style="font-size:0.75rem;color:#00C851;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px 0;">
                                            Días Restantes de Membresía
                                        </p>
                                        <p style="font-size:3.2rem;font-weight:900;margin:0;color:${diasRestantes <= 3 ? '#FACC15' : '#fff'};">
                                            ${diasRestantes} ${diasRestantes === 1 ? 'DÍA' : 'DÍAS'}
                                        </p>
                                    </div>
                                ` : ''}

                                <div style="margin-top:18px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.08);">
                                    <p style="font-size:1rem;color:#fff;font-weight:700;margin:0;">¡Sin prisa, pero con DISCIPLINA! 💪</p>
                                    <p style="font-size:0.9rem;color:#3D8EFF;font-weight:600;margin:4px 0 0 0;">(Insiste, Persiste, Resiste)</p>
                                </div>
                            </div>

                            <!-- Debt card -->
                            ${deuda && deuda.tieneDeuda ? `
                                <div class="debt-card">
                                    <p style="font-size:0.7rem;color:#D4A017;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 8px 0;">⚠️ Deuda Pendiente</p>
                                    <p style="font-size:2.6rem;font-weight:900;color:#F5C842;margin:0 0 8px 0;text-shadow:0 0 18px rgba(213,160,23,0.4);">
                                        $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                    </p>
                                    <p style="font-size:0.85rem;color:#D4A017;font-weight:600;margin:0 0 8px 0;">
                                        ${deuda.cantidadDeudas} ${deuda.cantidadDeudas === 1 ? 'pago pendiente' : 'pagos pendientes'}
                                    </p>
                                    <p style="font-size:0.8rem;color:rgba(255,255,255,0.6);font-weight:600;margin:0;">Acércate a recepción</p>
                                </div>
                            ` : ''}
                        </div>

                        <!-- FOOTER -->
                        <div class="screen-footer">
                            <p style="font-size:0.85rem;color:rgba(255,255,255,0.3);margin:0;">
                                Check-In registrado correctamente · POWER FITNESS
                            </p>
                        </div>
                    </div>
                `;
            }

            // ══════════════════════════════════════════════════════
            //  RENDER ALREADY CHECKED IN
            // ══════════════════════════════════════════════════════
            renderAlreadyCheckedIn() {
                const { cliente, message, ultimoCheckIn } = this.state;
                return `
                    <div class="kiosko-screen">
                        <div class="orb" style="width:380px;height:380px;background:#D4A017;opacity:0.10;top:-80px;left:-60px;"></div>
                        <div class="orb" style="width:340px;height:340px;background:#1E6FE3;opacity:0.10;bottom:-60px;right:-50px;"></div>
                        <div class="grid-overlay"></div>

                        <!-- HEADER -->
                        <div class="screen-header" style="border-bottom:1px solid rgba(212,160,23,0.25);">
                            <img src="/images/power-fitness-logo.png" alt="Power Fitness" class="screen-logo" />
                            <h2 style="font-size:2rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:0.07em;margin:0;">¡Ya Registrado Hoy!</h2>
                            <div style="width:60px;height:60px;border-radius:50%;background:#D4A017;display:flex;align-items:center;justify-content:center;box-shadow:0 0 20px rgba(212,160,23,0.4);">
                                <svg style="width:34px;height:34px;color:#fff;" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div style="position:relative;z-index:10;flex:1;display:flex;align-items:center;justify-content:center;padding:16px 48px;gap:28px;min-height:0;overflow:hidden;">

                            ${cliente?.fotoBase64 ? `
                                <div style="flex-shrink:0;">
                                    <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                         alt="${cliente?.nombre}"
                                         style="width:175px;height:175px;border-radius:50%;object-fit:cover;box-shadow:0 8px 40px rgba(0,0,0,0.8);border:4px solid #D4A017;" />
                                </div>
                            ` : ''}

                            <div class="info-card" style="flex:1;border:1px solid rgba(212,160,23,0.3);">
                                <h3 style="font-size:2.2rem;font-weight:900;color:#fff;margin:0 0 12px 0;">
                                    ${cliente?.nombre || 'Usuario'}
                                </h3>
                                <p style="font-size:1.2rem;color:rgba(255,255,255,0.8);font-weight:700;margin:0 0 18px 0;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,0.1);">
                                    ${message}
                                </p>

                                ${ultimoCheckIn ? `
                                    <div>
                                        <p style="font-size:0.72rem;color:#D4A017;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px 0;">
                                            ⏰ Último Check-In registrado
                                        </p>
                                        <p style="font-size:3.2rem;font-weight:900;color:#F5C842;margin:0 0 6px 0;">${ultimoCheckIn.horaFormateada}</p>
                                        <p style="font-size:0.9rem;color:rgba(255,255,255,0.55);margin:0 0 3px 0;">Hace ${ultimoCheckIn.horasTranscurridas.toFixed(1)} horas</p>
                                        <p style="font-size:0.85rem;color:rgba(255,255,255,0.4);margin:0;">Podrás registrar nuevamente en ${ultimoCheckIn.horasRestantes.toFixed(1)} horas</p>
                                    </div>
                                ` : ''}

                                <div style="margin-top:18px;padding-top:14px;border-top:1px solid rgba(212,160,23,0.2);">
                                    <p style="font-size:1rem;color:#fff;font-weight:700;margin:0;">¡Sigue con tu rutina! 💪</p>
                                    <p style="font-size:0.9rem;color:#3D8EFF;font-weight:600;margin:4px 0 0 0;">(Insiste, Persiste, Resiste)</p>
                                </div>
                            </div>
                        </div>

                        <!-- FOOTER -->
                        <div class="screen-footer" style="border-top:1px solid rgba(212,160,23,0.15);">
                            <button class="btn-primary" onclick="app.reset(); app.startFingerprintDetection();">
                                ENTENDIDO
                            </button>
                        </div>
                    </div>
                `;
            }

            // ══════════════════════════════════════════════════════
            //  RENDER ERROR
            // ══════════════════════════════════════════════════════
            renderError() {
                const { diasVencidos, deuda, membresia } = this.state;
                return `
                    <div class="kiosko-screen">
                        <div class="orb" style="width:380px;height:380px;background:#9B1C1C;opacity:0.14;top:-80px;left:-60px;"></div>
                        <div class="orb" style="width:340px;height:340px;background:#6B3FA0;opacity:0.10;bottom:-60px;right:-50px;"></div>
                        <div class="grid-overlay"></div>

                        <!-- HEADER -->
                        <div class="screen-header" style="border-bottom:1px solid rgba(185,28,28,0.25);">
                            <img src="/images/power-fitness-logo.png" alt="Power Fitness" class="screen-logo" />
                            <h2 style="font-size:2rem;font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:0.07em;margin:0;">Acceso Denegado</h2>
                            <div style="width:60px;height:60px;border-radius:50%;background:#B91C1C;display:flex;align-items:center;justify-content:center;box-shadow:0 0 20px rgba(185,28,28,0.5);">
                                <svg style="width:34px;height:34px;color:#fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div style="position:relative;z-index:10;flex:1;display:flex;align-items:center;justify-content:center;padding:16px 48px;gap:28px;min-height:0;overflow:hidden;">

                            <div class="info-card" style="flex:1;max-width:680px;border:1px solid rgba(185,28,28,0.4);text-align:center;">
                                <p style="font-size:1.5rem;color:#fff;font-weight:800;margin:0 0 18px 0;">${this.state.message}</p>

                                ${membresia?.tipoPlan ? `
                                    <div style="display:inline-block;background:rgba(185,28,28,0.12);border:1px solid rgba(185,28,28,0.35);border-radius:10px;padding:6px 18px;margin-bottom:18px;">
                                        <p style="font-size:0.65rem;color:#FCA5A5;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0;">Último Plan</p>
                                        <p style="font-size:1.3rem;font-weight:900;color:#fff;margin:0;">${membresia.tipoPlan}</p>
                                    </div>
                                ` : ''}

                                ${diasVencidos !== null && diasVencidos !== undefined && diasVencidos > 0 ? `
                                    <div style="border-top:1px solid rgba(185,28,28,0.3);padding-top:18px;margin-top:6px;">
                                        <p style="font-size:0.75rem;color:#FCA5A5;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px 0;">Membresía vencida hace</p>
                                        <p style="font-size:3.5rem;font-weight:900;color:#F5C842;margin:0 0 6px 0;">
                                            ${diasVencidos} ${diasVencidos === 1 ? 'DÍA' : 'DÍAS'}
                                        </p>
                                        <p style="font-size:0.95rem;color:#fff;font-weight:600;margin:0;">Renueva en recepción para volver a entrenar</p>
                                    </div>
                                ` : ''}

                                <div style="margin-top:20px;padding-top:16px;border-top:1px solid rgba(185,28,28,0.2);">
                                    <p style="font-size:1rem;color:rgba(255,255,255,0.65);font-weight:600;margin:0;">Dirígete a recepción para asistencia</p>
                                </div>
                            </div>

                            ${deuda && deuda.tieneDeuda ? `
                                <div class="debt-card">
                                    <p style="font-size:0.7rem;color:#D4A017;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 8px 0;">⚠️ Monto Pendiente</p>
                                    <p style="font-size:2.5rem;font-weight:900;color:#F5C842;margin:0 0 8px 0;text-shadow:0 0 18px rgba(213,160,23,0.4);">
                                        $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                    </p>
                                    <p style="font-size:0.85rem;color:#D4A017;font-weight:600;margin:0 0 8px 0;">
                                        ${deuda.cantidadDeudas} ${deuda.cantidadDeudas === 1 ? 'pago pendiente' : 'pagos pendientes'}
                                    </p>
                                    <p style="font-size:0.8rem;color:rgba(255,255,255,0.6);font-weight:600;margin:0;">Recuerda ponerte al día</p>
                                </div>
                            ` : ''}
                        </div>

                        <!-- FOOTER -->
                        <div class="screen-footer" style="border-top:1px solid rgba(185,28,28,0.15);">
                            <button class="btn-primary" onclick="app.reset(); app.startFingerprintDetection();">
                                VOLVER AL INICIO
                            </button>
                        </div>
                    </div>
                `;
            }

            // ══════════════════════════════════════════════════════
            //  MAIN RENDER DISPATCHER
            // ══════════════════════════════════════════════════════
            render() {
                const container = document.getElementById('kiosko-app');
                let html = '';
                let cursorPosition = null;
                const activeInput = document.getElementById('cedula-input');
                if (activeInput && this.state.mode === 'cedula') {
                    cursorPosition = activeInput.selectionStart;
                }

                switch(this.state.mode) {
                    case 'idle':             html = this.renderIdle();             break;
                    case 'cedula':           html = this.renderCedula();           break;
                    case 'scanning':         html = this.renderScanning();         break;
                    case 'success':          html = this.renderSuccess();          break;
                    case 'error':            html = this.renderError();            break;
                    case 'already-checked-in': html = this.renderAlreadyCheckedIn(); break;
                }

                container.innerHTML = html;

                if (this.state.mode === 'cedula') {
                    setTimeout(() => {
                        const input = document.getElementById('cedula-input');
                        if (input) {
                            input.focus();
                            if (cursorPosition !== null) {
                                const newPosition = Math.min(cursorPosition, input.value.length);
                                input.setSelectionRange(newPosition, newPosition);
                            }
                        }
                    }, 100);
                }
            }
        }

        const app = new KioskoApp();
    </script>
}

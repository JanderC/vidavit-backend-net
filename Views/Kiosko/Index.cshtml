@{
    Layout = "_Layout";
    ViewData["Title"] = "Check-In VIDA FIT";
}

<style>
    html, body {
        overflow: hidden !important;
        height: 100% !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }
    /* Anular cualquier navbar, header o wrapper del layout */
    nav, header, .navbar, .sidebar, footer, .footer { display: none !important; }
    /* El contenedor padre del body también debe ser full */
    body > *, main, .main, #main, [class*="container"], [class*="wrapper"] {
        margin: 0 !important;
        padding: 0 !important;
        max-width: 100% !important;
    }
</style>

<div id="kiosko-app" style="position:fixed;inset:0;width:100vw;height:100vh;overflow:hidden;"></div>

@section Scripts {
    <script>
        class KioskoApp {
            constructor() {
                this._cedula = '';
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    diasVencidos: null,
                    membresia: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                };
                this.render();
                this.startClock();
            }

            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.render();

                if (this.state.mode === 'success' || this.state.mode === 'error' || this.state.mode === 'already-checked-in') {
                    setTimeout(() => {
                        this.reset();
                    }, 6000);
                }
            }

            reset() {
                this._cedula = '';
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    diasVencidos: null,
                    membresia: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                };
                this.render();
            }

            startClock() {
                // Actualiza el reloj directo en el DOM sin re-renderizar
                const tick = () => {
                    const timeEl = document.getElementById('clock-time');
                    const dateEl = document.getElementById('clock-date');
                    if (timeEl && dateEl) {
                        const now = new Date();
                        timeEl.textContent = now.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });
                        dateEl.textContent = now.toLocaleDateString('es-ES', {
                            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                        });
                    }
                };
                tick();
                setInterval(tick, 1000);
            }

            async handleCedulaConsulta() {
                const cedula = (this._cedula || '').trim();
                if (!cedula) {
                    this.setState({ message: 'Por favor ingresa tu cédula' });
                    return;
                }

                this.setState({ mode: 'scanning', message: 'Consultando información...' });

                try {
                    const response = await fetch('/kiosko/checkin-cedula', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cedula: cedula })
                    });

                    const data = await response.json();

                    // ========== NUEVO: MANEJAR CHECK-IN DUPLICADO ==========
                    if (data.yaHizoCheckIn && data.ultimoCheckIn) {
                        this.setState({
                            mode: 'already-checked-in',
                            cliente: data.cliente,
                            message: data.message,
                            ultimoCheckIn: data.ultimoCheckIn
                        });
                        return;
                    }
                    // =======================================================

                    if (data.success && data.cliente) {
                        const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                        this.setState({
                            mode: 'success',
                            cliente: data.cliente,
                            diasRestantes: diasRestantes,
                            diasVencidos: null,
                            membresia: data.membresia || null,
                            message: data.message,
                            deuda: data.deuda || null
                        });
                    } else {
                        this.setState({
                            mode: 'error',
                            message: data.message || 'No se pudo verificar la cédula',
                            diasVencidos: data.membresia?.diasVencidos ?? null,
                            membresia: data.membresia || null,
                            deuda: data.deuda || null
                        });
                    }
                } catch (error) {
                    this.setState({
                        mode: 'error',
                        message: 'Error al consultar cédula. Intenta nuevamente.'
                    });
                }
            }

            renderIdle() {
                return `
                    <div style="position:fixed;inset:0;width:100vw;height:100vh;overflow:hidden;background:linear-gradient(135deg,#000000 0%,#1a1a1a 50%,#000000 100%);">
                        <div class="absolute inset-0 opacity-10 pointer-events-none">
                            <div class="absolute top-10 left-10 w-64 h-64 rounded-full filter blur-3xl" style="background: #22c55e;"></div>
                            <div class="absolute bottom-10 right-10 w-64 h-64 rounded-full filter blur-3xl" style="background: #22c55e;"></div>
                        </div>

                        <div style="position:relative;z-index:10;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:space-evenly;padding:2vh 1.5rem;">

                            <!-- Logo -->
                            <div class="animate-pulse flex-shrink-0">
                                <img src="/images/vida-fit-logo.png" alt="VIDA FIT" class="h-20 w-20 sm:h-28 sm:w-28 object-contain drop-shadow-2xl" />
                            </div>

                            <!-- Reloj -->
                            <div class="text-center flex-shrink-0">
                                <div id="clock-time" class="font-black text-white tracking-wider drop-shadow-2xl" style="font-size: clamp(2.5rem, 8vw, 5rem);"></div>
                                <div id="clock-date" class="font-bold capitalize" style="font-size: clamp(0.9rem, 2.5vw, 1.5rem); color: #22c55e;"></div>
                            </div>

                            <!-- Título -->
                            <div class="text-center flex-shrink-0 px-4">
                                <h1 class="font-black text-white uppercase tracking-wider drop-shadow-2xl" style="font-size: clamp(1.5rem, 4.5vw, 3rem);">
                                    Sistema de Check-In
                                </h1>
                                <p class="font-bold mt-1" style="font-size: clamp(0.9rem, 2.5vw, 1.4rem); color: #22c55e;">
                                    Ingresa tu cédula para registrarte
                                </p>
                            </div>

                            <!-- Input card -->
                            <div class="w-full flex-shrink-0" style="max-width: min(680px, 90vw);">
                                <div class="backdrop-blur-sm rounded-2xl px-6 py-5 sm:px-10 sm:py-7" style="background: rgba(0,0,0,0.45); border: 3px solid #22c55e;">
                                    <input
                                        type="text"
                                        id="cedula-input"
                                        value="${this._cedula || ''}"
                                        oninput="app._cedula = event.target.value"
                                        onkeypress="if(event.key === 'Enter') app.handleCedulaConsulta()"
                                        placeholder="000-0000000-0"
                                        class="w-full px-4 py-4 font-black text-center bg-white rounded-xl focus:outline-none focus:ring-4"
                                        style="font-size: clamp(1.8rem, 5vw, 3rem); color: #22c55e; border: 3px solid #22c55e;"
                                        autofocus
                                    />

                                    ${this.state.message ? `
                                        <p class="text-white mt-3 text-center font-bold" style="font-size: clamp(0.9rem, 2vw, 1.3rem);">${this.state.message}</p>
                                    ` : ''}

                                    <div class="mt-5">
                                        <button onclick="app.handleCedulaConsulta()"
                                            class="w-full text-white rounded-xl font-black transition-all duration-300 transform hover:scale-105 shadow-xl uppercase"
                                            style="padding: clamp(0.8rem, 2vw, 1.5rem); font-size: clamp(1rem, 2.5vw, 1.5rem); background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);">
                                            VERIFICAR
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                `;
            }

            renderCedula() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-20 left-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #22c55e;"></div>
                            <div class="absolute bottom-20 right-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #22c55e;"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="mb-12">
                                <img src="/images/vida-fit-logo.png" alt="VIDA FIT" class="h-40 w-40 object-contain drop-shadow-2xl" />
                            </div>

                            <h2 class="text-5xl font-black text-white mb-12 uppercase tracking-wider text-center">Ingresa tu Cédula</h2>

                            <div class="w-full max-w-2xl backdrop-blur-sm rounded-3xl p-10" style="background: rgba(0,0,0,0.4); border: 3px solid #22c55e;">
                                <input
                                    type="text"
                                    id="cedula-input"
                                    value="${this._cedula || ''}"
                                    oninput="app._cedula = event.target.value"
                                    onkeypress="if(event.key === 'Enter') app.handleCedulaConsulta()"
                                    placeholder="000-0000000-0"
                                    class="w-full px-8 py-6 text-5xl font-black text-center bg-white rounded-xl focus:outline-none focus:ring-4"
                                    style="color: #22c55e; border: 3px solid #22c55e;"
                                    autofocus
                                />

                                ${this.state.message ? `
                                    <p class="text-2xl text-white mt-6 text-center font-bold">${this.state.message}</p>
                                ` : ''}

                                <div class="mt-10 flex gap-6">
                                    <button onclick="app.handleCedulaConsulta()"
                                        class="flex-1 px-10 py-6 text-white rounded-xl text-2xl font-black transition-all duration-300 transform hover:scale-105 shadow-xl uppercase"
                                        style="background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);">
                                        VERIFICAR
                                    </button>

                                    <button onclick="app.reset();"
                                        class="px-10 py-6 bg-gray-700 hover:bg-gray-600 text-white rounded-xl text-2xl font-black transition-all duration-300 uppercase">
                                        VOLVER
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderScanning() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-20 left-20 w-96 h-96 rounded-full filter blur-3xl animate-pulse" style="background: #22c55e;"></div>
                            <div class="absolute bottom-20 right-20 w-96 h-96 rounded-full filter blur-3xl animate-pulse" style="background: #22c55e;"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="mb-12 animate-bounce">
                                <img src="/images/vida-fit-logo.png" alt="VIDA FIT" class="h-40 w-40 object-contain drop-shadow-2xl" />
                            </div>

                            <div class="relative mb-12">
                                <div class="w-48 h-48 rounded-full flex items-center justify-center shadow-2xl animate-pulse" style="background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);">
                                    <svg class="w-28 h-28 text-white animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                    </svg>
                                </div>
                                <div class="absolute inset-0 w-48 h-48 rounded-full animate-ping opacity-20" style="background: #22c55e;"></div>
                            </div>

                            <h2 class="text-6xl font-black text-white mb-6 uppercase tracking-wider drop-shadow-2xl">${this.state.message}</h2>
                            <p class="text-3xl font-bold" style="color: #22c55e;">Por favor espera...</p>
                        </div>
                    </div>
                `;
            }

            renderSuccess() {
                const { cliente, diasRestantes, similarity, deuda, membresia } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-10 left-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #00C851;"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #22c55e;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-4xl">
                                <div class="mb-8 flex justify-center">
                                    <img src="/images/vida-fit-logo.png" alt="VIDA FIT" class="h-32 w-32 object-contain drop-shadow-2xl" />
                                </div>

                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-40 h-40 rounded-full flex items-center justify-center shadow-2xl" style="background: linear-gradient(135deg, #00C851 0%, #007E33 100%);">
                                            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-40 h-40 rounded-full animate-ping opacity-20" style="background: #00C851;"></div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-8 uppercase tracking-wider">¡Acceso Autorizado!</h2>

                                <div class="flex flex-col md:flex-row gap-8 items-center justify-center mb-8">
                                    ${cliente.fotoBase64 ? `
                                        <div class="flex-shrink-0">
                                            <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                                 alt="${cliente.nombre}"
                                                 class="w-56 h-56 rounded-full object-cover shadow-2xl"
                                                 style="border: 6px solid #22c55e;" />
                                        </div>
                                    ` : ''}

                                    <div class="flex-1 text-left backdrop-blur-sm rounded-3xl px-12 py-10" style="background: rgba(0,0,0,0.6); border: 3px solid #00C851;">
                                        <h3 class="text-5xl font-black text-white mb-4">${cliente.nombre}</h3>

                                        <!-- Plan de membresía -->
                                        ${membresia?.tipoPlan ? `
                                            <div class="mb-6 inline-block px-5 py-2 rounded-xl" style="background: rgba(209,36,35,0.2); border: 2px solid #22c55e;">
                                                <p class="text-sm uppercase tracking-widest font-bold" style="color: #22c55e;">Plan</p>
                                                <p class="text-2xl font-black text-white">${membresia.tipoPlan}</p>
                                            </div>
                                        ` : ''}

                                        ${diasRestantes !== null && diasRestantes !== undefined ? `
                                            <div class="mb-6 pb-6" style="border-bottom: 2px solid rgba(255, 255, 255, 0.2);">
                                                <p class="text-lg mb-3 uppercase tracking-wide font-semibold" style="color: #00C851;">Días Restantes</p>
                                                <p class="text-6xl font-black ${diasRestantes <= 3 ? 'text-yellow-400' : 'text-white'}">
                                                    ${diasRestantes} ${diasRestantes === 1 ? 'DÍA' : 'DÍAS'}
                                                </p>
                                            </div>
                                        ` : ''}

                                        <!-- Información de Deuda -->
                                        ${deuda && deuda.tieneDeuda ? `
                                            <div class="pt-6 mt-6" style="border-top: 2px solid rgba(255, 165, 0, 0.5);">
                                                <div class="flex items-center justify-center gap-3 mb-4">
                                                    <svg class="w-10 h-10" style="color: #FFA500;" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                    </svg>
                                                    <p class="text-2xl uppercase tracking-wide font-bold" style="color: #FFA500;">⚠️ DEUDA PENDIENTE ⚠️</p>
                                                </div>
                                                <p class="text-7xl font-black mb-3 animate-pulse" style="color: #FFA500; text-shadow: 0 0 20px rgba(255, 165, 0, 0.5);">
                                                    $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                                </p>
                                                <p class="text-xl font-semibold" style="color: #FFA500;">
                                                    ${deuda.cantidadDeudas} ${deuda.cantidadDeudas === 1 ? 'pago pendiente' : 'pagos pendientes'}
                                                </p>
                                                <p class="text-lg text-white mt-3 font-semibold">
                                                    Por favor, acércate a recepción
                                                </p>
                                            </div>
                                        ` : ''}

                                        <!-- Verificación de similitud -->
                                        ${similarity ? `
                                            <div class="mt-6 pt-6" style="border-top: 2px solid rgba(209, 36, 35, 0.3);">
                                                <p class="text-lg font-semibold" style="color: #22c55e;">
                                                    🔒 Verificación: ${similarity.toFixed(1)}% de coincidencia
                                                </p>
                                            </div>
                                        ` : ''}
                                    </div>

                                    <!-- Mensaje motivacional -->
                                    <div class="mt-8 space-y-3">
                                        <p class="text-3xl text-white font-bold">¡Sin prisa, pero con ¡DISCIPLINA!</p>
                                        <p class="text-2xl font-semibold" style="color: #22c55e;">(Insiste, Persiste, Resiste)</p>
                                        <p class="text-xl text-white mt-3">Da lo mejor de ti 💪</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            // ========== NUEVA PANTALLA: CHECK-IN DUPLICADO ==========
            renderAlreadyCheckedIn() {
                const { cliente, message, ultimoCheckIn } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-10 left-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FFA500;"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #22c55e;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-3xl">
                                <!-- Logo -->
                                <div class="mb-8 flex justify-center">
                                    <img src="/images/vida-fit-logo.png" alt="VIDA FIT" class="h-32 w-32 object-contain drop-shadow-2xl" />
                                </div>

                                <!-- Icono de Advertencia -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-40 h-40 rounded-full flex items-center justify-center shadow-2xl" style="background: #FFA500;">
                                            <svg class="w-24 h-24 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-40 h-40 rounded-full animate-ping opacity-20" style="background: #FFA500;"></div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-8 uppercase tracking-wider">¡Ya Registrado!</h2>

                                <div class="flex flex-col gap-8 items-center justify-center mb-8">
                                    ${cliente?.fotoBase64 ? `
                                        <div class="flex-shrink-0">
                                            <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                                 alt="${cliente.nombre}"
                                                 class="w-48 h-48 rounded-full object-cover shadow-2xl"
                                                 style="border: 6px solid #FFA500;" />
                                        </div>
                                    ` : ''}

                                    <div class="backdrop-blur-sm rounded-3xl px-12 py-10 w-full" style="background: rgba(0,0,0,0.6); border: 3px solid #FFA500;">
                                        <h3 class="text-4xl font-black text-white mb-6">${cliente?.nombre || 'Usuario'}</h3>

                                        <div class="mb-8 pb-8" style="border-bottom: 2px solid rgba(255, 255, 255, 0.2);">
                                            <p class="text-3xl text-white mb-4 font-bold">${message}</p>
                                        </div>

                                        ${ultimoCheckIn ? `
                                            <div class="mb-6">
                                                <p class="text-xl mb-4 uppercase tracking-wide font-semibold" style="color: #FFA500;">
                                                    <svg class="w-6 h-6 inline-block mr-2" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                                    </svg>
                                                    Último Check-In
                                                </p>
                                                <p class="text-7xl font-black mb-4" style="color: #FFA500;">
                                                    ${ultimoCheckIn.horaFormateada}
                                                </p>
                                                <p class="text-xl text-gray-300 mb-2">
                                                    Hace ${ultimoCheckIn.horasTranscurridas.toFixed(1)} horas
                                                </p>
                                                <p class="text-lg text-gray-400">
                                                    Podrás registrar nuevamente en ${ultimoCheckIn.horasRestantes.toFixed(1)} horas
                                                </p>
                                            </div>
                                        ` : ''}

                                        <div class="mt-8 pt-6" style="border-top: 2px solid rgba(255, 165, 0, 0.5);">
                                            <p class="text-2xl text-white font-semibold">¡Sigue con tu rutina! 💪</p>
                                            <p class="text-lg text-gray-300 mt-2">Ya estás registrado para hoy</p>
                                        </div>
                                    </div>

                                    <!-- Mensaje motivacional -->
                                    <div class="mt-6 space-y-2">
                                        <p class="text-2xl text-white font-bold">¡Sin prisa, pero con ¡DISCIPLINA!</p>
                                        <p class="text-xl font-semibold" style="color: #22c55e;">(Insiste, Persiste, Resiste)</p>
                                    </div>
                                </div>

                                <button onclick="app.reset();"
                                    class="px-12 py-5 text-white rounded-xl text-xl font-bold transition-all duration-300 transform hover:scale-105" style="background: #FFA500;">
                                    ENTENDIDO
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }
            // =========================================================

            renderError() {
                const { diasVencidos, deuda, membresia } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-10 left-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #22c55e;"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #22c55e;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-3xl">
                                <!-- Logo -->
                                <div class="mb-8 flex justify-center">
                                    <img src="/images/vida-fit-logo.png" alt="VIDA FIT" class="h-32 w-32 object-contain drop-shadow-2xl" />
                                </div>

                                <!-- Error Icon -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-40 h-40 rounded-full flex items-center justify-center shadow-2xl" style="background: #22c55e;">
                                            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-40 h-40 rounded-full animate-ping opacity-20" style="background: #22c55e;"></div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-8 uppercase tracking-wider">Acceso Denegado</h2>

                                <div class="backdrop-blur-sm rounded-3xl px-12 py-10 mb-10" style="background: rgba(0,0,0,0.6); border: 3px solid #22c55e;">
                                    <div class="mb-6 flex justify-center">
                                        <div class="w-20 h-20 rounded-full flex items-center justify-center" style="background: #22c55e;">
                                            <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                    </div>

                                    <p class="text-3xl text-white mb-4 font-bold">${this.state.message}</p>

                                    <!-- Último plan -->
                                    ${membresia?.tipoPlan ? `
                                        <div class="mt-4 mb-2 inline-block px-5 py-2 rounded-xl" style="background: rgba(209,36,35,0.15); border: 2px solid rgba(209,36,35,0.5);">
                                            <p class="text-sm uppercase tracking-widest font-bold" style="color: #22c55e;">Último plan</p>
                                            <p class="text-2xl font-black text-white">${membresia.tipoPlan}</p>
                                        </div>
                                    ` : ''}

                                    <!-- Días vencidos -->
                                    ${diasVencidos !== null && diasVencidos !== undefined && diasVencidos > 0 ? `
                                        <div class="pt-6 mt-6" style="border-top: 2px solid rgba(209, 36, 35, 0.5);">
                                            <p class="text-lg mb-3 uppercase tracking-wide font-semibold" style="color: #22c55e;">Membresía vencida hace</p>
                                            <p class="text-7xl font-black" style="color: #FFA500;">
                                                ${diasVencidos} ${diasVencidos === 1 ? 'DÍA' : 'DÍAS'}
                                            </p>
                                            <p class="text-white text-lg mt-3">Renueva en recepción para volver a entrenar</p>
                                        </div>
                                    ` : ''}

                                    <!-- Información de Deuda en Error -->
                                    ${deuda && deuda.tieneDeuda ? `
                                        <div class="pt-6 mt-6" style="border-top: 2px solid rgba(209, 36, 35, 0.5);">
                                            <div class="flex items-center justify-center gap-3 mb-4">
                                                <svg class="w-10 h-10" style="color: #FFA500;" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                </svg>
                                                <p class="text-2xl uppercase tracking-wide font-bold" style="color: #FFA500;">⚠️ MONTO PENDIENTE ⚠️</p>
                                            </div>
                                            <p class="text-7xl font-black mb-3 animate-pulse" style="color: #FFA500; text-shadow: 0 0 20px rgba(255, 165, 0, 0.5);">
                                                $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                            </p>
                                            <p class="text-xl font-semibold" style="color: #FFA500;">
                                                ${deuda.cantidadDeudas} ${deuda.cantidadDeudas === 1 ? 'pago pendiente' : 'pagos pendientes'}
                                            </p>
                                            <p class="text-lg text-white mt-3 font-semibold">
                                                Recuerda ponerte al día
                                            </p>
                                        </div>
                                    ` : ''}

                                    <div class="mt-8 pt-6" style="border-top: 2px solid rgba(209, 36, 35, 0.5);">
                                        <p class="text-xl text-white font-semibold">Dirígete a recepción para asistencia</p>
                                    </div>
                                </div>

                                <button onclick="app.reset();"
                                    class="px-12 py-5 text-white rounded-xl text-xl font-bold transition-all duration-300 transform hover:scale-105" style="background: #22c55e;">
                                    VOLVER AL INICIO
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            render() {
                const container = document.getElementById('kiosko-app');
                let html = '';
                let cursorPosition = null;

                switch(this.state.mode) {
                    case 'idle': html = this.renderIdle(); break;
                    case 'cedula': html = this.renderCedula(); break;
                    case 'scanning': html = this.renderScanning(); break;
                    case 'success': html = this.renderSuccess(); break;
                    case 'error': html = this.renderError(); break;
                    case 'already-checked-in': html = this.renderAlreadyCheckedIn(); break; // NUEVO
                }

                container.innerHTML = html;

                if (this.state.mode === 'idle' || this.state.mode === 'cedula') {
                    setTimeout(() => {
                        const input = document.getElementById('cedula-input');
                        if (input) input.focus();
                    }, 50);
                }
            }
        }

        const app = new KioskoApp();
    </script>
}

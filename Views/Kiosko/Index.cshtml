@{
    Layout = "_Layout";
    ViewData["Title"] = "Check-In VIDA FIT";
}

<div id="kiosko-app" class="min-h-screen"></div>

@section Scripts {
    <script>
        const API_URL = '/api';

        class KioskoApp {
            constructor() {
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    captureProgress: 0,
                    similarity: 0
                };
                this.render();
                this.startClock();
            }

            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.render();
                if (this.state.mode === 'success' || this.state.mode === 'error') {
                    setTimeout(() => this.reset(), 5000);
                }
            }

            reset() {
                this.setState({
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    captureProgress: 0,
                    similarity: 0
                });
            }

            startClock() {
                setInterval(() => {
                    const timeEl = document.getElementById('clock-time');
                    const dateEl = document.getElementById('clock-date');
                    if (timeEl && dateEl) {
                        const now = new Date();
                        timeEl.textContent = now.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });
                        dateEl.textContent = now.toLocaleDateString('es-ES', {
                            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                        });
                    }
                }, 1000);
            }

            async handleFingerprintScan() {
                this.setState({ mode: 'scanning', message: 'Preparando sensor...', captureProgress: 0 });

                // Simular progreso de las 3 capturas
                const progressInterval = setInterval(() => {
                    if (this.state.captureProgress < 3) {
                        const newProgress = this.state.captureProgress + 1;
                        this.setState({
                            captureProgress: newProgress,
                            message: `Captura ${newProgress}/3 - Mantén el dedo en el sensor`
                        });
                    }
                }, 2500); // Cada 2.5 segundos

                try {
                    const response = await fetch(`${API_URL}/Fingerprint/checkin-multi`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    clearInterval(progressInterval);
                    const data = await response.json();

                    if (data.success) {
                        // Datos simplificados del API
                        this.setState({
                            mode: 'success',
                            cliente: {
                                nombre: data.cliente.nombre, // Ya viene como nombre completo
                                fotoBase64: data.cliente.fotoBase64
                            },
                            diasRestantes: data.membresia ? data.membresia.diasRestantes : null,
                            message: data.message,
                            similarity: data.similarity
                        });
                    } else {
                        clearInterval(progressInterval);
                        this.setState({
                            mode: 'error',
                            message: data.message || 'No se pudo verificar la huella',
                            similarity: data.similarity
                        });
                    }
                } catch (error) {
                    clearInterval(progressInterval);
                    this.setState({
                        mode: 'error',
                        message: 'Error de conexión. Intenta con cédula.'
                    });
                }
            }

            async handleCedulaSubmit() {
                if (!this.state.cedula.trim()) return;
                this.setState({ mode: 'scanning', message: 'Verificando...' });

                try {
                    const response = await fetch(`${API_URL}/CheckIn/cedula`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cedula: this.state.cedula.trim() })
                    });

                    const data = await response.json();

                    if (data.success) {
                        this.setState({
                            mode: 'success',
                            cliente: {
                                nombre: data.cliente.nombre,
                                fotoBase64: data.cliente.fotoBase64
                            },
                            diasRestantes: data.cliente.diasRestantes,
                            message: data.message
                        });
                    } else {
                        this.setState({
                            mode: 'error',
                            message: data.message
                        });
                    }
                } catch (error) {
                    this.setState({
                        mode: 'error',
                        message: 'Error de conexión'
                    });
                }
            }

            renderIdle() {
                return `
                    <div class="min-h-screen bg-gradient-to-br from-gray-900 via-black to-gray-900 flex flex-col items-center justify-center p-8 relative overflow-hidden">
                        <div class="absolute inset-0 opacity-20">
                            <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-green-500 rounded-full blur-3xl animate-pulse"></div>
                            <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-green-400 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
                        </div>

                        <div class="absolute top-8 right-8 text-right z-10">
                            <div class="text-6xl font-bold text-green-400 font-mono" id="clock-time">00:00:00</div>
                            <div class="text-xl text-gray-400 mt-2 capitalize" id="clock-date">Cargando...</div>
                        </div>

                        <div class="absolute top-8 left-8 z-10">
                            <div class="text-5xl font-black text-white">VIDA <span class="text-green-400">FIT</span></div>
                            <div class="text-sm text-gray-400 tracking-widest mt-1">SISTEMA CHECK-IN</div>
                        </div>

                        <div class="relative z-10 text-center">
                            <div class="mb-12 flex justify-center">
                                <button onclick="app.handleFingerprintScan()" class="relative group">
                                    <div class="absolute inset-0 bg-green-500 rounded-full blur-2xl opacity-50 group-hover:opacity-75 animate-pulse"></div>
                                    <div class="relative bg-gradient-to-br from-green-500 to-green-600 p-20 rounded-full shadow-2xl group-hover:scale-105 transition-transform">
                                        <i data-lucide="fingerprint" class="w-40 h-40 text-white" stroke-width="1.5"></i>
                                    </div>
                                </button>
                            </div>

                            <h1 class="text-6xl font-black text-white mb-6">
                                Coloca tu <span class="text-green-400">huella</span>
                            </h1>
                            <p class="text-3xl text-gray-400 mb-16">Sistema de reconocimiento biométrico</p>

                            <div class="flex items-center gap-6 my-12 max-w-2xl mx-auto">
                                <div class="flex-1 h-px bg-gradient-to-r from-transparent to-gray-700"></div>
                                <span class="text-gray-500 text-2xl">o</span>
                                <div class="flex-1 h-px bg-gradient-to-l from-transparent to-gray-700"></div>
                            </div>

                            <button onclick="app.setState({ mode: 'cedula' })"
                                class="px-10 py-5 bg-gray-800 hover:bg-gray-700 border-2 border-gray-700 hover:border-green-500 text-white rounded-2xl text-2xl font-bold transition-all flex items-center gap-4 mx-auto">
                                <i data-lucide="credit-card" class="w-8 h-8"></i>
                                Ingresar con Cédula
                            </button>
                        </div>
                    </div>
                `;
            }

            renderCedula() {
                return `
                    <div class="min-h-screen bg-gradient-to-br from-gray-900 via-black to-gray-900 flex items-center justify-center p-8">
                        <div class="bg-gray-800 rounded-2xl p-12 border-2 border-gray-700 shadow-2xl max-w-2xl w-full">
                            <div class="text-center mb-8">
                                <i data-lucide="credit-card" class="w-20 h-20 text-green-400 mx-auto mb-4"></i>
                                <h2 class="text-4xl font-bold text-white mb-2">Ingresa tu Cédula</h2>
                                <p class="text-gray-400 text-lg">Sin guiones ni espacios</p>
                            </div>

                                           <input type="text" id="cedula-input" value="${this.state.cedula}"
                                                oninput="app.setState({ cedula: this.value.replace(/\D/g, '') })"
                                                onkeypress="if(event.key==='Enter') app.handleCedulaSubmit()"
                                                placeholder="0000000"
                                                class="w-full px-6 py-4 text-3xl text-right bg-gray-900 text-white rounded-xl border-2 border-gray-600 focus:border-green-500 focus:outline-none mb-6 font-mono dir-ltr"
                                                maxlength="11" autofocus
                                                style="direction: ltr;" />

                            <div class="flex gap-4">
                                <button onclick="app.handleCedulaSubmit()"
                                    ${this.state.cedula.length < 8 ? 'disabled' : ''}
                                    class="flex-1 px-8 py-4 bg-green-500 hover:bg-green-600 disabled:bg-gray-600 disabled:cursor-not-allowed text-white rounded-xl text-xl font-bold transition-all">
                                    Verificar
                                </button>
                                <button onclick="app.reset()"
                                    class="px-8 py-4 bg-gray-700 hover:bg-gray-600 text-white rounded-xl text-xl font-bold transition-all">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderScanning() {
                const progress = Math.min((this.state.captureProgress / 3) * 100, 100);

                return `
                    <div class="min-h-screen bg-gradient-to-br from-gray-900 via-black to-gray-900 flex items-center justify-center p-8">
                        <div class="text-center">
                            <div class="mb-8 flex justify-center">
                                <div class="relative">
                                    <div class="absolute inset-0 bg-blue-500 rounded-full blur-2xl opacity-50 animate-pulse"></div>
                                    <div class="relative bg-gradient-to-br from-blue-500 to-blue-600 p-16 rounded-full">
                                        <i data-lucide="fingerprint" class="w-32 h-32 text-white animate-pulse" stroke-width="1.5"></i>
                                    </div>
                                </div>
                            </div>

                            <h2 class="text-5xl font-bold text-white mb-4">${this.state.message}</h2>

                            ${this.state.captureProgress > 0 ? `
                                <div class="max-w-md mx-auto bg-gray-800 rounded-xl p-6 border-2 border-blue-500 mb-6">
                                    <p class="text-3xl text-blue-300 font-bold mb-4">Captura ${this.state.captureProgress}/3</p>
                                    <div class="w-full bg-gray-700 rounded-full h-4 mb-3">
                                        <div class="bg-blue-500 h-4 rounded-full transition-all duration-500" style="width: ${progress}%"></div>
                                    </div>
                                    <p class="text-gray-400">
                                        ${this.state.captureProgress < 3 ? 'Levanta el dedo y vuelve a colocarlo' : 'Procesando...'}
                                    </p>
                                </div>
                            ` : '<p class="text-2xl text-gray-400 mb-6">Por favor espera...</p>'}

                            <div class="flex justify-center gap-2 mt-4">
                                <div class="w-3 h-3 bg-blue-500 rounded-full animate-bounce"></div>
                                <div class="w-3 h-3 bg-blue-500 rounded-full animate-bounce" style="animation-delay: 0.1s;"></div>
                                <div class="w-3 h-3 bg-blue-500 rounded-full animate-bounce" style="animation-delay: 0.2s;"></div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderSuccess() {
                const { cliente, diasRestantes, similarity } = this.state;
                return `
                    <div class="min-h-screen bg-gradient-to-br from-green-900 via-green-800 to-black flex items-center justify-center p-8">
                        <div class="text-center">
                            <div class="mb-8 flex justify-center">
                                <div class="bg-green-500 p-12 rounded-full shadow-2xl">
                                    <i data-lucide="check-circle" class="w-32 h-32 text-white" stroke-width="2"></i>
                                </div>
                            </div>

                            ${cliente?.fotoBase64 ? `
                                <div class="mb-6 flex justify-center">
                                    <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                         class="w-40 h-40 rounded-full border-4 border-green-400 shadow-xl object-cover"/>
                                </div>
                            ` : ''}

                            <h2 class="text-6xl font-black text-white mb-4">¡BIENVENIDO!</h2>
                            <p class="text-4xl text-green-300 mb-8 font-bold">${cliente?.nombre || ''}</p>

                            ${diasRestantes !== null && diasRestantes !== undefined ? `
                                <div class="bg-black/50 rounded-xl px-8 py-6 inline-block border-2 ${diasRestantes <= 3 ? 'border-red-500' : 'border-green-500'} mb-4">
                                    <p class="text-2xl text-gray-300 mb-2">
                                        ${diasRestantes <= 3 ? '⚠️ Tu membresía vence en' : 'Membresía vence en'}
                                    </p>
                                    <p class="text-5xl font-bold ${diasRestantes <= 3 ? 'text-red-400' : 'text-green-400'}">
                                        ${diasRestantes} ${diasRestantes === 1 ? 'día' : 'días'}
                                    </p>
                                </div>
                            ` : ''}

                            ${similarity ? `
                                <div class="mt-4 text-sm text-gray-400">
                                    <p>✓ Verificación biométrica: ${similarity.toFixed(1)}% de coincidencia</p>
                                </div>
                            ` : ''}

                            <div class="mt-8 text-gray-400">
                                <p class="text-xl">${this.state.message}</p>
                                <p class="text-sm mt-2 text-green-400">✓ Acceso autorizado</p>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderError() {
                return `
                    <div class="min-h-screen bg-gradient-to-br from-red-900 via-red-800 to-black flex items-center justify-center p-8">
                        <div class="text-center">
                            <div class="mb-8 flex justify-center">
                                <div class="bg-red-500 p-12 rounded-full shadow-2xl">
                                    <i data-lucide="x-circle" class="w-32 h-32 text-white" stroke-width="2"></i>
                                </div>
                            </div>

                            <h2 class="text-6xl font-black text-white mb-4">ACCESO DENEGADO</h2>

                            <div class="bg-black/50 rounded-xl px-12 py-8 max-w-2xl mx-auto border-2 border-red-500 mb-8">
                                <i data-lucide="alert-circle" class="w-16 h-16 text-red-400 mx-auto mb-4"></i>
                                <p class="text-3xl text-red-300 mb-4 font-semibold">${this.state.message}</p>
                                ${this.state.similarity ? `
                                    <p class="text-sm text-gray-400 mb-2">Similitud detectada: ${this.state.similarity.toFixed(1)}%</p>
                                    <p class="text-sm text-gray-500">Se requiere al menos 35% para verificación</p>
                                ` : ''}
                                <p class="text-xl text-gray-400 mt-4">Dirígete a recepción</p>
                            </div>

                            <button onclick="app.reset()"
                                class="px-12 py-4 bg-gray-700 hover:bg-gray-600 text-white rounded-xl text-2xl font-bold transition-all">
                                Intentar Nuevamente
                            </button>
                        </div>
                    </div>
                `;
            }

            render() {
                const container = document.getElementById('kiosko-app');
                let html = '';

                // 1. Guardar la posición del cursor antes de renderizar
                let cursorPosition = null;
                const activeInput = document.getElementById('cedula-input');
                if (activeInput && this.state.mode === 'cedula') {
                    cursorPosition = activeInput.selectionStart;
                }

                switch(this.state.mode) {
                    case 'idle': html = this.renderIdle(); break;
                    case 'cedula': html = this.renderCedula(); break;
                    case 'scanning': html = this.renderScanning(); break;
                    case 'success': html = this.renderSuccess(); break;
                    case 'error': html = this.renderError(); break;
                }

                container.innerHTML = html;
                lucide.createIcons();

                // 2. Restaurar el foco y la posición del cursor después de renderizar
                if (this.state.mode === 'cedula') {
                    setTimeout(() => {
                        const input = document.getElementById('cedula-input');
                        if (input) {
                            input.focus();
                            if (cursorPosition !== null) {
                                // Asegura que el cursor quede al final (o donde estaba)
                                const newPosition = Math.min(cursorPosition, input.value.length);
                                input.setSelectionRange(newPosition, newPosition);
                            }
                        }
                    }, 100);
                }
            }

        }

        const app = new KioskoApp();
    </script>
}
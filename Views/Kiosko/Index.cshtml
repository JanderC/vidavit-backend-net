@{
    Layout = "_Layout";
    ViewData["Title"] = "Check-In TAURO GYM";
}

<div id="kiosko-app" class="min-h-screen"></div>

<style>
    html, body {
        height: 100%;
        overflow: hidden;
        margin: 0;
        padding: 0;
    }
    #kiosko-app {
        height: 100vh;
        overflow: hidden;
    }
</style>

@section Scripts {
    <script>
        class KioskoApp {
            constructor() {
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    diasVencidos: null,
                    membresia: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                };
                this.fingerprintCheckInterval = null;
                this.render();
                this.startClock();
                this.startFingerprintDetection();
            }

            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.render();

                if (this.state.mode === 'success' || this.state.mode === 'error' || this.state.mode === 'already-checked-in') {
                    this.stopFingerprintDetection();
                    setTimeout(() => {
                        this.reset();
                        this.startFingerprintDetection();
                    }, 6000);
                }
            }

            reset() {
                this.setState({
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    diasVencidos: null,
                    membresia: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                });
            }

            startClock() {
                setInterval(() => {
                    const timeEl = document.getElementById('clock-time');
                    const dateEl = document.getElementById('clock-date');
                    if (timeEl && dateEl) {
                        const now = new Date();
                        timeEl.textContent = now.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });
                        dateEl.textContent = now.toLocaleDateString('es-ES', {
                            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                        });
                    }
                }, 1000);
            }

            startFingerprintDetection() {
                this.fingerprintCheckInterval = setInterval(async () => {
                    if (this.state.mode === 'idle' && !this.state.isProcessing) {
                        await this.checkFingerprintSensor();
                    }
                }, 800);
            }

            stopFingerprintDetection() {
                if (this.fingerprintCheckInterval) {
                    clearInterval(this.fingerprintCheckInterval);
                    this.fingerprintCheckInterval = null;
                }
            }

            async checkFingerprintSensor() {
                if (this.state.isProcessing) return;

                try {
                    this.state.isProcessing = true;
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 2000);

                    const response = await fetch('/kiosko/checkin-huella', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);
                    const data = await response.json();

                    if (data.cliente || data.useCedula) {
                        this.state.isProcessing = false;
                        await this.handleFingerprintDetected(data);
                    } else {
                        this.state.isProcessing = false;
                    }
                } catch (error) {
                    this.state.isProcessing = false;
                }
            }

            async handleFingerprintDetected(data) {
                this.stopFingerprintDetection();

                if (data.useCedula && !data.cliente) {
                    this.setState({
                        mode: 'cedula',
                        message: data.message || 'Huella no reconocida. Usa tu cédula.'
                    });
                    return;
                }

                // ========== NUEVO: MANEJAR CHECK-IN DUPLICADO ==========
                if (data.yaHizoCheckIn && data.ultimoCheckIn) {
                    this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                    await new Promise(resolve => setTimeout(resolve, 1500));

                    this.setState({
                        mode: 'already-checked-in',
                        cliente: data.cliente,
                        message: data.message,
                        ultimoCheckIn: data.ultimoCheckIn
                    });
                    return;
                }
                // =======================================================

                this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                await new Promise(resolve => setTimeout(resolve, 1500));

                if (data.success && data.cliente) {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'success',
                        cliente: data.cliente,
                        diasRestantes: diasRestantes,
                        diasVencidos: null,
                        membresia: data.membresia || null,
                        message: data.message,
                        similarity: data.similarity,
                        deuda: data.deuda || null
                    });
                } else {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'error',
                        message: data.message || 'No se pudo verificar la huella',
                        diasRestantes: diasRestantes,
                        diasVencidos: data.membresia?.diasVencidos ?? null,
                        membresia: data.membresia || null,
                        deuda: data.deuda || null
                    });
                }
            }

            async handleCedulaConsulta() {
                if (!this.state.cedula.trim()) {
                    this.setState({ message: 'Por favor ingresa tu cédula' });
                    return;
                }

                this.stopFingerprintDetection();
                this.setState({ mode: 'scanning', message: 'Consultando información...' });

                try {
                    const response = await fetch('/kiosko/checkin-cedula', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cedula: this.state.cedula })
                    });

                    const data = await response.json();

                    // ========== NUEVO: MANEJAR CHECK-IN DUPLICADO ==========
                    if (data.yaHizoCheckIn && data.ultimoCheckIn) {
                        this.setState({
                            mode: 'already-checked-in',
                            cliente: data.cliente,
                            message: data.message,
                            ultimoCheckIn: data.ultimoCheckIn
                        });
                        return;
                    }
                    // =======================================================

                    if (data.success && data.cliente) {
                        const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                        this.setState({
                            mode: 'success',
                            cliente: data.cliente,
                            diasRestantes: diasRestantes,
                            diasVencidos: null,
                            membresia: data.membresia || null,
                            message: data.message,
                            deuda: data.deuda || null
                        });
                    } else {
                        this.setState({
                            mode: 'error',
                            message: data.message || 'No se pudo verificar la cédula',
                            diasVencidos: data.membresia?.diasVencidos ?? null,
                            membresia: data.membresia || null,
                            deuda: data.deuda || null
                        });
                    }
                } catch (error) {
                    this.setState({
                        mode: 'error',
                        message: 'Error al consultar cédula. Intenta nuevamente.'
                    });
                }
            }

            renderIdle() {
                return `
                    <div style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%); height: 100vh; overflow: hidden; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0;">
                        <div style="position: absolute; inset: 0; opacity: 0.10; pointer-events: none;">
                            <div style="position: absolute; top: -80px; left: -80px; width: 400px; height: 400px; border-radius: 50%; background: #D12423; filter: blur(80px);"></div>
                            <div style="position: absolute; bottom: -80px; right: -80px; width: 400px; height: 400px; border-radius: 50%; background: #D12423; filter: blur(80px);"></div>
                        </div>

                        <div style="position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px; padding: 32px 48px; text-align: center;">
                            <!-- Logo -->
                            <div style="animation: pulse 2s infinite;">
                                <img src="/images/tauro-gym-logo.png" alt="TAURO GYM" style="height: 100px; width: 100px; object-fit: contain; filter: drop-shadow(0 4px 24px rgba(0,0,0,0.8));" />
                            </div>

                            <!-- Reloj -->
                            <div>
                                <div id="clock-time" style="font-size: 5rem; font-weight: 900; color: #fff; letter-spacing: 0.05em; line-height: 1;"></div>
                                <div id="clock-date" style="font-size: 1.4rem; font-weight: 700; color: #D12423; text-transform: capitalize; margin-top: 6px;"></div>
                            </div>

                            <!-- Ícono huella -->
                            <div style="position: relative;">
                                <div style="width: 130px; height: 130px; border-radius: 50%; background: linear-gradient(135deg, #D12423 0%, #8B0000 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 40px rgba(209,36,35,0.4);">
                                    <svg style="width: 76px; height: 76px; color: #fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path>
                                    </svg>
                                </div>
                                <div style="position: absolute; inset: 0; width: 130px; height: 130px; border-radius: 50%; background: #D12423; animation: ping 1.5s cubic-bezier(0,0,0.2,1) infinite; opacity: 0.2;"></div>
                            </div>

                            <!-- Texto principal -->
                            <div>
                                <h1 style="font-size: 3rem; font-weight: 900; color: #fff; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 8px 0;">Sistema de Check-In</h1>
                                <p style="font-size: 1.6rem; font-weight: 700; color: #D12423; margin: 0 0 6px 0;">Coloca tu dedo en el lector</p>
                                <p style="font-size: 1rem; color: rgba(255,255,255,0.6); margin: 0;">Si no tienes lector, utiliza la cédula del cliente</p>
                            </div>

                            <!-- Botón cédula -->
                            <button onclick="app.setState({ mode: 'cedula' })"
                                style="padding: 16px 48px; background: #fff; color: #000; border: none; border-radius: 12px; font-size: 1.1rem; font-weight: 900; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; box-shadow: 0 8px 32px rgba(0,0,0,0.5);"
                                onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                USAR CÉDULA
                            </button>
                        </div>

                    </div>
                `;
            }

            renderCedula() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-20 left-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #D12423;"></div>
                            <div class="absolute bottom-20 right-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #D12423;"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="mb-12">
                                <img src="/images/tauro-gym-logo.png" alt="TAURO GYM" class="h-40 w-40 object-contain drop-shadow-2xl" />
                            </div>

                            <h2 class="text-5xl font-black text-white mb-12 uppercase tracking-wider text-center">Ingresa tu Cédula</h2>

                            <div class="w-full max-w-2xl backdrop-blur-sm rounded-3xl p-10" style="background: rgba(0,0,0,0.4); border: 3px solid #D12423;">
                                <input
                                    type="text"
                                    id="cedula-input"
                                    value="${this.state.cedula}"
                                    oninput="app.setState({ cedula: event.target.value })"
                                    onkeypress="if(event.key === 'Enter') app.handleCedulaConsulta()"
                                    placeholder="000-0000000-0"
                                    class="w-full px-8 py-6 text-5xl font-black text-center bg-white rounded-xl focus:outline-none focus:ring-4"
                                    style="color: #D12423; border: 3px solid #D12423;"
                                    autofocus
                                />

                                ${this.state.message ? `
                                    <p class="text-2xl text-white mt-6 text-center font-bold">${this.state.message}</p>
                                ` : ''}

                                <div class="mt-10 flex gap-6">
                                    <button onclick="app.handleCedulaConsulta()"
                                        class="flex-1 px-10 py-6 text-white rounded-xl text-2xl font-black transition-all duration-300 transform hover:scale-105 shadow-xl uppercase"
                                        style="background: linear-gradient(135deg, #D12423 0%, #8B0000 100%);">
                                        VERIFICAR
                                    </button>

                                    <button onclick="app.reset(); app.startFingerprintDetection();"
                                        class="px-10 py-6 bg-gray-700 hover:bg-gray-600 text-white rounded-xl text-2xl font-black transition-all duration-300 uppercase">
                                        VOLVER
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderScanning() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-20 left-20 w-96 h-96 rounded-full filter blur-3xl animate-pulse" style="background: #D12423;"></div>
                            <div class="absolute bottom-20 right-20 w-96 h-96 rounded-full filter blur-3xl animate-pulse" style="background: #D12423;"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="mb-12 animate-bounce">
                                <img src="/images/tauro-gym-logo.png" alt="TAURO GYM" class="h-40 w-40 object-contain drop-shadow-2xl" />
                            </div>

                            <div class="relative mb-12">
                                <div class="w-48 h-48 rounded-full flex items-center justify-center shadow-2xl animate-pulse" style="background: linear-gradient(135deg, #D12423 0%, #8B0000 100%);">
                                    <svg class="w-28 h-28 text-white animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                    </svg>
                                </div>
                                <div class="absolute inset-0 w-48 h-48 rounded-full animate-ping opacity-20" style="background: #D12423;"></div>
                            </div>

                            <h2 class="text-6xl font-black text-white mb-6 uppercase tracking-wider drop-shadow-2xl">${this.state.message}</h2>
                            <p class="text-3xl font-bold" style="color: #D12423;">Por favor espera...</p>
                        </div>
                    </div>
                `;
            }

            renderSuccess() {
                const { cliente, diasRestantes, similarity, deuda, membresia } = this.state;
                return `
                    <div style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%); height: 100vh; overflow: hidden; position: relative; display: flex; flex-direction: column;">
                        <!-- Fondo decorativo -->
                        <div style="position: absolute; inset: 0; opacity: 0.12; pointer-events: none;">
                            <div style="position: absolute; top: -80px; left: -80px; width: 400px; height: 400px; border-radius: 50%; background: #00C851; filter: blur(80px);"></div>
                            <div style="position: absolute; bottom: -80px; right: -80px; width: 400px; height: 400px; border-radius: 50%; background: #D12423; filter: blur(80px);"></div>
                        </div>

                        <!-- HEADER: Logo + Título + Ícono check en una sola fila -->
                        <div style="position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 18px 48px; border-bottom: 2px solid rgba(0,200,81,0.25); flex-shrink: 0;">
                            <img src="/images/tauro-gym-logo.png" alt="TAURO GYM" style="height: 64px; width: 64px; object-fit: contain; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.8));" />
                            <h2 style="font-size: 2.4rem; font-weight: 900; color: #fff; text-transform: uppercase; letter-spacing: 0.08em; margin: 0;">¡Acceso Autorizado!</h2>
                            <div style="position: relative;">
                                <div style="width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #00C851, #007E33); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 24px rgba(0,200,81,0.5);">
                                    <svg style="width: 38px; height: 38px; color: #fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <div style="position: absolute; inset: 0; width: 64px; height: 64px; border-radius: 50%; background: #00C851; animation: ping 1.5s cubic-bezier(0,0,0.2,1) infinite; opacity: 0.25;"></div>
                            </div>
                        </div>

                        <!-- BODY: Foto + Info + Deuda en grid horizontal -->
                        <div style="position: relative; z-index: 10; flex: 1; display: flex; align-items: center; justify-content: center; padding: 16px 48px; gap: 32px; min-height: 0;">

                            <!-- Columna izquierda: Foto del cliente -->
                            ${cliente.fotoBase64 ? `
                                <div style="flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 12px;">
                                    <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                         alt="${cliente.nombre}"
                                         style="width: 200px; height: 200px; border-radius: 50%; object-fit: cover; box-shadow: 0 8px 40px rgba(0,0,0,0.8); border: 5px solid #D12423;" />
                                    ${similarity ? `
                                        <div style="background: rgba(209,36,35,0.15); border: 1px solid rgba(209,36,35,0.5); border-radius: 8px; padding: 6px 14px; text-align: center;">
                                            <p style="font-size: 0.75rem; color: #D12423; font-weight: 700;">🔒 ${similarity.toFixed(1)}% coincidencia</p>
                                        </div>
                                    ` : ''}
                                </div>
                            ` : ''}

                            <!-- Columna centro: Nombre + Plan + Días restantes -->
                            <div style="flex: 1; background: rgba(0,0,0,0.6); backdrop-filter: blur(10px); border: 2px solid #00C851; border-radius: 20px; padding: 28px 36px; min-width: 0;">
                                <h3 style="font-size: 2.6rem; font-weight: 900; color: #fff; margin: 0 0 16px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${cliente.nombre}</h3>

                                ${membresia?.tipoPlan ? `
                                    <div style="display: inline-block; background: rgba(209,36,35,0.2); border: 2px solid #D12423; border-radius: 10px; padding: 6px 16px; margin-bottom: 20px;">
                                        <p style="font-size: 0.7rem; color: #D12423; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin: 0;">Plan Activo</p>
                                        <p style="font-size: 1.4rem; font-weight: 900; color: #fff; margin: 0;">${membresia.tipoPlan}</p>
                                    </div>
                                ` : ''}

                                ${diasRestantes !== null && diasRestantes !== undefined ? `
                                    <div style="border-top: 2px solid rgba(255,255,255,0.15); padding-top: 16px; margin-top: 4px;">
                                        <p style="font-size: 0.85rem; color: #00C851; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 6px 0;">Días Restantes de Membresía</p>
                                        <p style="font-size: 3.5rem; font-weight: 900; margin: 0; color: ${diasRestantes <= 3 ? '#FACC15' : '#fff'};">
                                            ${diasRestantes} ${diasRestantes === 1 ? 'DÍA' : 'DÍAS'}
                                        </p>
                                    </div>
                                ` : ''}

                                <!-- Mensaje motivacional compacto -->
                                <div style="margin-top: 20px; padding-top: 16px; border-top: 2px solid rgba(255,255,255,0.12);">
                                    <p style="font-size: 1.1rem; color: #fff; font-weight: 700; margin: 0;">¡Sin prisa, pero con DISCIPLINA! 💪</p>
                                    <p style="font-size: 0.95rem; color: #D12423; font-weight: 600; margin: 4px 0 0 0;">(Insiste, Persiste, Resiste)</p>
                                </div>
                            </div>

                            <!-- Columna derecha: Deuda (solo si existe) -->
                            ${deuda && deuda.tieneDeuda ? `
                                <div style="flex-shrink: 0; width: 280px; background: rgba(0,0,0,0.7); backdrop-filter: blur(10px); border: 3px solid #FFA500; border-radius: 20px; padding: 24px 28px; text-align: center;">
                                    <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(255,165,0,0.2); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;">
                                        <svg style="width: 30px; height: 30px; color: #FFA500;" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                    <p style="font-size: 0.75rem; color: #FFA500; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 8px 0;">⚠️ Deuda Pendiente</p>
                                    <p style="font-size: 2.8rem; font-weight: 900; color: #FFA500; margin: 0 0 8px 0; animation: pulse 2s infinite; text-shadow: 0 0 20px rgba(255,165,0,0.4);">
                                        $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                    </p>
                                    <p style="font-size: 0.9rem; color: #FFA500; font-weight: 600; margin: 0 0 10px 0;">
                                        ${deuda.cantidadDeudas} ${deuda.cantidadDeudas === 1 ? 'pago pendiente' : 'pagos pendientes'}
                                    </p>
                                    <p style="font-size: 0.85rem; color: #fff; font-weight: 600; margin: 0;">Acércate a recepción</p>
                                </div>
                            ` : ''}
                        </div>

                        <!-- FOOTER: barra inferior con mensaje -->
                        <div style="position: relative; z-index: 10; text-align: center; padding: 14px 48px; border-top: 2px solid rgba(0,200,81,0.2); flex-shrink: 0;">
                            <p style="font-size: 1rem; color: rgba(255,255,255,0.5); margin: 0;">Check-In registrado correctamente · TAURO GYM</p>
                        </div>

                    </div>
                `;
            }

            // ========== NUEVA PANTALLA: CHECK-IN DUPLICADO ==========
            renderAlreadyCheckedIn() {
                const { cliente, message, ultimoCheckIn } = this.state;
                return `
                    <div style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%); height: 100vh; overflow: hidden; position: relative; display: flex; flex-direction: column;">
                        <div style="position: absolute; inset: 0; opacity: 0.12; pointer-events: none;">
                            <div style="position: absolute; top: -80px; left: -80px; width: 400px; height: 400px; border-radius: 50%; background: #FFA500; filter: blur(80px);"></div>
                            <div style="position: absolute; bottom: -80px; right: -80px; width: 400px; height: 400px; border-radius: 50%; background: #D12423; filter: blur(80px);"></div>
                        </div>

                        <!-- HEADER -->
                        <div style="position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 18px 48px; border-bottom: 2px solid rgba(255,165,0,0.3); flex-shrink: 0;">
                            <img src="/images/tauro-gym-logo.png" alt="TAURO GYM" style="height: 64px; width: 64px; object-fit: contain; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.8));" />
                            <h2 style="font-size: 2.4rem; font-weight: 900; color: #fff; text-transform: uppercase; letter-spacing: 0.08em; margin: 0;">¡Ya Registrado Hoy!</h2>
                            <div style="position: relative;">
                                <div style="width: 64px; height: 64px; border-radius: 50%; background: #FFA500; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 24px rgba(255,165,0,0.5);">
                                    <svg style="width: 38px; height: 38px; color: #fff;" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                    </svg>
                                </div>
                                <div style="position: absolute; inset: 0; width: 64px; height: 64px; border-radius: 50%; background: #FFA500; animation: ping 1.5s cubic-bezier(0,0,0.2,1) infinite; opacity: 0.25;"></div>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div style="position: relative; z-index: 10; flex: 1; display: flex; align-items: center; justify-content: center; padding: 20px 48px; gap: 32px; min-height: 0;">
                            ${cliente?.fotoBase64 ? `
                                <div style="flex-shrink: 0;">
                                    <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                         alt="${cliente?.nombre}"
                                         style="width: 180px; height: 180px; border-radius: 50%; object-fit: cover; box-shadow: 0 8px 40px rgba(0,0,0,0.8); border: 5px solid #FFA500;" />
                                </div>
                            ` : ''}

                            <div style="flex: 1; background: rgba(0,0,0,0.65); backdrop-filter: blur(10px); border: 2px solid #FFA500; border-radius: 20px; padding: 28px 36px;">
                                <h3 style="font-size: 2.4rem; font-weight: 900; color: #fff; margin: 0 0 12px 0;">${cliente?.nombre || 'Usuario'}</h3>
                                <p style="font-size: 1.3rem; color: #fff; font-weight: 700; margin: 0 0 20px 0; padding-bottom: 16px; border-bottom: 2px solid rgba(255,255,255,0.15);">${message}</p>

                                ${ultimoCheckIn ? `
                                    <div>
                                        <p style="font-size: 0.8rem; color: #FFA500; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 8px 0;">⏰ Último Check-In registrado</p>
                                        <p style="font-size: 3.5rem; font-weight: 900; color: #FFA500; margin: 0 0 8px 0;">${ultimoCheckIn.horaFormateada}</p>
                                        <p style="font-size: 1rem; color: rgba(255,255,255,0.7); margin: 0 0 4px 0;">Hace ${ultimoCheckIn.horasTranscurridas.toFixed(1)} horas</p>
                                        <p style="font-size: 0.95rem; color: rgba(255,255,255,0.55); margin: 0;">Podrás registrar nuevamente en ${ultimoCheckIn.horasRestantes.toFixed(1)} horas</p>
                                    </div>
                                ` : ''}

                                <div style="margin-top: 20px; padding-top: 16px; border-top: 2px solid rgba(255,165,0,0.3);">
                                    <p style="font-size: 1.1rem; color: #fff; font-weight: 700; margin: 0;">¡Sigue con tu rutina! 💪</p>
                                    <p style="font-size: 0.9rem; color: #D12423; font-weight: 600; margin: 4px 0 0 0;">(Insiste, Persiste, Resiste)</p>
                                </div>
                            </div>
                        </div>

                        <!-- FOOTER -->
                        <div style="position: relative; z-index: 10; display: flex; justify-content: center; padding: 16px 48px; border-top: 2px solid rgba(255,165,0,0.2); flex-shrink: 0;">
                            <button onclick="app.reset(); app.startFingerprintDetection();"
                                style="padding: 14px 48px; background: #FFA500; color: #fff; border: none; border-radius: 12px; font-size: 1.1rem; font-weight: 900; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em;"
                                onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                ENTENDIDO
                            </button>
                        </div>

                    </div>
                `;
            }
            // =========================================================

            renderError() {
                const { diasVencidos, deuda, membresia } = this.state;
                return `
                    <div style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%); height: 100vh; overflow: hidden; position: relative; display: flex; flex-direction: column;">
                        <div style="position: absolute; inset: 0; opacity: 0.12; pointer-events: none;">
                            <div style="position: absolute; top: -80px; left: -80px; width: 400px; height: 400px; border-radius: 50%; background: #D12423; filter: blur(80px);"></div>
                            <div style="position: absolute; bottom: -80px; right: -80px; width: 400px; height: 400px; border-radius: 50%; background: #D12423; filter: blur(80px);"></div>
                        </div>

                        <!-- HEADER -->
                        <div style="position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 18px 48px; border-bottom: 2px solid rgba(209,36,35,0.3); flex-shrink: 0;">
                            <img src="/images/tauro-gym-logo.png" alt="TAURO GYM" style="height: 64px; width: 64px; object-fit: contain; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.8));" />
                            <h2 style="font-size: 2.4rem; font-weight: 900; color: #fff; text-transform: uppercase; letter-spacing: 0.08em; margin: 0;">Acceso Denegado</h2>
                            <div style="position: relative;">
                                <div style="width: 64px; height: 64px; border-radius: 50%; background: #D12423; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 24px rgba(209,36,35,0.5);">
                                    <svg style="width: 38px; height: 38px; color: #fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div style="position: relative; z-index: 10; flex: 1; display: flex; align-items: center; justify-content: center; padding: 20px 48px; gap: 32px; min-height: 0;">
                            <div style="flex: 1; max-width: 680px; background: rgba(0,0,0,0.65); backdrop-filter: blur(10px); border: 2px solid #D12423; border-radius: 20px; padding: 32px 40px; text-align: center;">
                                <p style="font-size: 1.6rem; color: #fff; font-weight: 800; margin: 0 0 20px 0;">${this.state.message}</p>
                                ${membresia?.tipoPlan ? `
                                    <div style="display: inline-block; background: rgba(209,36,35,0.15); border: 2px solid rgba(209,36,35,0.5); border-radius: 10px; padding: 8px 20px; margin-bottom: 20px;">
                                        <p style="font-size: 0.7rem; color: #D12423; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin: 0;">Último Plan</p>
                                        <p style="font-size: 1.4rem; font-weight: 900; color: #fff; margin: 0;">${membresia.tipoPlan}</p>
                                    </div>
                                ` : ''}
                                ${diasVencidos !== null && diasVencidos !== undefined && diasVencidos > 0 ? `
                                    <div style="border-top: 2px solid rgba(209,36,35,0.4); padding-top: 20px; margin-top: 8px;">
                                        <p style="font-size: 0.85rem; color: #D12423; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 8px 0;">Membresía vencida hace</p>
                                        <p style="font-size: 4rem; font-weight: 900; color: #FFA500; margin: 0 0 8px 0;">
                                            ${diasVencidos} ${diasVencidos === 1 ? 'DÍA' : 'DÍAS'}
                                        </p>
                                        <p style="font-size: 1rem; color: #fff; font-weight: 600; margin: 0;">Renueva en recepción para volver a entrenar</p>
                                    </div>
                                ` : ''}
                                <div style="margin-top: 24px; padding-top: 16px; border-top: 2px solid rgba(209,36,35,0.3);">
                                    <p style="font-size: 1.05rem; color: rgba(255,255,255,0.8); font-weight: 600; margin: 0;">Dirígete a recepción para asistencia</p>
                                </div>
                            </div>
                            ${deuda && deuda.tieneDeuda ? `
                                <div style="flex-shrink: 0; width: 280px; background: rgba(0,0,0,0.7); backdrop-filter: blur(10px); border: 3px solid #FFA500; border-radius: 20px; padding: 28px; text-align: center;">
                                    <p style="font-size: 0.75rem; color: #FFA500; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 10px 0;">⚠️ Monto Pendiente</p>
                                    <p style="font-size: 2.8rem; font-weight: 900; color: #FFA500; margin: 0 0 8px 0; animation: pulse 2s infinite; text-shadow: 0 0 20px rgba(255,165,0,0.4);">
                                        $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                    </p>
                                    <p style="font-size: 0.9rem; color: #FFA500; font-weight: 600; margin: 0 0 10px 0;">
                                        ${deuda.cantidadDeudas} ${deuda.cantidadDeudas === 1 ? 'pago pendiente' : 'pagos pendientes'}
                                    </p>
                                    <p style="font-size: 0.85rem; color: #fff; font-weight: 600; margin: 0;">Recuerda ponerte al día</p>
                                </div>
                            ` : ''}
                        </div>

                        <!-- FOOTER -->
                        <div style="position: relative; z-index: 10; display: flex; justify-content: center; padding: 16px 48px; border-top: 2px solid rgba(209,36,35,0.2); flex-shrink: 0;">
                            <button onclick="app.reset(); app.startFingerprintDetection();"
                                style="padding: 14px 48px; background: #D12423; color: #fff; border: none; border-radius: 12px; font-size: 1.1rem; font-weight: 900; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em;"
                                onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                VOLVER AL INICIO
                            </button>
                        </div>


                        <div style="display:none;"><!-- cierre legacy --></div>
                    </div>
                `;
            }

            render() {
                const container = document.getElementById('kiosko-app');
                let html = '';
                let cursorPosition = null;
                const activeInput = document.getElementById('cedula-input');
                if (activeInput && this.state.mode === 'cedula') {
                    cursorPosition = activeInput.selectionStart;
                }

                switch(this.state.mode) {
                    case 'idle': html = this.renderIdle(); break;
                    case 'cedula': html = this.renderCedula(); break;
                    case 'scanning': html = this.renderScanning(); break;
                    case 'success': html = this.renderSuccess(); break;
                    case 'error': html = this.renderError(); break;
                    case 'already-checked-in': html = this.renderAlreadyCheckedIn(); break; // NUEVO
                }

                container.innerHTML = html;

                if (this.state.mode === 'cedula') {
                    setTimeout(() => {
                        const input = document.getElementById('cedula-input');
                        if (input) {
                            input.focus();
                            if (cursorPosition !== null) {
                                const newPosition = Math.min(cursorPosition, input.value.length);
                                input.setSelectionRange(newPosition, newPosition);
                            }
                        }
                    }, 100);
                }
            }
        }

        const app = new KioskoApp();
    </script>
}

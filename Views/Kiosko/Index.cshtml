@{
    Layout = "_Layout";
    ViewData["Title"] = "Check-In JONELGYM";
}

<div id="kiosko-app" class="min-h-screen"></div>

@section Scripts {
    <script>
        class KioskoApp {
            constructor() {
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null
                };
                this.fingerprintCheckInterval = null;
                this.render();
                this.startClock();
                this.startFingerprintDetection();
            }

            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.render();

                if (this.state.mode === 'success' || this.state.mode === 'error') {
                    this.stopFingerprintDetection();
                    setTimeout(() => {
                        this.reset();
                        this.startFingerprintDetection();
                    }, 6000);
                }
            }

            reset() {
                this.setState({
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null
                });
            }

            startClock() {
                setInterval(() => {
                    const timeEl = document.getElementById('clock-time');
                    const dateEl = document.getElementById('clock-date');
                    if (timeEl && dateEl) {
                        const now = new Date();
                        timeEl.textContent = now.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });
                        dateEl.textContent = now.toLocaleDateString('es-ES', {
                            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                        });
                    }
                }, 1000);
            }

            startFingerprintDetection() {
                this.fingerprintCheckInterval = setInterval(async () => {
                    if (this.state.mode === 'idle' && !this.state.isProcessing) {
                        await this.checkFingerprintSensor();
                    }
                }, 800);
            }

            stopFingerprintDetection() {
                if (this.fingerprintCheckInterval) {
                    clearInterval(this.fingerprintCheckInterval);
                    this.fingerprintCheckInterval = null;
                }
            }

            async checkFingerprintSensor() {
                if (this.state.isProcessing) return;

                try {
                    this.state.isProcessing = true;
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 2000);

                    const response = await fetch('/kiosko/checkin-huella', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);
                    const data = await response.json();

                    if (data.cliente || data.useCedula) {
                        this.state.isProcessing = false;
                        await this.handleFingerprintDetected(data);
                    } else {
                        this.state.isProcessing = false;
                    }
                } catch (error) {
                    this.state.isProcessing = false;
                }
            }

            async handleFingerprintDetected(data) {
                this.stopFingerprintDetection();

                if (data.useCedula && !data.cliente) {
                    this.setState({
                        mode: 'cedula',
                        message: data.message || 'Huella no reconocida. Usa tu cédula.'
                    });
                    return;
                }

                this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                await new Promise(resolve => setTimeout(resolve, 1500));

                if (data.success && data.cliente) {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'success',
                        cliente: data.cliente,
                        diasRestantes: diasRestantes,
                        message: data.message,
                        similarity: data.similarity,
                        deuda: data.deuda || null
                    });
                } else {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'error',
                        message: data.message || 'No se pudo verificar la huella',
                        diasRestantes: diasRestantes,
                        deuda: data.deuda || null
                    });
                }
            }

            async handleCedulaConsulta() {
                if (!this.state.cedula.trim()) {
                    this.setState({ message: 'Por favor ingresa tu cédula' });
                    return;
                }

                this.stopFingerprintDetection();
                this.setState({ mode: 'scanning', message: 'Consultando información...' });

                try {
                    const response = await fetch('/api/CheckIn/cedula', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cedula: this.state.cedula })
                    });

                    const data = await response.json();

                    if (data.success && data.cliente) {
                        const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                        this.setState({
                            mode: 'success',
                            cliente: data.cliente,
                            diasRestantes: diasRestantes,
                            message: data.message,
                            deuda: data.deuda || null
                        });
                    } else {
                        this.setState({
                            mode: 'error',
                            message: data.message || 'No se pudo verificar la cédula',
                            deuda: data.deuda || null
                        });
                    }
                } catch (error) {
                    this.setState({
                        mode: 'error',
                        message: 'Error al consultar cédula. Intenta nuevamente.'
                    });
                }
            }

            renderIdle() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-20 left-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                            <div class="absolute bottom-20 right-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="mb-12 animate-pulse">
                                <img src="/images/logo-nelson.png" alt="JONELGYM" class="h-40 w-40 object-contain drop-shadow-2xl" />
                            </div>

                            <h1 class="text-8xl font-black text-white mb-6 uppercase tracking-wider text-center">Bienvenido</h1>
                            <p class="text-3xl mb-12 uppercase tracking-wide font-semibold text-center" style="color: #FF8C00;">JONELGYM</p>

                            <div class="backdrop-blur-sm rounded-3xl px-16 py-12 max-w-2xl" style="background: rgba(0,0,0,0.6); border: 3px solid #FF8C00;">
                                <div class="flex items-center justify-center mb-8">
                                    <div class="w-24 h-24 rounded-full flex items-center justify-center animate-pulse" style="background: #FF8C00;">
                                        <svg class="w-14 h-14 text-white" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                </div>
                                <p class="text-4xl text-white font-bold text-center mb-4">Coloca tu huella</p>
                                <p class="text-2xl text-center font-semibold" style="color: #FF8C00;">en el lector</p>
                            </div>

                            <div class="mt-16 text-center">
                                <p class="text-xl text-white mb-4">¿No tienes huella registrada?</p>
                                <button onclick="app.setState({ mode: 'cedula', cedula: '' })"
                                    class="px-10 py-4 text-white rounded-xl text-lg font-bold transition-all duration-300 transform hover:scale-105" style="background: #FF8C00;">
                                    INGRESAR CON CÉDULA
                                </button>
                            </div>

                            <div class="mt-16 text-center">
                                <p id="clock-time" class="text-3xl text-white font-bold mb-2"></p>
                                <p id="clock-date" class="text-lg font-semibold capitalize" style="color: #FF8C00;"></p>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderCedula() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-20 left-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                            <div class="absolute bottom-20 right-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="mb-12">
                                <img src="/images/logo-nelson.png" alt="JONELGYM" class="h-32 w-32 object-contain drop-shadow-2xl" />
                            </div>

                            <h1 class="text-7xl font-black text-white mb-4 uppercase tracking-wider">Identificación</h1>
                            <p class="text-2xl mb-12 uppercase tracking-wide font-semibold" style="color: #FF8C00;">Ingresa tu cédula</p>

                            <div class="backdrop-blur-sm rounded-3xl px-16 py-12 max-w-2xl" style="background: rgba(0,0,0,0.6); border: 3px solid #FF8C00;">
                                <input id="cedula-input" type="text" placeholder="000-0000000-0"
                                    value="${this.state.cedula}"
                                    oninput="app.setState({ cedula: this.value })"
                                    onkeypress="if(event.key === 'Enter') app.handleCedulaConsulta()"
                                    class="w-full px-8 py-6 text-4xl text-center text-white rounded-xl font-bold focus:outline-none"
                                    style="background: rgba(0,0,0,0.7); border: 2px solid #FF8C00;"
                                    maxlength="13" />

                                ${this.state.message ? `
                                    <p class="text-xl text-center mt-6 font-semibold" style="color: #FFA500;">
                                        ${this.state.message}
                                    </p>
                                ` : ''}

                                <div class="flex gap-4 mt-8">
                                    <button onclick="app.handleCedulaConsulta()"
                                        class="flex-1 px-8 py-5 text-white rounded-xl text-2xl font-bold transition-all duration-300 transform hover:scale-105" style="background: #FF8C00;">
                                        CONSULTAR
                                    </button>
                                    <button onclick="app.reset(); app.startFingerprintDetection();"
                                        class="flex-1 px-8 py-5 text-white rounded-xl text-2xl font-bold transition-all duration-300 transform hover:scale-105" style="background: #666;">
                                        VOLVER
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderScanning() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-20 left-20 w-96 h-96 rounded-full filter blur-3xl animate-pulse" style="background: #FF8C00;"></div>
                            <div class="absolute bottom-20 right-20 w-96 h-96 rounded-full filter blur-3xl animate-pulse" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center">
                                <div class="mb-12 flex justify-center">
                                    <div class="relative">
                                        <div class="w-48 h-48 rounded-full flex items-center justify-center animate-spin" style="background: linear-gradient(45deg, #FF8C00, transparent);">
                                            <div class="w-40 h-40 rounded-full" style="background: #1a1a1a;"></div>
                                        </div>
                                        <div class="absolute inset-0 flex items-center justify-center">
                                            <svg class="w-20 h-20 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-6 uppercase tracking-wider">${this.state.message}</h2>
                                <div class="flex justify-center space-x-3">
                                    <div class="w-4 h-4 rounded-full animate-bounce" style="background: #FF8C00; animation-delay: 0s;"></div>
                                    <div class="w-4 h-4 rounded-full animate-bounce" style="background: #FF8C00; animation-delay: 0.2s;"></div>
                                    <div class="w-4 h-4 rounded-full animate-bounce" style="background: #FF8C00; animation-delay: 0.4s;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderSuccess() {
                const { cliente, diasRestantes, similarity, deuda } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-10 left-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #00FF00;"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8 py-12">
                            <div class="max-w-6xl w-full flex gap-8">
                                <!-- Foto del cliente -->
                                <div class="flex-shrink-0">
                                    ${cliente?.fotoBase64 ? `
                                        <div class="w-80 h-80 rounded-3xl overflow-hidden shadow-2xl" style="border: 5px solid #00FF00;">
                                            <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                                alt="${cliente.nombre}"
                                                class="w-full h-full object-cover" />
                                        </div>
                                    ` : `
                                        <div class="w-80 h-80 rounded-3xl flex items-center justify-center shadow-2xl" style="background: rgba(0,255,0,0.1); border: 5px solid #00FF00;">
                                            <svg class="w-40 h-40" style="color: #00FF00;" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                    `}
                                </div>

                                <!-- Información -->
                                <div class="flex-1">
                                    <!-- Logo -->
                                    <div class="mb-6 flex justify-center">
                                        <img src="/images/logo-nelson.png" alt="JONELGYM" class="h-24 w-24 object-contain drop-shadow-2xl" />
                                    </div>

                                    <h2 class="text-7xl font-black mb-8 uppercase tracking-wider" style="color: #00FF00;">Acceso Permitido</h2>

                                    <div class="backdrop-blur-sm rounded-3xl px-10 py-8" style="background: rgba(0,0,0,0.6); border: 3px solid #00FF00;">
                                        <p class="text-5xl font-black text-white mb-6">${cliente?.nombre || 'Usuario'}</p>

                                        <!-- Estado de Membresía -->
                                        <div class="mb-6">
                                            <p class="text-xl mb-3 uppercase tracking-wide font-semibold" style="color: #FF8C00;">Estado de Membresía</p>
                                            <p class="text-4xl font-black ${
                                                diasRestantes !== null && diasRestantes !== undefined ? 'text-white' : ''
                                            }" style="${diasRestantes === null || diasRestantes === undefined ? 'color: #FFA500;' : ''}">
                                                ${this.state.message}
                                            </p>
                                        </div>

                                        <!-- Días restantes -->
                                        ${diasRestantes !== null && diasRestantes !== undefined ? `
                                            <div class="pt-6 mt-6" style="border-top: 2px solid rgba(255, 140, 0, 0.3);">
                                                <p class="text-lg mb-3 uppercase tracking-wide" style="color: #FF8C00;">
                                                    ${diasRestantes <= 7 ? 'Tiempo Restante' : 'Vigencia'}
                                                </p>
                                                <p class="text-7xl font-black" style="color: ${
                                                    diasRestantes <= 3 ? '#FFA500' : '#FFFFFF'
                                                };">
                                                    ${diasRestantes} ${diasRestantes === 1 ? 'DÍA' : 'DÍAS'}
                                                </p>
                                                ${diasRestantes <= 7 ? `
                                                    <p class="text-xl mt-4 font-semibold" style="color: #FFA500;">
                                                        ⚠️ Renueva pronto tu membresía
                                                    </p>
                                                ` : ''}
                                            </div>
                                        ` : ''}


                                        <!-- Peso del Cliente -->
                                        ${cliente?.peso ? `
                                            <div class="pt-6 mt-6" style="border-top: 2px solid rgba(255, 140, 0, 0.3);">
                                                <p class="text-lg mb-3 uppercase tracking-wide flex items-center gap-2" style="color: #FF8C00;">
                                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                                                        <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
                                                    </svg>
                                                    Peso Registrado
                                                </p>
                                                <p class="text-6xl font-black text-white">
                                                    ${parseFloat(cliente.peso).toFixed(1)} kg
                                                </p>
                                            </div>
                                        ` : ''}
                                        <!-- Información de Deuda -->
                                        ${deuda && deuda.tieneDeuda ? `
                                            <div class="pt-6 mt-6" style="border-top: 2px solid rgba(255, 140, 0, 0.3);">
                                                <div class="flex items-center gap-3 mb-3">
                                                    <svg class="w-8 h-8" style="color: #FFA500;" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                    </svg>
                                                    <p class="text-xl uppercase tracking-wide font-semibold" style="color: #FFA500;">Tienes un monto pendiente</p>
                                                </div>
                                                <p class="text-6xl font-black mb-3" style="color: #FFA500;">
                                                    $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                                </p>
                                                <p class="text-lg font-semibold" style="color: #FFA500;">
                                                    💰 Recuerda ponerte al día
                                                </p>
                                                ${deuda.cantidadDeudas > 1 ? `
                                                    <p class="text-base mt-2 text-white">
                                                        (${deuda.cantidadDeudas} deudas pendientes)
                                                    </p>
                                                ` : ''}
                                            </div>
                                        ` : ''}

                                        <!-- Verificación de similitud -->
                                        ${similarity ? `
                                            <div class="mt-6 pt-6" style="border-top: 2px solid rgba(255, 140, 0, 0.3);">
                                                <p class="text-lg font-semibold" style="color: #FF8C00;">
                                                    🔒 Verificación: ${similarity.toFixed(1)}% de coincidencia
                                                </p>
                                            </div>
                                        ` : ''}
                                    </div>

                                    <!-- Mensaje motivacional -->
                                    <div class="mt-8 space-y-3">
                                        <p class="text-3xl text-white font-bold">¡Sin prisa, pero con ¡DISCIPLINA!</p>
                                        <p class="text-2xl font-semibold" style="color: #FF8C00;">(Insiste, Persiste, Resiste)</p>
                                        <p class="text-xl text-white mt-3">Da lo mejor de ti 💪</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderError() {
                const { diasRestantes, deuda } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-10 left-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF4444;"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-3xl">
                                <!-- Logo -->
                                <div class="mb-8 flex justify-center">
                                    <img src="/images/logo-nelson.png" alt="JONELGYM" class="h-32 w-32 object-contain drop-shadow-2xl" />
                                </div>

                                <!-- Error Icon -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-40 h-40 rounded-full flex items-center justify-center shadow-2xl" style="background: #FF4444;">
                                            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-40 h-40 rounded-full animate-ping opacity-20" style="background: #FF4444;"></div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-8 uppercase tracking-wider">Acceso Denegado</h2>

                                <div class="backdrop-blur-sm rounded-3xl px-12 py-10 mb-10" style="background: rgba(0,0,0,0.6); border: 3px solid #FF4444;">
                                    <div class="mb-6 flex justify-center">
                                        <div class="w-20 h-20 rounded-full flex items-center justify-center" style="background: #FF4444;">
                                            <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                    </div>

                                    <p class="text-3xl text-white mb-4 font-bold">${this.state.message}</p>

                                    ${diasRestantes !== null && diasRestantes !== undefined && diasRestantes < 0 ? `
                                        <div class="pt-6 mt-6" style="border-top: 2px solid rgba(255, 68, 68, 0.5);">
                                            <p class="text-lg mb-3 uppercase tracking-wide font-semibold" style="color: #FF8C00;">Membresía Vencida</p>
                                            <p class="text-5xl font-black" style="color: #FFA500;">
                                                ${Math.abs(diasRestantes)} ${Math.abs(diasRestantes) === 1 ? 'DÍA' : 'DÍAS'}
                                            </p>
                                            <p class="text-white text-lg mt-3">desde su vencimiento</p>
                                        </div>
                                    ` : ''}

                                    <!-- Información de Deuda en Error -->
                                    ${deuda && deuda.tieneDeuda ? `
                                        <div class="pt-6 mt-6" style="border-top: 2px solid rgba(255, 68, 68, 0.5);">
                                            <div class="flex items-center justify-center gap-3 mb-3">
                                                <svg class="w-8 h-8" style="color: #FFA500;" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                </svg>
                                                <p class="text-lg uppercase tracking-wide font-semibold" style="color: #FFA500;">Monto Pendiente</p>
                                            </div>
                                            <p class="text-5xl font-black mb-2" style="color: #FFA500;">
                                                ${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                            </p>
                                            <p class="text-base font-semibold" style="color: #FFA500;">
                                                Recuerda ponerte al día
                                            </p>
                                        </div>
                                    ` : ''}

                                    <div class="mt-8 pt-6" style="border-top: 2px solid rgba(255, 68, 68, 0.5);">
                                        <p class="text-xl text-white font-semibold">Dirígete a recepción para asistencia</p>
                                    </div>
                                </div>

                                <button onclick="app.reset(); app.startFingerprintDetection();"
                                    class="px-12 py-5 text-white rounded-xl text-xl font-bold transition-all duration-300 transform hover:scale-105" style="background: #FF8C00;">
                                    VOLVER AL INICIO
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            render() {
                const container = document.getElementById('kiosko-app');
                let html = '';
                let cursorPosition = null;
                const activeInput = document.getElementById('cedula-input');
                if (activeInput && this.state.mode === 'cedula') {
                    cursorPosition = activeInput.selectionStart;
                }

                switch(this.state.mode) {
                    case 'idle': html = this.renderIdle(); break;
                    case 'cedula': html = this.renderCedula(); break;
                    case 'scanning': html = this.renderScanning(); break;
                    case 'success': html = this.renderSuccess(); break;
                    case 'error': html = this.renderError(); break;
                }

                container.innerHTML = html;

                if (this.state.mode === 'cedula') {
                    setTimeout(() => {
                        const input = document.getElementById('cedula-input');
                        if (input) {
                            input.focus();
                            if (cursorPosition !== null) {
                                const newPosition = Math.min(cursorPosition, input.value.length);
                                input.setSelectionRange(newPosition, newPosition);
                            }
                        }
                    }, 100);
                }
            }
        }

        const app = new KioskoApp();
    </script>
}
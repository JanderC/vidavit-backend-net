@{
    Layout = "_Layout";
    ViewData["Title"] = "Check-In JONELGYM";
}

<div id="kiosko-app" class="min-h-screen"></div>

@section Scripts {
    <script>
        class KioskoApp {
            constructor() {
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    yaRegistrado: false,
                    ultimoCheckIn: null
                };
                this.fingerprintCheckInterval = null;
                this.render();
                this.startClock();
                this.startFingerprintDetection();
            }

            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.render();

                if (this.state.mode === 'success' || this.state.mode === 'error' || this.state.mode === 'duplicado') {
                    this.stopFingerprintDetection();
                    setTimeout(() => {
                        this.reset();
                        this.startFingerprintDetection();
                    }, 6000);
                }
            }

            reset() {
                this.setState({
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    yaRegistrado: false,
                    ultimoCheckIn: null
                });
            }

            startClock() {
                setInterval(() => {
                    const timeEl = document.getElementById('clock-time');
                    const dateEl = document.getElementById('clock-date');
                    if (timeEl && dateEl) {
                        const now = new Date();
                        timeEl.textContent = now.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });
                        dateEl.textContent = now.toLocaleDateString('es-ES', {
                            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                        });
                    }
                }, 1000);
            }

            startFingerprintDetection() {
                this.fingerprintCheckInterval = setInterval(async () => {
                    if (this.state.mode === 'idle' && !this.state.isProcessing) {
                        await this.checkFingerprintSensor();
                    }
                }, 800);
            }

            stopFingerprintDetection() {
                if (this.fingerprintCheckInterval) {
                    clearInterval(this.fingerprintCheckInterval);
                    this.fingerprintCheckInterval = null;
                }
            }

            async checkFingerprintSensor() {
                if (this.state.isProcessing) return;

                try {
                    this.state.isProcessing = true;
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 2000);

                    const response = await fetch('/kiosko/checkin-huella', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);
                    const data = await response.json();

                    if (data.cliente || data.useCedula) {
                        this.state.isProcessing = false;
                        await this.handleFingerprintDetected(data);
                    } else {
                        this.state.isProcessing = false;
                    }
                } catch (error) {
                    this.state.isProcessing = false;
                }
            }

            async handleFingerprintDetected(data) {
                this.stopFingerprintDetection();

                if (data.useCedula && !data.cliente) {
                    this.setState({
                        mode: 'cedula',
                        message: data.message || 'Huella no reconocida. Usa tu cédula.'
                    });
                    return;
                }

                this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                await new Promise(resolve => setTimeout(resolve, 1500));

                // ============= MANEJO DE CHECK-IN DUPLICADO =============
                if (!data.success && data.yaRegistrado) {
                    this.setState({
                        mode: 'duplicado',
                        cliente: data.cliente,
                        message: data.message,
                        ultimoCheckIn: data.ultimoCheckIn
                    });
                    return;
                }
                // ========================================================

                if (data.success && data.cliente) {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'success',
                        cliente: data.cliente,
                        diasRestantes: diasRestantes,
                        message: data.message,
                        similarity: data.similarity,
                        deuda: data.deuda || null
                    });
                } else {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'error',
                        message: data.message || 'No se pudo verificar la huella',
                        diasRestantes: diasRestantes,
                        deuda: data.deuda || null
                    });
                }
            }

            async handleCedulaConsulta() {
                if (!this.state.cedula.trim()) {
                    this.setState({ message: 'Por favor ingresa tu cédula' });
                    return;
                }

                this.setState({ mode: 'scanning', message: 'Verificando identidad...' });

                try {
                    const response = await fetch('/kiosko/checkin-cedula', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cedula: this.state.cedula })
                    });

                    const data = await response.json();

                    await new Promise(resolve => setTimeout(resolve, 1500));

                    // ============= MANEJO DE CHECK-IN DUPLICADO =============
                    if (!data.success && data.yaRegistrado) {
                        this.setState({
                            mode: 'duplicado',
                            cliente: data.cliente,
                            message: data.message,
                            ultimoCheckIn: data.ultimoCheckIn
                        });
                        return;
                    }
                    // ========================================================

                    if (data.success && data.cliente) {
                        const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                        this.setState({
                            mode: 'success',
                            cliente: data.cliente,
                            diasRestantes: diasRestantes,
                            message: data.message,
                            deuda: data.deuda || null
                        });
                    } else {
                        const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                        this.setState({
                            mode: 'error',
                            message: data.message || 'No se encontró registro',
                            diasRestantes: diasRestantes,
                            deuda: data.deuda || null
                        });
                    }
                } catch (error) {
                    this.setState({
                        mode: 'error',
                        message: 'Error al verificar la cédula'
                    });
                }
            }
            renderIdle() {
                return `
                    <div class="min-h-screen relative overflow-hidden bg-gradient-to-br from-gray-900 via-black to-gray-900">
                        <!-- Animated Background -->
                        <div class="absolute inset-0">
                            <div class="absolute top-0 left-0 w-full h-full opacity-30">
                                <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-orange-600 rounded-full blur-3xl animate-pulse"></div>
                                <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-orange-800 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
                            </div>
                            <!-- Grid Pattern -->
                            <div class="absolute inset-0" style="background-image: linear-gradient(rgba(244, 121, 32, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(244, 121, 32, 0.05) 1px, transparent 1px); background-size: 50px 50px;"></div>
                        </div>

                        <div class="relative z-10">
                            <!-- Header -->
                            <div class="pt-12 px-8">
                                <div class="flex justify-between items-start max-w-7xl mx-auto">
                                    <!-- Logo -->
                                    <div class="backdrop-blur-xl bg-white/10 rounded-3xl p-6 border-2 border-orange-500/30 shadow-2xl">
                                        <img src="/images/logo-nelson.png" alt="JONELGYM" class="h-20 w-20 object-contain drop-shadow-2xl" />
                                    </div>

                                    <!-- Clock -->
                                    <div class="text-right backdrop-blur-xl bg-white/10 rounded-3xl p-6 border-2 border-orange-500/30 shadow-2xl">
                                        <div id="clock-time" class="text-5xl font-black text-white tracking-wider">00:00:00</div>
                                        <div id="clock-date" class="text-sm font-bold text-orange-400 mt-2 uppercase tracking-wide">Cargando...</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Main Content -->
                            <div class="flex items-center justify-center min-h-[calc(100vh-200px)] px-8">
                                <div class="text-center max-w-4xl">
                                    <!-- Welcome -->
                                    <div class="mb-12">
                                        <h1 class="text-8xl font-black text-white mb-4 uppercase tracking-wider">
                                            Bienvenido
                                        </h1>
                                        <p class="text-2xl text-orange-400 font-bold uppercase tracking-widest">
                                            Sistema de Check-In
                                        </p>
                                    </div>

                                    <!-- Fingerprint Animation -->
                                    <div class="mb-16 flex justify-center">
                                        <div class="relative">
                                            <div class="w-64 h-64 rounded-full bg-gradient-to-br from-orange-600 to-orange-800 flex items-center justify-center shadow-2xl">
                                                <svg class="w-40 h-40 text-white animate-pulse" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M11.828 10.828L17.657 5H6.343L12.172 10.828C12.047 11.051 12 11.316 12 11.586C12 12.406 12.677 13.071 13.5 13.071S15 12.406 15 11.586C15 11.316 14.953 11.051 14.828 10.828L11.828 10.828Z"/>
                                                    <path d="M12 2C10.355 2 9 3.355 9 5C9 6.111 9.555 7.086 10.414 7.621V9.586L8 12V17C8 18.657 9.343 20 11 20H13C14.657 20 16 18.657 16 17V12L13.586 9.586V7.621C14.445 7.086 15 6.111 15 5C15 3.355 13.645 2 12 2ZM12 4C12.553 4 13 4.448 13 5C13 5.552 12.553 6 12 6C11.447 6 11 5.552 11 5C11 4.448 11.447 4 12 4Z"/>
                                                </svg>
                                            </div>
                                            <div class="absolute inset-0 w-64 h-64 rounded-full animate-ping bg-orange-500 opacity-20"></div>
                                            <div class="absolute -inset-4 w-72 h-72 rounded-full bg-gradient-to-r from-orange-600/20 to-orange-800/20 blur-xl"></div>
                                        </div>
                                    </div>

                                    <!-- Instructions -->
                                    <div class="backdrop-blur-xl bg-white/10 rounded-3xl p-10 border-2 border-orange-500/30 shadow-2xl">
                                        <div class="flex items-center justify-center gap-4 mb-6">
                                            <div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-orange-700 rounded-2xl flex items-center justify-center">
                                                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                                </svg>
                                            </div>
                                            <h2 class="text-4xl font-black text-white uppercase tracking-wide">Instrucciones</h2>
                                        </div>

                                        <div class="space-y-4 text-left">
                                            <div class="flex items-start gap-4 p-4 bg-white/5 rounded-2xl border border-orange-500/20">
                                                <div class="w-10 h-10 bg-orange-600 rounded-xl flex items-center justify-center flex-shrink-0 mt-1">
                                                    <span class="text-white font-black text-xl">1</span>
                                                </div>
                                                <p class="text-xl text-white font-semibold">Coloca tu <span class="text-orange-400 font-black">dedo en el sensor</span> de huellas</p>
                                            </div>

                                            <div class="flex items-start gap-4 p-4 bg-white/5 rounded-2xl border border-orange-500/20">
                                                <div class="w-10 h-10 bg-orange-600 rounded-xl flex items-center justify-center flex-shrink-0 mt-1">
                                                    <span class="text-white font-black text-xl">2</span>
                                                </div>
                                                <p class="text-xl text-white font-semibold">Espera la <span class="text-orange-400 font-black">verificación automática</span></p>
                                            </div>

                                            <div class="flex items-start gap-4 p-4 bg-white/5 rounded-2xl border border-orange-500/20">
                                                <div class="w-10 h-10 bg-orange-600 rounded-xl flex items-center justify-center flex-shrink-0 mt-1">
                                                    <span class="text-white font-black text-xl">3</span>
                                                </div>
                                                <p class="text-xl text-white font-semibold">Si no funciona, usa tu <span class="text-orange-400 font-black">cédula</span></p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Alternative Method -->
                                    <div class="mt-10 pt-8 border-t-2 border-orange-500/20">
                                        <p class="text-lg text-gray-400 font-bold mb-6 uppercase tracking-wide">¿No tienes huella registrada?</p>
                                        <button
                                            onclick="app.setState({ mode: 'cedula', message: 'Ingresa tu cédula para acceder' })"
                                            class="px-10 py-5 bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white text-xl font-black rounded-2xl transition-all transform hover:scale-105 shadow-2xl uppercase tracking-wider flex items-center justify-center gap-3 mx-auto"
                                        >
                                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/>
                                            </svg>
                                            Ingresar con Cédula
                                        </button>
                                    </div>

                                    <!-- Footer Message -->
                                    <div class="mt-10">
                                        <p class="text-2xl font-bold text-white uppercase tracking-wider animate-pulse">
                                            🏋️ ¡Listo para tu entrenamiento!
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderCedula() {
                return `
                    <div class="min-h-screen relative overflow-hidden bg-gradient-to-br from-gray-900 via-black to-gray-900">
                        <!-- Animated Background -->
                        <div class="absolute inset-0">
                            <div class="absolute inset-0 opacity-20">
                                <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-600 rounded-full blur-3xl animate-pulse"></div>
                                <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-600 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
                            </div>
                            <div class="absolute inset-0" style="background-image: linear-gradient(rgba(59, 130, 246, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(59, 130, 246, 0.05) 1px, transparent 1px); background-size: 50px 50px;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-2xl w-full">
                                <!-- Icon -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-32 h-32 rounded-full bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center shadow-2xl">
                                            <svg class="w-20 h-20 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/>
                                            </svg>
                                        </div>
                                        <div class="absolute -inset-3 rounded-full bg-gradient-to-r from-blue-500/20 to-blue-700/20 blur-xl"></div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-6 uppercase tracking-wider">Identificación</h2>
                                <p class="text-2xl text-blue-400 font-bold mb-12 uppercase tracking-wide">${this.state.message}</p>

                                <!-- Input Card -->
                                <div class="backdrop-blur-xl bg-white/10 rounded-3xl p-10 border-2 border-blue-500/30 shadow-2xl mb-8">
                                    <label class="block text-2xl font-black text-white mb-6 uppercase tracking-wide">Ingresa tu Cédula</label>
                                    <input
                                        type="text"
                                        id="cedula-input"
                                        value="${this.state.cedula}"
                                        oninput="app.setState({ cedula: this.value })"
                                        onkeypress="if(event.key==='Enter') app.handleCedulaConsulta()"
                                        placeholder="000-0000000-0"
                                        class="w-full px-8 py-6 bg-black/60 border-3 border-blue-500 rounded-2xl text-white text-3xl font-bold text-center placeholder-gray-500 focus:outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-500/30 transition-all"
                                    />
                                </div>

                                <!-- Buttons -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <button
                                        onclick="app.handleCedulaConsulta()"
                                        class="px-10 py-6 bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white text-2xl font-black rounded-2xl transition-all transform hover:scale-105 shadow-2xl uppercase tracking-wider flex items-center justify-center gap-3"
                                    >
                                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        Verificar
                                    </button>

                                    <button
                                        onclick="app.reset(); app.startFingerprintDetection();"
                                        class="px-10 py-6 bg-gradient-to-r from-gray-700 to-gray-900 hover:from-gray-600 hover:to-gray-800 text-white text-2xl font-black rounded-2xl transition-all transform hover:scale-105 shadow-2xl uppercase tracking-wider flex items-center justify-center gap-3"
                                    >
                                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                                        </svg>
                                        Volver
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderScanning() {
                return `
                    <div class="min-h-screen relative overflow-hidden bg-gradient-to-br from-gray-900 via-black to-gray-900 flex items-center justify-center">
                        <div class="absolute inset-0">
                            <div class="absolute inset-0 opacity-30">
                                <div class="absolute top-1/3 left-1/3 w-96 h-96 bg-purple-600 rounded-full blur-3xl animate-pulse"></div>
                                <div class="absolute bottom-1/3 right-1/3 w-96 h-96 bg-pink-600 rounded-full blur-3xl animate-pulse" style="animation-delay: 0.5s;"></div>
                            </div>
                        </div>

                        <div class="relative z-10 text-center">
                            <div class="mb-10">
                                <div class="relative inline-block">
                                    <div class="w-48 h-48 rounded-full bg-gradient-to-br from-purple-600 to-pink-600 flex items-center justify-center shadow-2xl animate-spin" style="animation-duration: 2s;">
                                        <div class="w-40 h-40 rounded-full bg-gray-900 flex items-center justify-center">
                                            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="absolute -inset-6 rounded-full bg-gradient-to-r from-purple-600/20 to-pink-600/20 blur-2xl"></div>
                                </div>
                            </div>

                            <h2 class="text-7xl font-black text-white mb-6 uppercase tracking-wider animate-pulse">${this.state.message}</h2>
                            <p class="text-3xl text-purple-400 font-bold uppercase tracking-widest">Por favor espera...</p>
                        </div>
                    </div>
                `;
            }

            renderSuccess() {
                const { cliente, diasRestantes, similarity, deuda } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden bg-gradient-to-br from-green-900 via-emerald-950 to-black">
                        <div class="absolute inset-0">
                            <div class="absolute inset-0 opacity-20">
                                <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-green-500 rounded-full blur-3xl animate-pulse"></div>
                                <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-emerald-500 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
                            </div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8 py-12">
                            <div class="text-center max-w-4xl">
                                <!-- Success Icon -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-48 h-48 rounded-full bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center shadow-2xl">
                                            <svg class="w-32 h-32 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-48 h-48 rounded-full animate-ping bg-green-500 opacity-20"></div>
                                        <div class="absolute -inset-6 rounded-full bg-gradient-to-r from-green-500/30 to-emerald-500/30 blur-2xl"></div>
                                    </div>
                                </div>

                                <h2 class="text-8xl font-black text-white mb-4 uppercase tracking-wider">¡Bienvenido!</h2>
                                <p class="text-4xl text-green-400 font-bold mb-12 uppercase tracking-wide">${this.state.message}</p>

                                <!-- Client Info Card -->
                                <div class="backdrop-blur-xl bg-white/10 rounded-3xl p-12 border-2 border-green-500/30 shadow-2xl mb-10">
                                    <div class="mb-8">
                                        <p class="text-6xl font-black text-white mb-4">${cliente?.nombre || 'Cliente'}</p>
                                        ${cliente?.cedula ? `<p class="text-2xl text-green-300 font-bold">Cédula: ${cliente.cedula}</p>` : ''}
                                    </div>

                                    ${diasRestantes !== null && diasRestantes !== undefined ? `
                                        <div class="pt-8 border-t-2 border-green-500/30">
                                            <p class="text-2xl font-bold text-green-300 mb-4 uppercase tracking-wide">Estado de Membresía</p>
                                            <div class="bg-gradient-to-r from-green-500/20 to-emerald-500/20 rounded-2xl p-8 border-2 border-green-400/40">
                                                <p class="text-7xl font-black ${diasRestantes > 7 ? 'text-green-400' : diasRestantes > 0 ? 'text-yellow-400' : 'text-orange-400'} mb-3">
                                                    ${diasRestantes > 0 ? diasRestantes : 0} ${diasRestantes === 1 ? 'DÍA' : 'DÍAS'}
                                                </p>
                                                <p class="text-2xl text-white font-bold">${diasRestantes > 0 ? 'restantes' : 'Membresía por vencer'}</p>
                                            </div>
                                        </div>
                                    ` : ''}

                                    ${deuda && deuda.tieneDeuda ? `
                                        <div class="pt-8 mt-8 border-t-2 border-orange-500/30">
                                            <div class="bg-gradient-to-r from-orange-500/20 to-amber-500/20 rounded-2xl p-8 border-2 border-orange-400/40">
                                                <div class="flex items-center justify-center gap-4 mb-4">
                                                    <svg class="w-12 h-12 text-orange-400" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                    </svg>
                                                    <p class="text-2xl font-bold text-orange-400 uppercase tracking-wide">Monto Pendiente</p>
                                                </div>
                                                <p class="text-6xl font-black text-orange-400 mb-3">
                                                    $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                                </p>
                                                <p class="text-xl text-white font-semibold">
                                                    💰 Recuerda ponerte al día
                                                </p>
                                                ${deuda.cantidadDeudas > 1 ? `
                                                    <p class="text-lg mt-3 text-orange-300 font-bold">
                                                        (${deuda.cantidadDeudas} deudas pendientes)
                                                    </p>
                                                ` : ''}
                                            </div>
                                        </div>
                                    ` : ''}

                                    ${similarity ? `
                                        <div class="pt-8 mt-8 border-t-2 border-green-500/30">
                                            <div class="flex items-center justify-center gap-3">
                                                <svg class="w-8 h-8 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                                </svg>
                                                <p class="text-2xl font-bold text-green-400">
                                                    Verificación: ${similarity.toFixed(1)}% de coincidencia
                                                </p>
                                            </div>
                                        </div>
                                    ` : ''}
                                </div>

                                <!-- Motivational Message -->
                                <div class="backdrop-blur-xl bg-gradient-to-r from-green-500/10 to-emerald-500/10 rounded-3xl p-10 border-2 border-green-400/30 shadow-xl">
                                    <p class="text-4xl text-white font-black uppercase tracking-wide">🏋️ ¡A dar lo mejor de ti hoy! 💪</p>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderError() {
                const { diasRestantes, deuda } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden bg-gradient-to-br from-red-900 via-red-950 to-black">
                        <div class="absolute inset-0">
                            <div class="absolute inset-0 opacity-20">
                                <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-red-600 rounded-full blur-3xl animate-pulse"></div>
                                <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-orange-600 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
                            </div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8 py-12">
                            <div class="text-center max-w-4xl">
                                <!-- Error Icon -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-48 h-48 rounded-full bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center shadow-2xl">
                                            <svg class="w-32 h-32 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-48 h-48 rounded-full animate-ping bg-red-500 opacity-20"></div>
                                        <div class="absolute -inset-6 rounded-full bg-gradient-to-r from-red-500/30 to-red-700/30 blur-2xl"></div>
                                    </div>
                                </div>

                                <h2 class="text-8xl font-black text-white mb-8 uppercase tracking-wider">Acceso Denegado</h2>

                                <!-- Error Info Card -->
                                <div class="backdrop-blur-xl bg-white/10 rounded-3xl p-12 border-2 border-red-500/30 shadow-2xl mb-10">
                                    <div class="mb-8 flex justify-center">
                                        <div class="w-24 h-24 rounded-full bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center shadow-xl">
                                            <svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                    </div>

                                    <p class="text-4xl text-white mb-6 font-black">${this.state.message}</p>

                                    ${diasRestantes !== null && diasRestantes !== undefined && diasRestantes < 0 ? `
                                        <div class="pt-8 mt-8 border-t-2 border-red-500/30">
                                            <p class="text-2xl mb-4 uppercase tracking-wide font-bold text-orange-400">Membresía Vencida</p>
                                            <div class="bg-gradient-to-r from-orange-500/20 to-red-500/20 rounded-2xl p-8 border-2 border-orange-400/40">
                                                <p class="text-7xl font-black text-orange-400 mb-3">
                                                    ${Math.abs(diasRestantes)} ${Math.abs(diasRestantes) === 1 ? 'DÍA' : 'DÍAS'}
                                                </p>
                                                <p class="text-2xl text-white font-bold">desde su vencimiento</p>
                                            </div>
                                        </div>
                                    ` : ''}

                                    ${deuda && deuda.tieneDeuda ? `
                                        <div class="pt-8 mt-8 border-t-2 border-orange-500/30">
                                            <div class="bg-gradient-to-r from-orange-500/20 to-amber-500/20 rounded-2xl p-8 border-2 border-orange-400/40">
                                                <div class="flex items-center justify-center gap-4 mb-4">
                                                    <svg class="w-12 h-12 text-orange-400" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                    </svg>
                                                    <p class="text-2xl font-bold text-orange-400 uppercase tracking-wide">Monto Pendiente</p>
                                                </div>
                                                <p class="text-6xl font-black text-orange-400 mb-3">
                                                    $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                                </p>
                                                <p class="text-xl text-white font-semibold">
                                                    Recuerda ponerte al día
                                                </p>
                                            </div>
                                        </div>
                                    ` : ''}

                                    <div class="mt-10 pt-8 border-t-2 border-red-500/30">
                                        <p class="text-3xl text-white font-bold">📞 Dirígete a recepción para asistencia</p>
                                    </div>
                                </div>

                                <button
                                    onclick="app.reset(); app.startFingerprintDetection();"
                                    class="px-12 py-6 bg-gradient-to-r from-orange-600 to-orange-800 hover:from-orange-700 hover:to-orange-900 text-white text-3xl font-black rounded-2xl transition-all transform hover:scale-105 shadow-2xl uppercase tracking-wider flex items-center justify-center gap-4 mx-auto"
                                >
                                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                                    </svg>
                                    Volver al Inicio
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }


            renderDuplicado() {
                const { cliente, message, ultimoCheckIn } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden bg-gradient-to-br from-yellow-900 via-yellow-950 to-black">
                        <div class="absolute inset-0">
                            <div class="absolute inset-0 opacity-20">
                                <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-yellow-600 rounded-full blur-3xl animate-pulse"></div>
                                <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-orange-600 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
                            </div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8 py-12">
                            <div class="text-center max-w-4xl">
                                <!-- Warning Icon -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-48 h-48 rounded-full bg-gradient-to-br from-yellow-500 to-yellow-700 flex items-center justify-center shadow-2xl">
                                            <svg class="w-32 h-32 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-48 h-48 rounded-full animate-ping bg-yellow-500 opacity-20"></div>
                                        <div class="absolute -inset-6 rounded-full bg-gradient-to-r from-yellow-500/30 to-yellow-700/30 blur-2xl"></div>
                                    </div>
                                </div>

                                <h2 class="text-8xl font-black text-white mb-8 uppercase tracking-wider">Ya Registrado</h2>

                                <!-- Client Info Card -->
                                ${cliente && cliente.fotoBase64 ? `
                                    <div class="backdrop-blur-xl bg-white/10 rounded-3xl p-10 border-2 border-yellow-500/30 shadow-2xl mb-10">
                                        <div class="flex items-center justify-center gap-8">
                                            <img src="${cliente.fotoBase64}" alt="${cliente.nombre}" class="w-32 h-32 rounded-full border-4 border-yellow-500 shadow-xl object-cover" />
                                            <div class="text-left">
                                                <p class="text-4xl font-black text-white mb-2">${cliente.nombre}</p>
                                                ${cliente.peso ? `
                                                    <p class="text-2xl text-yellow-400 font-bold">Peso: ${cliente.peso} kg</p>
                                                ` : ''}
                                            </div>
                                        </div>
                                    </div>
                                ` : ''}

                                <!-- Message Card -->
                                <div class="backdrop-blur-xl bg-white/10 rounded-3xl p-12 border-2 border-yellow-500/30 shadow-2xl mb-10">
                                    <div class="mb-8 flex justify-center">
                                        <div class="w-24 h-24 rounded-full bg-gradient-to-br from-yellow-500 to-yellow-700 flex items-center justify-center shadow-xl">
                                            <svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                    </div>

                                    <p class="text-4xl text-white mb-6 font-black">${message}</p>

                                    ${ultimoCheckIn && ultimoCheckIn.hora ? `
                                        <div class="pt-8 mt-8 border-t-2 border-yellow-500/30">
                                            <p class="text-2xl mb-4 uppercase tracking-wide font-bold text-yellow-400">Último Check-In</p>
                                            <div class="bg-gradient-to-r from-yellow-500/20 to-orange-500/20 rounded-2xl p-8 border-2 border-yellow-400/40">
                                                <div class="flex items-center justify-center gap-3 mb-4">
                                                    <svg class="w-12 h-12 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                    </svg>
                                                    <p class="text-6xl font-black text-yellow-400">${ultimoCheckIn.hora}</p>
                                                </div>
                                                <p class="text-2xl text-white font-bold">Hoy</p>
                                            </div>
                                        </div>
                                    ` : ''}

                                    <div class="mt-10 pt-8 border-t-2 border-yellow-500/30">
                                        <p class="text-3xl text-white font-bold">✅ Tu check-in ya fue registrado exitosamente</p>
                                        <p class="text-xl text-yellow-400 font-semibold mt-4">Vuelve mañana para hacer un nuevo check-in</p>
                                    </div>
                                </div>

                                <button
                                    onclick="app.reset(); app.startFingerprintDetection();"
                                    class="px-12 py-6 bg-gradient-to-r from-orange-600 to-orange-800 hover:from-orange-700 hover:to-orange-900 text-white text-3xl font-black rounded-2xl transition-all transform hover:scale-105 shadow-2xl uppercase tracking-wider flex items-center justify-center gap-4 mx-auto"
                                >
                                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                                    </svg>
                                    Volver al Inicio
                                </button>

                                <!-- Motivational Message -->
                                <div class="mt-10">
                                    <p class="text-2xl font-bold text-white uppercase tracking-wider">
                                        🏋️ ¡Disfruta tu entrenamiento!
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            render() {
                const container = document.getElementById('kiosko-app');
                let html = '';
                let cursorPosition = null;
                const activeInput = document.getElementById('cedula-input');
                if (activeInput && this.state.mode === 'cedula') {
                    cursorPosition = activeInput.selectionStart;
                }

                switch(this.state.mode) {
                    case 'idle': html = this.renderIdle(); break;
                    case 'cedula': html = this.renderCedula(); break;
                    case 'scanning': html = this.renderScanning(); break;
                    case 'success': html = this.renderSuccess(); break;
                    case 'error': html = this.renderError(); break;
                    case 'duplicado': html = this.renderDuplicado(); break;
                }

                container.innerHTML = html;

                if (this.state.mode === 'cedula') {
                    setTimeout(() => {
                        const input = document.getElementById('cedula-input');
                        if (input) {
                            input.focus();
                            if (cursorPosition !== null) {
                                const newPosition = Math.min(cursorPosition, input.value.length);
                                input.setSelectionRange(newPosition, newPosition);
                            }
                        }
                    }, 100);
                }
            }
        }

        const app = new KioskoApp();
    </script>
}

@{
    Layout = "_Layout";
    ViewData["Title"] = "Check-In TAURO GYM";
}

<div id="kiosko-app" class="min-h-screen"></div>

@section Scripts {
    <script>
        class KioskoApp {
            constructor() {
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    similarity: 0,
                    isProcessing: false
                };
                this.fingerprintCheckInterval = null;
                this.render();
                this.startClock();
                this.startFingerprintDetection();
            }

            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.render();

                if (this.state.mode === 'success' || this.state.mode === 'error') {
                    this.stopFingerprintDetection();
                    setTimeout(() => {
                        this.reset();
                        this.startFingerprintDetection();
                    }, 6000);
                }
            }

            reset() {
                this.setState({
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    similarity: 0,
                    isProcessing: false
                });
            }

            startClock() {
                setInterval(() => {
                    const timeEl = document.getElementById('clock-time');
                    const dateEl = document.getElementById('clock-date');
                    if (timeEl && dateEl) {
                        const now = new Date();
                        timeEl.textContent = now.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });
                        dateEl.textContent = now.toLocaleDateString('es-ES', {
                            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                        });
                    }
                }, 1000);
            }

            startFingerprintDetection() {
                this.fingerprintCheckInterval = setInterval(async () => {
                    if (this.state.mode === 'idle' && !this.state.isProcessing) {
                        await this.checkFingerprintSensor();
                    }
                }, 800);
            }

            stopFingerprintDetection() {
                if (this.fingerprintCheckInterval) {
                    clearInterval(this.fingerprintCheckInterval);
                    this.fingerprintCheckInterval = null;
                }
            }

            async checkFingerprintSensor() {
                if (this.state.isProcessing) return;

                try {
                    this.state.isProcessing = true;
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 2000);

                    const response = await fetch('/kiosko/checkin-huella', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);
                    const data = await response.json();

                    if (data.cliente || data.useCedula) {
                        this.state.isProcessing = false;
                        await this.handleFingerprintDetected(data);
                    } else {
                        this.state.isProcessing = false;
                    }
                } catch (error) {
                    this.state.isProcessing = false;
                }
            }

            async handleFingerprintDetected(data) {
                this.stopFingerprintDetection();

                if (data.useCedula && !data.cliente) {
                    this.setState({
                        mode: 'cedula',
                        message: data.message || 'Huella no reconocida. Usa tu cédula.'
                    });
                    return;
                }

                this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                await new Promise(resolve => setTimeout(resolve, 1500));

                if (data.success && data.cliente) {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'success',
                        cliente: data.cliente,
                        diasRestantes: diasRestantes,
                        message: data.message,
                        similarity: data.similarity
                    });
                } else {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'error',
                        message: data.message || 'No se pudo verificar la huella',
                        diasRestantes: diasRestantes
                    });
                }
            }

            async handleCedulaConsulta() {
                if (!this.state.cedula.trim()) {
                    this.setState({ message: 'Por favor ingresa tu cédula' });
                    return;
                }

                this.stopFingerprintDetection();
                this.setState({ mode: 'scanning', message: 'Consultando información...' });

                try {
                    const response = await fetch('/api/CheckIn/cedula', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Cedula: this.state.cedula.trim() })
                    });

                    const data = await response.json();
                    await new Promise(resolve => setTimeout(resolve, 1500));

                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;

                    if (data.success) {
                        this.setState({
                            mode: 'success',
                            cliente: data.cliente,
                            diasRestantes: diasRestantes,
                            message: data.message
                        });
                    } else {
                        this.setState({
                            mode: 'error',
                            message: data.message,
                            diasRestantes: diasRestantes
                        });
                    }
                } catch (error) {
                    this.setState({
                        mode: 'error',
                        message: 'Error al consultar la información. Intenta de nuevo.'
                    });
                }
            }

            renderIdle() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0f0f0f 100%);">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-10 left-10 w-96 h-96 bg-red-600 rounded-full filter blur-3xl"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 bg-gray-800 rounded-full filter blur-3xl"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="text-center mb-16">
                                <div class="inline-block mb-6 px-8 py-3 bg-gradient-to-r from-red-600 to-red-800 rounded-full">
                                    <h1 class="text-5xl font-black tracking-widest text-white">TAURO GYM</h1>
                                </div>
                                <div class="mt-8 space-y-3">
                                    <p id="clock-time" class="text-7xl font-bold text-white tracking-tight"></p>
                                    <p id="clock-date" class="text-2xl text-gray-400 uppercase tracking-wide"></p>
                                </div>
                            </div>

                            <div class="w-full max-w-2xl">
                                <div class="bg-gradient-to-br from-gray-900 to-black border-2 border-red-600 rounded-3xl p-12 shadow-2xl">
                                    <div class="text-center space-y-8">
                                        <div class="flex justify-center">
                                            <div class="relative">
                                                <div class="w-32 h-32 bg-red-600 rounded-full flex items-center justify-center animate-pulse">
                                                    <svg class="w-20 h-20 text-white" fill="currentColor" viewBox="0 0 24 24">
                                                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
                                                    </svg>
                                                </div>
                                                <div class="absolute inset-0 w-32 h-32 bg-red-600 rounded-full animate-ping opacity-20"></div>
                                            </div>
                                        </div>

                                        <div class="space-y-4">
                                            <h2 class="text-4xl font-bold text-white uppercase tracking-wider">Sistema de Acceso</h2>
                                            <p class="text-2xl text-gray-300">Coloca tu huella para ingresar</p>
                                        </div>

                                        <div class="pt-6 border-t border-gray-800">
                                            <button onclick="app.setState({ mode: 'cedula', message: '' })"
                                                class="w-full py-5 bg-gray-800 hover:bg-gray-700 text-white rounded-xl text-xl font-semibold transition-all duration-300 transform hover:scale-105 border border-gray-700">
                                                Ingresar con Cédula
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-12 text-center">
                                <p class="text-gray-500 text-lg">Horario: Lunes a Domingo 5:00 AM - 11:00 PM</p>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderCedula() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0f0f0f 100%);">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-10 left-10 w-96 h-96 bg-red-600 rounded-full filter blur-3xl"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 bg-gray-800 rounded-full filter blur-3xl"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="text-center mb-12">
                                <div class="inline-block mb-6 px-8 py-3 bg-gradient-to-r from-red-600 to-red-800 rounded-full">
                                    <h1 class="text-4xl font-black tracking-widest text-white">TAURO GYM</h1>
                                </div>
                            </div>

                            <div class="w-full max-w-2xl">
                                <div class="bg-gradient-to-br from-gray-900 to-black border-2 border-red-600 rounded-3xl p-12 shadow-2xl">
                                    <div class="text-center space-y-8">
                                        <div class="flex justify-center">
                                            <div class="w-24 h-24 bg-red-600 rounded-full flex items-center justify-center">
                                                <svg class="w-14 h-14 text-white" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                                </svg>
                                            </div>
                                        </div>

                                        <div class="space-y-3">
                                            <h2 class="text-3xl font-bold text-white uppercase">Identificación Manual</h2>
                                            ${this.state.message ? `<p class="text-xl text-red-400">${this.state.message}</p>` : ''}
                                        </div>

                                        <div class="space-y-6">
                                            <div>
                                                <label class="block text-left text-lg text-gray-400 mb-3 font-semibold">Número de Cédula</label>
                                                <input type="text"
                                                    id="cedula-input"
                                                    value="${this.state.cedula}"
                                                    oninput="app.state.cedula = this.value; app.render();"
                                                    onkeypress="if(event.key === 'Enter') app.handleCedulaConsulta()"
                                                    placeholder="Ingresa tu número de cédula"
                                                    class="w-full px-6 py-5 bg-gray-800 border-2 border-gray-700 rounded-xl text-white text-2xl text-center focus:border-red-600 focus:outline-none transition-all"/>
                                            </div>

                                            <button onclick="app.handleCedulaConsulta()"
                                                class="w-full py-5 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900 text-white rounded-xl text-xl font-bold transition-all duration-300 transform hover:scale-105 shadow-lg">
                                                VERIFICAR IDENTIDAD
                                            </button>

                                            <button onclick="app.reset(); app.startFingerprintDetection();"
                                                class="w-full py-4 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-xl text-lg font-semibold transition-all duration-300 border border-gray-700">
                                                Volver a Huella Dactilar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderScanning() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
                        <div class="absolute inset-0 opacity-20">
                            <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-600 rounded-full filter blur-3xl animate-pulse"></div>
                            <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-600 rounded-full filter blur-3xl animate-pulse" style="animation-delay: 0.5s;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center">
                                <div class="mb-12 flex justify-center">
                                    <div class="relative">
                                        <div class="w-48 h-48 border-8 border-cyan-500 border-t-transparent rounded-full animate-spin"></div>
                                        <div class="absolute inset-0 flex items-center justify-center">
                                            <svg class="w-24 h-24 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                            </svg>
                                        </div>
                                    </div>
                                </div>

                                <h2 class="text-5xl font-black text-white mb-6 uppercase tracking-wide">${this.state.message}</h2>
                                <p class="text-2xl text-cyan-300 font-semibold">Procesando...</p>

                                <div class="flex justify-center gap-3 mt-10">
                                    <div class="w-4 h-4 bg-cyan-500 rounded-full animate-bounce shadow-lg shadow-cyan-500/50"></div>
                                    <div class="w-4 h-4 bg-cyan-500 rounded-full animate-bounce shadow-lg shadow-cyan-500/50" style="animation-delay: 0.15s;"></div>
                                    <div class="w-4 h-4 bg-cyan-500 rounded-full animate-bounce shadow-lg shadow-cyan-500/50" style="animation-delay: 0.3s;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderSuccess() {
                const { cliente, diasRestantes, similarity } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #047857 100%);">
                        <div class="absolute inset-0 opacity-20">
                            <div class="absolute top-10 right-10 w-96 h-96 bg-emerald-400 rounded-full filter blur-3xl"></div>
                            <div class="absolute bottom-10 left-10 w-96 h-96 bg-green-500 rounded-full filter blur-3xl"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-4xl">
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-40 h-40 bg-emerald-500 rounded-full flex items-center justify-center shadow-2xl">
                                            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-40 h-40 bg-emerald-500 rounded-full animate-ping opacity-20"></div>
                                    </div>
                                </div>

                                ${cliente?.fotoBase64 ? `
                                    <div class="mb-8 flex justify-center">
                                        <div class="relative">
                                            <img src="${cliente.fotoBase64.startsWith('data:') ? cliente.fotoBase64 : 'data:image/jpeg;base64,' + cliente.fotoBase64}"
                                                 class="w-48 h-48 rounded-full border-4 border-emerald-400 shadow-2xl object-cover"/>
                                            <div class="absolute -bottom-2 -right-2 w-16 h-16 bg-emerald-500 rounded-full flex items-center justify-center border-4 border-green-800">
                                                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                ` : ''}

                                <h2 class="text-6xl font-black text-white mb-4 uppercase tracking-wider">¡Bienvenido!</h2>
                                <p class="text-5xl text-emerald-300 mb-10 font-bold">${cliente?.nombre || ''}</p>

                                <div class="bg-black/40 backdrop-blur-sm rounded-3xl px-12 py-10 border-2 ${
                                    diasRestantes !== null && diasRestantes !== undefined ?
                                        (diasRestantes <= 3 ? 'border-yellow-400' : 'border-emerald-400')
                                    : 'border-red-500'
                                } mb-8">
                                    <div class="mb-6">
                                        <p class="text-xl text-gray-300 mb-3 uppercase tracking-wide font-semibold">Estado de Membresía</p>
                                        <p class="text-4xl font-black ${
                                            diasRestantes !== null && diasRestantes !== undefined ? 'text-emerald-300' : 'text-red-400'
                                        }">
                                            ${this.state.message}
                                        </p>
                                    </div>

                                    ${diasRestantes !== null && diasRestantes !== undefined ? `
                                        <div class="border-t-2 border-gray-700/50 pt-6 mt-6">
                                            <p class="text-lg text-gray-400 mb-3 uppercase tracking-wide">
                                                ${diasRestantes <= 7 ? 'Tiempo restante' : 'Vigencia'}
                                            </p>
                                            <p class="text-6xl font-black ${
                                                diasRestantes <= 3 ? 'text-yellow-400' : 'text-emerald-400'
                                            }">
                                                ${diasRestantes} ${diasRestantes === 1 ? 'DÍA' : 'DÍAS'}
                                            </p>
                                            ${diasRestantes <= 7 ? `
                                                <p class="text-yellow-400 text-lg mt-4 font-semibold">
                                                    Renueva pronto tu membresía
                                                </p>
                                            ` : ''}
                                        </div>
                                    ` : ''}
                                </div>

                                ${similarity ? `
                                    <div class="mb-8 inline-block px-6 py-3 bg-black/30 rounded-full border border-emerald-500/30">
                                        <p class="text-emerald-300 font-semibold">
                                            Verificación: ${similarity.toFixed(1)}% de coincidencia
                                        </p>
                                    </div>
                                ` : ''}

                                <div class="mt-8">
                                    <p class="text-3xl text-white font-bold">¡Sin prisa, pero con ¡DISCIPLINA!(Insiste,Persiste,Resiste)</p>
                                    <p class="text-xl text-emerald-300 mt-3">Da lo mejor de ti</p>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderError() {
                const { diasRestantes } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #b91c1c 100%);">
                        <div class="absolute inset-0 opacity-20">
                            <div class="absolute top-10 left-10 w-96 h-96 bg-red-500 rounded-full filter blur-3xl"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 bg-orange-600 rounded-full filter blur-3xl"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-3xl">
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-40 h-40 bg-red-600 rounded-full flex items-center justify-center shadow-2xl">
                                            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-40 h-40 bg-red-600 rounded-full animate-ping opacity-20"></div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-8 uppercase tracking-wider">Acceso Denegado</h2>

                                <div class="bg-black/40 backdrop-blur-sm rounded-3xl px-12 py-10 border-2 border-red-500 mb-10">
                                    <div class="mb-6 flex justify-center">
                                        <div class="w-20 h-20 bg-red-500 rounded-full flex items-center justify-center">
                                            <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                    </div>

                                    <p class="text-3xl text-red-200 mb-4 font-bold">${this.state.message}</p>

                                    ${diasRestantes !== null && diasRestantes !== undefined && diasRestantes < 0 ? `
                                        <div class="border-t-2 border-red-700/50 pt-6 mt-6">
                                            <p class="text-lg text-red-300 mb-3 uppercase tracking-wide font-semibold">Membresía Vencida</p>
                                            <p class="text-5xl font-black text-red-300">
                                                ${Math.abs(diasRestantes)} ${Math.abs(diasRestantes) === 1 ? 'DÍA' : 'DÍAS'}
                                            </p>
                                            <p class="text-red-200 text-lg mt-3">desde su vencimiento</p>
                                        </div>
                                    ` : ''}

                                    <div class="mt-8 pt-6 border-t border-red-700/50">
                                        <p class="text-xl text-red-200 font-semibold">Dirígete a recepción para asistencia</p>
                                    </div>
                                </div>

                                <button onclick="app.reset(); app.startFingerprintDetection();"
                                    class="px-12 py-5 bg-gray-900 hover:bg-gray-800 text-white rounded-xl text-xl font-bold transition-all duration-300 transform hover:scale-105 border-2 border-gray-700">
                                    VOLVER AL INICIO
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            render() {
                const container = document.getElementById('kiosko-app');
                let html = '';
                let cursorPosition = null;
                const activeInput = document.getElementById('cedula-input');
                if (activeInput && this.state.mode === 'cedula') {
                    cursorPosition = activeInput.selectionStart;
                }

                switch(this.state.mode) {
                    case 'idle': html = this.renderIdle(); break;
                    case 'cedula': html = this.renderCedula(); break;
                    case 'scanning': html = this.renderScanning(); break;
                    case 'success': html = this.renderSuccess(); break;
                    case 'error': html = this.renderError(); break;
                }

                container.innerHTML = html;

                if (this.state.mode === 'cedula') {
                    setTimeout(() => {
                        const input = document.getElementById('cedula-input');
                        if (input) {
                            input.focus();
                            if (cursorPosition !== null) {
                                const newPosition = Math.min(cursorPosition, input.value.length);
                                input.setSelectionRange(newPosition, newPosition);
                            }
                        }
                    }, 100);
                }
            }
        }

        const app = new KioskoApp();
    </script>
}

@{
    Layout = "_Layout";
    ViewData["Title"] = "Check-In JONEL GYM";
}

<div id="kiosko-app" class="min-h-screen"></div>

@section Scripts {
    <script>
        class KioskoApp {
            constructor() {
                this.state = {
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                };
                this.fingerprintCheckInterval = null;
                this.render();
                this.startClock();
                this.startFingerprintDetection();
            }

            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.render();

                if (this.state.mode === 'success' || this.state.mode === 'error' || this.state.mode === 'already-checked-in') {
                    this.stopFingerprintDetection();
                    setTimeout(() => {
                        this.reset();
                        this.startFingerprintDetection();
                    }, 6000);
                }
            }

            reset() {
                this.setState({
                    mode: 'idle',
                    cliente: null,
                    message: '',
                    cedula: '',
                    diasRestantes: null,
                    similarity: 0,
                    isProcessing: false,
                    deuda: null,
                    ultimoCheckIn: null
                });
            }

            startClock() {
                setInterval(() => {
                    const timeEl = document.getElementById('clock-time');
                    const dateEl = document.getElementById('clock-date');
                    if (timeEl && dateEl) {
                        const now = new Date();
                        timeEl.textContent = now.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });
                        dateEl.textContent = now.toLocaleDateString('es-ES', {
                            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                        });
                    }
                }, 1000);
            }

            startFingerprintDetection() {
                this.fingerprintCheckInterval = setInterval(async () => {
                    if (this.state.mode === 'idle' && !this.state.isProcessing) {
                        await this.checkFingerprintSensor();
                    }
                }, 800);
            }

            stopFingerprintDetection() {
                if (this.fingerprintCheckInterval) {
                    clearInterval(this.fingerprintCheckInterval);
                    this.fingerprintCheckInterval = null;
                }
            }

            async checkFingerprintSensor() {
                if (this.state.isProcessing) return;

                try {
                    this.state.isProcessing = true;
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 2000);

                    const response = await fetch('/kiosko/checkin-huella', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);
                    const data = await response.json();

                    if (data.cliente || data.useCedula) {
                        this.state.isProcessing = false;
                        await this.handleFingerprintDetected(data);
                    } else {
                        this.state.isProcessing = false;
                    }
                } catch (error) {
                    this.state.isProcessing = false;
                }
            }

            async handleFingerprintDetected(data) {
                this.stopFingerprintDetection();

                if (data.useCedula && !data.cliente) {
                    this.setState({
                        mode: 'cedula',
                        message: data.message || 'Huella no reconocida. Usa tu cédula.'
                    });
                    return;
                }

                // ========== NUEVO: MANEJAR CHECK-IN DUPLICADO ==========
                if (data.yaHizoCheckIn && data.ultimoCheckIn) {
                    this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                    await new Promise(resolve => setTimeout(resolve, 1500));

                    this.setState({
                        mode: 'already-checked-in',
                        cliente: data.cliente,
                        message: data.message,
                        ultimoCheckIn: data.ultimoCheckIn
                    });
                    return;
                }
                // =======================================================

                this.setState({ mode: 'scanning', message: 'Verificando identidad...' });
                await new Promise(resolve => setTimeout(resolve, 1500));

                if (data.success && data.cliente) {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'success',
                        cliente: data.cliente,
                        diasRestantes: diasRestantes,
                        message: data.message,
                        similarity: data.similarity,
                        deuda: data.deuda || null
                    });
                } else {
                    const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                    this.setState({
                        mode: 'error',
                        message: data.message || 'No se pudo verificar la huella',
                        diasRestantes: diasRestantes,
                        deuda: data.deuda || null
                    });
                }
            }

            async handleCedulaConsulta() {
                if (!this.state.cedula.trim()) {
                    this.setState({ message: 'Por favor ingresa tu cédula' });
                    return;
                }

                this.stopFingerprintDetection();
                this.setState({ mode: 'scanning', message: 'Consultando información...' });

                try {
                    const response = await fetch('/kiosko/checkin-cedula', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cedula: this.state.cedula })
                    });

                    const data = await response.json();

                    // ========== NUEVO: MANEJAR CHECK-IN DUPLICADO ==========
                    if (data.yaHizoCheckIn && data.ultimoCheckIn) {
                        this.setState({
                            mode: 'already-checked-in',
                            cliente: data.cliente,
                            message: data.message,
                            ultimoCheckIn: data.ultimoCheckIn
                        });
                        return;
                    }
                    // =======================================================

                    if (data.success && data.cliente) {
                        const diasRestantes = data.cliente?.diasRestantes ?? data.membresia?.diasRestantes ?? null;
                        this.setState({
                            mode: 'success',
                            cliente: data.cliente,
                            diasRestantes: diasRestantes,
                            message: data.message,
                            deuda: data.deuda || null
                        });
                    } else {
                        this.setState({
                            mode: 'error',
                            message: data.message || 'No se pudo verificar la cédula',
                            deuda: data.deuda || null
                        });
                    }
                } catch (error) {
                    this.setState({
                        mode: 'error',
                        message: 'Error al consultar cédula. Intenta nuevamente.'
                    });
                }
            }

            renderIdle() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-20 left-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                            <div class="absolute bottom-20 right-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="mb-12 animate-pulse">
                                <img src="/images/logo-nelson.png" alt="JONEL GYM" class="h-40 w-40 object-contain drop-shadow-2xl" />
                            </div>

                            <div class="text-center mb-12">
                                <div id="clock-time" class="text-7xl font-black text-white mb-2 tracking-wider drop-shadow-2xl"></div>
                                <div id="clock-date" class="text-2xl font-bold capitalize" style="color: #FF8C00;"></div>
                            </div>

                            <div class="relative mb-12">
                                <div class="w-48 h-48 rounded-full flex items-center justify-center shadow-2xl" style="background: linear-gradient(135deg, #FF8C00 0%, #FFA500 100%);">
                                    <svg class="w-28 h-28 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path>
                                    </svg>
                                </div>
                                <div class="absolute inset-0 w-48 h-48 rounded-full animate-ping opacity-20" style="background: #FF8C00;"></div>
                            </div>

                            <h1 class="text-6xl font-black text-white mb-6 text-center uppercase tracking-wider drop-shadow-2xl">
                                Sistema de Check-In
                            </h1>
                            <p class="text-3xl font-bold mb-12" style="color: #FF8C00;">
                                Coloca tu dedo en el lector
                            </p>

                            <button onclick="app.setState({ mode: 'cedula' })"
                                class="px-12 py-5 bg-white text-black rounded-xl text-xl font-black transition-all duration-300 transform hover:scale-105 shadow-2xl uppercase tracking-wide">
                                USAR CÉDULA
                            </button>
                        </div>
                    </div>
                `;
            }

            renderCedula() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-20 left-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                            <div class="absolute bottom-20 right-20 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-8">
                            <div class="mb-12">
                                <img src="/images/logo-nelson.png" alt="JONEL GYM" class="h-32 w-32 object-contain drop-shadow-2xl" />
                            </div>

                            <h1 class="text-5xl font-black text-white mb-4 text-center uppercase tracking-wider">Ingresa tu cédula</h1>
                            <p class="text-xl text-gray-300 mb-12">Para verificar tu identidad</p>

                            <div class="backdrop-blur-sm rounded-3xl px-12 py-10 w-full max-w-md" style="background: rgba(0,0,0,0.6); border: 3px solid #FF8C00;">
                                <input type="text" id="cedula-input"
                                       value="${this.state.cedula}"
                                       onchange="app.setState({ cedula: this.value })"
                                       onkeypress="if(event.key === 'Enter') app.handleCedulaConsulta()"
                                       placeholder="0000000000"
                                       class="w-full px-6 py-4 rounded-xl text-2xl font-bold text-center bg-black text-white border-2" style="border-color: #FF8C00; color: #FF8C00;"
                                       maxlength="15" autocomplete="off" />

                                <p class="text-center mt-6 text-gray-300 text-sm">
                                    ${this.state.message ? `<span style="color: #FF8C00;">${this.state.message}</span>` : 'Presiona Enter o el botón de buscar'}
                                </p>

                                <button onclick="app.handleCedulaConsulta()"
                                    class="w-full mt-8 px-8 py-4 rounded-xl text-xl font-black transition-all duration-300 transform hover:scale-105 shadow-2xl uppercase tracking-wide text-white" style="background: linear-gradient(135deg, #FF8C00 0%, #FFA500 100%);">
                                    Buscar
                                </button>

                                <button onclick="app.reset(); app.startFingerprintDetection();"
                                    class="w-full mt-4 px-8 py-4 bg-gray-700 hover:bg-gray-600 rounded-xl text-xl font-black text-white transition-all duration-300 transform hover:scale-105 shadow-2xl uppercase tracking-wide">
                                    Volver
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderScanning() {
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-10 left-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center">
                                <div class="w-40 h-40 rounded-full flex items-center justify-center shadow-2xl mx-auto mb-12 animate-spin" style="background: linear-gradient(135deg, #FF8C00 0%, #FFA500 100%);">
                                    <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path>
                                    </svg>
                                </div>
                                <h2 class="text-5xl font-black text-white mb-4 uppercase tracking-wider">${this.state.message}</h2>
                            </div>
                        </div>
                    </div>
                `;
            }

            renderSuccess() {
                const { cliente, diasRestantes, similarity, deuda } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-10 left-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #00C851;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-3xl">
                                <!-- Logo -->
                                <div class="mb-8 flex justify-center">
                                    <img src="/images/logo-nelson.png" alt="JONEL GYM" class="h-32 w-32 object-contain drop-shadow-2xl" />
                                </div>

                                <!-- Check Icon -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-40 h-40 rounded-full flex items-center justify-center shadow-2xl" style="background: #00C851;">
                                            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-40 h-40 rounded-full animate-ping opacity-20" style="background: #00C851;"></div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-8 uppercase tracking-wider">¡Bienvenido!</h2>

                                <div class="flex flex-col gap-8 items-center justify-center mb-8">
                                    ${cliente?.fotoBase64 ? `
                                        <div class="flex-shrink-0">
                                            <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                                 alt="${cliente.nombre}"
                                                 class="w-48 h-48 rounded-full object-cover shadow-2xl"
                                                 style="border: 6px solid #FF8C00;" />
                                        </div>
                                    ` : ''}

                                    <div class="backdrop-blur-sm rounded-3xl px-12 py-10 w-full" style="background: rgba(0,0,0,0.6); border: 3px solid #00C851;">
                                        <h3 class="text-5xl font-black text-white mb-6">${cliente.nombre}</h3>

                                        ${diasRestantes !== null && diasRestantes !== undefined ? `
                                            <div class="mb-6 pb-6" style="border-bottom: 2px solid rgba(255, 255, 255, 0.2);">
                                                <p class="text-lg mb-3 uppercase tracking-wide font-semibold" style="color: #00C851;">Días Restantes</p>
                                                <p class="text-6xl font-black ${diasRestantes <= 3 ? 'text-yellow-400' : 'text-white'}">
                                                    ${diasRestantes} ${diasRestantes === 1 ? 'DÍA' : 'DÍAS'}
                                                </p>
                                            </div>
                                        ` : ''}

                                        <!-- Información de Deuda -->
                                        ${deuda && deuda.tieneDeuda ? `
                                            <div class="pt-6" style="border-top: 2px solid rgba(255, 140, 0, 0.3);">
                                                <div class="flex items-center gap-3 mb-3">
                                                    <svg class="w-8 h-8" style="color: #FF8C00;" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                    </svg>
                                                    <p class="text-lg uppercase tracking-wide font-semibold" style="color: #FF8C00;">Monto Pendiente</p>
                                                </div>
                                                <p class="text-5xl font-black mb-2" style="color: #FF8C00;">
                                                    $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                                </p>
                                                <p class="text-base mt-2 text-white">
                                                    (${deuda.cantidadDeudas} deudas pendientes)
                                                </p>
                                            </div>
                                        ` : ''}

                                        <!-- Verificación de similitud -->
                                        ${similarity ? `
                                            <div class="mt-6 pt-6" style="border-top: 2px solid rgba(255, 140, 0, 0.3);">
                                                <p class="text-lg font-semibold" style="color: #FF8C00;">
                                                    🔒 Verificación: ${similarity.toFixed(1)}% de coincidencia
                                                </p>
                                            </div>
                                        ` : ''}
                                    </div>

                                    <!-- Mensaje motivacional -->
                                    <div class="mt-8 space-y-3">
                                        <p class="text-3xl text-white font-bold">¡Sin prisa, pero con ¡DISCIPLINA!</p>
                                        <p class="text-2xl font-semibold" style="color: #FF8C00;">(Insiste, Persiste, Resiste)</p>
                                        <p class="text-xl text-white mt-3">Da lo mejor de ti 💪</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            // ========== NUEVA PANTALLA: CHECK-IN DUPLICADO ==========
            renderAlreadyCheckedIn() {
                const { cliente, message, ultimoCheckIn } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-10 left-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FFA500;"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-3xl">
                                <!-- Logo -->
                                <div class="mb-8 flex justify-center">
                                    <img src="/images/logo-nelson.png" alt="JONEL GYM" class="h-32 w-32 object-contain drop-shadow-2xl" />
                                </div>

                                <!-- Icono de Advertencia -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-40 h-40 rounded-full flex items-center justify-center shadow-2xl" style="background: #FFA500;">
                                            <svg class="w-24 h-24 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-40 h-40 rounded-full animate-ping opacity-20" style="background: #FFA500;"></div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-8 uppercase tracking-wider">¡Ya Registrado!</h2>

                                <div class="flex flex-col gap-8 items-center justify-center mb-8">
                                    ${cliente?.fotoBase64 ? `
                                        <div class="flex-shrink-0">
                                            <img src="data:image/jpeg;base64,${cliente.fotoBase64}"
                                                 alt="${cliente.nombre}"
                                                 class="w-48 h-48 rounded-full object-cover shadow-2xl"
                                                 style="border: 6px solid #FFA500;" />
                                        </div>
                                    ` : ''}

                                    <div class="backdrop-blur-sm rounded-3xl px-12 py-10 w-full" style="background: rgba(0,0,0,0.6); border: 3px solid #FFA500;">
                                        <h3 class="text-4xl font-black text-white mb-6">${cliente?.nombre || 'Usuario'}</h3>

                                        <div class="mb-8 pb-8" style="border-bottom: 2px solid rgba(255, 255, 255, 0.2);">
                                            <p class="text-3xl text-white mb-4 font-bold">${message}</p>
                                        </div>

                                        ${ultimoCheckIn ? `
                                            <div class="mb-6">
                                                <p class="text-xl mb-4 uppercase tracking-wide font-semibold" style="color: #FFA500;">
                                                    <svg class="w-6 h-6 inline-block mr-2" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                                    </svg>
                                                    Último Check-In
                                                </p>
                                                <p class="text-7xl font-black mb-4" style="color: #FFA500;">
                                                    ${ultimoCheckIn.horaFormateada}
                                                </p>
                                                <p class="text-xl text-gray-300 mb-2">
                                                    Hace ${ultimoCheckIn.horasTranscurridas.toFixed(1)} horas
                                                </p>
                                                <p class="text-lg text-gray-400">
                                                    Podrás registrar nuevamente en ${ultimoCheckIn.horasRestantes.toFixed(1)} horas
                                                </p>
                                            </div>
                                        ` : ''}

                                        <div class="mt-8 pt-6" style="border-top: 2px solid rgba(255, 165, 0, 0.5);">
                                            <p class="text-2xl text-white font-semibold">¡Sigue con tu rutina! 💪</p>
                                            <p class="text-lg text-gray-300 mt-2">Ya estás registrado para hoy</p>
                                        </div>
                                    </div>

                                    <!-- Mensaje motivacional -->
                                    <div class="mt-6 space-y-2">
                                        <p class="text-2xl text-white font-bold">¡Sin prisa, pero con ¡DISCIPLINA!</p>
                                        <p class="text-xl font-semibold" style="color: #FF8C00;">(Insiste, Persiste, Resiste)</p>
                                    </div>
                                </div>

                                <button onclick="app.reset(); app.startFingerprintDetection();"
                                    class="px-12 py-5 text-white rounded-xl text-xl font-bold transition-all duration-300 transform hover:scale-105" style="background: #FFA500;">
                                    ENTENDIDO
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }
            // =========================================================

            renderError() {
                const { diasRestantes, deuda } = this.state;
                return `
                    <div class="min-h-screen relative overflow-hidden" style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);">
                        <div class="absolute inset-0 opacity-15">
                            <div class="absolute top-10 left-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                            <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full filter blur-3xl" style="background: #FF8C00;"></div>
                        </div>

                        <div class="relative z-10 flex items-center justify-center min-h-screen px-8">
                            <div class="text-center max-w-3xl">
                                <!-- Logo -->
                                <div class="mb-8 flex justify-center">
                                    <img src="/images/logo-nelson.png" alt="JONEL GYM" class="h-32 w-32 object-contain drop-shadow-2xl" />
                                </div>

                                <!-- Error Icon -->
                                <div class="mb-10 flex justify-center">
                                    <div class="relative">
                                        <div class="w-40 h-40 rounded-full flex items-center justify-center shadow-2xl" style="background: #FF8C00;">
                                            <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </div>
                                        <div class="absolute inset-0 w-40 h-40 rounded-full animate-ping opacity-20" style="background: #FF8C00;"></div>
                                    </div>
                                </div>

                                <h2 class="text-6xl font-black text-white mb-8 uppercase tracking-wider">Acceso Denegado</h2>

                                <div class="backdrop-blur-sm rounded-3xl px-12 py-10 mb-10" style="background: rgba(0,0,0,0.6); border: 3px solid #FF8C00;">
                                    <div class="mb-6 flex justify-center">
                                        <div class="w-20 h-20 rounded-full flex items-center justify-center" style="background: #FF8C00;">
                                            <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                    </div>

                                    <p class="text-3xl text-white mb-4 font-bold">${this.state.message}</p>

                                    ${diasRestantes !== null && diasRestantes !== undefined && diasRestantes < 0 ? `
                                        <div class="pt-6 mt-6" style="border-top: 2px solid rgba(255, 140, 0, 0.5);">
                                            <p class="text-lg mb-3 uppercase tracking-wide font-semibold" style="color: #FF8C00;">Membresía Vencida</p>
                                            <p class="text-5xl font-black" style="color: #FFA500;">
                                                ${Math.abs(diasRestantes)} ${Math.abs(diasRestantes) === 1 ? 'DÍA' : 'DÍAS'}
                                            </p>
                                            <p class="text-white text-lg mt-3">desde su vencimiento</p>
                                        </div>
                                    ` : ''}

                                    <!-- Información de Deuda en Error -->
                                    ${deuda && deuda.tieneDeuda ? `
                                        <div class="pt-6 mt-6" style="border-top: 2px solid rgba(255, 140, 0, 0.5);">
                                            <div class="flex items-center justify-center gap-3 mb-3">
                                                <svg class="w-8 h-8" style="color: #FFA500;" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                </svg>
                                                <p class="text-lg uppercase tracking-wide font-semibold" style="color: #FFA500;">Monto Pendiente</p>
                                            </div>
                                            <p class="text-5xl font-black mb-2" style="color: #FFA500;">
                                                $${deuda.montoTotal.toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                            </p>
                                            <p class="text-base font-semibold" style="color: #FFA500;">
                                                Recuerda ponerte al día
                                            </p>
                                        </div>
                                    ` : ''}

                                    <div class="mt-8 pt-6" style="border-top: 2px solid rgba(255, 140, 0, 0.5);">
                                        <p class="text-xl text-white font-semibold">Dirígete a recepción para asistencia</p>
                                    </div>
                                </div>

                                <button onclick="app.reset(); app.startFingerprintDetection();"
                                    class="px-12 py-5 text-white rounded-xl text-xl font-bold transition-all duration-300 transform hover:scale-105" style="background: #FF8C00;">
                                    VOLVER AL INICIO
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            render() {
                const container = document.getElementById('kiosko-app');
                let html = '';
                let cursorPosition = null;
                const activeInput = document.getElementById('cedula-input');
                if (activeInput && this.state.mode === 'cedula') {
                    cursorPosition = activeInput.selectionStart;
                }

                switch(this.state.mode) {
                    case 'idle': html = this.renderIdle(); break;
                    case 'cedula': html = this.renderCedula(); break;
                    case 'scanning': html = this.renderScanning(); break;
                    case 'success': html = this.renderSuccess(); break;
                    case 'error': html = this.renderError(); break;
                    case 'already-checked-in': html = this.renderAlreadyCheckedIn(); break; // NUEVO
                }

                container.innerHTML = html;

                if (this.state.mode === 'cedula') {
                    setTimeout(() => {
                        const input = document.getElementById('cedula-input');
                        if (input) {
                            input.focus();
                            if (cursorPosition !== null) {
                                const newPosition = Math.min(cursorPosition, input.value.length);
                                input.setSelectionRange(newPosition, newPosition);
                            }
                        }
                    }, 100);
                }
            }
        }

        const app = new KioskoApp();
    </script>
}
